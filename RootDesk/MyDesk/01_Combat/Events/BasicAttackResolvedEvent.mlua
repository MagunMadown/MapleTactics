@Event
script BasicAttackResolvedEvent extends EventType

	property string SourceUnitId = ""
	property string AttackId = ""
	property string TargetUnitId = ""
	property integer TargetCell = -1
	property boolean Hit = false
	property string Reason = ""
	property number DamageAmount = 0
	property number TargetHpBefore = -1
	property number TargetHpAfter = -1

end
