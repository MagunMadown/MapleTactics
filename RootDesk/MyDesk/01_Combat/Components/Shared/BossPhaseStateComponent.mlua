@Component
script BossPhaseStateComponent extends Component

	@Sync property string EnemyDefinitionId = ""
	@Sync property integer PhaseIndex = 0
	@Sync property string PhaseId = ""
	@Sync property string PatternId = ""
	@Sync property integer PhaseRevision = 0

	property table Definitions = nil

	@ExecSpace("ServerOnly")
	method table InitializePhases(string enemyDefinitionId, number currentHp, number maxHp)
		local validation = _BossPhaseContentValidatorLogic:ValidateByEnemyDefinitionId(enemyDefinitionId)
		if validation.Success == false then return validation end
		self.EnemyDefinitionId = enemyDefinitionId
		self.Definitions = validation.Data.Definitions
		return self:ApplyPhaseForHp(currentHp, maxHp, "INITIALIZE")
	end

	@ExecSpace("ServerOnly")
	method table RefreshPhase(number currentHp, number maxHp, string reason)
		if self.Definitions == nil then
			return { Success = false, Reason = "BOSS_PHASE_RUNTIME_MISSING", Changed = false }
		end
		return self:ApplyPhaseForHp(currentHp, maxHp, reason or "HP_CHANGED")
	end

	@ExecSpace("ServerOnly")
	method table ApplyPhaseForHp(number currentHp, number maxHp, string reason)
		if maxHp <= 0 then return { Success = false, Reason = "INVALID_BOSS_MAX_HP", Changed = false } end
		local hpRatio = math.max(0, currentHp) / maxHp
		local selected = nil
		for _, definition in ipairs(self.Definitions or {}) do
			if hpRatio <= definition.HpRatioLE then selected = definition end
		end
		if selected == nil then return { Success = false, Reason = "BOSS_PHASE_NOT_RESOLVED", Changed = false } end
		if self.PhaseIndex == selected.PhaseIndex and self.PatternId == selected.PatternId then
			return { Success = true, Reason = "BOSS_PHASE_UNCHANGED", Changed = false, PhaseIndex = self.PhaseIndex, PhaseId = self.PhaseId, PatternId = self.PatternId }
		end
		local runner = self.Entity:GetComponent("script.EnemyPatternRunnerComponent")
		if runner == nil then return { Success = false, Reason = "PATTERN_RUNNER_MISSING", Changed = false } end
		local patternResult = runner:InitializePattern(selected.PatternId, 1)
		if patternResult.Success == false then return patternResult end
		local unit = self.Entity:GetComponent("script.BattleUnitComponent")
		if unit ~= nil then unit.EnemyPatternId = selected.PatternId end
		local previousPhaseId = self.PhaseId
		self.PhaseIndex = selected.PhaseIndex
		self.PhaseId = selected.PhaseId
		self.PatternId = selected.PatternId
		self.PhaseRevision = self.PhaseRevision + 1
		log("[BossPhase] changed enemy=" .. self.EnemyDefinitionId .. " from=" .. previousPhaseId .. " to=" .. self.PhaseId .. " index=" .. self.PhaseIndex .. " hpRatio=" .. tostring(hpRatio) .. " pattern=" .. self.PatternId .. " reason=" .. reason .. " revision=" .. self.PhaseRevision)
		if previousPhaseId ~= "" then
			local currentMap = self.Entity.CurrentMap
			local battleSession = currentMap ~= nil and currentMap:GetComponent("script.BattleSessionComponent") or nil
			if battleSession ~= nil then
				battleSession:PublishEnemyPlanSnapshot("BOSS_PHASE_CHANGED")
			end
		end
		return { Success = true, Reason = "BOSS_PHASE_CHANGED", Changed = true, PhaseIndex = self.PhaseIndex, PhaseId = self.PhaseId, PatternId = self.PatternId, Revision = self.PhaseRevision }
	end

end
