@Component
script EnemyActionPlanComponent extends Component

	@Sync property string PlanState = "EMPTY"
	@Sync property string OwnerUnitId = ""
	@Sync property integer PlannedTurn = 0
	@Sync property integer CurrentActionIndex = 0
	@Sync property integer PlannedActionCount = 0
	@Sync property string PlannedActionSnapshot = ""
	@Sync property string TraitIds = ""
	@Sync property string PlanReason = ""
	@Sync property integer PlanRevision = 0

	property table PlannedActions = nil
	property boolean AggregateSuccess = true

	@ExecSpace("ServerOnly")
	method table ReplacePlan(string ownerUnitId, table actions, integer plannedTurn, string traitIds, string reason)
		-- One enemy owns one immutable round plan. The session coordinates plans but never owns their queues.
		if ownerUnitId == nil or ownerUnitId == "" then
			return { Success = false, Reason = "INVALID_OWNER_UNIT_ID" }
		end
		if actions == nil or #actions == 0 then
			return { Success = false, Reason = "PLANNED_ACTIONS_EMPTY" }
		end
		if self.PlanState ~= "EMPTY" then
			return { Success = false, Reason = "PLAN_ALREADY_EXISTS" }
		end

		self.PlannedActions = {}
		for _, action in ipairs(actions) do
			if action.ActionType == nil or action.ActionType == "" then
				self.PlannedActions = nil
				return { Success = false, Reason = "INVALID_PLANNED_ACTION" }
			end
			table.insert(self.PlannedActions, {
				ActionType = action.ActionType,
				TileId = action.TileId or "",
				Direction = math.floor(tonumber(action.Direction) or 0),
				Reason = action.Reason or reason or "PLANNED",
				PatternId = action.PatternId or "",
				StepIndex = math.max(1, math.floor(tonumber(action.StepIndex) or 1)),
				PatternStepCount = math.max(0, math.floor(tonumber(action.PatternStepCount) or 0)),
				TelegraphTurnsRemaining = math.max(0, math.floor(tonumber(action.TelegraphTurnsRemaining) or 0))
			})
		end

		self.PlanState = "PREPARED"
		self.OwnerUnitId = ownerUnitId
		self.PlannedTurn = math.max(0, plannedTurn)
		self.CurrentActionIndex = 1
		self.PlannedActionCount = #self.PlannedActions
		self.TraitIds = traitIds or ""
		self.PlanReason = reason or "PLANNED"
		self.AggregateSuccess = true
		self.PlanRevision = self.PlanRevision + 1
		self:PublishSnapshot()
		log("[EnemyActionPlan] prepared enemy=" .. self.OwnerUnitId .. " turn=" .. self.PlannedTurn .. " actions=" .. self.PlannedActionCount .. " traits=" .. self.TraitIds .. " revision=" .. self.PlanRevision)
		return { Success = true, Reason = "PLAN_PREPARED", ActionCount = self.PlannedActionCount, Revision = self.PlanRevision }
	end

	@ExecSpace("ServerOnly")
	method table GetCurrentAction()
		if self.PlanState ~= "PREPARED" and self.PlanState ~= "EXECUTING" then
			return { Success = false, Reason = "PLAN_NOT_PREPARED" }
		end
		if self.PlannedActions == nil then
			return { Success = false, Reason = "PLAN_RUNTIME_MISSING" }
		end
		local action = self.PlannedActions[self.CurrentActionIndex]
		if action == nil then
			return { Success = false, Reason = "PLANNED_ACTION_MISSING" }
		end
		return {
			Success = true,
			Reason = "OK",
			EnemyId = self.OwnerUnitId,
			ActionType = action.ActionType,
			TileId = action.TileId,
			Direction = action.Direction,
			ActionReason = action.Reason,
			PatternId = action.PatternId,
			StepIndex = action.StepIndex,
			PatternStepCount = action.PatternStepCount,
			TelegraphTurnsRemaining = action.TelegraphTurnsRemaining,
			PreparedTurn = self.PlannedTurn,
			ActionIndex = self.CurrentActionIndex,
			ActionCount = self.PlannedActionCount,
			TraitIds = self.TraitIds,
			Revision = self.PlanRevision
		}
	end

	@ExecSpace("ServerOnly")
	method table TryBeginCurrentAction()
		if self.PlanState ~= "PREPARED" then
			return { Success = false, Reason = "PLAN_NOT_PREPARED" }
		end
		local current = self:GetCurrentAction()
		if current.Success == false then
			return current
		end
		self.PlanState = "EXECUTING"
		self.PlanRevision = self.PlanRevision + 1
		return current
	end

	@ExecSpace("ServerOnly")
	method table CompleteCurrentAction(boolean success, string reason)
		if self.PlanState ~= "EXECUTING" then
			return { Success = false, Reason = "PLAN_NOT_EXECUTING" }
		end
		self.AggregateSuccess = self.AggregateSuccess and success
		if self.CurrentActionIndex < self.PlannedActionCount then
			self.CurrentActionIndex = self.CurrentActionIndex + 1
			self.PlanState = "PREPARED"
			self.PlanReason = reason or "ACTION_COMPLETED"
			self.PlanRevision = self.PlanRevision + 1
			self:PublishSnapshot()
			return { Success = true, Reason = "NEXT_ACTION_READY", HasNextAction = true, AggregateSuccess = self.AggregateSuccess, Revision = self.PlanRevision }
		end
		self.PlanState = "COMPLETED"
		self.PlanReason = reason or "PLAN_COMPLETED"
		self.PlanRevision = self.PlanRevision + 1
		self:PublishSnapshot()
		return { Success = true, Reason = "PLAN_COMPLETED", HasNextAction = false, AggregateSuccess = self.AggregateSuccess, Revision = self.PlanRevision }
	end

	@ExecSpace("ServerOnly")
	method void ResetPlan(string reason)
		if self.PlanState ~= "EMPTY" then
			log("[EnemyActionPlan] reset enemy=" .. self.OwnerUnitId .. " state=" .. self.PlanState .. " reason=" .. reason)
		end
		self.PlanState = "EMPTY"
		self.PlannedTurn = 0
		self.CurrentActionIndex = 0
		self.PlannedActionCount = 0
		self.PlannedActionSnapshot = ""
		self.PlanReason = reason or "RESET"
		self.PlannedActions = nil
		self.AggregateSuccess = true
		self.PlanRevision = self.PlanRevision + 1
	end

	@ExecSpace("ServerOnly")
	method table GetPlanSnapshot()
		return {
			State = self.PlanState,
			OwnerUnitId = self.OwnerUnitId,
			PlannedTurn = self.PlannedTurn,
			CurrentActionIndex = self.CurrentActionIndex,
			ActionCount = self.PlannedActionCount,
			ActionSnapshot = self.PlannedActionSnapshot,
			TraitIds = self.TraitIds,
			Reason = self.PlanReason,
			Revision = self.PlanRevision,
			AggregateSuccess = self.AggregateSuccess
		}
	end

	@ExecSpace("ServerOnly")
	method void PublishSnapshot()
		local entries = {}
		if self.PlannedActions ~= nil then
			for index, action in ipairs(self.PlannedActions) do
				table.insert(entries, table.concat({
					tostring(index),
					action.ActionType,
					action.TileId ~= "" and action.TileId or "-",
					tostring(action.Direction),
					tostring(action.TelegraphTurnsRemaining),
					action.PatternId,
					tostring(action.StepIndex)
				}, "~"))
			end
		end
		self.PlannedActionSnapshot = table.concat(entries, ">")
	end

end
