@Component
script EnemyActionPlanComponent extends Component

	@Sync property string PlanState = "EMPTY"
	@Sync property string OwnerUnitId = ""
	@Sync property integer PlannedTurn = 0
	@Sync property integer CurrentActionIndex = 0
	@Sync property integer PlannedActionCount = 0
	@Sync property integer QueueTurnsRequired = 0
	@Sync property integer QueueTurnsElapsed = 0
	@Sync property string ReadinessReason = ""
	@Sync property string NextCommandType = ""
	@Sync property integer NextCommandDirection = 0
	@Sync property string TargetCellSnapshot = ""
	@Sync property string PlannedActionSnapshot = ""
	@Sync property string TraitIds = ""
	@Sync property string PlanReason = ""
	@Sync property integer PlanRevision = 0
	@Sync property integer DeferredUntilTurn = 0

	property table PlannedActions = nil
	property boolean AggregateSuccess = true
	property boolean SpawnWaitPending = true

	@ExecSpace("ServerOnly")
	method table ReplacePlan(string ownerUnitId, table actions, integer plannedTurn, string traitIds, string reason, integer queueTurnsRequired)
		-- One enemy owns one immutable round plan. The session coordinates plans but never owns their queues.
		if ownerUnitId == nil or ownerUnitId == "" then
			return { Success = false, Reason = "INVALID_OWNER_UNIT_ID" }
		end
		if actions == nil or #actions == 0 then
			return { Success = false, Reason = "PLANNED_ACTIONS_EMPTY" }
		end
		if self.PlanState ~= "EMPTY" then
			return { Success = false, Reason = "PLAN_ALREADY_EXISTS" }
		end

		self.PlannedActions = {}
		for _, action in ipairs(actions) do
			if action.ActionType == nil or action.ActionType == "" then
				self.PlannedActions = nil
				return { Success = false, Reason = "INVALID_PLANNED_ACTION" }
			end
			table.insert(self.PlannedActions, {
				ActionType = action.ActionType,
				TileId = action.TileId or "",
				Direction = math.floor(tonumber(action.Direction) or 0),
				Reason = action.Reason or reason or "PLANNED",
				PatternId = action.PatternId or "",
				StepIndex = math.max(1, math.floor(tonumber(action.StepIndex) or 1)),
				PatternStepCount = math.max(0, math.floor(tonumber(action.PatternStepCount) or 0)),
				TelegraphTurnsRemaining = math.max(0, math.floor(tonumber(action.TelegraphTurnsRemaining) or 0))
			})
		end

		self.QueueTurnsRequired = math.max(0, math.floor(tonumber(queueTurnsRequired) or 0))
		self.QueueTurnsElapsed = 0
		self.PlanState = "PREPARED"
		if self.PlannedActions[1].ActionType == "EXECUTE_TILE" and self.QueueTurnsRequired > 0 then
			self.PlanState = "INSERTING"
		elseif self.PlannedActions[1].ActionType == "EXECUTE_TILE" then
			self.PlanState = "TRACKING"
		end
		self.OwnerUnitId = ownerUnitId
		self.PlannedTurn = math.max(0, plannedTurn)
		self.CurrentActionIndex = 1
		self.PlannedActionCount = #self.PlannedActions
		self.TraitIds = traitIds or ""
		self.PlanReason = reason or "PLANNED"
		self.DeferredUntilTurn = 0
		self.ReadinessReason = self.PlanState == "INSERTING" and "ATTACK_TILE_INSERTING" or ""
		self.NextCommandType = self.PlanState == "INSERTING" and "QUEUE_TILE" or ""
		self.NextCommandDirection = 0
		self.TargetCellSnapshot = ""
		self.AggregateSuccess = true
		self.PlanRevision = self.PlanRevision + 1
		self:PublishSnapshot()
		log("[EnemyActionPlan] prepared enemy=" .. self.OwnerUnitId .. " turn=" .. self.PlannedTurn .. " state=" .. self.PlanState .. " queue=" .. self.QueueTurnsElapsed .. "/" .. self.QueueTurnsRequired .. " actions=" .. self.PlannedActionCount .. " traits=" .. self.TraitIds .. " revision=" .. self.PlanRevision)
		return { Success = true, Reason = self.PlanState == "INSERTING" and "PLAN_INSERTING" or self.PlanState == "TRACKING" and "PLAN_TRACKING" or "PLAN_PREPARED", State = self.PlanState, ActionCount = self.PlannedActionCount, Revision = self.PlanRevision }
	end

	@ExecSpace("ServerOnly")
	method table GetCurrentAction()
		if self.PlanState ~= "INSERTING" and self.PlanState ~= "TRACKING" and self.PlanState ~= "ATTACK_READY" and self.PlanState ~= "PREPARED" and self.PlanState ~= "EXECUTING" then
			return { Success = false, Reason = "PLAN_NOT_PREPARED" }
		end
		if self.PlannedActions == nil then
			return { Success = false, Reason = "PLAN_RUNTIME_MISSING" }
		end
		local action = self.PlannedActions[self.CurrentActionIndex]
		if action == nil then
			return { Success = false, Reason = "PLANNED_ACTION_MISSING" }
		end
		return {
			Success = true,
			Reason = "OK",
			EnemyId = self.OwnerUnitId,
			ActionType = action.ActionType,
			TileId = action.TileId,
			Direction = action.Direction,
			ActionReason = action.Reason,
			PatternId = action.PatternId,
			StepIndex = action.StepIndex,
			PatternStepCount = action.PatternStepCount,
			TelegraphTurnsRemaining = action.TelegraphTurnsRemaining,
			PreparedTurn = self.PlannedTurn,
			ActionIndex = self.CurrentActionIndex,
			ActionCount = self.PlannedActionCount,
			TraitIds = self.TraitIds,
			Revision = self.PlanRevision
		}
	end

	@ExecSpace("ServerOnly")
	method table AdvanceQueueTurn()
		-- Normal foes spend an enemy turn placing their attack Tile into the queue.
		if self.PlanState ~= "INSERTING" then
			return { Success = false, Reason = "PLAN_NOT_INSERTING", Ready = self.PlanState == "TRACKING" or self.PlanState == "ATTACK_READY" }
		end
		self.QueueTurnsElapsed = math.min(self.QueueTurnsRequired, self.QueueTurnsElapsed + 1)
		local isReady = self.QueueTurnsElapsed >= self.QueueTurnsRequired
		if isReady then
			self.PlanState = "TRACKING"
			self.PlanReason = "ATTACK_TILE_QUEUED"
			self.ReadinessReason = "READINESS_PENDING"
			self.NextCommandType = ""
			self.NextCommandDirection = 0
		else
			self.PlanReason = "ATTACK_TILE_QUEUEING"
			self.ReadinessReason = "ATTACK_TILE_INSERTING"
			self.NextCommandType = "QUEUE_TILE"
		end
		self.PlanRevision = self.PlanRevision + 1
		self:PublishSnapshot()
		log("[EnemyActionPlan] queue advanced enemy=" .. self.OwnerUnitId .. " state=" .. self.PlanState .. " queue=" .. self.QueueTurnsElapsed .. "/" .. self.QueueTurnsRequired .. " revision=" .. self.PlanRevision)
		return { Success = true, Reason = self.PlanReason, Ready = isReady, QueueTurnsElapsed = self.QueueTurnsElapsed, QueueTurnsRequired = self.QueueTurnsRequired, Revision = self.PlanRevision }
	end

	@ExecSpace("ServerOnly")
	method table SetTrackingState(string readinessReason, string nextCommandType, integer nextCommandDirection, string targetCellSnapshot)
		if self.PlanState ~= "TRACKING" then
			return { Success = false, Reason = "PLAN_NOT_TRACKING" }
		end
		self.ReadinessReason = readinessReason or "TRACKING"
		self.NextCommandType = nextCommandType or "WAIT"
		self.NextCommandDirection = math.floor(tonumber(nextCommandDirection) or 0)
		self.TargetCellSnapshot = targetCellSnapshot or ""
		self.PlanReason = self.ReadinessReason
		self.PlanRevision = self.PlanRevision + 1
		self:PublishSnapshot()
		log("[EnemyActionPlan] tracking enemy=" .. self.OwnerUnitId .. " readiness=" .. self.ReadinessReason .. " next=" .. self.NextCommandType .. " cells=" .. self.TargetCellSnapshot .. " revision=" .. self.PlanRevision)
		return { Success = true, Reason = self.ReadinessReason, State = self.PlanState, NextCommandType = self.NextCommandType, Revision = self.PlanRevision }
	end

	@ExecSpace("ServerOnly")
	method table MarkAttackReady(string readinessReason, string targetCellSnapshot)
		if self.PlanState ~= "TRACKING" then
			return { Success = false, Reason = "PLAN_NOT_TRACKING" }
		end
		self.PlanState = "ATTACK_READY"
		self.ReadinessReason = readinessReason or "READY"
		self.NextCommandType = "EXECUTE_TILE"
		self.NextCommandDirection = 0
		self.TargetCellSnapshot = targetCellSnapshot or ""
		self.PlanReason = "ATTACK_READY"
		self.PlanRevision = self.PlanRevision + 1
		self:PublishSnapshot()
		log("[EnemyActionPlan] attack ready enemy=" .. self.OwnerUnitId .. " tile=" .. (self.PlannedActions ~= nil and self.PlannedActions[1] ~= nil and self.PlannedActions[1].TileId or "") .. " cells=" .. self.TargetCellSnapshot .. " revision=" .. self.PlanRevision)
		return { Success = true, Reason = "ATTACK_READY", State = self.PlanState, Revision = self.PlanRevision }
	end

	@ExecSpace("ServerOnly")
	method table TryBeginCurrentAction()
		if self.PlanState ~= "PREPARED" and self.PlanState ~= "ATTACK_READY" then
			return { Success = false, Reason = "PLAN_NOT_PREPARED" }
		end
		local current = self:GetCurrentAction()
		if current.Success == false then
			return current
		end
		self.PlanState = "EXECUTING"
		self.DeferredUntilTurn = 0
		self.PlanRevision = self.PlanRevision + 1
		return current
	end

	@ExecSpace("ServerOnly")
	method table DeferCurrentActionUntilTurn(integer turnNumber, string reason)
		-- Keeps the next action visible in the enemy-owned plan while preventing same-round execution.
		if self.PlanState ~= "PREPARED" then
			return { Success = false, Reason = "PLAN_NOT_PREPARED" }
		end
		local minimumTurn = self.PlannedTurn + 1
		self.DeferredUntilTurn = math.max(minimumTurn, math.floor(tonumber(turnNumber) or minimumTurn))
		self.PlanReason = reason or "ACTION_DEFERRED"
		self.ReadinessReason = "WAITING_NEXT_ENEMY_TURN"
		self.PlanRevision = self.PlanRevision + 1
		self:PublishSnapshot()
		log("[EnemyActionPlan] deferred enemy=" .. self.OwnerUnitId .. " action=" .. self.CurrentActionIndex .. "/" .. self.PlannedActionCount .. " untilTurn=" .. self.DeferredUntilTurn .. " revision=" .. self.PlanRevision)
		return { Success = true, Reason = self.PlanReason, DeferredUntilTurn = self.DeferredUntilTurn, Revision = self.PlanRevision }
	end

	@ExecSpace("ServerOnly")
	method table CompleteCurrentAction(boolean success, string reason)
		-- Consumes the one-time spawn wait only after its enemy turn actually completes.
		if self.PlanState ~= "EXECUTING" then
			return { Success = false, Reason = "PLAN_NOT_EXECUTING" }
		end
		local currentAction = self.PlannedActions[self.CurrentActionIndex]
		if success == true and currentAction.ActionType == "WAIT" and currentAction.Reason == "SPAWN_WAIT" then
			self.SpawnWaitPending = false
			log("[EnemySpawnWait] completed enemy=" .. self.OwnerUnitId .. " turn=" .. self.PlannedTurn)
		end
		self.AggregateSuccess = self.AggregateSuccess and success
		if self.CurrentActionIndex < self.PlannedActionCount then
			self.CurrentActionIndex = self.CurrentActionIndex + 1
			self.PlanState = "PREPARED"
			self.PlanReason = reason or "ACTION_COMPLETED"
			self.PlanRevision = self.PlanRevision + 1
			self:PublishSnapshot()
			return { Success = true, Reason = "NEXT_ACTION_READY", HasNextAction = true, AggregateSuccess = self.AggregateSuccess, Revision = self.PlanRevision }
		end
		self.PlanState = "COMPLETED"
		self.PlanReason = reason or "PLAN_COMPLETED"
		self.PlanRevision = self.PlanRevision + 1
		self:PublishSnapshot()
		return { Success = true, Reason = "PLAN_COMPLETED", HasNextAction = false, AggregateSuccess = self.AggregateSuccess, Revision = self.PlanRevision }
	end

	@ExecSpace("ServerOnly")
	method void ResetPlan(string reason)
		if self.PlanState ~= "EMPTY" then
			log("[EnemyActionPlan] reset enemy=" .. self.OwnerUnitId .. " state=" .. self.PlanState .. " reason=" .. reason)
		end
		self.PlanState = "EMPTY"
		self.PlannedTurn = 0
		self.CurrentActionIndex = 0
		self.PlannedActionCount = 0
		self.QueueTurnsRequired = 0
		self.QueueTurnsElapsed = 0
		self.ReadinessReason = ""
		self.NextCommandType = ""
		self.NextCommandDirection = 0
		self.TargetCellSnapshot = ""
		self.PlannedActionSnapshot = ""
		self.PlanReason = reason or "RESET"
		self.DeferredUntilTurn = 0
		self.PlannedActions = nil
		self.AggregateSuccess = true
		self.PlanRevision = self.PlanRevision + 1
	end

	@ExecSpace("ServerOnly")
	method table GetPlanSnapshot()
		return {
			State = self.PlanState,
			OwnerUnitId = self.OwnerUnitId,
			PlannedTurn = self.PlannedTurn,
			CurrentActionIndex = self.CurrentActionIndex,
			ActionCount = self.PlannedActionCount,
			QueueTurnsRequired = self.QueueTurnsRequired,
			QueueTurnsElapsed = self.QueueTurnsElapsed,
			ReadinessReason = self.ReadinessReason,
			NextCommandType = self.NextCommandType,
			NextCommandDirection = self.NextCommandDirection,
			TargetCellSnapshot = self.TargetCellSnapshot,
			ActionSnapshot = self.PlannedActionSnapshot,
			TraitIds = self.TraitIds,
			Reason = self.PlanReason,
			DeferredUntilTurn = self.DeferredUntilTurn,
			Revision = self.PlanRevision,
			AggregateSuccess = self.AggregateSuccess
		}
	end

	@ExecSpace("ServerOnly")
	method void PublishSnapshot()
		local entries = {}
		if self.PlannedActions ~= nil then
			for index, action in ipairs(self.PlannedActions) do
				table.insert(entries, table.concat({
					tostring(index),
					action.ActionType,
					action.TileId ~= "" and action.TileId or "-",
					tostring(action.Direction),
					tostring(action.TelegraphTurnsRemaining),
					action.PatternId,
					tostring(action.StepIndex)
				}, "~"))
			end
		end
		self.PlannedActionSnapshot = table.concat(entries, ">")
	end

end
