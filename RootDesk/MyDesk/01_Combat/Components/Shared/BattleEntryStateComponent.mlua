@Component
script BattleEntryStateComponent extends Component

	@Sync property string EntryState = "IDLE"
	@Sync property integer RequestId = 0
	@Sync property string StageId = "stage01"
	@Sync property string CharacterId = ""
	@Sync property string JobId = ""
	@Sync property string LoadoutId = ""
	@Sync property integer RunSeed = 1000
	@Sync property string EntryMode = "NEW_RUN"
	@Sync property string LastReason = ""
	@Sync property integer LastTransferRequestId = 0

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		log("[BattleEntryState] attached player=" .. self.Entity.Name .. " state=" .. self.EntryState)
	end

	@ExecSpace("ServerOnly")
	method table Prepare(string stageId, string characterId, string jobId, string loadoutId, integer runSeed, string entryMode)
		local result = {
			Success = false,
			Reason = "UNKNOWN",
			RequestId = self.RequestId
		}
		if stageId == nil or stageId == "" then
			result.Reason = "INVALID_STAGE_ID"
			return result
		end
		if entryMode ~= "NEW_RUN" and entryMode ~= "CONTINUE_RUN" then
			result.Reason = "INVALID_ENTRY_MODE"
			return result
		end

		local normalizedSeed = math.max(0, math.floor(math.abs(runSeed)))
		self.RequestId = self.RequestId + 1
		self.StageId = stageId
		self.CharacterId = characterId or ""
		self.JobId = jobId or ""
		self.LoadoutId = loadoutId or ""
		self.RunSeed = normalizedSeed
		self.EntryMode = entryMode
		self.EntryState = "PREPARED"
		self.LastReason = "PREPARED"

		result.Success = true
		result.Reason = "PREPARED"
		result.RequestId = self.RequestId
		log("[BattleEntryState] prepared request=" .. self.RequestId .. " stage=" .. self.StageId .. " character=" .. self.CharacterId .. " job=" .. self.JobId .. " loadout=" .. self.LoadoutId .. " seed=" .. self.RunSeed .. " mode=" .. self.EntryMode)
		return result
	end

	@ExecSpace("ServerOnly")
	method table MarkStarted()
		if self.EntryState ~= "PREPARED" then
			return {
				Success = false,
				Reason = "ENTRY_NOT_PREPARED",
				RequestId = self.RequestId
			}
		end

		self.EntryState = "STARTED"
		self.LastReason = "STARTED"
		log("[BattleEntryState] started request=" .. self.RequestId .. " stage=" .. self.StageId)
		return {
			Success = true,
			Reason = "STARTED",
			RequestId = self.RequestId
		}
	end

	@ExecSpace("ServerOnly")
	method boolean TryMarkTransferRequested(integer requestId)
		-- Keeps transfer de-duplication on the player-owned entry without consuming PREPARED.
		if self.EntryState ~= "PREPARED" or requestId <= 0 or requestId ~= self.RequestId then
			return false
		end
		if self.LastTransferRequestId == requestId then
			return false
		end
		self.LastTransferRequestId = requestId
		return true
	end

	@ExecSpace("ServerOnly")
	method table RecordFailure(string reason)
		local failureReason = reason
		if failureReason == nil or failureReason == "" then
			failureReason = "UNKNOWN"
		end
		self.LastReason = failureReason
		log_warning("[BattleEntryState] pending request=" .. self.RequestId .. " reason=" .. failureReason)
		return {
			Success = false,
			Reason = failureReason,
			RequestId = self.RequestId
		}
	end

	@ExecSpace("ServerOnly")
	method table Cancel(string reason)
		local cancelReason = reason
		if cancelReason == nil or cancelReason == "" then
			cancelReason = "CANCELLED"
		end
		self.EntryState = "CANCELLED"
		self.LastReason = cancelReason
		log("[BattleEntryState] cancelled request=" .. self.RequestId .. " reason=" .. cancelReason)
		return {
			Success = true,
			Reason = cancelReason,
			RequestId = self.RequestId
		}
	end

	@ExecSpace("ServerOnly")
	method table GetSnapshot()
		return {
			Success = true,
			Reason = self.LastReason,
			EntryState = self.EntryState,
			RequestId = self.RequestId,
			StageId = self.StageId,
			CharacterId = self.CharacterId,
			JobId = self.JobId,
			LoadoutId = self.LoadoutId,
			RunSeed = self.RunSeed,
			EntryMode = self.EntryMode,
			LastTransferRequestId = self.LastTransferRequestId
		}
	end

end
