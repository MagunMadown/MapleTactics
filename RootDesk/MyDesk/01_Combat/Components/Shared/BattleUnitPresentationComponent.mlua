@Component
script BattleUnitPresentationComponent extends Component

	property Color HitFlashColor = Color(1, 0.35, 0.35, 1)
	-- Stable catalog IDs; cosmetic selection belongs to the actor, not to an individual skill.
	@Sync property string OutgoingDamageSkinId = "maple_default"
	@Sync property string IncomingDamageSkinId = "maple_taken"
	property Vector2 DamageNumberOffset = Vector2(0, 0)
	property Vector2 NormalHitSquashScale = Vector2(1.07, 0.93)
	property Vector2 StrongHitSquashScale = Vector2(1.13, 0.87)
	property string CombatMotionReturnState = "IDLE"
	-- Maple monster sprite and animation resources face left in their unflipped state.
	-- Override this only when a custom monster model is authored facing right.
	property boolean SpriteFacesLeftByDefault = true

	-- Optional per-character move-hop profile. When disabled, BattleSession team defaults are used.
	@Sync property boolean UseCustomMoveHopProfile = false
	@Sync property boolean CustomMoveHopEnabled = true
	@Sync property number CustomMoveHopDuration = 0.13
	@Sync property number CustomMoveHopHeight = 0.09
	@Sync property number CustomMoveHopTakeoffDuration = 0.02
	@Sync property number CustomMoveHopLandingDuration = 0.04
	@Sync property Vector2 CustomMoveHopSquashScale = Vector2(1.03, 0.97)
	@Sync property Vector2 CustomMoveHopLandingScale = Vector2(1.05, 0.95)
	@Sync property number CustomMoveHopPeakProgress = 0.50
	@Sync property string CustomMoveHopAnimationRuid = ""
	@Sync property number CustomMoveHopAnimationPlayRate = 3
	-- Data-driven enemy motion profile. Empty values preserve legacy model/skill fallbacks.
	@Sync property string IdleMotionRuid = ""
	@Sync property number IdleMotionPlayRate = 1
	@Sync property string MovementMotionRuid = ""
	@Sync property number MovementMotionPlayRate = 3
	@Sync property string HitMotionRuid = ""
	@Sync property number HitMotionPlayRate = 3
	@Sync property number HitMotionDuration = 0.25
	@Sync property string AttackMotionRuid = ""
	@Sync property number AttackMotionPlayRate = 3
	@Sync property number AttackMotionDuration = 0.35
	@Sync property string DeathMotionRuid = ""
	@Sync property number DeathMotionPlayRate = 3
	@Sync property number DeathMotionDuration = 0.5
	-- Per-resource ground alignment. Logical CellIndex/UnitY stay unchanged.
	@Sync property number GroundVisualOffsetY = 0
	-- Keeps the final death frame readable before the renderer is hidden or the next wave replaces it.
	property number DeathMotionHoldDuration = 0.3

	-- MapleStory skill clips are authored with their pivot already on the caster/target anchor
	-- (measured: hit clips center at ~0, piercing's cast pivot sits at the forward edge), so the
	-- default nudge is zero. Only override this for a clip that visibly needs repositioning.
	property number SkillEffectOffsetY = 0
	property string SkillEffectSortingLayer = "MapLayer0"
	property integer SkillEffectOrderInLayer = 30
	-- Looping status marker (e.g. venom poison) shown above the unit's head while the status lasts.
	-- Fallback height for units without a BattleHeadAnchor; monsters place the row at their own head height.
	-- The anchor is authored a little above the sprite, so a small negative gap seats the row on the head.
	property number StatusMarkerOffsetY = 1.25
	-- The player's overhead skill queue covers 1.24+ units above the feet, so player markers sit just below it.
	property number PlayerStatusMarkerOffsetY = 0.8
	property number StatusMarkerHeadGap = -0.15
	property string HeadAnchorChildName = "BattleHeadAnchor"
	property number StatusMarkerScale = 1

	property integer HitFlashTimerId = 0
	property integer HitStopTimerId = 0
	property integer HitReactionMidTimerId = 0
	property integer HitReactionRestoreTimerId = 0
	property integer MotionTimerId = 0
	property boolean CombatMotionHandoffPending = false
	property boolean CombatMotionReady = false
	property boolean CombatMotionReleaseRequested = false
	property string CombatMotionUnitId = ""
	property string CombatMotionKey = ""
	property integer SpriteMotionTimerId = 0
	property integer DeathMotionTimerId = 0
	property boolean DeathMotionActive = false
	property boolean DeathMotionCompleted = false
	property boolean HasOriginalSpriteColor = false
	property Color OriginalSpriteColor = Color(1, 1, 1, 1)
	property boolean HasOriginalImpactPlayRate = false
	property number OriginalImpactPlayRate = 1
	property boolean HasOriginalVisualScale = false
	property Vector3 OriginalVisualScale = Vector3(1, 1, 1)
	property boolean HasOriginalSpriteMotion = false
	property string OriginalSpriteRuid = ""
	property number OriginalSpritePlayRate = 1

	method void OnBeginPlay()
		-- Presentation settings are local-only and never mutate logical battle state.
		self:DisablePlayerAutomaticRenderLayer()
		if self:IsServer() then return end
		self:EnsurePlayerRenderOrder()
		log("[BattlePresentation] ready entity=" .. self.Entity.Name .. " tuningSource=BattleSessionComponent")
		_DamageSkinDefinitionRepositoryLogic:PreloadSkin(self.OutgoingDamageSkinId)
		_DamageSkinDefinitionRepositoryLogic:PreloadSkin(self.IncomingDamageSkinId)
		local unit = self.Entity:GetComponent("script.BattleUnitComponent")
		if unit ~= nil then
			self:ApplySpriteFacing(unit.UnitId, unit.Facing)
		end
	end

	method void DisablePlayerAutomaticRenderLayer()
		-- Keep footholds, ladders and ropes from moving player visuals behind scenery on either side.
		if self.Entity.PlayerComponent == nil then return end
		local body = self.Entity.RigidbodyComponent
		if body ~= nil and body.LayerSettingType ~= AutomaticLayerOption.None then
			body.LayerSettingType = AutomaticLayerOption.None
		end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- Maintain the foreground rule for local and remote avatars across every map.
		self:EnsurePlayerRenderOrder()
	end

	@ExecSpace("ClientOnly")
	method void EnsurePlayerRenderOrder()
		-- Use the frontmost registered map layer; its internal ID need not match LayerSortOrder.
		if self.Entity.PlayerComponent == nil then return end
		local avatar = self.Entity.AvatarRendererComponent
		local map = self.Entity.CurrentMap
		if avatar == nil or not isvalid(map) then return end
		self:DisablePlayerAutomaticRenderLayer()
		local mapChanged = self._T.playerRenderMap ~= map
		if mapChanged or self._T.playerRenderLayer == nil then
			local frontLayer = nil
			for _, candidate in ipairs(map:GetChildComponentsByTypeName("MapLayerComponent", true)) do
				---@type MapLayerComponent
				local layer = candidate
				if isvalid(layer) and layer.IsVisible and layer.MapLayerName ~= "" then
					if frontLayer == nil or layer.LayerSortOrder > frontLayer.LayerSortOrder then
						frontLayer = layer
					end
				end
			end
			if frontLayer == nil then return end
			self._T.playerRenderMap = map
			self._T.playerRenderLayer = frontLayer.MapLayerName
		end
		-- The guided battle temporarily raises actors above its dimmer and restores this baseline.
		if _TutorialPresentationLogic:IsActorHighlighted(self.Entity) then return end
		if avatar.IgnoreMapLayerCheck then avatar.IgnoreMapLayerCheck = false end
		if avatar.SortingLayer ~= self._T.playerRenderLayer then
			avatar.SortingLayer = self._T.playerRenderLayer
			-- Cache the effective internal ID after the engine resolves the map's display name.
			self._T.playerRenderLayer = avatar.SortingLayer
		end
		if avatar.OrderInLayer ~= 200 then avatar.OrderInLayer = 200 end
		if mapChanged then
			log("[PlayerRender] foreground entity=" .. self.Entity.Name .. " map=" .. map.Name .. " layer=" .. avatar.SortingLayer .. " order=" .. tostring(avatar.OrderInLayer))
		end
	end

	@ExecSpace("ClientOnly")
	method string GetPlayerRenderLayer()
		-- Expose the ordinary foreground layer even while the tutorial owns the actor's order.
		self:EnsurePlayerRenderOrder()
		return self._T.playerRenderLayer or "Default"
	end

	@ExecSpace("ClientOnly")
	method void ApplyPlayerEffectRenderOrder(table options, integer orderOffset)
		-- Keep attached skill effects and status markers above a foreground player avatar.
		if self.Entity.PlayerComponent == nil then return end
		local avatar = self.Entity.AvatarRendererComponent
		if avatar == nil then return end
		self:EnsurePlayerRenderOrder()
		options["SortingLayer"] = avatar.SortingLayer
		options["OrderInLayer"] = avatar.OrderInLayer + math.max(1, orderOffset)
	end

	@ExecSpace("ClientOnly")
	method void ApplySpriteFacing(string unitId, string facing)
		-- Mirrors only sprite-based units. Player avatars continue to use LookDirectionX on the server.
		local renderer = self.Entity.SpriteRendererComponent
		if renderer == nil then
			return
		end
		if facing ~= "Left" and facing ~= "Right" then
			log_warning("[BattleFacing] sprite facing skipped unit=" .. unitId .. " reason=INVALID_FACING facing=" .. facing)
			return
		end

		local shouldFlip = facing == "Right"
		if self.SpriteFacesLeftByDefault == false then
			shouldFlip = facing == "Left"
		end
		renderer.FlipX = shouldFlip
		log("[BattleFacing] sprite applied unit=" .. unitId .. " facing=" .. facing .. " flipX=" .. tostring(shouldFlip))
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string propertyName, any value)
		-- Warm newly equipped cosmetics without delaying damage or changing combat state.
		if propertyName == "OutgoingDamageSkinId" or propertyName == "IncomingDamageSkinId" then
			_DamageSkinDefinitionRepositoryLogic:PreloadSkin(tostring(value))
		end
	end

	@ExecSpace("ServerOnly")
	method table SetDamageSkin(string skinId, boolean incoming)
		-- Internal integration API; any future shop/equipment RPC must validate ownership first.
		local result = _DamageSkinDefinitionRepositoryLogic:GetDefinition(skinId)
		if result.Success == false then return { Success = false, Reason = result.Reason } end
		if incoming then self.IncomingDamageSkinId = skinId else self.OutgoingDamageSkinId = skinId end
		return { Success = true, Reason = "OK", SkinId = skinId }
	end

	@ExecSpace("Client")
	method void PlayDamageNumbers(string unitId, table appliedAmounts, string skinId, boolean playerTarget, number delayPerAttack)
		-- One native call carries all accepted hits so DelayPerAttack spaces their numbers.
		if not isvalid(self.Entity) or appliedAmounts == nil or #appliedAmounts == 0 then return end
		local localPlayer = _UserService.LocalPlayer
		if not isvalid(localPlayer) or localPlayer.CurrentMap ~= self.Entity.CurrentMap then return end
		local damages = {}
		for _, amount in ipairs(appliedAmounts) do
			if type(amount) ~= "number" or amount <= 0 or amount ~= amount then return end
			table.insert(damages, math.max(1, math.floor(amount + 0.5)))
		end
		local repository = _DamageSkinDefinitionRepositoryLogic
		local result = repository:GetPlaybackDefinition(skinId, playerTarget)
		if result.Success == false then
			log_warning("[DamageSkin] skipped unit=" .. unitId .. " reason=" .. result.Reason)
			return
		end
		local definition = result.Definition
		local offset = Vector2(definition.OffsetX + self.DamageNumberOffset.x, definition.OffsetY + self.DamageNumberOffset.y + self.GroundVisualOffsetY)
		-- All optional native arguments are explicit. The existing combat pipeline is integer-valued.
		_DamageSkinService:Play(self.Entity, definition.ResourceRuid, math.max(0, delayPerAttack), damages,
			DamageSkinTweenType.CastFrom(definition.TweenType), false, offset, Vector2(definition.Scale, definition.Scale), definition.PlayRate, definition.Alpha, LitMode.Default)
		log("[DamageSkin] played unit=" .. unitId .. " hits=" .. tostring(#damages) .. " interval=" .. tostring(delayPerAttack))
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		self:ClearStatusMarkers()
		self:CancelFullMotionPlayback("END_PLAY")
		-- Restores every short-lived presentation override owned by this unit.
		self:StopMoveHopVisual("END_PLAY")
		if self.HitFlashTimerId > 0 then
			_TimerService:ClearTimer(self.HitFlashTimerId)
			self.HitFlashTimerId = 0
		end
		if self.HitStopTimerId > 0 then
			_TimerService:ClearTimer(self.HitStopTimerId)
			self.HitStopTimerId = 0
		end
		if self.HitReactionMidTimerId > 0 then
			_TimerService:ClearTimer(self.HitReactionMidTimerId)
			self.HitReactionMidTimerId = 0
		end
		if self.HitReactionRestoreTimerId > 0 then
			_TimerService:ClearTimer(self.HitReactionRestoreTimerId)
			self.HitReactionRestoreTimerId = 0
		end
		local impactRenderer = self:GetImpactSpriteRenderer()
		if impactRenderer ~= nil then
			if self.HasOriginalSpriteColor then
				impactRenderer.Color = self.OriginalSpriteColor
			end
			if self.HasOriginalImpactPlayRate then
				impactRenderer.PlayRate = self.OriginalImpactPlayRate
			end
		end
		local visualEntity = self:GetImpactVisualEntity()
		if self.HasOriginalVisualScale and isvalid(visualEntity) and visualEntity.TransformComponent ~= nil then
			visualEntity.TransformComponent.Scale = self.OriginalVisualScale
		end
		if self.MotionTimerId > 0 then
			_TimerService:ClearTimer(self.MotionTimerId)
			self.MotionTimerId = 0
		end
		self.CombatMotionHandoffPending = false
		self.CombatMotionReady = false
		self.CombatMotionReleaseRequested = false
		self.CombatMotionUnitId = ""
		self.CombatMotionKey = ""
		if self.DeathMotionTimerId > 0 then
			_TimerService:ClearTimer(self.DeathMotionTimerId)
			self.DeathMotionTimerId = 0
		end
		self.DeathMotionActive = false
		self:StopSpriteMotion(self.Entity.Name, "END_PLAY")
	end

	@ExecSpace("ClientOnly")
	method void OnMapLeave(Entity previousMap)
		-- Clear map-local render settings before the next map resolves its own foreground layer.
		self._T.playerRenderMap = nil
		self._T.playerRenderLayer = nil
		self:ClearStatusMarkers()
		-- A transferred avatar must not retain event handlers, queued poses or death state from the old board.
		self:CancelCombatMotionHandoff(self.Entity.Name, "MAP_LEAVE", false)
		self:StopMoveHopVisual("MAP_LEAVE")
		if self.DeathMotionTimerId > 0 then _TimerService:ClearTimer(self.DeathMotionTimerId) end
		self.DeathMotionTimerId = 0
		self.DeathMotionActive = false
		self.DeathMotionCompleted = false
	end

	method void OnMapEnter(Entity enteredMap)
		-- Lobby entry restores the avatar even while the previous battle's dead flag is still synchronized.
		self:DisablePlayerAutomaticRenderLayer()
		if self:IsServer() then return end
		self:EnsurePlayerRenderOrder()
		self._T.confirmedDeathAwaitSync = false
		local found, clear = pcall(function() return self.ClearLocalGridMoveOffset end)
		if found and type(clear) == "function" then pcall(clear, self) end
		if isvalid(enteredMap) and enteredMap.Name == "lobby" then
			self:RestoreAvatarDeathMotion("LOBBY_ENTER")
		end
	end

	@ExecSpace("ClientOnly")
	method void RestoreAvatarDeathMotion(string reason)
		-- Clear only an outstanding death presentation; ordinary HP sync must not interrupt attacks.
		local avatar = self.Entity.AvatarRendererComponent
		if avatar == nil or self.Entity.PlayerComponent == nil then return end
		local body = avatar:GetBodyEntity()
		if isvalid(body) == false then return end
		local selector = body.AvatarBodyActionSelectorComponent
		local hasDeathPose = selector ~= nil and selector.ActionState == MapleAvatarBodyActionState.Dead
		if hasDeathPose == false and self.DeathMotionActive == false and self.DeathMotionCompleted == false then return end
		self:CancelCombatMotionHandoff(self.Entity.Name, reason, false)
		if self.DeathMotionTimerId > 0 then _TimerService:ClearTimer(self.DeathMotionTimerId) end
		self.DeathMotionTimerId = 0
		self.DeathMotionActive = false
		self.DeathMotionCompleted = false
		local resetEvent = BodyActionStateChangeEvent()
		resetEvent.ActionState = MapleAvatarBodyActionState.Stand
		resetEvent.needResetAction = true
		self.Entity:SendEvent(resetEvent)
		log("[AvatarRevive] death motion restored reason=" .. reason)
	end

	@ExecSpace("ClientOnly")
	method number GetLocalMotionSpeed()
		-- Read the synchronized battle speed without making a client-to-server call.
		local map = self.Entity.CurrentMap
		local session = isvalid(map) and map:GetComponent("script.BattleSessionComponent") or nil
		return session ~= nil and math.max(0.1, session.SkillSpeedMultiplier) or 1
	end

	@ExecSpace("ClientOnly")
	method boolean IsFullMotionPending()
		-- Handoff poses are already complete; only active playback, queued poses and death holds block actions.
		return self._T.fullMotion ~= nil or (self._T.fullMotionQueue ~= nil and #self._T.fullMotionQueue > 0) or self.DeathMotionActive
	end

	@ExecSpace("ClientOnly")
	method void CancelFullMotionPlayback(string reason)
		-- Invalidates callbacks before disconnecting so replacement/end events cannot complete a newer motion.
		local motion = self._T.fullMotion
		self._T.fullMotion = nil
		self._T.fullMotionQueue = {}
		if motion == nil then return end
		if motion.TimerId > 0 then _TimerService:ClearTimer(motion.TimerId) end
		if motion.FixedDurationTimerId ~= nil then _TimerService:ClearTimer(motion.FixedDurationTimerId) end
		if motion.AttackPoseEndTimerId ~= nil and motion.AttackPoseEndTimerId > 0 then
			_TimerService:ClearTimer(motion.AttackPoseEndTimerId)
		end
		if isvalid(motion.Target) then
			for _, connection in ipairs(motion.Connections) do
				motion.Target:DisconnectEvent(connection.Type, connection.Handler)
			end
		end
		log("[BattleMotionPlayback] cancelled kind=" .. motion.Kind .. " reason=" .. reason)
	end

	@ExecSpace("ClientOnly")
	method void WatchFullMotion(Entity target, string kind, any complete)
		-- Most motions finish their full clip; avatar attacks may trim only the final pose's hold time.
		local motion = { Target = target, Kind = kind, Complete = complete, Connections = {}, TimerId = 0, Started = false, SawLast = false, LastProgress = _UtilLogic.ElapsedSeconds }
		self._T.fullMotion = motion
		local finish = function(reason)
			if self._T.fullMotion ~= motion then return end
			if motion.FixedDurationTimerId ~= nil and reason ~= "HIT_DURATION_END" then return end
			local queue = self._T.fullMotionQueue or {}
			self:CancelFullMotionPlayback(reason)
			self._T.fullMotionQueue = queue
			if kind == "DEATH" and motion.LastFrame ~= nil and target.SpriteRendererComponent ~= nil then
				target.SpriteRendererComponent.StartFrameIndex = math.max(0, motion.LastFrame)
				target.SpriteRendererComponent.EndFrameIndex = math.max(0, motion.LastFrame)
			end
			complete()
			log("[BattleMotionPlayback] completed kind=" .. kind .. " reason=" .. reason)
			while #queue > 0 and self._T.fullMotion == nil and self.DeathMotionActive == false and self.DeathMotionCompleted == false do
				local nextMotion = table.remove(queue, 1)
				nextMotion()
			end
		end
		motion.Finish = finish
		local connect = function(eventType, eventCallback)
			local connection = target:ConnectEvent(eventType, eventCallback)
			table.insert(motion.Connections, { Type = eventType, Handler = connection })
		end
		connect(SpriteAnimPlayerStartEvent, function(event)
			if self._T.fullMotion ~= motion then return end
			motion.Started = true
			motion.LastProgress = _UtilLogic.ElapsedSeconds
		end)
		connect(SpriteAnimPlayerChangeFrameEvent, function(event)
			if self._T.fullMotion ~= motion then return end
			motion.Started = true
			motion.LastProgress = _UtilLogic.ElapsedSeconds
			if motion.ReturnedToFirst and event.FrameIndex ~= 0 then finish("FULL_REVERSE_CYCLE") end
		end)
		connect(SpriteAnimPlayerEndFrameEvent, function(event)
			if self._T.fullMotion ~= motion then return end
			motion.Started = true
			motion.SawLast = true
			motion.LastFrame = event.TotalFrameCount - 1
			motion.LastProgress = _UtilLogic.ElapsedSeconds
			if motion.TrimAttackEndPose == true and event.ReversePlaying == false and motion.AttackPoseEndTimerId == nil then
				-- Defer the reset outside frame dispatch and briefly show the final attack frame.
				log("[BattleMotionPlayback] attack final frame kind=" .. kind .. " frame=" .. tostring(event.FrameIndex) .. " hold=0.1")
				motion.AttackPoseEndTimerId = _TimerService:SetTimerOnce(function()
					finish("ATTACK_END_POSE_RELEASE")
				end, 0.1)
			end
		end)
		connect(SpriteAnimPlayerStartFrameEvent, function(event)
			if self._T.fullMotion ~= motion then return end
			motion.Started = true
			motion.LastProgress = _UtilLogic.ElapsedSeconds
			if motion.SawLast and event.ReversePlaying then motion.ReturnedToFirst = true end
			if motion.SawLast and event.ReversePlaying == false then
				finish("FULL_CYCLE")
			end
		end)
		connect(SpriteAnimPlayerEndEvent, function(event)
			if motion.Started then finish("ANIMATION_END") end
		end)
		local checkProgress = nil
		checkProgress = function()
			if self._T.fullMotion ~= motion then return end
			if _UtilLogic.ElapsedSeconds - motion.LastProgress >= 30 then
				log_warning("[BattleMotionPlayback] no animation progress kind=" .. kind .. " fallback=RELEASE")
				finish("NO_PROGRESS_TIMEOUT")
				return
			end
			motion.TimerId = _TimerService:SetTimerOnce(checkProgress, 1)
		end
		motion.TimerId = _TimerService:SetTimerOnce(checkProgress, 1)
	end

	@ExecSpace("ClientOnly")
	method void SetHitMotionDuration()
		-- Each hit owns 0.5 seconds of display time, independent of skill speed and clip length.
		local motion = self._T.fullMotion
		if motion == nil then return end
		motion.FixedDurationTimerId = _TimerService:SetTimerOnce(function()
			if self._T.fullMotion ~= motion then return end
			motion.Finish("HIT_DURATION_END")
		end, 0.5)
		log("[BattleMotionPlayback] hit display started kind=" .. motion.Kind .. " duration=0.5")
	end

	@ExecSpace("ClientOnly")
	method Entity GetImpactVisualEntity()
		-- Avatar feedback targets the rendered body child; sprite enemies use their own visual entity.
		if self.Entity.SpriteRendererComponent ~= nil then
			return self.Entity
		end
		local avatarRenderer = self.Entity.AvatarRendererComponent
		if avatarRenderer ~= nil then
			local body = avatarRenderer:GetBodyEntity()
			if isvalid(body) then
				return body
			end
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method Entity GetMoveVisualEntity()
		-- Avatar units use their visual child. Sprite units animate only their client replica;
		-- authoritative CellIndex and the server Transform are never changed by PlayMoveHop.
		local avatarRenderer = self.Entity.AvatarRendererComponent
		if avatarRenderer ~= nil then
			local avatarRoot = avatarRenderer:GetAvatarRootEntity()
			if isvalid(avatarRoot) then
				return avatarRoot
			end
		end
		if self.Entity.SpriteRendererComponent ~= nil then
			return self.Entity
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method void StartMoveHopAnimation(table state, string animationRuid, number animationPlayRate)
		-- Starts the existing avatar Fall action or the configured enemy jump clip without physics/state mutation.
		local safePlayRate = math.max(0.1, animationPlayRate)
		local avatarRenderer = self.Entity.AvatarRendererComponent
		if avatarRenderer ~= nil then
			if self.CombatMotionKey == "HIT" then
				self:CancelCombatMotionHandoff(tostring(state.UnitId), "MOVE_STARTED", false)
			end
			local jumpEvent = BodyActionStateChangeEvent()
			jumpEvent.ActionState = MapleAvatarBodyActionState.Fall
			jumpEvent.needResetAction = true
			jumpEvent.playRate = safePlayRate
			self.Entity:SendEvent(jumpEvent)
			state.AnimationKind = "AVATAR"
			state.AnimationRuid = ""
			log("[MoveHopAnimation] started unit=" .. tostring(state.UnitId)
				.. " kind=AVATAR action=Fall rate=" .. tostring(safePlayRate))
			return
		end

		local renderer = self.Entity.SpriteRendererComponent
		if renderer == nil or animationRuid == "" then
			state.AnimationKind = "NONE"
			log("[MoveHopAnimation] skipped unit=" .. tostring(state.UnitId) .. " reason=ANIMATION_UNAVAILABLE")
			return
		end

		state.AnimationKind = "SPRITE"
		state.AnimationRuid = animationRuid
		state.SpriteRenderer = renderer
		state.BaseSpriteRuid = renderer.SpriteRUID
		state.BaseSpritePlayRate = renderer.PlayRate
		renderer.SpriteRUID = animationRuid
		renderer.PlayRate = safePlayRate
		local unit = self.Entity:GetComponent("script.BattleUnitComponent")
		if unit ~= nil then
			self:ApplySpriteFacing(unit.UnitId, unit.Facing)
		end
		log("[MoveHopAnimation] started unit=" .. tostring(state.UnitId)
			.. " kind=SPRITE ruid=" .. animationRuid
			.. " rate=" .. tostring(safePlayRate))
	end

	@ExecSpace("ClientOnly")
	method void RestoreMoveHopAnimation(table state, string reason)
		-- Restores only the movement animation still owned by this hop instance.
		if state == nil or state.AnimationKind == nil or state.AnimationKind == "NONE" then
			return
		end

		if state.AnimationKind == "AVATAR" then
			if isvalid(self.Entity) and self.Entity.AvatarRendererComponent ~= nil then
				local standEvent = BodyActionStateChangeEvent()
				standEvent.ActionState = MapleAvatarBodyActionState.Stand
				standEvent.needResetAction = true
				self.Entity:SendEvent(standEvent)
				log("[MoveHopAnimation] restored unit=" .. tostring(state.UnitId)
					.. " kind=AVATAR action=Stand reason=" .. tostring(reason))
			end
			return
		end

		local renderer = state.SpriteRenderer
		if isvalid(self.Entity) and renderer ~= nil and renderer.SpriteRUID == state.AnimationRuid then
			renderer.SpriteRUID = state.BaseSpriteRuid
			renderer.PlayRate = state.BaseSpritePlayRate
			local unit = self.Entity:GetComponent("script.BattleUnitComponent")
			if unit ~= nil then
				self:ApplySpriteFacing(unit.UnitId, unit.Facing)
			end
			log("[MoveHopAnimation] restored unit=" .. tostring(state.UnitId)
				.. " kind=SPRITE ruid=" .. tostring(state.BaseSpriteRuid)
				.. " reason=" .. tostring(reason))
		end
	end

	@ExecSpace("ClientOnly")
	method void SetLocalGridMoveOffset(number offsetX, number offsetY)
		-- Prediction moves only the avatar child; server Position and BoardState remain authoritative.
		-- offsetY cancels the root's y jitter from server position writes; the hop arc is layered on top of it.
		local visualEntity = self:GetMoveVisualEntity()
		if isvalid(visualEntity) == false or visualEntity == self.Entity or visualEntity.TransformComponent == nil then return end
		local state = self._T.localGridMoveVisual
		if state == nil or state.Entity ~= visualEntity then
			state = { Entity = visualEntity, BaseX = visualEntity.TransformComponent.Position.x, OffsetX = 0, OffsetY = 0 }
			self._T.localGridMoveVisual = state
		end
		local position = visualEntity.TransformComponent.Position
		local nextOffsetY = offsetY or 0
		visualEntity.TransformComponent.Position = Vector3(state.BaseX + offsetX, position.y - state.OffsetY + nextOffsetY, position.z)
		state.OffsetX = offsetX
		state.OffsetY = nextOffsetY
	end

	@ExecSpace("ClientOnly")
	method void ClearLocalGridMoveOffset()
		local hop = self._T.moveHopVisual
		-- A landed hop only has its ground squash left; let it finish instead of popping the scale back.
		if hop ~= nil and hop.LocalPrediction and not hop.Landed then self:StopMoveHopVisual("LOCAL_MOVE_FINISHED") end
		local state = self._T.localGridMoveVisual
		if state ~= nil and isvalid(state.Entity) and state.Entity.TransformComponent ~= nil then
			local position = state.Entity.TransformComponent.Position
			state.Entity.TransformComponent.Position = Vector3(state.BaseX, position.y - (state.OffsetY or 0), position.z)
		end
		self._T.localGridMoveVisual = nil
	end

	@ExecSpace("ClientOnly")
	method void BeginLocalGridMoveHop(string unitId, number duration, number height, number takeoffDuration, number landingDuration, number squashXScale, number squashYScale, number landingXScale, number landingYScale, number peakProgress, string animationRuid, number animationPlayRate, integer predictionRequestId)
		self._T.lastPredictedMoveHopRequestId = math.max(self._T.lastPredictedMoveHopRequestId or 0, predictionRequestId or 0)
		self._T.startingPredictedMoveHop = true
		self:PlayMoveHop(unitId, duration, height, takeoffDuration, landingDuration, squashXScale, squashYScale, landingXScale, landingYScale, peakProgress, animationRuid, animationPlayRate, true, predictionRequestId or 0)
		self._T.startingPredictedMoveHop = false
		if self._T.moveHopVisual ~= nil then self._T.moveHopVisual.LocalPrediction = true end
	end

	@ExecSpace("Client")
	method void StopMoveHopVisual(string reason)
		-- Cancels an overlapping cosmetic hop and restores the visual child's exact local transform.
		local state = self._T.moveHopVisual
		if state == nil then
			return
		end

		self._T.moveHopVisual = nil
		state.Cancelled = true
		if state.Tweener ~= nil then
			state.Tweener:Destroy()
		end

		local visualEntity = state.VisualEntity
		if visualEntity ~= nil and isvalid(visualEntity) and visualEntity.TransformComponent ~= nil then
			if state.AnimatePosition then
				if state.PreserveHorizontalPosition then
					local currentPosition = visualEntity.TransformComponent.Position
					visualEntity.TransformComponent.Position = Vector3(currentPosition.x, state.BasePosition.y, currentPosition.z)
				else
					local offset = self._T.localGridMoveVisual
					local offsetX = offset ~= nil and offset.Entity == visualEntity and offset.OffsetX or 0
					local offsetY = offset ~= nil and offset.Entity == visualEntity and offset.OffsetY or 0
					visualEntity.TransformComponent.Position = Vector3(state.BasePosition.x + offsetX, state.BasePosition.y + offsetY, state.BasePosition.z)
				end
			end
			visualEntity.TransformComponent.Scale = state.BaseScale
			visualEntity.TransformComponent.Rotation = state.BaseRotation
		end
		self:RestoreMoveHopAnimation(state, reason)
		log("[CharacterHopVisual] restored unit=" .. tostring(state.UnitId) .. " reason=" .. tostring(reason))
	end

	@ExecSpace("Client")
	method void PlayMoveHop(string unitId, number duration, number height, number takeoffDuration, number landingDuration, number squashXScale, number squashYScale, number landingXScale, number landingYScale, number peakProgress, string animationRuid, number animationPlayRate, boolean animatePosition, integer predictionRequestId)
		if (predictionRequestId or 0) > 0 and self._T.startingPredictedMoveHop ~= true
			and predictionRequestId <= (self._T.lastPredictedMoveHopRequestId or 0) then return end
		-- Shared cosmetic path for avatar and sprite units. It never mutates BattleUnit CellIndex.
		if self._T.fullMotion ~= nil then
			-- Charge displacement may happen during an attack; keep that pose while the server moves the entity.
			return
		end
		self:StopMoveHopVisual("REPLACED")
		-- Server-owned movement already resolved the profile and its full action duration.
		if animatePosition == false then
			if self.DeathMotionActive or self.DeathMotionCompleted then
				return
			end
			self:StopSpriteMotion(unitId, "MOVE_STARTED")
		end
		if animatePosition and self.UseCustomMoveHopProfile then
			if self.CustomMoveHopEnabled == false then
				log("[CharacterHopVisual] skipped unit=" .. unitId .. " reason=CUSTOM_PROFILE_DISABLED")
				return
			end
			duration = self.CustomMoveHopDuration
			height = self.CustomMoveHopHeight
			takeoffDuration = self.CustomMoveHopTakeoffDuration
			landingDuration = self.CustomMoveHopLandingDuration
			squashXScale = self.CustomMoveHopSquashScale.x
			squashYScale = self.CustomMoveHopSquashScale.y
			landingXScale = self.CustomMoveHopLandingScale.x
			landingYScale = self.CustomMoveHopLandingScale.y
			peakProgress = self.CustomMoveHopPeakProgress
			if self.CustomMoveHopAnimationRuid ~= "" then
				animationRuid = self.CustomMoveHopAnimationRuid
				animationPlayRate = self.CustomMoveHopAnimationPlayRate
			end
		end
		local visualEntity = self:GetMoveVisualEntity()
		if visualEntity == nil or isvalid(visualEntity) == false or visualEntity.TransformComponent == nil then
			log_warning("[CharacterHopVisual] skipped unit=" .. unitId .. " reason=VISUAL_ROOT_UNAVAILABLE")
			return
		end

		local totalDuration = math.max(0.12, math.min(0.35, duration))
		if animatePosition == false then
			totalDuration = math.max(0.05, duration)
		end
		local hopHeight = math.max(0, height)
		local hopPeakProgress = math.max(0.45, math.min(0.55, peakProgress))
		local takeoff = math.max(0.02, math.min(0.04, takeoffDuration))
		local landing = math.max(0.03, math.min(0.08, landingDuration))
		-- The arc owns totalDuration; the landing squash runs after touchdown so the body never deforms mid-air.
		local tweenDuration = totalDuration + landing
		local airFraction = totalDuration / tweenDuration
		local takeoffFraction = math.min(0.45, takeoff / totalDuration)
		local transform = visualEntity.TransformComponent
		local basePosition = transform.Position
		local prediction = self._T.localGridMoveVisual
		if prediction ~= nil and prediction.Entity == visualEntity then
			basePosition = Vector3(basePosition.x - prediction.OffsetX, basePosition.y - (prediction.OffsetY or 0), basePosition.z)
		end
		local baseScale = transform.Scale
		local baseRotation = transform.Rotation
		local preserveHorizontalPosition = visualEntity == self.Entity and self.Entity.SpriteRendererComponent ~= nil
		local state = {
			UnitId = unitId,
			VisualEntity = visualEntity,
			BasePosition = basePosition,
			BaseScale = baseScale,
			BaseRotation = baseRotation,
			PreserveHorizontalPosition = preserveHorizontalPosition,
			AnimatePosition = animatePosition,
			Tweener = nil,
			Cancelled = false
		}
		self._T.moveHopVisual = state
		self:StartMoveHopAnimation(state, animationRuid, animationPlayRate)
		-- The tween only paces the callbacks. Progress comes from the frame clock that the local grid
		-- prediction also reads, so the arc and the horizontal step never drift a frame apart.
		local startTime = _UtilLogic.ElapsedSeconds

		local tweener = _TweenLogic:PlayTween(0, 1, tweenDuration, EaseType.Linear, function(progress)
			if state.Cancelled then
				return
			end
			if visualEntity == nil or isvalid(visualEntity) == false or visualEntity.TransformComponent == nil then
				state.Cancelled = true
				return
			end

			local clampedProgress = math.max(0, math.min(1, (_UtilLogic.ElapsedSeconds - startTime) / tweenDuration))
			local airProgress = math.min(1, clampedProgress / math.max(0.001, airFraction))
			-- Two half-sine segments keep the peak configurable while reacting on the first tween frame.
			local yOffset = 0
			if airProgress >= 1 then
				yOffset = 0
			elseif airProgress <= hopPeakProgress then
				local riseProgress = airProgress / math.max(0.001, hopPeakProgress)
				yOffset = math.sin(riseProgress * math.pi * 0.5) * hopHeight
			else
				local fallProgress = (airProgress - hopPeakProgress) / math.max(0.001, 1 - hopPeakProgress)
				yOffset = math.cos(fallProgress * math.pi * 0.5) * hopHeight
			end

			local takeoffWeight = 0
			local landingWeight = 0
			if airProgress < takeoffFraction then
				local takeoffProgress = airProgress / math.max(0.001, takeoffFraction)
				takeoffWeight = math.sin(math.pi * takeoffProgress)
			elseif airProgress >= 1 then
				if not state.Landed then
					-- Touchdown: switch back to the standing pose before the ground squash plays.
					state.Landed = true
					self:RestoreMoveHopAnimation(state, "LANDED")
					state.AnimationKind = "NONE"
				end
				local landingProgress = (clampedProgress - airFraction) / math.max(0.001, 1 - airFraction)
				landingWeight = math.sin(math.pi * landingProgress)
			end

			local scaleXMultiplier = 1 + ((squashXScale - 1) * takeoffWeight) + ((landingXScale - 1) * landingWeight)
			local scaleYMultiplier = 1 + ((squashYScale - 1) * takeoffWeight) + ((landingYScale - 1) * landingWeight)
			local scaleX = baseScale.x * scaleXMultiplier
			local scaleY = baseScale.y * scaleYMultiplier
			local currentPosition = visualEntity.TransformComponent.Position
			local offset = self._T.localGridMoveVisual
			local offsetX = offset ~= nil and offset.Entity == visualEntity and offset.OffsetX or 0
			local offsetY = offset ~= nil and offset.Entity == visualEntity and offset.OffsetY or 0
			local visualX = preserveHorizontalPosition and currentPosition.x or basePosition.x + offsetX
			local visualZ = preserveHorizontalPosition and currentPosition.z or basePosition.z
			if animatePosition then
				visualEntity.TransformComponent.Position = Vector3(visualX, basePosition.y + offsetY + yOffset, visualZ)
			end
			visualEntity.TransformComponent.Scale = Vector3(scaleX, scaleY, baseScale.z)
		end)
		state.Tweener = tweener
		tweener:SetOnEndCallback(function()
			if state.Cancelled then
				return
			end
			if visualEntity ~= nil and isvalid(visualEntity) and visualEntity.TransformComponent ~= nil then
				if animatePosition then
					if preserveHorizontalPosition then
						local currentPosition = visualEntity.TransformComponent.Position
						visualEntity.TransformComponent.Position = Vector3(currentPosition.x, basePosition.y, currentPosition.z)
					else
						local offset = self._T.localGridMoveVisual
						local offsetX = offset ~= nil and offset.Entity == visualEntity and offset.OffsetX or 0
						local offsetY = offset ~= nil and offset.Entity == visualEntity and offset.OffsetY or 0
						visualEntity.TransformComponent.Position = Vector3(basePosition.x + offsetX, basePosition.y + offsetY, basePosition.z)
					end
				end
				visualEntity.TransformComponent.Scale = baseScale
				visualEntity.TransformComponent.Rotation = baseRotation
			end
			self:RestoreMoveHopAnimation(state, "COMPLETED")
			if self._T.moveHopVisual == state then
				self._T.moveHopVisual = nil
			end
			log("[CharacterHopVisual] completed unit=" .. unitId .. " duration=" .. tostring(totalDuration) .. " height=" .. tostring(hopHeight))
		end)

		log("[CharacterHopVisual] started unit=" .. unitId
			.. " duration=" .. tostring(totalDuration)
			.. " height=" .. tostring(hopHeight)
			.. " peak=" .. tostring(hopPeakProgress)
			.. " takeoff=" .. tostring(takeoff)
			.. " landing=" .. tostring(landing)
			.. " target=" .. (preserveHorizontalPosition and "SPRITE_ROOT" or "VISUAL_CHILD"))
	end

	@ExecSpace("ClientOnly")
	method any GetImpactSpriteRenderer()
		local visualEntity = self:GetImpactVisualEntity()
		if isvalid(visualEntity) and visualEntity.SpriteRendererComponent ~= nil then
			return visualEntity.SpriteRendererComponent
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method void ResetConfirmedDeathPresentation()
		self._T.confirmedDeathAwaitSync = false
	end

	@ExecSpace("ClientOnly")
	method void PlayConfirmedDeathPresentation(string unitId, string team)
		-- Start from the authoritative death RPC even when IsDead synchronization has not arrived yet.
		self:RefreshDefeatedDisplay(unitId, team, true)
		local unit = self.Entity:GetComponent("script.BattleUnitComponent")
		self._T.confirmedDeathAwaitSync = unit == nil or unit.IsDead ~= true
	end

	@ExecSpace("ClientOnly")
	method void RefreshDefeatedDisplay(string unitId, string team, boolean isDead)
		-- Airborne bosses use the same visibility boundary while remaining alive in the turn order.
		if isDead then
			self._T.confirmedDeathAwaitSync = false
		elseif self._T.confirmedDeathAwaitSync then
			-- HP/Team updates may arrive before IsDead; they must not cancel a death already dispatched.
			isDead = true
		end
		if team ~= "Enemy" then
			local currentMap = self.Entity.CurrentMap
			if self.Entity.PlayerComponent ~= nil and isvalid(currentMap) and currentMap.Name == "lobby" then
				self:RestoreAvatarDeathMotion("LOBBY_SYNC")
				return
			end
			if isDead and self.DeathMotionActive == false and self.DeathMotionCompleted == false and self.Entity.AvatarRendererComponent ~= nil then
				self:CancelCombatMotionHandoff(unitId, "DEATH_STARTED", false)
				local body = self.Entity.AvatarRendererComponent:GetBodyEntity()
				if isvalid(body) then
					self.DeathMotionActive = true
					self:WatchFullMotion(body, "AVATAR_DEATH", function()
						self.DeathMotionActive = false
						self.DeathMotionCompleted = true
					end)
					local deathEvent = BodyActionStateChangeEvent()
					deathEvent.ActionState = MapleAvatarBodyActionState.Dead
					deathEvent.needResetAction = true
					deathEvent.playRate = self:GetLocalMotionSpeed()
					self.Entity:SendEvent(deathEvent)
				end
			elseif isDead == false then
				self:RestoreAvatarDeathMotion("UNIT_ALIVE")
				self.DeathMotionActive = false
				self.DeathMotionCompleted = false
			end
			return
		end
		local unit = self.Entity:GetComponent("script.BattleUnitComponent")
		local isAirborne = unit ~= nil and unit.IsAirborne == true
		local shouldEnable = isDead == false and isAirborne == false
		if isDead then
			self:StopMoveHopVisual("UNIT_DEFEATED")
			self:PlayDeathMotion(unitId)
		else
			if self.DeathMotionTimerId > 0 then
				_TimerService:ClearTimer(self.DeathMotionTimerId)
				self.DeathMotionTimerId = 0
			end
			self.DeathMotionActive = false
			self.DeathMotionCompleted = false
		end

		if self.Entity.SpriteRendererComponent ~= nil then
			if isDead == false or self.DeathMotionRuid == "" then
				self.Entity.SpriteRendererComponent.Enable = shouldEnable
			end
		end

		log("[BattlePresentation] visibility unit=" .. unitId .. " enabled=" .. tostring(shouldEnable) .. " dead=" .. tostring(isDead) .. " airborne=" .. tostring(isAirborne))
	end

	@ExecSpace("ClientOnly")
	method void PlayDeathMotion(string unitId)
		-- Death owns the renderer until its one-shot duration ends; repeated syncs cannot restart it.
		if self.DeathMotionActive or self.DeathMotionCompleted then
			return
		end
		self:CancelFullMotionPlayback("DEATH_STARTED")
		self:StopSpriteMotion(unitId, "DEATH_STARTED")
		local renderer = self.Entity.SpriteRendererComponent
		if renderer == nil or self.DeathMotionRuid == "" then
			if renderer ~= nil then
				renderer.Enable = false
			end
			self.DeathMotionCompleted = true
			return
		end
		self.DeathMotionActive = true
		self:WatchFullMotion(self.Entity, "DEATH", function()
			self.DeathMotionTimerId = _TimerService:SetTimerOnce(function()
				self.DeathMotionTimerId = 0
				self.DeathMotionActive = false
				self.DeathMotionCompleted = true
				if isvalid(self.Entity) and self.Entity.SpriteRendererComponent ~= nil then
					self.Entity.SpriteRendererComponent.Enable = false
					self.Entity.SpriteRendererComponent.StartFrameIndex = 0
					self.Entity.SpriteRendererComponent.EndFrameIndex = 2147483647
				end
				log("[EnemyDeathMotion] completed unit=" .. unitId)
			end, math.max(0, self.DeathMotionHoldDuration) / self:GetLocalMotionSpeed())
		end)
		renderer.Enable = true
		renderer.SpriteRUID = self.DeathMotionRuid
		renderer.PlayRate = math.max(0.1, self.DeathMotionPlayRate) * self:GetLocalMotionSpeed()
		local unit = self.Entity:GetComponent("script.BattleUnitComponent")
		if unit ~= nil then
			self:ApplySpriteFacing(unit.UnitId, unit.Facing)
		end
		log("[EnemyDeathMotion] started unit=" .. unitId .. " ruid=" .. self.DeathMotionRuid .. " completion=ANIMATION_END")
	end

	@ExecSpace("Client")
	method void PlayHitFlash(string unitId, number hitFlashDuration)
		-- Restarts one configurable sprite tint flash without changing combat state.
		local renderer = self:GetImpactSpriteRenderer()
		if renderer == nil then
			log_warning("[BattlePresentation] hit flash skipped unit=" .. unitId .. " reason=SPRITE_RENDERER_MISSING")
			return
		end

		if self.HasOriginalSpriteColor == false then
			self.OriginalSpriteColor = renderer.Color
			self.HasOriginalSpriteColor = true
		end

		if self.HitFlashTimerId > 0 then
			_TimerService:ClearTimer(self.HitFlashTimerId)
			self.HitFlashTimerId = 0
		end

		renderer.Color = self.HitFlashColor
		log("[BattlePresentation] hit flash started unit=" .. unitId .. " duration=" .. tostring(hitFlashDuration))

		local restore = function()
			-- Tint expires independently of hit stop; playback may already have resumed.
			if renderer ~= nil and isvalid(renderer.Entity) then
				renderer.Color = self.OriginalSpriteColor
			end
			self.HitFlashTimerId = 0
			self.HasOriginalSpriteColor = false
			log("[BattlePresentation] hit flash restored unit=" .. unitId)
		end

		local duration = math.max(0.05, math.min(0.08, hitFlashDuration))
		self.HitFlashTimerId = _TimerService:SetTimerOnce(restore, duration)
	end

	@ExecSpace("Client")
	method void PlayHitStop(string unitId, boolean strongHit, number normalHitStopDuration, number strongHitStopDuration)
		-- Freezes only the impacted presentation clip; global time and turn timers keep running.
		local renderer = self:GetImpactSpriteRenderer()
		if renderer == nil then
			return
		end
		if self.HasOriginalImpactPlayRate == false then
			self.OriginalImpactPlayRate = renderer.PlayRate
			self.HasOriginalImpactPlayRate = true
		end
		if self.HitStopTimerId > 0 then
			_TimerService:ClearTimer(self.HitStopTimerId)
			self.HitStopTimerId = 0
		end
		local duration = math.max(0.03, math.min(0.05, normalHitStopDuration))
		if strongHit then
			duration = math.max(0.05, math.min(0.08, strongHitStopDuration))
		end
		renderer.PlayRate = 0
		self.HitStopTimerId = _TimerService:SetTimerOnce(function()
			if renderer ~= nil and isvalid(renderer.Entity) and renderer.PlayRate == 0 then
				renderer.PlayRate = self.OriginalImpactPlayRate
			end
			self.HitStopTimerId = 0
			self.HasOriginalImpactPlayRate = false
			log("[BattlePresentation] hit stop restored unit=" .. unitId)
		end, duration)
		log("[BattlePresentation] hit stop started unit=" .. unitId .. " strong=" .. tostring(strongHit) .. " duration=" .. tostring(duration))
	end

	@ExecSpace("Client")
	method void PlayHitReaction(string unitId, boolean strongHit, number hitReactionDuration)
		-- Squash/stretch never changes Position or the logical BoardState cell.
		local visualEntity = self:GetImpactVisualEntity()
		if isvalid(visualEntity) == false or visualEntity.TransformComponent == nil then
			return
		end
		if self.HasOriginalVisualScale == false then
			self.OriginalVisualScale = visualEntity.TransformComponent.Scale
			self.HasOriginalVisualScale = true
		end
		if self.HitReactionMidTimerId > 0 then
			_TimerService:ClearTimer(self.HitReactionMidTimerId)
			self.HitReactionMidTimerId = 0
		end
		if self.HitReactionRestoreTimerId > 0 then
			_TimerService:ClearTimer(self.HitReactionRestoreTimerId)
			self.HitReactionRestoreTimerId = 0
		end
		local duration = math.max(0.06, math.min(0.10, hitReactionDuration))
		local squash = strongHit and self.StrongHitSquashScale or self.NormalHitSquashScale
		local original = self.OriginalVisualScale
		visualEntity.TransformComponent.Scale = Vector3(original.x * squash.x, original.y * squash.y, original.z)
		self.HitReactionMidTimerId = _TimerService:SetTimerOnce(function()
			if isvalid(visualEntity) and visualEntity.TransformComponent ~= nil then
				local stretchX = strongHit and 0.94 or 0.97
				local stretchY = strongHit and 1.06 or 1.03
				visualEntity.TransformComponent.Scale = Vector3(original.x * stretchX, original.y * stretchY, original.z)
			end
			self.HitReactionMidTimerId = 0
		end, duration * 0.45)
		self.HitReactionRestoreTimerId = _TimerService:SetTimerOnce(function()
			if isvalid(visualEntity) and visualEntity.TransformComponent ~= nil then
				visualEntity.TransformComponent.Scale = original
			end
			self.HitReactionRestoreTimerId = 0
			self.HasOriginalVisualScale = false
			log("[BattlePresentation] hit reaction restored unit=" .. unitId)
		end, duration)
		log("[BattlePresentation] hit reaction started unit=" .. unitId .. " strong=" .. tostring(strongHit) .. " duration=" .. tostring(duration))
	end

	@ExecSpace("Client")
	method void PlayHitImpact(string unitId, boolean strongHit, number normalHitStopDuration, number strongHitStopDuration, number hitReactionDuration, number hitFlashDuration, boolean skipHitMotion)
		-- Multi-hit keeps a brief flash/squash without locking the enemy in a 0.5-second hit clip.
		if skipHitMotion == false and self.DeathMotionActive == false and self.DeathMotionCompleted == false then
			if self.Entity.AvatarRendererComponent ~= nil then
				self:PlayCombatMotion(unitId, "HIT", "", self.HitMotionPlayRate * self:GetLocalMotionSpeed(), self.HitMotionDuration, false)
			elseif self.HitMotionRuid ~= "" then
				self:PlaySpriteMotion(unitId, self.HitMotionRuid, self.HitMotionPlayRate * self:GetLocalMotionSpeed(), self.HitMotionDuration, "", true)
			end
		end
		self:PlayHitStop(unitId, strongHit, normalHitStopDuration, strongHitStopDuration)
		self:PlayHitReaction(unitId, strongHit, hitReactionDuration)
		self:PlayHitFlash(unitId, hitFlashDuration)
	end

	@ExecSpace("Client")
	method void PlayCombatMotion(string unitId, string motionKey, string actionName, number playRate, number duration, boolean waitForServerHandoff)
		-- Plays one avatar action and restores idle on completion, including queued player skills.
		if self._T.fullMotion ~= nil then
			self._T.fullMotionQueue = self._T.fullMotionQueue or {}
			table.insert(self._T.fullMotionQueue, function() self:PlayCombatMotion(unitId, motionKey, actionName, playRate, duration, waitForServerHandoff) end)
			return
		end
		local state = self.Entity.StateComponent
		local avatarRenderer = self.Entity.AvatarRendererComponent
		if state == nil or avatarRenderer == nil then
			log_warning("[BattleMotion] skipped unit=" .. unitId .. " motion=" .. motionKey .. " reason=AVATAR_COMPONENT_MISSING")
			return
		end
		if motionKey == "" then
			log_warning("[BattleMotion] skipped unit=" .. unitId .. " reason=MOTION_KEY_EMPTY")
			return
		end
		local unit = self.Entity:GetComponent("script.BattleUnitComponent")
		if state.CurrentStateName == "DEAD" or (unit ~= nil and unit.IsDead) then
			return
		end
		self:StopMoveHopVisual("COMBAT_MOTION_STARTED")

		if self.MotionTimerId > 0 then
			_TimerService:ClearTimer(self.MotionTimerId)
			self.MotionTimerId = 0
		end
		-- Clear legacy handoff state before starting the next one-shot.
		self.CombatMotionHandoffPending = false
		self.CombatMotionReady = false
		self.CombatMotionReleaseRequested = false
		self.CombatMotionUnitId = ""
		self.CombatMotionKey = ""

		local safePlayRate = math.max(0.1, playRate)
		local safeDuration = math.max(0.1, duration)

		local body = avatarRenderer:GetBodyEntity()
		if isvalid(body) == false then
			log_warning("[BattleMotion] skipped unit=" .. unitId .. " reason=AVATAR_BODY_MISSING")
			return
		end
		-- Keep the RPC argument for existing callers, but never hold a completed pose for server release.
		self.CombatMotionHandoffPending = false
		self.CombatMotionUnitId = unitId
		self.CombatMotionKey = motionKey
		self:WatchFullMotion(body, "AVATAR_" .. motionKey, function()
			self:RestoreCombatMotionState(unitId, motionKey, "ANIMATION_END")
		end)
		-- Hits use a fixed display window; only attacks trim their trailing pose.
		self._T.fullMotion.TrimAttackEndPose = motionKey ~= "HIT"
		if motionKey == "HIT" then self:SetHitMotionDuration() end

		local motionMode = "BUILTIN_BODY_ACTION"
		if actionName == "" then
			local attackEvent = BodyActionStateChangeEvent()
			attackEvent.ActionState = MapleAvatarBodyActionState.Attack
			if motionKey == "HIT" then
				attackEvent.ActionState = MapleAvatarBodyActionState.Hit
			end
			attackEvent.needResetAction = true
			attackEvent.playRate = safePlayRate
			self.Entity:SendEvent(attackEvent)
		else
			motionMode = "CUSTOM_ACTION"
			local actionEvent = ActionStateChangedEvent()
			actionEvent.CoreActionName = actionName
			actionEvent.PartsActionName = actionName
			actionEvent.PlayRate = safePlayRate
			actionEvent.PlayType = SpriteAnimClipPlayType.Onetime
			body:SendEvent(actionEvent)
		end
		log("[BattleMotion] started unit=" .. unitId .. " motion=" .. motionKey .. " mode=" .. motionMode .. " action=" .. actionName .. " rate=" .. safePlayRate .. " duration=" .. safeDuration .. " serverHandoff=" .. tostring(waitForServerHandoff))
	end

	@ExecSpace("ClientOnly")
	method void RestoreCombatMotionState(string unitId, string motionKey, string reason)
		-- A delayed pose reset must never replace a death pose or revive the state machine.
		local canRestore = isvalid(self.Entity)
		if canRestore then
			local unit = self.Entity:GetComponent("script.BattleUnitComponent")
			local state = self.Entity.StateComponent
			canRestore = (unit == nil or unit.IsDead == false) and (state == nil or state.CurrentStateName ~= "DEAD")
		end
		if canRestore then
			if self.Entity.StateComponent ~= nil then
				self.Entity.StateComponent:ChangeState(self.CombatMotionReturnState)
			end
			local resetEvent = BodyActionStateChangeEvent()
			resetEvent.ActionState = MapleAvatarBodyActionState.Stand
			resetEvent.needResetAction = true
			self.Entity:SendEvent(resetEvent)
			log("[BattleMotion] restored unit=" .. unitId .. " motion=" .. motionKey .. " state=" .. self.CombatMotionReturnState .. " reason=" .. reason)
		end
		self.CombatMotionHandoffPending = false
		self.CombatMotionReady = false
		self.CombatMotionReleaseRequested = false
		self.CombatMotionUnitId = ""
		self.CombatMotionKey = ""
	end

	@ExecSpace("Client")
	method void CompleteCombatMotionHandoff(string unitId, string reason)
		if self.CombatMotionHandoffPending == false or self.CombatMotionUnitId ~= unitId then
			return
		end
		self.CombatMotionReleaseRequested = true
		log("[BattleMotionHandoff] release unit=" .. unitId .. " motion=" .. self.CombatMotionKey .. " ready=" .. tostring(self.CombatMotionReady) .. " reason=" .. reason)
		if self.CombatMotionReady then
			self:RestoreCombatMotionState(unitId, self.CombatMotionKey, reason)
		end
	end

	@ExecSpace("Client")
	method void CancelCombatMotionHandoff(string unitId, string reason, boolean restoreToStand)
		self:CancelFullMotionPlayback(reason)
		if self.MotionTimerId > 0 then
			_TimerService:ClearTimer(self.MotionTimerId)
			self.MotionTimerId = 0
		end
		local motionKey = self.CombatMotionKey
		self.CombatMotionHandoffPending = false
		self.CombatMotionReady = false
		self.CombatMotionReleaseRequested = false
		self.CombatMotionUnitId = ""
		self.CombatMotionKey = ""
		if restoreToStand then
			self:RestoreCombatMotionState(unitId, motionKey, reason)
		end
		log("[BattleMotionHandoff] cancelled unit=" .. unitId .. " restore=" .. tostring(restoreToStand) .. " reason=" .. reason)
	end

	@ExecSpace("ClientOnly")
	method void StopSpriteMotion(string unitId, string reason)
		-- Cancels one temporary sprite motion and restores the enemy's canonical idle clip.
		if self.SpriteMotionTimerId > 0 then
			_TimerService:ClearTimer(self.SpriteMotionTimerId)
			self.SpriteMotionTimerId = 0
		end
		if self.HasOriginalSpriteMotion == false then
			return
		end
		local renderer = self.Entity.SpriteRendererComponent
		if renderer ~= nil then
			if self.IdleMotionRuid ~= "" then
				renderer.SpriteRUID = self.IdleMotionRuid
				renderer.PlayRate = math.max(0.1, self.IdleMotionPlayRate)
			else
				renderer.SpriteRUID = self.OriginalSpriteRuid
				renderer.PlayRate = self.OriginalSpritePlayRate
			end
			local unit = self.Entity:GetComponent("script.BattleUnitComponent")
			if unit ~= nil then
				self:ApplySpriteFacing(unit.UnitId, unit.Facing)
			end
		end
		self.HasOriginalSpriteMotion = false
		log("[BattleSpriteMotion] cancelled unit=" .. unitId .. " reason=" .. reason .. " restoredRate=" .. tostring(renderer ~= nil and renderer.PlayRate or 0))
	end

	@ExecSpace("Client")
	method void ApplyPhaseIdleMotion(string idleRuid, number playRate)
		-- Invalidates queued old-form animations and makes the phase change visible immediately.
		if idleRuid == "" or self.Entity.SpriteRendererComponent == nil then return end
		self:CancelFullMotionPlayback("BOSS_PHASE_CHANGED")
		self.IdleMotionRuid = idleRuid
		self.IdleMotionPlayRate = math.max(0.1, playRate)
		local unit = self.Entity:GetComponent("script.BattleUnitComponent")
		local unitId = unit ~= nil and unit.UnitId or ""
		self:StopSpriteMotion(unitId, "BOSS_PHASE_CHANGED")
		self.Entity.SpriteRendererComponent.SpriteRUID = idleRuid
		self.Entity.SpriteRendererComponent.PlayRate = self.IdleMotionPlayRate
		if unit ~= nil then self:ApplySpriteFacing(unitId, unit.Facing) end
		log("[BossPhaseMotion] visible unit=" .. unitId .. " idle=" .. idleRuid)
	end

	@ExecSpace("Client")
	method void PlaySpriteMotion(string unitId, string motionRuid, number playRate, number duration, string facingOverride, boolean isHitMotion)
		-- Sprite-based enemies opt into one-shot attack or movement-action motion through data.
		-- Hits restore idle after 0.5 seconds; other motions finish their actual playback cycle.
		local renderer = self.Entity.SpriteRendererComponent
		if renderer == nil then
			log_warning("[BattleSpriteMotion] skipped unit=" .. unitId .. " reason=SPRITE_RENDERER_MISSING")
			return
		end
		if motionRuid == "" then
			return
		end
		if self.DeathMotionActive or self.DeathMotionCompleted then
			return
		end
		if self._T.fullMotion ~= nil then
			self._T.fullMotionQueue = self._T.fullMotionQueue or {}
			table.insert(self._T.fullMotionQueue, function() self:PlaySpriteMotion(unitId, motionRuid, playRate, duration, facingOverride, isHitMotion) end)
			return
		end
		self:StopMoveHopVisual("SPRITE_MOTION_STARTED")
		self:StopSpriteMotion(unitId, "REPLACED")
		self.OriginalSpriteRuid = self.IdleMotionRuid ~= "" and self.IdleMotionRuid or renderer.SpriteRUID
		self.OriginalSpritePlayRate = self.IdleMotionRuid ~= "" and math.max(0.1, self.IdleMotionPlayRate) or renderer.PlayRate
		self.HasOriginalSpriteMotion = true

		local safePlayRate = math.max(0.1, playRate)
		local safeDuration = math.max(0.1, duration)
		self:WatchFullMotion(self.Entity, "SPRITE", function()
			self:StopSpriteMotion(unitId, "ANIMATION_END")
		end)
		if isHitMotion then self:SetHitMotionDuration() end
		renderer.SpriteRUID = motionRuid
		renderer.PlayRate = safePlayRate
		local unit = self.Entity:GetComponent("script.BattleUnitComponent")
		if facingOverride == "Left" or facingOverride == "Right" then
			self:ApplySpriteFacing(unitId, facingOverride)
		elseif unit ~= nil then
			self:ApplySpriteFacing(unit.UnitId, unit.Facing)
		end
		log("[BattleSpriteMotion] started unit=" .. unitId .. " ruid=" .. motionRuid .. " rate=" .. safePlayRate .. " duration=" .. safeDuration)

	end

	@ExecSpace("Client")
	method void PlaySkillEffect(string unitId, string phase, string effectRuid, number scale, boolean flipX, number playRate)
		-- Plays one non-looping skill animation clip anchored to this unit. Purely presentational:
		-- it never touches HP, cell occupancy, or turn state, so a missing RUID only costs the visual.
		if effectRuid == "" then
			return
		end

		local safeScale = math.max(0.05, scale)
		local safePlayRate = math.max(0.1, playRate)
		local options = {}
		-- Skill effect art faces left by default, so flip only when the caster looks right.
		options["FlipX"] = flipX
		options["SortingLayer"] = self.SkillEffectSortingLayer
		options["OrderInLayer"] = self.SkillEffectOrderInLayer
		self:ApplyPlayerEffectRenderOrder(options, self.SkillEffectOrderInLayer)
		_TutorialPresentationLogic:ApplyEffectHighlight(options)
		-- Matches the clip to the skill speed so the effect finishes with the swing, not after it.
		options["PlayRate"] = safePlayRate

		local serial = _EffectService:PlayEffectAttached(
			effectRuid,
			self.Entity,
			Vector3(0, self.SkillEffectOffsetY, 0),
			0,
			Vector3(safeScale, safeScale, 1),
			false,
			options
		)
		if serial == 0 then
			log_warning("[BattleEffect] failed unit=" .. unitId .. " phase=" .. phase .. " ruid=" .. effectRuid .. " reason=PLAY_EFFECT_RETURNED_ZERO")
			return
		end
		log("[BattleEffect] played unit=" .. unitId .. " phase=" .. phase .. " ruid=" .. effectRuid .. " scale=" .. safeScale .. " rate=" .. safePlayRate .. " flipX=" .. tostring(flipX) .. " serial=" .. serial)
	end

	@ExecSpace("Client")
	method void PlaySkillEffectFrames(string unitId, string phase, string frameRuids, number scale, boolean flipX, number frameDuration)
		-- Shows a `|`-separated list of static sprites one after another, each held for frameDuration, as a
		-- flipbook for packs that ship frames instead of an animation clip. Purely presentational.
		local frames = {}
		for ruid in string.gmatch(frameRuids or "", "([^|]+)") do
			table.insert(frames, ruid)
		end
		if #frames == 0 then
			return
		end
		local safeScale = math.max(0.05, scale)
		local step = math.max(0.03, frameDuration)
		local options = {}
		options["FlipX"] = flipX
		options["SortingLayer"] = self.SkillEffectSortingLayer
		options["OrderInLayer"] = self.SkillEffectOrderInLayer
		self:ApplyPlayerEffectRenderOrder(options, self.SkillEffectOrderInLayer)
		_TutorialPresentationLogic:ApplyEffectHighlight(options)
		for index, ruid in ipairs(frames) do
			local frameRuid = ruid
			_TimerService:SetTimerOnce(function()
				if isvalid(self.Entity) == false then
					return
				end
				-- Looping keeps a static sprite on screen until this frame's slot ends and it is removed.
				local serial = _EffectService:PlayEffectAttached(frameRuid, self.Entity, Vector3(0, self.SkillEffectOffsetY, 0), 0, Vector3(safeScale, safeScale, 1), true, options)
				if serial == 0 then
					log_warning("[BattleEffect] frame failed unit=" .. unitId .. " phase=" .. phase .. " ruid=" .. frameRuid)
					return
				end
				_TimerService:SetTimerOnce(function() _EffectService:RemoveEffect(serial) end, step)
			end, math.max(0.001, (index - 1) * step))
		end
		log("[BattleEffect] frames played unit=" .. unitId .. " phase=" .. phase .. " frames=" .. #frames .. " frameDuration=" .. step)
	end

	@ExecSpace("ClientOnly")
	method void ClearStatusMarkers()
		for _, serial in ipairs(self._T.statusMarkerSerials or {}) do _EffectService:RemoveEffect(serial) end
		self._T.statusMarkerSerials = {}
		self._T.statusMarkerRuid = nil
		self._T.confusionMarkerActive = false
		self._T.confusionMarkerVersion = (self._T.confusionMarkerVersion or 0) + 1
	end

	@ExecSpace("Client")
	method void ShowConfusionMarker()
		local unit = self.Entity:GetComponent("script.BattleUnitComponent")
		if unit == nil or unit.IsDead then return end
		self._T.confusionMarkerActive = true
		self._T.confusionMarkerVersion = (self._T.confusionMarkerVersion or 0) + 1
		local version = self._T.confusionMarkerVersion
		unit:RefreshStatusMarker()
		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) or self._T.confusionMarkerVersion ~= version then return end
			self._T.confusionMarkerActive = false
			unit:RefreshStatusMarker()
		end, 1.2)
	end

	@ExecSpace("ClientOnly")
	method number GetStatusMarkerOffsetY()
		-- Small monsters otherwise show the row far above their head and tall bosses show it inside the body.
		local unit = self.Entity:GetComponent("script.BattleUnitComponent")
		if unit ~= nil and unit.Team == "Player" then
			return self.PlayerStatusMarkerOffsetY
		end
		local anchor = self.Entity:GetChildByName(self.HeadAnchorChildName, false)
		if isvalid(anchor) and anchor.TransformComponent ~= nil then
			return anchor.TransformComponent.Position.y + self.StatusMarkerHeadGap
		end
		return self.StatusMarkerOffsetY
	end

	@ExecSpace("ClientOnly")
	method void RefreshStatusMarker(string unitId, string markerRuid, boolean active)
		-- Render concurrent statuses in a centered row instead of hiding poison/burn behind a stun.
		if not active then self:ClearStatusMarkers(); return end
		local wanted = markerRuid or ""
		-- The brief turn-flash reuses the confusion icon; skip it when a lasting confusion already shows it.
		if self._T.confusionMarkerActive and not string.find(wanted, "086dfcf2a666440e92e2d15ed35a9275", 1, true) then
			wanted = wanted .. (wanted ~= "" and "|" or "") .. "086dfcf2a666440e92e2d15ed35a9275"
		end
		if self._T.statusMarkerRuid == wanted then return end
		for _, serial in ipairs(self._T.statusMarkerSerials or {}) do _EffectService:RemoveEffect(serial) end
		self._T.statusMarkerSerials = {}
		self._T.statusMarkerRuid = wanted
		local markers = {}
		for ruid in string.gmatch(wanted, "([^|]+)") do table.insert(markers, ruid) end
		local options = {}
		-- Status markers sit above actors (MapLayer2 / 100), below screen-space equipment UI.
		options["SortingLayer"] = "MapLayer2"
		options["OrderInLayer"] = 101
		self:ApplyPlayerEffectRenderOrder(options, 1)
		local scale = math.max(0.05, self.StatusMarkerScale)
		local offsetY = self:GetStatusMarkerOffsetY()
		for index, ruid in ipairs(markers) do
			local x = (index - (#markers + 1) / 2) * 0.45
			local serial = _EffectService:PlayEffectAttached(ruid, self.Entity, Vector3(x, offsetY, 0), 0, Vector3(scale, scale, 1), true, options)
			if serial ~= 0 then
				table.insert(self._T.statusMarkerSerials, serial)
			else
				log_warning("[BattleStatusMarker] failed unit=" .. unitId .. " ruid=" .. ruid)
			end
		end
		log("[BattleStatusMarker] updated unit=" .. unitId .. " markers=" .. wanted)
	end

	@ExecSpace("Client")
	method void PlaySkillSound(string unitId, string phase, string soundRuid, number volume)
		-- Plays one authored skill sound for this unit's cast or impact frame. Deliberately 2D
		-- (`PlaySound`, not a positional SoundComponent): the board is always fully on screen, so a
		-- distance-attenuated cue would only make the far column quieter for no gameplay reason.
		-- Purely presentational, so an unauthored RUID costs the cue and nothing else.
		if soundRuid == "" then
			return
		end

		-- The player's skill / monster sound sliders scale the authored volume on this client only.
		local unit = self.Entity:GetComponent("script.BattleUnitComponent")
		local category = _GameSettingsLogic:GetBattleSoundCategory(phase, unit ~= nil and unit.Team or "")
		local safeVolume = math.max(0, math.min(1, volume * _GameSettingsLogic:GetVolumeScale(category)))
		if safeVolume <= 0 then
			return
		end
		_SoundService:PlaySound(soundRuid, safeVolume)
		log("[BattleSkillSound] played unit=" .. unitId .. " phase=" .. phase .. " category=" .. category .. " ruid=" .. soundRuid .. " volume=" .. safeVolume)
	end

end
