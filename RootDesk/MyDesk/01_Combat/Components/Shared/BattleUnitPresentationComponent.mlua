@Component
script BattleUnitPresentationComponent extends Component

	property string HpTextChildName = "BattleHpText"
	property string HpTextFont = "Maple"
	property number HpTextFontSize = 1.2
	property Color HpTextColor = Color(1, 1, 1, 1)
	property Vector2 HpTextOffset = Vector2(0, 0)
	property Vector2 HpTextRectSize = Vector2(2.4, 0.5)
	property string HpTextSortingLayer = "MapLayer0"
	property integer HpTextOrderInLayer = 20
	property Color HpTextOutlineColor = Color(0, 0, 0, 1)
	property number HpTextOutlineWidth = 0.18

	property Color HitFlashColor = Color(1, 0.35, 0.35, 1)
	property number HitFlashDuration = 0.18
	property string CombatMotionReturnState = "IDLE"

	-- MapleStory skill clips are authored with their pivot already on the caster/target anchor
	-- (measured: hit clips center at ~0, piercing's cast pivot sits at the forward edge), so the
	-- default nudge is zero. Only override this for a clip that visibly needs repositioning.
	property number SkillEffectOffsetY = 0
	property string SkillEffectSortingLayer = "MapLayer0"
	property integer SkillEffectOrderInLayer = 30

	property string LastDisplayedHp = ""
	property integer HitFlashTimerId = 0
	property integer MotionTimerId = 0
	property integer SpriteMotionTimerId = 0
	property boolean HasOriginalSpriteColor = false
	property Color OriginalSpriteColor = Color(1, 1, 1, 1)
	property boolean HasOriginalSpriteMotion = false
	property string OriginalSpriteRuid = ""
	property number OriginalSpritePlayRate = 1

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- Presentation settings are local-only and never mutate logical battle state.
		log("[BattlePresentation] ready entity=" .. self.Entity.Name .. " flashDuration=" .. self.HitFlashDuration)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self.HitFlashTimerId > 0 then
			_TimerService:ClearTimer(self.HitFlashTimerId)
			self.HitFlashTimerId = 0
		end
		if self.MotionTimerId > 0 then
			_TimerService:ClearTimer(self.MotionTimerId)
			self.MotionTimerId = 0
		end
		if self.SpriteMotionTimerId > 0 then
			_TimerService:ClearTimer(self.SpriteMotionTimerId)
			self.SpriteMotionTimerId = 0
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshHpDisplay(string unitId, string team, number currentHp, number maxHp)
		-- Only entities with the configured child opt in to a world-space HP label.
		if team ~= "Enemy" then
			return
		end

		local hpTextEntity = self.Entity:GetChildByName(self.HpTextChildName, false)
		if isvalid(hpTextEntity) == false or hpTextEntity.TextRendererComponent == nil then
			return
		end

		local displayText = "HP " .. math.floor(currentHp) .. " / " .. math.floor(maxHp)
		if self.LastDisplayedHp == displayText then
			return
		end

		local renderer = hpTextEntity.TextRendererComponent
		renderer.Text = displayText
		renderer.Font = self.HpTextFont
		renderer.FontSize = self.HpTextFontSize
		renderer.FontColor = self.HpTextColor
		renderer.RectOffset = self.HpTextOffset
		renderer.RectSize = self.HpTextRectSize
		renderer.HorizontalAlignment = TextHorizontalAlignmentOption.Center
		renderer.VerticalAlignment = TextVerticalAlignmentOption.Middle
		renderer.SortingLayer = self.HpTextSortingLayer
		renderer.OrderInLayer = self.HpTextOrderInLayer
		renderer.OutlineColor = self.HpTextOutlineColor
		renderer.OutlineWidth = self.HpTextOutlineWidth

		self.LastDisplayedHp = displayText
		log("[BattlePresentation] hp refreshed unit=" .. unitId .. " text=" .. displayText)
	end

	@ExecSpace("ClientOnly")
	method void RefreshDefeatedDisplay(string unitId, string team, boolean isDead)
		-- Airborne bosses use the same visibility boundary while remaining alive in the turn order.
		if team ~= "Enemy" then
			return
		end
		local unit = self.Entity:GetComponent("script.BattleUnitComponent")
		local isAirborne = unit ~= nil and unit.IsAirborne == true
		local shouldEnable = isDead == false and isAirborne == false

		if self.Entity.SpriteRendererComponent ~= nil then
			self.Entity.SpriteRendererComponent.Enable = shouldEnable
		end

		local hpTextEntity = self.Entity:GetChildByName(self.HpTextChildName, false)
		if isvalid(hpTextEntity) and hpTextEntity.TextRendererComponent ~= nil then
			hpTextEntity.TextRendererComponent.Enable = shouldEnable
		end
		log("[BattlePresentation] visibility unit=" .. unitId .. " enabled=" .. tostring(shouldEnable) .. " dead=" .. tostring(isDead) .. " airborne=" .. tostring(isAirborne))
	end

	@ExecSpace("Client")
	method void PlayHitFlash(string unitId)
		-- Restarts one configurable sprite tint flash without changing combat state.
		local renderer = self.Entity.SpriteRendererComponent
		if renderer == nil then
			log_warning("[BattlePresentation] hit flash skipped unit=" .. unitId .. " reason=SPRITE_RENDERER_MISSING")
			return
		end

		if self.HasOriginalSpriteColor == false then
			self.OriginalSpriteColor = renderer.Color
			self.HasOriginalSpriteColor = true
		end

		if self.HitFlashTimerId > 0 then
			_TimerService:ClearTimer(self.HitFlashTimerId)
			self.HitFlashTimerId = 0
		end

		renderer.Color = self.HitFlashColor
		log("[BattlePresentation] hit flash started unit=" .. unitId .. " duration=" .. self.HitFlashDuration)

		local restore = function()
			if isvalid(self.Entity) and self.Entity.SpriteRendererComponent ~= nil then
				self.Entity.SpriteRendererComponent.Color = self.OriginalSpriteColor
			end
			self.HitFlashTimerId = 0
			self.HasOriginalSpriteColor = false
			log("[BattlePresentation] hit flash restored unit=" .. unitId)
		end

		local duration = math.max(0.05, self.HitFlashDuration)
		self.HitFlashTimerId = _TimerService:SetTimerOnce(restore, duration)
	end

	@ExecSpace("Client")
	method void PlayCombatMotion(string unitId, string motionKey, string actionName, number playRate, number duration)
		-- Plays either the equipped weapon attack or one arbitrary one-shot avatar action for this attack profile.
		local state = self.Entity.StateComponent
		local avatarRenderer = self.Entity.AvatarRendererComponent
		if state == nil or avatarRenderer == nil then
			log_warning("[BattleMotion] skipped unit=" .. unitId .. " motion=" .. motionKey .. " reason=AVATAR_COMPONENT_MISSING")
			return
		end
		if motionKey == "" then
			log_warning("[BattleMotion] skipped unit=" .. unitId .. " reason=MOTION_KEY_EMPTY")
			return
		end

		if self.MotionTimerId > 0 then
			_TimerService:ClearTimer(self.MotionTimerId)
			self.MotionTimerId = 0
		end

		local safePlayRate = math.max(0.1, playRate)
		local safeDuration = math.max(0.1, duration)

		local motionMode = "BUILTIN_BODY_ACTION"
		if actionName == "" then
			local attackEvent = BodyActionStateChangeEvent()
			attackEvent.ActionState = MapleAvatarBodyActionState.Attack
			attackEvent.needResetAction = true
			attackEvent.playRate = safePlayRate
			self.Entity:SendEvent(attackEvent)
		else
			local body = avatarRenderer:GetBodyEntity()
			if isvalid(body) == false then
				log_warning("[BattleMotion] skipped unit=" .. unitId .. " motion=" .. motionKey .. " reason=AVATAR_BODY_MISSING")
				return
			end

			motionMode = "CUSTOM_ACTION"
			local actionEvent = ActionStateChangedEvent()
			actionEvent.CoreActionName = actionName
			actionEvent.PartsActionName = actionName
			actionEvent.PlayRate = safePlayRate
			actionEvent.PlayType = SpriteAnimClipPlayType.Onetime
			body:SendEvent(actionEvent)
		end
		log("[BattleMotion] started unit=" .. unitId .. " motion=" .. motionKey .. " mode=" .. motionMode .. " action=" .. actionName .. " rate=" .. safePlayRate .. " duration=" .. safeDuration)

		local restore = function()
			if isvalid(self.Entity) then
				if self.Entity.StateComponent ~= nil then
					self.Entity.StateComponent:ChangeState(self.CombatMotionReturnState)
				end
				local resetEvent = BodyActionStateChangeEvent()
				resetEvent.ActionState = MapleAvatarBodyActionState.Stand
				resetEvent.needResetAction = true
				self.Entity:SendEvent(resetEvent)
				log("[BattleMotion] restored unit=" .. unitId .. " motion=" .. motionKey .. " state=" .. self.CombatMotionReturnState)
			end
			self.MotionTimerId = 0
		end

		self.MotionTimerId = _TimerService:SetTimerOnce(restore, safeDuration)
	end

	@ExecSpace("Client")
	method void PlaySpriteMotion(string unitId, string motionRuid, number playRate, number duration)
		-- Sprite-based enemies opt into one-shot attack motion through skill CSV data.
		-- The model's original idle clip is cached once and restored after the authored duration.
		local renderer = self.Entity.SpriteRendererComponent
		if renderer == nil then
			log_warning("[BattleSpriteMotion] skipped unit=" .. unitId .. " reason=SPRITE_RENDERER_MISSING")
			return
		end
		if motionRuid == "" then
			return
		end

		if self.HasOriginalSpriteMotion == false then
			self.OriginalSpriteRuid = renderer.SpriteRUID
			self.OriginalSpritePlayRate = renderer.PlayRate
			self.HasOriginalSpriteMotion = true
		end
		if self.SpriteMotionTimerId > 0 then
			_TimerService:ClearTimer(self.SpriteMotionTimerId)
			self.SpriteMotionTimerId = 0
		end

		local safePlayRate = math.max(0.1, playRate)
		local safeDuration = math.max(0.1, duration)
		renderer.SpriteRUID = motionRuid
		renderer.PlayRate = safePlayRate
		log("[BattleSpriteMotion] started unit=" .. unitId .. " ruid=" .. motionRuid .. " rate=" .. safePlayRate .. " duration=" .. safeDuration)

		local restore = function()
			if isvalid(self.Entity) and self.Entity.SpriteRendererComponent ~= nil then
				self.Entity.SpriteRendererComponent.SpriteRUID = self.OriginalSpriteRuid
				self.Entity.SpriteRendererComponent.PlayRate = self.OriginalSpritePlayRate
				log("[BattleSpriteMotion] restored unit=" .. unitId .. " ruid=" .. self.OriginalSpriteRuid)
			end
			self.SpriteMotionTimerId = 0
			self.HasOriginalSpriteMotion = false
		end

		self.SpriteMotionTimerId = _TimerService:SetTimerOnce(restore, safeDuration)
	end

	@ExecSpace("Client")
	method void PlaySkillEffect(string unitId, string phase, string effectRuid, number scale, boolean flipX, number playRate)
		-- Plays one non-looping skill animation clip anchored to this unit. Purely presentational:
		-- it never touches HP, cell occupancy, or turn state, so a missing RUID only costs the visual.
		if effectRuid == "" then
			return
		end

		local safeScale = math.max(0.05, scale)
		local safePlayRate = math.max(0.1, playRate)
		local options = {}
		-- Skill effect art faces left by default, so flip only when the caster looks right.
		options["FlipX"] = flipX
		options["SortingLayer"] = self.SkillEffectSortingLayer
		options["OrderInLayer"] = self.SkillEffectOrderInLayer
		-- Matches the clip to the skill speed so the effect finishes with the swing, not after it.
		options["PlayRate"] = safePlayRate

		local serial = _EffectService:PlayEffectAttached(
			effectRuid,
			self.Entity,
			Vector3(0, self.SkillEffectOffsetY, 0),
			0,
			Vector3(safeScale, safeScale, 1),
			false,
			options
		)
		if serial == 0 then
			log_warning("[BattleEffect] failed unit=" .. unitId .. " phase=" .. phase .. " ruid=" .. effectRuid .. " reason=PLAY_EFFECT_RETURNED_ZERO")
			return
		end
		log("[BattleEffect] played unit=" .. unitId .. " phase=" .. phase .. " ruid=" .. effectRuid .. " scale=" .. safeScale .. " rate=" .. safePlayRate .. " flipX=" .. tostring(flipX) .. " serial=" .. serial)
	end

end
