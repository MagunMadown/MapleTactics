	@ExecSpace("ServerOnly")
	method table CaptureBattleResultContext()
		-- A result save may yield; retain only identity fields that normal settlement does not change.
		local player = self.PlayerEntity
		if isvalid(player) == false then return nil end
		local run = player:GetComponent("script.PlayerRunStateComponent")
		local entryState = player:GetComponent("script.BattleEntryStateComponent")
		if (run ~= nil and isvalid(run) == false) or (entryState ~= nil and isvalid(entryState) == false) then return nil end
		return { Player = player, Map = player.CurrentMap, Entry = self.EntryRequestId,
			Stage = self.StageId, Result = self.BattleResult, Run = run,
			EntryState = entryState, PlayerEntry = entryState ~= nil and entryState.RequestId or 0,
			RunLifetime = run ~= nil and run.RunLifetimeRevision or 0,
			RunSequence = run ~= nil and run.RunSequence or 0 }
	end

	@ExecSpace("ServerOnly")
	method boolean IsBattleResultContextCurrent(table context)
		-- Forfeit, logout, a new run and map transfer invalidate the old save's UI/reward continuation.
		if context == nil or isvalid(self.Entity) == false or isvalid(context.Player) == false
			or self.PlayerEntity ~= context.Player or context.Player.CurrentMap ~= context.Map
			or context.Map ~= self.Entity or self.EntryRequestId ~= context.Entry
			or self.StageId ~= context.Stage or self.BattleResult ~= context.Result then return false end
		local run = context.Player:GetComponent("script.PlayerRunStateComponent")
		local entryState = context.Player:GetComponent("script.BattleEntryStateComponent")
		if entryState ~= context.EntryState or (entryState ~= nil and (isvalid(entryState) == false
			or (context.AllowPlayerEntryAdvance ~= true and entryState.RequestId ~= context.PlayerEntry))) then return false end
		return run == context.Run and (run == nil or (isvalid(run) and run.RunLifetimeRevision == context.RunLifetime
			and run.RunSequence == context.RunSequence))
	end

	@ExecSpace("Server")
	method void RequestContinueResult()
		-- Only the registered player can advance an ended, presented battle once.
		if self:IsValidPlayerRequest(senderUserId) == false or self.ResultReady == false then return end
		if self.BattleResult ~= "Victory" and self.BattleResult ~= "Defeat" then return end
		self.ResultReady = false
		_BattleResultLogic:ContinueResult(self)
	end

