	@ExecSpace("ServerOnly")
	method table CollectDropsForMovedUnit(any unit, integer cellIndex)
		-- Keeps movement coordination here while BattleDropComponent owns reward transfer and pending-state mutation.
		if unit == nil or unit.Team ~= "Player" then
			return { Success = true, Reason = "NOT_PLAYER", CollectedCount = 0, FailedCount = 0 }
		end
		if isvalid(self.PlayerEntity) == false then
			return { Success = false, Reason = "PLAYER_MISSING", CollectedCount = 0, FailedCount = 0 }
		end
		local dropRuntime = self:EnsureDropStateComponent()
		if dropRuntime == nil then
			return { Success = false, Reason = "DROP_RUNTIME_MISSING", CollectedCount = 0, FailedCount = 0 }
		end
		local battleRecordKey = self.StageId .. ":" .. tostring(self.EntryRequestId)
		local result = dropRuntime:CollectAtCell(self.PlayerEntity, battleRecordKey, cellIndex)
		if result.FailedCount > 0 then
			log_warning("[BattleDrop] player pickup partial cell=" .. cellIndex .. " failed=" .. result.FailedCount)
		end
		return result
	end

	method Entity FindUnitEntity(string unitId)
		-- Delegates logical unit lookup to the map-scoped BoardState registry.
		if self.BoardState == nil then
			return nil
		end
		return self.BoardState:FindByUnitId(unitId)
	end

