	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleMoveKeyDown(KeyDownEvent event)
		-- Converts one movement/turn/attack key press into a server-authoritative request.
		local player = _UserService.LocalPlayer
		if isvalid(player) == false or player.CurrentMap ~= self.Entity then
			return
		end
		-- UI clicks belong to skill selection and dragging, never to world commands.
		if (event.key == KeyboardKey.Mouse0 or event.key == KeyboardKey.Mouse1 or event.key == KeyboardKey.Mouse2)
			and _InputService:IsPointerOverUI() then
			return
		end
		if event.key == KeyboardKey.F8 then
			log("[BattlePrototypeTest] force stage clear requested key=F8")
			self:RequestPrototypeForceStageClear()
			return
		end
		if event.key == KeyboardKey.Space or event.key == KeyboardKey.Mouse0 then
			log("[BattleInput] execute queue requested")
			_BattleHudPresenterLogic:RequestExecuteQueue()
			return
		end
		if event.key == KeyboardKey.Mouse1 then
			if _BattleHudPresenterLogic:TryBeginLocalCommand("UTILITY") then
				self:RequestUtilitySkill()
			end
			return
		end
		if event.key == KeyboardKey.W or event.key == KeyboardKey.Mouse2 then
			if _BattleHudPresenterLogic:TryBeginLocalCommand("TURN") == false then
				return
			end
			self:PreviewLocalTurnFacing()
			log("[BattleInput] turn requested")
			self:RequestTurn()
			return
		end

		if event.key == KeyboardKey.H then
			self:SubmitConsumableUse("orange_potion", "")
			return
		end

		local direction = _PlayerGridMovementLogic:GetDirection(event.key)

		if direction ~= 0 then
			if _BattleHudPresenterLogic:TryBeginLocalCommand("MOVE") == false then
				return
			end
			log("[BattleInput] move requested direction=" .. direction)
			self:RequestMove(direction)
		end
	end

	@ExecSpace("ClientOnly")
	method void PreviewLocalTurnFacing()
		-- Gives direction input an immediate visual response without mutating authoritative BattleUnit facing.
		local player = _UserService.LocalPlayer
		if isvalid(player) == false or player.PlayerControllerComponent == nil then
			return
		end

		local currentDirection = player.PlayerControllerComponent.LookDirectionX
		if currentDirection >= 0 then
			player.PlayerControllerComponent.LookDirectionX = -1
		else
			player.PlayerControllerComponent.LookDirectionX = 1
		end
		log("[BattleInputFeedback] local turn preview direction=" .. tostring(player.PlayerControllerComponent.LookDirectionX))
	end

	@ExecSpace("Client")
	method void ConfirmLocalPlayerFacing(string facing)
		-- Confirms or rolls back the optimistic visual from the server-authoritative facing value.
		local player = _UserService.LocalPlayer
		if isvalid(player) == false or player.PlayerControllerComponent == nil then
			return
		end

		player.PlayerControllerComponent.LookDirectionX = facing == "Right" and 1 or -1
		log("[BattleInputFeedback] authoritative facing=" .. tostring(facing))
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleUnitTurnedEvent(UnitTurnedEvent event)
		-- Confirms that subscribers can observe a completed direction change.
		log("[BattleEvent] UnitTurnedEvent received unit=" .. event.UnitId .. " from=" .. event.PreviousFacing .. " to=" .. event.CurrentFacing)
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleUnitMovedEvent(UnitMovedEvent event)
		-- Confirms that subscribers can observe a completed logical move.
		log("[BattleEvent] UnitMovedEvent received unit=" .. event.UnitId .. " from=" .. event.FromCell .. " to=" .. event.ToCell)
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleBasicAttackResolvedEvent(BasicAttackResolvedEvent event)
		-- Confirms that subscribers receive both hit and miss attack resolutions.
		log("[BattleEvent] BasicAttackResolvedEvent attack=" .. event.AttackId .. " source=" .. event.SourceUnitId .. " target=" .. event.TargetUnitId .. " cell=" .. event.TargetCell .. " hit=" .. tostring(event.Hit) .. " reason=" .. event.Reason .. " damage=" .. event.DamageAmount .. " hp=" .. event.TargetHpBefore .. "->" .. event.TargetHpAfter)
	end

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- Initializes the map-scoped session. Prototype maps may still opt into automatic Stage 1 start.
		log("[BattleSession] begin map=" .. self.Entity.Name .. " cells=" .. self.CellCount .. " autoStart=" .. tostring(self.AutoStartPrototypeBattle))
		local boardState = self:EnsureBoardStateComponent()
		if boardState == nil then
			log_error("[BattleSession] BoardStateComponent unavailable")
			return
		end
		boardState:ResetRegistry("SESSION_BEGIN")
		local waveRuntime = self:EnsureWaveStateComponent()
		if waveRuntime == nil then
			log_error("[BattleSession] BattleWaveComponent unavailable")
			return
		end
		waveRuntime:ResetWaveState(self.TotalWaves, "SESSION_BEGIN")
		self:PublishWaveStateSnapshot("SESSION_BEGIN")
		local turnState = self:EnsureTurnStateComponent()
		if turnState == nil then
			log_error("[BattleSession] BattleTurnComponent unavailable")
			return
		end
		turnState:ResetTurnState(self.TileQueueCapacity, "SESSION_BEGIN")
		self:PublishTurnStateSnapshot("SESSION_BEGIN")
		local enemyIntentRuntime = self:EnsureEnemyIntentComponent()
		if enemyIntentRuntime == nil then
			log_error("[BattleSession] EnemyIntentComponent unavailable")
			return
		end
		enemyIntentRuntime:ResetIntent("SESSION_BEGIN")
		self:PublishEnemyIntentSnapshot("SESSION_BEGIN")
		local dropRuntime = self:EnsureDropStateComponent()
		if dropRuntime == nil then
			log_error("[BattleSession] BattleDropComponent unavailable")
			return
		end
		dropRuntime:ResetDropState("SESSION_BEGIN")
		local contentValidation = self:RunContentValidationGate("SESSION_BEGIN")
		if contentValidation.Success == false then
			log_error("[BattleContentGate] session start blocked reason=" .. contentValidation.Reason .. " errors=" .. contentValidation.ErrorCount)
			return
		end

		-- The map component can begin before the transferred player is visible. OnUpdate
		-- routes the first visible player through OnMapEnter so PREPARED always wins.
		self.EntryPolicyResolved = false
		self.PrototypeTestEntryActive = false
		self.LastInitializedEntryRequestId = 0
		log("[BattleSession] waiting for player entry policy")
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- Prevents a pending action callback from surviving this map-scoped battle session.
		self:ClearMotionCompletionWaits()
		self:ClearPrototypeBattleEntryRetry("SESSION_END")
		self.PrototypeTestEntryActive = false
		self:CancelPlayerCombatPresentationHandoff("SESSION_END", false)
		self:FinishPlayerGridMovePresentation("SESSION_END")
		self:FinishEnemyGridMovePresentation("SESSION_END", false)
		if self.ActionTimerId > 0 then
			_TimerService:ClearTimer(self.ActionTimerId)
			self.ActionTimerId = 0
		end
		if self.ResultTransitionTimerId > 0 then
			_TimerService:ClearTimer(self.ResultTransitionTimerId)
			self.ResultTransitionTimerId = 0
		end
		self:ClearTurnTransitionTimer("SESSION_END")
		self.PlayerToEnemyBeatPending = false
		self.PendingPlayerToEnemyHandoffDelay = -1
		self:ClearEnemyToEnemyPresentationHandoff("SESSION_END")
		self:ClearSkillImpactTimers()
		if self.TurnState ~= nil then
			self.TurnState:ResetTurnState(self.TileQueueCapacity, "SESSION_END")
			self:PublishTurnStateSnapshot("SESSION_END")
		end
		self.BattleResult = ""
		if self.WaveRuntime ~= nil then
			self.WaveRuntime:ResetWaveState(self.TotalWaves, "SESSION_END")
			self:PublishWaveStateSnapshot("SESSION_END")
		end
		self:ClearPreparedEnemyIntent("END_PLAY")
		if self.BoardState ~= nil then
			self.BoardState:ResetRegistry("SESSION_END")
		end
		if self.DropRuntime ~= nil then
			self.DropRuntime:DiscardPending("SESSION_END")
		end
	end

	@ExecSpace("ServerOnly")
	method void ClearMotionCompletionWaits()
		-- Entry changes invalidate every outstanding presentation acknowledgement.
		for _, wait in pairs(self._T.motionCompletionWaits or {}) do
			_TimerService:ClearTimer(wait.TimerId)
		end
		self._T.motionCompletionWaits = {}
	end

	@ExecSpace("ServerOnly")
	method void WaitForMotionCompletion(any complete)
		-- Logical delays remain a lower bound; only the owning player's display can release this presentation gate.
		if isvalid(self.PlayerEntity) == false or self.PlayerEntity.CurrentMap ~= self.Entity then return end
		self._T.motionCompletionSequence = (self._T.motionCompletionSequence or 0) + 1
		local sequence = self._T.motionCompletionSequence
		local entry = self.EntryRequestId
		self._T.motionCompletionWaits = self._T.motionCompletionWaits or {}
		local wait = { Complete = complete, Entry = entry, TimerId = 0 }
		self._T.motionCompletionWaits[sequence] = wait
		wait.TimerId = _TimerService:SetTimerOnce(function()
			if self._T.motionCompletionWaits[sequence] ~= wait then return end
			self._T.motionCompletionWaits[sequence] = nil
			if self.EntryRequestId ~= entry or isvalid(self.PlayerEntity) == false or self.PlayerEntity.CurrentMap ~= self.Entity then return end
			log_warning("[BattleMotionGate] acknowledgement timeout sequence=" .. sequence)
			complete()
		end, 60)
		self:AwaitClientMotionCompletion(sequence, entry, self.PlayerEntity.PlayerComponent.UserId)
	end

	@ExecSpace("Client")
	method void AwaitClientMotionCompletion(integer sequence, integer entry)
		-- Includes queued hit poses and death holds, but excludes completed attack handoff poses and repeating movement.
		-- The recipient UserId is an engine-supplied final call argument, never a declared parameter.
		local player = _UserService.LocalPlayer
		if isvalid(player) == false or player.CurrentMap ~= self.Entity then return end
		local started = _UtilLogic.ElapsedSeconds
		local poll = nil
		poll = function()
			if isvalid(self.Entity) == false or isvalid(player) == false or player.CurrentMap ~= self.Entity or self.EntryRequestId ~= entry then return end
			if _UtilLogic.ElapsedSeconds - started > 60 then return end
			local busy = false
			local presentations = self.Entity:GetChildComponentsByTypeName("script.BattleUnitPresentationComponent", true)
			for _, presentation in pairs(presentations) do
				if presentation:IsFullMotionPending() then busy = true break end
			end
			local playerPresentation = player:GetComponent("script.BattleUnitPresentationComponent")
			if playerPresentation ~= nil and playerPresentation:IsFullMotionPending() then busy = true end
			if busy == false then
				self:ConfirmMotionCompletion(sequence, entry)
				return
			end
			_TimerService:SetTimerOnce(poll, 0.01)
		end
		_TimerService:SetTimerOnce(poll, 0.01)
	end

	@ExecSpace("Server")
	method void ConfirmMotionCompletion(integer sequence, integer entry)
		-- This acknowledgement can only release an existing server-owned callback; it cannot apply damage or choose actions.
		if isvalid(self.PlayerEntity) == false or self.PlayerEntity.PlayerComponent.UserId ~= senderUserId or self.PlayerEntity.CurrentMap ~= self.Entity then return end
		local wait = self._T.motionCompletionWaits ~= nil and self._T.motionCompletionWaits[sequence] or nil
		if wait == nil or wait.Entry ~= entry or self.EntryRequestId ~= entry then return end
		self._T.motionCompletionWaits[sequence] = nil
		_TimerService:ClearTimer(wait.TimerId)
		log("[BattleMotionGate] released sequence=" .. sequence)
		wait.Complete()
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- Route the first visible player through the existing entry path exactly once.
		if self.PrototypeTestEntryPending == true then
			self:UpdatePrototypeBattleEntryRetry(delta)
			return
		end
		if self.EntryPolicyResolved == false then
			local users = _UserService:GetUsersByMapComponent(self.Entity.MapComponent)
			if users ~= nil then
				for _, player in ipairs(users) do
					self:OnMapEnter(player)
					break
				end
			end
			return
		end
		self:RefreshHudProgressSnapshot()
		self:UpdatePlayerGridMove(delta)
		self:UpdateEnemyGridMove(delta)
		self:RefreshPlayerHpSnapshot("")
		-- Battle map entities persist after the player visits another map. A completed
		-- battle observes the exit normally, while defeat return explicitly arms the
		-- same fresh-entry path after clearing BattleResult for the persistent HUD.
		if self.BattleResult ~= "" or self.PlayerExitObservedAfterBattle == true then
			local users = _UserService:GetUsersByMapComponent(self.Entity.MapComponent)
			if self.PlayerExitObservedAfterBattle == true then
				if users ~= nil then
					for _, player in ipairs(users) do
						local entryState = player:GetComponent("script.BattleEntryStateComponent")
						if entryState ~= nil and entryState.EntryState == "PREPARED" and entryState.RequestId ~= self.LastInitializedEntryRequestId then
							log("[BattleSession] prepared re-entry detected request=" .. entryState.RequestId .. " stage=" .. entryState.StageId)
							self:OnMapEnter(player)
							break
						end
					end
				end
			elseif users == nil or #users == 0 then
				if self.PlayerExitObservedAfterBattle == false then
					self.PlayerExitObservedAfterBattle = true
					log("[BattleSession] player exit observed after battle stage=" .. self.StageId)
				end
			end
		end

		if self.BattlePhase == "Setup" then
			self:TryStartBattle()
		end
		self:RefreshHudRelicSnapshot()
	end

	@ExecSpace("ServerOnly")
	method void RefreshPlayerHpSnapshot(string reason)
		-- Mirrors runtime-owned player HP onto the placed battle session for reliable client UI sync.
		if isvalid(self.PlayerEntity) == false then
			return
		end
		local playerUnit = self.PlayerEntity:GetComponent("script.BattleUnitComponent")
		if playerUnit == nil or playerUnit.Team ~= "Player" then
			return
		end
		local currentHp = math.max(0, playerUnit.CurrentHp)
		local maxHp = math.max(1, playerUnit.MaxHp)
		if self.PlayerCurrentHp == currentHp and self.PlayerMaxHp == maxHp then
			return
		end
		self.PlayerCurrentHp = currentHp
		self.PlayerMaxHp = maxHp
		self.PlayerHpRevision = self.PlayerHpRevision + 1
		if reason ~= nil and reason ~= "" then
			log("[BattlePlayerHp] synced reason=" .. reason .. " hp=" .. tostring(currentHp) .. "/" .. tostring(maxHp) .. " revision=" .. tostring(self.PlayerHpRevision))
		end
	end

	@ExecSpace("ServerOnly")
	method void OnMapEnter(Entity enteredEntity)
		-- Registers a player that enters this battle map after the session has initialized.
		if enteredEntity == nil or enteredEntity.PlayerComponent == nil then
			return
		end
		local entryState = enteredEntity:GetComponent("script.BattleEntryStateComponent")
		if entryState ~= nil and entryState.EntryState == "PREPARED" then
			local runState = enteredEntity:GetComponent("script.PlayerRunStateComponent")
			self.PrototypeTestEntryActive = runState ~= nil and runState.PrototypeTestMode == true
			self.EntryPolicyResolved = true
			log("[BattleSession] prepared entry detected request=" .. entryState.RequestId .. " stage=" .. entryState.StageId .. " prototype=" .. tostring(self.PrototypeTestEntryActive))
			local entryResult = _BattleGatewayLogic:ConsumePreparedBattle(enteredEntity, self)
			if entryResult.Success == true then
				return
			end
			log_warning("[BattleSession] prepared entry blocked request=" .. entryState.RequestId .. " reason=" .. entryResult.Reason)
			return
		end
		if self.EntryPolicyResolved == true then
			log("[BattleSession] duplicate map entry ignored player=" .. enteredEntity.Name)
			return
		end

		log("[BattleSession] map entered player=" .. enteredEntity.Name)
		if self.AutoStartPrototypeBattle == false then
			self.EntryPolicyResolved = true
			log("[BattleSession] player waiting for prepared entry player=" .. enteredEntity.Name)
			return
		end
		self.EntryPolicyResolved = true
		local stageResolution = self:ResolvePrototypeTestStage()
		if stageResolution.Success == false then
			log_error("[BattlePrototypeEntry] stage resolution rejected map=" .. self.Entity.Name .. " reason=" .. stageResolution.Reason .. " detail=" .. (stageResolution.DetailReason or ""))
			return
		end
		local targetStageId = stageResolution.StageId
		log("[BattleSession] no prepared entry, prototype auto start player=" .. enteredEntity.Name .. " stage=" .. targetStageId .. " source=" .. stageResolution.Source)
		local testResult = self:StartPrototypeBattleFromMap(enteredEntity, targetStageId)
		if testResult.Success == false then
			if testResult.Retryable == true then
				self:QueuePrototypeBattleEntryRetry(enteredEntity, targetStageId, testResult.Reason)
			else
				log_error("[BattlePrototypeEntry] rejected stage=" .. targetStageId .. " reason=" .. testResult.Reason .. " detail=" .. (testResult.DetailReason or ""))
			end
		end
	end

	@ExecSpace("ServerOnly")
	method table ResolvePrototypeTestStage()
		local mapId = self.Entity.Name
		if self.PrototypeTestStageOverride ~= nil and self.PrototypeTestStageOverride ~= "" then
			local overrideRoute = _StageMapRouteRepositoryLogic:GetMapRoute(self.PrototypeTestStageOverride)
			if overrideRoute.Success == false then
				return overrideRoute
			end
			if overrideRoute.MapId ~= mapId then
				return {
					Success = false,
					Reason = "PROTOTYPE_STAGE_MAP_MISMATCH",
					DetailReason = "EXPECTED_" .. mapId .. "_ACTUAL_" .. overrideRoute.MapId,
					StageId = self.PrototypeTestStageOverride,
					MapId = mapId
				}
			end
			return {
				Success = true,
				Reason = "OK",
				StageId = self.PrototypeTestStageOverride,
				MapId = mapId,
				Source = "MAP_OVERRIDE"
			}
		end

		local defaultRoute = _StageMapRouteRepositoryLogic:GetDefaultStageForMap(mapId)
		if defaultRoute.Success == true then
			return defaultRoute
		end

		-- Backward compatibility for older prototype maps that have not registered StageMapRoutes yet.
		local fallbackRoute = _StageMapRouteRepositoryLogic:GetMapRoute(self.StageId)
		if fallbackRoute.Success == true and fallbackRoute.MapId == mapId then
			log_warning("[BattlePrototypeEntry] legacy StageId fallback map=" .. mapId .. " stage=" .. self.StageId)
			return {
				Success = true,
				Reason = "OK",
				StageId = self.StageId,
				MapId = mapId,
				Source = "LEGACY_STAGE_ID"
			}
		end
		return defaultRoute
	end

	@ExecSpace("ServerOnly")
	method table StartPrototypeBattleFromMap(Entity playerEntity, string targetStageId)
		-- Initializes a direct Maker Play session through the production NEW_RUN boundary for realistic HP, skills, queue, and inventory.
		local unionReadiness = _UnionEffectResolverLogic:GetEffectSnapshot(playerEntity)
		if unionReadiness.Success == false then
			return {
				Success = false,
				Reason = unionReadiness.Reason or "UNION_EFFECT_UNAVAILABLE",
				DetailReason = unionReadiness.DetailReason or "",
				Retryable = self:IsPrototypeBattleEntryRetryableReason(unionReadiness.Reason)
			}
		end
		local resolvedJobId = _RunManagerLogic:ResolveJobId(self.PrototypeTestJobId)
		local requestId = math.max(1, self.PrototypeTestEntryRequestId)
		local runSeed = math.max(1, self.PrototypeTestRunSeed)
		local result = self:InitializeFromEntry(
			playerEntity,
			targetStageId,
			self.PrototypeTestCharacterId,
			resolvedJobId,
			self.PrototypeTestLoadoutId,
			runSeed,
			"NEW_RUN",
			requestId
		)
		if result.Success == true then
			local runState = playerEntity:GetComponent("script.PlayerRunStateComponent")
			if runState ~= nil then
				runState.PrototypeTestMode = true
			end
			self.PrototypeTestEntryActive = true
			log("[BattlePrototypeEntry] started stage=" .. targetStageId .. " job=" .. resolvedJobId .. " seed=" .. runSeed .. " request=" .. requestId)
		end
		return result
	end

	@ExecSpace("Server")
	method void RequestPrototypeForceStageClear()
		-- Test-only RPC: sender ownership and direct Maker Play mode are both required.
		if self:IsValidPlayerRequest(senderUserId) == false then
			log_warning("[BattlePrototypeTest] force clear rejected reason=INVALID_SENDER")
			return
		end
		if self.EnablePrototypeForceStageClear == false or self.PrototypeTestEntryActive == false then
			log_warning("[BattlePrototypeTest] force clear rejected reason=NOT_PROTOTYPE_ENTRY")
			return
		end

		local result = self:TryPrototypeForceStageClear()
		if result.Success == false then
			log_warning("[BattlePrototypeTest] force clear rejected reason=" .. result.Reason)
		end
	end

	@ExecSpace("ServerOnly")
	method table TryPrototypeForceStageClear()
		-- Skips remaining waves, then kills one retained enemy through the normal damage/death/victory pipeline.
		local result = { Success = false, Reason = "UNKNOWN" }
		if self.BattleResult ~= "" then
			result.Reason = "BATTLE_ALREADY_ENDED"
			return result
		end
		if self.BoardState == nil or self.TurnState == nil or self.WaveRuntime == nil then
			result.Reason = "BATTLE_STATE_UNAVAILABLE"
			return result
		end
		if isvalid(self.PlayerEntity) == false then
			result.Reason = "PLAYER_UNAVAILABLE"
			return result
		end

		local livingEnemies = self.BoardState:CollectLivingEnemies()
		if livingEnemies == nil or #livingEnemies == 0 then
			result.Reason = "NO_LIVING_ENEMY"
			return result
		end

		-- Retain one enemy so ApplyDamage can enter the exact production victory boundary.
		local finalEnemy = livingEnemies[1]
		for index = 2, #livingEnemies do
			local enemyEntity = livingEnemies[index]
			if isvalid(enemyEntity) then
				local enemyUnit = enemyEntity:GetComponent("script.BattleUnitComponent")
				if enemyUnit ~= nil then
					self.BoardState:UnregisterUnit(enemyUnit.UnitId)
				end
				_EntityService:Destroy(enemyEntity)
			end
		end

		local finalUnit = finalEnemy:GetComponent("script.BattleUnitComponent")
		if finalUnit == nil then
			result.Reason = "FINAL_ENEMY_COMPONENT_MISSING"
			return result
		end
		local waveResult = self.WaveRuntime:ForceFinalWaveForPrototypeTest("PROTOTYPE_FORCE_CLEAR")
		if waveResult.Success == false then
			result.Reason = waveResult.Reason
			return result
		end
		self:PublishWaveStateSnapshot("PROTOTYPE_FORCE_CLEAR")
		local damageAmount = math.max(1, finalUnit.CurrentHp)
		local damageResult = self:ApplyDamage("player_01", finalUnit.UnitId, damageAmount, "prototype_force_clear")
		if damageResult.Success == false then
			result.Reason = damageResult.Reason
			return result
		end

		result.Success = true
		result.Reason = "OK"
		log("[BattlePrototypeTest] force clear accepted stage=" .. self.StageId .. " skippedEnemies=" .. tostring(math.max(0, #livingEnemies - 1)))
		return result
	end

	@ExecSpace("ServerOnly")
	method boolean IsPrototypeBattleEntryRetryableReason(string reason)
		-- Restricts automatic retries to transient Union profile readiness states.
		return reason == "PROFILE_LOAD_IN_PROGRESS"
			or reason == "PROFILE_NOT_LOADED"
			or reason == "PROFILE_CACHE_MISSING"
			or reason == "USER_DATA_STORAGE_UNAVAILABLE"
	end

	@ExecSpace("ServerOnly")
	method void QueuePrototypeBattleEntryRetry(Entity playerEntity, string targetStageId, string reason)
		-- Holds one direct-Play request while the player profile finishes loading.
		self.PrototypeTestEntryPending = true
		self.PrototypeTestPendingPlayer = playerEntity
		self.PrototypeTestPendingStageId = targetStageId
		self.PrototypeTestRetryElapsed = 0
		self.PrototypeTestRetryCount = 0
		log("[BattlePrototypeEntry] waiting stage=" .. targetStageId .. " reason=" .. (reason or "PROFILE_NOT_READY"))
	end

	@ExecSpace("ServerOnly")
	method void UpdatePrototypeBattleEntryRetry(number delta)
		-- Retries the production NEW_RUN boundary at a bounded interval without starting a partial battle.
		if isvalid(self.PrototypeTestPendingPlayer) == false then
			log_error("[BattlePrototypeEntry] retry cancelled reason=PLAYER_UNAVAILABLE")
			self:ClearPrototypeBattleEntryRetry("PLAYER_UNAVAILABLE")
			return
		end
		self.PrototypeTestRetryElapsed = self.PrototypeTestRetryElapsed + math.max(0, delta)
		if self.PrototypeTestRetryElapsed < self.PrototypeTestRetryInterval then
			return
		end
		self.PrototypeTestRetryElapsed = 0
		self.PrototypeTestRetryCount = self.PrototypeTestRetryCount + 1
		local result = self:StartPrototypeBattleFromMap(self.PrototypeTestPendingPlayer, self.PrototypeTestPendingStageId)
		if result.Success == true then
			self:ClearPrototypeBattleEntryRetry("STARTED")
			return
		end
		if result.Retryable == true and self.PrototypeTestRetryCount < self.PrototypeTestMaxRetryCount then
			if self.PrototypeTestRetryCount % 10 == 0 then
				log("[BattlePrototypeEntry] still waiting stage=" .. self.PrototypeTestPendingStageId .. " retry=" .. self.PrototypeTestRetryCount .. "/" .. self.PrototypeTestMaxRetryCount .. " reason=" .. result.Reason)
			end
			return
		end
		log_error("[BattlePrototypeEntry] retry exhausted stage=" .. self.PrototypeTestPendingStageId .. " retry=" .. self.PrototypeTestRetryCount .. " reason=" .. result.Reason .. " detail=" .. (result.DetailReason or ""))
		self:ClearPrototypeBattleEntryRetry("RETRY_EXHAUSTED")
	end

	@ExecSpace("ServerOnly")
	method void ClearPrototypeBattleEntryRetry(string reason)
		-- Releases the map-scoped direct-Play retry state after success, failure, or teardown.
		if self.PrototypeTestEntryPending == true then
			log("[BattlePrototypeEntry] retry cleared reason=" .. (reason or ""))
		end
		self.PrototypeTestEntryPending = false
		self.PrototypeTestPendingPlayer = nil
		self.PrototypeTestPendingStageId = ""
		self.PrototypeTestRetryElapsed = 0
		self.PrototypeTestRetryCount = 0
	end

	@ExecSpace("ServerOnly")
	method void NotifyBossPhaseAdvanced(integer phaseIndex)
		-- Bridges a boss phase transition to the wave runtime. Ownership stays split: the
		-- wave component decides whether the current wave arms a BOSS_PHASE trigger, and the
		-- actual spawn still runs through EvaluateForcedSpawnAtTurnBoundary on the next turn
		-- boundary, so no enemy is injected while an action is resolving.
		if self.WaveRuntime == nil then
			return
		end
		local trigger = self.WaveRuntime:ApplyBossPhaseTrigger(phaseIndex, "BOSS_PHASE_CHANGED")
		if trigger.Pended == true then
			self:PublishWaveStateSnapshot("BOSS_PHASE_SPAWN_PENDING")
			log("[BattleSession] boss phase reinforcement queued phase=" .. phaseIndex .. " wave=" .. self.WaveRuntime.PendingWaveNumber)
		end
	end

	@ExecSpace("ServerOnly")
	method void StartStageById(string stageId)
		-- Starts one exact StageId. Region, order, and type always come from StageDefinitions.
		local stageResult = self:LoadAndApplyStageDefinition(stageId)
		if stageResult.Success == false then
			self.TurnState:SetPhase("DataError", "STAGE_DATA_ERROR")
			self:PublishTurnStateSnapshot("STAGE_DATA_ERROR")
			self.WaveRuntime:SetWaveState("DataError", "STAGE_DATA_ERROR")
			self:PublishWaveStateSnapshot("STAGE_DATA_ERROR")
			log_error("[BattleSession] stage start rejected stage=" .. stageId .. " reason=" .. stageResult.Reason .. " detail=" .. (stageResult.DetailReason or ""))
			return
		end
		log("[BattleSession] stage definition loaded stageId=" .. self.StageId)
		self.StageTurnNumber = 0
		self.BattleResult = ""
		self.ResultReady = false
		self.ResultRecorded = false
		self.ResultDefeatReset = {}
		self.ResultKillCount = 0
		self.ResultElapsedSeconds = 0
		self.ResultGold = 0
		self.ResultStartTime = _UtilLogic.ElapsedSeconds
		_MonsterCollectionLogic:GetRecord(self.PlayerEntity)
		local inventory = isvalid(self.PlayerEntity) and self.PlayerEntity:GetComponent("script.PlayerRunInventoryComponent") or nil
		self.ResultStartGold = inventory ~= nil and inventory:GetSnapshotAmount(inventory.RunCurrencySnapshot, "gold") or 0
		self:ResetUnionRewardPresentation("STAGE_START")
		self.DropRuntime:ResetDropState("STAGE_START")
		self.WaveRuntime:ResetWaveState(self.TotalWaves, "STAGE_START")
		self:PublishWaveStateSnapshot("STAGE_START")
		log("[BattleWave] stage started stage=" .. self.StageNumber .. " stageId=" .. self.StageId .. " waveTable=" .. self.WaveTableId .. " seed=" .. self.RunSeed .. " totalWaves=" .. self.TotalWaves)
		self:SpawnWave(1)
	end

	@ExecSpace("ServerOnly")
	method table LoadAndApplyStageDefinition(string stageId)
		local validation = _ContentValidatorLogic:ValidateStageById(stageId)
		if validation.Success == false then
			return validation
		end

		local definition = validation.Data
		self.StageId = definition.StageId
		self.RegionId = definition.RegionId
		self.StageIndex = definition.StageIndex
		self.StageType = definition.StageType
		self.StageNumber = definition.StageIndex
		self.StageDisplayName = definition.DisplayName
		self.WaveTableId = definition.WaveTableId
		self.StageRuleId = definition.StageRuleId
		self.StageSchemaVersion = definition.SchemaVersion
		self.CellCount = definition.CellCount
		self.CellStartX = definition.CellStartX
		self.CellSpacing = definition.CellSpacing
		self.UnitY = definition.UnitY
		self.PlayerStartCell = definition.PlayerStartCell
		if self.DropRuntime ~= nil then
			self.DropRuntime:ConfigurePresentation(self.CellStartX, self.CellSpacing, self.UnitY)
		end
		local baseQueueCapacity = self.SelectedJobBaseQueueCapacity
		if baseQueueCapacity == nil or baseQueueCapacity <= 0 then
			baseQueueCapacity = definition.QueueCapacity
		end
		if baseQueueCapacity == nil or baseQueueCapacity <= 0 then
			baseQueueCapacity = self.DefaultQueueCapacity
		end
		self.TurnState:ConfigureQueueCapacity(baseQueueCapacity, self.MinQueueCapacity, self.MaxQueueCapacity, "JOB_AND_STAGE_DEFINITION")
		self:PublishTurnStateSnapshot("STAGE_DEFINITION")
		self.WaveRuntime:SetTotalWaves(validation.TotalWaves, "STAGE_DEFINITION")
		self:PublishWaveStateSnapshot("STAGE_DEFINITION")
		log("[BattleSession] stage definition applied stage=" .. self.StageId .. " region=" .. self.RegionId .. " index=" .. self.StageIndex .. " type=" .. self.StageType .. " display=" .. self.StageDisplayName .. " cells=" .. self.CellCount .. " startX=" .. self.CellStartX .. " spacing=" .. self.CellSpacing .. " playerCell=" .. self.PlayerStartCell .. " queue=" .. self.TileQueueCapacity)
		return validation
	end

	@ExecSpace("ServerOnly")
	method void SpawnWave(integer waveNumber)
		-- Creates one data-defined wave while preserving living enemies from an earlier forced-overlap wave.
		if waveNumber < 1 or waveNumber > self.TotalWaves then
			log_error("[BattleWave] spawn rejected wave=" .. waveNumber .. " total=" .. self.TotalWaves)
			return
		end

		local definition = _StageWaveRepositoryLogic:GetWaveDefinition(self.WaveTableId, waveNumber, self.RunSeed)
		if definition.Success == false then
			self.WaveRuntime:SetWaveState("DataError", "WAVE_DEFINITION_ERROR")
			self:PublishWaveStateSnapshot("WAVE_DEFINITION_ERROR")
			log_error("[BattleWave] definition rejected stage=" .. self.StageId .. " wave=" .. waveNumber .. " reason=" .. definition.Reason)
			return
		end
		if self:CanSpawnWave(definition.SpawnCount, definition.MaxConcurrent) == false then
			self.WaveRuntime:MarkSpawnPending(waveNumber, "CAPACITY_WAIT")
			self:PublishWaveStateSnapshot("CAPACITY_WAIT")
			-- Capacity wait is normal back-pressure while the configured live-enemy cap is full.
			log("[BattleWave] pending stage=" .. self.StageId .. " wave=" .. waveNumber .. " reason=CAPACITY_WAIT count=" .. definition.SpawnCount .. " maxConcurrent=" .. definition.MaxConcurrent)
			return
		end
		local spawnDefinitions = {}
		local compositionIds = {}
		for spawnIndex = 1, definition.SpawnCount do
			local spawnDefinition = _StageWaveRepositoryLogic:GetEnemySpawnDefinition(definition.EnemyPoolId, waveNumber, spawnIndex, self.RunSeed)
			if spawnDefinition.Success == false then
				self.WaveRuntime:SetWaveState("DataError", "ENEMY_DEFINITION_ERROR")
				self:PublishWaveStateSnapshot("ENEMY_DEFINITION_ERROR")
				log_error("[BattleWave] enemy definition rejected stage=" .. self.StageId .. " wave=" .. waveNumber .. " slot=" .. spawnIndex .. " reason=" .. spawnDefinition.Reason)
				return
			end
			table.insert(spawnDefinitions, spawnDefinition)
			table.insert(compositionIds, spawnDefinition.EnemyDefinitionId)
		end

		local waveBegin = self.WaveRuntime:BeginWave(
			waveNumber,
			definition.SpawnTriggerMode,
			definition.ForceAfterTurns,
			definition.ForceAfterSeconds,
			definition.SpawnCount,
			definition.MaxConcurrent,
			definition.ClearSpawnDelaySeconds,
			math.max(1, self.StageTurnNumber)
		)
		self.WaveRuntime:SetWaveTriggerPhaseIndex(definition.TriggerPhaseIndex or 0, "WAVE_BEGIN")
		if waveBegin.Success == false then
			log_error("[BattleWave] begin rejected wave=" .. waveNumber .. " reason=" .. waveBegin.Reason)
			return
		end
		self:PublishWaveStateSnapshot("WAVE_BEGIN")
		self:CleanupDefeatedEnemies("BEFORE_WAVE_" .. waveNumber)
		if waveNumber == 1 then
			self.TurnState:ResetTurnState(self.TileQueueCapacity, "FIRST_WAVE_SPAWN")
		else
			self.TurnState:ClearActionState("WAVE_SPAWN")
			log("[BattleQueueBoundary] boundary=WAVE_SPAWN policy=PRESERVE queue=" .. self.TurnState.QueuedTileIds)
		end
		self:PublishTurnStateSnapshot("WAVE_SPAWN")
		self.LastEnemySpawnOrder = 0
		if waveNumber == 1 then
			self:ClearPreparedEnemyIntent("WAVE_SPAWN")
		else
			-- Forced reinforcements must not erase Tiles already queued by surviving enemies.
			self:ResetEnemyIntentCursor("WAVE_REINFORCEMENT_SPAWN")
		end
		local firstSpawnDefinition = spawnDefinitions[1]
		self.EnemyModelId = firstSpawnDefinition.EnemyModelId
		self.CurrentEnemyDefinitionId = firstSpawnDefinition.EnemyDefinitionId
		self.CurrentEnemyMaxHp = firstSpawnDefinition.MaxHp
		self.CurrentEnemyBasicAttackDamage = firstSpawnDefinition.BasicAttackDamage
		self.CurrentEnemyPatternId = firstSpawnDefinition.PatternId
		self.CurrentEnemyMovementPolicy = firstSpawnDefinition.MovementPolicy
		local spawnedCount = 0
		for spawnIndex = 1, definition.SpawnCount do
			local preferredCell = self.LeftEnemyStartCell
			local searchDirection = 1
			local facing = "Right"
			local side = "left"
			if spawnIndex % 2 == 0 then
				preferredCell = self.RightEnemyStartCell
				searchDirection = -1
				facing = "Left"
				side = "right"
			end
			if spawnIndex > 2 then
				side = side .. "_" .. spawnIndex
			end
			local startCell = self:FindAvailableSpawnCell(preferredCell, searchDirection)
			local enemy = self:SpawnWaveEnemy(side, startCell, facing, waveNumber * 100 + spawnIndex, spawnDefinitions[spawnIndex])
			if isvalid(enemy) then
				spawnedCount = spawnedCount + 1
				if isvalid(self.EnemyEntity) == false then
					self.EnemyEntity = enemy
				end
			end
		end

		if spawnedCount == 0 then
			self.WaveRuntime:SetWaveState("SpawnFailed", "NO_ENEMY_SPAWNED")
			self:PublishWaveStateSnapshot("NO_ENEMY_SPAWNED")
			log_error("[BattleWave] spawn failed stage=" .. self.StageNumber .. " wave=" .. self.CurrentWave)
			return
		end

		self.WaveRuntime:MarkWaveActive("SPAWN_COMPLETED")
		self:PublishWaveStateSnapshot("SPAWN_COMPLETED")
		self:ScheduleForcedSpawnTimer()
		local livingTotal = #self.BoardState:CollectLivingEnemies()
		log("[BattleWave] spawned stage=" .. self.StageNumber .. " wave=" .. self.CurrentWave .. "/" .. self.TotalWaves .. " seed=" .. self.RunSeed .. " enemies=" .. spawnedCount .. " livingTotal=" .. livingTotal .. " composition=" .. table.concat(compositionIds, ",") .. " mode=" .. self.CurrentWaveSpawnMode .. " forceTurns=" .. self.ForceAfterTurns .. " forceSeconds=" .. self.ForceAfterSeconds)
		log("[BattleSession] wave spawned wave=" .. waveNumber .. " enemies=" .. spawnedCount)
		if waveNumber == 1 then
			self:TryStartBattle()
		end
	end

	@ExecSpace("ServerOnly")
	method boolean CanSpawnWave(integer spawnCount, integer maxConcurrent)
		-- Enforces the configured live-enemy cap and requires enough currently empty board cells.
		if self.BoardState == nil then
			return false
		end
		local livingEnemies = self.BoardState:CollectLivingEnemies()
		if #livingEnemies + spawnCount > maxConcurrent then
			return false
		end
		local emptyCells = 0
		for cellIndex = 0, self.CellCount - 1 do
			if self.BoardState:FindAtCell(cellIndex, "") == nil then
				emptyCells = emptyCells + 1
			end
		end
		return emptyCells >= spawnCount
	end

	@ExecSpace("ServerOnly")
	method void ScheduleForcedSpawnTimer()
		self.WaveRuntime:ScheduleForcedSpawnTimer()
	end

	@ExecSpace("ServerOnly")
	method void ClearForcedSpawnSchedule(string reason)
		self.WaveRuntime:ClearForcedSpawnSchedule(reason)
		self:PublishWaveStateSnapshot(reason)
	end

	@ExecSpace("ServerOnly")
	method void EvaluateForcedSpawnAtTurnBoundary()
		-- Evaluates turn pressure and consumes one pending forced wave only after the full enemy round.
		local evaluation = self.WaveRuntime:EvaluateForcedSpawnAtTurnBoundary(self.StageTurnNumber, self.BattleResult ~= "")
		self:PublishWaveStateSnapshot("TURN_BOUNDARY")
		if evaluation.ShouldSpawn == false then
			return
		end

		self:SpawnWave(evaluation.WaveNumber)
		if self.CurrentWave == evaluation.WaveNumber then
			log("[BattleWave] force spawned reason=" .. evaluation.PendingReason .. " wave=" .. evaluation.WaveNumber .. " stageTurn=" .. self.StageTurnNumber)
		end
	end

	@ExecSpace("ServerOnly")
	method Entity SpawnWaveEnemy(string side, integer startCell, string facing, integer spawnOrder, table spawnDefinition)
		-- Spawns one enemy with a wave-unique name and UnitId, then registers its logical state.
		if self:IsValidCell(startCell) == false then
			log_error("[BattleWave] enemy spawn rejected side=" .. side .. " reason=NO_EMPTY_CELL")
			return nil
		end

		local unitId = "enemy_w" .. self.CurrentWave .. "_" .. side
		local entityName = "BattleEnemy_W" .. self.CurrentWave .. "_" .. side
		local position = self:GetCellPosition(startCell)
		local enemy = _SpawnService:SpawnByModelId(
			spawnDefinition.EnemyModelId,
			entityName,
			Vector3(position.x, position.y, 0),
			self.Entity
		)
		if isvalid(enemy) == false then
			log_error("[BattleWave] SpawnByModelId failed model=" .. spawnDefinition.EnemyModelId .. " unit=" .. unitId)
			return nil
		end

		local resolvedFacing = facing
		if spawnDefinition.InitialFacingPolicy == "FIXED_LEFT" then
			resolvedFacing = "Left"
		elseif spawnDefinition.InitialFacingPolicy == "FIXED_RIGHT" then
			resolvedFacing = "Right"
		end
		local unitInitialization = self:InitializeUnitState(enemy, unitId, "Enemy", startCell, resolvedFacing, spawnDefinition.MaxHp, spawnOrder)
		if unitInitialization.Success == false then
			log_error("[BattleWave] enemy initialization failed unit=" .. unitId .. " reason=" .. unitInitialization.Reason)
			_EntityService:Destroy(enemy)
			return nil
		end
		local enemyUnit = enemy:GetComponent("script.BattleUnitComponent")
		if enemyUnit ~= nil then
			local enemyConfiguration = enemyUnit:ConfigureEnemyDefinition(spawnDefinition.EnemyDefinitionId, spawnDefinition.BasicAttackDamage, spawnDefinition.PatternId, spawnDefinition.MovementPolicy, spawnDefinition.TraitIds or "", spawnDefinition.IsBoss == true, spawnDefinition.DisplayName or "")
			if enemyConfiguration.Success == false then
				log_error("[EnemyData] apply failed unit=" .. unitId .. " reason=" .. enemyConfiguration.Reason)
				_EntityService:Destroy(enemy)
				return nil
			end
			log("[EnemyData] applied unit=" .. unitId .. " definition=" .. enemyUnit.EnemyDefinitionId .. " hp=" .. enemyUnit.MaxHp .. " attack=" .. enemyUnit.BasicAttackDamage .. " pattern=" .. enemyUnit.EnemyPatternId .. " movement=" .. enemyUnit.EnemyMovementPolicy .. " traits=" .. enemyUnit.EnemyTraitIds .. " boss=" .. tostring(enemyUnit.IsBoss) .. " roll=" .. spawnDefinition.SelectionRoll .. "/" .. spawnDefinition.TotalWeight)
		end
		if spawnDefinition.EnemyDefinitionId == "ellinia_faust" then
			enemy:AddComponent("FaustSummonComponent")
		end
		local phaseState = enemy:GetComponent("script.BossPhaseStateComponent")
		if phaseState ~= nil then
			phaseState:ApplyPresentationOverrides(spawnDefinition)
		else
			self:ConfigureEnemyMovementPresentation(enemy, spawnDefinition)
		end
		-- Re-apply the logical cell after the resource-specific ground offset is configured.
		self:PlaceEntity(enemy, position)
		local registration = self:RegisterConfiguredUnit(enemy)
		if registration.Success == false then
			log_error("[BattleWave] enemy registration failed unit=" .. unitId .. " reason=" .. registration.Reason)
			_EntityService:Destroy(enemy)
			return nil
		end
		return enemy
	end

	@ExecSpace("ServerOnly")
	method void ConfigureEnemyMovementPresentation(Entity enemyEntity, table spawnDefinition)
		-- Injects the complete per-enemy motion profile without changing logical combat timing.
		if isvalid(enemyEntity) == false or spawnDefinition == nil then
			return
		end
		local presentation = enemyEntity:GetComponent("script.BattleUnitPresentationComponent")
		if presentation == nil then
			return
		end
		presentation.IdleMotionRuid = spawnDefinition.IdleMotionRuid or ""
		-- Idle is the restoration baseline; only action motions receive the combat speedup.
		presentation.IdleMotionPlayRate = math.max(0.1, tonumber(spawnDefinition.IdleMotionPlayRate) or 1)
		presentation.MovementMotionRuid = spawnDefinition.MoveMotionRuid or ""
		if presentation.MovementMotionRuid == "" then
			presentation.MovementMotionRuid = presentation.IdleMotionRuid
		end
		presentation.MovementMotionPlayRate = math.max(0.1, tonumber(spawnDefinition.MoveMotionPlayRate) or 1) * 3
		presentation.HitMotionRuid = spawnDefinition.HitMotionRuid or ""
		presentation.HitMotionPlayRate = math.max(0.1, tonumber(spawnDefinition.HitMotionPlayRate) or 1) * 3
		presentation.HitMotionDuration = math.max(0.05, tonumber(spawnDefinition.HitMotionDuration) or 0.25)
		presentation.AttackMotionRuid = spawnDefinition.AttackMotionRuid or ""
		presentation.AttackMotionPlayRate = math.max(0.1, tonumber(spawnDefinition.AttackMotionPlayRate) or 1) * 3
		presentation.AttackMotionDuration = math.max(0.05, tonumber(spawnDefinition.AttackMotionDuration) or 0.35)
		presentation.DeathMotionRuid = spawnDefinition.DeathMotionRuid or ""
		presentation.DeathMotionPlayRate = math.max(0.1, tonumber(spawnDefinition.DeathMotionPlayRate) or 1) * 3
		presentation.DeathMotionDuration = math.max(0.05, tonumber(spawnDefinition.DeathMotionDuration) or 0.5)
		presentation.GroundVisualOffsetY = tonumber(spawnDefinition.VisualOffsetY) or 0
		log("[EnemyMotionProfile] configured definition=" .. tostring(spawnDefinition.EnemyDefinitionId)
			.. " idle=" .. tostring(presentation.IdleMotionRuid)
			.. " move=" .. tostring(presentation.MovementMotionRuid)
			.. " hit=" .. tostring(presentation.HitMotionRuid)
			.. " attack=" .. tostring(presentation.AttackMotionRuid)
			.. " death=" .. tostring(presentation.DeathMotionRuid)
			.. " groundOffsetY=" .. tostring(presentation.GroundVisualOffsetY))
	end

	@ExecSpace("ServerOnly")
	method integer FindAvailableSpawnCell(integer preferredCell, integer searchDirection)
		-- Finds an empty cell from the requested board edge so a surviving player is never overlapped.
		local direction = searchDirection
		if direction ~= -1 then
			direction = 1
		end
		for offset = 0, self.CellCount - 1 do
			local cell = preferredCell + (offset * direction)
			if self:IsValidCell(cell) and self.BoardState:FindAtCell(cell, "") == nil then
				return cell
			end
		end
		return -1
	end

	@ExecSpace("ServerOnly")
	method void CleanupRegisteredEnemies(string reason)
		-- Unregisters and destroys only runtime enemy entities while preserving the stage player.
		if self.BoardState == nil then
			return
		end

		local registeredUnits = self.BoardState:CollectRegisteredUnits()
		for _, unitEntity in ipairs(registeredUnits) do
			local unit = unitEntity:GetComponent("script.BattleUnitComponent")
			if unit ~= nil and unit.Team == "Enemy" then
				self.BoardState:UnregisterUnit(unit.UnitId)
				if isvalid(unitEntity) then
					_EntityService:Destroy(unitEntity)
				end
			end
		end
		self.EnemyEntity = nil
		log("[BattleWave] enemies cleaned reason=" .. reason)
	end

	@ExecSpace("ServerOnly")
	method void CleanupDefeatedEnemies(string reason)
		-- Removes dead enemies only so forced waves can overlap with survivors from earlier waves.
		if self.BoardState == nil then
			return
		end
		local removedCount = 0
		local registeredUnits = self.BoardState:CollectRegisteredUnits()
		for _, unitEntity in ipairs(registeredUnits) do
			local unit = unitEntity:GetComponent("script.BattleUnitComponent")
			if unit ~= nil and unit.Team == "Enemy" and unit.IsDead == true then
				self.BoardState:UnregisterUnit(unit.UnitId)
				if isvalid(unitEntity) then
					_EntityService:Destroy(unitEntity)
				end
				removedCount = removedCount + 1
			end
		end
		log("[BattleWave] defeated enemies cleaned reason=" .. reason .. " count=" .. removedCount)
	end

	@ExecSpace("ServerOnly")
	method void RegisterPlayer(Entity player)
		-- Initializes one player as the controllable logical battle unit.
		if player == nil or player.PlayerComponent == nil then
			return
		end

		if self.PlayerEntity ~= nil and self.PlayerEntity == player then
			return
		end

		local previousRunSeed = self.RunSeed
		self.PlayerEntity = player
		local runState = _RunManagerLogic:EnsureRunState(player, self.RunSeed)
		if runState ~= nil then
			self.RunSeed = runState.RunSeed
			if runState.SelectedJobId == "" then
				_RunManagerLogic:ApplyJobSelection(player, "")
			end
			self:ApplyRunJobConfiguration(runState, player)
			if self.TurnState ~= nil and self.SelectedJobBaseQueueCapacity > 0 then
				self.TurnState:ConfigureQueueCapacity(self.SelectedJobBaseQueueCapacity, self.MinQueueCapacity, self.MaxQueueCapacity, "JOB_REGISTERED")
				self:PublishTurnStateSnapshot("JOB_REGISTERED")
			end
			log("[BattleRun] context synced sequence=" .. runState.RunSequence .. " seed=" .. self.RunSeed .. " state=" .. runState.RunState)
		end
		if player.PlayerControllerComponent ~= nil then
			player.PlayerControllerComponent.Enable = false
		end

		if player.MovementComponent ~= nil then
			player.MovementComponent:Stop()
		end

		local playerMaxHp = self.SelectedJobBaseMaxHp
		if runState ~= nil and runState.RunHpInitialized == true then
			playerMaxHp = runState.RunMaxHp
		end
		if playerMaxHp <= 0 then
			playerMaxHp = 100
		end
		self:ConfigureUnit(player, "player_01", "Player", self.PlayerStartCell, "Right", playerMaxHp, 1)
		self:RestorePlayerRunHp(player, runState, "PLAYER_REGISTERED")
		self:RefreshPlayerHpSnapshot("PLAYER_REGISTERED")
		if self.CurrentWave > 0 and previousRunSeed ~= self.RunSeed then
			log("[BattleRun] rebuilding for restored seed previous=" .. previousRunSeed .. " current=" .. self.RunSeed)
			self:RebuildBattleState("RUN_CONTEXT_SYNC")
		end
	end

	@ExecSpace("ServerOnly")
	method table RestorePlayerRunHp(Entity playerEntity, any runState, string reason)
		-- Restores the player-owned run HP after battle-unit initialization on every map entry or rebuild.
		if isvalid(playerEntity) == false or runState == nil then
			return { Success = false, Reason = "RUN_HP_CONTEXT_MISSING" }
		end
		local playerUnit = playerEntity:GetComponent("script.BattleUnitComponent")
		if playerUnit == nil then
			return { Success = false, Reason = "PLAYER_UNIT_MISSING" }
		end
		local hpSnapshot = runState:EnsureRunHpInitialized(playerUnit.MaxHp, reason)
		if hpSnapshot.Success == false then
			return hpSnapshot
		end
		local effects = playerEntity:GetComponent("script.PlayerRunRelicEffectComponent")
		if effects ~= nil then effects:Recalculate() end
		playerUnit.MaxHp = runState.RunMaxHp
		local restoreResult = playerUnit:RestoreCurrentHp(runState.RunCurrentHp)
		log("[RunHp] restored stage=" .. self.StageId .. " hp=" .. restoreResult.HpAfter .. "/" .. restoreResult.MaxHp .. " reason=" .. (reason or ""))
		return restoreResult
	end

	@ExecSpace("ServerOnly")
	method any EnsureBoardStateComponent()
		-- Prefers the dedicated map child so each runtime-state entity owns one script component.
		local boardState = self.Entity:GetComponent("script.BoardStateComponent")
		local stateEntity = self.Entity:GetChildByName("BattleBoardState")
		if stateEntity ~= nil then
			boardState = stateEntity:GetComponent("script.BoardStateComponent")
		end
		if boardState == nil then
			boardState = self.Entity:AddComponent("BoardStateComponent")
		end
		if boardState == nil then
			log_error("[BattleSession] failed to attach BoardStateComponent entity=" .. self.Entity.Name)
			return nil
		end
		self.BoardState = boardState
		return boardState
	end

	@ExecSpace("ServerOnly")
	method any EnsureTurnStateComponent()
		-- BattleTurnComponent is the single mutable owner of turn, action-slot, and skill-queue state.
		local turnState = self.Entity:GetComponent("script.BattleTurnComponent")
		local stateEntity = self.Entity:GetChildByName("BattleTurnState")
		if stateEntity ~= nil then
			turnState = stateEntity:GetComponent("script.BattleTurnComponent")
		end
		if turnState == nil then
			turnState = self.Entity:AddComponent("BattleTurnComponent")
		end
		if turnState == nil then
			log_error("[BattleSession] failed to attach BattleTurnComponent entity=" .. self.Entity.Name)
			return nil
		end
		self.TurnState = turnState
		return turnState
	end

	@ExecSpace("ServerOnly")
	method any EnsureEnemyIntentComponent()
		-- Makes EnemyIntentComponent the single mutable owner of the prepared enemy action snapshot.
		local intentRuntime = self.Entity:GetComponent("script.EnemyIntentComponent")
		local stateEntity = self.Entity:GetChildByName("BattleEnemyIntentState")
		if stateEntity ~= nil then
			intentRuntime = stateEntity:GetComponent("script.EnemyIntentComponent")
		end
		if intentRuntime == nil then
			intentRuntime = self.Entity:AddComponent("EnemyIntentComponent")
		end
		if intentRuntime == nil then
			log_error("[BattleSession] failed to attach EnemyIntentComponent entity=" .. self.Entity.Name)
			return nil
		end
		self.EnemyIntentRuntime = intentRuntime
		return intentRuntime
	end

	@ExecSpace("ServerOnly")
	method void PublishEnemyIntentSnapshot(string reason)
		-- Preserves the existing Session sync contract while EnemyIntentComponent owns mutable state.
		local intentRuntime = self.EnemyIntentRuntime
		if intentRuntime == nil then
			intentRuntime = self:EnsureEnemyIntentComponent()
		end
		if intentRuntime == nil then
			return
		end
		local snapshot = intentRuntime:GetSnapshot()
		self.PreparedEnemyIntentState = snapshot.State
		self.PreparedEnemyId = snapshot.EnemyId
		self.PreparedEnemyPatternId = snapshot.PatternId
		self.PreparedEnemyStepIndex = snapshot.StepIndex
		self.PreparedEnemyActionType = snapshot.ActionType
		self.PreparedEnemyTileId = snapshot.TileId
		self.PreparedEnemyTelegraphTurnsRemaining = snapshot.TelegraphTurnsRemaining
		self.PreparedEnemyDirection = snapshot.Direction
		self.PreparedEnemyTurn = snapshot.PreparedTurn
		self.PreparedEnemyReason = snapshot.Reason
		if reason ~= "" then
			log("[BattleSession] enemy intent snapshot reason=" .. reason .. " state=" .. snapshot.State .. " enemy=" .. snapshot.EnemyId .. " action=" .. snapshot.ActionType .. " revision=" .. snapshot.Revision)
		end
	end

	@ExecSpace("ServerOnly")
	method table BuildBossLandingTelegraph(any unit, string skillId)
		-- The server owns landing/range calculation; UI only renders this immutable DTO.
		local result = { Success = false, TelegraphKind = "", LandingCell = -1, TargetCells = "" }
		if unit == nil or unit.IsBoss ~= true or self.CellCount <= 0 then
			return result
		end
		local landingCell = unit.PendingLandingCell
		if unit.IsAirborne ~= true or self:IsValidCell(landingCell) == false then
			landingCell = 0
			if unit.CellIndex <= (self.CellCount - 1) * 0.5 then
				landingCell = self.CellCount - 1
			end
		end
		local cells = { tostring(landingCell) }
		local seen = { [landingCell] = true }
		local inwardDirection = landingCell == 0 and 1 or -1
		local definition = _SkillDefinitionRepositoryLogic:GetSkillDefinition(skillId)
		if definition.Success == true then
			for token in string.gmatch(definition.TargetOffsets or "", "([^|]+)") do
				local offset = math.abs(math.floor(tonumber(token) or 0))
				local targetCell = landingCell + inwardDirection * offset
				if offset > 0 and self:IsValidCell(targetCell) and seen[targetCell] ~= true then
					seen[targetCell] = true
					table.insert(cells, tostring(targetCell))
				end
			end
		end
		result.Success = true
		result.TelegraphKind = "BOSS_LANDING"
		result.LandingCell = landingCell
		result.TargetCells = table.concat(cells, "|")
		return result
	end

	@ExecSpace("ServerOnly")
	method table BuildChargeTelegraph(any unit, integer direction, string skillId)
		-- Reuses the shared target-cell snapshot; the client only renders this server-owned line.
		local result = { Success = false, TelegraphKind = "", LandingCell = -1, TargetCells = "" }
		if unit == nil or unit.IsDead == true or self.BoardState == nil or self.CellCount <= 0 then
			return result
		end
		if direction ~= -1 and direction ~= 1 then
			direction = unit.Facing == "Right" and 1 or -1
		end
		local definition = _SkillDefinitionRepositoryLogic:GetSkillDefinition(skillId)
		if definition.Success == false then
			return result
		end
		local cells = {}
		local maxDistance = math.max(1, math.min(self.CellCount, math.floor(tonumber(definition.Range) or 1)))
		for offset = 1, maxDistance do
			local cellIndex = unit.CellIndex + direction * offset
			if self:IsValidCell(cellIndex) == false then
				break
			end
			local occupantEntity = self.BoardState:FindAtCell(cellIndex, unit.UnitId)
			if isvalid(occupantEntity) then
				local occupantUnit = occupantEntity:GetComponent("script.BattleUnitComponent")
				if occupantUnit ~= nil and occupantUnit.IsDead == false and occupantUnit.Team ~= unit.Team then
					table.insert(cells, tostring(cellIndex))
				end
				break
			end
			table.insert(cells, tostring(cellIndex))
		end
		result.Success = true
		result.TelegraphKind = "CHARGE_LINE"
		result.TargetCells = table.concat(cells, "|")
		return result
	end

	@ExecSpace("ServerOnly")
	method table BuildSkillAreaTelegraph(any unit, string skillId)
		-- Uses the same target resolver as impact execution so the warning cells cannot drift from damage.
		local result = { Success = false, TelegraphKind = "", LandingCell = -1, TargetCells = "" }
		if unit == nil or unit.IsDead == true or self.BoardState == nil or skillId == "" then
			return result
		end
		local definition = _SkillDefinitionRepositoryLogic:GetSkillDefinition(skillId)
		if definition.Success == false then
			return result
		end
		local targetResult = _SkillTargetResolverLogic:Resolve(self, unit.UnitId, definition)
		if targetResult.Success == false then
			return result
		end
		result.Success = true
		result.TelegraphKind = "SKILL_AREA"
		result.TargetCells = _SkillTargetResolverLogic:SerializeIntegers(targetResult.TargetCellIndices)
		return result
	end

	@ExecSpace("ServerOnly")
	method void PublishEnemyPlanSnapshot(string reason)
		-- Synchronizes a compact read-only list so UI can render every enemy without running AI rules.
		local entries = {}
		if self.BoardState ~= nil then
			local livingEnemies = self.BoardState:CollectLivingEnemies()
			for _, enemyEntity in ipairs(livingEnemies) do
				local unit = enemyEntity:GetComponent("script.BattleUnitComponent")
				local plan = enemyEntity:GetComponent("script.EnemyActionPlanComponent")
				if unit ~= nil and plan ~= nil and plan.PlanState ~= "EMPTY" then
					local bossPhase = enemyEntity:GetComponent("script.BossPhaseStateComponent")
					local bossPhaseId = ""
					local bossPhaseIndex = 0
					local bossPhaseRevision = 0
					if bossPhase ~= nil then
						bossPhaseId = bossPhase.PhaseId
						bossPhaseIndex = bossPhase.PhaseIndex
						bossPhaseRevision = bossPhase.PhaseRevision
					end
					local current = plan:GetCurrentAction()
					local actionType = ""
					local tileId = ""
					local direction = 0
					local telegraphTurns = 0
					local patternId = unit.EnemyPatternId
					local stepIndex = 0
					if current.Success == true then
						actionType = current.ActionType
						tileId = current.TileId
						direction = current.Direction
						telegraphTurns = current.TelegraphTurnsRemaining
						patternId = current.PatternId
						stepIndex = current.StepIndex
					end
					-- Individually inserted skills are already owned while the next skill is loading.
					local hasVisibleQueue = plan.PlanState == "TRACKING"
						or plan.PlanState == "ATTACK_READY"
						or plan.PlanState == "EXECUTING"
						or (plan.PlanState == "INSERTING" and plan.QueueSkillsIndividually and plan.PlannedActionCount > 0)
					local queuedTileNames = ""
					local queuedIconRuids = ""
					local queuedIconBackgroundColors = ""
					if hasVisibleQueue then
						queuedTileNames = self:GetEnemyQueueDisplayNames(plan.PlannedActionSnapshot)
						queuedIconRuids = self:GetEnemyQueueIconRuids(plan.PlannedActionSnapshot)
						queuedIconBackgroundColors = self:GetEnemyQueueIconBackgroundColors(plan.PlannedActionSnapshot)
					end
					local targetCellSnapshot = plan.TargetCellSnapshot
					local telegraphKind = ""
					local landingCell = -1
					if actionType == "BOSS_JUMP_TELEGRAPH" or actionType == "BOSS_LAND_OPPOSITE" then
						local telegraph = self:BuildBossLandingTelegraph(unit, tileId)
						if telegraph.Success == true then
							targetCellSnapshot = telegraph.TargetCells
							telegraphKind = telegraph.TelegraphKind
							landingCell = telegraph.LandingCell
						end
					elseif actionType == "CHARGE_FORWARD" then
						local telegraph = self:BuildChargeTelegraph(unit, direction, tileId)
						if telegraph.Success == true then
							targetCellSnapshot = telegraph.TargetCells
							telegraphKind = telegraph.TelegraphKind
						end
					elseif actionType == "TELEGRAPH_TILE" then
						local telegraph = self:BuildSkillAreaTelegraph(unit, tileId)
						if telegraph.Success == true then
							targetCellSnapshot = telegraph.TargetCells
							telegraphKind = telegraph.TelegraphKind
						end
					end
					table.insert(entries, table.concat({
						unit.UnitId,
						tostring(unit.SpawnOrder),
						plan.PlanState,
						tostring(plan.CurrentActionIndex),
						tostring(plan.PlannedActionCount),
						plan.TraitIds ~= "" and plan.TraitIds or "-",
						actionType ~= "" and actionType or "-",
						tileId ~= "" and tileId or "-",
						tostring(direction),
						tostring(telegraphTurns),
						patternId ~= "" and patternId or "-",
						tostring(stepIndex),
						tostring(plan.PlanRevision),
						plan.PlannedActionSnapshot ~= "" and plan.PlannedActionSnapshot or "-",
						bossPhaseId ~= "" and bossPhaseId or "-",
						tostring(bossPhaseIndex),
						tostring(bossPhaseRevision),
						tostring(plan.QueueTurnsRequired),
						tostring(plan.QueueTurnsElapsed),
						plan.ReadinessReason ~= "" and plan.ReadinessReason or "-",
						plan.NextCommandType ~= "" and plan.NextCommandType or "-",
						targetCellSnapshot ~= "" and targetCellSnapshot or "-",
						tostring(plan.NextCommandDirection),
						enemyEntity.Name ~= "" and enemyEntity.Name or "-",
						queuedTileNames ~= "" and queuedTileNames or "-",
						queuedIconRuids ~= "" and queuedIconRuids or "-",
						telegraphKind ~= "" and telegraphKind or "-",
						tostring(landingCell),
						tostring(plan.DeferredUntilTurn),
						queuedIconBackgroundColors ~= "" and queuedIconBackgroundColors or "-",
						plan.CastState ~= "" and plan.CastState or "NONE",
						plan.CastingSkillId ~= "" and plan.CastingSkillId or "-",
						tostring(plan.InterruptHitsRequired),
						tostring(plan.InterruptHitsReceived)
					}, ","))
				end
			end
		end
		self.EnemyPlanSnapshot = table.concat(entries, "#")
		self.EnemyPlanCount = #entries
		self.EnemyPlanRevision = self.EnemyPlanRevision + 1
		log("[EnemyRoundPlan] publish reason=" .. reason .. " count=" .. self.EnemyPlanCount .. " revision=" .. self.EnemyPlanRevision .. " snapshot=" .. self.EnemyPlanSnapshot)
	end

	@ExecSpace("ServerOnly")
	method string GetEnemyQueueDisplayNames(string actionSnapshot)
		-- Resolves authoring DisplayName values on the server so UI never reads server-only DataSets.
		local names = {}
		for actionEntry in string.gmatch(actionSnapshot or "", "([^>]+)") do
			local actionFields = {}
			for actionField in string.gmatch(actionEntry, "([^~]+)") do
				table.insert(actionFields, actionField)
			end
			local tileId = ""
			if #actionFields >= 3 then
				tileId = actionFields[3]
				if tileId == "-" then
					tileId = ""
				end
			end
			if tileId ~= "" then
				local definition = _SkillDefinitionRepositoryLogic:GetSkillDefinition(tileId)
				local displayName = tileId
				if definition.Success == true and definition.DisplayName ~= nil and definition.DisplayName ~= "" then
					displayName = definition.DisplayName
				end
				table.insert(names, displayName)
			end
		end
		return table.concat(names, "|")
	end

	@ExecSpace("ServerOnly")
	method string GetEnemyQueueIconRuids(string actionSnapshot)
		-- Presentation data is authored beside the Skill row and published for client-only HUDs.
		local iconRuids = {}
		for actionEntry in string.gmatch(actionSnapshot or "", "([^>]+)") do
			local actionFields = {}
			for actionField in string.gmatch(actionEntry, "([^~]+)") do
				table.insert(actionFields, actionField)
			end
			local tileId = #actionFields >= 3 and actionFields[3] or ""
			if tileId ~= "" and tileId ~= "-" then
				local definition = _SkillDefinitionRepositoryLogic:GetSkillDefinition(tileId)
				local iconRuid = ""
				if definition.Success == true then
					iconRuid = definition.HudIconRuid or ""
				end

				table.insert(iconRuids, iconRuid ~= "" and iconRuid or "-")
			end
		end
		return table.concat(iconRuids, "|")
	end

	@ExecSpace("ServerOnly")
	method string GetEnemyQueueIconBackgroundColors(string actionSnapshot)
		-- Preserve slot placeholders and omit # on the wire because it separates enemy records.
		local colors = {}
		for actionEntry in string.gmatch(actionSnapshot or "", "([^>]+)") do
			local fields = {}
			for field in string.gmatch(actionEntry, "([^~]+)") do
				table.insert(fields, field)
			end
			local tileId = fields[3] or ""
			if tileId ~= "" and tileId ~= "-" then
				local definition = _SkillDefinitionRepositoryLogic:GetSkillDefinition(tileId)
				local color = definition.Success and (definition.HudIconBackgroundColor or "") or ""
				table.insert(colors, string.match(color, "^#%x%x%x%x%x%x%x%x$") and string.sub(color, 2) or "-")
			end
		end
		return table.concat(colors, "|")
	end

	@ExecSpace("ServerOnly")
	method void PublishSkillTargetResolution(string skillId, string targetingType, string targetUnitIds, string targetCellIndices, string reason)
		-- Exposes only the resolved impact snapshot; UI never repeats board targeting rules.
		self.LastSkillTargetSkillId = skillId or ""
		self.LastSkillTargetingType = targetingType or ""
		self.LastSkillTargetUnitIds = targetUnitIds or ""
		self.LastSkillTargetCellIndices = targetCellIndices or ""
		self.LastSkillTargetReason = reason or ""
		self.SkillTargetRevision = self.SkillTargetRevision + 1
		log("[BattleSkillTarget] published skill=" .. self.LastSkillTargetSkillId .. " type=" .. self.LastSkillTargetingType .. " cells=" .. self.LastSkillTargetCellIndices .. " targets=" .. self.LastSkillTargetUnitIds .. " reason=" .. self.LastSkillTargetReason .. " revision=" .. self.SkillTargetRevision)
	end

	@ExecSpace("ServerOnly")
	method void PublishTurnStateSnapshot(string reason)
		-- Temporary compatibility bridge: external readers may keep using BattleSession while the owner is BattleTurnComponent.
		local turnState = self.TurnState
		if turnState == nil then
			turnState = self:EnsureTurnStateComponent()
		end
		if turnState == nil then
			return
		end
		self.BattlePhase = turnState.BattlePhase
		self.TurnNumber = turnState.TurnNumber
		self.QueuedActionType = turnState.QueuedActionType
		self.QueuedActionDirection = turnState.QueuedActionDirection
		self.IsActionProcessing = turnState.IsActionProcessing
		self.QueuedTileIds = turnState.QueuedTileIds
		self.QueuedTileCount = turnState.QueuedTileCount
		self.ExecutingTileIds = turnState.ExecutingTileIds
		self.ExecutingTileIndex = turnState.ExecutingTileIndex
		self.TileQueueCapacity = turnState.TileQueueCapacity
		if reason ~= "" then
			log("[BattleSession] turn snapshot reason=" .. reason .. " phase=" .. self.BattlePhase .. " turn=" .. self.TurnNumber .. " queue=" .. self.QueuedTileCount .. "/" .. self.TileQueueCapacity)
		end
	end

	@ExecSpace("ServerOnly")
	method any EnsureWaveStateComponent()
		-- Prefers the dedicated map child so Wave state and Timer lifetime stay isolated from Session.
		local waveRuntime = self.Entity:GetComponent("script.BattleWaveComponent")
		local stateEntity = self.Entity:GetChildByName("BattleWaveState")
		if stateEntity ~= nil then
			waveRuntime = stateEntity:GetComponent("script.BattleWaveComponent")
		end
		if waveRuntime == nil then
			waveRuntime = self.Entity:AddComponent("BattleWaveComponent")
		end
		if waveRuntime == nil then
			log_error("[BattleSession] failed to attach BattleWaveComponent entity=" .. self.Entity.Name)
			return nil
		end
		self.WaveRuntime = waveRuntime
		return waveRuntime
	end

	@ExecSpace("ServerOnly")
	method any EnsureDropStateComponent()
		-- Keeps uncollected battle rewards map-scoped so they cannot leak into the next stage.
		local dropRuntime = self.Entity:GetComponent("script.BattleDropComponent")
		if dropRuntime == nil then
			dropRuntime = self.Entity:AddComponent("BattleDropComponent")
		end
		if dropRuntime == nil then
			log_error("[BattleSession] failed to attach BattleDropComponent entity=" .. self.Entity.Name)
			return nil
		end
		self.DropRuntime = dropRuntime
		return dropRuntime
	end

	@ExecSpace("ServerOnly")
	method void PublishWaveStateSnapshot(string reason)
		-- Temporary compatibility bridge for existing HUD and external Snapshot consumers.
		local waveRuntime = self.WaveRuntime
		if waveRuntime == nil then
			waveRuntime = self:EnsureWaveStateComponent()
		end
		if waveRuntime == nil then
			return
		end
		self.CurrentWave = waveRuntime.CurrentWave
		self.TotalWaves = waveRuntime.TotalWaves
		self.WaveState = waveRuntime.WaveState
		self.WaveSpawnStageTurn = waveRuntime.WaveSpawnStageTurn
		self.CurrentWaveSpawnMode = waveRuntime.CurrentWaveSpawnMode
		self.ForceAfterTurns = waveRuntime.ForceAfterTurns
		self.ForceAfterSeconds = waveRuntime.ForceAfterSeconds
		self.ForceSpawnPending = waveRuntime.ForceSpawnPending
		self.ForceSpawnPendingReason = waveRuntime.ForceSpawnPendingReason
		self.CurrentWaveSpawnCount = waveRuntime.CurrentWaveSpawnCount
		self.MaxConcurrentEnemies = waveRuntime.MaxConcurrentEnemies
		self.CurrentClearSpawnDelay = waveRuntime.CurrentClearSpawnDelay
		if reason ~= "" then
			log("[BattleSession] wave snapshot reason=" .. reason .. " wave=" .. self.CurrentWave .. "/" .. self.TotalWaves .. " state=" .. self.WaveState .. " pending=" .. tostring(self.ForceSpawnPending))
		end
	end

	@ExecSpace("ServerOnly")
	method any EnsureUnitComponent(Entity targetEntity)
		-- Returns the target's BattleUnitComponent, attaching it at runtime when necessary.
		local unit = targetEntity:GetComponent("script.BattleUnitComponent")
		if unit == nil then
			unit = targetEntity:AddComponent("BattleUnitComponent")
		end

		if unit == nil then
			log_error("[BattleSession] failed to attach BattleUnitComponent entity=" .. targetEntity.Name)
		end
		return unit
	end

	@ExecSpace("ServerOnly")
	method any EnsurePresentationComponent(Entity targetEntity)
		-- Attaches optional visual behavior to runtime-created players while preserving placed enemy settings.
		local presentation = targetEntity:GetComponent("script.BattleUnitPresentationComponent")
		if presentation == nil then
			presentation = targetEntity:AddComponent("BattleUnitPresentationComponent")
		end

		if presentation == nil then
			log_error("[BattleSession] failed to attach BattleUnitPresentationComponent entity=" .. targetEntity.Name)
		end
		return presentation
	end

	@ExecSpace("ServerOnly")
	method any EnsureSkillRuntimeStateComponent(Entity targetEntity)
		-- Keeps mutable cooldowns on their owning unit rather than the map session.
		local runtimeState = targetEntity:GetComponent("script.SkillRuntimeStateComponent")
		if runtimeState == nil then
			runtimeState = targetEntity:AddComponent("SkillRuntimeStateComponent")
		end
		if runtimeState == nil then
			log_error("[BattleSession] failed to attach SkillRuntimeStateComponent entity=" .. targetEntity.Name)
		end
		return runtimeState
	end

	@ExecSpace("ServerOnly")
	method void ConfigureUnit(Entity targetEntity, string unitId, string team, integer cellIndex, string facing, number maxHp, integer spawnOrder)
		-- Convenience path for player units; enemies defer registry visibility until definition setup completes.
		local initialization = self:InitializeUnitState(targetEntity, unitId, team, cellIndex, facing, maxHp, spawnOrder)
		if initialization.Success == false then
			log_error("[BattleSession] unit initialization failed unit=" .. unitId .. " reason=" .. initialization.Reason)
			return
		end
		local registration = self:RegisterConfiguredUnit(targetEntity)
		if registration.Success == false then
			log_error("[BattleSession] registry rejected unit=" .. unitId .. " reason=" .. registration.Reason)
		end
	end

	@ExecSpace("ServerOnly")
	method table InitializeUnitState(Entity targetEntity, string unitId, string team, integer cellIndex, string facing, number maxHp, integer spawnOrder)
		-- Builds a complete unit object before it becomes visible to BoardState and turn planning.
		if self:IsValidCell(cellIndex) == false then
			return { Success = false, Reason = "INVALID_INITIAL_CELL" }
		end

		local unit = self:EnsureUnitComponent(targetEntity)
		if unit == nil then
			return { Success = false, Reason = "UNIT_COMPONENT_MISSING" }
		end
		self:EnsurePresentationComponent(targetEntity)
		local skillRuntimeState = self:EnsureSkillRuntimeStateComponent(targetEntity)
		if skillRuntimeState == nil then
			return { Success = false, Reason = "SKILL_RUNTIME_STATE_MISSING" }
		end
		skillRuntimeState:ResetSkillRuntimeState("UNIT_CONFIGURED")

		local initializeResult = unit:InitializeBattleState(unitId, team, cellIndex, facing, maxHp, spawnOrder)
		if initializeResult.Success == false then
			return initializeResult
		end
		self:ApplyFacing(targetEntity, facing)

		local position = self:GetCellPosition(cellIndex)
		self:PlaceEntity(targetEntity, position)
		if team == "Player" and targetEntity.PlayerComponent ~= nil then
			self:LockBoardCamera(self:GetBoardCenterX(), targetEntity.PlayerComponent.UserId)
		end
		return { Success = true, Reason = "UNIT_STATE_INITIALIZED", UnitId = unitId, PositionX = position.x }
	end

	@ExecSpace("ServerOnly")
	method table RegisterConfiguredUnit(Entity targetEntity)
		local unit = targetEntity:GetComponent("script.BattleUnitComponent")
		if unit == nil then return { Success = false, Reason = "UNIT_COMPONENT_MISSING" } end
		if self.BoardState == nil then
			return { Success = false, Reason = "REGISTRY_MISSING" }
		end
		local registerResult = self.BoardState:RegisterUnit(targetEntity)
		if registerResult.Success == false then
			return registerResult
		end
		local position = self:GetCellPosition(unit.CellIndex)
		log("[BattleSession] unit registered id=" .. unit.UnitId .. " team=" .. unit.Team .. " cell=" .. unit.CellIndex .. " spawnOrder=" .. unit.SpawnOrder .. " x=" .. position.x)
		return { Success = true, Reason = "UNIT_REGISTERED", UnitId = unit.UnitId }
	end

	@ExecSpace("Server")
	method void RequestUtilitySkill()
		-- The server chooses the utility from the selected job; clients cannot submit arbitrary skill IDs.
		if isvalid(self.PlayerEntity) == false or self.PlayerEntity.PlayerComponent == nil
			or self.PlayerEntity.PlayerComponent.UserId ~= senderUserId
			or self.PlayerEntity.CurrentMap ~= self.Entity then
			return
		end
		local result = self:TryUseUtilitySkill()
		self:PublishPlayerCommandResult("UTILITY", result)
		log("[UtilitySkill] request job=" .. self.SelectedJobId .. " skill=" .. self.UtilitySkillId
			.. " success=" .. tostring(result.Success) .. " reason=" .. result.Reason)
	end

	@ExecSpace("ServerOnly")
	method table TryUseUtilitySkill()
		-- Reserves the existing immediate-action lock without consuming or rewriting queued skills.
		if self.TurnState == nil or self.BoardState == nil or self.BattleResult ~= ""
			or self.BattlePhase ~= "PlayerTurn" then
			return { Success = false, Reason = "INVALID_PHASE" }
		end
		local unit = self.PlayerEntity:GetComponent("script.BattleUnitComponent")
		if unit == nil or unit.IsDead or unit.IsAirborne then
			return { Success = false, Reason = "UNIT_UNAVAILABLE" }
		end
		local bundle = _SkillDefinitionRepositoryLogic:GetUtilitySkillBundle(self.SelectedJobId)
		if bundle.Success == false then return bundle end
		local definition = bundle.Definition
		local runtime = self:GetSkillRuntimeState("player_01")
		if runtime == nil then return { Success = false, Reason = "SKILL_RUNTIME_STATE_MISSING" } end
		local cooldown = runtime:CanUseSkill(definition.SkillId)
		if cooldown.Success == false then return cooldown end
		local reserved = self.TurnState:TryReserveImmediateAction("UTILITY", 0)
		if reserved.Success == false then return reserved end
		self.CurrentPlayerActionKillCount = 0
		local result = self:ExecuteUtilityEffect(definition, bundle.Step, unit)
		if result.Success == false then
			self:CompleteQueuedAction("UTILITY", false, result.Reason)
			return result
		end
		-- A utility effect resolves synchronously, so this is still cast time; arming the presentation only
		-- after acceptance keeps a rejected cast (no target, blocked destination) silent. Utility rows author
		-- no cast/hit clip today, so in practice this presents the authored cast sound alone.
		self:BeginSkillEffectPresentation(unit.UnitId, definition)
		self.UtilitySkillId = definition.SkillId
		self.UtilitySkillIconRuid = definition.IconRuid
		self.UtilityMaxCooldown = definition.CooldownTurns
		runtime:StartCooldown(definition.SkillId, definition.CooldownTurns)
		self.UtilityRemainingCooldown = runtime:GetRemainingCooldown(definition.SkillId)
		self:PublishTurnStateSnapshot("UTILITY_EXECUTED")
		local duration = math.max(0.1, definition.ActionDuration) / self:GetSkillSpeedMultiplier()
		self.ActionTimerId = _TimerService:SetTimerOnce(function()
			self:CompleteQueuedAction("UTILITY", true, result.Reason)
		end, duration)
		return result
	end

	@ExecSpace("ServerOnly")
	method table ExecuteUtilityEffect(table definition, table step, any sourceUnit)
		-- Executes the authored utility effect through existing board, push and HP boundaries.
		local direction = sourceUnit.Facing == "Right" and 1 or -1
		local sourceCell = sourceUnit.CellIndex
		if step.EffectType == "GUARD" and step.TargetSelector == "SELF_UNIT"
			and step.ParameterA == "UNTIL_NEXT_PLAYER_TURN" and step.ParameterB == "ALL_DAMAGE" then
			sourceUnit.UtilityGuardActive = true
			return { Success = true, Reason = "UTILITY_GUARD_ACTIVE" }
		end
		if step.EffectType == "MOVE_SELF" and step.TargetSelector == "SELF_UNIT" then
			local destination = -1
			if step.ParameterA == "FARTHEST_EMPTY_FORWARD" then
				for distance = 1, self.CellCount do
					local cell = sourceCell + direction * distance
					if self:IsValidCell(cell) and self:IsCellOccupied(cell, sourceUnit.UnitId) == false then
						destination = cell
					end
				end
			elseif step.ParameterA == "BEHIND_FARTHEST_ENEMY_FORWARD" and step.ParameterB == "REQUIRE_EMPTY" then
				local farthestEnemy = -1
				for distance = 1, self.CellCount do
					local cell = sourceCell + direction * distance
					if self:IsValidCell(cell) then
						local entity = self.BoardState:FindAtCell(cell, sourceUnit.UnitId)
						if isvalid(entity) then
							local target = entity:GetComponent("script.BattleUnitComponent")
							if target ~= nil and target.Team ~= sourceUnit.Team and not target.IsDead and not target.IsAirborne then
								farthestEnemy = cell
							end
						end
					end
				end
				if farthestEnemy >= 0 then
					destination = farthestEnemy + direction * math.max(1, math.floor(step.Value))
				end
			else
				return { Success = false, Reason = "UTILITY_MOVE_RULE_UNSUPPORTED" }
			end
			if self:IsValidCell(destination) == false or self:IsCellOccupied(destination, sourceUnit.UnitId) then
				return { Success = false, Reason = "UTILITY_NO_EMPTY_DESTINATION" }
			end
			return self:RelocateUnitForMechanic(sourceUnit.UnitId, destination, definition.SkillId)
		end
		if step.EffectType ~= "PUSH_DISTANCE"
			or (step.ParameterA ~= "STOP_BEFORE_BLOCKED" and step.ParameterA ~= "MAX")
			or (step.TargetSelector ~= "PRIMARY_TARGET" and step.TargetSelector ~= "ALL_SKILL_TARGETS") then
			return { Success = false, Reason = "UTILITY_EFFECT_UNSUPPORTED" }
		end
		local targets = _SkillTargetResolverLogic:Resolve(self, sourceUnit.UnitId, definition)
		if targets.Success == false then return targets end
		local targetIds = step.TargetSelector == "PRIMARY_TARGET" and { targets.PrimaryTargetUnitId } or targets.TargetUnitIds
		if #targetIds == 0 or targetIds[1] == "" then
			return { Success = false, Reason = "UTILITY_NO_TARGET" }
		end
		-- Move the farthest target first so nearer targets cannot block a multi-target wave.
		table.sort(targetIds, function(left, right)
			return math.abs(targets.TargetCellsByUnitId[left] - sourceCell) > math.abs(targets.TargetCellsByUnitId[right] - sourceCell)
		end)
		local maxSteps = step.ParameterA == "MAX" and self.CellCount or math.max(0, math.floor(step.Value))
		local moved = 0
		for _, targetId in ipairs(targetIds) do
			for distance = 1, maxSteps do
				local pushed = self:ResolvePushImpactOnTarget(sourceUnit.UnitId, targetId)
				if pushed.Success == false or pushed.Reason ~= "PUSHED" then break end
				moved = moved + 1
			end
		end
		if step.ParameterB == "CARRY_CASTER" and moved > 0 then
			local destination = sourceCell
			for distance = 1, self.CellCount do
				local cell = sourceCell + direction * distance
				if self:IsValidCell(cell) == false or self:IsCellOccupied(cell, sourceUnit.UnitId) then break end
				destination = cell
			end
			if destination ~= sourceCell then
				self:RelocateUnitForMechanic(sourceUnit.UnitId, destination, definition.SkillId)
			end
		end
		log("[UtilitySkill] pushed skill=" .. definition.SkillId .. " cells=" .. tostring(moved))
		return { Success = true, Reason = moved > 0 and "UTILITY_PUSHED" or "UTILITY_PUSH_BLOCKED" }
	end

	@ExecSpace("Server")
	method void RequestTurn()
		-- Validates the requesting client before forwarding the turn request.
		if isvalid(self.PlayerEntity) == false or self.PlayerEntity.PlayerComponent == nil then
			log_warning("[BattleTurn] rejected reason=PLAYER_MISSING")
			return
		end

		if self.PlayerEntity.PlayerComponent.UserId ~= senderUserId then
			log_warning("[BattleTurn] rejected reason=INVALID_SENDER")
			return
		end

		local result = self:TryQueuePlayerAction("TURN", 0)
		self:PublishPlayerCommandResult("TURN", result)
		local playerUnit = self.PlayerEntity:GetComponent("script.BattleUnitComponent")
		if playerUnit ~= nil then
			self:ConfirmLocalPlayerFacing(playerUnit.Facing)
		end
		if result.Success == false then
			log_warning("[BattleQueue] rejected action=TURN reason=" .. result.Reason)
		end
	end

	@ExecSpace("ServerOnly")
	method table TryQueuePlayerAction(string actionType, integer direction)
		-- Accepts at most one player action and keeps the slot occupied until presentation time ends.
		local result = { Success = false, Reason = "UNKNOWN" }

		if actionType ~= "MOVE" and actionType ~= "TURN" then
			result.Reason = "INVALID_ACTION"
			return result
		end

		if actionType == "MOVE" and direction ~= -1 and direction ~= 1 then
			result.Reason = "INVALID_DIRECTION"
			return result
		end

		result = self.TurnState:TryReserveImmediateAction(actionType, direction)
		if result.Success == false then
			return result
		end
		self:PublishTurnStateSnapshot("IMMEDIATE_ACTION_QUEUED")
		log("[BattleQueue] queued action=" .. actionType .. " direction=" .. direction)
		self:ExecuteQueuedAction()
		return result
	end

	@ExecSpace("ServerOnly")
	method void ExecuteQueuedAction()
		-- Dispatches the queued action through the existing authoritative action functions.
		local actionType = self.TurnState.QueuedActionType
		local direction = self.TurnState.QueuedActionDirection
		if actionType == "" then
			return
		end

		self.CurrentPlayerActionKillCount = 0
		log("[BattleQueue] started action=" .. actionType .. " direction=" .. direction)

		local actionResult = nil
		if actionType == "MOVE" then
			actionResult = self:TryMove("player_01", direction)
		elseif actionType == "TURN" then
			actionResult = self:TryTurn("player_01")
		end

		if actionResult == nil or actionResult.Success == false then
			local reason = "EXECUTION_FAILED"
			if actionResult ~= nil then
				reason = actionResult.Reason
			end
			self:CompleteQueuedAction(actionType, false, reason)
			return
		end

		local duration = self:GetActionDuration(actionType)
		local complete = function()
			self:CompleteQueuedAction(actionType, true, actionResult.Reason)
		end
		if actionType == "MOVE" and actionResult.PresentationStarted == true and self._T.playerGridMove ~= nil then
			-- The visual snap is the primary completion signal. This slightly-late timer is only a
			-- fail-safe so a lost presentation update can never leave the authoritative turn locked.
			self._T.playerGridMove.CompletionReason = actionResult.Reason
			self.ActionTimerId = _TimerService:SetTimerOnce(complete, duration + math.max(0.02, self.MoveCompletionFallbackGrace))
			return
		end
		self.ActionTimerId = _TimerService:SetTimerOnce(complete, duration)
	end

	@ExecSpace("ServerOnly")
	method number GetActionDuration(string actionType)
		if actionType == "MOVE" then
			return self:GetPlayerMoveDuration()
		elseif actionType == "TURN" then
			return math.max(0.05, self.PlayerTurnActionDuration)
		elseif actionType == "PUSH" then
			return math.max(0.1, self.PushActionDuration)
		end

		return 0.05
	end

	@ExecSpace("ServerOnly")
	method void CompleteQueuedAction(string actionType, boolean success, string reason)
		-- A valid player action hands control to the enemy; invalid actions release input immediately.
		if self.TurnState == nil or self.TurnState.QueuedActionType ~= actionType then
			log_warning("[BattleTurnTempo] duplicate immediate completion blocked action=" .. actionType .. " reason=" .. reason)
			return
		end
		if actionType == "MOVE" then
			self:FinishPlayerGridMovePresentation("ACTION_COMPLETE")
		end
		self.ActionTimerId = 0
		self.TurnState:CompleteImmediateAction(reason)
		self:PublishTurnStateSnapshot("IMMEDIATE_ACTION_COMPLETED")
		log("[BattleQueue] completed action=" .. actionType .. " success=" .. tostring(success) .. " reason=" .. reason)
		if self.BattleResult ~= "" then
			return
		end

		if success == true then
			self:BeginEnemyTurnFromPlayerAction("IMMEDIATE_ACTION_COMPLETED")
			return
		end

	end

	@ExecSpace("ServerOnly")
	method void BeginEnemyTurnFromPlayerAction(string completionReason)
		-- The authoritative action completion has already happened. Lock the enemy phase now,
		-- then consume only the presentation handoff that this action still needs.
		self:RecordRunConsumedPlayerTurn()
		local handoffDelay = self.PlayerToEnemyBeatDuration
		if completionReason == "IMMEDIATE_ACTION_COMPLETED" or completionReason == "SKILL_QUEUE_COMPLETED" then
			handoffDelay = self.PlayerPresentationSettledBeatDuration
		elseif completionReason == "SKILL_QUEUED" then
			-- Reservation is a real turn handoff. Let its existing pop read before the enemy acts.
			handoffDelay = self.QueuePopDuration
		end
		self.PlayerToEnemyBeatPending = true
		self.PendingPlayerToEnemyHandoffDelay = math.max(0.016, math.min(0.12, handoffDelay))
		log("[BattlePlayerHandoff] player action completed reason=" .. completionReason .. " remainingBeat=" .. tostring(self.PendingPlayerToEnemyHandoffDelay))
		self:BeginEnemyTurn()
	end

	@ExecSpace("ServerOnly")
	method void BeginEnemyTurnFromEnemyAction(string completedEnemyId, string completedActionType)
		-- Marks only the presentation cadence between two already-ordered enemy actions.
		-- Authoritative completion happens before this method and the next intent still executes later.
		self.EnemyToEnemyHandoffPending = true
		self.PendingEnemyHandoffSourceId = completedEnemyId
		self.PendingEnemyHandoffActionType = completedActionType
		self:BeginEnemyTurn()
	end

	@ExecSpace("ServerOnly")
	method void BeginEnemyTurn()
		-- Executes only actions that were frozen for every enemy before the player committed this turn.
		local usePlayerTransitionBeat = self.PlayerToEnemyBeatPending
		local playerHandoffDelay = self.PendingPlayerToEnemyHandoffDelay
		local useEnemyTransitionBeat = self.EnemyToEnemyHandoffPending
		local enemyHandoffSourceId = self.PendingEnemyHandoffSourceId
		local enemyHandoffActionType = self.PendingEnemyHandoffActionType
		self.PlayerToEnemyBeatPending = false
		self.PendingPlayerToEnemyHandoffDelay = -1
		self.EnemyToEnemyHandoffPending = false
		self.PendingEnemyHandoffSourceId = ""
		self.PendingEnemyHandoffActionType = ""
		local preparedIntent = self:GetPreparedEnemyIntent()
		if preparedIntent.State ~= "PREPARED" then
			log_warning("[BattleEnemyIntent] compatibility cursor missing; selecting frozen plan turn=" .. self.TurnNumber)
			local selection = self:PrepareNextEnemyIntent()
			if selection.Success == false then
				self:CompleteEnemyTurn("WAIT", false, selection.Reason)
				return
			end
			preparedIntent = self:GetPreparedEnemyIntent()
		end

		local enemyEntity = self:FindUnitEntity(preparedIntent.EnemyId)
		local enemyPlan = nil
		if isvalid(enemyEntity) then
			enemyPlan = enemyEntity:GetComponent("script.EnemyActionPlanComponent")
		end
		self:AdvanceEnemySkillCooldowns(preparedIntent.EnemyId, "ENEMY_ACTION_BEGIN")
		local isQueueingAttack = enemyPlan ~= nil and enemyPlan.PlanState == "INSERTING"
		local enemyCommand = "ENEMY_" .. preparedIntent.ActionType
		if isQueueingAttack then
			enemyCommand = "ENEMY_QUEUE_TILE"
		end
		self.TurnState:BeginEnemyTurn(enemyCommand, preparedIntent.Direction, isQueueingAttack and "ATTACK_TILE_QUEUEING" or "PREPARED_INTENT")
		self:PublishTurnStateSnapshot("ENEMY_TURN_BEGIN")
		log("[BattleEnemyIntent] hold enemy=" .. preparedIntent.EnemyId .. " pattern=" .. preparedIntent.PatternId .. " step=" .. preparedIntent.StepIndex .. " action=" .. preparedIntent.ActionType .. " tile=" .. preparedIntent.TileId .. " telegraphRemaining=" .. preparedIntent.TelegraphTurnsRemaining .. " turn=" .. preparedIntent.PreparedTurn)
		log("[BattleTurnFlow] phase=EnemyTurn turn=" .. self.TurnNumber)

		local execute = function()
			if isQueueingAttack then
				self:AdvancePreparedEnemyQueue()
				return
			end
			self:ExecutePreparedEnemyIntent()
		end
		local traitIds = ""
		if isvalid(enemyEntity) then
			local enemyUnit = enemyEntity:GetComponent("script.BattleUnitComponent")
			if enemyUnit ~= nil then
				traitIds = enemyUnit.EnemyTraitIds
			end
		end
		-- The intent has already been selected and frozen. This value is presentation cadence only;
		-- no AI result is applied until the callback actually executes the prepared intent.
		local executeDelay = _EnemyTraitRouterLogic:GetEnemyThinkDuration(traitIds, self.EnemyThinkDuration)
		if usePlayerTransitionBeat == true then
			if playerHandoffDelay < 0 then
				playerHandoffDelay = self.PlayerToEnemyBeatDuration
			end
			executeDelay = math.max(0.016, math.min(0.12, playerHandoffDelay))
			log("[BattlePlayerHandoff] enemy action queued delay=" .. tostring(executeDelay) .. " enemy=" .. preparedIntent.EnemyId)
		elseif useEnemyTransitionBeat == true then
			executeDelay = self.EnemyToEnemyBeatDuration
			if _EnemyTraitRouterLogic:HasTrait(traitIds, "QUICK") then
				executeDelay = self.QuickEnemyToEnemyBeatDuration
			end
			executeDelay = math.max(0.02, math.min(0.05, executeDelay))
			log("[BattleEnemyHandoff] from=" .. enemyHandoffSourceId .. " action=" .. enemyHandoffActionType .. " to=" .. preparedIntent.EnemyId .. " delay=" .. tostring(executeDelay))
		end
		self.ActionTimerId = _TimerService:SetTimerOnce(execute, executeDelay)
	end

	@ExecSpace("ServerOnly")
	method void CompletePlayerCombatPresentationHandoff(string reason)
		local playerEntity = self.PlayerEntity
		if playerEntity == nil or isvalid(playerEntity) == false then
			playerEntity = self:FindUnitEntity("player_01")
		end
		if playerEntity == nil or isvalid(playerEntity) == false then
			return
		end
		local presentation = playerEntity:GetComponent("script.BattleUnitPresentationComponent")
		if presentation ~= nil then
			presentation:CompleteCombatMotionHandoff("player_01", reason)
		end
	end

	@ExecSpace("ServerOnly")
	method void CancelPlayerCombatPresentationHandoff(string reason, boolean restoreToStand)
		self:ClearMotionCompletionWaits()
		local playerEntity = self.PlayerEntity
		if playerEntity == nil or isvalid(playerEntity) == false then
			playerEntity = self:FindUnitEntity("player_01")
		end
		if playerEntity == nil or isvalid(playerEntity) == false then
			return
		end
		local presentation = playerEntity:GetComponent("script.BattleUnitPresentationComponent")
		if presentation ~= nil then
			presentation:CancelCombatMotionHandoff("player_01", reason, restoreToStand)
		end
	end

	@ExecSpace("ServerOnly")
	method void AdvancePreparedEnemyQueue()
		-- Consumes this foe's turn by adding its attack Tile; readiness is evaluated on the following player turn.
		self.ActionTimerId = 0
		local intent = self:GetPreparedEnemyIntent()
		if intent.State ~= "PREPARED" then
			self:CompleteEnemyTurn("QUEUE_TILE", false, "INTENT_NOT_PREPARED")
			return
		end
		local enemyEntity = self:FindUnitEntity(intent.EnemyId)
		local enemyPlan = nil
		local enemyUnit = nil
		if isvalid(enemyEntity) then
			enemyPlan = enemyEntity:GetComponent("script.EnemyActionPlanComponent")
			enemyUnit = enemyEntity:GetComponent("script.BattleUnitComponent")
		end
		if enemyPlan == nil then
			self:CompleteEnemyTurn("QUEUE_TILE", false, "ENEMY_PLAN_COMPONENT_MISSING")
			return
		end
		local queueResult = enemyPlan:AdvanceQueueTurn()
		if enemyUnit ~= nil then
			self.LastEnemySpawnOrder = enemyUnit.SpawnOrder
		end
		if self.EnemyIntentRuntime ~= nil then
			self.EnemyIntentRuntime:ResetIntent("ATTACK_TILE_QUEUE_TURN_COMPLETED")
		end
		self:PublishEnemyIntentSnapshot("ATTACK_TILE_QUEUE_TURN_COMPLETED")
		self:PublishEnemyPlanSnapshot("ATTACK_TILE_QUEUE_TURN_COMPLETED")
		log("[BattleEnemyQueue] advanced enemy=" .. intent.EnemyId .. " tile=" .. intent.TileId .. " success=" .. tostring(queueResult.Success) .. " ready=" .. tostring(queueResult.Ready) .. " queue=" .. tostring(queueResult.QueueTurnsElapsed or 0) .. "/" .. tostring(queueResult.QueueTurnsRequired or 0))
		local nextResult = self:PrepareNextEnemyIntent()
		if nextResult.Success == true then
			self:BeginEnemyTurn()
			return
		end
		self:CompleteEnemyTurn("QUEUE_TILE", queueResult.Success == true, queueResult.Reason)
	end

	@ExecSpace("ServerOnly")
	method table BuildEnemyIntent(string enemyUnitId)
		-- Loads validated PatternStep rows, then adapts authoritative unit state into the stateless resolver contract.
		local playerEntity = self:FindUnitEntity("player_01")
		local enemyEntity = self:FindUnitEntity(enemyUnitId)
		if isvalid(playerEntity) == false or isvalid(enemyEntity) == false then
			return { ActionType = "WAIT", TileId = "", Direction = 0, Reason = "UNIT_MISSING", PatternId = "", StepIndex = 1 }
		end

		local player = playerEntity:GetComponent("script.BattleUnitComponent")
		local enemy = enemyEntity:GetComponent("script.BattleUnitComponent")
		if player == nil or enemy == nil or player.IsDead == true or enemy.IsDead == true then
			return { ActionType = "WAIT", TileId = "", Direction = 0, Reason = "UNIT_UNAVAILABLE", PatternId = "", StepIndex = 1 }
		end
		local patternRunner = enemyEntity:GetComponent("script.EnemyPatternRunnerComponent")
		if patternRunner == nil then
			log_error("[BattleEnemyIntent] pattern runner missing enemy=" .. enemyUnitId)
			return { ActionType = "WAIT", TileId = "", Direction = 0, Reason = "PATTERN_RUNNER_MISSING", PatternId = enemy.EnemyPatternId, StepIndex = 1, PatternStepCount = 0 }
		end
		if patternRunner.PatternId ~= enemy.EnemyPatternId then
			-- Reset/rebuild can replace an enemy definition while reusing its stable UnitId.
			-- The BattleUnit definition is authoritative; a step index from the previous pattern cannot be carried over safely.
			local previousPatternId = patternRunner.PatternId
			local alignment = patternRunner:InitializePattern(enemy.EnemyPatternId, 1)
			if alignment.Success == false then
				log_error("[BattleEnemyIntent] pattern runner resync failed enemy=" .. enemyUnitId .. " unitPattern=" .. enemy.EnemyPatternId .. " runnerPattern=" .. previousPatternId .. " reason=" .. alignment.Reason)
				return { ActionType = "WAIT", TileId = "", Direction = 0, Reason = "PATTERN_RUNNER_RESYNC_FAILED_" .. alignment.Reason, PatternId = enemy.EnemyPatternId, StepIndex = 1, PatternStepCount = 0 }
			end
			log_warning("[BattleEnemyIntent] pattern runner resynced enemy=" .. enemyUnitId .. " previous=" .. previousPatternId .. " current=" .. enemy.EnemyPatternId)
		end

		local patternValidation = _EnemyPatternContentValidatorLogic:ValidateById(enemy.EnemyPatternId)
		if patternValidation.Success == false then
			local detailReason = patternValidation.DetailReason or patternValidation.Reason
			log_error("[BattleEnemyIntent] pattern rejected enemy=" .. enemyUnitId .. " pattern=" .. enemy.EnemyPatternId .. " reason=" .. detailReason)
			return { ActionType = "WAIT", TileId = "", Direction = 0, Reason = "PATTERN_INVALID_" .. detailReason, PatternId = enemy.EnemyPatternId, StepIndex = 1 }
		end

		local summoner = enemyEntity:GetComponent("script.FaustSummonComponent")
		local summonReady = summoner ~= nil and summoner:CanSummon(self, self:GetOppositeEdgeCell(enemy.CellIndex))
		return _EnemyIntentResolverLogic:ResolvePatternIntent({
			SummonReady = summonReady,
			EnemyUnitId = enemyUnitId,
			PatternId = enemy.EnemyPatternId,
			StartStepIndex = patternRunner.CurrentStepIndex,
			TelegraphTurnsRemaining = patternRunner.TelegraphTurnsRemaining,
			EnemyCellIndex = enemy.CellIndex,
			EnemyFacing = enemy.Facing,
			EnemyCurrentHp = enemy.CurrentHp,
			EnemyMaxHp = enemy.MaxHp,
			EnemyIsBoss = enemy.IsBoss,
			EnemyIsAirborne = enemy.IsAirborne,
			PlayerCellIndex = player.CellIndex,
			CellFreeBySelector = self:BuildEnemyCellFreeSnapshot(enemyUnitId, enemy.CellIndex, enemy.Facing, player.CellIndex)
		}, patternValidation.Data.Steps)
	end

	@ExecSpace("ServerOnly")
	method table BuildEnemyCellFreeSnapshot(string enemyUnitId, integer enemyCellIndex, string enemyFacing, integer playerCellIndex)
		-- Converts live BoardState occupancy into immutable selector booleans for the stateless Resolver.
		local directions = _EnemyIntentResolverLogic:ResolveRelativeDirections(enemyCellIndex, enemyFacing, playerCellIndex)
		return {
			FRONT = self:IsPatternCellFree(enemyCellIndex + directions.FacingDirection, enemyUnitId),
			BACK = self:IsPatternCellFree(enemyCellIndex - directions.FacingDirection, enemyUnitId),
			TOWARD_PLAYER = self:IsPatternCellFree(enemyCellIndex + directions.PlayerDirection, enemyUnitId),
			AWAY_FROM_PLAYER = self:IsPatternCellFree(enemyCellIndex - directions.PlayerDirection, enemyUnitId)
		}
	end

	@ExecSpace("ServerOnly")
	method boolean IsPatternCellFree(integer cellIndex, string ignoredUnitId)
		-- Out-of-range cells are never valid destinations even when no unit occupies them.
		if self:IsValidCell(cellIndex) == false or self.BoardState == nil then
			return false
		end
		return isvalid(self.BoardState:FindAtCell(cellIndex, ignoredUnitId)) == false
	end

	@ExecSpace("ServerOnly")
	method table PrepareEnemyIntent()
		-- Freezes every living enemy plan while the board still represents the same player decision point.
		self.LastEnemySpawnOrder = 0
		self:ResetEnemyIntentCursor("PLAN_ALL_ENEMIES")
		if self.BoardState == nil then
			return { Success = false, Reason = "REGISTRY_MISSING" }
		end
		local livingEnemies = self.BoardState:CollectLivingEnemies()
		local preparedCount = 0
		for _, enemyEntity in ipairs(livingEnemies) do
			local enemyUnit = enemyEntity:GetComponent("script.BattleUnitComponent")
			local actionPlan = enemyEntity:GetComponent("script.EnemyActionPlanComponent")
			if enemyUnit ~= nil and actionPlan ~= nil then
				if actionPlan.PlanState == "COMPLETED" then
					actionPlan:ResetPlan("NEXT_ENEMY_DECISION")
				end
				local planResult = { Success = true, Reason = "EXISTING_PLAN_PRESERVED" }
				if actionPlan.PlanState == "EMPTY" then
					planResult = self:PrepareEnemyIntentForUnit(enemyUnit.UnitId)
				elseif actionPlan.PlanState == "TRACKING" then
					-- Freeze every queued enemy's readiness before the player commits a Command.
					planResult = self:RefreshQueuedAttackReadiness(enemyUnit.UnitId)
				end
				if planResult.Success == true then
					preparedCount = preparedCount + 1
				else
					log_error("[EnemyRoundPlan] enemy plan failed enemy=" .. enemyUnit.UnitId .. " reason=" .. planResult.Reason)
				end
			end
		end
		self:PublishEnemyPlanSnapshot("ALL_PLANS_FROZEN")
		local selection = self:PrepareNextEnemyIntent()
		log("[EnemyRoundPlan] frozen turn=" .. self.TurnNumber .. " living=" .. #livingEnemies .. " prepared=" .. preparedCount .. " selected=" .. self.PreparedEnemyId .. " revision=" .. self.EnemyPlanRevision)
		return { Success = preparedCount > 0, Reason = preparedCount > 0 and "ALL_PLANS_FROZEN" or "NO_ENEMY_PLAN_PREPARED", PreparedCount = preparedCount, SelectionReason = selection.Reason }
	end

	@ExecSpace("ServerOnly")
	method table PrepareNextEnemyIntent()
		-- Moves the compatibility cursor to the next already-frozen per-enemy plan; it never rebuilds AI here.
		local result = {
			Success = false,
			Reason = "UNKNOWN"
		}

		if self.BattleResult ~= "" then
			result.Reason = "BATTLE_ENDED"
			return result
		end
		local currentIntent = self:GetPreparedEnemyIntent()
		if currentIntent.State ~= "EMPTY" then
			result.Reason = "INTENT_ALREADY_PREPARED"
			return result
		end

		if self.BoardState == nil then
			result.Reason = "REGISTRY_MISSING"
			return result
		end
		local livingEnemies = self.BoardState:CollectLivingEnemies()
		local selectedUnitId = ""
		for _, enemyEntity in ipairs(livingEnemies) do
			local enemyUnit = enemyEntity:GetComponent("script.BattleUnitComponent")
			local actionPlan = enemyEntity:GetComponent("script.EnemyActionPlanComponent")
			if enemyUnit ~= nil and actionPlan ~= nil
				and (actionPlan.PlanState == "INSERTING" or actionPlan.PlanState == "TRACKING" or actionPlan.PlanState == "ATTACK_READY" or actionPlan.PlanState == "PREPARED")
				and actionPlan.DeferredUntilTurn <= self.TurnNumber
				and enemyUnit.SpawnOrder > self.LastEnemySpawnOrder then
				selectedUnitId = enemyUnit.UnitId
				break
			end
		end
		if selectedUnitId == "" then
			result.Reason = "NO_NEXT_LIVING_ENEMY"
			return result
		end

		return self:LoadEnemyPlanActionToCompatibility(selectedUnitId)
	end

	@ExecSpace("ServerOnly")
	method table PrepareEnemyIntentForUnit(string enemyUnitId)
		-- Resolves one base pattern step, decorates it through traits, and stores it on the enemy object.
		local result = {
			Success = false,
			Reason = "UNKNOWN"
		}
		if self.BattleResult ~= "" then
			result.Reason = "BATTLE_ENDED"
			return result
		end
		local spawningEnemy = self:FindUnitEntity(enemyUnitId)
		if isvalid(spawningEnemy) then
			local spawnPlan = spawningEnemy:GetComponent("script.EnemyActionPlanComponent")
			local spawnUnit = spawningEnemy:GetComponent("script.BattleUnitComponent")
			if spawnPlan ~= nil and spawnUnit ~= nil and spawnUnit.IsDead == false and spawnPlan.SpawnWaitPending == true then
				-- Do not select a skill, apply QUICK/other traits, or advance the pattern during the first enemy turn.
				return spawnPlan:ReplacePlan(enemyUnitId, {
					{ ActionType = "WAIT", TileId = "", Direction = 0, Reason = "SPAWN_WAIT" }
				}, self.TurnNumber, spawnUnit.EnemyTraitIds, "SPAWN_WAIT", 0)
			end
		end
		local intent = self:BuildEnemyIntent(enemyUnitId)
		if intent.PatternId == nil or intent.PatternId == "" then
			-- Preserve the actual planning failure (for example UNIT_UNAVAILABLE after a zero-HP reset)
			-- instead of passing an empty id to the runner and reporting a misleading mismatch.
			return { Success = false, Reason = intent.Reason or "ENEMY_INTENT_UNAVAILABLE" }
		end
		local preparedMovementPolicy = ""
		local preparedEnemyEntity = self:FindUnitEntity(enemyUnitId)
		if isvalid(preparedEnemyEntity) == false then
			return { Success = false, Reason = "ENEMY_MISSING_AFTER_PREPARE" }
		else
			local preparedEnemyUnit = preparedEnemyEntity:GetComponent("script.BattleUnitComponent")
			local actionPlan = preparedEnemyEntity:GetComponent("script.EnemyActionPlanComponent")
			if preparedEnemyUnit ~= nil then
				preparedMovementPolicy = preparedEnemyUnit.EnemyMovementPolicy
			end
			if preparedEnemyUnit == nil or actionPlan == nil then
				return { Success = false, Reason = "ENEMY_PLAN_COMPONENT_MISSING" }
			end
			if actionPlan.PlanState ~= "EMPTY" then
				actionPlan:ResetPlan("REPLAN")
			end
			local patternRunner = preparedEnemyEntity:GetComponent("script.EnemyPatternRunnerComponent")
			if patternRunner == nil then
				return { Success = false, Reason = "PATTERN_RUNNER_MISSING" }
			end
			local traitPlan = _EnemyTraitRouterLogic:BuildActionPlan(preparedEnemyUnit.EnemyTraitIds, intent, preparedEnemyUnit.IsBoss)
			if traitPlan.Success == false then
				return traitPlan
			end
			local markResult = patternRunner:TryMarkPrepared(intent.PatternId, intent.StepIndex, intent.PatternStepCount or 0, intent.ActionType, intent.TelegraphTurnsRemaining or 0)
			if markResult.Success == false and markResult.Reason == "PATTERN_ID_MISMATCH" then
				-- Recover once at the mutation boundary in case reset/rebuild swapped runtime state after intent resolution.
				local previousPatternId = patternRunner.PatternId
				local recovery = patternRunner:InitializePattern(intent.PatternId, intent.StepIndex)
				if recovery.Success == true then
					markResult = patternRunner:TryMarkPrepared(intent.PatternId, intent.StepIndex, intent.PatternStepCount or 0, intent.ActionType, intent.TelegraphTurnsRemaining or 0)
					log_warning("[BattleEnemyIntent] pattern mismatch recovered enemy=" .. enemyUnitId .. " previous=" .. previousPatternId .. " current=" .. intent.PatternId .. " step=" .. intent.StepIndex .. " success=" .. tostring(markResult.Success))
				else
					return { Success = false, Reason = "PATTERN_MISMATCH_RECOVERY_FAILED_" .. recovery.Reason }
				end
			end
			if markResult.Success == false then
				return markResult
			end
			local queueTurnsRequired = 0
			if intent.ActionType == "EXECUTE_TILE" and intent.TileId ~= "" then
				local skillDefinition = _SkillDefinitionRepositoryLogic:GetSkillDefinition(intent.TileId)
				if skillDefinition.Success == true then
					queueTurnsRequired = math.max(0, math.floor(tonumber(skillDefinition.EnemyQueueTurns) or 0))
				end
				if _EnemyTraitRouterLogic:HasTrait(preparedEnemyUnit.EnemyTraitIds, "QUICK") then
					queueTurnsRequired = 0
				end
			end
			result = actionPlan:ReplacePlan(enemyUnitId, traitPlan.Actions, self.TurnNumber, preparedEnemyUnit.EnemyTraitIds, intent.Reason, queueTurnsRequired)
			if result.Success == false then
				patternRunner:CancelPreparedStep(intent.PatternId, intent.StepIndex, result.Reason)
				return result
			end
			if intent.ActionType == "SUMMON_ENEMIES" then
				actionPlan.TargetCellSnapshot = tostring(self:GetOppositeEdgeCell(preparedEnemyUnit.CellIndex))
			end
			local preparedAction = actionPlan:GetCurrentAction()
			if preparedAction.Success == true and preparedAction.ActionType == "CHARGE_FORWARD" then
				-- Freeze the warned cells with the round plan. Charge execution must not reacquire a player
				-- who moved beyond the line that was visible during the preceding PlayerTurn.
				local telegraph = self:BuildChargeTelegraph(preparedEnemyUnit, preparedAction.Direction, preparedAction.TileId)
				if telegraph.Success == true then
					actionPlan.TargetCellSnapshot = telegraph.TargetCells
				end
			end
			if actionPlan.PlanState == "TRACKING" then
				local readiness = self:RefreshQueuedAttackReadiness(enemyUnitId)
				if readiness.Success == false then
					patternRunner:CancelPreparedStep(intent.PatternId, intent.StepIndex, readiness.Reason)
					actionPlan:ResetPlan(readiness.Reason)
					return readiness
				end
			end
		end
		log("[BattleEnemyIntent] plan enemy=" .. enemyUnitId .. " pattern=" .. intent.PatternId .. " step=" .. intent.StepIndex .. " action=" .. intent.ActionType .. " tile=" .. intent.TileId .. " telegraphRemaining=" .. (intent.TelegraphTurnsRemaining or 0) .. " direction=" .. intent.Direction .. " turn=" .. self.TurnNumber .. " policy=" .. preparedMovementPolicy .. " reason=" .. intent.Reason)
		return result
	end

	@ExecSpace("ServerOnly")
	method void ResetEnemyIntentCursor(string reason)
		-- Clears only the map-scoped selection cursor. Enemy-owned queued Tiles survive into later turns.
		local intentRuntime = self.EnemyIntentRuntime
		if intentRuntime == nil then
			intentRuntime = self:EnsureEnemyIntentComponent()
		end
		if intentRuntime ~= nil then
			intentRuntime:ResetIntent(reason)
		end
		self:PublishEnemyIntentSnapshot(reason)
	end

	@ExecSpace("ServerOnly")
	method table RefreshQueuedAttackReadiness(string enemyUnitId)
		-- Converts the queued attack Tile into a turn, move, wait, or committed attack without changing Pattern Step.
		local enemyEntity = self:FindUnitEntity(enemyUnitId)
		local playerEntity = self:FindUnitEntity("player_01")
		if isvalid(enemyEntity) == false or isvalid(playerEntity) == false then
			return { Success = false, Reason = "READINESS_UNIT_MISSING" }
		end
		local enemyUnit = enemyEntity:GetComponent("script.BattleUnitComponent")
		local playerUnit = playerEntity:GetComponent("script.BattleUnitComponent")
		local actionPlan = enemyEntity:GetComponent("script.EnemyActionPlanComponent")
		if enemyUnit == nil or playerUnit == nil or actionPlan == nil then
			return { Success = false, Reason = "READINESS_COMPONENT_MISSING" }
		end
		if actionPlan.PlanState ~= "TRACKING" then
			return { Success = false, Reason = "PLAN_NOT_TRACKING" }
		end
		local action = actionPlan:GetCurrentAction()
		if action.Success == false or action.ActionType ~= "EXECUTE_TILE" or action.TileId == "" then
			return { Success = false, Reason = "QUEUED_ATTACK_ACTION_MISSING" }
		end
		local definitionResult = _SkillDefinitionRepositoryLogic:GetSkillDefinition(action.TileId)
		if definitionResult.Success == false then
			return definitionResult
		end
		local runtimeState = self:GetSkillRuntimeState(enemyUnitId)
		if runtimeState ~= nil then
			local cooldownResult = runtimeState:CanUseSkill(action.TileId)
			if cooldownResult.Success == false then
				local trackingResult = actionPlan:SetTrackingState("SKILL_COOLDOWN", "WAIT", 0, "")
				if trackingResult.Success == false then
					return trackingResult
				end
				return {
					Success = true,
					Reason = "SKILL_COOLDOWN",
					Readiness = "COOLDOWN",
					NextCommandType = "WAIT",
					Direction = 0,
					TargetCellSnapshot = "",
					RemainingTurns = cooldownResult.RemainingTurns,
					PatternId = action.PatternId,
					StepIndex = action.StepIndex,
					PatternStepCount = action.PatternStepCount,
					TileId = action.TileId,
					PreparedTurn = action.PreparedTurn,
					TelegraphTurnsRemaining = action.TelegraphTurnsRemaining
				}
			end
		end
		local relative = _EnemyIntentResolverLogic:ResolveRelativeDirections(enemyUnit.CellIndex, enemyUnit.Facing, playerUnit.CellIndex)
		local readiness = _EnemyIntentResolverLogic:ResolveQueuedAttackReadiness({
			EnemyCellIndex = enemyUnit.CellIndex,
			EnemyFacing = enemyUnit.Facing,
			PlayerCellIndex = playerUnit.CellIndex,
			TowardPlayerCellFree = self:IsPatternCellFree(enemyUnit.CellIndex + relative.PlayerDirection, enemyUnitId)
		}, definitionResult)
		if readiness.Success == false then
			return readiness
		end
		if readiness.Readiness == "READY" then
			local readyResult = actionPlan:MarkAttackReady(readiness.Reason, readiness.TargetCellSnapshot)
			if readyResult.Success == false then
				return readyResult
			end
		else
			local trackingResult = actionPlan:SetTrackingState(readiness.Reason, readiness.NextCommandType, readiness.Direction, readiness.TargetCellSnapshot)
			if trackingResult.Success == false then
				return trackingResult
			end
		end
		readiness.PatternId = action.PatternId
		readiness.StepIndex = action.StepIndex
		readiness.PatternStepCount = action.PatternStepCount
		readiness.TileId = action.TileId
		readiness.PreparedTurn = action.PreparedTurn
		readiness.TelegraphTurnsRemaining = action.TelegraphTurnsRemaining
		return readiness
	end

	@ExecSpace("ServerOnly")
	method table LoadEnemyPlanActionToCompatibility(string enemyUnitId)
		local enemyEntity = self:FindUnitEntity(enemyUnitId)
		if isvalid(enemyEntity) == false then
			return { Success = false, Reason = "ENEMY_MISSING" }
		end
		local actionPlan = enemyEntity:GetComponent("script.EnemyActionPlanComponent")
		if actionPlan == nil then
			return { Success = false, Reason = "ENEMY_PLAN_COMPONENT_MISSING" }
		end
		local action = actionPlan:GetCurrentAction()
		if action.Success == false then
			return action
		end
		local compatibilityActionType = action.ActionType
		local compatibilityDirection = action.Direction
		local compatibilityReason = action.ActionReason
		if actionPlan.PlanState == "TRACKING" then
			compatibilityActionType = actionPlan.NextCommandType ~= "" and actionPlan.NextCommandType or "WAIT"
			compatibilityDirection = actionPlan.NextCommandDirection
			compatibilityReason = actionPlan.ReadinessReason ~= "" and actionPlan.ReadinessReason or "TRACKING"
		end
		local intentRuntime = self:EnsureEnemyIntentComponent()
		if intentRuntime == nil then
			return { Success = false, Reason = "INTENT_STATE_MISSING" }
		end
		if intentRuntime.IntentState ~= "EMPTY" then
			intentRuntime:ResetIntent("COMPATIBILITY_CURSOR_ADVANCE")
		end
		local result = intentRuntime:TryPrepare(enemyUnitId, action.PatternId, action.StepIndex, compatibilityActionType, action.TileId, action.TelegraphTurnsRemaining, compatibilityDirection, action.PreparedTurn, compatibilityReason)
		self:PublishEnemyIntentSnapshot("PLAN_CURSOR_SELECTED")
		self:PublishEnemyPlanSnapshot("PLAN_CURSOR_SELECTED")
		return result
	end

	@ExecSpace("ServerOnly")
	method table GetPreparedEnemyIntent()
		-- Returns a copy so callers cannot mutate the synchronized snapshot fields.
		local intentRuntime = self.EnemyIntentRuntime
		if intentRuntime == nil then
			intentRuntime = self:EnsureEnemyIntentComponent()
		end
		if intentRuntime == nil then
			return { State = "EMPTY", EnemyId = "", PatternId = "", StepIndex = 0, ActionType = "", TileId = "", TelegraphTurnsRemaining = 0, Direction = 0, PreparedTurn = 0, Reason = "INTENT_STATE_MISSING", Revision = 0 }
		end
		return intentRuntime:GetSnapshot()
	end

	@ExecSpace("ServerOnly")
	method void ExecutePreparedEnemyIntent()
		-- Reuses the authoritative action paths without rebuilding the prepared PatternStep.
		self.ActionTimerId = 0
		local intent = self:GetPreparedEnemyIntent()
		if intent.State ~= "PREPARED" then
			log_error("[BattleEnemyIntent] execute rejected state=" .. intent.State)
			self:CompleteEnemyTurn("WAIT", false, "INTENT_NOT_PREPARED")
			return
		end

		local beginResult = self.EnemyIntentRuntime:TryBeginExecution()
		if beginResult.Success == false then
			log_error("[BattleEnemyIntent] execute transition rejected reason=" .. beginResult.Reason)
			self:CompleteEnemyTurn("WAIT", false, beginResult.Reason)
			return
		end
		local executingEnemy = self:FindUnitEntity(intent.EnemyId)
		local executingPlan = nil
		if isvalid(executingEnemy) then
			executingPlan = executingEnemy:GetComponent("script.EnemyActionPlanComponent")
		end
		if executingPlan == nil then
			log_error("[BattleEnemyIntent] execute rejected reason=ENEMY_PLAN_COMPONENT_MISSING enemy=" .. intent.EnemyId)
			self:CompleteEnemyTurn("WAIT", false, "ENEMY_PLAN_COMPONENT_MISSING")
			return
		end
		local isTrackingCommand = executingPlan.PlanState == "TRACKING"
			and (intent.ActionType == "TURN_TO_PLAYER" or intent.ActionType == "MOVE_TOWARD" or intent.ActionType == "WAIT")
		if isTrackingCommand == false then
			local planBegin = executingPlan:TryBeginCurrentAction()
			if planBegin.Success == false then
				log_error("[BattleEnemyIntent] plan execute rejected reason=" .. planBegin.Reason .. " enemy=" .. intent.EnemyId)
				self:CompleteEnemyTurn("WAIT", false, planBegin.Reason)
				return
			end
		end
		self:PublishEnemyIntentSnapshot("EXECUTING")
		self:PublishEnemyPlanSnapshot("ACTION_EXECUTING")
		local actionDirection = intent.Direction
		if actionDirection == 0 and (intent.ActionType == "MOVE_TOWARD" or intent.ActionType == "MOVE_AWAY") then
			actionDirection = self:ResolveEnemyRelativeMoveDirection(intent.EnemyId, intent.ActionType)
		end
		self.TurnState:UpdateEnemyAction("ENEMY_" .. intent.ActionType, actionDirection)
		self:PublishTurnStateSnapshot("ENEMY_ACTION")
		log("[BattleEnemyIntent] execute enemy=" .. intent.EnemyId .. " pattern=" .. intent.PatternId .. " step=" .. intent.StepIndex .. " action=" .. intent.ActionType .. " tile=" .. intent.TileId .. " telegraphRemaining=" .. intent.TelegraphTurnsRemaining .. " preparedTurn=" .. intent.PreparedTurn .. " currentTurn=" .. self.TurnNumber)

		local actionResult = nil
		if intent.ActionType == "MOVE_TOWARD" then
			actionResult = self:TryMoveInternal(intent.EnemyId, actionDirection, true)
		elseif intent.ActionType == "MOVE_AWAY" then
			actionResult = self:TryMoveAwayInternal(intent.EnemyId, actionDirection, true)
		elseif intent.ActionType == "MOVE_FIXED_FACING" then
			actionResult = self:TryMoveInternal(intent.EnemyId, intent.Direction, true)
		elseif intent.ActionType == "TURN_TO_PLAYER" then
			actionResult = self:TryFaceDirection(intent.EnemyId, intent.Direction)
		elseif intent.ActionType == "TELEGRAPH_TILE" then
			actionResult = { Success = true, Reason = "TELEGRAPH_COMPLETED" }
		elseif intent.ActionType == "CHARGE_FORWARD" then
			actionResult = self:TryChargeForward(intent.EnemyId, intent.Direction, intent.TileId, executingPlan.TargetCellSnapshot)
		elseif intent.ActionType == "CAST_INTERRUPTIBLE" then
			actionResult = self:BeginEnemyInterruptibleCast(intent.EnemyId, intent.PatternId, intent.StepIndex, intent.TileId)
		elseif intent.ActionType == "SUMMON_ENEMIES" then
			local summoner = executingEnemy:GetComponent("script.FaustSummonComponent")
			actionResult = { Success = false, Reason = "SUMMON_COMPONENT_MISSING_WAIT" }
			if summoner ~= nil then
				actionResult = summoner:TrySummon(self, tonumber(executingPlan.TargetCellSnapshot) or -1)
			end
		elseif intent.ActionType == "BOSS_JUMP_TELEGRAPH" then
			actionResult = self:BeginBossOppositeJump(intent.EnemyId)
		elseif intent.ActionType == "BOSS_LAND_OPPOSITE" then
			actionResult = self:ResolveBossOppositeLanding(intent.EnemyId, intent.TileId)
		elseif intent.ActionType == "EXECUTE_TILE" and intent.TileId ~= "" then
			-- Resolves the pattern's TileId through the enemy-only skill table and shared skill pipeline.
			local castResult = self:ConsumeEnemyInterruptibleCast(intent.EnemyId, intent.TileId)
			if castResult.CanExecute == false then
				actionResult = { Success = false, Reason = "CAST_INTERRUPTED" }
			else
				actionResult = self:TryExecuteSkill(intent.EnemyId, intent.TileId)
			end
		else
			 actionResult = { Success = true, Reason = intent.Reason }
		end
		if intent.ActionType == "SUMMON_ENEMIES" and actionResult.Success == false then
			self.TurnState:UpdateEnemyAction("ENEMY_WAIT", 0)
			self:PublishTurnStateSnapshot("SUMMON_BLOCKED_WAIT")
		end
		if intent.ActionType == "MOVE_TOWARD" or intent.ActionType == "MOVE_AWAY" or intent.ActionType == "MOVE_FIXED_FACING" then
			actionResult = self:ConvertBlockedEnemyMoveToWait(intent.EnemyId, intent.ActionType, actionDirection, actionResult)
		end

		local success = actionResult ~= nil and actionResult.Success == true
		local reason = "EXECUTION_FAILED"
		if actionResult ~= nil then
			reason = actionResult.Reason
		end

		local duration = self:GetEnemyActionDuration(intent.ActionType, intent.TileId)
		if intent.ActionType == "EXECUTE_TILE" and actionResult ~= nil then
			-- The actual impact delay already includes the final projectile; playback completion supplies the visual boundary.
			duration = actionResult.PresentationHandoffDuration or 0.01
		end
		local completed = false
		local complete = function()
			if completed then
				return
			end
			completed = true
			self.ActionTimerId = 0
			if isTrackingCommand then
				self:CompleteQueuedAttackTrackingCommand(intent.EnemyId, intent.ActionType, success, reason)
				return
			end
			self:CompletePreparedEnemyIntent(intent.EnemyId, intent.PatternId, intent.StepIndex, intent.ActionType, intent.TileId, intent.TelegraphTurnsRemaining, success, reason)
		end
		local movement = self._T.enemyGridMove
		if actionResult ~= nil and actionResult.PresentationStarted == true
			and movement ~= nil and movement.UnitId == intent.EnemyId then
			movement.CompleteAction = complete
			movement.TimerId = _TimerService:SetTimerOnce(function()
				if self._T.enemyGridMove == movement then
					self:FinishEnemyGridMovePresentation("FALLBACK_COMPLETE", true)
				end
			end, movement.Duration + math.max(0.02, self.MoveCompletionFallbackGrace))
			self.ActionTimerId = movement.TimerId
			return
		end
		self.ActionTimerId = _TimerService:SetTimerOnce(function()
			self.ActionTimerId = 0
			self:WaitForMotionCompletion(complete)
		end, duration)
	end

	@ExecSpace("ServerOnly")
	method void CompleteQueuedAttackTrackingCommand(string enemyId, string actionType, boolean success, string reason)
		-- A tracking command consumes one enemy action but never completes the queued attack's Pattern Step.
		log("[BattleEnemyQueue] tracking complete enemy=" .. enemyId .. " action=" .. actionType .. " success=" .. tostring(success) .. " reason=" .. reason)
		local enemyEntity = self:FindUnitEntity(enemyId)
		if isvalid(enemyEntity) then
			local enemyUnit = enemyEntity:GetComponent("script.BattleUnitComponent")
			if enemyUnit ~= nil then
				self.LastEnemySpawnOrder = enemyUnit.SpawnOrder
			end
		end
		if self.EnemyIntentRuntime ~= nil then
			self.EnemyIntentRuntime:ResetIntent("QUEUED_ATTACK_TRACKING_COMPLETED")
		end
		self:PublishEnemyIntentSnapshot("QUEUED_ATTACK_TRACKING_COMPLETED")
		self:PublishEnemyPlanSnapshot("QUEUED_ATTACK_TRACKING_COMPLETED")
		if self.BattleResult == "" then
			local nextResult = self:PrepareNextEnemyIntent()
			if nextResult.Success == true then
				self:BeginEnemyTurnFromEnemyAction(enemyId, actionType)
				return
			end
		end
		self:CompleteEnemyTurn(actionType, success, reason)
	end

	@ExecSpace("ServerOnly")
	method table ConvertBlockedEnemyMoveToWait(string enemyId, string actionType, integer direction, table actionResult)
		-- Normalizes spatial movement blocks into one consumed WAIT without hiding configuration or phase errors.
		if actionResult == nil or actionResult.Success == true then
			return actionResult
		end
		if actionResult.Reason ~= "OUT_OF_BOUNDS" and actionResult.Reason ~= "CELL_OCCUPIED" then
			return actionResult
		end
		local blockedReason = actionResult.Reason
		local result = {
			Success = true,
			Reason = "WAIT_" .. blockedReason,
			WasBlocked = true,
			BlockedReason = blockedReason,
			OriginalActionType = actionType,
			FromCell = actionResult.FromCell,
			ToCell = actionResult.ToCell
		}
		self.TurnState:UpdateEnemyAction("ENEMY_WAIT", 0)
		self:PublishTurnStateSnapshot("ENEMY_WAIT")
		log("[BattleEnemyIntent] move blocked; wait enemy=" .. enemyId .. " action=" .. actionType .. " direction=" .. direction .. " reason=" .. blockedReason .. " from=" .. tostring(result.FromCell) .. " to=" .. tostring(result.ToCell))
		return result
	end

	@ExecSpace("ServerOnly")
	method number GetEnemyActionDuration(string actionType, string tileId)
		-- Returns the presentation lock duration for each prepared enemy action meaning.
		if actionType == "MOVE_TOWARD" or actionType == "MOVE_AWAY" or actionType == "MOVE_FIXED_FACING" then
			return math.max(0.05, self.EnemyMoveActionDuration)
		elseif actionType == "TURN_TO_PLAYER" then
			return math.max(0.05, self.TurnActionDuration)
		elseif actionType == "EXECUTE_TILE" or actionType == "CHARGE_FORWARD" then
			return self:GetEnemySkillPresentationReadyDuration(tileId)
		elseif actionType == "SUMMON_ENEMIES" then
			return 0.6
		elseif actionType == "BOSS_LAND_OPPOSITE" then
			return self:GetEnemySkillPresentationReadyDuration(tileId)
		elseif actionType == "TELEGRAPH_TILE" or actionType == "CAST_INTERRUPTIBLE" or actionType == "BOSS_JUMP_TELEGRAPH" then
			return 0.05
		end
		return 0.05
	end

	@ExecSpace("ServerOnly")
	method number GetEnemySkillPresentationReadyDuration(string skillId)
		-- Enemy-to-enemy sequencing follows the meaningful caster motion instead of the longer
		-- generic action lock. Projectile skills retain the full flight-safe duration.
		local validation = _ContentValidatorLogic:ValidateSkillById(skillId)
		if validation.Success == false then
			return math.max(0.1, self:GetSkillActionDuration(skillId))
		end
		local definition = validation.Data.Definition
		if self:HasSkillProjectile(definition) then
			return math.max(0.1, self:GetSkillActionDuration(skillId))
		end
		local speed = self:GetSkillSpeedMultiplier()
		local authoredMotionDuration = definition.CasterMotionDuration or 0
		if authoredMotionDuration <= 0 then
			authoredMotionDuration = definition.ActionDuration or 0.1
		end
		local motionDuration = authoredMotionDuration / speed
		local motionProfile = self:GetSkillMotionProfile(definition.MotionProfileId)
		local impactReadyDuration = motionProfile.ImpactDelay or 0
		return math.max(0.1, motionDuration, impactReadyDuration)
	end

	@ExecSpace("ServerOnly")
	method table BeginEnemyInterruptibleCast(string enemyId, string patternId, integer stepIndex, string skillId)
		-- Reads the interruption threshold from the pattern row so boss difficulty remains data-driven.
		local enemyEntity = self:FindUnitEntity(enemyId)
		if isvalid(enemyEntity) == false then
			return { Success = false, Reason = "ENEMY_NOT_FOUND" }
		end
		local plan = enemyEntity:GetComponent("script.EnemyActionPlanComponent")
		if plan == nil then
			return { Success = false, Reason = "ENEMY_PLAN_COMPONENT_MISSING" }
		end
		local stepResult = _EnemyPatternStepRepositoryLogic:GetPatternStep(patternId, stepIndex)
		if stepResult.Success == false then
			return { Success = false, Reason = "CAST_PATTERN_STEP_NOT_FOUND" }
		end
		if stepResult.Step == nil then
			return { Success = false, Reason = "CAST_PATTERN_STEP_NOT_FOUND" }
		end
		local requiredHits = math.max(1, math.floor(tonumber(stepResult.Step.ParamA) or 1))
		local result = plan:BeginInterruptibleCast(skillId, requiredHits)
		if result.Success == true then
			self:PublishEnemyPlanSnapshot("CAST_STARTED")
		end
		return result
	end

	@ExecSpace("ServerOnly")
	method table ConsumeEnemyInterruptibleCast(string enemyId, string skillId)
		local enemyEntity = self:FindUnitEntity(enemyId)
		if isvalid(enemyEntity) == false then
			return { Success = false, Reason = "ENEMY_NOT_FOUND", CanExecute = false }
		end
		local plan = enemyEntity:GetComponent("script.EnemyActionPlanComponent")
		if plan == nil then
			return { Success = false, Reason = "ENEMY_PLAN_COMPONENT_MISSING", CanExecute = false }
		end
		local result = plan:ConsumeInterruptibleCast(skillId)
		if result.Reason ~= "CAST_NOT_REQUIRED" then
			self:PublishEnemyPlanSnapshot(result.Reason)
		end
		return result
	end

	@ExecSpace("ServerOnly")
	method integer GetOppositeEdgeCell(integer cellIndex)
		if cellIndex <= (self.CellCount - 1) * 0.5 then
			return self.CellCount - 1
		end
		return 0
	end

	@ExecSpace("ServerOnly")
	method table BeginBossOppositeJump(string enemyId)
		-- Freezes the opposite edge at takeoff so later player movement cannot retarget the landing.
		local enemyEntity = self:FindUnitEntity(enemyId)
		if isvalid(enemyEntity) == false then
			return { Success = false, Reason = "ENEMY_NOT_FOUND" }
		end
		local enemy = enemyEntity:GetComponent("script.BattleUnitComponent")
		if enemy == nil or enemy.IsBoss ~= true or enemy.IsDead == true then
			return { Success = false, Reason = "BOSS_UNAVAILABLE" }
		end
		local landingCell = self:GetOppositeEdgeCell(enemy.CellIndex)
		local result = enemy:SetAirborneState(true, landingCell)
		if result.Success == true then
			log("[BossJump] takeoff enemy=" .. enemyId .. " from=" .. enemy.CellIndex .. " landing=" .. landingCell)
		end
		return result
	end

	@ExecSpace("ServerOnly")
	method table ResolveBossOppositeLanding(string enemyId, string landingSkillId)
		-- Landing owns overlap resolution: push toward center first, then try the opposite side.
		local result = { Success = false, Reason = "UNKNOWN", EnemyId = enemyId, LandingCell = -1, PlayerPushed = false, PlayerFromCell = -1, PlayerToCell = -1 }
		local enemyEntity = self:FindUnitEntity(enemyId)
		local playerEntity = self:FindUnitEntity("player_01")
		if isvalid(enemyEntity) == false or isvalid(playerEntity) == false then
			result.Reason = "LANDING_UNIT_MISSING"
			return result
		end
		local enemy = enemyEntity:GetComponent("script.BattleUnitComponent")
		local player = playerEntity:GetComponent("script.BattleUnitComponent")
		if enemy == nil or player == nil or enemy.IsBoss ~= true or enemy.IsAirborne ~= true then
			result.Reason = "BOSS_NOT_AIRBORNE"
			return result
		end
		local landingCell = enemy.PendingLandingCell
		result.LandingCell = landingCell
		if self:IsValidCell(landingCell) == false then
			result.Reason = "INVALID_LANDING_CELL"
			return result
		end

		if player.IsDead == false and player.CellIndex == landingCell then
			local centerDirection = landingCell <= (self.CellCount - 1) * 0.5 and 1 or -1
			local pushResult = self:RelocateUnitForMechanic("player_01", player.CellIndex + centerDirection, "BOSS_LANDING_CENTER_PUSH")
			if pushResult.Success == false then
				pushResult = self:RelocateUnitForMechanic("player_01", player.CellIndex - centerDirection, "BOSS_LANDING_REVERSE_PUSH")
			end
			if pushResult.Success == false then
				result.Reason = "LANDING_OVERLAP_UNRESOLVED_" .. pushResult.Reason
				return result
			end
			result.PlayerPushed = true
			result.PlayerFromCell = pushResult.FromCell
			result.PlayerToCell = pushResult.ToCell
		end

		if self:IsCellOccupied(landingCell, enemyId) then
			result.Reason = "LANDING_CELL_OCCUPIED"
			return result
		end
		local fromCell = enemy.CellIndex
		local cellResult = enemy:ApplyCellChange(landingCell)
		if cellResult.Success == false then
			result.Reason = cellResult.Reason
			return result
		end
		self:PlaceEntity(enemyEntity, self:GetCellPosition(landingCell))
		enemy:SetAirborneState(false, -1)
		local facing = player.CellIndex >= landingCell and "Right" or "Left"
		enemy:ApplyFacingState(facing)
		self:ApplyFacing(enemyEntity, enemy.Facing)
		local impactResult = nil
		if landingSkillId ~= nil and landingSkillId ~= "" then
			impactResult = self:TryExecuteSkill(enemyId, landingSkillId)
			result.ImpactSuccess = impactResult.Success
			result.ImpactReason = impactResult.Reason
		end
		result.Success = true
		result.Reason = "BOSS_LANDED"
		log("[BossJump] landed enemy=" .. enemyId .. " from=" .. fromCell .. " to=" .. landingCell .. " playerPush=" .. tostring(result.PlayerPushed) .. " player=" .. result.PlayerFromCell .. "->" .. result.PlayerToCell .. " impact=" .. tostring(result.ImpactSuccess) .. ":" .. tostring(result.ImpactReason))
		return result
	end

	@ExecSpace("ServerOnly")
	method void CompletePreparedEnemyIntent(string enemyId, string patternId, integer stepIndex, string actionType, string tileId, integer telegraphTurnsRemaining, boolean success, string reason)
		-- Advances within the enemy-owned queue; pattern progression occurs once after the full plan.
		log("[BattleEnemyIntent] complete enemy=" .. enemyId .. " pattern=" .. patternId .. " step=" .. stepIndex .. " action=" .. actionType .. " tile=" .. tileId .. " telegraphRemaining=" .. telegraphTurnsRemaining .. " success=" .. tostring(success) .. " reason=" .. reason)
		local completedEnemy = self:FindUnitEntity(enemyId)
		local completedPlan = nil
		local planCompletion = { Success = false, Reason = "ENEMY_MISSING", HasNextAction = false, AggregateSuccess = success }
		if isvalid(completedEnemy) then
			local completedUnit = completedEnemy:GetComponent("script.BattleUnitComponent")
			completedPlan = completedEnemy:GetComponent("script.EnemyActionPlanComponent")
			if completedPlan ~= nil then
				planCompletion = completedPlan:CompleteCurrentAction(success, reason)
			end
			if completedUnit ~= nil then
				self.LastEnemySpawnOrder = completedUnit.SpawnOrder
			end
		end
		if self.EnemyIntentRuntime ~= nil then
			self.EnemyIntentRuntime:ResetIntent("ACTION_COMPLETED")
		end
		self:PublishEnemyIntentSnapshot("ACTION_COMPLETED")
		self:PublishEnemyPlanSnapshot("ACTION_COMPLETED")
		if self.BattleResult ~= "" then
			self:ClearPreparedEnemyIntent("BATTLE_ENDED")
			self:CompleteEnemyTurn(actionType, success, reason)
			return
		end
		if planCompletion.Success == true and planCompletion.HasNextAction == true then
			local pendingAction = completedPlan ~= nil and completedPlan:GetCurrentAction() or { Success = false }
			local pendingReason = pendingAction.Success == true and (pendingAction.ActionReason or "") or ""
			if string.sub(pendingReason, 1, 12) == "POST_ATTACK_" then
				local deferResult = completedPlan:DeferCurrentActionUntilTurn(self.TurnNumber + 1, "POST_ATTACK_NEXT_ENEMY_TURN")
				self:PublishEnemyPlanSnapshot("POST_ATTACK_ACTION_DEFERRED")
				if deferResult.Success == false then
					log_error("[BattleEnemyIntent] defer failed enemy=" .. enemyId .. " reason=" .. deferResult.Reason)
				else
					log("[BattleEnemyIntent] deferred enemy=" .. enemyId .. " action=" .. pendingAction.ActionType .. " untilTurn=" .. deferResult.DeferredUntilTurn)
					local nextEnemy = self:PrepareNextEnemyIntent()
					if nextEnemy.Success == true then
						self:BeginEnemyTurnFromEnemyAction(enemyId, actionType)
						return
					end
					self:CompleteEnemyTurn(actionType, success, "POST_ATTACK_ACTION_DEFERRED")
					return
				end
			end
			local nextAction = self:LoadEnemyPlanActionToCompatibility(enemyId)
			if nextAction.Success == true then
				self:BeginEnemyTurnFromEnemyAction(enemyId, actionType)
				return
			end
		end
		if actionType ~= "WAIT" or reason ~= "SPAWN_WAIT" then
			local progression = self:CompleteEnemyPatternStep(enemyId, patternId, stepIndex, planCompletion.AggregateSuccess == true)
			if progression.Success == false then
				log_error("[BattleEnemyIntent] pattern progression failed enemy=" .. enemyId .. " pattern=" .. patternId .. " step=" .. stepIndex .. " reason=" .. progression.Reason)
			end
		end
		if self.BattleResult == "" then
			local nextResult = self:PrepareNextEnemyIntent()
			if nextResult.Success == true then
				log("[BattleEnemyIntent] advance next=" .. self.PreparedEnemyId .. " afterSpawnOrder=" .. self.LastEnemySpawnOrder)
				self:BeginEnemyTurnFromEnemyAction(enemyId, actionType)
				return
			end
		end
		self:CompleteEnemyTurn(actionType, success, reason)
	end

	@ExecSpace("ServerOnly")
	method table CompleteEnemyPatternStep(string enemyId, string patternId, integer stepIndex, boolean success)
		-- Resolves immutable row links, then asks the per-enemy runner to own the mutable transition.
		local enemyEntity = self:FindUnitEntity(enemyId)
		if isvalid(enemyEntity) == false then
			return { Success = false, Reason = "ENEMY_MISSING" }
		end
		local patternRunner = enemyEntity:GetComponent("script.EnemyPatternRunnerComponent")
		if patternRunner == nil then
			return { Success = false, Reason = "PATTERN_RUNNER_MISSING" }
		end
		if patternRunner.PatternId ~= patternId then
			-- A boss may cross a phase threshold after this round's plan was frozen. The frozen
			-- action still resolves, but its old Step must not advance the replacement Pattern.
			log("[BattleEnemyIntent] pattern progression skipped enemy=" .. enemyId .. " oldPattern=" .. patternId .. " currentPattern=" .. patternRunner.PatternId .. " reason=PATTERN_SUPERSEDED")
			return { Success = true, Reason = "PATTERN_SUPERSEDED", PreviousPatternId = patternId, CurrentPatternId = patternRunner.PatternId }
		end
		local stepResult = _EnemyPatternStepRepositoryLogic:GetPatternStep(patternId, stepIndex)
		if stepResult.Success == false then
			return stepResult
		end
		return patternRunner:CompletePreparedStep(
			patternId,
			stepIndex,
			success,
			stepResult.Step.NextStepOnSuccess,
			stepResult.Step.ActionType == "SUMMON_ENEMIES" and 1 or stepResult.Step.NextStepOnFailure,
			stepResult.StepCount,
			stepResult.Step.ActionType
		)
	end

	@ExecSpace("ServerOnly")
	method void ClearPreparedEnemyIntent(string reason)
		-- Cancels every per-enemy frozen plan at a real round/battle boundary.
		self:FinishEnemyGridMovePresentation("INTENT_CLEAR_" .. reason, false)
		local intentRuntime = self.EnemyIntentRuntime
		if intentRuntime == nil then
			intentRuntime = self:EnsureEnemyIntentComponent()
		end
		if self.BoardState ~= nil then
			local livingEnemies = self.BoardState:CollectLivingEnemies()
			for _, enemyEntity in ipairs(livingEnemies) do
				local actionPlan = enemyEntity:GetComponent("script.EnemyActionPlanComponent")
				local patternRunner = enemyEntity:GetComponent("script.EnemyPatternRunnerComponent")
				if actionPlan ~= nil and actionPlan.PlanState ~= "EMPTY" then
					local current = actionPlan:GetCurrentAction()
					if patternRunner ~= nil and current.Success == true then
						patternRunner:CancelPreparedStep(current.PatternId, current.StepIndex, reason)
					end
					actionPlan:ResetPlan(reason)
				end
			end
		end
		if intentRuntime ~= nil then
			intentRuntime:ResetIntent(reason)
		end
		self:PublishEnemyIntentSnapshot(reason)
		self:PublishEnemyPlanSnapshot(reason)
	end

	@ExecSpace("ServerOnly")
	method table ProcessAugmentTrigger(string triggerType, string sourceTag, integer depth)
		-- Publishes one normalized battle trigger to the shared job-passive and augment runtime.
		local result = { Success = false, Reason = "PLAYER_MISSING", TriggerType = triggerType or "", ExecutedCount = 0 }
		if isvalid(self.PlayerEntity) == false then
			return result
		end
		local playerUnit = self.PlayerEntity:GetComponent("script.BattleUnitComponent")
		if playerUnit == nil or playerUnit.IsDead == true then
			result.Reason = "PLAYER_UNIT_UNAVAILABLE"
			return result
		end
		local context = {
			BattleSession = self,
			SourceEntity = self.PlayerEntity,
			SourceUnit = playerUnit,
			TurnNumber = self.TurnNumber,
			SourceTag = sourceTag or "",
			Depth = math.max(0, depth)
		}
		result = _AugmentRuntimeLogic:ProcessTrigger(self.PlayerEntity, triggerType, context)
		self.LastAugmentTriggerType = triggerType or ""
		self.LastAugmentTriggerReason = result.Reason or "UNKNOWN"
		self.LastAugmentExecutedCount = result.ExecutedCount or 0
		self.AugmentRuntimeRevision = self.AugmentRuntimeRevision + 1
		log("[BattleAugment] trigger=" .. self.LastAugmentTriggerType .. " success=" .. tostring(result.Success) .. " reason=" .. self.LastAugmentTriggerReason .. " executed=" .. self.LastAugmentExecutedCount .. " revision=" .. self.AugmentRuntimeRevision)
		return result
	end

	@ExecSpace("ServerOnly")
	method void CompleteEnemyTurn(string actionType, boolean success, string reason)
		-- The ordered enemy round is complete. Keep the enemy phase locked for a short visual beat,
		-- then reopen the player turn without changing the authoritative completion result.
		self.ActionTimerId = 0
		if self.BattleResult ~= "" then
			self.TurnState:ClearTransientState("BATTLE_ENDED")
			self:PublishTurnStateSnapshot("BATTLE_ENDED")
			log("[BattleEnemy] completed action=" .. actionType .. " success=" .. tostring(success) .. " reason=" .. reason .. " result=" .. self.BattleResult)
			return
		end

		if self.TurnTransitionTimerId > 0 then
			log_warning("[BattleTurnTempo] duplicate enemy-to-player transition blocked action=" .. actionType .. " reason=" .. reason)
			return
		end

		local beatDuration = math.max(0.02, math.min(0.06, self.EnemyToPlayerBeatDuration))
		local finishTransition = function()
			self:FinishEnemyToPlayerTransition(actionType, success, reason)
		end
		self.TurnTransitionTimerId = _TimerService:SetTimerOnce(finishTransition, beatDuration)
		log("[BattleTurnTempo] enemy round completed action=" .. actionType .. " reason=" .. reason .. " playerReadyBeat=" .. tostring(beatDuration))
	end

	@ExecSpace("ServerOnly")
	method void FinishEnemyToPlayerTransition(string actionType, boolean success, string reason)
		-- Called only after CompleteEnemyTurn confirmed the enemy round was finished.
		-- This timer controls presentation tempo, never whether the round succeeded.
		self.TurnTransitionTimerId = 0
		if self.BattleResult ~= "" then
			self.TurnState:ClearTransientState("BATTLE_ENDED")
			self:PublishTurnStateSnapshot("BATTLE_ENDED")
			log("[BattleEnemy] transition ended action=" .. actionType .. " success=" .. tostring(success) .. " reason=" .. reason .. " result=" .. self.BattleResult)
			return
		end

		self.TurnState:CompleteEnemyTurn("ENEMY_ROUND_COMPLETED")
		self:PublishTurnStateSnapshot("PLAYER_TURN_REOPENED")
		self.StageTurnNumber = self.TurnNumber
		self:AdvancePlayerSkillCooldowns("PLAYER_TURN_" .. self.TurnNumber)
		self:ProcessAugmentTrigger("TURN_START", "TURN:" .. tostring(self.TurnNumber), 0)
		self.LastEnemySpawnOrder = 0
		self:EvaluateForcedSpawnAtTurnBoundary()
		log("[BattleEnemy] completed action=" .. actionType .. " success=" .. tostring(success) .. " reason=" .. reason)
		log("[BattleTurnFlow] phase=PlayerTurn turn=" .. self.TurnNumber .. " stageTurn=" .. self.StageTurnNumber .. " wave=" .. self.CurrentWave)
		self:PrepareEnemyIntent()
	end

	@ExecSpace("ServerOnly")
	method void ClearTurnTransitionTimer(string reason)
		if self.TurnTransitionTimerId > 0 then
			_TimerService:ClearTimer(self.TurnTransitionTimerId)
			self.TurnTransitionTimerId = 0
			log("[BattleTurnTempo] transition timer cleared reason=" .. reason)
		end
		self.PlayerToEnemyBeatPending = false
		self.PendingPlayerToEnemyHandoffDelay = -1
	end

	@ExecSpace("ServerOnly")
	method void ClearEnemyToEnemyPresentationHandoff(string reason)
		if self.EnemyToEnemyHandoffPending then
			log("[BattleEnemyHandoff] pending handoff cleared reason=" .. reason)
		end
		self.EnemyToEnemyHandoffPending = false
		self.PendingEnemyHandoffSourceId = ""
		self.PendingEnemyHandoffActionType = ""
	end

	@ExecSpace("ServerOnly")
	method boolean IsTeamTurn(string team)
		if team == "Player" then
			return self.BattlePhase == "PlayerTurn"
		elseif team == "Enemy" then
			return self.BattlePhase == "EnemyTurn"
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method table TryTurn(string unitId)
		-- Reverses a living unit's logical and visual facing without moving cells.
		local result = {
			Success = false,
			Reason = "UNKNOWN",
			PreviousFacing = "",
			CurrentFacing = ""
		}

		local unitEntity = self:FindUnitEntity(unitId)
		if isvalid(unitEntity) == false then
			result.Reason = "UNIT_NOT_FOUND"
			return result
		end

		local unit = unitEntity:GetComponent("script.BattleUnitComponent")
		if unit == nil then
			result.Reason = "UNIT_COMPONENT_MISSING"
			return result
		end

		if self:IsTeamTurn(unit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end

		if unit.IsDead == true then
			result.Reason = "UNIT_DEAD"
			return result
		end

		result.PreviousFacing = unit.Facing
		local nextFacing = "Right"
		if unit.Facing == "Right" then
			nextFacing = "Left"
		end
		local facingResult = unit:ApplyFacingState(nextFacing)
		if facingResult.Success == false then
			result.Reason = facingResult.Reason
			return result
		end
		result.CurrentFacing = facingResult.CurrentFacing
		self:ApplyFacing(unitEntity, unit.Facing)

		local turnedEvent = UnitTurnedEvent()
		turnedEvent.UnitId = unit.UnitId
		turnedEvent.PreviousFacing = result.PreviousFacing
		turnedEvent.CurrentFacing = result.CurrentFacing
		self.Entity:SendEvent(turnedEvent)

		result.Success = true
		result.Reason = "OK"
		log("[BattleTurn] success unit=" .. unit.UnitId .. " from=" .. result.PreviousFacing .. " to=" .. result.CurrentFacing .. " cell=" .. unit.CellIndex)
		return result
	end

	@ExecSpace("ServerOnly")
	method table TryFaceDirection(string unitId, integer direction)
		-- Sets one living unit to an explicit prepared direction without deriving it again from the current target position.
		local result = {
			Success = false,
			Reason = "UNKNOWN",
			PreviousFacing = "",
			CurrentFacing = ""
		}

		if direction ~= -1 and direction ~= 1 then
			result.Reason = "INVALID_DIRECTION"
			return result
		end

		local unitEntity = self:FindUnitEntity(unitId)
		if isvalid(unitEntity) == false then
			result.Reason = "UNIT_NOT_FOUND"
			return result
		end

		local unit = unitEntity:GetComponent("script.BattleUnitComponent")
		if unit == nil then
			result.Reason = "UNIT_COMPONENT_MISSING"
			return result
		end
		if self:IsTeamTurn(unit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end
		if unit.IsDead == true then
			result.Reason = "UNIT_DEAD"
			return result
		end

		result.PreviousFacing = unit.Facing
		result.CurrentFacing = "Right"
		if direction < 0 then
			result.CurrentFacing = "Left"
		end

		if result.PreviousFacing == result.CurrentFacing then
			result.Success = true
			result.Reason = "ALREADY_FACING"
			log("[BattleTurn] kept unit=" .. unit.UnitId .. " facing=" .. result.CurrentFacing .. " cell=" .. unit.CellIndex)
			return result
		end

		local facingResult = unit:ApplyFacingState(result.CurrentFacing)
		if facingResult.Success == false then
			result.Reason = facingResult.Reason
			return result
		end
		self:ApplyFacing(unitEntity, unit.Facing)

		local turnedEvent = UnitTurnedEvent()
		turnedEvent.UnitId = unit.UnitId
		turnedEvent.PreviousFacing = result.PreviousFacing
		turnedEvent.CurrentFacing = result.CurrentFacing
		self.Entity:SendEvent(turnedEvent)

		result.Success = true
		result.Reason = "OK"
		log("[BattleTurn] success unit=" .. unit.UnitId .. " from=" .. result.PreviousFacing .. " to=" .. result.CurrentFacing .. " cell=" .. unit.CellIndex .. " source=PREPARED_DIRECTION")
		return result
	end

	method integer GetFacingDirection(string facing)
		-- Converts the logical facing string into a stable one-cell direction.
		if facing == "Right" then
			return 1
		end
		return -1
	end

	@ExecSpace("ServerOnly")
	method void ApplyFacing(Entity targetEntity, string facing)
		-- Uses the native player look direction so the three-layer avatar renderer turns correctly.
		if targetEntity.PlayerControllerComponent == nil then
			return
		end

		if facing == "Right" then
			targetEntity.PlayerControllerComponent.LookDirectionX = 1
		else
			targetEntity.PlayerControllerComponent.LookDirectionX = -1
		end
	end

	@ExecSpace("Server")
	method void RequestQueueTile(string tileId)
		-- Validates the requesting player before registering one supported tile in the queue slot.
		if self:IsValidPlayerRequest(senderUserId) == false then
			log_warning("[BattleTileQueue] register rejected tile=" .. tileId .. " reason=INVALID_SENDER")
			return
		end

		local result = self:TryQueueTile(tileId)
		self:PublishPlayerCommandResult("QUEUE_TILE", result)
		if result.Success == false then
			log_warning("[BattleTileQueue] register rejected tile=" .. tileId .. " reason=" .. result.Reason)
		end
	end

	@ExecSpace("Server")
	method void RequestReorderBattleSkillSlot(integer sourceIndex, integer targetIndex, integer requestId, integer expectedRevision)
		-- The client proposes indices only. Skill identities always come from this authoritative session.
		if self:IsValidPlayerRequest(senderUserId) == false then
			log_warning("[BattleSkillSlotReorder] rejected request=" .. tostring(requestId) .. " reason=INVALID_SENDER")
			return
		end
		if requestId <= 0 then
			log_warning("[BattleSkillSlotReorder] rejected request=" .. tostring(requestId) .. " reason=INVALID_REQUEST_ID")
			return
		end
		if requestId <= self.LastProcessedSkillSlotReorderRequestId then
			local replayReason = requestId == self.LastProcessedSkillSlotReorderRequestId and "DUPLICATE_REQUEST" or "STALE_REQUEST"
			log_warning("[BattleSkillSlotReorder] rejected request=" .. tostring(requestId) .. " last=" .. tostring(self.LastProcessedSkillSlotReorderRequestId) .. " reason=" .. replayReason)
			return
		end

		self.LastProcessedSkillSlotReorderRequestId = requestId
		local result = self:TryReorderBattleSkillSlot(sourceIndex, targetIndex, expectedRevision)
		self:PublishSkillSlotReorderReceipt(sourceIndex, targetIndex, result)
	end

	@ExecSpace("ServerOnly")
	method table TryReorderBattleSkillSlot(integer sourceIndex, integer targetIndex, integer expectedRevision)
		local result = {
			Success = false,
			Reason = "UNKNOWN",
			SourceIndex = sourceIndex,
			TargetIndex = targetIndex,
			SlotIds = self.SkillSlotIds,
			PreviousSlotIds = self.SkillSlotIds,
			Revision = self.SkillSlotRevision
		}

		if sourceIndex ~= math.floor(sourceIndex) or targetIndex ~= math.floor(targetIndex) then
			result.Reason = "INVALID_SLOT_INDEX_TYPE"
			return result
		end
		if sourceIndex < 1 or sourceIndex > self.SkillSlotCount or targetIndex < 1 or targetIndex > self.SkillSlotCount then
			result.Reason = "SLOT_INDEX_OUT_OF_RANGE"
			return result
		end
		if sourceIndex == targetIndex then
			result.Reason = "SAME_SLOT"
			return result
		end
		if expectedRevision ~= self.SkillSlotRevision then
			result.Reason = "STALE_SLOT_REVISION"
			return result
		end
		if self.ContentValidationState ~= "VALID" then
			result.Reason = "CONTENT_NOT_READY"
			return result
		end
		if self.BattleResult ~= "" then
			result.Reason = "BATTLE_ALREADY_ENDED"
			return result
		end
		if self.TurnState == nil or self.TurnState.BattlePhase ~= "PlayerTurn" then
			result.Reason = "NOT_PLAYER_DECISION_STATE"
			return result
		end
		if self.TurnState.IsActionProcessing == true then
			result.Reason = "ACTION_PROCESSING"
			return result
		end

		local slotIds = self:ParseSkillSlotPipe(self.SkillSlotIds)
		local sourceSkillId = slotIds[sourceIndex] or ""
		local targetSkillId = slotIds[targetIndex] or ""
		if sourceSkillId == "" then
			result.Reason = "SOURCE_SLOT_EMPTY"
			return result
		end
		local sourceValidation = _ContentValidatorLogic:ValidateSkillById(sourceSkillId)
		if sourceValidation.Success == false then
			result.Reason = "SOURCE_SKILL_INVALID"
			result.DetailReason = sourceValidation.Reason
			return result
		end
		local sourceOwnership = _RunManagerLogic:CanUseRunSkill(self.PlayerEntity, sourceSkillId)
		if sourceOwnership.Success == false then
			result.Reason = "SOURCE_SKILL_NOT_OWNED"
			return result
		end
		if targetSkillId ~= "" then
			local targetValidation = _ContentValidatorLogic:ValidateSkillById(targetSkillId)
			if targetValidation.Success == false then
				result.Reason = "TARGET_SKILL_INVALID"
				result.DetailReason = targetValidation.Reason
				return result
			end
			local targetOwnership = _RunManagerLogic:CanUseRunSkill(self.PlayerEntity, targetSkillId)
			if targetOwnership.Success == false then
				result.Reason = "TARGET_SKILL_NOT_OWNED"
				return result
			end
		end

		local seenSkillIds = {}
		for slotIndex = 1, self.SkillSlotCount do
			local skillId = slotIds[slotIndex] or ""
			if skillId ~= "" then
				if seenSkillIds[skillId] == true then
					result.Reason = "DUPLICATE_SKILL_SLOT"
					return result
				end
				seenSkillIds[skillId] = true
			end
		end

		-- Names and authored cooldowns are parallel presentation data for the same fixed six positions.
		-- QueuedTileIds and ExecutingTileIds deliberately remain untouched because they already store SkillIds.
		local slotNames = self:ParseSkillSlotPipe(self.SkillSlotNames)
		local slotCooldownTurns = self:ParseSkillSlotPipe(self.SkillSlotCooldownTurns)
		local operation = "SWAP"
		if targetSkillId == "" then
			operation = "MOVE"
			slotIds[targetIndex] = slotIds[sourceIndex]
			slotIds[sourceIndex] = ""
			slotNames[targetIndex] = slotNames[sourceIndex]
			slotNames[sourceIndex] = ""
			slotCooldownTurns[targetIndex] = slotCooldownTurns[sourceIndex]
			slotCooldownTurns[sourceIndex] = ""
		else
			slotIds[sourceIndex], slotIds[targetIndex] = slotIds[targetIndex], slotIds[sourceIndex]
			slotNames[sourceIndex], slotNames[targetIndex] = slotNames[targetIndex], slotNames[sourceIndex]
			slotCooldownTurns[sourceIndex], slotCooldownTurns[targetIndex] = slotCooldownTurns[targetIndex], slotCooldownTurns[sourceIndex]
		end

		local nextSlotIds = self:SerializeSkillSlotPipe(slotIds)
		local nextSlotNames = self:SerializeSkillSlotPipe(slotNames)
		local nextSlotCooldownTurns = self:SerializeSkillSlotPipe(slotCooldownTurns)
		local runInventory = self.PlayerEntity:GetComponent("script.PlayerRunInventoryComponent")
		if runInventory == nil then
			result.Reason = "RUN_SKILL_BAR_OWNER_UNAVAILABLE"
			return result
		end
		local runOrderResult = runInventory:CommitRunSkillBarOrder(self.SkillSlotIds, nextSlotIds, "BATTLE_REORDER")
		if runOrderResult.Success ~= true then
			result.Reason = runOrderResult.Reason or "RUN_SKILL_BAR_COMMIT_FAILED"
			return result
		end

		self.SkillSlotIds = nextSlotIds
		self.SkillSlotNames = nextSlotNames
		self.SkillSlotCooldownTurns = nextSlotCooldownTurns
		self.SkillSlotSourceSnapshot = runInventory.RunSkillSnapshot
		self.SkillSlotSourceRunOrderRevision = runOrderResult.Revision or self.SkillSlotSourceRunOrderRevision
		self.SkillSlotRevision = self.SkillSlotRevision + 1
		result.Success = true
		result.Reason = "OK"
		result.SourceSkillId = sourceSkillId
		result.TargetSkillId = targetSkillId
		result.Operation = operation
		result.SlotIds = self.SkillSlotIds
		result.Revision = self.SkillSlotRevision
		result.RunSkillBarRevision = self.SkillSlotSourceRunOrderRevision
		log("[BattleSkillSlotReorder] success request=" .. tostring(self.LastProcessedSkillSlotReorderRequestId) .. " operation=" .. operation .. " source=" .. tostring(sourceIndex) .. " target=" .. tostring(targetIndex) .. " before=" .. result.PreviousSlotIds .. " after=" .. result.SlotIds .. " runOrderRevision=" .. tostring(self.SkillSlotSourceRunOrderRevision) .. " queued=" .. self.QueuedTileIds .. " executing=" .. self.ExecutingTileIds)
		return result
	end

	@ExecSpace("ServerOnly")
	method table ParseSkillSlotPipe(string snapshot)
		local values = {}
		local serialized = snapshot or ""
		local startIndex = 1
		for slotIndex = 1, self.SkillSlotCount do
			local separatorIndex, _ = string.find(serialized, "|", startIndex, true)
			if separatorIndex == nil then
				values[slotIndex] = string.sub(serialized, startIndex)
				startIndex = string.len(serialized) + 1
			else
				values[slotIndex] = string.sub(serialized, startIndex, separatorIndex - 1)
				startIndex = separatorIndex + 1
			end
		end
		return values
	end

	@ExecSpace("ServerOnly")
	method string SerializeSkillSlotPipe(table values)
		local fixedValues = {}
		for slotIndex = 1, self.SkillSlotCount do
			fixedValues[slotIndex] = values[slotIndex] or ""
		end
		return table.concat(fixedValues, "|")
	end

	@ExecSpace("ServerOnly")
	method void PublishSkillSlotReorderReceipt(integer sourceIndex, integer targetIndex, table result)
		self.SkillSlotLastRequestId = self.LastProcessedSkillSlotReorderRequestId
		self.SkillSlotLastRequestSuccess = result ~= nil and result.Success == true
		self.SkillSlotLastRequestReason = result ~= nil and result.Reason or "UNKNOWN"
		self.SkillSlotLastSourceIndex = sourceIndex
		self.SkillSlotLastTargetIndex = targetIndex
		self.SkillSlotReorderReceiptRevision = self.SkillSlotReorderReceiptRevision + 1
		local operation = result ~= nil and result.Operation or "NONE"
		log("[BattleSkillSlotReorder] receipt request=" .. tostring(self.SkillSlotLastRequestId) .. " success=" .. tostring(self.SkillSlotLastRequestSuccess) .. " reason=" .. self.SkillSlotLastRequestReason .. " operation=" .. tostring(operation) .. " revision=" .. tostring(self.SkillSlotRevision) .. " slots=" .. self.SkillSlotIds)
	end

	@ExecSpace("Server")
	method void RequestExecuteQueuedTile()
		-- Validates the requesting player before executing the registered tile.
		if self:IsValidPlayerRequest(senderUserId) == false then
			log_warning("[BattleTileQueue] execute rejected reason=INVALID_SENDER")
			return
		end

		local result = self:TryExecuteQueuedTile()
		self:PublishPlayerCommandResult("EXECUTE_QUEUE", result)
		if result.Success == false then
			log_warning("[BattleTileQueue] execute rejected reason=" .. result.Reason)
		end
	end

	@ExecSpace("Server")
	method void RequestClearQueuedTile()
		-- Validates the requesting player before clearing the registered tile.
		if self:IsValidPlayerRequest(senderUserId) == false then
			log_warning("[BattleTileQueue] clear rejected reason=INVALID_SENDER")
			return
		end

		local result = self:TryClearQueuedTile()
		self:PublishPlayerCommandResult("CLEAR_QUEUE", result)
		if result.Success == false then
			log_warning("[BattleTileQueue] clear rejected reason=" .. result.Reason)
		end
	end

	@ExecSpace("Server")
	method void RequestRemoveQueuedTile(integer queueIndex)
		-- Validates the requesting player before removing one queued tile for free.
		if self:IsValidPlayerRequest(senderUserId) == false then
			log_warning("[BattleTileQueue] remove rejected index=" .. queueIndex .. " reason=INVALID_SENDER")
			return
		end

		local result = self:TryRemoveQueuedTileAt(queueIndex)
		self:PublishPlayerCommandResult("REMOVE_QUEUE_ITEM", result)
		if result.Success == false then
			log_warning("[BattleTileQueue] remove rejected index=" .. queueIndex .. " reason=" .. result.Reason)
		end
	end

	@ExecSpace("Server")
	method void RequestMoveQueuedTile(integer fromIndex, integer toIndex, integer requestId, integer expectedQueueOrderRevision)
		-- Future queue drag sends indices and concurrency metadata only. Skill identities remain
		-- server-owned inside TurnState. No current UI calls this method in STEP 8.
		if self:IsValidPlayerRequest(senderUserId) == false then
			log_warning("[BattleQueueReorder] rejected request=" .. tostring(requestId) .. " reason=INVALID_SENDER")
			return
		end
		if requestId <= 0 then
			log_warning("[BattleQueueReorder] rejected request=" .. tostring(requestId) .. " reason=INVALID_REQUEST_ID")
			return
		end
		if requestId <= self.LastProcessedQueueReorderRequestId then
			local replayReason = requestId == self.LastProcessedQueueReorderRequestId and "DUPLICATE_REQUEST" or "STALE_REQUEST"
			log_warning("[BattleQueueReorder] rejected request=" .. tostring(requestId) .. " last=" .. tostring(self.LastProcessedQueueReorderRequestId) .. " reason=" .. replayReason)
			return
		end

		self.LastProcessedQueueReorderRequestId = requestId
		local result = self:TryReorderQueuedTile(fromIndex, toIndex, expectedQueueOrderRevision)
		self:PublishPlayerCommandResult("REORDER_QUEUE", result)
		self:PublishQueueReorderReceipt(fromIndex, toIndex, result)
	end

	@ExecSpace("ServerOnly")
	method boolean IsValidPlayerRequest(string requestingUserId)
		-- Confirms that a client request belongs to the registered solo player.
		if isvalid(self.PlayerEntity) == false or self.PlayerEntity.PlayerComponent == nil then
			return false
		end

		return self.PlayerEntity.PlayerComponent.UserId == requestingUserId
	end

	@ExecSpace("ServerOnly")
	method void PublishPlayerCommandResult(string commandType, table result)
		-- Records one authoritative command result so UI can explain accepted and rejected input.
		local success = result ~= nil and result.Success == true
		local reason = "UNKNOWN"
		if result ~= nil and result.Reason ~= nil then
			reason = result.Reason
		end
		self.TurnState:RecordCommandResult(commandType, success, reason)
		self:PublishTurnStateSnapshot("PLAYER_COMMAND_RESULT")
	end

	@ExecSpace("ServerOnly")
	method table ApplyQueueCapacityModifier(string modifierId, string sourceType, string sourceId, integer addValue)
		-- Stable server entry point for Job, Skill, Augment, Relic, Item, and Stage Rule systems.
		local result = self.TurnState:UpsertQueueCapacityModifier(modifierId, sourceType, sourceId, addValue)
		if result.Success == true then
			self:PublishTurnStateSnapshot("QUEUE_CAPACITY_MODIFIER_UPSERT")
		end
		return result
	end

	@ExecSpace("ServerOnly")
	method table RemoveQueueCapacityModifier(string modifierId)
		-- Removes one external queue-capacity contribution and republishes the snapshot.
		local result = self.TurnState:RemoveQueueCapacityModifier(modifierId)
		if result.Success == true then
			self:PublishTurnStateSnapshot("QUEUE_CAPACITY_MODIFIER_REMOVED")
		end
		return result
	end

	@ExecSpace("ServerOnly")
	method table GetQueueCapacityState()
		-- Exposes the authoritative queue-capacity state to server integrations.
		return self.TurnState:GetQueueCapacityState()
	end

	@ExecSpace("ServerOnly")
	method table TryQueueTile(string tileId)
		-- Appends one supported tile up to the configurable queue capacity.
		local result = {
			Success = false,
			Reason = "UNKNOWN",
			QueueIndex = -1,
			QueueCount = self.QueuedTileCount,
			ConsumesTurn = true
		}

		local capacity = self.TurnState.TileQueueCapacity

		local skillValidation = _ContentValidatorLogic:ValidateSkillById(tileId)
		if skillValidation.Success == false then
			result.Reason = skillValidation.Reason
			result.DetailReason = skillValidation.DetailReason or ""
			return result
		end
		local ownership = _RunManagerLogic:CanUseRunSkill(self.PlayerEntity, tileId)
		if ownership.Success == false then
			result.Reason = ownership.Reason
			result.OwnedAmount = ownership.OwnedAmount or 0
			log_warning("[BattleTileQueue] ownership rejected tile=" .. tileId .. " reason=" .. result.Reason .. " owned=" .. result.OwnedAmount)
			return result
		end

		local runtimeState = self:GetSkillRuntimeState("player_01")
		if runtimeState == nil then
			result.Reason = "SKILL_RUNTIME_STATE_MISSING"
			return result
		end
		local cooldownResult = runtimeState:CanUseSkill(tileId)
		if cooldownResult.Success == false then
			result.Reason = cooldownResult.Reason
			result.RemainingTurns = cooldownResult.RemainingTurns
			return result
		end
		local definition = skillValidation.Data.Definition
		if definition.CooldownTurns > 0 and self.TurnState:QueueContainsSkill(self.TurnState.QueuedTileIds, tileId) then
			result.Reason = "COOLDOWN_RESERVED"
			result.RemainingTurns = definition.CooldownTurns
			return result
		end

		result = self.TurnState:TryAppendSkill(tileId)
		if result.Success == false then
			return result
		end
		result.ConsumesTurn = definition.FreePlay ~= true
		self:PublishTurnStateSnapshot("SKILL_QUEUED")
		log("[BattleTileQueue] registered tile=" .. tileId .. " index=" .. result.QueueIndex .. " count=" .. result.QueueCount .. "/" .. capacity .. " turn=" .. self.TurnNumber .. " consumesTurn=" .. tostring(result.ConsumesTurn))
		if result.ConsumesTurn == true and self.BattleResult == "" then
			self:BeginEnemyTurnFromPlayerAction("SKILL_QUEUED")
		else
			log("[BattleTurnFlow] freeplay queue retained tile=" .. tileId .. " turn=" .. self.TurnNumber)
		end
		return result
	end

	@ExecSpace("ServerOnly")
	method table TryExecuteQueuedTile()
		-- Freezes the registered queue and starts an arbitrary-length sequential execution pass.
		local result = self.TurnState:TryFreezeSkillQueue()
		if result.Success == false then
			return result
		end
		self.CurrentPlayerActionKillCount = 0
		self:PublishTurnStateSnapshot("SKILL_QUEUE_FROZEN")
		log("[BattleTileQueue] execution started count=" .. self:GetTileIdCount(self.ExecutingTileIds) .. " capacity=" .. self.TileQueueCapacity .. " turn=" .. self.TurnNumber)
		self:ExecuteNextQueuedTile()
		return result
	end

	@ExecSpace("ServerOnly")
	method void ExecuteNextQueuedTile()
		-- Resolves exactly one tile, then advances only after its action duration has completed.
		local tileCount = self.TurnState:GetTileIdCount(self.TurnState.ExecutingTileIds)
		if self.TurnState.ExecutingTileIndex <= 0 or self.TurnState.ExecutingTileIndex > tileCount then
			self:CompleteTileQueueExecution(true, "QUEUE_COMPLETE")
			return
		end

		local tileId = self.TurnState:GetTileIdAt(self.TurnState.ExecutingTileIds, self.TurnState.ExecutingTileIndex)
		local actionType = self:GetTileActionType(tileId)
		if actionType == "" then
			self:CompleteTileQueueExecution(false, "UNKNOWN_SKILL")
			return
		end

		self.TurnState:SetExecutingAction(actionType, 0)
		self:PublishTurnStateSnapshot("SKILL_EXECUTING")
		log("[BattleTileQueue] tile started index=" .. self.ExecutingTileIndex .. "/" .. tileCount .. " tile=" .. tileId .. " action=" .. actionType)

		local actionResult = nil
		if actionType == "EXECUTE_SKILL" then
			actionResult = self:TryExecuteSkill("player_01", tileId)
		end

		if actionResult == nil or actionResult.Success == false then
			local reason = "EXECUTION_FAILED"
			if actionResult ~= nil then
				reason = actionResult.Reason
			end
			self:CompleteTileQueueExecution(false, reason)
			return
		end

		local completedIndex = self.TurnState.ExecutingTileIndex
		local duration = actionResult.PresentationHandoffDuration or self:GetSkillActionDuration(tileId)
		local complete = function()
			self.ActionTimerId = 0
			log("[BattleTileQueue] tile completed index=" .. completedIndex .. "/" .. tileCount .. " tile=" .. tileId .. " reason=" .. actionResult.Reason)
			if self.BattleResult ~= "" then
				self:CompleteTileQueueExecution(true, "BATTLE_ENDED")
				return
			end
			self.TurnState:AdvanceExecutingSkill()
			self:PublishTurnStateSnapshot("SKILL_ADVANCED")
			self:ExecuteNextQueuedTile()
		end
		self.ActionTimerId = _TimerService:SetTimerOnce(function()
			self.ActionTimerId = 0
			self:WaitForMotionCompletion(complete)
		end, duration)
	end

	@ExecSpace("ServerOnly")
	method void CompleteTileQueueExecution(boolean success, string reason)
		-- Clears execution state once, then hands control to the enemy only after the full queue succeeds.
		local executedCount = self.TurnState:GetTileIdCount(self.TurnState.ExecutingTileIds)
		self.ActionTimerId = 0
		self:CompletePlayerCombatPresentationHandoff(reason)
		self.TurnState:CompleteSkillQueue(reason)
		self:PublishTurnStateSnapshot("SKILL_QUEUE_COMPLETED")
		log("[BattleTileQueue] execution completed success=" .. tostring(success) .. " reason=" .. reason .. " count=" .. executedCount)

		if self.BattleResult ~= "" then
			return
		end
		if success then
			self:BeginEnemyTurnFromPlayerAction("SKILL_QUEUE_COMPLETED")
			return
		end
	end

	method string AppendTileId(string serializedQueue, string tileId)
		if serializedQueue == "" then
			return tileId
		end
		return serializedQueue .. "|" .. tileId
	end

	method boolean QueueContainsSkill(string serializedQueue, string skillId)
		for queuedSkillId in string.gmatch(serializedQueue, "([^|]+)") do
			if queuedSkillId == skillId then
				return true
			end
		end
		return false
	end

	method integer GetTileIdCount(string serializedQueue)
		if serializedQueue == "" then
			return 0
		end
		local count = 0
		for _ in string.gmatch(serializedQueue, "([^|]+)") do
			count = count + 1
		end
		return count
	end

	method string GetTileIdAt(string serializedQueue, integer targetIndex)
		if targetIndex <= 0 then
			return ""
		end
		local index = 0
		for tileId in string.gmatch(serializedQueue, "([^|]+)") do
			index = index + 1
			if index == targetIndex then
				return tileId
			end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method string GetTileActionType(string tileId)
		local validation = _ContentValidatorLogic:ValidateSkillById(tileId)
		if validation.Success == true then
			return "EXECUTE_SKILL"
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method number GetSkillActionDuration(string skillId)
		-- Scaled by the same multiplier as the motion, so the queue slot frees when the swing ends
		-- instead of holding the turn for the original 1x duration.
		local validation = _ContentValidatorLogic:ValidateSkillById(skillId)
		if validation.Success == false then
			return 0.1
		end
		local definition = validation.Data.Definition
		local speed = self:GetSkillSpeedMultiplier()
		local authored = definition.ActionDuration / speed
		if self:HasSkillProjectile(definition) == false then
			return math.max(0.1, authored)
		end

		-- A projectile skill resolves only after the shot lands, so the queue slot must outlive the
		-- worst-case flight. Actual flight uses the real target distance; the clamp uses full range
		-- because the target is not known until the shot is scheduled.
		local launchDelay = self:GetProjectileLaunchDelay(definition)
		local worstFlight = (definition.Range * self.CellSpacing) / (definition.ProjectileSpeed * speed)
		-- A volley finishes on its last shot, so the slot has to cover the whole stream, not one arrow.
		local volleySpan = math.max(0, definition.ProjectileInterval or 0) / speed * (math.max(1, definition.ProjectileCount or 1) - 1)
		local minimumDuration = launchDelay + volleySpan + worstFlight
		return math.max(0.1, authored, minimumDuration)
	end

	@ExecSpace("ServerOnly")
	method table TryClearQueuedTile()
		-- Clears every registered tile only while the player still owns an idle input phase.
		local clearedCount = self.TurnState.QueuedTileCount
		local result = self.TurnState:TryClearQueuedSkills()
		if result.Success == false then
			return result
		end
		self:PublishTurnStateSnapshot("SKILL_QUEUE_CLEARED")
		log("[BattleTileQueue] cleared count=" .. clearedCount .. " turn=" .. self.TurnNumber)
		return result
	end

	@ExecSpace("ServerOnly")
	method table TryRemoveQueuedTileAt(integer queueIndex)
		-- Removes one queued tile without advancing the turn or starting the enemy round.
		local result = self.TurnState:TryRemoveQueuedSkillAt(queueIndex)
		if result.Success == false then
			return result
		end
		self:PublishTurnStateSnapshot("SKILL_QUEUE_ITEM_REMOVED")
		log("[BattleTileQueue] removed index=" .. queueIndex .. " tile=" .. result.RemovedSkillId .. " remaining=" .. result.QueueCount .. " turn=" .. self.TurnNumber)
		return result
	end

	@ExecSpace("ServerOnly")
	method table TryReorderQueuedTile(integer fromIndex, integer toIndex, integer expectedQueueOrderRevision)
		local currentRevision = self.TurnState ~= nil and self.TurnState.QueueOrderRevision or 0
		local currentQueue = self.TurnState ~= nil and self.TurnState.QueuedTileIds or ""
		local result = {
			Success = false,
			Reason = "UNKNOWN",
			FromIndex = fromIndex,
			ToIndex = toIndex,
			PreviousQueue = currentQueue,
			QueuedTileIds = currentQueue,
			QueueOrderRevision = currentRevision
		}
		if fromIndex ~= math.floor(fromIndex) or toIndex ~= math.floor(toIndex) then
			result.Reason = "INVALID_QUEUE_INDEX_TYPE"
			return result
		end
		if expectedQueueOrderRevision ~= math.floor(expectedQueueOrderRevision) then
			result.Reason = "INVALID_QUEUE_REVISION_TYPE"
			return result
		end
		if self.ContentValidationState ~= "VALID" then
			result.Reason = "CONTENT_NOT_READY"
			return result
		end
		if self.BattleResult ~= "" then
			result.Reason = "BATTLE_ALREADY_ENDED"
			return result
		end
		if self.TurnState == nil or self.TurnState.BattlePhase ~= "PlayerTurn" then
			result.Reason = "NOT_PLAYER_DECISION_STATE"
			return result
		end
		if self.TurnState.IsActionProcessing == true then
			result.Reason = "ACTION_PROCESSING"
			return result
		end
		if self.TurnState.ExecutingTileIds ~= "" then
			result.Reason = "EXECUTION_SNAPSHOT_ACTIVE"
			return result
		end
		if expectedQueueOrderRevision ~= self.TurnState.QueueOrderRevision then
			result.Reason = "STALE_QUEUE_REVISION"
			return result
		end
		if self.TurnState.QueuedTileCount < 2 then
			result.Reason = "QUEUE_REORDER_NOT_NEEDED"
			return result
		end

		result = self:TryMoveQueuedTile(fromIndex, toIndex)
		result.PreviousQueue = currentQueue
		result.QueuedTileIds = self.TurnState.QueuedTileIds
		result.QueueOrderRevision = self.TurnState.QueueOrderRevision
		return result
	end

	@ExecSpace("ServerOnly")
	method table TryMoveQueuedTile(integer fromIndex, integer toIndex)
		-- Reorders the queued tiles without advancing the turn or starting the enemy round.
		local result = self.TurnState:TryMoveQueuedSkill(fromIndex, toIndex)
		if result.Success == false then
			return result
		end
		if result.Reason == "MOVED" then
			self:PublishTurnStateSnapshot("SKILL_QUEUE_ITEM_MOVED")
			log("[BattleTileQueue] moved tile=" .. result.MovedSkillId .. " from=" .. fromIndex .. " to=" .. toIndex .. " queue=" .. self.TurnState.QueuedTileIds .. " turn=" .. self.TurnNumber)
		end
		return result
	end

	@ExecSpace("ServerOnly")
	method void PublishQueueReorderReceipt(integer fromIndex, integer toIndex, table result)
		self.QueueLastRequestId = self.LastProcessedQueueReorderRequestId
		self.QueueLastRequestSuccess = result ~= nil and result.Success == true
		self.QueueLastRequestReason = result ~= nil and result.Reason or "UNKNOWN"
		self.QueueLastSourceIndex = fromIndex
		self.QueueLastTargetIndex = toIndex
		self.QueueLastOrderRevision = self.TurnState ~= nil and self.TurnState.QueueOrderRevision or 0
		self.QueueReorderReceiptRevision = self.QueueReorderReceiptRevision + 1
		log("[BattleQueueReorder] receipt request=" .. tostring(self.QueueLastRequestId)
			.. " success=" .. tostring(self.QueueLastRequestSuccess)
			.. " reason=" .. self.QueueLastRequestReason
			.. " from=" .. tostring(fromIndex)
			.. " to=" .. tostring(toIndex)
			.. " queueRevision=" .. tostring(self.QueueLastOrderRevision)
			.. " queued=" .. tostring(self.TurnState ~= nil and self.TurnState.QueuedTileIds or "")
			.. " executing=" .. tostring(self.TurnState ~= nil and self.TurnState.ExecutingTileIds or ""))
	end

	@ExecSpace("Server")
	method void RequestReturnToLobbyAfterDefeat()
		-- Accepts the defeat return only from the registered solo player and keeps all mutations on the server.
		if self:IsValidPlayerRequest(senderUserId) == false then
			log_warning("[BattleDefeatReturn] rejected reason=INVALID_SENDER")
			return
		end

		local result = self:ReturnToLobbyAfterDefeat()
		self:PublishPlayerCommandResult("RETURN_TO_LOBBY", result)
		if result.Success == false then
			log_warning("[BattleDefeatReturn] rejected reason=" .. result.Reason)
		end
	end

	@ExecSpace("ServerOnly")
	method table ReturnToLobbyAfterDefeat()
		-- Resets the failed run and its entry payload before requesting the authoritative lobby transfer.
		if self.BattleResult ~= "Defeat" then
			return { Success = false, Reason = "BATTLE_NOT_DEFEATED" }
		end
		if isvalid(self.PlayerEntity) == false then
			return { Success = false, Reason = "PLAYER_MISSING" }
		end
		local entryState = _BattleGatewayLogic:GetOrCreateEntryState(self.PlayerEntity)
		if entryState == nil then
			return { Success = false, Reason = "ENTRY_STATE_UNAVAILABLE" }
		end

		local resetResult = self.ResultDefeatReset
		if resetResult.Success ~= true then
			resetResult = _RunManagerLogic:ResetFailedRun(self.PlayerEntity, "BATTLE_DEFEAT_RETURN")
			if resetResult.Success then self.ResultDefeatReset = resetResult end
		end
		if resetResult.Success == false then
			return resetResult
		end
		entryState:ResetToIdle("BATTLE_DEFEAT_RETURN")
		self.BattleResult = ""
		self.PlayerExitObservedAfterBattle = true
		log("[BattleDefeatReturn] map session result cleared and fresh entry armed before transfer")
		local navigationResult = _MapTeleportManager:TeleportPlayer(
			self.PlayerEntity,
			"lobby",
			Vector3(-27.22, -7.92, 0),
			"BATTLE_DEFEAT_RETURN"
		)
		if navigationResult.Success == false then
			self.BattleResult = "Defeat"
			self.PlayerExitObservedAfterBattle = false
			return navigationResult
		end
		log("[BattleDefeatReturn] completed player=" .. self.PlayerEntity.Name .. " previousSequence=" .. resetResult.RunSequence .. " destination=lobby")
		return { Success = true, Reason = "LOBBY_TRANSFER_REQUESTED", RunSequence = resetResult.RunSequence }
	end

	@ExecSpace("ServerOnly")
	method void ResetUnionRewardPresentation(string reason)
		self.UnionRewardRunId = 0
		self.UnionRewardBasePoints = 0
		self.UnionRewardBonusPoints = 0
		self.UnionRewardFinalPoints = 0
		self.UnionRewardWasCommitted = false
		self.UnionRewardWasDuplicate = false
		self.UnionRewardRunEnded = false
		self.UnionRewardRunEndReason = reason or ""
		self.UnionRewardRevision = self.UnionRewardRevision + 1
	end

	@ExecSpace("ServerOnly")
	method void RefreshUnionRewardPresentation()
		if isvalid(self.PlayerEntity) == false then
			return
		end
		local snapshot = _UnionRewardServiceLogic:GetRunRewardSnapshot(self.PlayerEntity)
		if snapshot.Success == false then
			log_warning("[BattleResult] Union reward snapshot unavailable reason=" .. snapshot.Reason)
			return
		end
		self.UnionRewardRunId = snapshot.RewardRunId or 0
		self.UnionRewardBasePoints = snapshot.BaseUnionPoints or 0
		self.UnionRewardBonusPoints = snapshot.BonusUnionPoints or 0
		self.UnionRewardFinalPoints = snapshot.FinalUnionPoints or 0
		self.UnionRewardWasCommitted = snapshot.WasCommitted == true
		self.UnionRewardWasDuplicate = snapshot.WasDuplicate == true
		self.UnionRewardRunEnded = snapshot.RunEnded == true
		self.UnionRewardRunEndReason = snapshot.RunEndReason or ""
		self.UnionRewardRevision = self.UnionRewardRevision + 1
		log("[BattleResult] Union reward runId=" .. self.UnionRewardRunId .. " base=" .. self.UnionRewardBasePoints .. " bonus=" .. self.UnionRewardBonusPoints .. " final=" .. self.UnionRewardFinalPoints .. " committed=" .. tostring(self.UnionRewardWasCommitted) .. " ended=" .. tostring(self.UnionRewardRunEnded))
	end

	@ExecSpace("ServerOnly")
	method void ApplyRunJobConfiguration(any runState, Entity playerEntity)
		-- Copies the player-owned job snapshot into synchronized map-scoped battle state.
		if runState == nil then
			return
		end
		local runOwner = playerEntity
		if isvalid(runOwner) == false then
			runOwner = self.PlayerEntity
		end
		self.SelectedJobId = runState.SelectedJobId
		self.SelectedJobMechanicId = runState.SelectedJobMechanicId
		self.SelectedJobPassiveSetId = runState.SelectedJobPassiveSetId
		local utility = _SkillDefinitionRepositoryLogic:GetUtilitySkillBundle(self.SelectedJobId)
		self.UtilitySkillId = utility.Success and utility.Definition.SkillId or ""
		self.UtilitySkillIconRuid = utility.Success and utility.Definition.IconRuid or ""
		self.UtilityMaxCooldown = utility.Success and utility.Definition.CooldownTurns or 0
		self.UtilityRemainingCooldown = 0
		self.SelectedJobStartingSkillIds = runState.StartingSkillIds
		self.SelectedJobBaseMaxHp = runState.JobBaseMaxHp
		self.SelectedJobBaseQueueCapacity = runState.JobBaseQueueCapacity
		self.SelectedJobRevision = runState.JobRevision
		local unionSnapshot = _RunManagerLogic:GetRunUnionEffectSnapshot(runOwner)
		if unionSnapshot.Success == true then
			self.UnionItemDropRate = unionSnapshot.ItemDropRate
		else
			self.UnionItemDropRate = 0
			log_error("[UnionEffect] battle snapshot unavailable reason=" .. (unionSnapshot.Reason or "UNKNOWN"))
		end
		log("[BattleJob] configuration applied job=" .. self.SelectedJobId .. " mechanic=" .. self.SelectedJobMechanicId .. " passive=" .. self.SelectedJobPassiveSetId .. " hp=" .. self.SelectedJobBaseMaxHp .. " queue=" .. self.SelectedJobBaseQueueCapacity .. " skills=" .. self.SelectedJobStartingSkillIds .. " revision=" .. self.SelectedJobRevision)
		self:RefreshSkillSlots("JOB_APPLIED", runOwner)
	end

	@ExecSpace("ServerOnly")
	method void RefreshSkillSlots(string reason, Entity playerEntity)
		-- Reconciles the player-owned run order and copies it into this map-scoped BattleSession.
		local ownedSnapshot = ""
		local runSlotIds = ""
		local runOrderRevision = 0
		local runOrderAvailable = false
		local inventory = nil
		if isvalid(playerEntity) then
			inventory = playerEntity:GetComponent("script.PlayerRunInventoryComponent")
			if inventory ~= nil then
				ownedSnapshot = inventory.RunSkillSnapshot
				local runOrderResult = inventory:GetOrInitializeRunSkillBarOrder()
				if runOrderResult.Success == true then
					runSlotIds = runOrderResult.SlotIds or ""
					runOrderRevision = runOrderResult.Revision or 0
					runOrderAvailable = runSlotIds ~= ""
				else
					log_error("[BattleSkillSlots] run order unavailable reason=" .. (runOrderResult.Reason or "UNKNOWN") .. " refresh=" .. (reason or ""))
				end
			end
		end
		if ownedSnapshot == "" then
			ownedSnapshot = self.SelectedJobStartingSkillIds
		end
		if runOrderAvailable == true
			and ownedSnapshot == self.SkillSlotSourceSnapshot
			and runOrderRevision == self.SkillSlotSourceRunOrderRevision
			and runSlotIds == self.SkillSlotIds then
			return
		end
		self.SkillSlotSourceSnapshot = ownedSnapshot
		self.SkillSlotSourceRunOrderRevision = runOrderRevision

		local candidates = {}
		local seen = {}
		for token in string.gmatch(ownedSnapshot or "", "([^|]+)") do
			-- Inventory snapshot entries carry an owned-amount suffix ("brandish~1"); only the id selects a slot.
			local skillId = string.match(token, "^([^~]+)")
			if skillId ~= nil and skillId ~= "" and seen[skillId] == nil then
				seen[skillId] = true
				table.insert(candidates, skillId)
			end
		end

		-- Icons cover every candidate, not just the drawn slots, because the queue accepts any owned skill.
		-- The same pass collects the clips those skills will play, so the client can warm them before the
		-- first cast instead of loading one mid-flight.
		local iconRecords = {}
		local presentationRuids = {}
		local presentationSeen = {}
		for _, ruid in ipairs(_EnemyImpactPresentationLogic:GetResourceRuids()) do
			self:CollectPresentationRuid(presentationRuids, presentationSeen, ruid)
		end
		for _, skillId in ipairs(candidates) do
			local definition = _SkillDefinitionRepositoryLogic:GetSkillDefinition(skillId)
			if definition.Success == true then
				if definition.IconRuid ~= nil and definition.IconRuid ~= "" then
					table.insert(iconRecords, skillId .. "~" .. definition.IconRuid)
				end
				self:CollectPresentationRuid(presentationRuids, presentationSeen, definition.CastEffectRuid)
				self:CollectPresentationRuid(presentationRuids, presentationSeen, definition.HitEffectRuid)
				self:CollectPresentationRuid(presentationRuids, presentationSeen, definition.ProjectileRuid)
				-- Audio clips warm the same way: an unloaded cast sound lands after its own swing, which
				-- reads as a mistimed hit rather than a slow load.
				self:CollectPresentationRuid(presentationRuids, presentationSeen, definition.CastSoundRuid)
				self:CollectPresentationRuid(presentationRuids, presentationSeen, definition.HitSoundRuid)
			end
		end

		-- The utility skill comes from the job, not from the owned-skill snapshot, so it never appears among
		-- the candidates above. Warm it in the same pass; otherwise its first cast is the one that loads it.
		local utility = _SkillDefinitionRepositoryLogic:GetUtilitySkillBundle(self.SelectedJobId)
		if utility.Success == true then
			self:CollectPresentationRuid(presentationRuids, presentationSeen, utility.Definition.CastEffectRuid)
			self:CollectPresentationRuid(presentationRuids, presentationSeen, utility.Definition.HitEffectRuid)
			self:CollectPresentationRuid(presentationRuids, presentationSeen, utility.Definition.ProjectileRuid)
			self:CollectPresentationRuid(presentationRuids, presentationSeen, utility.Definition.CastSoundRuid)
			self:CollectPresentationRuid(presentationRuids, presentationSeen, utility.Definition.HitSoundRuid)
		else
			-- A job with no authored utility row is a valid configuration, and warming is an optimisation
			-- only, so this stays a log rather than a failure.
			log("[BattleSkillSlots] utility warm skipped job=" .. self.SelectedJobId .. " reason=" .. (utility.Reason or "UNKNOWN"))
		end

		local slotIds = {}
		local slotNames = {}
		local slotCooldownTurns = {}
		if runOrderAvailable == true then
			slotIds = self:ParseSkillSlotPipe(runSlotIds)
		else
			-- Compatibility fallback only; valid runs initialize and persist their random default in the run owner.
			for index = #candidates, 2, -1 do
				local swapIndex = _UtilLogic:RandomIntegerRange(1, index)
				candidates[index], candidates[swapIndex] = candidates[swapIndex], candidates[index]
			end
			for index = 1, math.min(self.SkillSlotCount, #candidates) do
				slotIds[index] = candidates[index]
			end
			log_warning("[BattleSkillSlots] using nonpersistent fallback reason=RUN_ORDER_UNAVAILABLE refresh=" .. (reason or ""))
		end
		for slotIndex = 1, self.SkillSlotCount do
			local skillId = slotIds[slotIndex] or ""
			slotNames[slotIndex] = ""
			slotCooldownTurns[slotIndex] = ""
			if skillId ~= "" then
				local definition = _SkillDefinitionRepositoryLogic:GetSkillDefinition(skillId)
				if definition.Success == true then
					slotNames[slotIndex] = definition.DisplayName
					slotCooldownTurns[slotIndex] = tostring(math.max(0, math.floor(definition.CooldownTurns or 0)))
				else
					log_error("[BattleSkillSlots] ordered skill definition unavailable skill=" .. skillId .. " reason=" .. (definition.Reason or "UNKNOWN"))
				end
			end
		end

		self.SkillSlotIds = self:SerializeSkillSlotPipe(slotIds)
		self.SkillSlotNames = self:SerializeSkillSlotPipe(slotNames)
		self.SkillSlotCooldownTurns = self:SerializeSkillSlotPipe(slotCooldownTurns)
		self.SkillSlotRevision = self.SkillSlotRevision + 1
		self.SkillIconSnapshot = table.concat(iconRecords, "|")
		log("[BattleSkillSlots] assigned reason=" .. reason .. " owned=" .. ownedSnapshot .. " runOrder=" .. tostring(runOrderAvailable) .. " runOrderRevision=" .. tostring(self.SkillSlotSourceRunOrderRevision) .. " slots=" .. self.SkillSlotIds .. " names=" .. self.SkillSlotNames .. " cooldowns=" .. self.SkillSlotCooldownTurns .. " icons=" .. tostring(#iconRecords) .. " presentationRuids=" .. tostring(#presentationRuids))

		-- Scope note: this method is only reached from job apply, so the warm covers the skills owned at
		-- battle start. A skill granted mid-run is not re-warmed here -- it falls back to the renderer being
		-- held off until its RUID lands, which costs a brief invisible projectile rather than a wrong one.
		if #presentationRuids > 0 and isvalid(self.PlayerEntity) and self.PlayerEntity.PlayerComponent ~= nil then
			self:PreloadSkillPresentation(table.concat(presentationRuids, "|"), self.PlayerEntity.PlayerComponent.UserId)
		end
	end

	@ExecSpace("ServerOnly")
	method void CollectPresentationRuid(table collected, table seen, string ruid)
		-- Appends one distinct non-empty clip RUID. Skills share cast and hit clips across tiers, so the
		-- seen set keeps the preload list from asking for the same resource several times.
		if ruid == nil or ruid == "" or seen[ruid] ~= nil then
			return
		end
		seen[ruid] = true
		table.insert(collected, ruid)
	end

	@ExecSpace("Client")
	method void PreloadSkillPresentation(string ruidCsv)
		-- Warms the client resource cache with this run's cast / hit / projectile clips.
		-- These RUIDs are only ever assigned at cast time, so on a cold cache the renderer keeps showing
		-- whatever it had while the clip loads -- long enough to cover a whole projectile flight. Loading
		-- them up front is what makes the first cast of a skill look like every later one.
		if ruidCsv == "" then
			return
		end

		local ruids = {}
		for ruid in string.gmatch(ruidCsv, "([^|]+)") do
			table.insert(ruids, ruid)
		end
		if #ruids == 0 then
			return
		end

		local requested = #ruids
		log("[SkillPreload] requested count=" .. tostring(requested))
		_ResourceService:PreloadAsync(ruids, function(results)
			local succeeded = 0
			local failed = 0
			for _, status in pairs(results or {}) do
				if status == PreloadResultStatus.Success then
					succeeded = succeeded + 1
				else
					failed = failed + 1
					log_warning("[SkillPreload] resource rejected status=" .. tostring(status))
				end
			end
			-- Purely an optimisation: a failure here costs the old first-cast flicker, never gameplay.
			log("[SkillPreload] complete requested=" .. tostring(requested) .. " success=" .. tostring(succeeded) .. " failed=" .. tostring(failed))
		end)
	end

	@ExecSpace("ServerOnly")
	method table StartNewRun(integer runSeed)
		-- Asks the player-owned run state to begin, then rebuilds this map-scoped battle.
		if isvalid(self.PlayerEntity) == false then
			return {
				Success = false,
				Reason = "PLAYER_MISSING"
			}
		end
		local runState = _RunManagerLogic:StartNewRun(self.PlayerEntity, runSeed)
		if runState == nil then
			return {
				Success = false,
				Reason = "RUN_STATE_UNAVAILABLE"
			}
		end
		local jobResult = _RunManagerLogic:ApplyJobSelection(self.PlayerEntity, self.SelectedJobId)
		if jobResult.Success == false then
			return jobResult
		end
		self:ApplyRunJobConfiguration(runState, self.PlayerEntity)
		self.RunSeed = runState.RunSeed
		log("[BattleRun] new run requested sequence=" .. runState.RunSequence .. " seed=" .. self.RunSeed)
		return self:RebuildBattleState("NEW_RUN")
	end

	@ExecSpace("ServerOnly")
	method table InitializeFromEntry(Entity playerEntity, string stageId, string characterId, string jobId, string loadoutId, integer runSeed, string entryMode, integer requestId)
		-- Public map-session initializer used only through BattleGatewayLogic.
		local result = {
			Success = false,
			Reason = "UNKNOWN",
			RequestId = requestId,
			StageId = stageId
		}
		if isvalid(playerEntity) == false or playerEntity.PlayerComponent == nil then
			result.Reason = "INVALID_PLAYER"
			return result
		end
		if stageId == nil or stageId == "" then
			result.Reason = "INVALID_STAGE_ID"
			return result
		end
		if requestId > 0 and requestId == self.LastInitializedEntryRequestId then
			result.Reason = "DUPLICATE_ENTRY_INITIALIZATION"
			log_warning("[BattleSession] duplicate entry initialization blocked request=" .. requestId .. " stageId=" .. stageId)
			return result
		end
		log("[BattleSession] initialize from entry stageId=" .. stageId .. " request=" .. requestId)
		local stageValidation = _ContentValidatorLogic:ValidateStageById(stageId)
		if stageValidation.Success == false then
			result.Reason = stageValidation.Reason
			result.DetailReason = stageValidation.DetailReason or ""
			return result
		end
		if entryMode ~= "NEW_RUN" and entryMode ~= "CONTINUE_RUN" then
			result.Reason = "INVALID_ENTRY_MODE"
			return result
		end

		local runState = nil
		if entryMode == "NEW_RUN" then
			runState = _RunManagerLogic:StartNewRun(playerEntity, runSeed)
		else
			runState = _RunManagerLogic:EnsureRunState(playerEntity, runSeed)
		end
		if runState == nil then
			result.Reason = "RUN_STATE_UNAVAILABLE"
			return result
		end
		local jobResult = _RunManagerLogic:ApplyJobSelection(playerEntity, jobId)
		if jobResult.Success == false then
			result.Reason = jobResult.Reason
			result.DetailReason = jobResult.DetailReason or ""
			return result
		end
		self:ApplyRunJobConfiguration(runState, playerEntity)

		local applyResult = self:LoadAndApplyStageDefinition(stageId)
		if applyResult.Success == false then
			result.Reason = applyResult.Reason
			result.DetailReason = applyResult.DetailReason or ""
			return result
		end
		self.RunSeed = runState.RunSeed
		self.EntryRequestId = requestId
		self.EntryMode = entryMode
		self.SelectedCharacterId = characterId or ""
		self.SelectedLoadoutId = loadoutId or ""
		self:RegisterPlayer(playerEntity)

		local rebuildResult = self:RebuildBattleState("BATTLE_ENTRY")
		result.Success = rebuildResult.Success
		result.Reason = rebuildResult.Reason
		if result.Success == true then
			self.LastInitializedEntryRequestId = requestId
		end
		log("[BattleSession] entry initialized request=" .. requestId .. " stage=" .. self.StageId .. " character=" .. self.SelectedCharacterId .. " job=" .. self.SelectedJobId .. " loadout=" .. self.SelectedLoadoutId .. " seed=" .. self.RunSeed .. " mode=" .. self.EntryMode .. " success=" .. tostring(result.Success))
		return result
	end

	@ExecSpace("ServerOnly")
	method table RunContentValidationGate(string reason)
		-- Coordinates startup validation while domain validators retain all content rules.
		local validation = nil
		if self.RequireValidContentAtStartup == false then
			validation = {
				Success = true,
				Reason = "VALIDATION_DISABLED",
				ErrorCount = 0,
				ErrorSnapshot = ""
			}
		else
			validation = _ContentValidatorLogic:ValidateAllContent()
		end
		if validation == nil then
			validation = {
				Success = false,
				Reason = "VALIDATOR_UNAVAILABLE",
				ErrorCount = 1,
				ErrorSnapshot = "ContentValidatorLogic[0]=VALIDATOR_UNAVAILABLE"
			}
		end
		self:ApplyContentValidationResult(validation, reason)
		return validation
	end

	@ExecSpace("ServerOnly")
	method void ApplyContentValidationResult(table validation, string reason)
		-- Publishes a compact synchronized gate result; UI does not inspect datasets or validator internals.
		if validation ~= nil and validation.Success == true then
			self.ContentValidationState = "VALID"
			self.ContentValidationReason = validation.Reason or "OK"
			self.ContentValidationErrorCount = validation.ErrorCount or 0
			self.ContentValidationErrorSnapshot = validation.ErrorSnapshot or ""
			self.ContentValidationRevision = self.ContentValidationRevision + 1
			log("[BattleContentGate] valid trigger=" .. reason .. " revision=" .. self.ContentValidationRevision)
			return
		end

		self.ContentValidationState = "BLOCKED"
		self.ContentValidationReason = validation ~= nil and (validation.Reason or "CONTENT_VALIDATION_FAILED") or "VALIDATOR_UNAVAILABLE"
		self.ContentValidationErrorCount = validation ~= nil and (validation.ErrorCount or 1) or 1
		self.ContentValidationErrorSnapshot = validation ~= nil and (validation.ErrorSnapshot or "") or "ContentValidatorLogic[0]=VALIDATOR_UNAVAILABLE"
		self.ContentValidationRevision = self.ContentValidationRevision + 1
		log_error("[BattleContentGate] blocked trigger=" .. reason .. " reason=" .. self.ContentValidationReason .. " errors=" .. self.ContentValidationErrorCount .. " details=" .. self.ContentValidationErrorSnapshot)
	end

	method boolean IsContentValidationReady()
		if self.RequireValidContentAtStartup == false then
			return true
		end
		return self.ContentValidationState == "VALID"
	end

	@ExecSpace("ClientOnly")
	method table ParseEnemyPlanSnapshot(string serializedPlans)
		-- Parses the server DTO only; no pattern, targeting, or trait rule is repeated on the client.
		local plans = {}
		for entry in string.gmatch(serializedPlans or "", "([^#]+)") do
			local fields = {}
			for field in string.gmatch(entry, "([^,]+)") do
				table.insert(fields, field)
			end
			if #fields >= 14 and fields[1] ~= "" then
				local unitId = self:DecodeEnemyPlanField(fields[1])
				local traitIds = self:DecodeEnemyPlanField(fields[6])
				local actionType = self:DecodeEnemyPlanField(fields[7])
				local tileId = self:DecodeEnemyPlanField(fields[8])
				local patternId = self:DecodeEnemyPlanField(fields[11])
				local actionSnapshot = self:DecodeEnemyPlanField(fields[14])
				local bossPhaseId = ""
				local bossPhaseIndex = 0
				local bossPhaseRevision = 0
				local queueTurnsRequired = 0
				local queueTurnsElapsed = 0
				local readinessReason = ""
				local nextCommandType = ""
				local targetCellSnapshot = ""
				local nextCommandDirection = 0
				local entityName = ""
				local queuedTileNames = ""
				local queuedIconRuids = ""
				local queuedIconBackgroundColors = ""
				local telegraphKind = ""
				local landingCell = -1
				local deferredUntilTurn = 0
				local castState = "NONE"
				local castingSkillId = ""
				local interruptHitsRequired = 0
				local interruptHitsReceived = 0
				if #fields >= 17 then
					bossPhaseId = self:DecodeEnemyPlanField(fields[15])
					bossPhaseIndex = math.floor(tonumber(fields[16]) or 0)
					bossPhaseRevision = math.floor(tonumber(fields[17]) or 0)
				end
				if #fields >= 19 then
					queueTurnsRequired = math.floor(tonumber(fields[18]) or 0)
					queueTurnsElapsed = math.floor(tonumber(fields[19]) or 0)
				end
				if #fields >= 22 then
					readinessReason = self:DecodeEnemyPlanField(fields[20])
					nextCommandType = self:DecodeEnemyPlanField(fields[21])
					targetCellSnapshot = self:DecodeEnemyPlanField(fields[22])
				end
				if #fields >= 23 then
					nextCommandDirection = math.floor(tonumber(fields[23]) or 0)
				end
				if #fields >= 25 then
					entityName = self:DecodeEnemyPlanField(fields[24])
					queuedTileNames = self:DecodeEnemyPlanField(fields[25])
				end
				if #fields >= 26 then
					queuedIconRuids = self:DecodeEnemyPlanField(fields[26])
				end
				if #fields >= 28 then
					telegraphKind = self:DecodeEnemyPlanField(fields[27])
					landingCell = math.floor(tonumber(fields[28]) or -1)
				end
				if #fields >= 29 then
					deferredUntilTurn = math.floor(tonumber(fields[29]) or 0)
				end
				if #fields >= 30 then
					queuedIconBackgroundColors = self:DecodeEnemyPlanField(fields[30])
				end
				if #fields >= 34 then
					castState = self:DecodeEnemyPlanField(fields[31])
					castingSkillId = self:DecodeEnemyPlanField(fields[32])
					interruptHitsRequired = math.floor(tonumber(fields[33]) or 0)
					interruptHitsReceived = math.floor(tonumber(fields[34]) or 0)
				end
				local queuedTileIds = ""
				-- Keep the client read model aligned with the server DTO: a completed or merely
				-- selected action is not a newly filled enemy queue slot.
				local planState = self:DecodeEnemyPlanField(fields[3])
				local hasInsertedQueue = planState == "TRACKING"
					or planState == "ATTACK_READY"
					or planState == "EXECUTING"
					or (planState == "INSERTING" and queueTurnsElapsed > 0 and string.find("|" .. traitIds .. "|", "|DOUBLE_STRIKE|", 1, true) ~= nil)
				if hasInsertedQueue then
					for actionEntry in string.gmatch(actionSnapshot or "", "([^>]+)") do
						local actionFields = {}
						for actionField in string.gmatch(actionEntry, "([^~]+)") do
							table.insert(actionFields, actionField)
						end
						local queuedTileId = ""
						if #actionFields >= 3 then
							queuedTileId = self:DecodeEnemyPlanField(actionFields[3])
						end
						if queuedTileId ~= "" then
							if queuedTileIds ~= "" then
								queuedTileIds = queuedTileIds .. "|"
							end
							queuedTileIds = queuedTileIds .. queuedTileId
						end
					end
				else
					-- INSERTING is a selected future action, not an item already owned by the enemy queue.
					queuedTileNames = ""
					queuedIconRuids = ""
					queuedIconBackgroundColors = ""
				end
				-- Frozen summon plans are visible during the player turn before the enemy summons.
				-- Summoning is a command without a TileId, but still occupies a monster skill queue slot.
				if actionType == "SUMMON_ENEMIES" and (fields[3] == "PREPARED" or fields[3] == "EXECUTING") then
					queuedTileIds = "faust_summon"
					queuedTileNames = "좀비루팡 소환"
					queuedIconRuids = "a878e3aa8b40480cba6f5167285a4ec4"
				end
				table.insert(plans, {
					UnitId = unitId,
					SpawnOrder = math.floor(tonumber(fields[2]) or 0),
					State = self:DecodeEnemyPlanField(fields[3]),
					CurrentActionIndex = math.floor(tonumber(fields[4]) or 0),
					ActionCount = math.floor(tonumber(fields[5]) or 0),
					TraitIds = traitIds,
					CommandType = actionType,
					TileId = tileId,
					Direction = math.floor(tonumber(fields[9]) or 0),
					TelegraphTurnsRemaining = math.floor(tonumber(fields[10]) or 0),
					PatternId = patternId,
					StepIndex = math.floor(tonumber(fields[12]) or 0),
					Revision = math.floor(tonumber(fields[13]) or 0),
					QueuedActionSnapshot = actionSnapshot,
					QueuedTileIds = queuedTileIds,
					BossPhaseId = bossPhaseId,
					BossPhaseIndex = bossPhaseIndex,
					BossPhaseRevision = bossPhaseRevision,
					QueueTurnsRequired = queueTurnsRequired,
					QueueTurnsElapsed = queueTurnsElapsed,
					ReadinessReason = readinessReason,
					NextCommandType = nextCommandType,
					NextCommandDirection = nextCommandDirection,
					TargetCells = targetCellSnapshot,
					EntityName = entityName,
					QueuedTileNames = queuedTileNames,
					QueuedIconRuids = queuedIconRuids,
					QueuedIconBackgroundColors = queuedIconBackgroundColors,
					TelegraphKind = telegraphKind,
					LandingCell = landingCell,
					DeferredUntilTurn = deferredUntilTurn,
					CastState = castState,
					CastingSkillId = castingSkillId,
					InterruptHitsRequired = interruptHitsRequired,
					InterruptHitsReceived = interruptHitsReceived,
					IsCastInterrupted = castState == "INTERRUPTED",
					IsAttackReady = fields[3] == "ATTACK_READY",
					IsQueueReady = hasInsertedQueue
				})
			end
		end
		table.sort(plans, function(left, right)
			return left.SpawnOrder < right.SpawnOrder
		end)
		return plans
	end

	@ExecSpace("ClientOnly")
	method string DecodeEnemyPlanField(string value)
		if value == "-" then
			return ""
		end
		return value or ""
	end

	@ExecSpace("ClientOnly")
	method table GetBattleUiState()
		-- Builds one read-only client DTO from synchronized map, turn, wave, cooldown, and intent state.
		local stateEntity = self.Entity:GetChildByName("BattleTurnState")
		local turnState = nil
		if stateEntity ~= nil then
			turnState = stateEntity:GetComponent("script.BattleTurnComponent")
		else
			turnState = self.Entity:GetComponent("script.BattleTurnComponent")
		end
		local waveEntity = self.Entity:GetChildByName("BattleWaveState")
		local waveState = nil
		if waveEntity ~= nil then
			waveState = waveEntity:GetComponent("script.BattleWaveComponent")
		else
			waveState = self.Entity:GetComponent("script.BattleWaveComponent")
		end
		local intentEntity = self.Entity:GetChildByName("BattleEnemyIntentState")
		local intentState = nil
		if intentEntity ~= nil then
			intentState = intentEntity:GetComponent("script.EnemyIntentComponent")
		else
			intentState = self.Entity:GetComponent("script.EnemyIntentComponent")
		end
		if turnState == nil or waveState == nil then
			return { Success = false, Reason = "BATTLE_STATE_MISSING" }
		end

		local runStats = _RunManagerLogic:GetLocalRunStatsSnapshot()
		local cooldownSnapshot = ""
		local cooldownRevision = 0
		local runConsumableSnapshot = ""
		local runCurrencySnapshot = ""
		local runSkillSnapshot = ""
		local runInventoryRevision = 0
		local runSkillInventoryRevision = 0
		local runConsumableCapacity = 0
		local ownedAugmentSnapshot = ""
		local runAugmentRevision = 0
		local localPlayer = _UserService.LocalPlayer
		if localPlayer ~= nil then
			local runtimeState = localPlayer:GetComponent("script.SkillRuntimeStateComponent")
			if runtimeState ~= nil then
				cooldownSnapshot = runtimeState.CooldownSnapshot
				cooldownRevision = runtimeState.CooldownRevision
			end
			local runInventory = localPlayer:GetComponent("script.PlayerRunInventoryComponent")
			if runInventory ~= nil then
				runConsumableSnapshot = runInventory.RunConsumableSnapshot
				runCurrencySnapshot = runInventory.RunCurrencySnapshot
				runSkillSnapshot = runInventory.RunSkillSnapshot
				runInventoryRevision = runInventory.InventoryRevision
				runSkillInventoryRevision = runInventory.SkillInventoryRevision
				runConsumableCapacity = runInventory.ConsumableCapacity
			end
			local runAugments = localPlayer:GetComponent("script.PlayerRunAugmentComponent")
			if runAugments ~= nil then
				ownedAugmentSnapshot = runAugments.OwnedAugmentSnapshot
				runAugmentRevision = runAugments.AugmentRevision
			end
		end
		local dropRuntime = self.Entity:GetComponent("script.BattleDropComponent")
		local pendingDropSnapshot = ""
		local pendingDropCount = 0
		local dropRevision = 0
		if dropRuntime ~= nil then
			pendingDropSnapshot = dropRuntime.PendingDropSnapshot
			pendingDropCount = dropRuntime.PendingDropCount
			dropRevision = dropRuntime.DropRevision
		end

		local playerActionState = self:ResolvePlayerActionState(turnState)
		local isIdlePlayerTurn = self.ContentValidationState == "VALID" and self.BattleResult == "" and turnState.BattlePhase == "PlayerTurn" and turnState.IsActionProcessing == false
		local queueCount = turnState.QueuedTileCount
		local effectiveCapacity = turnState.TileQueueCapacity
		local queuedItems = {}
		local queueIndex = 0
		for skillId in string.gmatch(turnState.QueuedTileIds, "([^|]+)") do
			queueIndex = queueIndex + 1
			table.insert(queuedItems, { Index = queueIndex, SkillId = skillId })
		end
		local enemyIntents = self:ParseEnemyPlanSnapshot(self.EnemyPlanSnapshot)
		local preparedIntent = {
			State = self.PreparedEnemyIntentState,
			EnemyId = self.PreparedEnemyId,
			PatternId = self.PreparedEnemyPatternId,
			StepIndex = self.PreparedEnemyStepIndex,
			ActionType = self.PreparedEnemyActionType,
			TileId = self.PreparedEnemyTileId,
			TelegraphTurnsRemaining = self.PreparedEnemyTelegraphTurnsRemaining,
			Direction = self.PreparedEnemyDirection,
			PreparedTurn = self.PreparedEnemyTurn,
			Reason = self.PreparedEnemyReason,
			Revision = 0
		}
		if intentState ~= nil then
			preparedIntent.State = intentState.IntentState
			preparedIntent.EnemyId = intentState.EnemyId
			preparedIntent.PatternId = intentState.PatternId
			preparedIntent.StepIndex = intentState.StepIndex
			preparedIntent.ActionType = intentState.ActionType
			preparedIntent.TileId = intentState.TileId
			preparedIntent.TelegraphTurnsRemaining = intentState.TelegraphTurnsRemaining
			preparedIntent.Direction = intentState.Direction
			preparedIntent.PreparedTurn = intentState.PreparedTurn
			preparedIntent.Reason = intentState.IntentReason
			preparedIntent.Revision = intentState.IntentRevision
		end
		if #enemyIntents == 0 and preparedIntent.State ~= "EMPTY" and preparedIntent.EnemyId ~= "" then
			table.insert(enemyIntents, {
				UnitId = preparedIntent.EnemyId,
				State = preparedIntent.State,
				PatternId = preparedIntent.PatternId,
				StepIndex = preparedIntent.StepIndex,
				CommandType = preparedIntent.ActionType,
				TileId = preparedIntent.TileId,
				TelegraphTurnsRemaining = preparedIntent.TelegraphTurnsRemaining,
				Direction = preparedIntent.Direction,
				PreparedTurn = preparedIntent.PreparedTurn,
				Reason = preparedIntent.Reason,
				Revision = preparedIntent.Revision,
				QueuedTileIds = preparedIntent.TileId
			})
		end

		return {
			Success = true,
			Reason = "OK",
			PlayerActionState = playerActionState,
			RunStats = runStats,
			CombatFeel = {
				PlayerMoveDuration = self.MoveActionDuration,
				MoveCurve = self.MoveCurve,
				MoveSnapThreshold = self.MoveSnapThreshold,
				PlayerHopEnabled = self.EnablePlayerHopVisual,
				PlayerHopDuration = self.PlayerHopDuration,
				PlayerHopHeight = self.PlayerHopHeight,
				PlayerHopTakeoffSquashDuration = self.PlayerHopTakeoffSquashDuration,
				PlayerHopLandingSquashDuration = self.PlayerHopLandingSquashDuration,
				PlayerHopSquashXScale = self.PlayerHopSquashXScale,
				PlayerHopSquashYScale = self.PlayerHopSquashYScale,
				AttackTransitionDelay = self.PlayerToEnemyBeatDuration,
				EnemyTurnTransitionDelay = self.EnemyToPlayerBeatDuration,
				QueuePopDuration = self.QueuePopDuration,
				NormalHitStopDuration = self.NormalHitStopDuration,
				StrongHitStopDuration = self.StrongHitStopDuration,
				HitFlashDuration = self.HitFlashDuration,
				HitReactionDuration = self.HitReactionDuration
			},
			RevisionKey = tostring(runStats.Revision) .. ":" .. tostring(runStats.RunSequence) .. ":" .. tostring(turnState.StateRevision) .. ":" .. tostring(turnState.QueueCapacityRevision) .. ":" .. tostring(turnState.QueueOrderRevision) .. ":" .. tostring(turnState.CommandResultRevision) .. ":" .. tostring(cooldownRevision) .. ":" .. tostring(runInventoryRevision) .. ":" .. tostring(runAugmentRevision) .. ":" .. tostring(self.AugmentRuntimeRevision) .. ":" .. tostring(dropRevision) .. ":" .. tostring(self.SelectedJobRevision) .. ":" .. tostring(self.JobMechanicRevision) .. ":" .. tostring(self.SkillTargetRevision) .. ":" .. tostring(self.ContentValidationRevision) .. ":" .. tostring(waveState.CurrentWave) .. ":" .. tostring(self.EnemyPlanRevision) .. ":" .. tostring(preparedIntent.Revision) .. ":" .. preparedIntent.State .. ":" .. preparedIntent.EnemyId .. ":" .. preparedIntent.ActionType .. ":" .. preparedIntent.TileId .. ":" .. tostring(self.UnionRewardRevision) .. ":" .. self.BattleResult,
			Phase = turnState.BattlePhase,
			TurnNumber = turnState.TurnNumber,
			IsProcessing = turnState.IsActionProcessing,
			BattleResult = self.BattleResult,
			UnionReward = {
				RewardRunId = self.UnionRewardRunId,
				BaseUnionPoints = self.UnionRewardBasePoints,
				BonusUnionPoints = self.UnionRewardBonusPoints,
				FinalUnionPoints = self.UnionRewardFinalPoints,
				WasCommitted = self.UnionRewardWasCommitted,
				WasDuplicate = self.UnionRewardWasDuplicate,
				RunEnded = self.UnionRewardRunEnded,
				RunEndReason = self.UnionRewardRunEndReason,
				Revision = self.UnionRewardRevision
			},
			Stage = {
				StageId = self.StageId,
				RegionId = self.RegionId,
				StageIndex = self.StageIndex,
				StageType = self.StageType,
				DisplayName = self.StageDisplayName,
				SchemaVersion = self.StageSchemaVersion
			},
			Commands = {
				CanMove = isIdlePlayerTurn,
				CanTurn = isIdlePlayerTurn,
				CanQueue = isIdlePlayerTurn and queueCount < effectiveCapacity,
				CanExecute = isIdlePlayerTurn and queueCount > 0,
				CanClear = isIdlePlayerTurn and queueCount > 0,
				CanRemove = isIdlePlayerTurn and queueCount > 0,
				CanReorder = isIdlePlayerTurn and queueCount > 1
			},
			LastCommand = {
				Type = turnState.LastCommandType,
				Success = turnState.LastCommandSuccess,
				Reason = turnState.LastCommandReason,
				Revision = turnState.CommandResultRevision
			},
			LastSkillTarget = {
				SkillId = self.LastSkillTargetSkillId,
				TargetingType = self.LastSkillTargetingType,
				TargetUnitIds = self.LastSkillTargetUnitIds,
				TargetCellIndices = self.LastSkillTargetCellIndices,
				Reason = self.LastSkillTargetReason,
				Revision = self.SkillTargetRevision
			},
			ContentValidation = {
				State = self.ContentValidationState,
				IsReady = self.ContentValidationState == "VALID",
				Reason = self.ContentValidationReason,
				ErrorCount = self.ContentValidationErrorCount,
				ErrorSnapshot = self.ContentValidationErrorSnapshot,
				Revision = self.ContentValidationRevision
			},
			Job = {
				JobId = self.SelectedJobId,
				MechanicId = self.SelectedJobMechanicId,
				PassiveSetId = self.SelectedJobPassiveSetId,
				StartingSkillIds = self.SelectedJobStartingSkillIds,
				BaseMaxHp = self.SelectedJobBaseMaxHp,
				BaseQueueCapacity = self.SelectedJobBaseQueueCapacity,
				Revision = self.SelectedJobRevision
			},
			JobMechanic = {
				LastMechanicId = self.LastJobMechanicId,
				LastSuccess = self.LastJobMechanicSuccess,
				LastReason = self.LastJobMechanicReason,
				Revision = self.JobMechanicRevision
			},
			RunAugments = {
				OwnedSnapshot = ownedAugmentSnapshot,
				LastTriggerType = self.LastAugmentTriggerType,
				LastTriggerReason = self.LastAugmentTriggerReason,
				LastExecutedCount = self.LastAugmentExecutedCount,
				RuntimeRevision = self.AugmentRuntimeRevision,
				Revision = runAugmentRevision
			},
			PlayerQueue = {
				BaseCapacity = turnState.BaseQueueCapacity,
				BonusCapacity = turnState.QueueCapacityBonus,
				EffectiveCapacity = effectiveCapacity,
				MinCapacity = turnState.QueueCapacityMin,
				MaxCapacity = turnState.QueueCapacityMax,
				Count = queueCount,
				RemainingSlots = math.max(0, effectiveCapacity - queueCount),
				IsFull = queueCount >= effectiveCapacity,
				IsOverCapacity = queueCount > effectiveCapacity,
				QueuedTileIds = turnState.QueuedTileIds,
				Items = queuedItems,
				ExecutingTileIds = turnState.ExecutingTileIds,
				ExecutingIndex = turnState.ExecutingTileIndex,
				ModifierSnapshot = turnState.QueueCapacityModifierSnapshot,
				QueueOrderRevision = turnState.QueueOrderRevision,
				ReorderReceipt = {
					Revision = self.QueueReorderReceiptRevision,
					RequestId = self.QueueLastRequestId,
					Success = self.QueueLastRequestSuccess,
					Reason = self.QueueLastRequestReason,
					SourceIndex = self.QueueLastSourceIndex,
					TargetIndex = self.QueueLastTargetIndex,
					QueueOrderRevision = self.QueueLastOrderRevision
				},
				Revision = turnState.QueueCapacityRevision
			},
			EnemyIntentMode = "PER_ENEMY_RANGE_AWARE_QUEUE_V2",
			EnemyPlanRevision = self.EnemyPlanRevision,
			EnemyPlanCount = self.EnemyPlanCount,
			EnemyIntents = enemyIntents,
			CooldownSnapshot = cooldownSnapshot,
			CooldownRevision = cooldownRevision,
			RunInventory = {
				CurrencySnapshot = runCurrencySnapshot,
				ConsumableSnapshot = runConsumableSnapshot,
				SkillSnapshot = runSkillSnapshot,
				ConsumableCapacity = runConsumableCapacity,
				SkillRevision = runSkillInventoryRevision,
				Revision = runInventoryRevision
			},
			Drops = {
				PendingSnapshot = pendingDropSnapshot,
				PendingCount = pendingDropCount,
				Revision = dropRevision
			},
			Wave = {
				Current = waveState.CurrentWave,
				Total = waveState.TotalWaves,
				State = waveState.WaveState,
				ForceSpawnPending = waveState.ForceSpawnPending,
				ForceSpawnPendingReason = waveState.ForceSpawnPendingReason
			}
		}
	end

	@ExecSpace("ClientOnly")
	method string ResolvePlayerActionState(any turnState)
		-- Derives presentation state from the existing authoritative turn state; it owns no rules or transitions.
		if self.BattleResult ~= "" or self.ContentValidationState ~= "VALID" then
			return "LOCKED"
		end
		if turnState == nil or turnState.BattlePhase ~= "PlayerTurn" then
			return "WAITING_ENEMY_TURN"
		end
		if turnState.IsActionProcessing == true then
			if turnState.QueuedActionType == "MOVE" then
				return "MOVING"
			end
			if turnState.QueuedActionType == "TURN" then
				return "TURNING"
			end
			if turnState.ExecutingTileIds ~= "" then
				return "EXECUTING_ATTACK"
			end
			return "LOCKED"
		end
		if turnState.QueuedTileCount > 0 then
			return "PREPARING_ATTACK"
		end
		return "READY"
	end

	@ExecSpace("Server")
	method void RequestUseConsumable(string consumableId, integer requestId, string targetSkillId, integer entryId, integer inventoryRevision)
		-- Authenticates a client request before entering the server-only consumable workflow.
		if isvalid(self.PlayerEntity) == false or self.PlayerEntity.PlayerComponent == nil then
			log_warning("[BattleConsumable] rejected reason=PLAYER_MISSING")
			return
		end
		if self.PlayerEntity.PlayerComponent.UserId ~= senderUserId then
			log_warning("[BattleConsumable] rejected reason=INVALID_SENDER")
			return
		end
		local result = self:TryUseRunConsumable(self.PlayerEntity, consumableId, requestId, targetSkillId, entryId, inventoryRevision)
		result.RequestId = requestId
		self:ReceiveConsumableUseResult(result, entryId, self.PlayerEntity.PlayerComponent.UserId)
		log("[BattleConsumable] request id=" .. tostring(requestId) .. " ref=" .. consumableId .. " success=" .. tostring(result.Success) .. " reason=" .. result.Reason)
	end

	@ExecSpace("ServerOnly")
	method table TryUseRunConsumable(Entity playerEntity, string consumableId, integer requestId, string targetSkillId, integer entryId, integer inventoryRevision)
		-- Validates timing and inventory, executes the registered effect, then commits consumption exactly once.
		local result = { Success = false, Reason = "UNKNOWN", ConsumableId = consumableId or "", AppliedAmount = 0, ConsumedAmount = 0, ConsumesTurn = false }
		if isvalid(playerEntity) == false or playerEntity ~= self.PlayerEntity or playerEntity.CurrentMap ~= self.Entity or entryId ~= self.EntryRequestId then
			result.Reason = "INVALID_PLAYER"
			return result
		end
		if requestId <= 0 then
			result.Reason = "INVALID_REQUEST_ID"
			return result
		end
		if self.ContentValidationState ~= "VALID" or self.BattleResult ~= "" or self.TurnState == nil or self.TurnState.BattlePhase ~= "PlayerTurn" or self.TurnState.IsActionProcessing == true then
			result.Reason = "INVALID_CONSUMABLE_TIMING"
			return result
		end

		local definition = _ConsumableDefinitionRepositoryLogic:GetDefinition(consumableId)
		if definition.Success == false then
			result.Reason = definition.Reason
			result.DetailReason = definition.DetailReason or ""
			return result
		end
		if definition.TargetType ~= "SELF" and definition.TargetType ~= "OWNED_SKILL" then
			result.Reason = "UNSUPPORTED_CONSUMABLE_TARGET"
			return result
		end

		local runState = _RunManagerLogic:GetOrCreateRunState(playerEntity)
		if runState == nil then
			result.Reason = "RUN_STATE_UNAVAILABLE"
			return result
		end
		local useKey = tostring(runState.RunSequence) .. ":" .. self.StageId .. ":" .. tostring(self.EntryRequestId) .. ":consumable:" .. tostring(inventoryRevision) .. ":" .. tostring(requestId)
		local availability = _RunManagerLogic:CanUseRunConsumable(playerEntity, consumableId, useKey)
		if availability.Success == false then
			result.Reason = availability.Reason
			return result
		end
		if availability.AlreadyApplied == true then
			result.Success = true
			result.Reason = "DUPLICATE_USE_IGNORED"
			return result
		end
		local inventory = playerEntity:GetComponent("script.PlayerRunInventoryComponent")
		if inventory == nil or inventory.InventoryRevision ~= inventoryRevision then
			result.Reason = "STALE_INVENTORY"
			return result
		end

		local targetEntity = self:FindUnitEntity("player_01")
		if isvalid(targetEntity) == false then
			result.Reason = "TARGET_NOT_FOUND"
			return result
		end
		local targetUnit = targetEntity:GetComponent("script.BattleUnitComponent")
		local effectResult = _ConsumableEffectRouterLogic:Execute(definition, targetUnit, targetSkillId)
		if effectResult.Success == false then
			result.Reason = effectResult.Reason
			return result
		end

		local consumeResult = _RunManagerLogic:ConsumeRunConsumable(playerEntity, consumableId, useKey)
		if consumeResult.Success == false then
			log_error("[BattleConsumable] commit failed after effect key=" .. useKey .. " reason=" .. consumeResult.Reason)
			result.Reason = "CONSUMABLE_COMMIT_FAILED"
			return result
		end
		result.Success = true
		result.Reason = "CONSUMABLE_USED"
		result.AppliedAmount = effectResult.AppliedAmount or 0
		result.HpBefore = effectResult.HpBefore or -1
		result.HpAfter = effectResult.HpAfter or -1
		result.ConsumedAmount = consumeResult.ConsumedAmount or 0
		result.ConsumesTurn = false
		result.InventoryRevision = inventory.InventoryRevision
		result.TargetSkillId = targetSkillId or ""
		result.CooldownBefore = effectResult.CooldownBefore or 0
		result.CooldownAfter = effectResult.CooldownAfter or 0
		log("[BattleConsumable] used ref=" .. consumableId .. " effect=" .. definition.EffectType .. " applied=" .. result.AppliedAmount .. " hp=" .. result.HpBefore .. "->" .. result.HpAfter .. " consumesTurn=" .. tostring(result.ConsumesTurn) .. " key=" .. useKey)
		return result
	end

	@ExecSpace("ClientOnly")
	method boolean SubmitConsumableUse(string consumableId, string targetSkillId)
		-- Shares the hotkey/HUD request counter and waits for the authoritative receipt.
		local player = _UserService.LocalPlayer
		if not isvalid(player) or player.CurrentMap ~= self.Entity then return false end
		local inventory = player:GetComponent("script.PlayerRunInventoryComponent")
		if inventory == nil then return false end
		if self._T.ConsumablePending and self._T.ConsumablePendingEntry == self.EntryRequestId and self._T.ConsumablePendingRun == inventory.ActiveRunSequence then return false end
		if self.ContentValidationState ~= "VALID" or self.BattleResult ~= "" or self.BattlePhase ~= "PlayerTurn" or self.IsActionProcessing then return false end
		self.ConsumableRequestSequence = self.ConsumableRequestSequence + 1
		self._T.ConsumablePending = true
		self._T.ConsumablePendingEntry = self.EntryRequestId
		self._T.ConsumablePendingRun = inventory.ActiveRunSequence
		self:RequestUseConsumable(consumableId, self.ConsumableRequestSequence, targetSkillId, self.EntryRequestId, inventory.InventoryRevision)
		return true
	end

	@ExecSpace("Client")
	method void ReceiveConsumableUseResult(table result, integer entryId)
		-- Receipts stay on the battle component; UI entities never host a server RPC.
		if entryId ~= self.EntryRequestId or result.RequestId ~= self.ConsumableRequestSequence then return end
		self._T.ConsumablePending = false
		self._T.ConsumableUseResult = result
		self._T.ConsumableReceiptRevision = (self._T.ConsumableReceiptRevision or 0) + 1
	end

	@ExecSpace("Server")
	method void RequestConsumableHudState(integer queryId, integer entryId)
		-- Sends a small owner-only read model because the authored dataset is server-only.
		if not isvalid(self.PlayerEntity) or self.PlayerEntity.PlayerComponent == nil then return end
		if senderUserId ~= self.PlayerEntity.PlayerComponent.UserId then return end
		if self.PlayerEntity.CurrentMap ~= self.Entity or entryId ~= self.EntryRequestId then return end
		self:ReceiveConsumableHudState(self:BuildConsumableHudState(), queryId, entryId, senderUserId)
	end

	@ExecSpace("Client")
	method void ReceiveConsumableHudState(table data, integer queryId, integer entryId)
		-- Ignores delayed responses from an older battle or older query.
		if entryId ~= self.EntryRequestId or queryId < (self._T.ConsumableHudQuery or 0) then return end
		self._T.ConsumableHudQuery = queryId
		self._T.ConsumableHudState = data
	end

	@ExecSpace("ServerOnly")
	method table BuildConsumableHudState()
		-- Reuses run inventory and cooldown owners without creating client-authoritative state.
		local result = { Success = false, Items = {}, Skills = {}, Capacity = 0, CanUse = false, EntryId = self.EntryRequestId }
		if not isvalid(self.PlayerEntity) then return result end
		local inventory = self.PlayerEntity:GetComponent("script.PlayerRunInventoryComponent")
		local runtime = self.PlayerEntity:GetComponent("script.SkillRuntimeStateComponent")
		local unit = self.PlayerEntity:GetComponent("script.BattleUnitComponent")
		if inventory == nil or runtime == nil or unit == nil then return result end
		inventory:NormalizeLegacyConsumables()
		result.Success = true
		result.Capacity = inventory.ConsumableCapacity
		result.CooldownRevision = runtime.CooldownRevision
		result.CurrentHp = unit.CurrentHp
		result.MaxHp = unit.MaxHp
		result.InventoryRevision = inventory.InventoryRevision
		result.RunSequence = inventory.ActiveRunSequence
		result.CanUse = inventory.ActiveRunSequence > 0 and not unit.IsDead and self.ContentValidationState == "VALID" and self.BattleResult == "" and self.TurnState ~= nil and self.TurnState.BattlePhase == "PlayerTurn" and not self.TurnState.IsActionProcessing
		for _, skillId in ipairs(inventory:GetDistinctOwnedSkillIds()) do
			local cooldown = runtime:GetRemainingCooldown(skillId)
			if cooldown > 0 then
				local definition = _SkillDefinitionRepositoryLogic:GetSkillDefinition(skillId)
				table.insert(result.Skills, { SkillId = skillId, DisplayName = definition.DisplayName or skillId, Cooldown = cooldown })
			end
		end
		for itemId, count in string.gmatch(inventory.RunConsumableSnapshot or "", "([^|~]+)~(%d+)") do
			local definition = _ConsumableDefinitionRepositoryLogic:GetDefinition(itemId)
			if tonumber(count) > 0 and definition.Success then
				local usable = result.CanUse
				local reason = ""
				if definition.EffectType == "HEAL" and unit.CurrentHp >= unit.MaxHp then usable = false; reason = "HP_ALREADY_FULL" end
				if definition.EffectType == "COOLDOWN_REDUCTION" and #result.Skills == 0 then usable = false; reason = "NO_COOLDOWN_SKILLS" end
				-- No status system exists yet; keep the future cleanse item visible but unavailable.
				if definition.EffectType == "CLEANSE" then usable = false; reason = "NO_NEGATIVE_STATUS_EFFECTS" end
				table.insert(result.Items, { ConsumableId = itemId, DisplayOrder = definition.RowIndex, DisplayName = definition.DisplayName, Count = tonumber(count), EffectType = definition.EffectType, EffectValue = definition.EffectValue, IconKey = definition.IconKey, Description = definition.Description, Usable = usable, Reason = reason })
			end
		end
		table.sort(result.Items, function(left, right) return left.DisplayOrder < right.DisplayOrder end)
		return result
	end

	@ExecSpace("ServerOnly")
	method table GetBattleSnapshot()
		-- Stable read model for server-side lobby, waiting, result, and flow controllers.
		local turnState = self:EnsureTurnStateComponent()
		local waveRuntime = self:EnsureWaveStateComponent()
		local dropRuntime = self:EnsureDropStateComponent()
		local ownedSkillSnapshot = ""
		local skillInventoryRevision = 0
		local ownedAugmentSnapshot = ""
		local augmentRevision = 0
		if isvalid(self.PlayerEntity) then
			local inventory = self.PlayerEntity:GetComponent("script.PlayerRunInventoryComponent")
			if inventory ~= nil then
				ownedSkillSnapshot = inventory.RunSkillSnapshot
				skillInventoryRevision = inventory.SkillInventoryRevision
			end
			local augmentState = self.PlayerEntity:GetComponent("script.PlayerRunAugmentComponent")
			if augmentState ~= nil then
				ownedAugmentSnapshot = augmentState.OwnedAugmentSnapshot
				augmentRevision = augmentState.AugmentRevision
			end
		end
		return {
			Success = true,
			Reason = "OK",
			EntryRequestId = self.EntryRequestId,
			EntryMode = self.EntryMode,
			StageId = self.StageId,
			RegionId = self.RegionId,
			StageIndex = self.StageIndex,
			StageType = self.StageType,
			StageDisplayName = self.StageDisplayName,
			WaveTableId = self.WaveTableId,
			StageRuleId = self.StageRuleId,
			StageSchemaVersion = self.StageSchemaVersion,
			StageNumber = self.StageNumber,
			RunSeed = self.RunSeed,
			CharacterId = self.SelectedCharacterId,
			JobId = self.SelectedJobId,
			JobMechanicId = self.SelectedJobMechanicId,
			JobPassiveSetId = self.SelectedJobPassiveSetId,
			JobStartingSkillIds = self.SelectedJobStartingSkillIds,
			JobBaseMaxHp = self.SelectedJobBaseMaxHp,
			JobBaseQueueCapacity = self.SelectedJobBaseQueueCapacity,
			JobRevision = self.SelectedJobRevision,
			OwnedSkillSnapshot = ownedSkillSnapshot,
			SkillInventoryRevision = skillInventoryRevision,
			OwnedAugmentSnapshot = ownedAugmentSnapshot,
			AugmentRevision = augmentRevision,
			LastAugmentTriggerType = self.LastAugmentTriggerType,
			LastAugmentTriggerReason = self.LastAugmentTriggerReason,
			LastAugmentExecutedCount = self.LastAugmentExecutedCount,
			LoadoutId = self.SelectedLoadoutId,
			BattlePhase = turnState.BattlePhase,
			BattleResult = self.BattleResult,
			TurnNumber = turnState.TurnNumber,
			CurrentWave = waveRuntime.CurrentWave,
			TotalWaves = waveRuntime.TotalWaves,
			CellCount = self.CellCount,
			PlayerStartCell = self.PlayerStartCell,
			QueueCapacity = turnState.TileQueueCapacity,
			PendingDropSnapshot = dropRuntime.PendingDropSnapshot,
			PendingDropCount = dropRuntime.PendingDropCount,
			DropRevision = dropRuntime.DropRevision
		}
	end

	@ExecSpace("ServerOnly")
	method table RebuildBattleState(string reason)
		-- Clears transient battle state, then rebuilds the selected Stage through the normal spawn path.
		local result = {
			Success = false,
			Reason = "UNKNOWN"
		}
		local contentValidation = self:RunContentValidationGate("REBUILD_" .. reason)
		if contentValidation.Success == false then
			result.Reason = "CONTENT_VALIDATION_BLOCKED"
			result.DetailReason = contentValidation.Reason
			result.ErrorCount = contentValidation.ErrorCount
			result.ErrorSnapshot = contentValidation.ErrorSnapshot
			return result
		end

		-- Presentation generation invalidates cached HUD references even when StageId and UnitId repeat.
		self.HudContextRevision = self.HudContextRevision + 1
		self:CancelPlayerCombatPresentationHandoff("REBUILD_" .. reason, true)
		self:FinishPlayerGridMovePresentation("REBUILD_" .. reason)
		self:FinishEnemyGridMovePresentation("REBUILD_" .. reason, false)
		if self.ActionTimerId > 0 then
			_TimerService:ClearTimer(self.ActionTimerId)
			self.ActionTimerId = 0
		end
		self:ClearTurnTransitionTimer("REBUILD_" .. reason)
		self.PlayerToEnemyBeatPending = false
		self.PendingPlayerToEnemyHandoffDelay = -1
		self:ClearEnemyToEnemyPresentationHandoff("REBUILD_" .. reason)
		self:ClearSkillImpactTimers()
		self.WaveRuntime:ClearAllTimers(reason)

		local queuedBeforeReset = self.TurnState.QueuedTileIds
		self.BattleResult = ""
		self:ResetUnionRewardPresentation("REBUILD_" .. reason)
		self.PlayerExitObservedAfterBattle = false
		self.StageTurnNumber = 0
		self.TurnState:ResetTurnState(self.TileQueueCapacity, reason)
		self:PublishTurnStateSnapshot(reason)
		log("[BattleQueueBoundary] boundary=" .. reason .. " policy=CLEAR before=" .. queuedBeforeReset .. " after=" .. self.TurnState.QueuedTileIds)
		self.LastEnemySpawnOrder = 0
		self:ClearPreparedEnemyIntent(reason)

		local playerEntity = self:FindUnitEntity("player_01")
		if isvalid(playerEntity) == false then
			result.Reason = "PLAYER_MISSING"
			return result
		end
		self:CleanupRegisteredEnemies(reason)
		self.PlayerEntity = playerEntity
		local runState = _RunManagerLogic:EnsureRunState(playerEntity, self.RunSeed)
		local playerMaxHp = self.SelectedJobBaseMaxHp
		if playerMaxHp <= 0 then
			playerMaxHp = 100
		end
		self:ConfigureUnit(playerEntity, "player_01", "Player", self.PlayerStartCell, "Right", playerMaxHp, 1)
		self:RestorePlayerRunHp(playerEntity, runState, "BATTLE_REBUILD_" .. reason)
		self:RefreshPlayerHpSnapshot("BATTLE_REBUILD_" .. reason)
		self:StartStageById(self.StageId)

		result.Success = true
		result.Reason = reason
		log("[BattleReset] completed reason=" .. reason .. " seed=" .. self.RunSeed .. " stage=" .. self.StageNumber .. " wave=" .. self.CurrentWave .. "/" .. self.TotalWaves .. " playerCell=" .. self.PlayerStartCell .. " enemyHp=" .. self.CurrentEnemyMaxHp)
		return result
	end

	@ExecSpace("ServerOnly")
	method table ResolvePushImpact(string sourceUnitId)
		-- Re-resolves the front target and moves it one logical cell away from the source.
		local result = {
			Success = false,
			Hit = false,
			Reason = "UNKNOWN",
			SourceUnitId = sourceUnitId,
			TargetUnitId = "",
			TargetCell = -1,
			FromCell = -1,
			ToCell = -1
		}

		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		if isvalid(sourceEntity) == false then
			result.Reason = "SOURCE_NOT_FOUND"
			return result
		end
		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit == nil then
			result.Reason = "SOURCE_COMPONENT_MISSING"
			return result
		end
		if self:IsTeamTurn(sourceUnit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end
		if sourceUnit.IsDead == true then
			result.Reason = "SOURCE_DEAD"
			return result
		end

		local direction = -1
		if sourceUnit.Facing == "Right" then
			direction = 1
		end
		result.TargetCell = sourceUnit.CellIndex + direction
		local targetEntity = self:ResolveFrontTarget(sourceUnitId)
		if isvalid(targetEntity) == false then
			result.Success = true
			result.Reason = self:IsValidCell(result.TargetCell) and "MISS_EMPTY" or "MISS_OUT_OF_BOUNDS"
			log("[BattlePush] resolved source=" .. sourceUnitId .. " target= cell=" .. result.TargetCell .. " reason=" .. result.Reason)
			return result
		end

		local targetUnit = targetEntity:GetComponent("script.BattleUnitComponent")
		result.Hit = true
		result.TargetUnitId = targetUnit.UnitId
		result.FromCell = targetUnit.CellIndex
		result.ToCell = targetUnit.CellIndex + direction
		if targetUnit.Team == "Enemy" and _EnemyTraitRouterLogic:BlocksForcedDisplacement(targetUnit.EnemyTraitIds) then
			result.Success = true
			result.ToCell = result.FromCell
			result.Reason = "PUSH_BLOCKED_HEAVY_TRAIT"
			log("[EnemyTrait] HEAVY blocked push target=" .. result.TargetUnitId .. " cell=" .. result.FromCell)
			return result
		end
		if self:IsValidCell(result.ToCell) == false then
			result.Success = true
			result.Reason = "PUSH_BLOCKED_OUT_OF_BOUNDS"
			log("[BattlePush] resolved source=" .. sourceUnitId .. " target=" .. result.TargetUnitId .. " from=" .. result.FromCell .. " to=" .. result.ToCell .. " reason=" .. result.Reason)
			return result
		end
		if self:IsCellOccupied(result.ToCell, targetUnit.UnitId) then
			result.Success = true
			result.Reason = "PUSH_BLOCKED_OCCUPIED"
			log("[BattlePush] resolved source=" .. sourceUnitId .. " target=" .. result.TargetUnitId .. " from=" .. result.FromCell .. " to=" .. result.ToCell .. " reason=" .. result.Reason)
			return result
		end

		local cellChange = targetUnit:ApplyCellChange(result.ToCell)
		if cellChange.Success == false then
			result.Success = false
			result.Reason = cellChange.Reason
			return result
		end
		self:PlaceEntity(targetEntity, self:GetCellPosition(result.ToCell))
		local movedEvent = UnitMovedEvent()
		movedEvent.UnitId = targetUnit.UnitId
		movedEvent.FromCell = result.FromCell
		movedEvent.ToCell = result.ToCell
		self.Entity:SendEvent(movedEvent)

		result.Success = true
		result.Reason = "PUSHED"
		log("[BattlePush] resolved source=" .. sourceUnitId .. " target=" .. result.TargetUnitId .. " from=" .. result.FromCell .. " to=" .. result.ToCell .. " reason=" .. result.Reason)
		return result
	end

	@ExecSpace("ServerOnly")
	method table ResolvePushImpactOnTarget(string sourceUnitId, string targetUnitId)
		-- Applies the existing one-cell push rule to a target already selected by SkillTargetResolverLogic.
		local result = { Success = false, Hit = false, Reason = "UNKNOWN", SourceUnitId = sourceUnitId, TargetUnitId = targetUnitId, TargetCell = -1, FromCell = -1, ToCell = -1 }
		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		local targetEntity = self:FindUnitEntity(targetUnitId)
		if isvalid(sourceEntity) == false then
			result.Reason = "SOURCE_NOT_FOUND"
			return result
		end
		if isvalid(targetEntity) == false then
			result.Reason = "TARGET_NOT_FOUND"
			return result
		end
		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		local targetUnit = targetEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit == nil or targetUnit == nil then
			result.Reason = "UNIT_COMPONENT_MISSING"
			return result
		end
		if self:IsTeamTurn(sourceUnit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end
		if sourceUnit.IsDead == true or targetUnit.IsDead == true then
			result.Reason = "UNIT_DEAD"
			return result
		end
		if sourceUnit.Team == targetUnit.Team then
			result.Reason = "TARGET_SAME_TEAM"
			return result
		end

		local direction = sourceUnit.Facing == "Right" and 1 or -1
		result.Hit = true
		result.TargetCell = targetUnit.CellIndex
		result.FromCell = targetUnit.CellIndex
		result.ToCell = targetUnit.CellIndex + direction
		-- The impact lands even when displacement is later blocked, so present the hit before those branches.
		self:PlayActiveHitEffect(targetUnitId)
		if targetUnit.Team == "Enemy" and _EnemyTraitRouterLogic:BlocksForcedDisplacement(targetUnit.EnemyTraitIds) then
			result.Success = true
			result.ToCell = result.FromCell
			result.Reason = "PUSH_BLOCKED_HEAVY_TRAIT"
			log("[EnemyTrait] HEAVY blocked push target=" .. targetUnitId .. " cell=" .. result.FromCell)
			return result
		end
		if self:IsValidCell(result.ToCell) == false then
			result.Success = true
			result.Reason = "PUSH_BLOCKED_OUT_OF_BOUNDS"
			return result
		end
		if self:IsCellOccupied(result.ToCell, targetUnitId) then
			result.Success = true
			result.Reason = "PUSH_BLOCKED_OCCUPIED"
			return result
		end

		local cellChange = targetUnit:ApplyCellChange(result.ToCell)
		if cellChange.Success == false then
			result.Reason = cellChange.Reason
			return result
		end
		self:PlaceEntity(targetEntity, self:GetCellPosition(result.ToCell))
		local movedEvent = UnitMovedEvent()
		movedEvent.UnitId = targetUnit.UnitId
		movedEvent.FromCell = result.FromCell
		movedEvent.ToCell = result.ToCell
		self.Entity:SendEvent(movedEvent)
		result.Success = true
		result.Reason = "PUSHED"
		log("[BattlePushTarget] resolved source=" .. sourceUnitId .. " target=" .. targetUnitId .. " from=" .. result.FromCell .. " to=" .. result.ToCell .. " reason=" .. result.Reason)
		return result
	end

	@ExecSpace("ServerOnly")
	method table TryExecuteSkill(string sourceUnitId, string skillId)
		local validation = _ContentValidatorLogic:ValidateSkillById(skillId)
		if validation.Success == false then
			return {
				Success = false,
				Reason = validation.Reason,
				DetailReason = validation.DetailReason or "",
				SourceUnitId = sourceUnitId,
				SkillId = skillId
			}
		end

		local bundle = validation.Data
		local definition = bundle.Definition
		local effectSteps = bundle.EffectSteps
		local contextResult = _SkillExecutionLogic:BuildContext(self, sourceUnitId, skillId, definition)
		if contextResult.Success == false then
			return contextResult
		end

		-- A living enemy's attack attempt animates even when use checks or target resolution fail.
		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		local isEnemyAttack = sourceUnit.Team == "Enemy"
		if isEnemyAttack then
			self:PlayEnemyAttackMotion(sourceEntity, sourceUnitId, definition)
			log("[EnemyAttackMotion] attempt unit=" .. sourceUnitId .. " skill=" .. skillId)
		end

		local runtimeState = self:GetSkillRuntimeState(sourceUnitId)
		if runtimeState == nil then
			return {
				Success = false,
				Reason = "SKILL_RUNTIME_STATE_MISSING",
				SourceUnitId = sourceUnitId,
				SkillId = skillId
			}
		end
		local cooldownResult = runtimeState:CanUseSkill(skillId)
		if cooldownResult.Success == false then
			return {
				Success = false,
				Reason = cooldownResult.Reason,
				RemainingTurns = cooldownResult.RemainingTurns,
				SourceUnitId = sourceUnitId,
				SkillId = skillId
			}
		end
		runtimeState:StartCooldown(skillId, definition.CooldownTurns)

		-- Swap the avatar weapon before the motion starts so the swing shows the skill's own weapon.
		self:ApplySkillWeapon(sourceUnitId, sourceEntity, definition)
		local motionProfile = self:GetSkillMotionProfile(definition.MotionProfileId)
		local sourcePresentation = sourceEntity:GetComponent("script.BattleUnitPresentationComponent")
		if sourcePresentation ~= nil and isEnemyAttack == false then
			if sourceEntity.PlayerControllerComponent ~= nil then
				sourcePresentation:PlayCombatMotion(
					sourceUnitId,
					motionProfile.MotionKey,
					motionProfile.ActionName,
					motionProfile.PlayRate,
					motionProfile.Duration,
					false
				)
			else
				self:PlayEnemyAttackMotion(sourceEntity, sourceUnitId, definition)
			end
		end
		self:BeginSkillEffectPresentation(sourceUnitId, definition)

		local context = contextResult.Data
		local safeImpactDelay = math.max(0, motionProfile.ImpactDelay)
		local resolveEffects = function()
			self.ImpactTimerId = 0
			local effectResult = _SkillExecutionLogic:ExecuteEffectSteps(context, effectSteps)
			if effectResult.Success == false then
				log_warning("[SkillExecution] failed skill=" .. skillId .. " source=" .. sourceUnitId .. " reason=" .. effectResult.Reason)
			end
		end

		self:ClearSkillImpactTimers()
		-- A projectile skill splits the impact in two: the shot leaves at its launch delay, and the
		-- effects resolve only once it has crossed the board to the target cell.
		local launchDelay = safeImpactDelay
		local flightSeconds = 0
		local totalImpactDelay = safeImpactDelay
		if self:HasSkillProjectile(definition) then
			launchDelay = self:GetProjectileLaunchDelay(definition)
			flightSeconds = self:LaunchSkillProjectile(sourceUnitId, definition, launchDelay)
			if flightSeconds > 0 then
				totalImpactDelay = launchDelay + flightSeconds
			end
		end
		if totalImpactDelay <= 0 then
			local immediateResult = _SkillExecutionLogic:ExecuteEffectSteps(context, effectSteps)
			if immediateResult ~= nil then
				immediateResult.PresentationHandoffDuration = 0.01
			end
			return immediateResult
		end

		self.ImpactTimerId = _TimerService:SetTimerOnce(resolveEffects, totalImpactDelay)
		log("[SkillExecution] scheduled skill=" .. skillId .. " source=" .. sourceUnitId .. " steps=" .. #effectSteps .. " delay=" .. launchDelay .. " flight=" .. flightSeconds)
		return {
			Success = true,
			Reason = "IMPACT_PENDING",
			SourceUnitId = sourceUnitId,
			SkillId = skillId,
			StepCount = #effectSteps,
			-- Wait for damage resolution; the existing completion gate waits for actual playback.
			PresentationHandoffDuration = totalImpactDelay
		}
	end

	@ExecSpace("ServerOnly")
	method void ApplySkillWeapon(string sourceUnitId, Entity sourceEntity, table definition)
		-- Presentation-only hop into the weapon catalog. Never gates execution: a data or costume
		-- problem downgrades to a log line and the skill still resolves.
		if isvalid(sourceEntity) == false then
			return
		end
		local weaponResult = _SkillWeaponEquipLogic:ApplyWeaponForSkill(sourceEntity, definition)
		if weaponResult.Success == false then
			log_warning("[SkillWeapon] skill=" .. (definition.SkillId or "") .. " unit=" .. sourceUnitId .. " reason=" .. weaponResult.Reason)
		end
	end

	@ExecSpace("ServerOnly")
	method void ClearSkillImpactTimers()
		-- One battle action resolves at a time, so a new cast always supersedes any pending impact.
		if self.ImpactTimerId > 0 then
			_TimerService:ClearTimer(self.ImpactTimerId)
			self.ImpactTimerId = 0
		end
		-- A volley schedules one timer per shot, so every pending launch has to be dropped — not just
		-- the most recent one, or the superseded cast keeps firing arrows into the next action.
		local pendingShots = self._T.projectileTimerIds
		if pendingShots ~= nil then
			for _, timerId in ipairs(pendingShots) do
				if timerId > 0 then
					_TimerService:ClearTimer(timerId)
				end
			end
		end
		self._T.projectileTimerIds = {}
	end

	method number GetProjectileLaunchDelay(table definition)
		-- The shot leaves with the cast effect by default, so a ranged skill reads as "fire on cast"
		-- rather than waiting for a melee swing's impact frame. ProjectileLaunchDelay only holds it
		-- back, and is scaled like every other duration so it tracks the battle speed multiplier.
		if definition == nil then
			return 0
		end
		local authored = definition.ProjectileLaunchDelay or 0
		if authored <= 0 then
			return 0
		end
		return authored / self:GetSkillSpeedMultiplier()
	end

	method boolean HasSkillProjectile(table definition)
		-- Both columns are required together; the Validator rejects a RUID with no speed, and this
		-- guard keeps a half-authored row from stalling the impact instead of just skipping the visual.
		if definition == nil then
			return false
		end
		local ruid = definition.ProjectileRuid or ""
		local speed = definition.ProjectileSpeed or 0
		return ruid ~= "" and speed > 0
	end

	@ExecSpace("ServerOnly")
	method number GetProjectileAimCell(string sourceUnitId, table definition)
		-- The Target Resolver owns every targeting rule, so the aim point is read from its cell list
		-- rather than re-derived here. Its last entry is the farthest cell the skill reaches: the
		-- blocking enemy for FIRST_ENEMY_FORWARD, the outermost offset for RANGE_OFFSETS.
		local resolved = _SkillTargetResolverLogic:Resolve(self, sourceUnitId, definition)
		if resolved.Success == false then
			return -1
		end
		local cells = resolved.TargetCellIndices
		if cells == nil or #cells == 0 then
			return -1
		end
		return cells[#cells]
	end

	@ExecSpace("ServerOnly")
	method number LaunchSkillProjectile(string sourceUnitId, table definition, number launchDelay)
		-- Schedules the shot for the motion's release frame and returns how long it will be in flight,
		-- so the caller can delay the impact by exactly that much. Returns 0 for every non-projectile
		-- skill, which leaves the original single-timer impact path untouched.
		if self:HasSkillProjectile(definition) == false then
			return 0
		end

		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		if isvalid(sourceEntity) == false then
			log_warning("[SkillProjectile] skipped skill=" .. (definition.SkillId or "") .. " reason=SOURCE_NOT_FOUND")
			return 0
		end
		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit == nil then
			log_warning("[SkillProjectile] skipped skill=" .. (definition.SkillId or "") .. " reason=SOURCE_COMPONENT_MISSING")
			return 0
		end

		local aimCell = self:GetProjectileAimCell(sourceUnitId, definition)
		if aimCell < 0 then
			log_warning("[SkillProjectile] skipped skill=" .. (definition.SkillId or "") .. " reason=NO_AIM_CELL")
			return 0
		end

		-- Cell positions sit at the unit's own origin, so a shot fired straight from them skims the
		-- floor. ProjectileHeight lifts the whole flight line to roughly where the weapon is held;
		-- both ends move together, so the distance and therefore the flight time are unchanged.
		local launchHeight = definition.ProjectileHeight or 0
		local sourceCell = self:GetCellPosition(sourceUnit.CellIndex)
		local aimCellPosition = self:GetCellPosition(aimCell)
		local startPosition = Vector2(sourceCell.x, sourceCell.y + launchHeight)
		local targetPosition = Vector2(aimCellPosition.x, aimCellPosition.y + launchHeight)
		local speed = definition.ProjectileSpeed * self:GetSkillSpeedMultiplier()
		local distance = math.abs(targetPosition.x - startPosition.x)
		if distance <= 0 or speed <= 0 then
			return 0
		end

		local skillId = definition.SkillId or ""
		local projectileRuid = definition.ProjectileRuid
		local projectileScale = definition.ProjectileScale or 1
		local flipX = sourceUnit.Facing == "Right"

		-- A volley sends the same shot down the same path several times, spaced out in time. The gap is
		-- scaled like every other authored duration so the stream tightens with the battle speed.
		local shotCount = math.max(1, definition.ProjectileCount or 1)
		local interval = math.max(0, definition.ProjectileInterval or 0) / self:GetSkillSpeedMultiplier()

		self._T.projectileTimerIds = {}
		for shotIndex = 0, shotCount - 1 do
			self.ProjectileSpawnCount = self.ProjectileSpawnCount + 1
			local projectileName = "SkillProjectile_" .. tostring(self.ProjectileSpawnCount)
			local shotDelay = launchDelay + interval * shotIndex
			local spawnProjectile = function()
				self:SpawnSkillProjectile(skillId, projectileName, startPosition, targetPosition, speed, projectileRuid, projectileScale, flipX)
			end
			if shotDelay <= 0 then
				spawnProjectile()
			else
				table.insert(self._T.projectileTimerIds, _TimerService:SetTimerOnce(spawnProjectile, shotDelay))
			end
		end

		-- The impact waits for the *last* arrow, so the damage never lands while shots are still in the
		-- air. A single shot reduces to the original "flight time" answer.
		local flightSeconds = distance / speed
		local lastArrival = interval * (shotCount - 1) + flightSeconds
		log("[SkillProjectile] scheduled skill=" .. skillId .. " source=" .. sourceUnitId .. " fromCell=" .. sourceUnit.CellIndex .. " aimCell=" .. aimCell .. " distance=" .. distance .. " speed=" .. speed .. " flight=" .. flightSeconds .. " shots=" .. shotCount .. " interval=" .. interval .. " lastArrival=" .. lastArrival .. " launchDelay=" .. launchDelay)
		return lastArrival
	end

	@ExecSpace("ServerOnly")
	method void SpawnSkillProjectile(string skillId, string projectileName, Vector2 startPosition, Vector2 targetPosition, number speed, string projectileRuid, number projectileScale, boolean flipX)
		-- The model stays native-only and the mover is attached here, so a missing .codeblock can never
		-- silently drop the component out of the spawned entity.
		local mapEntity = self.Entity.CurrentMap
		if mapEntity == nil then
			log_warning("[SkillProjectile] spawn failed skill=" .. skillId .. " reason=MAP_MISSING")
			return
		end

		local projectile = _SpawnService:SpawnByModelId(
			self.ProjectileModelId,
			projectileName,
			Vector3(startPosition.x, startPosition.y, 0),
			mapEntity
		)
		if isvalid(projectile) == false then
			log_warning("[SkillProjectile] spawn failed skill=" .. skillId .. " model=" .. self.ProjectileModelId .. " reason=SPAWN_RETURNED_NIL")
			return
		end

		local mover = projectile:AddComponent("SkillProjectileComponent")
		if mover == nil then
			log_warning("[SkillProjectile] spawn failed skill=" .. skillId .. " reason=COMPONENT_ATTACH_FAILED")
			projectile:Destroy()
			return
		end
		mover:Launch(startPosition, targetPosition, speed, projectileRuid, projectileScale, flipX, self.ProjectileOrderInLayer)
	end

	@ExecSpace("ServerOnly")
	method void BeginSkillEffectPresentation(string sourceUnitId, table definition)
		-- Plays the caster-side effect and latches the target-side effect for this action's impact frame.
		-- Battle actions resolve strictly one at a time, so a single latched slot is enough.
		self.ActiveEffectSkillId = definition.SkillId or ""
		self.ActiveHitEffectRuid = definition.HitEffectRuid or ""
		self.ActiveHitSoundRuid = definition.HitSoundRuid or ""
		self.ActiveEffectScale = definition.EffectScale or 1
		self.ActiveEffectFlipX = false

		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		if isvalid(sourceEntity) == false then
			return
		end
		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit ~= nil then
			self.ActiveEffectFlipX = sourceUnit.Facing == "Right"
		end

		local castEffectRuid = definition.CastEffectRuid or ""
		if sourceUnit ~= nil and sourceUnit.Team == "Enemy" then
			-- Only accepted damage emits enemy hit audio; PUSH/HEAL cannot replay it.
			self.ActiveHitSoundRuid = ""
			if _EnemyImpactPresentationLogic:GetHitEffect(sourceUnit.EnemyDefinitionId, definition.SkillId) ~= "" then
				-- The old CAST is a target hit clip; its replacement belongs to the damaged avatar.
				castEffectRuid = ""
				self.ActiveHitEffectRuid = ""
			end
		end

		local castSoundRuid = definition.CastSoundRuid or ""
		if castEffectRuid == "" and castSoundRuid == "" then
			return
		end
		local sourcePresentation = sourceEntity:GetComponent("script.BattleUnitPresentationComponent")
		if sourcePresentation == nil then
			log_warning("[BattleEffect] cast skipped unit=" .. sourceUnitId .. " skill=" .. self.ActiveEffectSkillId .. " reason=PRESENTATION_MISSING")
			return
		end
		-- The sound is authored independently of the clip, so a skill with only one of the two still
		-- presents that half; both calls no-op on an empty RUID.
		sourcePresentation:PlaySkillEffect(sourceUnitId, "CAST", castEffectRuid, self.ActiveEffectScale, self.ActiveEffectFlipX, self:GetSkillSpeedMultiplier())
		sourcePresentation:PlaySkillSound(sourceUnitId, "CAST", castSoundRuid, self:GetSkillSoundVolume())
	end

	@ExecSpace("ServerOnly")
	method void PlayActiveHitEffect(string targetUnitId)
		-- Presents the latched hit effect and hit sound on one target at its impact frame; never gates
		-- gameplay resolution.
		if self.ActiveHitEffectRuid == "" and self.ActiveHitSoundRuid == "" then
			return
		end
		local targetEntity = self:FindUnitEntity(targetUnitId)
		if isvalid(targetEntity) == false then
			return
		end
		local targetPresentation = targetEntity:GetComponent("script.BattleUnitPresentationComponent")
		if targetPresentation == nil then
			log_warning("[BattleEffect] hit skipped unit=" .. targetUnitId .. " skill=" .. self.ActiveEffectSkillId .. " reason=PRESENTATION_MISSING")
			return
		end
		targetPresentation:PlaySkillEffect(targetUnitId, "HIT", self.ActiveHitEffectRuid, self.ActiveEffectScale, self.ActiveEffectFlipX, self:GetSkillSpeedMultiplier())
		targetPresentation:PlaySkillSound(targetUnitId, "HIT", self.ActiveHitSoundRuid, self:GetSkillSoundVolume())
	end

	@ExecSpace("ServerOnly")
	method number GetSkillSpeedMultiplier()
		-- Guarded so a mistyped inspector value can never stall or invert skill playback.
		return math.max(0.1, self.SkillSpeedMultiplier)
	end

	@ExecSpace("ServerOnly")
	method number GetSkillSoundVolume()
		-- Clamped to the engine's accepted 0~1 range so a mistyped inspector value cannot mute or
		-- distort the whole skill sound layer.
		return math.max(0, math.min(1, self.SkillSoundVolume))
	end

	@ExecSpace("ServerOnly")
	method table GetSkillMotionProfile(string motionProfileId)
		-- Authored values describe the skill at 1x; the speed multiplier scales them on the way out,
		-- so the swing, the impact frame, and the effect play rate all move together.
		local speed = self:GetSkillSpeedMultiplier()
		if motionProfileId == "heavy_slash" then
			return {
				MotionKey = self.HeavySlashMotionKey,
				ActionName = self.HeavySlashActionName,
				PlayRate = self.HeavySlashMotionPlayRate * speed,
				Duration = self.HeavySlashMotionDuration / speed,
				ImpactDelay = self.HeavySlashImpactDelay / speed,
				EffectPlayRate = speed
			}
		elseif motionProfileId == "push" then
			return {
				MotionKey = self.PushMotionKey,
				ActionName = self.PushActionName,
				PlayRate = self.PushMotionPlayRate * speed,
				Duration = self.PushMotionDuration / speed,
				ImpactDelay = self.PushImpactDelay / speed,
				EffectPlayRate = speed
			}
		end
		return {
			MotionKey = self.BasicSlashMotionKey,
			ActionName = self.BasicSlashActionName,
			PlayRate = self.BasicSlashMotionPlayRate * speed,
			Duration = self.BasicSlashMotionDuration / speed,
			ImpactDelay = self.BasicSlashImpactDelay / speed,
			EffectPlayRate = speed
		}
	end

	@ExecSpace("ServerOnly")
	method table ResolveFrontAttackImpact(string sourceUnitId, string attackId, number damageAmount)
		-- Re-reads the source cell and facing at impact time, so damage remains board-state based.
		local result = {
			Success = false,
			Hit = false,
			Reason = "UNKNOWN",
			SourceUnitId = sourceUnitId,
			AttackId = attackId,
			TargetUnitId = "",
			TargetCell = -1,
			DamageAmount = 0,
			TargetHpBefore = -1,
			TargetHpAfter = -1
		}

		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		if isvalid(sourceEntity) == false then
			result.Reason = "SOURCE_NOT_FOUND"
			return result
		end

		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit == nil then
			result.Reason = "SOURCE_COMPONENT_MISSING"
			return result
		end
		if self:IsTeamTurn(sourceUnit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end
		if sourceUnit.IsDead == true then
			result.Reason = "SOURCE_DEAD"
			return result
		end

		local facingDirection = -1
		if sourceUnit.Facing == "Right" then
			facingDirection = 1
		end
		result.TargetCell = sourceUnit.CellIndex + facingDirection

		local targetEntity = nil
		if self:IsValidCell(result.TargetCell) then
			targetEntity = self:ResolveFrontTarget(sourceUnitId)
		else
			result.Reason = "MISS_OUT_OF_BOUNDS"
		end

		if isvalid(targetEntity) then
			local targetUnit = targetEntity:GetComponent("script.BattleUnitComponent")
			-- Forward the attack ID with damage so the router can select its impact presentation.
			local damageResult = _EffectRouterLogic:ExecuteEffect(self, "DAMAGE", sourceUnitId, targetUnit.UnitId, damageAmount, attackId)
			if damageResult.Success == false then
				result.Reason = "DAMAGE_FAILED_" .. damageResult.Reason
				log_error("[BattleAttack] damage failed source=" .. sourceUnitId .. " target=" .. targetUnit.UnitId .. " reason=" .. damageResult.Reason)
				return result
			end

			result.Hit = true
			result.Reason = "HIT"
			result.TargetUnitId = targetUnit.UnitId
			result.DamageAmount = damageResult.AppliedAmount
			result.TargetHpBefore = damageResult.HpBefore
			result.TargetHpAfter = damageResult.HpAfter
		elseif result.Reason == "UNKNOWN" then
			result.Reason = "MISS_EMPTY"
		end

		local attackEvent = BasicAttackResolvedEvent()
		attackEvent.SourceUnitId = result.SourceUnitId
		attackEvent.AttackId = result.AttackId
		attackEvent.TargetUnitId = result.TargetUnitId
		attackEvent.TargetCell = result.TargetCell
		attackEvent.Hit = result.Hit
		attackEvent.Reason = result.Reason
		attackEvent.DamageAmount = result.DamageAmount
		attackEvent.TargetHpBefore = result.TargetHpBefore
		attackEvent.TargetHpAfter = result.TargetHpAfter
		self.Entity:SendEvent(attackEvent)

		result.Success = true
		log("[BattleAttack] resolved attack=" .. result.AttackId .. " source=" .. result.SourceUnitId .. " facing=" .. sourceUnit.Facing .. " target=" .. result.TargetUnitId .. " cell=" .. result.TargetCell .. " hit=" .. tostring(result.Hit) .. " reason=" .. result.Reason .. " damage=" .. result.DamageAmount .. " hp=" .. result.TargetHpBefore .. "->" .. result.TargetHpAfter)
		return result
	end

	@ExecSpace("ServerOnly")
	method table ResolveSkillHealImpact(string sourceUnitId, string skillId, string targetUnitId, number healAmount)
		-- Restores HP on one impact-time target. Support skills stay castable with no enemy on the board,
		-- so this path never requires a resolved enemy target.
		local result = { Success = false, Hit = false, Reason = "UNKNOWN", SourceUnitId = sourceUnitId, SkillId = skillId, TargetUnitId = targetUnitId, HealAmount = 0, TargetHpBefore = -1, TargetHpAfter = -1 }
		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		local targetEntity = self:FindUnitEntity(targetUnitId)
		if isvalid(sourceEntity) == false then
			result.Reason = "SOURCE_NOT_FOUND"
			return result
		end
		if isvalid(targetEntity) == false then
			result.Reason = "TARGET_NOT_FOUND"
			return result
		end
		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		local targetUnit = targetEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit == nil or targetUnit == nil then
			result.Reason = "UNIT_COMPONENT_MISSING"
			return result
		end
		if self:IsTeamTurn(sourceUnit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end
		if sourceUnit.IsDead == true or targetUnit.IsDead == true then
			result.Reason = "UNIT_DEAD"
			return result
		end
		if sourceUnit.Team ~= targetUnit.Team then
			result.Reason = "TARGET_NOT_ALLY"
			return result
		end

		local healResult = targetUnit:ApplyHealing(healAmount)
		if healResult.Success == false then
			result.Reason = "HEAL_FAILED_" .. healResult.Reason
			return result
		end
		result.Success = true
		result.Hit = true
		result.Reason = "HEALED"
		result.HealAmount = healResult.AppliedAmount
		result.TargetHpBefore = healResult.HpBefore
		result.TargetHpAfter = healResult.HpAfter
		self:PlayActiveHitEffect(targetUnitId)

		local targetPresentation = targetEntity:GetComponent("script.BattleUnitPresentationComponent")
		if targetPresentation ~= nil then
			targetPresentation:RefreshHpDisplay(targetUnitId, targetUnit.Team, targetUnit.CurrentHp, targetUnit.MaxHp)
		end
		log("[BattleHeal] resolved skill=" .. skillId .. " source=" .. sourceUnitId .. " target=" .. targetUnitId .. " amount=" .. result.HealAmount .. " hp=" .. result.TargetHpBefore .. "->" .. result.TargetHpAfter)
		return result
	end

	@ExecSpace("ServerOnly")
	method table TryRegisterEnemyCastInterrupt(string sourceUnitId, string skillId, string targetUnitId, number appliedDamage)
		-- Interruption is a combat-domain consequence of a successful player skill hit, not a special case inside one skill.
		local result = { Success = false, Reason = "NOT_INTERRUPTIBLE", Interrupted = false }
		if appliedDamage <= 0 then
			result.Reason = "NO_APPLIED_DAMAGE"
			return result
		end
		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		local targetEntity = self:FindUnitEntity(targetUnitId)
		if isvalid(sourceEntity) == false or isvalid(targetEntity) == false then
			result.Reason = "UNIT_NOT_FOUND"
			return result
		end
		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		local targetUnit = targetEntity:GetComponent("script.BattleUnitComponent")
		local plan = targetEntity:GetComponent("script.EnemyActionPlanComponent")
		if sourceUnit == nil or targetUnit == nil or plan == nil then
			result.Reason = "COMPONENT_MISSING"
			return result
		end
		if sourceUnit.Team ~= "Player" or targetUnit.Team ~= "Enemy" then
			result.Reason = "INVALID_TEAMS"
			return result
		end
		local executionIndex = self.ExecutingTileIndex
		if self.TurnState ~= nil then
			executionIndex = self.TurnState.ExecutingTileIndex
		end
		local hitKey = tostring(self.TurnNumber) .. ":" .. tostring(executionIndex) .. ":" .. skillId
		result = plan:RegisterInterruptHit(skillId, hitKey)
		if result.Success == true and result.Reason ~= "INTERRUPT_HIT_DUPLICATE" then
			self:PublishEnemyPlanSnapshot(result.Reason)
		end
		return result
	end

	@ExecSpace("ServerOnly")
	method table ResolveSkillDamageImpact(string sourceUnitId, string skillId, string targetUnitId, integer targetCell, number damageAmount)
		-- Applies damage to an immutable impact-time target selected by the shared skill Target Resolver.
		local result = { Success = false, Hit = false, Reason = "UNKNOWN", SourceUnitId = sourceUnitId, AttackId = skillId, TargetUnitId = targetUnitId, TargetCell = targetCell, DamageAmount = 0, TargetHpBefore = -1, TargetHpAfter = -1 }
		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		local targetEntity = self:FindUnitEntity(targetUnitId)
		if isvalid(sourceEntity) == false then
			result.Reason = "SOURCE_NOT_FOUND"
			return result
		end
		if isvalid(targetEntity) == false then
			result.Reason = "TARGET_NOT_FOUND"
			return result
		end
		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		local targetUnit = targetEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit == nil or targetUnit == nil then
			result.Reason = "UNIT_COMPONENT_MISSING"
			return result
		end
		if self:IsTeamTurn(sourceUnit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end
		if sourceUnit.IsDead == true or targetUnit.IsDead == true then
			result.Reason = "UNIT_DEAD"
			return result
		end
		if sourceUnit.Team == targetUnit.Team then
			result.Reason = "TARGET_SAME_TEAM"
			return result
		end

		-- Skill damage uses the skill ID as the impact presentation key.
		local damageResult = _EffectRouterLogic:ExecuteEffect(self, "DAMAGE", sourceUnitId, targetUnitId, damageAmount, skillId)
		if damageResult.Success == false then
			result.Reason = "DAMAGE_FAILED_" .. damageResult.Reason
			return result
		end
		result.Success = true
		result.Hit = true
		result.Reason = "HIT"
		result.DamageAmount = damageResult.AppliedAmount
		result.TargetHpBefore = damageResult.HpBefore
		result.TargetHpAfter = damageResult.HpAfter
		if damageResult.AppliedAmount > 0 then
			self:TryRegisterEnemyCastInterrupt(sourceUnitId, skillId, targetUnitId, result.DamageAmount)
			self:PlayActiveHitEffect(targetUnitId)
		end

		local attackEvent = BasicAttackResolvedEvent()
		attackEvent.SourceUnitId = sourceUnitId
		attackEvent.AttackId = skillId
		attackEvent.TargetUnitId = targetUnitId
		attackEvent.TargetCell = targetCell
		attackEvent.Hit = true
		attackEvent.Reason = result.Reason
		attackEvent.DamageAmount = result.DamageAmount
		attackEvent.TargetHpBefore = result.TargetHpBefore
		attackEvent.TargetHpAfter = result.TargetHpAfter
		self.Entity:SendEvent(attackEvent)
		log("[BattleSkillDamage] resolved skill=" .. skillId .. " source=" .. sourceUnitId .. " target=" .. targetUnitId .. " cell=" .. targetCell .. " damage=" .. result.DamageAmount .. " hp=" .. result.TargetHpBefore .. "->" .. result.TargetHpAfter)
		return result
	end

	@ExecSpace("ServerOnly")
	method void PlayAcceptedEnemyImpact(Entity sourceEntity, Entity targetEntity, string attackId)
		-- Called once for positive damage before death cleanup; all selection uses this hit's explicit source and attack.
		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		local targetUnit = targetEntity:GetComponent("script.BattleUnitComponent")
		local presentation = targetEntity:GetComponent("script.BattleUnitPresentationComponent")
		if sourceUnit == nil or targetUnit == nil or presentation == nil then return end
		if targetUnit.Team == "Enemy" then
			local sound = _EnemyImpactPresentationLogic:GetDamageSound(targetUnit.EnemyDefinitionId)
			presentation:PlaySkillSound(targetUnit.UnitId, "MONSTER_DAMAGE", sound, self:GetSkillSoundVolume())
		elseif targetUnit.Team == "Player" and sourceUnit.Team == "Enemy" then
			local sound = _EnemyImpactPresentationLogic:GetImpactSound(sourceUnit.EnemyDefinitionId, attackId)
			presentation:PlaySkillSound(targetUnit.UnitId, "ENEMY_HIT", sound, self:GetSkillSoundVolume())
			local effect = _EnemyImpactPresentationLogic:GetHitEffect(sourceUnit.EnemyDefinitionId, attackId)
			if effect ~= "" then
				local definition = _SkillDefinitionRepositoryLogic:GetSkillDefinition(attackId)
				local scale = definition.EffectScale or 1
				presentation:PlaySkillEffect(targetUnit.UnitId, "HIT", effect, scale, sourceUnit.Facing == "Right", self:GetSkillSpeedMultiplier())
			end
		end
		log("[EnemyImpact] accepted source=" .. sourceUnit.UnitId .. " target=" .. targetUnit.UnitId .. " attack=" .. tostring(attackId))
	end

	@ExecSpace("ServerOnly")
	method table ApplyDamage(string sourceUnitId, string targetUnitId, number amount, string attackId)
		-- Owns the single HP mutation path and forwards the first zero-HP transition to death handling.
		local result = {
			Success = false,
			Reason = "UNKNOWN",
			AppliedAmount = 0,
			HpBefore = -1,
			HpAfter = -1
		}

		if amount <= 0 then
			result.Reason = "INVALID_AMOUNT"
			return result
		end

		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		local targetEntity = self:FindUnitEntity(targetUnitId)
		if isvalid(sourceEntity) == false then
			result.Reason = "SOURCE_NOT_FOUND"
			return result
		end
		if isvalid(targetEntity) == false then
			result.Reason = "TARGET_NOT_FOUND"
			return result
		end

		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		local targetUnit = targetEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit == nil or targetUnit == nil then
			result.Reason = "UNIT_COMPONENT_MISSING"
			return result
		end
		if sourceUnit.Team == targetUnit.Team then
			result.Reason = "SAME_TEAM"
			return result
		end
		if sourceUnit.IsDead == true or targetUnit.IsDead == true then
			result.Reason = "UNIT_DEAD"
			return result
		end

		local attackerEffects = sourceEntity:GetComponent("script.PlayerRunRelicEffectComponent")
		local defenderEffects = targetEntity:GetComponent("script.PlayerRunRelicEffectComponent")
		local attackerRun = sourceEntity:GetComponent("script.PlayerRunStateComponent")
		local defenderRun = targetEntity:GetComponent("script.PlayerRunStateComponent")
		if sourceUnit.Team == "Player" and attackerEffects ~= nil and attackerEffects.IsInitialized
			and attackerRun ~= nil and attackerEffects.ActiveRunSequence == attackerRun.RunSequence then
			amount = amount + attackerEffects.AttackBonus
		end
		if targetUnit.Team == "Player" and defenderEffects ~= nil and defenderEffects.IsInitialized
			and defenderRun ~= nil and defenderEffects.ActiveRunSequence == defenderRun.RunSequence then
			amount = math.max(1, amount - defenderEffects.DefenseBonus)
		end
		-- BattleUnit retains the full UtilityGuardActive block, including zero damage.
		local damageResult = targetUnit:ApplyDamage(amount)
		if damageResult.Success == false then
			result.Reason = damageResult.Reason
			return result
		end
		result.HpBefore = damageResult.HpBefore
		result.HpAfter = damageResult.HpAfter
		result.AppliedAmount = damageResult.AppliedAmount
		if damageResult.AppliedAmount > 0 then
			self:PlayAcceptedEnemyImpact(sourceEntity, targetEntity, attackId)
		end
		local strongHit = amount >= math.max(0.01, self.StrongHitDamageThreshold)
		local sourcePresentation = sourceEntity:GetComponent("script.BattleUnitPresentationComponent")
		if sourcePresentation ~= nil then
			sourcePresentation:PlayHitStop(sourceUnitId, strongHit, self.NormalHitStopDuration, self.StrongHitStopDuration)
		end
		local targetPresentation = targetEntity:GetComponent("script.BattleUnitPresentationComponent")
		if targetPresentation ~= nil and damageResult.AppliedAmount > 0 then
			targetPresentation:PlayHitImpact(targetUnitId, strongHit, self.NormalHitStopDuration, self.StrongHitStopDuration, self.HitReactionDuration, self.HitFlashDuration)
		end
		self:PlayImpactCameraShake(strongHit)
		if targetUnit.Team == "Player" then
			self:RefreshPlayerHpSnapshot("DAMAGE_APPLIED")
		end
		if damageResult.ReachedZero == true then
			self:HandleUnitDiedFromSource(targetUnitId, "DAMAGE", sourceUnitId)
		end

		result.Success = true
		result.Reason = "OK"
		log("[BattleDamage] applied source=" .. sourceUnitId .. " target=" .. targetUnitId .. " amount=" .. result.AppliedAmount .. " hp=" .. result.HpBefore .. "->" .. result.HpAfter)
		return result
	end

	@ExecSpace("ServerOnly")
	method void HandleUnitDied(string unitId, string cause)
		-- Preserves the existing public death entrypoint for non-attributed causes and tests.
		self:HandleUnitDiedFromSource(unitId, cause, "")
	end

	@ExecSpace("ServerOnly")
	method void HandleUnitDiedFromSource(string unitId, string cause, string sourceUnitId)
		-- Marks one unit dead, resolves contextual drops, advances waves, and checks battle completion.
		local unitEntity = self:FindUnitEntity(unitId)
		if isvalid(unitEntity) == false then
			log_error("[BattleDeath] failed unit=" .. unitId .. " reason=UNIT_NOT_FOUND")
			return
		end

		local unit = unitEntity:GetComponent("script.BattleUnitComponent")
		if unit == nil then
			log_error("[BattleDeath] failed unit=" .. unitId .. " reason=COMPONENT_MISSING")
			return
		end
		if self.BattleResult ~= "" then
			log("[BattleDeath] ignored unit=" .. unitId .. " reason=BATTLE_ALREADY_ENDED result=" .. self.BattleResult)
			return
		end
		if unit.IsDead == true then
			log_warning("[BattleDeath] duplicate ignored unit=" .. unitId)
			return
		end

		local deathState = unit:MarkDead()
		if deathState.Success == false then
			log_error("[BattleDeath] state transition failed unit=" .. unitId .. " reason=" .. deathState.Reason)
			return
		end
		if unit.Team == "Enemy" then
			-- Plays once per confirmed death; duplicate death calls already returned above.
			local deathSound = _EnemyImpactPresentationLogic:GetDeathSound(unit.EnemyDefinitionId)
			local deathPresentation = unitEntity:GetComponent("script.BattleUnitPresentationComponent")
			if deathSound ~= "" and deathPresentation ~= nil then
				deathPresentation:PlaySkillSound(unitId, "MONSTER_DEATH", deathSound, self:GetSkillSoundVolume())
			end
		end
		if unit.Team == "Enemy" and isvalid(self.PlayerEntity) then
			self.ResultKillCount = self.ResultKillCount + 1
			_MonsterCollectionLogic:RecordDefeat(self.PlayerEntity, unit.EnemyDefinitionId)
		end
		local summoner = unitEntity:GetComponent("script.FaustSummonComponent")
		if summoner ~= nil then
			summoner:RemoveSummon(self)
		end
		local defeatedPlan = unitEntity:GetComponent("script.EnemyActionPlanComponent")
		local defeatedRunner = unitEntity:GetComponent("script.EnemyPatternRunnerComponent")
		if defeatedPlan ~= nil and defeatedPlan.PlanState ~= "EMPTY" then
			local currentAction = defeatedPlan:GetCurrentAction()
			if defeatedRunner ~= nil and currentAction.Success == true then
				defeatedRunner:CancelPreparedStep(currentAction.PatternId, currentAction.StepIndex, "UNIT_DIED")
			end
			defeatedPlan:ResetPlan("UNIT_DIED")
		end
		local preparedIntent = self:GetPreparedEnemyIntent()
		if preparedIntent.EnemyId == unitId then
			self:ResetEnemyIntentCursor("UNIT_DIED")
		end
		self:PublishEnemyPlanSnapshot("UNIT_DIED")
		if unit.Team == "Enemy" and self.DropRuntime ~= nil then
			local sourceEntity = self:FindUnitEntity(sourceUnitId)
			local sourceUnit = nil
			if isvalid(sourceEntity) then
				sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
			end
			if sourceUnit ~= nil and sourceUnit.Team == "Player" then
				self.CurrentPlayerActionKillCount = self.CurrentPlayerActionKillCount + 1
			end
			local triggerResult = _EnemyDropTriggerResolverLogic:Resolve(unit.IsBoss, self.CurrentPlayerActionKillCount)
			local dropResult = self.DropRuntime:ResolveEnemyDeath(
				self.RunSeed,
				self.StageId,
				self.CurrentWave,
				unit.EnemyDefinitionId,
				unit.UnitId,
				unit.SpawnOrder,
				unit.CellIndex,
				triggerResult.TriggerSnapshot,
				self.UnionItemDropRate
			)
			if dropResult.Success == false then
				log_error("[BattleDeath] drop failed unit=" .. unitId .. " reason=" .. dropResult.Reason)
			end
		end
		if unit.Team == "Enemy" and self.BoardState ~= nil then
			local livingEnemies = self.BoardState:CollectLivingEnemies()
			if #livingEnemies > 0 then
				log("[BattleDeath] unit=" .. unitId .. " cause=" .. cause .. " result=CONTINUE livingEnemies=" .. #livingEnemies)
				return
			end
		end
		-- A successful queue can clear the wave before its completion timer reaches the handoff.
		if unit.Team == "Enemy" and self.TurnState ~= nil and self.TurnState.ExecutingTileIndex > 0 then
			local sourceEntity = self:FindUnitEntity(sourceUnitId)
			if isvalid(sourceEntity) and sourceEntity == self.PlayerEntity then
				self:RecordRunConsumedPlayerTurn()
			end
		end
		self:ClearForcedSpawnSchedule("ALL_ENEMIES_DEFEATED")
		self:ClearTurnTransitionTimer("ALL_ENEMIES_DEFEATED")
		self:ClearMotionCompletionWaits()
		if unit.Team == "Enemy" then
			self:CompletePlayerCombatPresentationHandoff("ENEMIES_DEFEATED")
		end
		self.PlayerToEnemyBeatPending = false
		self.PendingPlayerToEnemyHandoffDelay = -1
		self:ClearEnemyToEnemyPresentationHandoff("UNIT_DEATH_" .. unitId)
		self:ClearSkillImpactTimers()
		if self.ActionTimerId > 0 then
			_TimerService:ClearTimer(self.ActionTimerId)
			self.ActionTimerId = 0
		end
		if unit.Team == "Enemy" then
			if self.CurrentWave < self.TotalWaves then
				self.TurnState:ClearActionState("WAVE_CLEARED")
				self.TurnState:SetPhase("WaveTransition", "WAVE_CLEARED")
				self:PublishTurnStateSnapshot("WAVE_CLEARED")
				log("[BattleQueueBoundary] boundary=WAVE_CLEARED policy=PRESERVE queue=" .. self.TurnState.QueuedTileIds)
				self:ClearPreparedEnemyIntent("WAVE_CLEARED")
				local clearedWave = self.CurrentWave
				local nextWave = clearedWave + 1
				local transitionDelay = math.max(self.CurrentClearSpawnDelay, self.EnemyDeathPresentationDelay)
				self.WaveRuntime:ScheduleWaveTransition(clearedWave, nextWave, transitionDelay)
				self:PublishWaveStateSnapshot("WAVE_CLEARED")
				log("[BattleWave] cleared stage=" .. self.StageNumber .. " wave=" .. clearedWave .. "/" .. self.TotalWaves .. " nextWave=" .. nextWave)
				return
			end

			local queuedBeforeVictory = self.TurnState.QueuedTileIds
			self.TurnState:ClearTransientState("STAGE_CLEARED")
			self.TurnState:SetPhase("BattleEnded", "STAGE_CLEARED")
			self:PublishTurnStateSnapshot("STAGE_CLEARED")
			log("[BattleQueueBoundary] boundary=VICTORY policy=CLEAR before=" .. queuedBeforeVictory .. " after=" .. self.TurnState.QueuedTileIds)
			self.WaveRuntime:SetWaveState("StageCleared", "STAGE_CLEARED")
			self:PublishWaveStateSnapshot("STAGE_CLEARED")
			self.BattleResult = "Victory"
		else
			local queuedBeforeDefeat = self.TurnState.QueuedTileIds
			self.TurnState:ClearTransientState("PLAYER_DEFEATED")
			self.TurnState:SetPhase("BattleEnded", "PLAYER_DEFEATED")
			self:PublishTurnStateSnapshot("PLAYER_DEFEATED")
			log("[BattleQueueBoundary] boundary=DEFEAT policy=CLEAR before=" .. queuedBeforeDefeat .. " after=" .. self.TurnState.QueuedTileIds)
			self.WaveRuntime:SetWaveState("Failed", "PLAYER_DEFEATED")
			self:PublishWaveStateSnapshot("PLAYER_DEFEATED")
			self.BattleResult = "Defeat"
		end

		local runResultRecorded = false
		if isvalid(self.PlayerEntity) then
			if self.BattleResult == "Victory" and self.DropRuntime ~= nil then
				local dropRecordKey = self.StageId .. ":" .. tostring(self.EntryRequestId)
				local collectResult = self.DropRuntime:AutoCollectAll(self.PlayerEntity, dropRecordKey)
				if collectResult.Success == false then
					log_error("[BattleResult] drop auto collect failed reason=" .. collectResult.Reason .. " remaining=" .. collectResult.FailedCount)
				end
			elseif self.DropRuntime ~= nil then
				self.DropRuntime:DiscardPending("BATTLE_DEFEAT")
			end
			runResultRecorded = _RunManagerLogic:RecordBattleResult(self.PlayerEntity, self.StageId, self.StageNumber, self.BattleResult, self.EntryRequestId)
			if runResultRecorded == true then
				self:RefreshUnionRewardPresentation()
			end
		end
		log("[BattleDeath] unit=" .. unitId .. " cause=" .. cause .. " result=" .. self.BattleResult .. " wave=" .. self.CurrentWave)
		log("[BattleResult] result=" .. self.BattleResult .. " stage=" .. self.StageNumber .. " wave=" .. self.CurrentWave .. "/" .. self.TotalWaves .. " turn=" .. self.TurnNumber .. " runRecorded=" .. tostring(runResultRecorded))
		self.ResultRecorded = runResultRecorded
		self.ResultElapsedSeconds = math.max(0, math.floor(_UtilLogic.ElapsedSeconds - self.ResultStartTime))
		local inventory = isvalid(self.PlayerEntity) and self.PlayerEntity:GetComponent("script.PlayerRunInventoryComponent") or nil
		self.ResultGold = inventory ~= nil and math.max(0, inventory:GetSnapshotAmount(inventory.RunCurrencySnapshot, "gold") - self.ResultStartGold) or 0
		local expectedEntry = self.EntryRequestId
		self.ResultTransitionTimerId = _TimerService:SetTimerOnce(function()
			self.ResultTransitionTimerId = 0
			self:WaitForMotionCompletion(function()
				if self.EntryRequestId == expectedEntry and self.BattleResult ~= "" then
					self.ResultReady = true
					log("[BattleResult] ready for confirmation kills=" .. self.ResultKillCount)
				end
			end)
		end, math.max(0.1, self.EnemyDeathPresentationDelay))
	end

	@ExecSpace("ServerOnly")
	method void AdvanceClearedWave(integer clearedWave, integer nextWave)
		-- Called only by BattleWaveComponent after its map-scoped transition timer expires.
		self:WaitForMotionCompletion(function() self:AdvanceWaveAfterMotion(clearedWave, nextWave) end)
	end

	@ExecSpace("ServerOnly")
	method void AdvanceWaveAfterMotion(integer clearedWave, integer nextWave)
		-- Dead entities remain visible until their completed animation and hold have been acknowledged.
		if self.BattleResult ~= "" or self.CurrentWave ~= clearedWave then
			return
		end
		self.TurnState:OpenPlayerTurn(self.TurnNumber + 1, "NEXT_WAVE")
		if isvalid(self.PlayerEntity) then
			local unit = self.PlayerEntity:GetComponent("script.BattleUnitComponent")
			if unit ~= nil then unit.UtilityGuardActive = false end
		end
		self:PublishTurnStateSnapshot("NEXT_WAVE")
		self.StageTurnNumber = self.TurnNumber
		self:SpawnWave(nextWave)
		if self.CurrentWave == nextWave then
			self.TurnState:SetPhase("PlayerTurn", "NEXT_WAVE_ACTIVE")
			self:PublishTurnStateSnapshot("NEXT_WAVE_ACTIVE")
			self.WaveRuntime:MarkWaveActive("NEXT_WAVE_ACTIVE")
			self:PublishWaveStateSnapshot("NEXT_WAVE_ACTIVE")
			self:ProcessAugmentTrigger("TURN_START", "TURN:" .. tostring(self.TurnNumber), 0)
			self:PrepareEnemyIntent()
		end
	end

	@ExecSpace("ServerOnly")
	method Entity ResolveFrontTarget(string sourceUnitId)
		-- Returns a living opposing unit occupying the source unit's front cell.
		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		if isvalid(sourceEntity) == false then
			return nil
		end

		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit == nil then
			return nil
		end

		local facingDirection = -1
		if sourceUnit.Facing == "Right" then
			facingDirection = 1
		end
		local targetCell = sourceUnit.CellIndex + facingDirection

		if self.BoardState == nil then
			return nil
		end
		local candidate = self.BoardState:FindAtCell(targetCell, sourceUnitId)
		if isvalid(candidate) then
			local unit = candidate:GetComponent("script.BattleUnitComponent")
			if unit ~= nil and unit.Team ~= sourceUnit.Team then
				return candidate
			end
		end
		return nil
	end

	@ExecSpace("Server")
	method void RequestMove(integer direction)
		-- Validates the requesting client before forwarding the move to battle state.
		if isvalid(self.PlayerEntity) == false or self.PlayerEntity.PlayerComponent == nil then
			log_warning("[BattleMove] rejected reason=PLAYER_MISSING")
			return
		end

		if self.PlayerEntity.PlayerComponent.UserId ~= senderUserId then
			log_warning("[BattleMove] rejected reason=INVALID_SENDER")
			return
		end

		if self.BattlePhase ~= "PlayerTurn" then
			local rejected = { Success = false, Reason = "INVALID_PHASE" }
			self:PublishPlayerCommandResult("MOVE", rejected)
			log_warning("[BattleMove] rejected direction=" .. tostring(direction) .. " reason=INVALID_PHASE phase=" .. tostring(self.BattlePhase))
			return
		end

		local result = self:TryQueuePlayerAction("MOVE", direction)
		self:PublishPlayerCommandResult("MOVE", result)
		if result.Success == false then
			log_warning("[BattleQueue] rejected action=MOVE direction=" .. direction .. " reason=" .. result.Reason)
		end
	end

	@ExecSpace("ServerOnly")
	method table RelocateUnitForMechanic(string unitId, integer toCell, string mechanicId)
		-- Provides a validated board-mutation boundary for job handlers without exposing BoardState internals.
		local result = { Success = false, Reason = "UNKNOWN", UnitId = unitId or "", FromCell = -1, ToCell = toCell }
		if self:IsValidCell(toCell) == false then
			result.Reason = "OUT_OF_BOUNDS"
			return result
		end
		local unitEntity = self:FindUnitEntity(unitId)
		if isvalid(unitEntity) == false then
			result.Reason = "UNIT_NOT_FOUND"
			return result
		end
		local unit = unitEntity:GetComponent("script.BattleUnitComponent")
		if unit == nil or unit.IsDead == true then
			result.Reason = "UNIT_UNAVAILABLE"
			return result
		end
		if self:IsCellOccupied(toCell, unitId) then
			result.Reason = "CELL_OCCUPIED"
			return result
		end
		result.FromCell = unit.CellIndex
		local cellChange = unit:ApplyCellChange(toCell)
		if cellChange.Success == false then
			result.Reason = cellChange.Reason
			return result
		end
		self:PlaceEntity(unitEntity, self:GetCellPosition(toCell))
		self:CollectDropsForMovedUnit(unit, toCell)
		local movedEvent = UnitMovedEvent()
		movedEvent.UnitId = unit.UnitId
		movedEvent.FromCell = result.FromCell
		movedEvent.ToCell = toCell
		self.Entity:SendEvent(movedEvent)
		result.Success = true
		result.Reason = "OK"
		log("[JobMechanic] relocated mechanic=" .. mechanicId .. " unit=" .. unitId .. " from=" .. result.FromCell .. " to=" .. toCell)
		return result
	end

	@ExecSpace("ServerOnly")
	method integer ResolveEnemyRelativeMoveDirection(string enemyId, string actionType)
		-- Post-attack movement resolves against the live board after impact/push effects.
		local enemyEntity = self:FindUnitEntity(enemyId)
		local playerEntity = self:FindUnitEntity("player_01")
		if isvalid(enemyEntity) == false or isvalid(playerEntity) == false then
			return 0
		end
		local enemy = enemyEntity:GetComponent("script.BattleUnitComponent")
		local player = playerEntity:GetComponent("script.BattleUnitComponent")
		if enemy == nil or player == nil or enemy.CellIndex == player.CellIndex then
			return 0
		end
		local towardDirection = player.CellIndex > enemy.CellIndex and 1 or -1
		if actionType == "MOVE_AWAY" then
			return -towardDirection
		end
		return towardDirection
	end

	@ExecSpace("ServerOnly")
	method table TryMoveAway(string unitId, integer direction)
		-- Preserves existing player and special-skill callers; only ordinary enemy commands opt in.
		return self:TryMoveAwayInternal(unitId, direction, false)
	end

	@ExecSpace("ServerOnly")
	method table TryMoveAwayInternal(string unitId, integer direction, boolean smoothEnemyMove)
		-- Atomically turns away and moves one cell; blocked destinations never change Facing.
		local result = { Success = false, Reason = "UNKNOWN", FromCell = -1, ToCell = -1, PreviousFacing = "", CurrentFacing = "" }
		if direction ~= -1 and direction ~= 1 then
			result.Reason = "INVALID_DIRECTION"
			return result
		end
		local unitEntity = self:FindUnitEntity(unitId)
		if isvalid(unitEntity) == false then
			result.Reason = "UNIT_NOT_FOUND"
			return result
		end
		local unit = unitEntity:GetComponent("script.BattleUnitComponent")
		if unit == nil then
			result.Reason = "UNIT_COMPONENT_MISSING"
			return result
		end
		if self:IsTeamTurn(unit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end
		if unit.IsDead == true then
			result.Reason = "UNIT_DEAD"
			return result
		end

		result.FromCell = unit.CellIndex
		result.ToCell = unit.CellIndex + direction
		result.PreviousFacing = unit.Facing
		result.CurrentFacing = direction > 0 and "Right" or "Left"
		if self:IsValidCell(result.ToCell) == false then
			result.Reason = "OUT_OF_BOUNDS"
			return result
		end
		if self:IsCellOccupied(result.ToCell, unitId) then
			result.Reason = "CELL_OCCUPIED"
			return result
		end

		local facingResult = unit:ApplyFacingState(result.CurrentFacing)
		if facingResult.Success == false then
			result.Reason = facingResult.Reason
			return result
		end
		local moveResult = self:TryMoveInternal(unitId, direction, smoothEnemyMove)
		if moveResult.Success == false then
			unit:ApplyFacingState(result.PreviousFacing)
			self:ApplyFacing(unitEntity, unit.Facing)
			result.Reason = moveResult.Reason
			return result
		end

		self:ApplyFacing(unitEntity, unit.Facing)
		if result.PreviousFacing ~= result.CurrentFacing then
			local turnedEvent = UnitTurnedEvent()
			turnedEvent.UnitId = unit.UnitId
			turnedEvent.PreviousFacing = result.PreviousFacing
			turnedEvent.CurrentFacing = result.CurrentFacing
			self.Entity:SendEvent(turnedEvent)
		end
		result.Success = true
		result.Reason = "OK"
		result.PresentationStarted = moveResult.PresentationStarted == true
		log("[BattleMoveAway] success unit=" .. unit.UnitId .. " from=" .. result.FromCell .. " to=" .. result.ToCell .. " facing=" .. result.PreviousFacing .. "->" .. result.CurrentFacing)
		return result
	end

	@ExecSpace("ServerOnly")
	method table TryChargeForward(string unitId, integer direction, string skillId, string committedCellSnapshot)
		-- Traverses only the cells frozen with the visible plan and stops before the first occupied cell.
		local result = {
			Success = false,
			Reason = "UNKNOWN",
			FromCell = -1,
			ToCell = -1,
			TraversedCells = "",
			MovedCellCount = 0,
			Hit = false,
			TargetUnitId = "",
			DamageAmount = 0,
			StopReason = ""
		}
		if self.BattleResult ~= "" then
			result.Reason = "BATTLE_ENDED"
			return result
		end
		if direction ~= -1 and direction ~= 1 then
			result.Reason = "INVALID_DIRECTION"
			return result
		end
		local unitEntity = self:FindUnitEntity(unitId)
		if isvalid(unitEntity) == false then
			result.Reason = "UNIT_NOT_FOUND"
			return result
		end
		local unit = unitEntity:GetComponent("script.BattleUnitComponent")
		if unit == nil then
			result.Reason = "UNIT_COMPONENT_MISSING"
			return result
		end
		if unit.IsDead == true or unit.IsAirborne == true then
			result.Reason = "UNIT_UNAVAILABLE"
			return result
		end
		if self:IsTeamTurn(unit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end
		local definition = _SkillDefinitionRepositoryLogic:GetSkillDefinition(skillId)
		if definition.Success == false then
			result.Reason = "CHARGE_SKILL_INVALID"
			return result
		end

		result.FromCell = unit.CellIndex
		result.ToCell = unit.CellIndex
		local committedCells = {}
		for token in string.gmatch(committedCellSnapshot or "", "([^|]+)") do
			local cellIndex = math.floor(tonumber(token) or -1)
			if self:IsValidCell(cellIndex) then
				table.insert(committedCells, cellIndex)
			end
		end
		if #committedCells == 0 then
			result.Reason = "CHARGE_TARGET_SNAPSHOT_MISSING"
			return result
		end
		local committedFacing = direction == 1 and "Right" or "Left"
		local facingResult = unit:ApplyFacingState(committedFacing)
		if facingResult.Success == false then
			result.Reason = facingResult.Reason
			return result
		end
		self:PlayEnemyMovementActionMotion(unitEntity, unitId, definition)

		local traversed = {}
		for _, nextCell in ipairs(committedCells) do
			if nextCell ~= unit.CellIndex + direction then
				result.StopReason = "COMMITTED_PATH_ENDED"
				break
			end
			if self:IsValidCell(nextCell) == false then
				result.StopReason = "OUT_OF_BOUNDS"
				break
			end

			local occupantEntity = self.BoardState ~= nil and self.BoardState:FindAtCell(nextCell, unitId) or nil
			if isvalid(occupantEntity) then
				local occupantUnit = occupantEntity:GetComponent("script.BattleUnitComponent")
				result.StopReason = "CELL_OCCUPIED"
				if occupantUnit ~= nil and occupantUnit.IsDead == false and occupantUnit.Team ~= unit.Team then
					self:BeginSkillEffectPresentation(unitId, definition)
					local damage = self:ResolveSkillDamageImpact(unitId, skillId, occupantUnit.UnitId, nextCell, unit.BasicAttackDamage)
					result.Success = damage.Success == true
					result.Hit = damage.Hit == true
					result.TargetUnitId = occupantUnit.UnitId
					result.DamageAmount = damage.DamageAmount or 0
					result.Reason = damage.Success == true and "CHARGE_HIT" or damage.Reason
					result.ToCell = unit.CellIndex
					result.TraversedCells = table.concat(traversed, "|")
					log("[EnemyCharge] resolved unit=" .. unitId .. " from=" .. result.FromCell .. " to=" .. result.ToCell .. " path=" .. result.TraversedCells .. " target=" .. result.TargetUnitId .. " damage=" .. result.DamageAmount .. " success=" .. tostring(result.Success))
					return result
				end
				break
			end

			local move = self:TryMove(unitId, direction)
			if move.Success == false then
				if move.Reason == "OUT_OF_BOUNDS" or move.Reason == "CELL_OCCUPIED" then
					result.StopReason = move.Reason
					break
				end
				result.Reason = move.Reason
				result.ToCell = unit.CellIndex
				result.TraversedCells = table.concat(traversed, "|")
				return result
			end
			table.insert(traversed, tostring(unit.CellIndex))
			result.MovedCellCount = result.MovedCellCount + 1
			result.ToCell = unit.CellIndex
		end

		result.Success = true
		result.Reason = result.StopReason == "CELL_OCCUPIED" and "CHARGE_BLOCKED" or "CHARGE_ENDPOINT_REACHED"
		result.TraversedCells = table.concat(traversed, "|")
		log("[EnemyCharge] resolved unit=" .. unitId .. " from=" .. result.FromCell .. " to=" .. result.ToCell .. " path=" .. result.TraversedCells .. " target=- damage=0 stop=" .. result.StopReason)
		return result
	end

	@ExecSpace("ServerOnly")
	method void PlayEnemyMovementActionMotion(Entity sourceEntity, string unitId, table definition)
		-- Movement-type enemy skills use the same monster-specific attack selection as ordinary skills.
		self:PlayEnemyAttackMotion(sourceEntity, unitId, definition)
	end

	@ExecSpace("ServerOnly")
	method void PlayEnemyAttackMotion(Entity sourceEntity, string unitId, table definition)
		-- Priority: enemy attack -> skill caster fallback -> enemy move -> enemy idle/model.
		if isvalid(sourceEntity) == false or definition == nil then
			return
		end
		local presentation = sourceEntity:GetComponent("script.BattleUnitPresentationComponent")
		if presentation == nil then
			return
		end
		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		local motionRuid = presentation.AttackMotionRuid or ""
		local motionPlayRate = tonumber(presentation.AttackMotionPlayRate) or 1
		local motionDuration = tonumber(presentation.AttackMotionDuration) or 0.35
		local source = "ENEMY_DEFINITION"
		if motionRuid == "" then
			motionRuid = definition.CasterMotionRuid or ""
			motionPlayRate = (tonumber(definition.CasterMotionPlayRate) or 1) * 3
			motionDuration = tonumber(definition.CasterMotionDuration) or tonumber(definition.ActionDuration) or 0.35
			source = "SKILL_FALLBACK"
		end
		if motionRuid == "" then
			motionRuid = presentation.MovementMotionRuid or ""
			motionPlayRate = tonumber(presentation.MovementMotionPlayRate) or 1
			source = "MOVE_FALLBACK"
		end
		if motionRuid == "" then
			motionRuid = presentation.IdleMotionRuid or ""
			motionPlayRate = tonumber(presentation.IdleMotionPlayRate) or 1
			source = "IDLE_FALLBACK"
		end
		if motionRuid == "" then
			log_warning("[EnemyAttackMotion] skipped unit=" .. unitId .. " reason=MOTION_RUID_MISSING")
			return
		end
		local speed = self:GetSkillSpeedMultiplier()
		local skillDuration = tonumber(definition.CasterMotionDuration) or tonumber(definition.ActionDuration) or 0
		motionDuration = math.max(motionDuration, skillDuration) / speed
		presentation:PlaySpriteMotion(unitId, motionRuid, motionPlayRate * speed, motionDuration, sourceUnit ~= nil and sourceUnit.Facing or "", false)
		log("[EnemyAttackMotion] selected unit=" .. unitId
			.. " definition=" .. tostring(sourceUnit ~= nil and sourceUnit.EnemyDefinitionId or "")
			.. " skill=" .. tostring(definition.SkillId)
			.. " ruid=" .. motionRuid
			.. " source=" .. source
			.. " fallback=" .. tostring(source ~= "ENEMY_DEFINITION")
			.. " facing=" .. tostring(sourceUnit ~= nil and sourceUnit.Facing or "UNKNOWN")
			.. " duration=" .. tostring(motionDuration))
	end

	@ExecSpace("ServerOnly")
	method table TryMove(string unitId, integer direction)
		-- Preserves existing player and special-skill callers; only ordinary enemy commands opt in.
		return self:TryMoveInternal(unitId, direction, false)
	end

	@ExecSpace("ServerOnly")
	method table TryMoveInternal(string unitId, integer direction, boolean smoothEnemyMove)
		-- Moves one logical cell after checking phase, range, life, and occupancy.
		local result = {
			Success = false,
			Reason = "UNKNOWN",
			FromCell = -1,
			ToCell = -1
		}

		if direction ~= -1 and direction ~= 1 then
			result.Reason = "INVALID_DIRECTION"
			return result
		end

		local unitEntity = self:FindUnitEntity(unitId)
		if isvalid(unitEntity) == false then
			result.Reason = "UNIT_NOT_FOUND"
			return result
		end

		local unit = unitEntity:GetComponent("script.BattleUnitComponent")
		if unit == nil then
			result.Reason = "UNIT_COMPONENT_MISSING"
			return result
		end

		if self:IsTeamTurn(unit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end

		result.FromCell = unit.CellIndex
		result.ToCell = unit.CellIndex + direction
		if unit.IsDead == true then
			result.Reason = "UNIT_DEAD"
			return result
		end

		if self:IsValidCell(result.ToCell) == false then
			result.Reason = "OUT_OF_BOUNDS"
			return result
		end

		local mechanicResult = nil
		if self:IsCellOccupied(result.ToCell, unitId) then
			local occupiedEntity = self.BoardState:FindAtCell(result.ToCell, unitId)
			if unit.Team == "Player" and self.SelectedJobMechanicId ~= "" and self.SelectedJobMechanicId ~= "NONE" then
				local mechanicContext = {
					BattleSession = self,
					SourceEntity = unitEntity,
					SourceUnit = unit,
					SourceCell = result.FromCell,
					TargetCell = result.ToCell,
					Direction = direction,
					OccupantEntity = occupiedEntity
				}
				local availability = _JobMechanicRouterLogic:CanActivate(self.SelectedJobMechanicId, mechanicContext)
				self.LastJobMechanicId = self.SelectedJobMechanicId
				self.LastJobMechanicSuccess = availability.Success == true and availability.CanActivate == true
				self.LastJobMechanicReason = availability.Reason or "JOB_MECHANIC_UNAVAILABLE"
				self.JobMechanicRevision = self.JobMechanicRevision + 1
				if availability.Success == true and availability.CanActivate == true then
					mechanicResult = _JobMechanicRouterLogic:Execute(self.SelectedJobMechanicId, mechanicContext)
					self.LastJobMechanicSuccess = mechanicResult.Success == true
					self.LastJobMechanicReason = mechanicResult.Reason or "JOB_MECHANIC_FAILED"
					if mechanicResult.Success == false or mechanicResult.AllowSourceMove ~= true then
						result.Reason = mechanicResult.Reason
						return result
					end
				else
					result.DetailReason = availability.Reason
				end
			end
			if self:IsCellOccupied(result.ToCell, unitId) then
				result.Reason = "CELL_OCCUPIED"
				return result
			end
		end

		local cellChange = unit:ApplyCellChange(result.ToCell)
		if cellChange.Success == false then
			result.Reason = cellChange.Reason
			return result
		end
		local position = self:GetCellPosition(result.ToCell)
		if unit.Team == "Player" and unit.UnitId == "player_01" then
			local started = self:StartPlayerGridMovePresentation(unitEntity, result.FromCell, result.ToCell)
			result.PresentationStarted = started
			if started == false then
				self:PlaceEntity(unitEntity, position)
			end
		elseif unit.Team == "Enemy" and smoothEnemyMove then
			result.PresentationStarted = self:StartEnemyGridMovePresentation(unitEntity, result.FromCell, result.ToCell)
			if result.PresentationStarted == false then
				self:PlaceEntity(unitEntity, position)
			end
		else
			self:PlaceEntity(unitEntity, position)
			self:PlayUnitMoveHop(unitEntity)
		end
		local pickupResult = self:CollectDropsForMovedUnit(unit, result.ToCell)
		result.PickedUpDropCount = pickupResult.CollectedCount or 0

		local movedEvent = UnitMovedEvent()
		movedEvent.UnitId = unit.UnitId
		movedEvent.FromCell = result.FromCell
		movedEvent.ToCell = result.ToCell
		self.Entity:SendEvent(movedEvent)

		result.Success = true
		result.Reason = mechanicResult ~= nil and mechanicResult.Reason or "OK"
		if mechanicResult ~= nil then
			result.MechanicId = mechanicResult.MechanicId
			result.PushedUnitId = mechanicResult.PushedUnitId
			result.PushedFromCell = mechanicResult.PushedFromCell
			result.PushedToCell = mechanicResult.PushedToCell
		end
		log("[BattleMove] success unit=" .. unit.UnitId .. " from=" .. result.FromCell .. " to=" .. result.ToCell .. " x=" .. position.x)
		return result
	end

	@ExecSpace("ServerOnly")
	method table CollectDropsForMovedUnit(any unit, integer cellIndex)
		-- Keeps movement coordination here while BattleDropComponent owns reward transfer and pending-state mutation.
		if unit == nil or unit.Team ~= "Player" then
			return { Success = true, Reason = "NOT_PLAYER", CollectedCount = 0, FailedCount = 0 }
		end
		if isvalid(self.PlayerEntity) == false then
			return { Success = false, Reason = "PLAYER_MISSING", CollectedCount = 0, FailedCount = 0 }
		end
		local dropRuntime = self:EnsureDropStateComponent()
		if dropRuntime == nil then
			return { Success = false, Reason = "DROP_RUNTIME_MISSING", CollectedCount = 0, FailedCount = 0 }
		end
		local battleRecordKey = self.StageId .. ":" .. tostring(self.EntryRequestId)
		local result = dropRuntime:CollectAtCell(self.PlayerEntity, battleRecordKey, cellIndex)
		if result.FailedCount > 0 then
			log_warning("[BattleDrop] player pickup partial cell=" .. cellIndex .. " failed=" .. result.FailedCount)
		end
		return result
	end

	method Entity FindUnitEntity(string unitId)
		-- Delegates logical unit lookup to the map-scoped BoardState registry.
		if self.BoardState == nil then
			return nil
		end
		return self.BoardState:FindByUnitId(unitId)
	end

	@ExecSpace("ServerOnly")
	method any GetSkillRuntimeState(string unitId)
		local unitEntity = self:FindUnitEntity(unitId)
		if isvalid(unitEntity) == false then
			return nil
		end
		return unitEntity:GetComponent("script.SkillRuntimeStateComponent")
	end

	@ExecSpace("ServerOnly")
	method void AdvancePlayerSkillCooldowns(string reason)
		-- A guard lasts through one enemy round; utilities share the existing turn cooldown clock.
		if isvalid(self.PlayerEntity) then
			local unit = self.PlayerEntity:GetComponent("script.BattleUnitComponent")
			if unit ~= nil then unit.UtilityGuardActive = false end
		end
		local runtimeState = self:GetSkillRuntimeState("player_01")
		if runtimeState == nil then
			log_warning("[BattleCooldown] advance skipped reason=SKILL_RUNTIME_STATE_MISSING turn=" .. self.TurnNumber)
			return
		end
		runtimeState:AdvanceCooldowns(1, reason)
		self.UtilityRemainingCooldown = runtimeState:GetRemainingCooldown(self.UtilitySkillId)
	end

	@ExecSpace("ServerOnly")
	method void AdvanceEnemySkillCooldowns(string enemyUnitId, string reason)
		-- Enemy cooldowns advance on that enemy's own action, independent of player queue size.
		local runtimeState = self:GetSkillRuntimeState(enemyUnitId)
		if runtimeState == nil then
			return
		end
		runtimeState:AdvanceCooldowns(1, reason)
	end

	method boolean IsCellOccupied(integer cellIndex, string ignoredUnitId)
		-- Delegates living-cell occupancy to the map-scoped BoardState registry.
		if self.BoardState == nil then
			return false
		end
		return isvalid(self.BoardState:FindAtCell(cellIndex, ignoredUnitId))
	end

	method number GetBoardCenterX()
		-- Calculates the visual center of the current logical battle board.
		return self.CellStartX + self.CellSpacing * (self.CellCount - 1) * 0.5
	end

	@ExecSpace("Client")
	method void LockBoardCamera(number boardCenterX)
		-- Switches away from the moving player to a fixed board-center camera target.
		local player = _UserService.LocalPlayer
		if isvalid(player) == false or player.CameraComponent == nil then
			log_error("[BattleCamera] local player camera missing")
			return
		end

		local anchor = self.Entity:GetChildByName("BattleCameraAnchor", false)
		if isvalid(anchor) == false or anchor.CameraComponent == nil or anchor.TransformComponent == nil then
			log_error("[BattleCamera] BattleCameraAnchor missing")
			return
		end

		local playerCamera = player.CameraComponent
		local boardCamera = anchor.CameraComponent
		local anchorX = anchor.TransformComponent.WorldPosition.x
		boardCamera.CameraOffset = Vector2(boardCenterX - anchorX, playerCamera.CameraOffset.y)
		boardCamera.ScreenOffset = playerCamera.ScreenOffset
		boardCamera.ZoomRatio = playerCamera.ZoomRatio
		boardCamera.ConfineCameraArea = false
		boardCamera.Damping = Vector2(0, 0)
		boardCamera.DeadZone = Vector2(0, 0)
		boardCamera.SoftZone = Vector2(0, 0)

		_CameraService.TransitionBlendTime = 0
		_CameraService:SwitchCameraTo(boardCamera)
		log("[BattleCamera] fixed anchor active centerX=" .. boardCenterX .. " anchorX=" .. anchorX .. " offsetX=" .. boardCamera.CameraOffset.x)
	end

	@ExecSpace("Client")
	method void StopImpactCameraShake()
		if self.ImpactCameraShakeMidTimerId > 0 then
			_TimerService:ClearTimer(self.ImpactCameraShakeMidTimerId)
			self.ImpactCameraShakeMidTimerId = 0
		end
		if self.ImpactCameraShakeLateTimerId > 0 then
			_TimerService:ClearTimer(self.ImpactCameraShakeLateTimerId)
			self.ImpactCameraShakeLateTimerId = 0
		end
		if self.ImpactCameraShakeRestoreTimerId > 0 then
			_TimerService:ClearTimer(self.ImpactCameraShakeRestoreTimerId)
			self.ImpactCameraShakeRestoreTimerId = 0
		end
		local anchor = self.Entity:GetChildByName("BattleCameraAnchor", false)
		if self.HasImpactCameraBaseOffset and isvalid(anchor) and anchor.CameraComponent ~= nil then
			anchor.CameraComponent.CameraOffset = self.ImpactCameraBaseOffset
		end
		self.HasImpactCameraBaseOffset = false
	end

	@ExecSpace("Client")
	method void PlayImpactCameraShake(boolean strongHit)
		-- Reuses the fixed board camera and restores its exact offset; no camera controller is replaced.
		self:StopImpactCameraShake()
		local anchor = self.Entity:GetChildByName("BattleCameraAnchor", false)
		if isvalid(anchor) == false or anchor.CameraComponent == nil then
			return
		end
		local boardCamera = anchor.CameraComponent
		local baseOffset = boardCamera.CameraOffset
		local amplitude = strongHit and self.StrongCameraShakeAmplitude or self.NormalCameraShakeAmplitude
		local duration = math.max(0.05, math.min(0.10, self.ImpactCameraShakeDuration))
		self.ImpactCameraBaseOffset = baseOffset
		self.HasImpactCameraBaseOffset = true
		boardCamera.CameraOffset = Vector2(baseOffset.x + amplitude, baseOffset.y + amplitude * 0.35)
		self.ImpactCameraShakeMidTimerId = _TimerService:SetTimerOnce(function()
			if boardCamera ~= nil and isvalid(boardCamera.Entity) then
				boardCamera.CameraOffset = Vector2(baseOffset.x - amplitude * 0.65, baseOffset.y - amplitude * 0.25)
			end
			self.ImpactCameraShakeMidTimerId = 0
		end, duration * 0.34)
		self.ImpactCameraShakeLateTimerId = _TimerService:SetTimerOnce(function()
			if boardCamera ~= nil and isvalid(boardCamera.Entity) then
				boardCamera.CameraOffset = Vector2(baseOffset.x + amplitude * 0.25, baseOffset.y)
			end
			self.ImpactCameraShakeLateTimerId = 0
		end, duration * 0.68)
		self.ImpactCameraShakeRestoreTimerId = _TimerService:SetTimerOnce(function()
			if boardCamera ~= nil and isvalid(boardCamera.Entity) then
				boardCamera.CameraOffset = baseOffset
			end
			self.ImpactCameraShakeRestoreTimerId = 0
			self.HasImpactCameraBaseOffset = false
		end, duration)
		log("[BattleCamera] impact shake strong=" .. tostring(strongHit) .. " amplitude=" .. tostring(amplitude) .. " duration=" .. tostring(duration))
	end

	method boolean IsValidCell(integer cellIndex)
		-- Returns whether the logical cell index is inside the six-cell board.
		return cellIndex >= 0 and cellIndex < self.CellCount
	end

	method Vector2 GetCellPosition(integer cellIndex)
		-- Converts a zero-based logical cell index into the current map's world position.
		local x = self.CellStartX + self.CellSpacing * cellIndex
		return Vector2(x, self.UnitY)
	end

	@ExecSpace("ServerOnly")
	method void PlaceEntity(Entity targetEntity, Vector2 position)
		-- Places Body-based players through MovementComponent and static units through TransformComponent.
		if targetEntity.MovementComponent ~= nil then
			targetEntity.MovementComponent:SetPosition(position)
			return
		end

		if targetEntity.TransformComponent == nil then
			log_error("[BattleSession] TransformComponent missing entity=" .. targetEntity.Name)
			return
		end

		local current = targetEntity.TransformComponent.Position
		local groundVisualOffsetY = 0
		local presentation = targetEntity:GetComponent("script.BattleUnitPresentationComponent")
		if presentation ~= nil then
			groundVisualOffsetY = tonumber(presentation.GroundVisualOffsetY) or 0
		end
		targetEntity.TransformComponent.Position = Vector3(position.x, position.y + groundVisualOffsetY, current.z)
	end

	@ExecSpace("ServerOnly")
	method number GetPlayerMoveDuration()
		-- One deterministic duration owns both horizontal interpolation and the cosmetic player hop.
		return _PlayerGridMovementLogic:GetDuration(_PlayerGridMovementLogic:GetProfile(self))
	end

	@ExecSpace("ServerOnly")
	method number GetPlayerHopDuration()
		-- Clamps only the cosmetic avatar hop to the prototype's requested timing range.
		return math.max(0.12, math.min(0.16, self.PlayerHopDuration))
	end

	@ExecSpace("ServerOnly")
	method void PlayUnitMoveHop(Entity targetEntity)
		-- Selects only presentation defaults. Per-character Presentation overrides remain authoritative.
		if targetEntity == nil or isvalid(targetEntity) == false then
			return
		end
		local unit = targetEntity:GetComponent("script.BattleUnitComponent")
		local presentation = targetEntity:GetComponent("script.BattleUnitPresentationComponent")
		if unit == nil or presentation == nil then
			log_warning("[CharacterHopVisual] skipped reason=UNIT_PRESENTATION_UNAVAILABLE entity=" .. tostring(targetEntity.Name))
			return
		end

		if unit.Team == "Player" then
			_PlayerGridMovementLogic:PlayHop(targetEntity, unit.UnitId, _PlayerGridMovementLogic:GetProfile(self))
			return
		end

		if unit.Team == "Enemy" and self.EnableEnemyHopVisual then
			local movementMotionRuid = "" -- Keep the actor's sprite when no per-enemy motion is authored.
			local movementMotionPlayRate = self.EnemyHopAnimationPlayRate
			if presentation.MovementMotionRuid ~= nil and presentation.MovementMotionRuid ~= "" then
				movementMotionRuid = presentation.MovementMotionRuid
				movementMotionPlayRate = presentation.MovementMotionPlayRate
			end
			presentation:PlayMoveHop(
				unit.UnitId,
				math.max(0.12, math.min(0.16, self.EnemyHopDuration)),
				self.EnemyHopHeight,
				self.EnemyHopTakeoffSquashDuration,
				self.EnemyHopLandingSquashDuration,
				self.EnemyHopSquashXScale,
				self.EnemyHopSquashYScale,
				self.EnemyHopLandingXScale,
				self.EnemyHopLandingYScale,
				self.EnemyHopPeakProgress,
				movementMotionRuid,
				movementMotionPlayRate,
				true
			)
		end
	end

	@ExecSpace("ServerOnly")
	method table GetEnemyMoveHopProfile(Entity targetEntity)
		-- Resolves one server-side snapshot for both position and client appearance timing.
		local profile = {
			Enabled = self.EnableEnemyHopVisual,
			Duration = self.EnemyHopDuration,
			Height = self.EnemyHopHeight,
			Takeoff = self.EnemyHopTakeoffSquashDuration,
			Landing = self.EnemyHopLandingSquashDuration,
			SquashX = self.EnemyHopSquashXScale,
			SquashY = self.EnemyHopSquashYScale,
			LandingX = self.EnemyHopLandingXScale,
			LandingY = self.EnemyHopLandingYScale,
			Peak = self.EnemyHopPeakProgress,
			-- A global monster clip can replace an unrelated enemy sprite. Only use per-enemy authored motion.
			AnimationRuid = "",
			AnimationPlayRate = self.EnemyHopAnimationPlayRate
		}
		local presentation = targetEntity:GetComponent("script.BattleUnitPresentationComponent")
		if presentation ~= nil then
			if presentation.MovementMotionRuid ~= "" then
				profile.AnimationRuid = presentation.MovementMotionRuid
				profile.AnimationPlayRate = presentation.MovementMotionPlayRate
			end
			if presentation.UseCustomMoveHopProfile then
				profile.Enabled = profile.Enabled and presentation.CustomMoveHopEnabled
				profile.Duration = presentation.CustomMoveHopDuration
				profile.Height = presentation.CustomMoveHopHeight
				profile.Takeoff = presentation.CustomMoveHopTakeoffDuration
				profile.Landing = presentation.CustomMoveHopLandingDuration
				profile.SquashX = presentation.CustomMoveHopSquashScale.x
				profile.SquashY = presentation.CustomMoveHopSquashScale.y
				profile.LandingX = presentation.CustomMoveHopLandingScale.x
				profile.LandingY = presentation.CustomMoveHopLandingScale.y
				profile.Peak = presentation.CustomMoveHopPeakProgress
				if presentation.CustomMoveHopAnimationRuid ~= "" then
					profile.AnimationRuid = presentation.CustomMoveHopAnimationRuid
					profile.AnimationPlayRate = presentation.CustomMoveHopAnimationPlayRate
				end
			end
		end
		local actionDuration = math.max(0.05, self.EnemyMoveActionDuration)
		profile.Duration = profile.Enabled and math.max(actionDuration, math.max(0.12, math.min(0.16, profile.Duration))) or actionDuration
		profile.Height = profile.Enabled and math.max(0, profile.Height) or 0
		profile.Peak = math.max(0.45, math.min(0.55, profile.Peak))
		return profile
	end

	@ExecSpace("ServerOnly")
	method boolean StartEnemyGridMovePresentation(Entity targetEntity, integer fromCell, integer toCell)
		-- Ordinary enemy moves share the player curve, with all position axes owned by the server.
		if isvalid(targetEntity) == false or targetEntity.TransformComponent == nil then
			log_warning("[EnemyMoveVisual] skipped reason=TRANSFORM_UNAVAILABLE")
			return false
		end
		local unit = targetEntity:GetComponent("script.BattleUnitComponent")
		if unit == nil or unit.IsDead or unit.IsAirborne then
			return false
		end
		self:FinishEnemyGridMovePresentation("REPLACED", false)
		local profile = self:GetEnemyMoveHopProfile(targetEntity)
		local startPosition = self:GetCellPosition(fromCell)
		self:PlaceEntity(targetEntity, startPosition)
		self._T.enemyGridMove = {
			Entity = targetEntity,
			UnitId = unit.UnitId,
			FromCell = fromCell,
			ToCell = toCell,
			StartPosition = startPosition,
			TargetPosition = self:GetCellPosition(toCell),
			Elapsed = 0,
			Duration = profile.Duration,
			Height = profile.Height,
			Peak = profile.Peak,
			TimerId = 0,
			CompleteAction = nil,
			LoggedIntermediate = false
		}
		local presentation = targetEntity:GetComponent("script.BattleUnitPresentationComponent")
		if presentation ~= nil and profile.Enabled then
			presentation:PlayMoveHop(unit.UnitId, profile.Duration, profile.Height, profile.Takeoff, profile.Landing,
				profile.SquashX, profile.SquashY, profile.LandingX, profile.LandingY, profile.Peak,
				profile.AnimationRuid, profile.AnimationPlayRate, false)
		end
		log("[EnemyMoveVisual] started unit=" .. unit.UnitId .. " from=" .. tostring(fromCell)
			.. " to=" .. tostring(toCell) .. " duration=" .. tostring(profile.Duration)
			.. " height=" .. tostring(profile.Height) .. " curve=" .. tostring(self.MoveCurve))
		return true
	end

	@ExecSpace("ServerOnly")
	method void UpdateEnemyGridMove(number delta)
		-- Advances one accepted move without touching logical occupancy or emitting another move event.
		local movement = self._T.enemyGridMove
		if movement == nil then
			return
		end
		if self.BattleResult ~= "" then
			self:FinishEnemyGridMovePresentation("BATTLE_ENDED", false)
			return
		end
		if isvalid(self.PlayerEntity) == false or self.PlayerEntity.CurrentMap ~= self.Entity then
			self:FinishEnemyGridMovePresentation("PLAYER_LEFT_MAP", false)
			return
		end
		local targetEntity = movement.Entity
		if isvalid(targetEntity) == false or targetEntity.TransformComponent == nil then
			self:FinishEnemyGridMovePresentation("ENTITY_REMOVED", true)
			return
		end
		local unit = targetEntity:GetComponent("script.BattleUnitComponent")
		if unit == nil or unit.IsDead or unit.IsAirborne or unit.CellIndex ~= movement.ToCell
			or targetEntity.CurrentMap ~= self.Entity then
			self:FinishEnemyGridMovePresentation("UNIT_INTERRUPTED", true)
			return
		end
		movement.Elapsed = movement.Elapsed + math.max(0, delta)
		local progress = math.min(1, movement.Elapsed / movement.Duration)
		if progress >= 1 then
			self:FinishEnemyGridMovePresentation("VISUAL_COMPLETE", true)
			return
		end
		local eased = self:EvaluatePlayerMoveCurve(progress)
		local x = movement.StartPosition.x + (movement.TargetPosition.x - movement.StartPosition.x) * eased
		if math.abs(movement.TargetPosition.x - x) <= math.max(0, self.MoveSnapThreshold) then
			x = movement.TargetPosition.x
		end
		local yOffset = 0
		if progress <= movement.Peak then
			yOffset = math.sin(progress / movement.Peak * math.pi * 0.5) * movement.Height
		else
			yOffset = math.cos((progress - movement.Peak) / (1 - movement.Peak) * math.pi * 0.5) * movement.Height
		end
		self:PlaceEntity(targetEntity, Vector2(x, movement.TargetPosition.y + yOffset))
		if movement.LoggedIntermediate == false and progress > 0 then
			movement.LoggedIntermediate = true
			log("[EnemyMoveVisual] intermediate unit=" .. movement.UnitId .. " progress=" .. tostring(progress)
				.. " x=" .. tostring(x) .. " yOffset=" .. tostring(yOffset))
		end
	end

	@ExecSpace("ServerOnly")
	method void FinishEnemyGridMovePresentation(string reason, boolean completeAction)
		-- Releases ownership before callbacks, so visual completion and fallback cannot finish twice.
		local movement = self._T.enemyGridMove
		if movement == nil then
			return
		end
		self._T.enemyGridMove = nil
		if movement.TimerId > 0 then
			_TimerService:ClearTimer(movement.TimerId)
			if self.ActionTimerId == movement.TimerId then
				self.ActionTimerId = 0
			end
		end
		local targetEntity = movement.Entity
		if isvalid(targetEntity) then
			local unit = targetEntity:GetComponent("script.BattleUnitComponent")
			if targetEntity.TransformComponent ~= nil and targetEntity.CurrentMap == self.Entity then
				local cell = unit ~= nil and unit.CellIndex or movement.ToCell
				self:PlaceEntity(targetEntity, self:GetCellPosition(cell))
			end
			local presentation = targetEntity:GetComponent("script.BattleUnitPresentationComponent")
			if presentation ~= nil then
				presentation:StopMoveHopVisual(reason)
			end
		end
		log("[EnemyMoveVisual] completed unit=" .. movement.UnitId .. " from=" .. tostring(movement.FromCell)
			.. " to=" .. tostring(movement.ToCell) .. " reason=" .. reason .. " completeAction=" .. tostring(completeAction))
		if completeAction and movement.CompleteAction ~= nil and self.BattleResult == ""
			and isvalid(self.PlayerEntity) and self.PlayerEntity.CurrentMap == self.Entity then
			movement.CompleteAction()
		end
	end

	@ExecSpace("ServerOnly")
	method number EvaluatePlayerMoveCurve(number progress)
		-- Uses the same movement curve as the lobby.
		return _PlayerGridMovementLogic:EvaluateCurve(progress, self.MoveCurve)
	end

	@ExecSpace("ServerOnly")
	method boolean StartPlayerGridMovePresentation(Entity targetEntity, integer fromCell, integer toCell)
		-- Starts the existing horizontal Root presentation and a separate client-only avatar hop.
		if targetEntity == nil or isvalid(targetEntity) == false then
			log_warning("[BattleMoveVisual] start skipped because player entity is invalid")
			return false
		end

		-- This is defensive only. The existing immediate-action lock prevents a second valid move.
		self:FinishPlayerGridMovePresentation("REPLACED")

		local startPosition = self:GetCellPosition(fromCell)
		local targetPosition = self:GetCellPosition(toCell)
		self:PlaceEntity(targetEntity, startPosition)
		self._T.playerGridMove = {
			Entity = targetEntity,
			StartPosition = startPosition,
			TargetPosition = targetPosition,
			Elapsed = 0,
			Duration = self:GetPlayerMoveDuration(),
			FromCell = fromCell,
			ToCell = toCell
		}
		self:PlayUnitMoveHop(targetEntity)

		log("[BattleMoveVisual] started from=" .. tostring(fromCell)
			.. " to=" .. tostring(toCell)
			.. " duration=" .. tostring(self._T.playerGridMove.Duration)
			.. " curve=" .. tostring(self.MoveCurve)
			.. " snap=" .. tostring(self.MoveSnapThreshold))
		return true
	end

	@ExecSpace("ServerOnly")
	method void UpdatePlayerGridMove(number delta)
		local movement = self._T.playerGridMove
		if movement == nil then
			return
		end

		local targetEntity = movement.Entity
		if targetEntity == nil or isvalid(targetEntity) == false then
			self._T.playerGridMove = nil
			log_warning("[BattleMoveVisual] cancelled because player entity became invalid")
			return
		end

		local step = _PlayerGridMovementLogic:Advance(movement, delta, self.MoveCurve, self.MoveSnapThreshold)
		if step.Complete then
			self:FinishPlayerGridMovePresentation("VISUAL_COMPLETE")
			return
		end
		self:PlaceEntity(targetEntity, step.Position)
	end

	@ExecSpace("ServerOnly")
	method void FinishPlayerGridMovePresentation(string reason)
		local movement = self._T.playerGridMove
		if movement == nil then
			return
		end

		self._T.playerGridMove = nil
		local targetEntity = movement.Entity
		if targetEntity == nil or isvalid(targetEntity) == false then
			return
		end

		local targetPosition = movement.TargetPosition
		self:PlaceEntity(targetEntity, targetPosition)
		log("[BattleMoveVisual] completed from=" .. tostring(movement.FromCell)
			.. " to=" .. tostring(movement.ToCell)
			.. " reason=" .. tostring(reason)
			.. " snappedX=" .. tostring(targetPosition.x)
			.. " snappedY=" .. tostring(targetPosition.y))

		if reason == "VISUAL_COMPLETE"
			and self.TurnState ~= nil
			and self.TurnState.QueuedActionType == "MOVE"
			and self.TurnState.IsActionProcessing == true then
			if self.ActionTimerId > 0 then
				_TimerService:ClearTimer(self.ActionTimerId)
				self.ActionTimerId = 0
			end
			local completionReason = movement.CompletionReason or "MOVE_VISUAL_COMPLETE"
			log("[BattleTurnTempo] player move completed by visual snap reason=" .. completionReason)
			self:CompleteQueuedAction("MOVE", true, completionReason)
		end
	end

	@ExecSpace("ServerOnly")
	method void TryStartBattle()
		-- Enters the first player turn after a player and at least one wave enemy have registered.
		if self:IsContentValidationReady() == false then
			return
		end
		local playerEntity = self:FindUnitEntity("player_01")
		if isvalid(playerEntity) == false or self.BoardState == nil then
			return
		end
		local livingEnemies = self.BoardState:CollectLivingEnemies()
		if #livingEnemies == 0 then
			return
		end
		self.PlayerEntity = playerEntity
		self.EnemyEntity = livingEnemies[1]

		if self.BattlePhase == "PlayerTurn" then
			return
		end

		self.TurnState:OpenPlayerTurn(1, "BATTLE_READY")
		self:PublishTurnStateSnapshot("BATTLE_READY")
		self.WaveRuntime:MarkWaveActive("BATTLE_READY")
		self:PublishWaveStateSnapshot("BATTLE_READY")
		self.StageTurnNumber = 1
		self:ProcessAugmentTrigger("TURN_START", "TURN:1", 0)
		log("[BattleSession] ready phase=" .. self.BattlePhase .. " stage=" .. self.StageNumber .. " wave=" .. self.CurrentWave .. "/" .. self.TotalWaves .. " turn=" .. self.TurnNumber .. " playerCell=" .. self.PlayerStartCell .. " livingEnemies=" .. #livingEnemies .. " enemyHp=" .. self.CurrentEnemyMaxHp)
		log("[BattleSession] battle started stageId=" .. self.StageId .. " wave=" .. self.CurrentWave)
		self:PrepareEnemyIntent()
	end

	@ExecSpace("ServerOnly")
	method void RefreshHudProgressSnapshot()
		-- Presentation only. Never validate or gate battle entry through this optional path.
		local run = nil
		if isvalid(self.PlayerEntity) then run = self.PlayerEntity:GetComponent("script.PlayerRunStateComponent") end
		local graphId = run ~= nil and run.CurrentNodeGraphId or ""
		local nodeId = run ~= nil and run.CurrentNodeId or ""
		local context = self.StageId .. "~" .. tostring(self.EntryRequestId) .. "~" .. tostring(self.HudContextRevision)
		local cacheKey = context .. "~" .. self.RegionId .. "~" .. graphId .. "~" .. nodeId .. "~" .. tostring(run ~= nil and run.RunSequence or 0)
		if self._T.HudProgressCacheKey == cacheKey then return end
		self._T.HudProgressCacheKey = cacheKey
		self.HudProgressSnapshot = ""
		-- Reward-map transitions may retain the completed Run node. The HUD follows
		-- the active battle StageId without changing authoritative Run progression.
		local currentNode = _NodeDefinitionRepositoryLogic:FindNodeByStageId(self.StageId)
		if currentNode.Success ~= true then return end
		graphId = currentNode.NodeGraphId
		local graph = _NodeDefinitionRepositoryLogic:GetGraphDefinitions(graphId)
		if graph.Success ~= true then return end
		local nodes = {}
		local battles = {}
		local stages = {}
		local count = 0
		for _, node in ipairs(graph.Definitions) do
			if node.Enabled == true then
				if nodes[node.NodeId] ~= nil then return end
				nodes[node.NodeId] = node
				if node.NodeType == "BATTLE" or node.NodeType == "BOSS" then
					local stage = _StageDefinitionRepositoryLogic:GetStageDefinition(node.StageId)
					if stage.Success ~= true or stage.MatchCount ~= 1 then return end
					if stage.StageType ~= "NORMAL" and stage.StageType ~= "BOSS" then return end
					stages[node.NodeId] = stage
					if stage.RegionId == self.RegionId then
						battles[node.NodeId] = node
						count = count + 1
					end
				end
			end
		end
		if battles[currentNode.NodeId] == nil or count == 0 then return end
		local nextBattle = {}
		local incoming = {}
		for id, battle in pairs(battles) do
			local cursor = battle
			local seen = {}
			-- A boss is the regional endpoint; outgoing shops/regions are not part of this strip.
			if stages[id].StageType ~= "BOSS" then
				while cursor ~= nil do
					if seen[cursor.NodeId] then return end
					seen[cursor.NodeId] = true
					local nextId = nil
					for candidate in string.gmatch(cursor.NextNodeIds or "", "([^|]+)") do
						if nextId ~= nil then return end
						nextId = candidate
					end
					if nextId == nil then break end
					cursor = nodes[nextId]
					if cursor == nil then return end
					if stages[nextId] ~= nil then
						if battles[nextId] ~= nil then
							nextBattle[id] = nextId
							incoming[nextId] = (incoming[nextId] or 0) + 1
						end
						break
					end
					if cursor.NodeType ~= "REST" and cursor.NodeType ~= "SHOP" then return end
				end
			end
		end
		local head = nil
		for id, _ in pairs(battles) do
			if (incoming[id] or 0) > 1 then return end
			if incoming[id] == nil then
				if head ~= nil then return end
				head = id
			end
		end
		local entries = { context }
		local visited = {}
		local visitedStages = {}
		local included = 0
		local foundCurrent = false
		while head ~= nil do
			if visited[head] then return end
			visited[head] = true
			local stage = stages[head]
			if visitedStages[stage.StageId] or string.find(stage.StageId, "[~|]") ~= nil then return end
			visitedStages[stage.StageId] = true
			if stage.StageId == self.StageId then foundCurrent = true end
			table.insert(entries, stage.StageId .. "~" .. stage.StageType)
			included = included + 1
			head = nextBattle[head]
		end
		if included ~= count or not foundCurrent then return end
		self.HudProgressSnapshot = table.concat(entries, "|")
	end

	@ExecSpace("ServerOnly")
	method void RefreshHudRelicSnapshot()
		-- Optional display data only; membership and quantities stay owned by the run inventory.
		local player = self.PlayerEntity
		if not isvalid(player) or player.CurrentMap ~= self.Entity then
			self.HudRelicSnapshot = ""
			self._T.HudRelicCache = nil
			return
		end
		local inventory = player:GetComponent("script.PlayerRunInventoryComponent")
		if inventory == nil or inventory.ActiveRunSequence <= 0 or _RelicDefinitionRepositoryLogic == nil then
			self.HudRelicSnapshot = ""
			self._T.HudRelicCache = nil
			return
		end
		local snapshot = inventory.RunItemSnapshot or ""
		local context = self.StageId .. "~" .. tostring(self.EntryRequestId) .. "~" .. tostring(self.HudContextRevision)
		local cached = self._T.HudRelicCache
		if cached ~= nil and cached.Inventory == inventory and cached.Context == context
			and cached.RunSequence == inventory.ActiveRunSequence and cached.Revision == inventory.InventoryRevision
			and cached.Snapshot == snapshot then return end
		local items = {}
		local seen = {}
		for entry in string.gmatch(snapshot, "([^|]+)") do
			local itemId, amount = string.match(entry, "^([^~]+)~([^~]+)$")
			local quantity = tonumber(amount) or 0
			if itemId ~= nil and quantity > 0 and not seen[itemId] then
				seen[itemId] = true
				local effects = player:GetComponent("script.PlayerRunRelicEffectComponent")
				local definition = effects ~= nil and effects.ActiveRunSequence == inventory.ActiveRunSequence and effects.Definitions[itemId] or nil
				local ok = definition ~= nil
				if ok and definition ~= nil and definition.Success == true then
					table.insert(items, { RelicId = itemId, DisplayName = definition.DisplayName,
						IconImageRUID = definition.IconImageRUID, EffectDescription = definition.EffectDescription, Quantity = quantity })
				end
			end
		end
		-- Preserve snapshot order (stable ItemId order); it is not acquisition order.
		self.HudRelicSnapshot = ""
		if #items > 0 then
			self.HudRelicSnapshot = _HttpService:JSONEncode({ Items = items, ItemSnapshot = snapshot,
			UserId = player.PlayerComponent.UserId, RunSequence = inventory.ActiveRunSequence,
			InventoryRevision = inventory.InventoryRevision, MapId = self.Entity.Id, StageId = self.StageId,
			EntryRequestId = self.EntryRequestId, HudContextRevision = self.HudContextRevision })
		end
		self._T.HudRelicCache = { Inventory = inventory, Context = context, RunSequence = inventory.ActiveRunSequence,
			Revision = inventory.InventoryRevision, Snapshot = snapshot }
	end

	@ExecSpace("ServerOnly")
	method void RecordRunConsumedPlayerTurn()
		-- Observes successful handoff or wave-clearing execution; enemy turns and duplicate commits are excluded.
		if self.TurnState == nil or self.TurnState.BattlePhase ~= "PlayerTurn" or isvalid(self.PlayerEntity) == false then
			return
		end
		local combatStats = self.PlayerEntity:GetComponent("script.PlayerRunCombatStatsComponent")
		if combatStats == nil then
			return
		end
		local consumptionKey = tostring(self.Entity.Id) .. ":" .. self.StageId .. ":" .. tostring(self.EntryRequestId)
			.. ":" .. tostring(self.HudContextRevision) .. ":" .. tostring(self.TurnState.StateRevision)
		combatStats:RecordConsumedTurn(consumptionKey)
	end

	@ExecSpace("Server")
	method void RequestContinueResult()
		-- Only the registered player can advance an ended, presented battle once.
		if self:IsValidPlayerRequest(senderUserId) == false or self.ResultReady == false then return end
		if self.BattleResult ~= "Victory" and self.BattleResult ~= "Defeat" then return end
		self.ResultReady = false
		if self.ResultRecorded == false then
			self.ResultRecorded = _RunManagerLogic:RecordBattleResult(self.PlayerEntity, self.StageId, self.StageNumber, self.BattleResult, self.EntryRequestId)
			if self.ResultRecorded then self:RefreshUnionRewardPresentation() end
		end
		if self.ResultRecorded == false then self.ResultReady = true return end
		if self.BattleResult == "Defeat" then
			local result = self:ReturnToLobbyAfterDefeat()
			if result.Success == false then self.ResultReady = true end
			self:PublishPlayerCommandResult("RETURN_TO_LOBBY", result)
			return
		end
		if self.UnionRewardRunEnded and self.UnionRewardWasCommitted then
			_StageTransitionManagerLogic:HandleCompletedRunTransition(self.PlayerEntity)
		else
			_StageTransitionManagerLogic:HandleVictoryTransition(self.PlayerEntity, self.StageId)
		end
		local expectedEntry = self.EntryRequestId
		self.ResultTransitionTimerId = _TimerService:SetTimerOnce(function()
			self.ResultTransitionTimerId = 0
			if isvalid(self.PlayerEntity) and self.PlayerEntity.CurrentMap == self.Entity and self.EntryRequestId == expectedEntry then self.ResultReady = true end
		end, 8)
	end

end
