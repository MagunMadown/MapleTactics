	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleMoveKeyDown(KeyDownEvent event)
		-- Converts one movement/turn/attack key press into a server-authoritative request.
		if _RunRelicInventoryUILogic.IsOpen then return end
		local player = _UserService.LocalPlayer
		if isvalid(player) == false or player.CurrentMap ~= self.Entity then
			return
		end
		-- Typing a stat value in the skill test panel must not move or turn the player.
		if self.SkillTestMode == true and _SkillTestLogic.KeyboardCaptured == true then
			return
		end
		if _GameSettingsLogic:IsInputBlocked() then
			return
		end
		-- UI clicks belong to skill selection and dragging, never to world commands.
		if (event.key == KeyboardKey.Mouse0 or event.key == KeyboardKey.Mouse1 or event.key == KeyboardKey.Mouse2)
			and _InputService:IsPointerOverUI() then
			return
		end
		if event.key == KeyboardKey.F8 then
			log("[BattlePrototypeTest] force stage clear requested key=F8")
			self:RequestPrototypeForceStageClear()
			return
		end
		-- Mouse buttons are fixed; keyboard keys come from the player's control settings.
		if event.key == KeyboardKey.Mouse0 or _GameSettingsLogic:IsActionKey("EXECUTE", event.key) then
			log("[BattleInput] execute queue requested")
			_BattleHudPresenterLogic:RequestExecuteQueue()
			return
		end
		if event.key == KeyboardKey.Mouse1 or _GameSettingsLogic:IsActionKey("UTILITY", event.key) then
			_BattleHudPresenterLogic:SubmitLocalCommand("UTILITY", "", 0)
			return
		end
		if event.key == KeyboardKey.Mouse2 or _GameSettingsLogic:IsActionKey("TURN", event.key) then
			_BattleHudPresenterLogic:SubmitLocalCommand("TURN", "", 0)
			return
		end

		local direction = _PlayerGridMovementLogic:GetDirection(event.key)

		if direction ~= 0 then
			_BattleHudPresenterLogic:SubmitLocalCommand("MOVE", "", direction)
		end
	end

	@ExecSpace("ClientOnly")
	method void PreviewLocalTurnFacing()
		-- Delegates to the owner while keeping session state and the public call boundary.
		_BattleMovementPresentationLogic:PreviewLocalTurnFacing(self)
	end

	@ExecSpace("Client")
	method void ConfirmLocalPlayerFacing(string facing)
		-- Delegates to the owner while keeping session state and the public call boundary.
		_BattleMovementPresentationLogic:ConfirmLocalPlayerFacing(self, facing)
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleUnitTurnedEvent(UnitTurnedEvent event)
		-- Confirms that subscribers can observe a completed direction change.
		log("[BattleEvent] UnitTurnedEvent received unit=" .. event.UnitId .. " from=" .. event.PreviousFacing .. " to=" .. event.CurrentFacing)
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleUnitMovedEvent(UnitMovedEvent event)
		-- Confirms that subscribers can observe a completed logical move, then ticks venom poison on the mover.
		log("[BattleEvent] UnitMovedEvent received unit=" .. event.UnitId .. " from=" .. event.FromCell .. " to=" .. event.ToCell)
		if event.FromCell ~= event.ToCell then
			_TutorialRulesLogic:OnUnitMoved(self, event.UnitId, event.FromCell, event.ToCell)
			self:ApplyPoisonOnMove(event.UnitId)
		end
	end

	@ExecSpace("ServerOnly")
	method void ApplyPoisonOnMove(string unitId)
		-- Delegates to the responsible effect executor; battle state stays in this session.
		_CombatModifierEffectExecutorLogic:ApplyPoisonOnMove(self, unitId)
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleBasicAttackResolvedEvent(BasicAttackResolvedEvent event)
		-- Confirms that subscribers receive both hit and miss attack resolutions.
		log("[BattleEvent] BasicAttackResolvedEvent attack=" .. event.AttackId .. " source=" .. event.SourceUnitId .. " target=" .. event.TargetUnitId .. " cell=" .. event.TargetCell .. " hit=" .. tostring(event.Hit) .. " reason=" .. event.Reason .. " damage=" .. event.DamageAmount .. " hp=" .. event.TargetHpBefore .. "->" .. event.TargetHpAfter)
	end

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- Initializes the map-scoped session. Prototype maps may still opt into automatic Stage 1 start.
		log("[BattleSession] begin map=" .. self.Entity.Name .. " cells=" .. self.CellCount .. " autoStart=" .. tostring(self.AutoStartPrototypeBattle))
		local boardState = self:EnsureBoardStateComponent()
		if boardState == nil then
			log_error("[BattleSession] BoardStateComponent unavailable")
			return
		end
		boardState:ResetRegistry("SESSION_BEGIN")
		local waveRuntime = self:EnsureWaveStateComponent()
		if waveRuntime == nil then
			log_error("[BattleSession] BattleWaveComponent unavailable")
			return
		end
		waveRuntime:ResetWaveState(self.TotalWaves, "SESSION_BEGIN")
		self:PublishWaveStateSnapshot("SESSION_BEGIN")
		local turnState = self:EnsureTurnStateComponent()
		if turnState == nil then
			log_error("[BattleSession] BattleTurnComponent unavailable")
			return
		end
		turnState:ResetTurnState(self.TileQueueCapacity, "SESSION_BEGIN")
		self:PublishTurnStateSnapshot("SESSION_BEGIN")
		local enemyIntentRuntime = self:EnsureEnemyIntentComponent()
		if enemyIntentRuntime == nil then
			log_error("[BattleSession] EnemyIntentComponent unavailable")
			return
		end
		enemyIntentRuntime:ResetIntent("SESSION_BEGIN")
		self:PublishEnemyIntentSnapshot("SESSION_BEGIN")
		local dropRuntime = self:EnsureDropStateComponent()
		if dropRuntime == nil then
			log_error("[BattleSession] BattleDropComponent unavailable")
			return
		end
		dropRuntime:ResetDropState("SESSION_BEGIN")
		local contentValidation = self:RunContentValidationGate("SESSION_BEGIN")
		if contentValidation.Success == false then
			log_error("[BattleContentGate] session start blocked reason=" .. contentValidation.Reason .. " errors=" .. contentValidation.ErrorCount)
			return
		end

		-- The map component can begin before the transferred player is visible. OnUpdate
		-- routes the first visible player through OnMapEnter so PREPARED always wins.
		self.EntryPolicyResolved = false
		self.PrototypeTestEntryActive = false
		self.LastInitializedEntryRequestId = 0
		log("[BattleSession] waiting for player entry policy")
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- Hazards belong to this battle only.
		self:ClearPoisonMists()
		-- Prevents a pending action callback from surviving this map-scoped battle session.
		self:ClearMotionCompletionWaits()
		self:ClearPrototypeBattleEntryRetry("SESSION_END")
		self.PrototypeTestEntryActive = false
		self:CancelPlayerCombatPresentationHandoff("SESSION_END", false)
		self:FinishPlayerGridMovePresentation("SESSION_END")
		self._T.playerGridLandingCheck = nil
		self:FinishEnemyGridMovePresentation("SESSION_END", false)
		if self.ActionTimerId > 0 then
			_TimerService:ClearTimer(self.ActionTimerId)
			self.ActionTimerId = 0
		end
		if self.ResultTransitionTimerId > 0 then
			_TimerService:ClearTimer(self.ResultTransitionTimerId)
			self.ResultTransitionTimerId = 0
		end
		self:ClearTurnTransitionTimer("SESSION_END")
		self.PlayerToEnemyBeatPending = false
		self.PendingPlayerToEnemyHandoffDelay = -1
		self:ClearEnemyToEnemyPresentationHandoff("SESSION_END")
		self:ClearSkillImpactTimers()
		if self.TurnState ~= nil then
			self.TurnState:ResetTurnState(self.TileQueueCapacity, "SESSION_END")
			self:PublishTurnStateSnapshot("SESSION_END")
		end
		self.BattleResult = ""
		if self.WaveRuntime ~= nil then
			self.WaveRuntime:ResetWaveState(self.TotalWaves, "SESSION_END")
			self:PublishWaveStateSnapshot("SESSION_END")
		end
		self:ClearPreparedEnemyIntent("END_PLAY")
		if self.BoardState ~= nil then
			self.BoardState:ResetRegistry("SESSION_END")
		end
		if self.DropRuntime ~= nil then
			self.DropRuntime:DiscardPending("SESSION_END")
		end
	end

