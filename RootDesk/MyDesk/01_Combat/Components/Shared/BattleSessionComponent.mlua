	@ExecSpace("ServerOnly")
	method integer RollBoardParity(string unitId, string skillId)
		-- Picks even (0) or odd (1) board cells when a BOARD_PARITY attack is queued; the warning cells and the
		-- impact both read this stored pick, so the attack lands exactly where it was announced.
		if self._T.BoardParity == nil then self._T.BoardParity = {} end
		local parity = _UtilLogic:RandomIntegerRange(0, 1)
		self._T.BoardParity[unitId .. "|" .. skillId] = parity
		log("[BoardParity] rolled unit=" .. unitId .. " skill=" .. skillId .. " parity=" .. parity)
		return parity
	end

	@ExecSpace("ServerOnly")
	method integer GetBoardParity(string unitId, string skillId)
		-- Returns the parity fixed when the attack was queued; an unqueued cast (tests) rolls one on demand.
		local stored = self._T.BoardParity ~= nil and self._T.BoardParity[unitId .. "|" .. skillId] or nil
		if stored == nil then
			return self:RollBoardParity(unitId, skillId)
		end
		return stored
	end

