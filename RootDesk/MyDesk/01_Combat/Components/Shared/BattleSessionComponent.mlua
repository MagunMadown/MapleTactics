	@ExecSpace("ServerOnly")
	method any EnsureBoardStateComponent()
		-- Prefers the dedicated map child so each runtime-state entity owns one script component.
		local boardState = self.Entity:GetComponent("script.BoardStateComponent")
		local stateEntity = self.Entity:GetChildByName("BattleBoardState")
		if stateEntity ~= nil then
			boardState = stateEntity:GetComponent("script.BoardStateComponent")
		end
		if boardState == nil then
			boardState = self.Entity:AddComponent("BoardStateComponent")
		end
		if boardState == nil then
			log_error("[BattleSession] failed to attach BoardStateComponent entity=" .. self.Entity.Name)
			return nil
		end
		self.BoardState = boardState
		return boardState
	end

	@ExecSpace("ServerOnly")
	method any EnsureTurnStateComponent()
		-- BattleTurnComponent is the single mutable owner of turn, action-slot, and skill-queue state.
		local turnState = self.Entity:GetComponent("script.BattleTurnComponent")
		local stateEntity = self.Entity:GetChildByName("BattleTurnState")
		if stateEntity ~= nil then
			turnState = stateEntity:GetComponent("script.BattleTurnComponent")
		end
		if turnState == nil then
			turnState = self.Entity:AddComponent("BattleTurnComponent")
		end
		if turnState == nil then
			log_error("[BattleSession] failed to attach BattleTurnComponent entity=" .. self.Entity.Name)
			return nil
		end
		self.TurnState = turnState
		return turnState
	end

	@ExecSpace("ServerOnly")
	method any EnsureEnemyIntentComponent()
		-- Makes EnemyIntentComponent the single mutable owner of the prepared enemy action snapshot.
		local intentRuntime = self.Entity:GetComponent("script.EnemyIntentComponent")
		local stateEntity = self.Entity:GetChildByName("BattleEnemyIntentState")
		if stateEntity ~= nil then
			intentRuntime = stateEntity:GetComponent("script.EnemyIntentComponent")
		end
		if intentRuntime == nil then
			intentRuntime = self.Entity:AddComponent("EnemyIntentComponent")
		end
		if intentRuntime == nil then
			log_error("[BattleSession] failed to attach EnemyIntentComponent entity=" .. self.Entity.Name)
			return nil
		end
		self.EnemyIntentRuntime = intentRuntime
		return intentRuntime
	end

	@ExecSpace("ServerOnly")
	method void PublishEnemyIntentSnapshot(string reason)
		-- Preserves the existing Session sync contract while EnemyIntentComponent owns mutable state.
		local intentRuntime = self.EnemyIntentRuntime
		if intentRuntime == nil then
			intentRuntime = self:EnsureEnemyIntentComponent()
		end
		if intentRuntime == nil then
			return
		end
		local snapshot = intentRuntime:GetSnapshot()
		self.PreparedEnemyIntentState = snapshot.State
		self.PreparedEnemyId = snapshot.EnemyId
		self.PreparedEnemyPatternId = snapshot.PatternId
		self.PreparedEnemyStepIndex = snapshot.StepIndex
		self.PreparedEnemyActionType = snapshot.ActionType
		self.PreparedEnemyTileId = snapshot.TileId
		self.PreparedEnemyTelegraphTurnsRemaining = snapshot.TelegraphTurnsRemaining
		self.PreparedEnemyDirection = snapshot.Direction
		self.PreparedEnemyTurn = snapshot.PreparedTurn
		self.PreparedEnemyReason = snapshot.Reason
		if reason ~= "" then
			log("[BattleSession] enemy intent snapshot reason=" .. reason .. " state=" .. snapshot.State .. " enemy=" .. snapshot.EnemyId .. " action=" .. snapshot.ActionType .. " revision=" .. snapshot.Revision)
		end
	end

	@ExecSpace("ServerOnly")
	method void PublishEnemyPlanSnapshot(string reason)
		-- The session owns synchronization and revisions; the builder only reads battle state.
		local state = _EnemyPlanSnapshotLogic:BuildSnapshot(self)
		self.EnemyPlanSnapshot = state.Snapshot
		self.EnemyPlanCount = state.Count
		self.EnemyPlanRevision = self.EnemyPlanRevision + 1
		log("[EnemyRoundPlan] publish reason=" .. reason .. " count=" .. self.EnemyPlanCount .. " revision=" .. self.EnemyPlanRevision .. " snapshot=" .. self.EnemyPlanSnapshot)
	end

	@ExecSpace("Server")
	method void RequestEnemySkillHover(string enemyUnitId, string skillId, integer requestId)
		-- Only describes a skill of a living enemy on this board; data tables stay server-only.
		if not self:IsValidPlayerRequest(senderUserId) then return end
		local now = _UtilLogic.ElapsedSeconds
		if now < (self._T.NextEnemySkillHoverRequest or 0) then return end
		self._T.NextEnemySkillHoverRequest = now + 0.08
		local enemyEntity = self:FindUnitEntity(enemyUnitId)
		local enemyUnit = isvalid(enemyEntity) and enemyEntity:GetComponent("script.BattleUnitComponent") or nil
		if enemyUnit == nil or enemyUnit.IsDead or enemyUnit.Team ~= "Enemy" then return end
		local definition = _SkillDefinitionRepositoryLogic:GetSkillDefinition(skillId)
		if definition.Success ~= true then return end
		local hover = _EnemyPlanSnapshotLogic:BuildEnemySkillHover(self, enemyUnitId, enemyUnit, definition)
		self:ReceiveEnemySkillHover(enemyUnitId .. ":" .. skillId, requestId, hover.Text, hover.Cells, senderUserId)
	end

	@ExecSpace("Client")
	method void ReceiveEnemySkillHover(string hoverKey, integer requestId, string text, table cells)
		-- Forwards the server-built enemy skill description to the shared mouse tooltip.
		local root = _EntityService:GetEntityByPath("/ui/MouseTooltipGroup")
		local tooltip = isvalid(root) and root:GetComponent("script.MouseTooltipUIComponent") or nil
		if tooltip ~= nil then tooltip:ReceiveEnemySkillHover(self.Entity, hoverKey, requestId, text, cells) end
	end

	@ExecSpace("ServerOnly")
	method void PublishSkillTargetResolution(string skillId, string targetingType, string targetUnitIds, string targetCellIndices, string reason)
		-- Exposes only the resolved impact snapshot; UI never repeats board targeting rules.
		self.LastSkillTargetSkillId = skillId or ""
		self.LastSkillTargetingType = targetingType or ""
		self.LastSkillTargetUnitIds = targetUnitIds or ""
		self.LastSkillTargetCellIndices = targetCellIndices or ""
		self.LastSkillTargetReason = reason or ""
		self.SkillTargetRevision = self.SkillTargetRevision + 1
		log("[BattleSkillTarget] published skill=" .. self.LastSkillTargetSkillId .. " type=" .. self.LastSkillTargetingType .. " cells=" .. self.LastSkillTargetCellIndices .. " targets=" .. self.LastSkillTargetUnitIds .. " reason=" .. self.LastSkillTargetReason .. " revision=" .. self.SkillTargetRevision)
	end

	@ExecSpace("ServerOnly")
	method void PublishTurnStateSnapshot(string reason)
		-- Temporary compatibility bridge: external readers may keep using BattleSession while the owner is BattleTurnComponent.
		local turnState = self.TurnState
		if turnState == nil then
			turnState = self:EnsureTurnStateComponent()
		end
		if turnState == nil then
			return
		end
		self.BattlePhase = turnState.BattlePhase
		self.TurnNumber = turnState.TurnNumber
		self.QueuedActionType = turnState.QueuedActionType
		self.QueuedActionDirection = turnState.QueuedActionDirection
		self.IsActionProcessing = turnState.IsActionProcessing
		self.QueuedTileIds = turnState.QueuedTileIds
		self.QueuedTileCount = turnState.QueuedTileCount
		self.ExecutingTileIds = turnState.ExecutingTileIds
		self.ExecutingTileIndex = turnState.ExecutingTileIndex
		self.TileQueueCapacity = turnState.TileQueueCapacity
		if reason ~= "" then
			log("[BattleSession] turn snapshot reason=" .. reason .. " phase=" .. self.BattlePhase .. " turn=" .. self.TurnNumber .. " queue=" .. self.QueuedTileCount .. "/" .. self.TileQueueCapacity)
		end
	end

