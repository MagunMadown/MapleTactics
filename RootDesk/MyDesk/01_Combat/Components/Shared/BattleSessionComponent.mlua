	@ExecSpace("ServerOnly")
	method Entity ResolveFrontTarget(string sourceUnitId)
		-- Returns a living opposing unit occupying the source unit's front cell.
		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		if isvalid(sourceEntity) == false then
			return nil
		end

		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit == nil then
			return nil
		end

		local facingDirection = -1
		if sourceUnit.Facing == "Right" then
			facingDirection = 1
		end
		local targetCell = sourceUnit.CellIndex + facingDirection

		if self.BoardState == nil then
			return nil
		end
		local candidate = self.BoardState:FindAtCell(targetCell, sourceUnitId)
		if isvalid(candidate) then
			local unit = candidate:GetComponent("script.BattleUnitComponent")
			if unit ~= nil and (unit.Team ~= sourceUnit.Team or sourceUnit.Team == "Enemy") then
				return candidate
			end
		end
		return nil
	end

	@ExecSpace("Server")
	method void RequestMove(integer direction, integer requestId, integer expectedEntry, integer expectedContext)
		-- Validates the requesting client before forwarding the move to battle state.
		if isvalid(self.PlayerEntity) == false or self.PlayerEntity.PlayerComponent == nil then
			log_warning("[BattleMove] rejected reason=PLAYER_MISSING")
			return
		end

		if self.PlayerEntity.PlayerComponent.UserId ~= senderUserId then
			log_warning("[BattleMove] rejected reason=INVALID_SENDER")
			return
		end
		if self.PlayerEntity.CurrentMap ~= self.Entity or requestId <= 0 or requestId ~= math.floor(requestId) then return end
		local current = self.PlayerEntity.TransformComponent.WorldPosition
		if expectedEntry ~= self.EntryRequestId or expectedContext ~= self.HudContextRevision then
			self:ReceivePlayerMoveResult(requestId, expectedEntry, expectedContext, false, true, current.x, current.y, "BATTLE_CONTEXT_CHANGED", senderUserId)
			return
		end
		local previous = self._T.lastPlayerMoveRequest
		if previous ~= nil and previous.Player == self.PlayerEntity and previous.Entry == expectedEntry
			and previous.Context == expectedContext and requestId <= previous.Id then return end
		self._T.lastPlayerMoveRequest = { Id = requestId, Player = self.PlayerEntity, Entry = expectedEntry, Context = expectedContext }

		if self.BattlePhase ~= "PlayerTurn" then
			local rejected = { Success = false, Reason = "INVALID_PHASE" }
			self:PublishPlayerCommandResult("MOVE", rejected)
			self:ReceivePlayerMoveResult(requestId, expectedEntry, expectedContext, false, true, current.x, current.y, rejected.Reason, senderUserId)
			log_warning("[BattleMove] rejected direction=" .. tostring(direction) .. " reason=INVALID_PHASE phase=" .. tostring(self.BattlePhase))
			return
		end

		local unit = self.PlayerEntity:GetComponent("script.BattleUnitComponent")
		local fromCell = unit ~= nil and unit.CellIndex or -1
		self._T.activePlayerMoveRequest = { Id = requestId, Entry = expectedEntry, Context = expectedContext, UserId = senderUserId }
		local result = self:TryQueuePlayerAction("MOVE", direction)
		self._T.activePlayerMoveRequest = nil
		local accepted = result.Success and unit ~= nil and unit.CellIndex ~= fromCell
		local target = accepted and self:GetCellPosition(unit.CellIndex) or Vector2(current.x, current.y)
		local moving = self._T.playerGridMove ~= nil and self._T.playerGridMove.RequestId == requestId
		self:ReceivePlayerMoveResult(requestId, expectedEntry, expectedContext, accepted, not moving, target.x, target.y, accepted and "MOVE_ACCEPTED" or result.Reason, senderUserId)
		self:PublishPlayerCommandResult("MOVE", result)
		if result.Success == false then
			local message = "[BattleQueue] rejected action=MOVE direction=" .. direction .. " reason=" .. result.Reason
			if _PlayerGridMovementLogic:IsBlockedMoveReason(result.Reason) then log(message) else log_warning(message) end
		end
	end

	@ExecSpace("Client")
	method void ReceivePlayerMoveResult(integer requestId, integer entry, integer context, boolean success, boolean completed, number targetX, number targetY, string reason)
		_PlayerGridMovementLogic:ResolveLocalMove(self.Entity, requestId, entry, context, success, completed, targetX, targetY, reason)
	end

	@ExecSpace("ServerOnly")
	method boolean CanSkeletonSwapWithCommander(string unitId)
		-- Only a Perion commander's summoned soldier may relieve its engaged commander.
		if self.StageId ~= "region_04_stage_04" or self.BattleResult ~= "" or self._T.BossDefeated then
			return false
		end
		local soldierEntity = self:FindUnitEntity(unitId)
		local playerEntity = self:FindUnitEntity("player_01")
		if not isvalid(soldierEntity) or not isvalid(playerEntity) then return false end
		local soldier = soldierEntity:GetComponent("script.BattleUnitComponent")
		local player = playerEntity:GetComponent("script.BattleUnitComponent")
		if soldier == nil or player == nil then return false end
		local commanderEntity = soldier._T.SkeletonCommander
		if not isvalid(commanderEntity) or commanderEntity.CurrentMap ~= self.Entity then return false end
		local commander = commanderEntity:GetComponent("script.BattleUnitComponent")
		if commander == nil or self:FindUnitEntity(commander.UnitId) ~= commanderEntity then return false end
		if (soldier.EnemyDefinitionId ~= "region_04_skeleton_soldier" and soldier.EnemyDefinitionId ~= "region_04_skeleton_officer") or soldier.Team ~= "Enemy"
			or commander.EnemyDefinitionId ~= "region_04_commander_skeleton" or not commander.IsBoss or commander.Team ~= "Enemy" then
			return false
		end
		for _, unit in ipairs({ soldier, commander, player }) do
			if unit.IsDead or unit.CurrentHp <= 0 or unit.IsAirborne or not self:IsValidCell(unit.CellIndex) then return false end
		end
		return soldier.CellIndex ~= commander.CellIndex
			and math.abs(soldier.CellIndex - player.CellIndex) >= 2
			and math.abs(commander.CellIndex - player.CellIndex) == 1
	end

	@ExecSpace("ServerOnly")
	method table SwapSkeletonWithCommander(string unitId)
		-- Revalidate a frozen plan at impact; cooldown was already consumed by skill execution.
		if self.TurnState == nil or self.TurnState.BattlePhase ~= "EnemyTurn" or not self:CanSkeletonSwapWithCommander(unitId) then
			return { Success = false, Reason = "COMMANDER_RELIEF_UNAVAILABLE" }
		end
		local soldierEntity = self:FindUnitEntity(unitId)
		local soldier = soldierEntity:GetComponent("script.BattleUnitComponent")
		local commanderEntity = soldier._T.SkeletonCommander
		local commander = commanderEntity:GetComponent("script.BattleUnitComponent")
		local soldierCell = soldier.CellIndex
		local commanderCell = commander.CellIndex
		-- Leave a commander-owned hazard at the departure cell before committing the swap.
		local poisonCells = {}
		for cell = commanderCell - 1, commanderCell + 1 do
			if self:IsValidCell(cell) then table.insert(poisonCells, cell) end
		end
		self:ExecuteEnemySpecialEffect({ SourceUnitId = commander.UnitId, TargetCellIndices = poisonCells },
			{ EffectType = "POISON_MIST", Value = 1, ParameterA = "2" })
		-- Commit both cells before publishing movement so observers never see an occupied destination.
		soldier:ApplyCellChange(commanderCell)
		commander:ApplyCellChange(soldierCell)
		local player = self:FindUnitEntity("player_01"):GetComponent("script.BattleUnitComponent")
		soldier:ApplyFacingState(player.CellIndex > commanderCell and "Right" or "Left")
		commander:ApplyFacingState(player.CellIndex > soldierCell and "Right" or "Left")
		self:PlaceEntity(soldierEntity, self:GetCellPosition(commanderCell))
		self:PlaceEntity(commanderEntity, self:GetCellPosition(soldierCell))
		self:PlayUnitMoveHop(soldierEntity)
		self:PlayUnitMoveHop(commanderEntity)
		for _, move in ipairs({ { UnitId = unitId, FromCell = soldierCell, ToCell = commanderCell },
			{ UnitId = commander.UnitId, FromCell = commanderCell, ToCell = soldierCell } }) do
			local movedEvent = UnitMovedEvent()
			movedEvent.UnitId = move.UnitId
			movedEvent.FromCell = move.FromCell
			movedEvent.ToCell = move.ToCell
			self.Entity:SendEvent(movedEvent)
		end
		self:PublishEnemyPlanSnapshot("COMMANDER_RELIEF")
		log("[BattleBoss] skeleton relief soldier=" .. unitId .. " commander=" .. commander.UnitId)
		return { Success = true, Reason = "COMMANDER_RELIEVED" }
	end

