	@ExecSpace("Server")
	method void RequestSkillHover(string skillId, integer requestId)
		if not self:IsValidPlayerRequest(senderUserId) then return end
		local owned = false
		for _, id in ipairs(self:ParseSkillSlotPipe(self.SkillSlotIds)) do if id == skillId then owned = true end end
		if not owned then return end
		local now = _UtilLogic.ElapsedSeconds
		if now < (self._T.NextSkillHoverRequest or 0) then return end
		self._T.NextSkillHoverRequest = now + 0.08
		_BattleUiStateLogic:SendSkillHover(self, skillId, requestId, senderUserId)
	end

	@ExecSpace("Client")
	method void ReceiveSkillHover(string skillId, integer requestId, string text, table cells)
		local player = _UserService.LocalPlayer
		if not isvalid(player) or player.CurrentMap ~= self.Entity then return end
		local root = _EntityService:GetEntityByPath("/ui/MouseTooltipGroup")
		local tooltip = isvalid(root) and root:GetComponent("script.MouseTooltipUIComponent") or nil
		if tooltip ~= nil then tooltip:ReceiveSkillHover(self.Entity, skillId, requestId, text, cells) end
	end

