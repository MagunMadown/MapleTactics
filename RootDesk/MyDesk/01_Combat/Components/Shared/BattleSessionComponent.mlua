		_EnemyTurnExecutionLogic:BeginEnemyTurnFromPlayerAction(self, completionReason)
	end

	@ExecSpace("ServerOnly")
	method void AdvanceConsumedPlayerActionEffects(string completionReason)
		-- Every consumed action spends status duration, including queues that clear a wave without an enemy round.
		self:RecordRunConsumedPlayerTurn()
		local playerUnit = isvalid(self.PlayerEntity) and self.PlayerEntity:GetComponent("script.BattleUnitComponent") or nil
		if playerUnit ~= nil then playerUnit:AdvanceNegativeStatusTurns() end
		if self.BoardState ~= nil then
			for _, enemyEntity in ipairs(self.BoardState:CollectLivingEnemies()) do
				local enemy = enemyEntity:GetComponent("script.BattleUnitComponent")
				if enemy ~= nil and enemy.BurnTurns > 0 then enemy:AdvanceNegativeStatusTurns() end
			end
		end
		self:AdvancePoisonMists()
		log("[BattlePlayerActionBoundary] effects advanced reason=" .. completionReason .. " result=" .. self.BattleResult)
	end

