	@ExecSpace("Server")
	method void RequestQueueTile(string tileId)
		-- Validates the requesting player before registering one supported tile in the queue slot.
		if self:IsValidPlayerRequest(senderUserId) == false then
			log_warning("[BattleTileQueue] register rejected tile=" .. tileId .. " reason=INVALID_SENDER")
			return
		end

		local result = self:TryQueueTile(tileId)
		self:PublishPlayerCommandResult("QUEUE_TILE", result)
		if result.Success == false then
			log_warning("[BattleTileQueue] register rejected tile=" .. tileId .. " reason=" .. result.Reason)
		end
	end

	@ExecSpace("Server")
	method void RequestReorderBattleSkillSlot(integer sourceIndex, integer targetIndex, integer requestId, integer expectedRevision)
		-- The client proposes indices only. Skill identities always come from this authoritative session.
		if self:IsValidPlayerRequest(senderUserId) == false then
			log_warning("[BattleSkillSlotReorder] rejected request=" .. tostring(requestId) .. " reason=INVALID_SENDER")
			return
		end
		if requestId <= 0 then
			log_warning("[BattleSkillSlotReorder] rejected request=" .. tostring(requestId) .. " reason=INVALID_REQUEST_ID")
			return
		end
		if requestId <= self.LastProcessedSkillSlotReorderRequestId then
			local replayReason = requestId == self.LastProcessedSkillSlotReorderRequestId and "DUPLICATE_REQUEST" or "STALE_REQUEST"
			log_warning("[BattleSkillSlotReorder] rejected request=" .. tostring(requestId) .. " last=" .. tostring(self.LastProcessedSkillSlotReorderRequestId) .. " reason=" .. replayReason)
			return
		end

		self.LastProcessedSkillSlotReorderRequestId = requestId
		local result = self:TryReorderBattleSkillSlot(sourceIndex, targetIndex, expectedRevision)
		self:PublishSkillSlotReorderReceipt(sourceIndex, targetIndex, result)
	end

