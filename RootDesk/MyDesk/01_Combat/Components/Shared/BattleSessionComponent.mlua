	method any EnsurePresentationComponent(Entity targetEntity)
		-- Attaches optional visual behavior to runtime-created players while preserving placed enemy settings.
		local presentation = targetEntity:GetComponent("script.BattleUnitPresentationComponent")
		if presentation == nil then
			presentation = targetEntity:AddComponent("BattleUnitPresentationComponent")
		end

		if presentation == nil then
			log_error("[BattleSession] failed to attach BattleUnitPresentationComponent entity=" .. targetEntity.Name)
		end
		return presentation
	end

	@ExecSpace("ServerOnly")
	method any EnsureSkillRuntimeStateComponent(Entity targetEntity)
		-- Keeps mutable cooldowns on their owning unit rather than the map session.
		local runtimeState = targetEntity:GetComponent("script.SkillRuntimeStateComponent")
		if runtimeState == nil then
			runtimeState = targetEntity:AddComponent("SkillRuntimeStateComponent")
		end
		if runtimeState == nil then
			log_error("[BattleSession] failed to attach SkillRuntimeStateComponent entity=" .. targetEntity.Name)
		end
		return runtimeState
	end

	@ExecSpace("ServerOnly")
	method void ConfigureUnit(Entity targetEntity, string unitId, string team, integer cellIndex, string facing, number maxHp, integer spawnOrder)
		-- Convenience path for player units; enemies defer registry visibility until definition setup completes.
		local initialization = self:InitializeUnitState(targetEntity, unitId, team, cellIndex, facing, maxHp, spawnOrder)
		if initialization.Success == false then
			log_error("[BattleSession] unit initialization failed unit=" .. unitId .. " reason=" .. initialization.Reason)
			return
		end
		local registration = self:RegisterConfiguredUnit(targetEntity)
		if registration.Success == false then
			log_error("[BattleSession] registry rejected unit=" .. unitId .. " reason=" .. registration.Reason)
		end
	end

	@ExecSpace("ServerOnly")
	method table InitializeUnitState(Entity targetEntity, string unitId, string team, integer cellIndex, string facing, number maxHp, integer spawnOrder)
		-- Builds a complete unit object before it becomes visible to BoardState and turn planning.
		if self:IsValidCell(cellIndex) == false then
			return { Success = false, Reason = "INVALID_INITIAL_CELL" }
		end

		local unit = self:EnsureUnitComponent(targetEntity)
		if unit == nil then
			return { Success = false, Reason = "UNIT_COMPONENT_MISSING" }
		end
		self:EnsurePresentationComponent(targetEntity)
		local skillRuntimeState = self:EnsureSkillRuntimeStateComponent(targetEntity)
		if skillRuntimeState == nil then
			return { Success = false, Reason = "SKILL_RUNTIME_STATE_MISSING" }
		end
		skillRuntimeState:ResetSkillRuntimeState("UNIT_CONFIGURED")

		local initializeResult = unit:InitializeBattleState(unitId, team, cellIndex, facing, maxHp, spawnOrder)
		if initializeResult.Success == false then
			return initializeResult
		end
		self:ApplyFacing(targetEntity, facing)

		local position = self:GetCellPosition(cellIndex)
		self:PlaceEntity(targetEntity, position)
		if team == "Player" and targetEntity.PlayerComponent ~= nil then
			self:LockBoardCamera(self:GetBoardCenterX(), targetEntity.PlayerComponent.UserId)
		end
		return { Success = true, Reason = "UNIT_STATE_INITIALIZED", UnitId = unitId, PositionX = position.x }
	end

	@ExecSpace("ServerOnly")
	method table RegisterConfiguredUnit(Entity targetEntity)
		local unit = targetEntity:GetComponent("script.BattleUnitComponent")
		if unit == nil then return { Success = false, Reason = "UNIT_COMPONENT_MISSING" } end
		if self.BoardState == nil then
			return { Success = false, Reason = "REGISTRY_MISSING" }
		end
		local registerResult = self.BoardState:RegisterUnit(targetEntity)
		if registerResult.Success == false then
			return registerResult
		end
		local position = self:GetCellPosition(unit.CellIndex)
		log("[BattleSession] unit registered id=" .. unit.UnitId .. " team=" .. unit.Team .. " cell=" .. unit.CellIndex .. " spawnOrder=" .. unit.SpawnOrder .. " x=" .. position.x)
		return { Success = true, Reason = "UNIT_REGISTERED", UnitId = unit.UnitId }
	end

	@ExecSpace("Server")
	method void RequestTurn()
		-- Validates the requesting client before forwarding the turn request.
		if isvalid(self.PlayerEntity) == false or self.PlayerEntity.PlayerComponent == nil then
			log_warning("[BattleTurn] rejected reason=PLAYER_MISSING")
			return
		end

		if self.PlayerEntity.PlayerComponent.UserId ~= senderUserId then
			log_warning("[BattleTurn] rejected reason=INVALID_SENDER")
			return
		end

		local result = self:TryQueuePlayerAction("TURN", 0)
		self:PublishPlayerCommandResult("TURN", result)
		if result.Success == false then
			log_warning("[BattleQueue] rejected action=TURN reason=" .. result.Reason)
		end
	end

	@ExecSpace("ServerOnly")
	method table TryQueuePlayerAction(string actionType, integer direction)
		-- Accepts at most one player action and keeps the slot occupied until presentation time ends.
		local result = { Success = false, Reason = "UNKNOWN" }

		if actionType ~= "MOVE" and actionType ~= "TURN" then
			result.Reason = "INVALID_ACTION"
			return result
		end

		if actionType == "MOVE" and direction ~= -1 and direction ~= 1 then
			result.Reason = "INVALID_DIRECTION"
			return result
		end

		result = self.TurnState:TryReserveImmediateAction(actionType, direction)
		if result.Success == false then
			return result
		end
		self:PublishTurnStateSnapshot("IMMEDIATE_ACTION_QUEUED")
		log("[BattleQueue] queued action=" .. actionType .. " direction=" .. direction)
		self:ExecuteQueuedAction()
		return result
	end

	@ExecSpace("ServerOnly")
	method void ExecuteQueuedAction()
		-- Dispatches the queued action through the existing authoritative action functions.
		local actionType = self.TurnState.QueuedActionType
		local direction = self.TurnState.QueuedActionDirection
		if actionType == "" then
			return
		end

		self.CurrentPlayerActionKillCount = 0
		log("[BattleQueue] started action=" .. actionType .. " direction=" .. direction)

		local actionResult = nil
		if actionType == "MOVE" then
			actionResult = self:TryMove("player_01", direction)
		elseif actionType == "TURN" then
			actionResult = self:TryTurn("player_01")
		end

		if actionResult == nil or actionResult.Success == false then
			local reason = "EXECUTION_FAILED"
			if actionResult ~= nil then
				reason = actionResult.Reason
			end
			self:CompleteQueuedAction(actionType, false, reason)
			return
		end

		local duration = self:GetActionDuration(actionType)
		local complete = function()
			self:CompleteQueuedAction(actionType, true, actionResult.Reason)
		end
		self.ActionTimerId = _TimerService:SetTimerOnce(complete, duration)
	end

	@ExecSpace("ServerOnly")
	method number GetActionDuration(string actionType)
		if actionType == "MOVE" then
			return math.max(0.05, self.MoveActionDuration)
		elseif actionType == "TURN" then
			return math.max(0.05, self.TurnActionDuration)
		elseif actionType == "PUSH" then
			return math.max(0.1, self.PushActionDuration)
		end

		return 0.05
	end

	@ExecSpace("ServerOnly")
	method void CompleteQueuedAction(string actionType, boolean success, string reason)
		-- A valid player action hands control to the enemy; invalid actions release input immediately.
		self.ActionTimerId = 0
		self.TurnState:CompleteImmediateAction(reason)
		self:PublishTurnStateSnapshot("IMMEDIATE_ACTION_COMPLETED")
		log("[BattleQueue] completed action=" .. actionType .. " success=" .. tostring(success) .. " reason=" .. reason)
		if self.BattleResult ~= "" then
			return
		end

		if success == true then
			self:BeginEnemyTurn()
			return
		end

	end

	@ExecSpace("ServerOnly")
	method void BeginEnemyTurn()
		-- Executes only actions that were frozen for every enemy before the player committed this turn.
		local preparedIntent = self:GetPreparedEnemyIntent()
		if preparedIntent.State ~= "PREPARED" then
			log_warning("[BattleEnemyIntent] compatibility cursor missing; selecting frozen plan turn=" .. self.TurnNumber)
			local selection = self:PrepareNextEnemyIntent()
			if selection.Success == false then
				self:CompleteEnemyTurn("WAIT", false, selection.Reason)
				return
			end
			preparedIntent = self:GetPreparedEnemyIntent()
		end

		local enemyEntity = self:FindUnitEntity(preparedIntent.EnemyId)
		local enemyPlan = nil
		if isvalid(enemyEntity) then
			enemyPlan = enemyEntity:GetComponent("script.EnemyActionPlanComponent")
		end
		self:AdvanceEnemySkillCooldowns(preparedIntent.EnemyId, "ENEMY_ACTION_BEGIN")
		local isQueueingAttack = enemyPlan ~= nil and enemyPlan.PlanState == "INSERTING"
		local enemyCommand = "ENEMY_" .. preparedIntent.ActionType
		if isQueueingAttack then
			enemyCommand = "ENEMY_QUEUE_TILE"
		end
		self.TurnState:BeginEnemyTurn(enemyCommand, preparedIntent.Direction, isQueueingAttack and "ATTACK_TILE_QUEUEING" or "PREPARED_INTENT")
		self:PublishTurnStateSnapshot("ENEMY_TURN_BEGIN")
		log("[BattleEnemyIntent] hold enemy=" .. preparedIntent.EnemyId .. " pattern=" .. preparedIntent.PatternId .. " step=" .. preparedIntent.StepIndex .. " action=" .. preparedIntent.ActionType .. " tile=" .. preparedIntent.TileId .. " telegraphRemaining=" .. preparedIntent.TelegraphTurnsRemaining .. " turn=" .. preparedIntent.PreparedTurn)
		log("[BattleTurnFlow] phase=EnemyTurn turn=" .. self.TurnNumber)

		local execute = function()
			if isQueueingAttack then
				self:AdvancePreparedEnemyQueue()
				return
			end
			self:ExecutePreparedEnemyIntent()
		end
		local traitIds = ""
		if isvalid(enemyEntity) then
			local enemyUnit = enemyEntity:GetComponent("script.BattleUnitComponent")
			if enemyUnit ~= nil then
				traitIds = enemyUnit.EnemyTraitIds
			end
		end
		self.ActionTimerId = _TimerService:SetTimerOnce(execute, _EnemyTraitRouterLogic:GetEnemyThinkDuration(traitIds, self.EnemyThinkDuration))
	end

	@ExecSpace("ServerOnly")
	method void AdvancePreparedEnemyQueue()
		-- Consumes this foe's turn by adding its attack Tile; readiness is evaluated on the following player turn.
		self.ActionTimerId = 0
		local intent = self:GetPreparedEnemyIntent()
		if intent.State ~= "PREPARED" then
			self:CompleteEnemyTurn("QUEUE_TILE", false, "INTENT_NOT_PREPARED")
			return
		end
		local enemyEntity = self:FindUnitEntity(intent.EnemyId)
		local enemyPlan = nil
		local enemyUnit = nil
		if isvalid(enemyEntity) then
			enemyPlan = enemyEntity:GetComponent("script.EnemyActionPlanComponent")
			enemyUnit = enemyEntity:GetComponent("script.BattleUnitComponent")
		end
		if enemyPlan == nil then
			self:CompleteEnemyTurn("QUEUE_TILE", false, "ENEMY_PLAN_COMPONENT_MISSING")
			return
		end
		local queueResult = enemyPlan:AdvanceQueueTurn()
		if enemyUnit ~= nil then
			self.LastEnemySpawnOrder = enemyUnit.SpawnOrder
		end
		if self.EnemyIntentRuntime ~= nil then
			self.EnemyIntentRuntime:ResetIntent("ATTACK_TILE_QUEUE_TURN_COMPLETED")
		end
		self:PublishEnemyIntentSnapshot("ATTACK_TILE_QUEUE_TURN_COMPLETED")
		self:PublishEnemyPlanSnapshot("ATTACK_TILE_QUEUE_TURN_COMPLETED")
		log("[BattleEnemyQueue] advanced enemy=" .. intent.EnemyId .. " tile=" .. intent.TileId .. " success=" .. tostring(queueResult.Success) .. " ready=" .. tostring(queueResult.Ready) .. " queue=" .. tostring(queueResult.QueueTurnsElapsed or 0) .. "/" .. tostring(queueResult.QueueTurnsRequired or 0))
		local nextResult = self:PrepareNextEnemyIntent()
		if nextResult.Success == true then
			self:BeginEnemyTurn()
			return
		end
		self:CompleteEnemyTurn("QUEUE_TILE", queueResult.Success == true, queueResult.Reason)
	end

	@ExecSpace("ServerOnly")
	method table BuildEnemyIntent(string enemyUnitId)
		-- Loads validated PatternStep rows, then adapts authoritative unit state into the stateless resolver contract.
		local playerEntity = self:FindUnitEntity("player_01")
		local enemyEntity = self:FindUnitEntity(enemyUnitId)
		if isvalid(playerEntity) == false or isvalid(enemyEntity) == false then
			return { ActionType = "WAIT", TileId = "", Direction = 0, Reason = "UNIT_MISSING", PatternId = "", StepIndex = 1 }
		end

		local player = playerEntity:GetComponent("script.BattleUnitComponent")
		local enemy = enemyEntity:GetComponent("script.BattleUnitComponent")
		if player == nil or enemy == nil or player.IsDead == true or enemy.IsDead == true then
			return { ActionType = "WAIT", TileId = "", Direction = 0, Reason = "UNIT_UNAVAILABLE", PatternId = "", StepIndex = 1 }
		end
		local patternRunner = enemyEntity:GetComponent("script.EnemyPatternRunnerComponent")
		if patternRunner == nil then
			log_error("[BattleEnemyIntent] pattern runner missing enemy=" .. enemyUnitId)
			return { ActionType = "WAIT", TileId = "", Direction = 0, Reason = "PATTERN_RUNNER_MISSING", PatternId = enemy.EnemyPatternId, StepIndex = 1, PatternStepCount = 0 }
		end

		local patternValidation = _EnemyPatternContentValidatorLogic:ValidateById(enemy.EnemyPatternId)
		if patternValidation.Success == false then
			local detailReason = patternValidation.DetailReason or patternValidation.Reason
			log_error("[BattleEnemyIntent] pattern rejected enemy=" .. enemyUnitId .. " pattern=" .. enemy.EnemyPatternId .. " reason=" .. detailReason)
			return { ActionType = "WAIT", TileId = "", Direction = 0, Reason = "PATTERN_INVALID_" .. detailReason, PatternId = enemy.EnemyPatternId, StepIndex = 1 }
		end

		return _EnemyIntentResolverLogic:ResolvePatternIntent({
			EnemyUnitId = enemyUnitId,
			PatternId = enemy.EnemyPatternId,
			StartStepIndex = patternRunner.CurrentStepIndex,
			TelegraphTurnsRemaining = patternRunner.TelegraphTurnsRemaining,
			EnemyCellIndex = enemy.CellIndex,
			EnemyFacing = enemy.Facing,
			EnemyCurrentHp = enemy.CurrentHp,
			EnemyMaxHp = enemy.MaxHp,
			EnemyIsBoss = enemy.IsBoss,
			EnemyIsAirborne = enemy.IsAirborne,
			PlayerCellIndex = player.CellIndex,
			CellFreeBySelector = self:BuildEnemyCellFreeSnapshot(enemyUnitId, enemy.CellIndex, enemy.Facing, player.CellIndex)
		}, patternValidation.Data.Steps)
	end

	@ExecSpace("ServerOnly")
	method table BuildEnemyCellFreeSnapshot(string enemyUnitId, integer enemyCellIndex, string enemyFacing, integer playerCellIndex)
		-- Converts live BoardState occupancy into immutable selector booleans for the stateless Resolver.
		local directions = _EnemyIntentResolverLogic:ResolveRelativeDirections(enemyCellIndex, enemyFacing, playerCellIndex)
		return {
			FRONT = self:IsPatternCellFree(enemyCellIndex + directions.FacingDirection, enemyUnitId),
			BACK = self:IsPatternCellFree(enemyCellIndex - directions.FacingDirection, enemyUnitId),
			TOWARD_PLAYER = self:IsPatternCellFree(enemyCellIndex + directions.PlayerDirection, enemyUnitId),
			AWAY_FROM_PLAYER = self:IsPatternCellFree(enemyCellIndex - directions.PlayerDirection, enemyUnitId)
		}
	end

	@ExecSpace("ServerOnly")
	method boolean IsPatternCellFree(integer cellIndex, string ignoredUnitId)
		-- Out-of-range cells are never valid destinations even when no unit occupies them.
		if self:IsValidCell(cellIndex) == false or self.BoardState == nil then
			return false
		end
		return isvalid(self.BoardState:FindAtCell(cellIndex, ignoredUnitId)) == false
	end

	@ExecSpace("ServerOnly")
	method table PrepareEnemyIntent()
		-- Freezes every living enemy plan while the board still represents the same player decision point.
		self.LastEnemySpawnOrder = 0
		self:ResetEnemyIntentCursor("PLAN_ALL_ENEMIES")
		if self.BoardState == nil then
			return { Success = false, Reason = "REGISTRY_MISSING" }
		end
		local livingEnemies = self.BoardState:CollectLivingEnemies()
		local preparedCount = 0
		for _, enemyEntity in ipairs(livingEnemies) do
			local enemyUnit = enemyEntity:GetComponent("script.BattleUnitComponent")
			local actionPlan = enemyEntity:GetComponent("script.EnemyActionPlanComponent")
			if enemyUnit ~= nil and actionPlan ~= nil then
				if actionPlan.PlanState == "COMPLETED" then
					actionPlan:ResetPlan("NEXT_ENEMY_DECISION")
				end
				local planResult = { Success = true, Reason = "EXISTING_PLAN_PRESERVED" }
				if actionPlan.PlanState == "EMPTY" then
					planResult = self:PrepareEnemyIntentForUnit(enemyUnit.UnitId)
				elseif actionPlan.PlanState == "TRACKING" then
					-- Freeze every queued enemy's readiness before the player commits a Command.
					planResult = self:RefreshQueuedAttackReadiness(enemyUnit.UnitId)
				end
				if planResult.Success == true then
					preparedCount = preparedCount + 1
				else
					log_error("[EnemyRoundPlan] enemy plan failed enemy=" .. enemyUnit.UnitId .. " reason=" .. planResult.Reason)
				end
			end
		end
		self:PublishEnemyPlanSnapshot("ALL_PLANS_FROZEN")
		local selection = self:PrepareNextEnemyIntent()
		log("[EnemyRoundPlan] frozen turn=" .. self.TurnNumber .. " living=" .. #livingEnemies .. " prepared=" .. preparedCount .. " selected=" .. self.PreparedEnemyId .. " revision=" .. self.EnemyPlanRevision)
		return { Success = preparedCount > 0, Reason = preparedCount > 0 and "ALL_PLANS_FROZEN" or "NO_ENEMY_PLAN_PREPARED", PreparedCount = preparedCount, SelectionReason = selection.Reason }
	end

	@ExecSpace("ServerOnly")
	method table PrepareNextEnemyIntent()
		-- Moves the compatibility cursor to the next already-frozen per-enemy plan; it never rebuilds AI here.
		local result = {
			Success = false,
			Reason = "UNKNOWN"
		}

		if self.BattleResult ~= "" then
			result.Reason = "BATTLE_ENDED"
			return result
		end
		local currentIntent = self:GetPreparedEnemyIntent()
		if currentIntent.State ~= "EMPTY" then
			result.Reason = "INTENT_ALREADY_PREPARED"
			return result
		end

		if self.BoardState == nil then
			result.Reason = "REGISTRY_MISSING"
			return result
		end
		local livingEnemies = self.BoardState:CollectLivingEnemies()
		local selectedUnitId = ""
		for _, enemyEntity in ipairs(livingEnemies) do
			local enemyUnit = enemyEntity:GetComponent("script.BattleUnitComponent")
			local actionPlan = enemyEntity:GetComponent("script.EnemyActionPlanComponent")
			if enemyUnit ~= nil and actionPlan ~= nil
				and (actionPlan.PlanState == "INSERTING" or actionPlan.PlanState == "TRACKING" or actionPlan.PlanState == "ATTACK_READY" or actionPlan.PlanState == "PREPARED")
				and actionPlan.DeferredUntilTurn <= self.TurnNumber
				and enemyUnit.SpawnOrder > self.LastEnemySpawnOrder then
				selectedUnitId = enemyUnit.UnitId
				break
			end
		end
		if selectedUnitId == "" then
			result.Reason = "NO_NEXT_LIVING_ENEMY"
			return result
		end

		return self:LoadEnemyPlanActionToCompatibility(selectedUnitId)
	end

	@ExecSpace("ServerOnly")
	method table PrepareEnemyIntentForUnit(string enemyUnitId)
		-- Resolves one base pattern step, decorates it through traits, and stores it on the enemy object.
		local result = {
			Success = false,
			Reason = "UNKNOWN"
		}
		if self.BattleResult ~= "" then
			result.Reason = "BATTLE_ENDED"
			return result
		end
		local intent = self:BuildEnemyIntent(enemyUnitId)
		local preparedMovementPolicy = ""
		local preparedEnemyEntity = self:FindUnitEntity(enemyUnitId)
		if isvalid(preparedEnemyEntity) == false then
			return { Success = false, Reason = "ENEMY_MISSING_AFTER_PREPARE" }
		else
			local preparedEnemyUnit = preparedEnemyEntity:GetComponent("script.BattleUnitComponent")
			local actionPlan = preparedEnemyEntity:GetComponent("script.EnemyActionPlanComponent")
			if preparedEnemyUnit ~= nil then
				preparedMovementPolicy = preparedEnemyUnit.EnemyMovementPolicy
			end
			if preparedEnemyUnit == nil or actionPlan == nil then
				return { Success = false, Reason = "ENEMY_PLAN_COMPONENT_MISSING" }
			end
			if actionPlan.PlanState ~= "EMPTY" then
				actionPlan:ResetPlan("REPLAN")
			end
			local patternRunner = preparedEnemyEntity:GetComponent("script.EnemyPatternRunnerComponent")
			if patternRunner == nil then
				return { Success = false, Reason = "PATTERN_RUNNER_MISSING" }
			end
			local traitPlan = _EnemyTraitRouterLogic:BuildActionPlan(preparedEnemyUnit.EnemyTraitIds, intent, preparedEnemyUnit.IsBoss)
			if traitPlan.Success == false then
				return traitPlan
			end
			local markResult = patternRunner:TryMarkPrepared(intent.PatternId, intent.StepIndex, intent.PatternStepCount or 0, intent.ActionType, intent.TelegraphTurnsRemaining or 0)
			if markResult.Success == false then
				return markResult
			end
			local queueTurnsRequired = 0
			if intent.ActionType == "EXECUTE_TILE" and intent.TileId ~= "" then
				local skillDefinition = _SkillDefinitionRepositoryLogic:GetSkillDefinition(intent.TileId)
				if skillDefinition.Success == true then
					queueTurnsRequired = math.max(0, math.floor(tonumber(skillDefinition.EnemyQueueTurns) or 0))
				end
				if _EnemyTraitRouterLogic:HasTrait(preparedEnemyUnit.EnemyTraitIds, "QUICK") then
					queueTurnsRequired = 0
				end
			end
			result = actionPlan:ReplacePlan(enemyUnitId, traitPlan.Actions, self.TurnNumber, preparedEnemyUnit.EnemyTraitIds, intent.Reason, queueTurnsRequired)
			if result.Success == false then
				patternRunner:CancelPreparedStep(intent.PatternId, intent.StepIndex, result.Reason)
				return result
			end
			if actionPlan.PlanState == "TRACKING" then
				local readiness = self:RefreshQueuedAttackReadiness(enemyUnitId)
				if readiness.Success == false then
					patternRunner:CancelPreparedStep(intent.PatternId, intent.StepIndex, readiness.Reason)
					actionPlan:ResetPlan(readiness.Reason)
					return readiness
				end
			end
		end
		log("[BattleEnemyIntent] plan enemy=" .. enemyUnitId .. " pattern=" .. intent.PatternId .. " step=" .. intent.StepIndex .. " action=" .. intent.ActionType .. " tile=" .. intent.TileId .. " telegraphRemaining=" .. (intent.TelegraphTurnsRemaining or 0) .. " direction=" .. intent.Direction .. " turn=" .. self.TurnNumber .. " policy=" .. preparedMovementPolicy .. " reason=" .. intent.Reason)
		return result
	end

	@ExecSpace("ServerOnly")
	method void ResetEnemyIntentCursor(string reason)
		-- Clears only the map-scoped selection cursor. Enemy-owned queued Tiles survive into later turns.
		local intentRuntime = self.EnemyIntentRuntime
		if intentRuntime == nil then
			intentRuntime = self:EnsureEnemyIntentComponent()
		end
		if intentRuntime ~= nil then
			intentRuntime:ResetIntent(reason)
		end
		self:PublishEnemyIntentSnapshot(reason)
	end

	@ExecSpace("ServerOnly")
	method table RefreshQueuedAttackReadiness(string enemyUnitId)
		-- Converts the queued attack Tile into a turn, move, wait, or committed attack without changing Pattern Step.
		local enemyEntity = self:FindUnitEntity(enemyUnitId)
		local playerEntity = self:FindUnitEntity("player_01")
		if isvalid(enemyEntity) == false or isvalid(playerEntity) == false then
			return { Success = false, Reason = "READINESS_UNIT_MISSING" }
		end
		local enemyUnit = enemyEntity:GetComponent("script.BattleUnitComponent")
		local playerUnit = playerEntity:GetComponent("script.BattleUnitComponent")
		local actionPlan = enemyEntity:GetComponent("script.EnemyActionPlanComponent")
		if enemyUnit == nil or playerUnit == nil or actionPlan == nil then
			return { Success = false, Reason = "READINESS_COMPONENT_MISSING" }
		end
		if actionPlan.PlanState ~= "TRACKING" then
			return { Success = false, Reason = "PLAN_NOT_TRACKING" }
		end
		local action = actionPlan:GetCurrentAction()
		if action.Success == false or action.ActionType ~= "EXECUTE_TILE" or action.TileId == "" then
			return { Success = false, Reason = "QUEUED_ATTACK_ACTION_MISSING" }
		end
		local definitionResult = _SkillDefinitionRepositoryLogic:GetSkillDefinition(action.TileId)
		if definitionResult.Success == false then
			return definitionResult
		end
		local runtimeState = self:GetSkillRuntimeState(enemyUnitId)
		if runtimeState ~= nil then
			local cooldownResult = runtimeState:CanUseSkill(action.TileId)
			if cooldownResult.Success == false then
				local trackingResult = actionPlan:SetTrackingState("SKILL_COOLDOWN", "WAIT", 0, "")
				if trackingResult.Success == false then
					return trackingResult
				end
				return {
					Success = true,
					Reason = "SKILL_COOLDOWN",
					Readiness = "COOLDOWN",
					NextCommandType = "WAIT",
					Direction = 0,
					TargetCellSnapshot = "",
					RemainingTurns = cooldownResult.RemainingTurns,
					PatternId = action.PatternId,
					StepIndex = action.StepIndex,
					PatternStepCount = action.PatternStepCount,
					TileId = action.TileId,
					PreparedTurn = action.PreparedTurn,
					TelegraphTurnsRemaining = action.TelegraphTurnsRemaining
				}
			end
		end
		local relative = _EnemyIntentResolverLogic:ResolveRelativeDirections(enemyUnit.CellIndex, enemyUnit.Facing, playerUnit.CellIndex)
		local readiness = _EnemyIntentResolverLogic:ResolveQueuedAttackReadiness({
			EnemyCellIndex = enemyUnit.CellIndex,
			EnemyFacing = enemyUnit.Facing,
			PlayerCellIndex = playerUnit.CellIndex,
			TowardPlayerCellFree = self:IsPatternCellFree(enemyUnit.CellIndex + relative.PlayerDirection, enemyUnitId)
		}, definitionResult)
		if readiness.Success == false then
			return readiness
		end
		if readiness.Readiness == "READY" then
			local readyResult = actionPlan:MarkAttackReady(readiness.Reason, readiness.TargetCellSnapshot)
			if readyResult.Success == false then
				return readyResult
			end
		else
			local trackingResult = actionPlan:SetTrackingState(readiness.Reason, readiness.NextCommandType, readiness.Direction, readiness.TargetCellSnapshot)
			if trackingResult.Success == false then
				return trackingResult
			end
		end
		readiness.PatternId = action.PatternId
		readiness.StepIndex = action.StepIndex
		readiness.PatternStepCount = action.PatternStepCount
		readiness.TileId = action.TileId
		readiness.PreparedTurn = action.PreparedTurn
		readiness.TelegraphTurnsRemaining = action.TelegraphTurnsRemaining
		return readiness
	end

	@ExecSpace("ServerOnly")
	method table LoadEnemyPlanActionToCompatibility(string enemyUnitId)
		local enemyEntity = self:FindUnitEntity(enemyUnitId)
		if isvalid(enemyEntity) == false then
			return { Success = false, Reason = "ENEMY_MISSING" }
		end
		local actionPlan = enemyEntity:GetComponent("script.EnemyActionPlanComponent")
		if actionPlan == nil then
			return { Success = false, Reason = "ENEMY_PLAN_COMPONENT_MISSING" }
		end
		local action = actionPlan:GetCurrentAction()
		if action.Success == false then
			return action
		end
		local compatibilityActionType = action.ActionType
		local compatibilityDirection = action.Direction
		local compatibilityReason = action.ActionReason
		if actionPlan.PlanState == "TRACKING" then
			compatibilityActionType = actionPlan.NextCommandType ~= "" and actionPlan.NextCommandType or "WAIT"
			compatibilityDirection = actionPlan.NextCommandDirection
			compatibilityReason = actionPlan.ReadinessReason ~= "" and actionPlan.ReadinessReason or "TRACKING"
		end
		local intentRuntime = self:EnsureEnemyIntentComponent()
		if intentRuntime == nil then
			return { Success = false, Reason = "INTENT_STATE_MISSING" }
		end
		if intentRuntime.IntentState ~= "EMPTY" then
			intentRuntime:ResetIntent("COMPATIBILITY_CURSOR_ADVANCE")
		end
		local result = intentRuntime:TryPrepare(enemyUnitId, action.PatternId, action.StepIndex, compatibilityActionType, action.TileId, action.TelegraphTurnsRemaining, compatibilityDirection, action.PreparedTurn, compatibilityReason)
		self:PublishEnemyIntentSnapshot("PLAN_CURSOR_SELECTED")
		self:PublishEnemyPlanSnapshot("PLAN_CURSOR_SELECTED")
		return result
	end

	@ExecSpace("ServerOnly")
	method table GetPreparedEnemyIntent()
		-- Returns a copy so callers cannot mutate the synchronized snapshot fields.
		local intentRuntime = self.EnemyIntentRuntime
		if intentRuntime == nil then
			intentRuntime = self:EnsureEnemyIntentComponent()
		end
		if intentRuntime == nil then
			return { State = "EMPTY", EnemyId = "", PatternId = "", StepIndex = 0, ActionType = "", TileId = "", TelegraphTurnsRemaining = 0, Direction = 0, PreparedTurn = 0, Reason = "INTENT_STATE_MISSING", Revision = 0 }
		end
		return intentRuntime:GetSnapshot()
	end

	@ExecSpace("ServerOnly")
	method void ExecutePreparedEnemyIntent()
		-- Reuses the authoritative action paths without rebuilding the prepared PatternStep.
		self.ActionTimerId = 0
		local intent = self:GetPreparedEnemyIntent()
		if intent.State ~= "PREPARED" then
			log_error("[BattleEnemyIntent] execute rejected state=" .. intent.State)
			self:CompleteEnemyTurn("WAIT", false, "INTENT_NOT_PREPARED")
			return
		end

		local beginResult = self.EnemyIntentRuntime:TryBeginExecution()
		if beginResult.Success == false then
			log_error("[BattleEnemyIntent] execute transition rejected reason=" .. beginResult.Reason)
			self:CompleteEnemyTurn("WAIT", false, beginResult.Reason)
			return
		end
		local executingEnemy = self:FindUnitEntity(intent.EnemyId)
		local executingPlan = nil
		if isvalid(executingEnemy) then
			executingPlan = executingEnemy:GetComponent("script.EnemyActionPlanComponent")
		end
		if executingPlan == nil then
			log_error("[BattleEnemyIntent] execute rejected reason=ENEMY_PLAN_COMPONENT_MISSING enemy=" .. intent.EnemyId)
			self:CompleteEnemyTurn("WAIT", false, "ENEMY_PLAN_COMPONENT_MISSING")
			return
		end
		local isTrackingCommand = executingPlan.PlanState == "TRACKING"
			and (intent.ActionType == "TURN_TO_PLAYER" or intent.ActionType == "MOVE_TOWARD" or intent.ActionType == "WAIT")
		if isTrackingCommand == false then
			local planBegin = executingPlan:TryBeginCurrentAction()
			if planBegin.Success == false then
				log_error("[BattleEnemyIntent] plan execute rejected reason=" .. planBegin.Reason .. " enemy=" .. intent.EnemyId)
				self:CompleteEnemyTurn("WAIT", false, planBegin.Reason)
				return
			end
		end
		self:PublishEnemyIntentSnapshot("EXECUTING")
		self:PublishEnemyPlanSnapshot("ACTION_EXECUTING")
		local actionDirection = intent.Direction
		if actionDirection == 0 and (intent.ActionType == "MOVE_TOWARD" or intent.ActionType == "MOVE_AWAY") then
			actionDirection = self:ResolveEnemyRelativeMoveDirection(intent.EnemyId, intent.ActionType)
		end
		self.TurnState:UpdateEnemyAction("ENEMY_" .. intent.ActionType, actionDirection)
		self:PublishTurnStateSnapshot("ENEMY_ACTION")
		log("[BattleEnemyIntent] execute enemy=" .. intent.EnemyId .. " pattern=" .. intent.PatternId .. " step=" .. intent.StepIndex .. " action=" .. intent.ActionType .. " tile=" .. intent.TileId .. " telegraphRemaining=" .. intent.TelegraphTurnsRemaining .. " preparedTurn=" .. intent.PreparedTurn .. " currentTurn=" .. self.TurnNumber)

		local actionResult = nil
		if intent.ActionType == "MOVE_TOWARD" then
			actionResult = self:TryMove(intent.EnemyId, actionDirection)
		elseif intent.ActionType == "MOVE_AWAY" then
			actionResult = self:TryMoveAway(intent.EnemyId, actionDirection)
		elseif intent.ActionType == "MOVE_FIXED_FACING" then
			actionResult = self:TryMove(intent.EnemyId, intent.Direction)
		elseif intent.ActionType == "TURN_TO_PLAYER" then
			actionResult = self:TryFaceDirection(intent.EnemyId, intent.Direction)
		elseif intent.ActionType == "TELEGRAPH_TILE" then
			actionResult = { Success = true, Reason = "TELEGRAPH_COMPLETED" }
		elseif intent.ActionType == "BOSS_JUMP_TELEGRAPH" then
			actionResult = self:BeginBossOppositeJump(intent.EnemyId)
		elseif intent.ActionType == "BOSS_LAND_OPPOSITE" then
			actionResult = self:ResolveBossOppositeLanding(intent.EnemyId, intent.TileId)
		elseif intent.ActionType == "EXECUTE_TILE" and intent.TileId ~= "" then
			-- Resolves the pattern's TileId through the enemy-only skill table and shared skill pipeline.
			actionResult = self:TryExecuteSkill(intent.EnemyId, intent.TileId)
		else
			 actionResult = { Success = true, Reason = intent.Reason }
		end
		if intent.ActionType == "MOVE_TOWARD" or intent.ActionType == "MOVE_AWAY" or intent.ActionType == "MOVE_FIXED_FACING" then
			actionResult = self:ConvertBlockedEnemyMoveToWait(intent.EnemyId, intent.ActionType, actionDirection, actionResult)
		end

		local success = actionResult ~= nil and actionResult.Success == true
		local reason = "EXECUTION_FAILED"
		if actionResult ~= nil then
			reason = actionResult.Reason
		end

		local duration = self:GetEnemyActionDuration(intent.ActionType, intent.TileId)
		local complete = function()
			if isTrackingCommand then
				self:CompleteQueuedAttackTrackingCommand(intent.EnemyId, intent.ActionType, success, reason)
				return
			end
			self:CompletePreparedEnemyIntent(intent.EnemyId, intent.PatternId, intent.StepIndex, intent.ActionType, intent.TileId, intent.TelegraphTurnsRemaining, success, reason)
		end
		self.ActionTimerId = _TimerService:SetTimerOnce(complete, duration)
	end

	@ExecSpace("ServerOnly")
	method void CompleteQueuedAttackTrackingCommand(string enemyId, string actionType, boolean success, string reason)
		-- A tracking command consumes one enemy action but never completes the queued attack's Pattern Step.
		log("[BattleEnemyQueue] tracking complete enemy=" .. enemyId .. " action=" .. actionType .. " success=" .. tostring(success) .. " reason=" .. reason)
		local enemyEntity = self:FindUnitEntity(enemyId)
		if isvalid(enemyEntity) then
			local enemyUnit = enemyEntity:GetComponent("script.BattleUnitComponent")
			if enemyUnit ~= nil then
				self.LastEnemySpawnOrder = enemyUnit.SpawnOrder
			end
		end
		if self.EnemyIntentRuntime ~= nil then
			self.EnemyIntentRuntime:ResetIntent("QUEUED_ATTACK_TRACKING_COMPLETED")
		end
		self:PublishEnemyIntentSnapshot("QUEUED_ATTACK_TRACKING_COMPLETED")
		self:PublishEnemyPlanSnapshot("QUEUED_ATTACK_TRACKING_COMPLETED")
		if self.BattleResult == "" then
			local nextResult = self:PrepareNextEnemyIntent()
			if nextResult.Success == true then
				self:BeginEnemyTurn()
				return
			end
		end
		self:CompleteEnemyTurn(actionType, success, reason)
	end

	@ExecSpace("ServerOnly")
	method table ConvertBlockedEnemyMoveToWait(string enemyId, string actionType, integer direction, table actionResult)
		-- Normalizes spatial movement blocks into one consumed WAIT without hiding configuration or phase errors.
		if actionResult == nil or actionResult.Success == true then
			return actionResult
		end
		if actionResult.Reason ~= "OUT_OF_BOUNDS" and actionResult.Reason ~= "CELL_OCCUPIED" then
			return actionResult
		end
		local blockedReason = actionResult.Reason
		local result = {
			Success = true,
			Reason = "WAIT_" .. blockedReason,
			WasBlocked = true,
			BlockedReason = blockedReason,
			OriginalActionType = actionType,
			FromCell = actionResult.FromCell,
			ToCell = actionResult.ToCell
		}
		self.TurnState:UpdateEnemyAction("ENEMY_WAIT", 0)
		self:PublishTurnStateSnapshot("ENEMY_WAIT")
		log("[BattleEnemyIntent] move blocked; wait enemy=" .. enemyId .. " action=" .. actionType .. " direction=" .. direction .. " reason=" .. blockedReason .. " from=" .. tostring(result.FromCell) .. " to=" .. tostring(result.ToCell))
		return result
	end

	@ExecSpace("ServerOnly")
	method number GetEnemyActionDuration(string actionType, string tileId)
		-- Returns the presentation lock duration for each prepared enemy action meaning.
		if actionType == "MOVE_TOWARD" or actionType == "MOVE_AWAY" or actionType == "MOVE_FIXED_FACING" then
			return math.max(0.05, self.EnemyMoveActionDuration)
		elseif actionType == "TURN_TO_PLAYER" then
			return math.max(0.05, self.TurnActionDuration)
		elseif actionType == "EXECUTE_TILE" then
			-- Keep the enemy turn open through the Skill's configured impact/presentation window.
			return math.max(0.1, self:GetSkillActionDuration(tileId))
		elseif actionType == "BOSS_LAND_OPPOSITE" then
			return math.max(0.1, self:GetSkillActionDuration(tileId))
		elseif actionType == "TELEGRAPH_TILE" or actionType == "BOSS_JUMP_TELEGRAPH" then
			return 0.05
		end
		return 0.05
	end

	@ExecSpace("ServerOnly")
	method table BeginBossOppositeJump(string enemyId)
		-- Freezes the opposite edge at takeoff so later player movement cannot retarget the landing.
		local enemyEntity = self:FindUnitEntity(enemyId)
		if isvalid(enemyEntity) == false then
			return { Success = false, Reason = "ENEMY_NOT_FOUND" }
		end
		local enemy = enemyEntity:GetComponent("script.BattleUnitComponent")
		if enemy == nil or enemy.IsBoss ~= true or enemy.IsDead == true then
			return { Success = false, Reason = "BOSS_UNAVAILABLE" }
		end
		local centerCell = (self.CellCount - 1) * 0.5
		local landingCell = 0
		if enemy.CellIndex <= centerCell then
			landingCell = self.CellCount - 1
		end
		local result = enemy:SetAirborneState(true, landingCell)
		if result.Success == true then
			log("[BossJump] takeoff enemy=" .. enemyId .. " from=" .. enemy.CellIndex .. " landing=" .. landingCell)
		end
		return result
	end

	@ExecSpace("ServerOnly")
	method table ResolveBossOppositeLanding(string enemyId, string landingSkillId)
		-- Landing owns overlap resolution: push toward center first, then try the opposite side.
		local result = { Success = false, Reason = "UNKNOWN", EnemyId = enemyId, LandingCell = -1, PlayerPushed = false, PlayerFromCell = -1, PlayerToCell = -1 }
		local enemyEntity = self:FindUnitEntity(enemyId)
		local playerEntity = self:FindUnitEntity("player_01")
		if isvalid(enemyEntity) == false or isvalid(playerEntity) == false then
			result.Reason = "LANDING_UNIT_MISSING"
			return result
		end
		local enemy = enemyEntity:GetComponent("script.BattleUnitComponent")
		local player = playerEntity:GetComponent("script.BattleUnitComponent")
		if enemy == nil or player == nil or enemy.IsBoss ~= true or enemy.IsAirborne ~= true then
			result.Reason = "BOSS_NOT_AIRBORNE"
			return result
		end
		local landingCell = enemy.PendingLandingCell
		result.LandingCell = landingCell
		if self:IsValidCell(landingCell) == false then
			result.Reason = "INVALID_LANDING_CELL"
			return result
		end

		if player.IsDead == false and player.CellIndex == landingCell then
			local centerDirection = landingCell <= (self.CellCount - 1) * 0.5 and 1 or -1
			local pushResult = self:RelocateUnitForMechanic("player_01", player.CellIndex + centerDirection, "BOSS_LANDING_CENTER_PUSH")
			if pushResult.Success == false then
				pushResult = self:RelocateUnitForMechanic("player_01", player.CellIndex - centerDirection, "BOSS_LANDING_REVERSE_PUSH")
			end
			if pushResult.Success == false then
				result.Reason = "LANDING_OVERLAP_UNRESOLVED_" .. pushResult.Reason
				return result
			end
			result.PlayerPushed = true
			result.PlayerFromCell = pushResult.FromCell
			result.PlayerToCell = pushResult.ToCell
		end

		if self:IsCellOccupied(landingCell, enemyId) then
			result.Reason = "LANDING_CELL_OCCUPIED"
			return result
		end
		local fromCell = enemy.CellIndex
		local cellResult = enemy:ApplyCellChange(landingCell)
		if cellResult.Success == false then
			result.Reason = cellResult.Reason
			return result
		end
		self:PlaceEntity(enemyEntity, self:GetCellPosition(landingCell))
		enemy:SetAirborneState(false, -1)
		local facing = player.CellIndex >= landingCell and "Right" or "Left"
		enemy:ApplyFacingState(facing)
		self:ApplyFacing(enemyEntity, enemy.Facing)
		local impactResult = nil
		if landingSkillId ~= nil and landingSkillId ~= "" then
			impactResult = self:TryExecuteSkill(enemyId, landingSkillId)
			result.ImpactSuccess = impactResult.Success
			result.ImpactReason = impactResult.Reason
		end
		result.Success = true
		result.Reason = "BOSS_LANDED"
		log("[BossJump] landed enemy=" .. enemyId .. " from=" .. fromCell .. " to=" .. landingCell .. " playerPush=" .. tostring(result.PlayerPushed) .. " player=" .. result.PlayerFromCell .. "->" .. result.PlayerToCell .. " impact=" .. tostring(result.ImpactSuccess) .. ":" .. tostring(result.ImpactReason))
		return result
	end

	@ExecSpace("ServerOnly")
	method void CompletePreparedEnemyIntent(string enemyId, string patternId, integer stepIndex, string actionType, string tileId, integer telegraphTurnsRemaining, boolean success, string reason)
		-- Advances within the enemy-owned queue; pattern progression occurs once after the full plan.
		log("[BattleEnemyIntent] complete enemy=" .. enemyId .. " pattern=" .. patternId .. " step=" .. stepIndex .. " action=" .. actionType .. " tile=" .. tileId .. " telegraphRemaining=" .. telegraphTurnsRemaining .. " success=" .. tostring(success) .. " reason=" .. reason)
		local completedEnemy = self:FindUnitEntity(enemyId)
		local completedPlan = nil
		local planCompletion = { Success = false, Reason = "ENEMY_MISSING", HasNextAction = false, AggregateSuccess = success }
		if isvalid(completedEnemy) then
			local completedUnit = completedEnemy:GetComponent("script.BattleUnitComponent")
			completedPlan = completedEnemy:GetComponent("script.EnemyActionPlanComponent")
			if completedPlan ~= nil then
				planCompletion = completedPlan:CompleteCurrentAction(success, reason)
			end
			if completedUnit ~= nil then
				self.LastEnemySpawnOrder = completedUnit.SpawnOrder
			end
		end
		if self.EnemyIntentRuntime ~= nil then
			self.EnemyIntentRuntime:ResetIntent("ACTION_COMPLETED")
		end
		self:PublishEnemyIntentSnapshot("ACTION_COMPLETED")
		self:PublishEnemyPlanSnapshot("ACTION_COMPLETED")
		if self.BattleResult ~= "" then
			self:ClearPreparedEnemyIntent("BATTLE_ENDED")
			self:CompleteEnemyTurn(actionType, success, reason)
			return
		end
		if planCompletion.Success == true and planCompletion.HasNextAction == true then
			local pendingAction = completedPlan ~= nil and completedPlan:GetCurrentAction() or { Success = false }
			local pendingReason = pendingAction.Success == true and (pendingAction.ActionReason or "") or ""
			if string.sub(pendingReason, 1, 12) == "POST_ATTACK_" then
				local deferResult = completedPlan:DeferCurrentActionUntilTurn(self.TurnNumber + 1, "POST_ATTACK_NEXT_ENEMY_TURN")
				self:PublishEnemyPlanSnapshot("POST_ATTACK_ACTION_DEFERRED")
				if deferResult.Success == false then
					log_error("[BattleEnemyIntent] defer failed enemy=" .. enemyId .. " reason=" .. deferResult.Reason)
				else
					log("[BattleEnemyIntent] deferred enemy=" .. enemyId .. " action=" .. pendingAction.ActionType .. " untilTurn=" .. deferResult.DeferredUntilTurn)
					local nextEnemy = self:PrepareNextEnemyIntent()
					if nextEnemy.Success == true then
						self:BeginEnemyTurn()
						return
					end
					self:CompleteEnemyTurn(actionType, success, "POST_ATTACK_ACTION_DEFERRED")
					return
				end
			end
			local nextAction = self:LoadEnemyPlanActionToCompatibility(enemyId)
			if nextAction.Success == true then
				self:BeginEnemyTurn()
				return
			end
		end
		local progression = self:CompleteEnemyPatternStep(enemyId, patternId, stepIndex, planCompletion.AggregateSuccess == true)
		if progression.Success == false then
			log_error("[BattleEnemyIntent] pattern progression failed enemy=" .. enemyId .. " pattern=" .. patternId .. " step=" .. stepIndex .. " reason=" .. progression.Reason)
		end
		if self.BattleResult == "" then
			local nextResult = self:PrepareNextEnemyIntent()
			if nextResult.Success == true then
				log("[BattleEnemyIntent] advance next=" .. self.PreparedEnemyId .. " afterSpawnOrder=" .. self.LastEnemySpawnOrder)
				self:BeginEnemyTurn()
				return
			end
		end
		self:CompleteEnemyTurn(actionType, success, reason)
	end

	@ExecSpace("ServerOnly")
	method table CompleteEnemyPatternStep(string enemyId, string patternId, integer stepIndex, boolean success)
		-- Resolves immutable row links, then asks the per-enemy runner to own the mutable transition.
		local enemyEntity = self:FindUnitEntity(enemyId)
		if isvalid(enemyEntity) == false then
			return { Success = false, Reason = "ENEMY_MISSING" }
		end
		local patternRunner = enemyEntity:GetComponent("script.EnemyPatternRunnerComponent")
		if patternRunner == nil then
			return { Success = false, Reason = "PATTERN_RUNNER_MISSING" }
		end
		if patternRunner.PatternId ~= patternId then
			-- A boss may cross a phase threshold after this round's plan was frozen. The frozen
			-- action still resolves, but its old Step must not advance the replacement Pattern.
			log("[BattleEnemyIntent] pattern progression skipped enemy=" .. enemyId .. " oldPattern=" .. patternId .. " currentPattern=" .. patternRunner.PatternId .. " reason=PATTERN_SUPERSEDED")
			return { Success = true, Reason = "PATTERN_SUPERSEDED", PreviousPatternId = patternId, CurrentPatternId = patternRunner.PatternId }
		end
		local stepResult = _EnemyPatternStepRepositoryLogic:GetPatternStep(patternId, stepIndex)
		if stepResult.Success == false then
			return stepResult
		end
		return patternRunner:CompletePreparedStep(
			patternId,
			stepIndex,
			success,
			stepResult.Step.NextStepOnSuccess,
			stepResult.Step.NextStepOnFailure,
			stepResult.StepCount,
			stepResult.Step.ActionType
		)
	end

	@ExecSpace("ServerOnly")
	method void ClearPreparedEnemyIntent(string reason)
		-- Cancels every per-enemy frozen plan at a real round/battle boundary.
		local intentRuntime = self.EnemyIntentRuntime
		if intentRuntime == nil then
			intentRuntime = self:EnsureEnemyIntentComponent()
		end
		if self.BoardState ~= nil then
			local livingEnemies = self.BoardState:CollectLivingEnemies()
			for _, enemyEntity in ipairs(livingEnemies) do
				local actionPlan = enemyEntity:GetComponent("script.EnemyActionPlanComponent")
				local patternRunner = enemyEntity:GetComponent("script.EnemyPatternRunnerComponent")
				if actionPlan ~= nil and actionPlan.PlanState ~= "EMPTY" then
					local current = actionPlan:GetCurrentAction()
					if patternRunner ~= nil and current.Success == true then
						patternRunner:CancelPreparedStep(current.PatternId, current.StepIndex, reason)
					end
					actionPlan:ResetPlan(reason)
				end
			end
		end
		if intentRuntime ~= nil then
			intentRuntime:ResetIntent(reason)
		end
		self:PublishEnemyIntentSnapshot(reason)
		self:PublishEnemyPlanSnapshot(reason)
	end

	@ExecSpace("ServerOnly")
	method table ProcessAugmentTrigger(string triggerType, string sourceTag, integer depth)
		-- Publishes one normalized battle trigger to the shared job-passive and augment runtime.
		local result = { Success = false, Reason = "PLAYER_MISSING", TriggerType = triggerType or "", ExecutedCount = 0 }
		if isvalid(self.PlayerEntity) == false then
			return result
		end
		local playerUnit = self.PlayerEntity:GetComponent("script.BattleUnitComponent")
		if playerUnit == nil or playerUnit.IsDead == true then
			result.Reason = "PLAYER_UNIT_UNAVAILABLE"
			return result
		end
		local context = {
			BattleSession = self,
			SourceEntity = self.PlayerEntity,
			SourceUnit = playerUnit,
			TurnNumber = self.TurnNumber,
			SourceTag = sourceTag or "",
			Depth = math.max(0, depth)
		}
		result = _AugmentRuntimeLogic:ProcessTrigger(self.PlayerEntity, triggerType, context)
		self.LastAugmentTriggerType = triggerType or ""
		self.LastAugmentTriggerReason = result.Reason or "UNKNOWN"
		self.LastAugmentExecutedCount = result.ExecutedCount or 0
		self.AugmentRuntimeRevision = self.AugmentRuntimeRevision + 1
		log("[BattleAugment] trigger=" .. self.LastAugmentTriggerType .. " success=" .. tostring(result.Success) .. " reason=" .. self.LastAugmentTriggerReason .. " executed=" .. self.LastAugmentExecutedCount .. " revision=" .. self.AugmentRuntimeRevision)
		return result
	end

	@ExecSpace("ServerOnly")
	method void CompleteEnemyTurn(string actionType, boolean success, string reason)
		-- Ends the full ordered enemy round and reopens the next player turn.
		self.ActionTimerId = 0
		if self.BattleResult ~= "" then
			self.TurnState:ClearTransientState("BATTLE_ENDED")
			self:PublishTurnStateSnapshot("BATTLE_ENDED")
			log("[BattleEnemy] completed action=" .. actionType .. " success=" .. tostring(success) .. " reason=" .. reason .. " result=" .. self.BattleResult)
			return
		end

		self.TurnState:CompleteEnemyTurn("ENEMY_ROUND_COMPLETED")
		self:PublishTurnStateSnapshot("PLAYER_TURN_REOPENED")
		self.StageTurnNumber = self.TurnNumber
		self:AdvancePlayerSkillCooldowns("PLAYER_TURN_" .. self.TurnNumber)
		self:ProcessAugmentTrigger("TURN_START", "TURN:" .. tostring(self.TurnNumber), 0)
		self.LastEnemySpawnOrder = 0
		self:EvaluateForcedSpawnAtTurnBoundary()
		log("[BattleEnemy] completed action=" .. actionType .. " success=" .. tostring(success) .. " reason=" .. reason)
		log("[BattleTurnFlow] phase=PlayerTurn turn=" .. self.TurnNumber .. " stageTurn=" .. self.StageTurnNumber .. " wave=" .. self.CurrentWave)
		self:PrepareEnemyIntent()
	end

	@ExecSpace("ServerOnly")
	method boolean IsTeamTurn(string team)
		if team == "Player" then
			return self.BattlePhase == "PlayerTurn"
		elseif team == "Enemy" then
			return self.BattlePhase == "EnemyTurn"
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method table TryTurn(string unitId)
		-- Reverses a living unit's logical and visual facing without moving cells.
		local result = {
			Success = false,
			Reason = "UNKNOWN",
			PreviousFacing = "",
			CurrentFacing = ""
		}

		local unitEntity = self:FindUnitEntity(unitId)
		if isvalid(unitEntity) == false then
			result.Reason = "UNIT_NOT_FOUND"
			return result
		end

		local unit = unitEntity:GetComponent("script.BattleUnitComponent")
		if unit == nil then
			result.Reason = "UNIT_COMPONENT_MISSING"
			return result
		end

		if self:IsTeamTurn(unit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end

		if unit.IsDead == true then
			result.Reason = "UNIT_DEAD"
			return result
		end

		result.PreviousFacing = unit.Facing
		local nextFacing = "Right"
		if unit.Facing == "Right" then
			nextFacing = "Left"
		end
		local facingResult = unit:ApplyFacingState(nextFacing)
		if facingResult.Success == false then
			result.Reason = facingResult.Reason
			return result
		end
		result.CurrentFacing = facingResult.CurrentFacing
		self:ApplyFacing(unitEntity, unit.Facing)

		local turnedEvent = UnitTurnedEvent()
		turnedEvent.UnitId = unit.UnitId
		turnedEvent.PreviousFacing = result.PreviousFacing
		turnedEvent.CurrentFacing = result.CurrentFacing
		self.Entity:SendEvent(turnedEvent)

		result.Success = true
		result.Reason = "OK"
		log("[BattleTurn] success unit=" .. unit.UnitId .. " from=" .. result.PreviousFacing .. " to=" .. result.CurrentFacing .. " cell=" .. unit.CellIndex)
		return result
	end

	@ExecSpace("ServerOnly")
	method table TryFaceDirection(string unitId, integer direction)
		-- Sets one living unit to an explicit prepared direction without deriving it again from the current target position.
		local result = {
			Success = false,
			Reason = "UNKNOWN",
			PreviousFacing = "",
			CurrentFacing = ""
		}

		if direction ~= -1 and direction ~= 1 then
			result.Reason = "INVALID_DIRECTION"
			return result
		end

		local unitEntity = self:FindUnitEntity(unitId)
		if isvalid(unitEntity) == false then
			result.Reason = "UNIT_NOT_FOUND"
			return result
		end

		local unit = unitEntity:GetComponent("script.BattleUnitComponent")
		if unit == nil then
			result.Reason = "UNIT_COMPONENT_MISSING"
			return result
		end
		if self:IsTeamTurn(unit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end
		if unit.IsDead == true then
			result.Reason = "UNIT_DEAD"
			return result
		end

		result.PreviousFacing = unit.Facing
		result.CurrentFacing = "Right"
		if direction < 0 then
			result.CurrentFacing = "Left"
		end

		if result.PreviousFacing == result.CurrentFacing then
			result.Success = true
			result.Reason = "ALREADY_FACING"
			log("[BattleTurn] kept unit=" .. unit.UnitId .. " facing=" .. result.CurrentFacing .. " cell=" .. unit.CellIndex)
			return result
		end

		local facingResult = unit:ApplyFacingState(result.CurrentFacing)
		if facingResult.Success == false then
			result.Reason = facingResult.Reason
			return result
		end
		self:ApplyFacing(unitEntity, unit.Facing)

		local turnedEvent = UnitTurnedEvent()
		turnedEvent.UnitId = unit.UnitId
		turnedEvent.PreviousFacing = result.PreviousFacing
		turnedEvent.CurrentFacing = result.CurrentFacing
		self.Entity:SendEvent(turnedEvent)

		result.Success = true
		result.Reason = "OK"
		log("[BattleTurn] success unit=" .. unit.UnitId .. " from=" .. result.PreviousFacing .. " to=" .. result.CurrentFacing .. " cell=" .. unit.CellIndex .. " source=PREPARED_DIRECTION")
		return result
	end

	method integer GetFacingDirection(string facing)
		-- Converts the logical facing string into a stable one-cell direction.
		if facing == "Right" then
			return 1
		end
		return -1
	end

	@ExecSpace("ServerOnly")
	method void ApplyFacing(Entity targetEntity, string facing)
		-- Uses the native player look direction so the three-layer avatar renderer turns correctly.
		if targetEntity.PlayerControllerComponent == nil then
			return
		end

		if facing == "Right" then
			targetEntity.PlayerControllerComponent.LookDirectionX = 1
		else
			targetEntity.PlayerControllerComponent.LookDirectionX = -1
		end
	end

	@ExecSpace("Server")
	method void RequestQueueTile(string tileId)
		-- Validates the requesting player before registering one supported tile in the queue slot.
		if self:IsValidPlayerRequest(senderUserId) == false then
			log_warning("[BattleTileQueue] register rejected tile=" .. tileId .. " reason=INVALID_SENDER")
			return
		end

		local result = self:TryQueueTile(tileId)
		self:PublishPlayerCommandResult("QUEUE_TILE", result)
		if result.Success == false then
			log_warning("[BattleTileQueue] register rejected tile=" .. tileId .. " reason=" .. result.Reason)
		end
	end

	@ExecSpace("Server")
	method void RequestExecuteQueuedTile()
		-- Validates the requesting player before executing the registered tile.
		if self:IsValidPlayerRequest(senderUserId) == false then
			log_warning("[BattleTileQueue] execute rejected reason=INVALID_SENDER")
			return
		end

		local result = self:TryExecuteQueuedTile()
		self:PublishPlayerCommandResult("EXECUTE_QUEUE", result)
		if result.Success == false then
			log_warning("[BattleTileQueue] execute rejected reason=" .. result.Reason)
		end
	end

	@ExecSpace("Server")
	method void RequestClearQueuedTile()
		-- Validates the requesting player before clearing the registered tile.
		if self:IsValidPlayerRequest(senderUserId) == false then
			log_warning("[BattleTileQueue] clear rejected reason=INVALID_SENDER")
			return
		end

		local result = self:TryClearQueuedTile()
		self:PublishPlayerCommandResult("CLEAR_QUEUE", result)
		if result.Success == false then
			log_warning("[BattleTileQueue] clear rejected reason=" .. result.Reason)
		end
	end

	@ExecSpace("Server")
	method void RequestRemoveQueuedTile(integer queueIndex)
		-- Validates the requesting player before removing one queued tile for free.
		if self:IsValidPlayerRequest(senderUserId) == false then
			log_warning("[BattleTileQueue] remove rejected index=" .. queueIndex .. " reason=INVALID_SENDER")
			return
		end

		local result = self:TryRemoveQueuedTileAt(queueIndex)
		self:PublishPlayerCommandResult("REMOVE_QUEUE_ITEM", result)
		if result.Success == false then
			log_warning("[BattleTileQueue] remove rejected index=" .. queueIndex .. " reason=" .. result.Reason)
		end
	end

	@ExecSpace("Server")
	method void RequestMoveQueuedTile(integer fromIndex, integer toIndex)
		-- Validates the requesting player before reordering the queued tiles for free.
		if self:IsValidPlayerRequest(senderUserId) == false then
			log_warning("[BattleTileQueue] move rejected from=" .. fromIndex .. " to=" .. toIndex .. " reason=INVALID_SENDER")
			return
		end

		local result = self:TryMoveQueuedTile(fromIndex, toIndex)
		self:PublishPlayerCommandResult("REORDER_QUEUE", result)
		if result.Success == false then
			log_warning("[BattleTileQueue] move rejected from=" .. fromIndex .. " to=" .. toIndex .. " reason=" .. result.Reason)
		end
	end

	@ExecSpace("ServerOnly")
	method boolean IsValidPlayerRequest(string requestingUserId)
		-- Confirms that a client request belongs to the registered solo player.
		if isvalid(self.PlayerEntity) == false or self.PlayerEntity.PlayerComponent == nil then
			return false
		end

		return self.PlayerEntity.PlayerComponent.UserId == requestingUserId
	end

	@ExecSpace("ServerOnly")
	method void PublishPlayerCommandResult(string commandType, table result)
		-- Records one authoritative command result so UI can explain accepted and rejected input.
		local success = result ~= nil and result.Success == true
		local reason = "UNKNOWN"
		if result ~= nil and result.Reason ~= nil then
			reason = result.Reason
		end
		self.TurnState:RecordCommandResult(commandType, success, reason)
		self:PublishTurnStateSnapshot("PLAYER_COMMAND_RESULT")
	end

	@ExecSpace("ServerOnly")
	method table ApplyQueueCapacityModifier(string modifierId, string sourceType, string sourceId, integer addValue)
		-- Stable server entry point for Job, Skill, Augment, Relic, Item, and Stage Rule systems.
		local result = self.TurnState:UpsertQueueCapacityModifier(modifierId, sourceType, sourceId, addValue)
		if result.Success == true then
			self:PublishTurnStateSnapshot("QUEUE_CAPACITY_MODIFIER_UPSERT")
		end
		return result
	end

	@ExecSpace("ServerOnly")
	method table RemoveQueueCapacityModifier(string modifierId)
		-- Removes one external queue-capacity contribution and republishes the snapshot.
		local result = self.TurnState:RemoveQueueCapacityModifier(modifierId)
		if result.Success == true then
			self:PublishTurnStateSnapshot("QUEUE_CAPACITY_MODIFIER_REMOVED")
		end
		return result
	end

	@ExecSpace("ServerOnly")
	method table GetQueueCapacityState()
		-- Exposes the authoritative queue-capacity state to server integrations.
		return self.TurnState:GetQueueCapacityState()
	end

	@ExecSpace("ServerOnly")
	method table TryQueueTile(string tileId)
		-- Appends one supported tile up to the configurable queue capacity.
		local result = {
			Success = false,
			Reason = "UNKNOWN",
			QueueIndex = -1,
			QueueCount = self.QueuedTileCount,
			ConsumesTurn = true
		}

		local capacity = self.TurnState.TileQueueCapacity

		local skillValidation = _ContentValidatorLogic:ValidateSkillById(tileId)
		if skillValidation.Success == false then
			result.Reason = skillValidation.Reason
			result.DetailReason = skillValidation.DetailReason or ""
			return result
		end
		local ownership = _RunManagerLogic:CanUseRunSkill(self.PlayerEntity, tileId)
		if ownership.Success == false then
			result.Reason = ownership.Reason
			result.OwnedAmount = ownership.OwnedAmount or 0
			log_warning("[BattleTileQueue] ownership rejected tile=" .. tileId .. " reason=" .. result.Reason .. " owned=" .. result.OwnedAmount)
			return result
		end

		local runtimeState = self:GetSkillRuntimeState("player_01")
		if runtimeState == nil then
			result.Reason = "SKILL_RUNTIME_STATE_MISSING"
			return result
		end
		local cooldownResult = runtimeState:CanUseSkill(tileId)
		if cooldownResult.Success == false then
			result.Reason = cooldownResult.Reason
			result.RemainingTurns = cooldownResult.RemainingTurns
			return result
		end
		local definition = skillValidation.Data.Definition
		if definition.CooldownTurns > 0 and self.TurnState:QueueContainsSkill(self.TurnState.QueuedTileIds, tileId) then
			result.Reason = "COOLDOWN_RESERVED"
			result.RemainingTurns = definition.CooldownTurns
			return result
		end

		result = self.TurnState:TryAppendSkill(tileId)
		if result.Success == false then
			return result
		end
		result.ConsumesTurn = definition.FreePlay ~= true
		self:PublishTurnStateSnapshot("SKILL_QUEUED")
		log("[BattleTileQueue] registered tile=" .. tileId .. " index=" .. result.QueueIndex .. " count=" .. result.QueueCount .. "/" .. capacity .. " turn=" .. self.TurnNumber .. " consumesTurn=" .. tostring(result.ConsumesTurn))
		if result.ConsumesTurn == true and self.BattleResult == "" then
			self:BeginEnemyTurn()
		else
			log("[BattleTurnFlow] freeplay queue retained tile=" .. tileId .. " turn=" .. self.TurnNumber)
		end
		return result
	end

	@ExecSpace("ServerOnly")
	method table TryExecuteQueuedTile()
		-- Freezes the registered queue and starts an arbitrary-length sequential execution pass.
		local result = self.TurnState:TryFreezeSkillQueue()
		if result.Success == false then
			return result
		end
		self.CurrentPlayerActionKillCount = 0
		self:PublishTurnStateSnapshot("SKILL_QUEUE_FROZEN")
		log("[BattleTileQueue] execution started count=" .. self:GetTileIdCount(self.ExecutingTileIds) .. " capacity=" .. self.TileQueueCapacity .. " turn=" .. self.TurnNumber)
		self:ExecuteNextQueuedTile()
		return result
	end

	@ExecSpace("ServerOnly")
	method void ExecuteNextQueuedTile()
		-- Resolves exactly one tile, then advances only after its action duration has completed.
		local tileCount = self.TurnState:GetTileIdCount(self.TurnState.ExecutingTileIds)
		if self.TurnState.ExecutingTileIndex <= 0 or self.TurnState.ExecutingTileIndex > tileCount then
			self:CompleteTileQueueExecution(true, "QUEUE_COMPLETE")
			return
		end

		local tileId = self.TurnState:GetTileIdAt(self.TurnState.ExecutingTileIds, self.TurnState.ExecutingTileIndex)
		local actionType = self:GetTileActionType(tileId)
		if actionType == "" then
			self:CompleteTileQueueExecution(false, "UNKNOWN_SKILL")
			return
		end

		self.TurnState:SetExecutingAction(actionType, 0)
		self:PublishTurnStateSnapshot("SKILL_EXECUTING")
		log("[BattleTileQueue] tile started index=" .. self.ExecutingTileIndex .. "/" .. tileCount .. " tile=" .. tileId .. " action=" .. actionType)

		local actionResult = nil
		if actionType == "EXECUTE_SKILL" then
			actionResult = self:TryExecuteSkill("player_01", tileId)
		end

		if actionResult == nil or actionResult.Success == false then
			local reason = "EXECUTION_FAILED"
			if actionResult ~= nil then
				reason = actionResult.Reason
			end
			self:CompleteTileQueueExecution(false, reason)
			return
		end

		local completedIndex = self.TurnState.ExecutingTileIndex
		local duration = self:GetSkillActionDuration(tileId)
		local complete = function()
			self.ActionTimerId = 0
			log("[BattleTileQueue] tile completed index=" .. completedIndex .. "/" .. tileCount .. " tile=" .. tileId .. " reason=" .. actionResult.Reason)
			if self.BattleResult ~= "" then
				self:CompleteTileQueueExecution(true, "BATTLE_ENDED")
				return
			end
			self.TurnState:AdvanceExecutingSkill()
			self:PublishTurnStateSnapshot("SKILL_ADVANCED")
			self:ExecuteNextQueuedTile()
		end
		self.ActionTimerId = _TimerService:SetTimerOnce(complete, duration)
	end

	@ExecSpace("ServerOnly")
	method void CompleteTileQueueExecution(boolean success, string reason)
		-- Clears execution state once, then hands control to the enemy only after the full queue succeeds.
		local executedCount = self.TurnState:GetTileIdCount(self.TurnState.ExecutingTileIds)
		self.ActionTimerId = 0
		self.TurnState:CompleteSkillQueue(reason)
		self:PublishTurnStateSnapshot("SKILL_QUEUE_COMPLETED")
		log("[BattleTileQueue] execution completed success=" .. tostring(success) .. " reason=" .. reason .. " count=" .. executedCount)

		if self.BattleResult ~= "" then
			return
		end
		if success then
			self:BeginEnemyTurn()
			return
		end
	end

	method string AppendTileId(string serializedQueue, string tileId)
		if serializedQueue == "" then
			return tileId
		end
		return serializedQueue .. "|" .. tileId
	end

	method boolean QueueContainsSkill(string serializedQueue, string skillId)
		for queuedSkillId in string.gmatch(serializedQueue, "([^|]+)") do
			if queuedSkillId == skillId then
				return true
			end
		end
		return false
	end

	method integer GetTileIdCount(string serializedQueue)
		if serializedQueue == "" then
			return 0
		end
		local count = 0
		for _ in string.gmatch(serializedQueue, "([^|]+)") do
			count = count + 1
		end
		return count
	end

	method string GetTileIdAt(string serializedQueue, integer targetIndex)
		if targetIndex <= 0 then
			return ""
		end
		local index = 0
		for tileId in string.gmatch(serializedQueue, "([^|]+)") do
			index = index + 1
			if index == targetIndex then
				return tileId
			end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method string GetTileActionType(string tileId)
		local validation = _ContentValidatorLogic:ValidateSkillById(tileId)
		if validation.Success == true then
			return "EXECUTE_SKILL"
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method number GetSkillActionDuration(string skillId)
		-- Scaled by the same multiplier as the motion, so the queue slot frees when the swing ends
		-- instead of holding the turn for the original 1x duration.
		local validation = _ContentValidatorLogic:ValidateSkillById(skillId)
		if validation.Success == false then
			return 0.1
		end
		local definition = validation.Data.Definition
		local speed = self:GetSkillSpeedMultiplier()
		local authored = definition.ActionDuration / speed
		if self:HasSkillProjectile(definition) == false then
			return math.max(0.1, authored)
		end

		-- A projectile skill resolves only after the shot lands, so the queue slot must outlive the
		-- worst-case flight. Actual flight uses the real target distance; the clamp uses full range
		-- because the target is not known until the shot is scheduled.
		local launchDelay = self:GetProjectileLaunchDelay(definition)
		local worstFlight = (definition.Range * self.CellSpacing) / (definition.ProjectileSpeed * speed)
		local minimumDuration = launchDelay + worstFlight
		return math.max(0.1, authored, minimumDuration)
	end

	@ExecSpace("ServerOnly")
	method table TryClearQueuedTile()
		-- Clears every registered tile only while the player still owns an idle input phase.
		local clearedCount = self.TurnState.QueuedTileCount
		local result = self.TurnState:TryClearQueuedSkills()
		if result.Success == false then
			return result
		end
		self:PublishTurnStateSnapshot("SKILL_QUEUE_CLEARED")
		log("[BattleTileQueue] cleared count=" .. clearedCount .. " turn=" .. self.TurnNumber)
		return result
	end

	@ExecSpace("ServerOnly")
	method table TryRemoveQueuedTileAt(integer queueIndex)
		-- Removes one queued tile without advancing the turn or starting the enemy round.
		local result = self.TurnState:TryRemoveQueuedSkillAt(queueIndex)
		if result.Success == false then
			return result
		end
		self:PublishTurnStateSnapshot("SKILL_QUEUE_ITEM_REMOVED")
		log("[BattleTileQueue] removed index=" .. queueIndex .. " tile=" .. result.RemovedSkillId .. " remaining=" .. result.QueueCount .. " turn=" .. self.TurnNumber)
		return result
	end

	@ExecSpace("ServerOnly")
	method table TryMoveQueuedTile(integer fromIndex, integer toIndex)
		-- Reorders the queued tiles without advancing the turn or starting the enemy round.
		local result = self.TurnState:TryMoveQueuedSkill(fromIndex, toIndex)
		if result.Success == false then
			return result
		end
		if result.Reason == "MOVED" then
			self:PublishTurnStateSnapshot("SKILL_QUEUE_ITEM_MOVED")
			log("[BattleTileQueue] moved tile=" .. result.MovedSkillId .. " from=" .. fromIndex .. " to=" .. toIndex .. " queue=" .. self.TurnState.QueuedTileIds .. " turn=" .. self.TurnNumber)
		end
		return result
	end

	@ExecSpace("Server")
	method void RequestResetBattle()
		-- Accepts Reset only from the registered solo player after the battle has ended.
		if self:IsValidPlayerRequest(senderUserId) == false then
			log_warning("[BattleReset] rejected reason=INVALID_SENDER")
			return
		end

		local result = self:ResetBattle()
		self:PublishPlayerCommandResult("RESET_BATTLE", result)
		if result.Success == false then
			log_warning("[BattleReset] rejected reason=" .. result.Reason)
		end
	end

	@ExecSpace("ServerOnly")
	method table ResetBattle()
		-- Restarts a completed battle with a fresh entry request so its result is recorded independently.
		local result = {
			Success = false,
			Reason = "UNKNOWN"
		}

		if self.BattleResult == "" then
			result.Reason = "BATTLE_NOT_ENDED"
			return result
		end
		if isvalid(self.PlayerEntity) == false then
			result.Reason = "PLAYER_MISSING"
			return result
		end

		local entryState = _BattleGatewayLogic:GetOrCreateEntryState(self.PlayerEntity)
		if entryState == nil then
			result.Reason = "ENTRY_STATE_UNAVAILABLE"
			return result
		end
		local retryEntry = entryState:Prepare(
			self.StageId,
			self.SelectedCharacterId,
			self.SelectedJobId,
			self.SelectedLoadoutId,
			self.RunSeed,
			"CONTINUE_RUN"
		)
		if retryEntry.Success == false then
			result.Reason = retryEntry.Reason
			return result
		end

		self.EntryRequestId = retryEntry.RequestId
		local rebuildResult = self:RebuildBattleState("RESET")
		if rebuildResult.Success == false then
			entryState:Cancel("RESET_REBUILD_FAILED")
			entryState:RecordFailure(rebuildResult.Reason)
			return rebuildResult
		end
		local startedResult = entryState:MarkStarted()
		if startedResult.Success == false then
			result.Reason = startedResult.Reason
			return result
		end
		log("[BattleReset] retry entry started request=" .. self.EntryRequestId .. " stage=" .. self.StageId)
		return rebuildResult
	end

	@ExecSpace("ServerOnly")
	method void ApplyRunJobConfiguration(any runState)
		-- Copies the player-owned job snapshot into synchronized map-scoped battle state.
		if runState == nil then
			return
		end
		self.SelectedJobId = runState.SelectedJobId
		self.SelectedJobMechanicId = runState.SelectedJobMechanicId
		self.SelectedJobPassiveSetId = runState.SelectedJobPassiveSetId
		self.SelectedJobStartingSkillIds = runState.StartingSkillIds
		self.SelectedJobBaseMaxHp = runState.JobBaseMaxHp
		self.SelectedJobBaseQueueCapacity = runState.JobBaseQueueCapacity
		self.SelectedJobRevision = runState.JobRevision
		log("[BattleJob] configuration applied job=" .. self.SelectedJobId .. " mechanic=" .. self.SelectedJobMechanicId .. " passive=" .. self.SelectedJobPassiveSetId .. " hp=" .. self.SelectedJobBaseMaxHp .. " queue=" .. self.SelectedJobBaseQueueCapacity .. " skills=" .. self.SelectedJobStartingSkillIds .. " revision=" .. self.SelectedJobRevision)
		self:RefreshSkillSlots("JOB_APPLIED")
	end

	@ExecSpace("ServerOnly")
	method void RefreshSkillSlots(string reason)
		-- Draws this battle's HUD slots at random from the skills the player actually owns, and resolves
		-- their display names here because the skill DataSets are server-only and the HUD cannot read them.
		-- Re-rolls only when the owned set changes, so slots stay stable for the duration of a battle.
		local ownedSnapshot = ""
		if isvalid(self.PlayerEntity) then
			local inventory = self.PlayerEntity:GetComponent("script.PlayerRunInventoryComponent")
			if inventory ~= nil then
				ownedSnapshot = inventory.RunSkillSnapshot
			end
		end
		if ownedSnapshot == "" then
			ownedSnapshot = self.SelectedJobStartingSkillIds
		end
		if ownedSnapshot == self.SkillSlotSourceSnapshot then
			return
		end
		self.SkillSlotSourceSnapshot = ownedSnapshot

		local candidates = {}
		local seen = {}
		for token in string.gmatch(ownedSnapshot or "", "([^|]+)") do
			-- Inventory snapshot entries carry an owned-amount suffix ("brandish~1"); only the id selects a slot.
			local skillId = string.match(token, "^([^~]+)")
			if skillId ~= nil and skillId ~= "" and seen[skillId] == nil then
				seen[skillId] = true
				table.insert(candidates, skillId)
			end
		end

		-- Fisher-Yates so every owned skill has an equal chance of reaching a slot.
		for index = #candidates, 2, -1 do
			local swap = _UtilLogic:RandomIntegerRange(1, index)
			local held = candidates[index]
			candidates[index] = candidates[swap]
			candidates[swap] = held
		end

		-- Icons cover every candidate, not just the drawn slots, because the queue accepts any owned skill.
		local iconRecords = {}
		for _, skillId in ipairs(candidates) do
			local definition = _SkillDefinitionRepositoryLogic:GetSkillDefinition(skillId)
			if definition.Success == true and definition.IconRuid ~= nil and definition.IconRuid ~= "" then
				table.insert(iconRecords, skillId .. "~" .. definition.IconRuid)
			end
		end

		local slotIds = {}
		local slotNames = {}
		local slotCount = math.min(self.SkillSlotCount, #candidates)
		for index = 1, slotCount do
			local skillId = candidates[index]
			local definition = _SkillDefinitionRepositoryLogic:GetSkillDefinition(skillId)
			if definition.Success == true then
				table.insert(slotIds, skillId)
				table.insert(slotNames, definition.DisplayName)
			end
		end

		self.SkillSlotIds = table.concat(slotIds, "|")
		self.SkillSlotNames = table.concat(slotNames, "|")
		self.SkillIconSnapshot = table.concat(iconRecords, "|")
		log("[BattleSkillSlots] assigned reason=" .. reason .. " owned=" .. ownedSnapshot .. " slots=" .. self.SkillSlotIds .. " names=" .. self.SkillSlotNames .. " icons=" .. tostring(#iconRecords))
	end

	@ExecSpace("ServerOnly")
	method table StartNewRun(integer runSeed)
		-- Asks the player-owned run state to begin, then rebuilds this map-scoped battle.
		if isvalid(self.PlayerEntity) == false then
			return {
				Success = false,
				Reason = "PLAYER_MISSING"
			}
		end
		local runState = _RunManagerLogic:StartNewRun(self.PlayerEntity, runSeed)
		if runState == nil then
			return {
				Success = false,
				Reason = "RUN_STATE_UNAVAILABLE"
			}
		end
		local jobResult = _RunManagerLogic:ApplyJobSelection(self.PlayerEntity, self.SelectedJobId)
		if jobResult.Success == false then
			return jobResult
		end
		self:ApplyRunJobConfiguration(runState)
		self.RunSeed = runState.RunSeed
		log("[BattleRun] new run requested sequence=" .. runState.RunSequence .. " seed=" .. self.RunSeed)
		return self:RebuildBattleState("NEW_RUN")
	end

	@ExecSpace("ServerOnly")
	method table InitializeFromEntry(Entity playerEntity, string stageId, string characterId, string jobId, string loadoutId, integer runSeed, string entryMode, integer requestId)
		-- Public map-session initializer used only through BattleGatewayLogic.
		local result = {
			Success = false,
			Reason = "UNKNOWN",
			RequestId = requestId,
			StageId = stageId
		}
		if isvalid(playerEntity) == false or playerEntity.PlayerComponent == nil then
			result.Reason = "INVALID_PLAYER"
			return result
		end
		if stageId == nil or stageId == "" then
			result.Reason = "INVALID_STAGE_ID"
			return result
		end
		if requestId > 0 and requestId == self.LastInitializedEntryRequestId then
			result.Reason = "DUPLICATE_ENTRY_INITIALIZATION"
			log_warning("[BattleSession] duplicate entry initialization blocked request=" .. requestId .. " stageId=" .. stageId)
			return result
		end
		log("[BattleSession] initialize from entry stageId=" .. stageId .. " request=" .. requestId)
		local stageValidation = _ContentValidatorLogic:ValidateStageById(stageId)
		if stageValidation.Success == false then
			result.Reason = stageValidation.Reason
			result.DetailReason = stageValidation.DetailReason or ""
			return result
		end
		if entryMode ~= "NEW_RUN" and entryMode ~= "CONTINUE_RUN" then
			result.Reason = "INVALID_ENTRY_MODE"
			return result
		end

		local runState = nil
		if entryMode == "NEW_RUN" then
			runState = _RunManagerLogic:StartNewRun(playerEntity, runSeed)
		else
			runState = _RunManagerLogic:EnsureRunState(playerEntity, runSeed)
		end
		if runState == nil then
			result.Reason = "RUN_STATE_UNAVAILABLE"
			return result
		end
		local jobResult = _RunManagerLogic:ApplyJobSelection(playerEntity, jobId)
		if jobResult.Success == false then
			result.Reason = jobResult.Reason
			result.DetailReason = jobResult.DetailReason or ""
			return result
		end
		self:ApplyRunJobConfiguration(runState)

		local applyResult = self:LoadAndApplyStageDefinition(stageId)
		if applyResult.Success == false then
			result.Reason = applyResult.Reason
			result.DetailReason = applyResult.DetailReason or ""
			return result
		end
		self.RunSeed = runState.RunSeed
		self.EntryRequestId = requestId
		self.EntryMode = entryMode
		self.SelectedCharacterId = characterId or ""
		self.SelectedLoadoutId = loadoutId or ""
		self:RegisterPlayer(playerEntity)

		local rebuildResult = self:RebuildBattleState("BATTLE_ENTRY")
		result.Success = rebuildResult.Success
		result.Reason = rebuildResult.Reason
		if result.Success == true then
			self.LastInitializedEntryRequestId = requestId
		end
		log("[BattleSession] entry initialized request=" .. requestId .. " stage=" .. self.StageId .. " character=" .. self.SelectedCharacterId .. " job=" .. self.SelectedJobId .. " loadout=" .. self.SelectedLoadoutId .. " seed=" .. self.RunSeed .. " mode=" .. self.EntryMode .. " success=" .. tostring(result.Success))
		return result
	end

	@ExecSpace("ServerOnly")
	method table RunContentValidationGate(string reason)
		-- Coordinates startup validation while domain validators retain all content rules.
		local validation = nil
		if self.RequireValidContentAtStartup == false then
			validation = {
				Success = true,
				Reason = "VALIDATION_DISABLED",
				ErrorCount = 0,
				ErrorSnapshot = ""
			}
		else
			validation = _ContentValidatorLogic:ValidateAllContent()
		end
		if validation == nil then
			validation = {
				Success = false,
				Reason = "VALIDATOR_UNAVAILABLE",
				ErrorCount = 1,
				ErrorSnapshot = "ContentValidatorLogic[0]=VALIDATOR_UNAVAILABLE"
			}
		end
		self:ApplyContentValidationResult(validation, reason)
		return validation
	end

	@ExecSpace("ServerOnly")
	method void ApplyContentValidationResult(table validation, string reason)
		-- Publishes a compact synchronized gate result; UI does not inspect datasets or validator internals.
		if validation ~= nil and validation.Success == true then
			self.ContentValidationState = "VALID"
			self.ContentValidationReason = validation.Reason or "OK"
			self.ContentValidationErrorCount = validation.ErrorCount or 0
			self.ContentValidationErrorSnapshot = validation.ErrorSnapshot or ""
			self.ContentValidationRevision = self.ContentValidationRevision + 1
			log("[BattleContentGate] valid trigger=" .. reason .. " revision=" .. self.ContentValidationRevision)
			return
		end

		self.ContentValidationState = "BLOCKED"
		self.ContentValidationReason = validation ~= nil and (validation.Reason or "CONTENT_VALIDATION_FAILED") or "VALIDATOR_UNAVAILABLE"
		self.ContentValidationErrorCount = validation ~= nil and (validation.ErrorCount or 1) or 1
		self.ContentValidationErrorSnapshot = validation ~= nil and (validation.ErrorSnapshot or "") or "ContentValidatorLogic[0]=VALIDATOR_UNAVAILABLE"
		self.ContentValidationRevision = self.ContentValidationRevision + 1
		log_error("[BattleContentGate] blocked trigger=" .. reason .. " reason=" .. self.ContentValidationReason .. " errors=" .. self.ContentValidationErrorCount .. " details=" .. self.ContentValidationErrorSnapshot)
	end

	method boolean IsContentValidationReady()
		if self.RequireValidContentAtStartup == false then
			return true
		end
		return self.ContentValidationState == "VALID"
	end

	@ExecSpace("ClientOnly")
	method table ParseEnemyPlanSnapshot(string serializedPlans)
		-- Parses the server DTO only; no pattern, targeting, or trait rule is repeated on the client.
		local plans = {}
		for entry in string.gmatch(serializedPlans or "", "([^#]+)") do
			local fields = {}
			for field in string.gmatch(entry, "([^,]+)") do
				table.insert(fields, field)
			end
			if #fields >= 14 and fields[1] ~= "" then
				local unitId = self:DecodeEnemyPlanField(fields[1])
				local traitIds = self:DecodeEnemyPlanField(fields[6])
				local actionType = self:DecodeEnemyPlanField(fields[7])
				local tileId = self:DecodeEnemyPlanField(fields[8])
				local patternId = self:DecodeEnemyPlanField(fields[11])
				local actionSnapshot = self:DecodeEnemyPlanField(fields[14])
				local bossPhaseId = ""
				local bossPhaseIndex = 0
				local bossPhaseRevision = 0
				local queueTurnsRequired = 0
				local queueTurnsElapsed = 0
				local readinessReason = ""
				local nextCommandType = ""
				local targetCellSnapshot = ""
				local nextCommandDirection = 0
				local entityName = ""
				local queuedTileNames = ""
				local queuedIconRuids = ""
				local telegraphKind = ""
				local landingCell = -1
				local deferredUntilTurn = 0
				if #fields >= 17 then
					bossPhaseId = self:DecodeEnemyPlanField(fields[15])
					bossPhaseIndex = math.floor(tonumber(fields[16]) or 0)
					bossPhaseRevision = math.floor(tonumber(fields[17]) or 0)
				end
				if #fields >= 19 then
					queueTurnsRequired = math.floor(tonumber(fields[18]) or 0)
					queueTurnsElapsed = math.floor(tonumber(fields[19]) or 0)
				end
				if #fields >= 22 then
					readinessReason = self:DecodeEnemyPlanField(fields[20])
					nextCommandType = self:DecodeEnemyPlanField(fields[21])
					targetCellSnapshot = self:DecodeEnemyPlanField(fields[22])
				end
				if #fields >= 23 then
					nextCommandDirection = math.floor(tonumber(fields[23]) or 0)
				end
				if #fields >= 25 then
					entityName = self:DecodeEnemyPlanField(fields[24])
					queuedTileNames = self:DecodeEnemyPlanField(fields[25])
				end
				if #fields >= 26 then
					queuedIconRuids = self:DecodeEnemyPlanField(fields[26])
				end
				if #fields >= 28 then
					telegraphKind = self:DecodeEnemyPlanField(fields[27])
					landingCell = math.floor(tonumber(fields[28]) or -1)
				end
				if #fields >= 29 then
					deferredUntilTurn = math.floor(tonumber(fields[29]) or 0)
				end
				local queuedTileIds = ""
				local hasInsertedQueue = fields[3] ~= "INSERTING"
				if hasInsertedQueue then
					for actionEntry in string.gmatch(actionSnapshot or "", "([^>]+)") do
						local actionFields = {}
						for actionField in string.gmatch(actionEntry, "([^~]+)") do
							table.insert(actionFields, actionField)
						end
						local queuedTileId = ""
						if #actionFields >= 3 then
							queuedTileId = self:DecodeEnemyPlanField(actionFields[3])
						end
						if queuedTileId ~= "" then
							if queuedTileIds ~= "" then
								queuedTileIds = queuedTileIds .. "|"
							end
							queuedTileIds = queuedTileIds .. queuedTileId
						end
					end
				else
					-- INSERTING is a selected future action, not an item already owned by the enemy queue.
					queuedTileNames = ""
					queuedIconRuids = ""
				end
				table.insert(plans, {
					UnitId = unitId,
					SpawnOrder = math.floor(tonumber(fields[2]) or 0),
					State = self:DecodeEnemyPlanField(fields[3]),
					CurrentActionIndex = math.floor(tonumber(fields[4]) or 0),
					ActionCount = math.floor(tonumber(fields[5]) or 0),
					TraitIds = traitIds,
					CommandType = actionType,
					TileId = tileId,
					Direction = math.floor(tonumber(fields[9]) or 0),
					TelegraphTurnsRemaining = math.floor(tonumber(fields[10]) or 0),
					PatternId = patternId,
					StepIndex = math.floor(tonumber(fields[12]) or 0),
					Revision = math.floor(tonumber(fields[13]) or 0),
					QueuedActionSnapshot = actionSnapshot,
					QueuedTileIds = queuedTileIds,
					BossPhaseId = bossPhaseId,
					BossPhaseIndex = bossPhaseIndex,
					BossPhaseRevision = bossPhaseRevision,
					QueueTurnsRequired = queueTurnsRequired,
					QueueTurnsElapsed = queueTurnsElapsed,
					ReadinessReason = readinessReason,
					NextCommandType = nextCommandType,
					NextCommandDirection = nextCommandDirection,
					TargetCells = targetCellSnapshot,
					EntityName = entityName,
					QueuedTileNames = queuedTileNames,
					QueuedIconRuids = queuedIconRuids,
					TelegraphKind = telegraphKind,
					LandingCell = landingCell,
					DeferredUntilTurn = deferredUntilTurn,
					IsAttackReady = fields[3] == "ATTACK_READY",
					IsQueueReady = hasInsertedQueue
				})
			end
		end
		table.sort(plans, function(left, right)
			return left.SpawnOrder < right.SpawnOrder
		end)
		return plans
	end

	@ExecSpace("ClientOnly")
	method string DecodeEnemyPlanField(string value)
		if value == "-" then
			return ""
		end
		return value or ""
	end

	@ExecSpace("ClientOnly")
	method table GetBattleUiState()
		-- Builds one read-only client DTO from synchronized map, turn, wave, cooldown, and intent state.
		local stateEntity = self.Entity:GetChildByName("BattleTurnState")
		local turnState = nil
		if stateEntity ~= nil then
			turnState = stateEntity:GetComponent("script.BattleTurnComponent")
		else
			turnState = self.Entity:GetComponent("script.BattleTurnComponent")
		end
		local waveEntity = self.Entity:GetChildByName("BattleWaveState")
		local waveState = nil
		if waveEntity ~= nil then
			waveState = waveEntity:GetComponent("script.BattleWaveComponent")
		else
			waveState = self.Entity:GetComponent("script.BattleWaveComponent")
		end
		local intentEntity = self.Entity:GetChildByName("BattleEnemyIntentState")
		local intentState = nil
		if intentEntity ~= nil then
			intentState = intentEntity:GetComponent("script.EnemyIntentComponent")
		else
			intentState = self.Entity:GetComponent("script.EnemyIntentComponent")
		end
		if turnState == nil or waveState == nil then
			return { Success = false, Reason = "BATTLE_STATE_MISSING" }
		end

		local cooldownSnapshot = ""
		local cooldownRevision = 0
		local runConsumableSnapshot = ""
		local runCurrencySnapshot = ""
		local runSkillSnapshot = ""
		local runInventoryRevision = 0
		local runSkillInventoryRevision = 0
		local runConsumableCapacity = 0
		local ownedAugmentSnapshot = ""
		local runAugmentRevision = 0
		local localPlayer = _UserService.LocalPlayer
		if localPlayer ~= nil then
			local runtimeState = localPlayer:GetComponent("script.SkillRuntimeStateComponent")
			if runtimeState ~= nil then
				cooldownSnapshot = runtimeState.CooldownSnapshot
				cooldownRevision = runtimeState.CooldownRevision
			end
			local runInventory = localPlayer:GetComponent("script.PlayerRunInventoryComponent")
			if runInventory ~= nil then
				runConsumableSnapshot = runInventory.RunConsumableSnapshot
				runCurrencySnapshot = runInventory.RunCurrencySnapshot
				runSkillSnapshot = runInventory.RunSkillSnapshot
				runInventoryRevision = runInventory.InventoryRevision
				runSkillInventoryRevision = runInventory.SkillInventoryRevision
				runConsumableCapacity = runInventory.ConsumableCapacity
			end
			local runAugments = localPlayer:GetComponent("script.PlayerRunAugmentComponent")
			if runAugments ~= nil then
				ownedAugmentSnapshot = runAugments.OwnedAugmentSnapshot
				runAugmentRevision = runAugments.AugmentRevision
			end
		end
		local dropRuntime = self.Entity:GetComponent("script.BattleDropComponent")
		local pendingDropSnapshot = ""
		local pendingDropCount = 0
		local dropRevision = 0
		if dropRuntime ~= nil then
			pendingDropSnapshot = dropRuntime.PendingDropSnapshot
			pendingDropCount = dropRuntime.PendingDropCount
			dropRevision = dropRuntime.DropRevision
		end

		local isIdlePlayerTurn = self.ContentValidationState == "VALID" and self.BattleResult == "" and turnState.BattlePhase == "PlayerTurn" and turnState.IsActionProcessing == false
		local queueCount = turnState.QueuedTileCount
		local effectiveCapacity = turnState.TileQueueCapacity
		local queuedItems = {}
		local queueIndex = 0
		for skillId in string.gmatch(turnState.QueuedTileIds, "([^|]+)") do
			queueIndex = queueIndex + 1
			table.insert(queuedItems, { Index = queueIndex, SkillId = skillId })
		end
		local enemyIntents = self:ParseEnemyPlanSnapshot(self.EnemyPlanSnapshot)
		local preparedIntent = {
			State = self.PreparedEnemyIntentState,
			EnemyId = self.PreparedEnemyId,
			PatternId = self.PreparedEnemyPatternId,
			StepIndex = self.PreparedEnemyStepIndex,
			ActionType = self.PreparedEnemyActionType,
			TileId = self.PreparedEnemyTileId,
			TelegraphTurnsRemaining = self.PreparedEnemyTelegraphTurnsRemaining,
			Direction = self.PreparedEnemyDirection,
			PreparedTurn = self.PreparedEnemyTurn,
			Reason = self.PreparedEnemyReason,
			Revision = 0
		}
		if intentState ~= nil then
			preparedIntent.State = intentState.IntentState
			preparedIntent.EnemyId = intentState.EnemyId
			preparedIntent.PatternId = intentState.PatternId
			preparedIntent.StepIndex = intentState.StepIndex
			preparedIntent.ActionType = intentState.ActionType
			preparedIntent.TileId = intentState.TileId
			preparedIntent.TelegraphTurnsRemaining = intentState.TelegraphTurnsRemaining
			preparedIntent.Direction = intentState.Direction
			preparedIntent.PreparedTurn = intentState.PreparedTurn
			preparedIntent.Reason = intentState.IntentReason
			preparedIntent.Revision = intentState.IntentRevision
		end
		if #enemyIntents == 0 and preparedIntent.State ~= "EMPTY" and preparedIntent.EnemyId ~= "" then
			table.insert(enemyIntents, {
				UnitId = preparedIntent.EnemyId,
				State = preparedIntent.State,
				PatternId = preparedIntent.PatternId,
				StepIndex = preparedIntent.StepIndex,
				CommandType = preparedIntent.ActionType,
				TileId = preparedIntent.TileId,
				TelegraphTurnsRemaining = preparedIntent.TelegraphTurnsRemaining,
				Direction = preparedIntent.Direction,
				PreparedTurn = preparedIntent.PreparedTurn,
				Reason = preparedIntent.Reason,
				Revision = preparedIntent.Revision,
				QueuedTileIds = preparedIntent.TileId
			})
		end

		return {
			Success = true,
			Reason = "OK",
			RevisionKey = tostring(turnState.StateRevision) .. ":" .. tostring(turnState.QueueCapacityRevision) .. ":" .. tostring(turnState.CommandResultRevision) .. ":" .. tostring(cooldownRevision) .. ":" .. tostring(runInventoryRevision) .. ":" .. tostring(runAugmentRevision) .. ":" .. tostring(self.AugmentRuntimeRevision) .. ":" .. tostring(dropRevision) .. ":" .. tostring(self.SelectedJobRevision) .. ":" .. tostring(self.JobMechanicRevision) .. ":" .. tostring(self.SkillTargetRevision) .. ":" .. tostring(self.ContentValidationRevision) .. ":" .. tostring(waveState.CurrentWave) .. ":" .. tostring(self.EnemyPlanRevision) .. ":" .. tostring(preparedIntent.Revision) .. ":" .. preparedIntent.State .. ":" .. preparedIntent.EnemyId .. ":" .. preparedIntent.ActionType .. ":" .. preparedIntent.TileId .. ":" .. self.BattleResult,
			Phase = turnState.BattlePhase,
			TurnNumber = turnState.TurnNumber,
			IsProcessing = turnState.IsActionProcessing,
			BattleResult = self.BattleResult,
			Stage = {
				StageId = self.StageId,
				RegionId = self.RegionId,
				StageIndex = self.StageIndex,
				StageType = self.StageType,
				DisplayName = self.StageDisplayName,
				SchemaVersion = self.StageSchemaVersion
			},
			Commands = {
				CanMove = isIdlePlayerTurn,
				CanTurn = isIdlePlayerTurn,
				CanQueue = isIdlePlayerTurn and queueCount < effectiveCapacity,
				CanExecute = isIdlePlayerTurn and queueCount > 0,
				CanClear = isIdlePlayerTurn and queueCount > 0,
				CanRemove = isIdlePlayerTurn and queueCount > 0,
				CanReorder = isIdlePlayerTurn and queueCount > 1
			},
			LastCommand = {
				Type = turnState.LastCommandType,
				Success = turnState.LastCommandSuccess,
				Reason = turnState.LastCommandReason,
				Revision = turnState.CommandResultRevision
			},
			LastSkillTarget = {
				SkillId = self.LastSkillTargetSkillId,
				TargetingType = self.LastSkillTargetingType,
				TargetUnitIds = self.LastSkillTargetUnitIds,
				TargetCellIndices = self.LastSkillTargetCellIndices,
				Reason = self.LastSkillTargetReason,
				Revision = self.SkillTargetRevision
			},
			ContentValidation = {
				State = self.ContentValidationState,
				IsReady = self.ContentValidationState == "VALID",
				Reason = self.ContentValidationReason,
				ErrorCount = self.ContentValidationErrorCount,
				ErrorSnapshot = self.ContentValidationErrorSnapshot,
				Revision = self.ContentValidationRevision
			},
			Job = {
				JobId = self.SelectedJobId,
				MechanicId = self.SelectedJobMechanicId,
				PassiveSetId = self.SelectedJobPassiveSetId,
				StartingSkillIds = self.SelectedJobStartingSkillIds,
				BaseMaxHp = self.SelectedJobBaseMaxHp,
				BaseQueueCapacity = self.SelectedJobBaseQueueCapacity,
				Revision = self.SelectedJobRevision
			},
			JobMechanic = {
				LastMechanicId = self.LastJobMechanicId,
				LastSuccess = self.LastJobMechanicSuccess,
				LastReason = self.LastJobMechanicReason,
				Revision = self.JobMechanicRevision
			},
			RunAugments = {
				OwnedSnapshot = ownedAugmentSnapshot,
				LastTriggerType = self.LastAugmentTriggerType,
				LastTriggerReason = self.LastAugmentTriggerReason,
				LastExecutedCount = self.LastAugmentExecutedCount,
				RuntimeRevision = self.AugmentRuntimeRevision,
				Revision = runAugmentRevision
			},
			PlayerQueue = {
				BaseCapacity = turnState.BaseQueueCapacity,
				BonusCapacity = turnState.QueueCapacityBonus,
				EffectiveCapacity = effectiveCapacity,
				MinCapacity = turnState.QueueCapacityMin,
				MaxCapacity = turnState.QueueCapacityMax,
				Count = queueCount,
				RemainingSlots = math.max(0, effectiveCapacity - queueCount),
				IsFull = queueCount >= effectiveCapacity,
				IsOverCapacity = queueCount > effectiveCapacity,
				QueuedTileIds = turnState.QueuedTileIds,
				Items = queuedItems,
				ExecutingTileIds = turnState.ExecutingTileIds,
				ExecutingIndex = turnState.ExecutingTileIndex,
				ModifierSnapshot = turnState.QueueCapacityModifierSnapshot,
				Revision = turnState.QueueCapacityRevision
			},
			EnemyIntentMode = "PER_ENEMY_RANGE_AWARE_QUEUE_V2",
			EnemyPlanRevision = self.EnemyPlanRevision,
			EnemyPlanCount = self.EnemyPlanCount,
			EnemyIntents = enemyIntents,
			CooldownSnapshot = cooldownSnapshot,
			CooldownRevision = cooldownRevision,
			RunInventory = {
				CurrencySnapshot = runCurrencySnapshot,
				ConsumableSnapshot = runConsumableSnapshot,
				SkillSnapshot = runSkillSnapshot,
				ConsumableCapacity = runConsumableCapacity,
				SkillRevision = runSkillInventoryRevision,
				Revision = runInventoryRevision
			},
			Drops = {
				PendingSnapshot = pendingDropSnapshot,
				PendingCount = pendingDropCount,
				Revision = dropRevision
			},
			Wave = {
				Current = waveState.CurrentWave,
				Total = waveState.TotalWaves,
				State = waveState.WaveState,
				ForceSpawnPending = waveState.ForceSpawnPending,
				ForceSpawnPendingReason = waveState.ForceSpawnPendingReason
			}
		}
	end

	@ExecSpace("Server")
	method void RequestUseConsumable(string consumableId, integer requestId)
		-- Authenticates a client request before entering the server-only consumable workflow.
		if isvalid(self.PlayerEntity) == false or self.PlayerEntity.PlayerComponent == nil then
			log_warning("[BattleConsumable] rejected reason=PLAYER_MISSING")
			return
		end
		if self.PlayerEntity.PlayerComponent.UserId ~= senderUserId then
			log_warning("[BattleConsumable] rejected reason=INVALID_SENDER")
			return
		end
		local result = self:TryUseRunConsumable(self.PlayerEntity, consumableId, requestId)
		log("[BattleConsumable] request id=" .. tostring(requestId) .. " ref=" .. consumableId .. " success=" .. tostring(result.Success) .. " reason=" .. result.Reason)
	end

	@ExecSpace("ServerOnly")
	method table TryUseRunConsumable(Entity playerEntity, string consumableId, integer requestId)
		-- Validates timing and inventory, executes the registered effect, then commits consumption exactly once.
		local result = { Success = false, Reason = "UNKNOWN", ConsumableId = consumableId or "", AppliedAmount = 0, ConsumedAmount = 0, ConsumesTurn = false }
		if isvalid(playerEntity) == false or playerEntity ~= self.PlayerEntity then
			result.Reason = "INVALID_PLAYER"
			return result
		end
		if requestId <= 0 then
			result.Reason = "INVALID_REQUEST_ID"
			return result
		end
		if self.BattleResult ~= "" or self.TurnState == nil or self.TurnState.BattlePhase ~= "PlayerTurn" or self.TurnState.IsActionProcessing == true then
			result.Reason = "INVALID_CONSUMABLE_TIMING"
			return result
		end

		local definition = _ConsumableDefinitionRepositoryLogic:GetDefinition(consumableId)
		if definition.Success == false then
			result.Reason = definition.Reason
			result.DetailReason = definition.DetailReason or ""
			return result
		end
		if definition.TargetType ~= "SELF" then
			result.Reason = "UNSUPPORTED_CONSUMABLE_TARGET"
			return result
		end

		local runState = _RunManagerLogic:GetOrCreateRunState(playerEntity)
		if runState == nil then
			result.Reason = "RUN_STATE_UNAVAILABLE"
			return result
		end
		local useKey = tostring(runState.RunSequence) .. ":" .. self.StageId .. ":consumable:" .. tostring(requestId)
		local availability = _RunManagerLogic:CanUseRunConsumable(playerEntity, consumableId, useKey)
		if availability.Success == false then
			result.Reason = availability.Reason
			return result
		end
		if availability.AlreadyApplied == true then
			result.Success = true
			result.Reason = "DUPLICATE_USE_IGNORED"
			return result
		end

		local targetEntity = self:FindUnitEntity("player_01")
		if isvalid(targetEntity) == false then
			result.Reason = "TARGET_NOT_FOUND"
			return result
		end
		local targetUnit = targetEntity:GetComponent("script.BattleUnitComponent")
		local effectResult = _ConsumableEffectRouterLogic:Execute(definition, targetUnit)
		if effectResult.Success == false then
			result.Reason = effectResult.Reason
			return result
		end

		local consumeResult = _RunManagerLogic:ConsumeRunConsumable(playerEntity, consumableId, useKey)
		if consumeResult.Success == false then
			log_error("[BattleConsumable] commit failed after effect key=" .. useKey .. " reason=" .. consumeResult.Reason)
			result.Reason = "CONSUMABLE_COMMIT_FAILED"
			return result
		end
		result.Success = true
		result.Reason = "CONSUMABLE_USED"
		result.AppliedAmount = effectResult.AppliedAmount or 0
		result.HpBefore = effectResult.HpBefore or -1
		result.HpAfter = effectResult.HpAfter or -1
		result.ConsumedAmount = consumeResult.ConsumedAmount or 0
		result.ConsumesTurn = definition.ConsumesTurn == true
		log("[BattleConsumable] used ref=" .. consumableId .. " effect=" .. definition.EffectType .. " applied=" .. result.AppliedAmount .. " hp=" .. result.HpBefore .. "->" .. result.HpAfter .. " consumesTurn=" .. tostring(result.ConsumesTurn) .. " key=" .. useKey)
		if result.ConsumesTurn == true and self.BattleResult == "" then
			self:BeginEnemyTurn()
		end
		return result
	end

	@ExecSpace("ServerOnly")
	method table GetBattleSnapshot()
		-- Stable read model for server-side lobby, waiting, result, and flow controllers.
		local turnState = self:EnsureTurnStateComponent()
		local waveRuntime = self:EnsureWaveStateComponent()
		local dropRuntime = self:EnsureDropStateComponent()
		local ownedSkillSnapshot = ""
		local skillInventoryRevision = 0
		local ownedAugmentSnapshot = ""
		local augmentRevision = 0
		if isvalid(self.PlayerEntity) then
			local inventory = self.PlayerEntity:GetComponent("script.PlayerRunInventoryComponent")
			if inventory ~= nil then
				ownedSkillSnapshot = inventory.RunSkillSnapshot
				skillInventoryRevision = inventory.SkillInventoryRevision
			end
			local augmentState = self.PlayerEntity:GetComponent("script.PlayerRunAugmentComponent")
			if augmentState ~= nil then
				ownedAugmentSnapshot = augmentState.OwnedAugmentSnapshot
				augmentRevision = augmentState.AugmentRevision
			end
		end
		return {
			Success = true,
			Reason = "OK",
			EntryRequestId = self.EntryRequestId,
			EntryMode = self.EntryMode,
			StageId = self.StageId,
			RegionId = self.RegionId,
			StageIndex = self.StageIndex,
			StageType = self.StageType,
			StageDisplayName = self.StageDisplayName,
			WaveTableId = self.WaveTableId,
			StageRuleId = self.StageRuleId,
			StageSchemaVersion = self.StageSchemaVersion,
			StageNumber = self.StageNumber,
			RunSeed = self.RunSeed,
			CharacterId = self.SelectedCharacterId,
			JobId = self.SelectedJobId,
			JobMechanicId = self.SelectedJobMechanicId,
			JobPassiveSetId = self.SelectedJobPassiveSetId,
			JobStartingSkillIds = self.SelectedJobStartingSkillIds,
			JobBaseMaxHp = self.SelectedJobBaseMaxHp,
			JobBaseQueueCapacity = self.SelectedJobBaseQueueCapacity,
			JobRevision = self.SelectedJobRevision,
			OwnedSkillSnapshot = ownedSkillSnapshot,
			SkillInventoryRevision = skillInventoryRevision,
			OwnedAugmentSnapshot = ownedAugmentSnapshot,
			AugmentRevision = augmentRevision,
			LastAugmentTriggerType = self.LastAugmentTriggerType,
			LastAugmentTriggerReason = self.LastAugmentTriggerReason,
			LastAugmentExecutedCount = self.LastAugmentExecutedCount,
			LoadoutId = self.SelectedLoadoutId,
			BattlePhase = turnState.BattlePhase,
			BattleResult = self.BattleResult,
			TurnNumber = turnState.TurnNumber,
			CurrentWave = waveRuntime.CurrentWave,
			TotalWaves = waveRuntime.TotalWaves,
			CellCount = self.CellCount,
			PlayerStartCell = self.PlayerStartCell,
			QueueCapacity = turnState.TileQueueCapacity,
			PendingDropSnapshot = dropRuntime.PendingDropSnapshot,
			PendingDropCount = dropRuntime.PendingDropCount,
			DropRevision = dropRuntime.DropRevision
		}
	end

	@ExecSpace("ServerOnly")
	method table RebuildBattleState(string reason)
		-- Clears transient battle state, then rebuilds the selected Stage through the normal spawn path.
		local result = {
			Success = false,
			Reason = "UNKNOWN"
		}
		local contentValidation = self:RunContentValidationGate("REBUILD_" .. reason)
		if contentValidation.Success == false then
			result.Reason = "CONTENT_VALIDATION_BLOCKED"
			result.DetailReason = contentValidation.Reason
			result.ErrorCount = contentValidation.ErrorCount
			result.ErrorSnapshot = contentValidation.ErrorSnapshot
			return result
		end

		if self.ActionTimerId > 0 then
			_TimerService:ClearTimer(self.ActionTimerId)
			self.ActionTimerId = 0
		end
		self:ClearSkillImpactTimers()
		self.WaveRuntime:ClearAllTimers(reason)

		local queuedBeforeReset = self.TurnState.QueuedTileIds
		self.BattleResult = ""
		self.PlayerExitObservedAfterBattle = false
		self.StageTurnNumber = 0
		self.TurnState:ResetTurnState(self.TileQueueCapacity, reason)
		self:PublishTurnStateSnapshot(reason)
		log("[BattleQueueBoundary] boundary=" .. reason .. " policy=CLEAR before=" .. queuedBeforeReset .. " after=" .. self.TurnState.QueuedTileIds)
		self.LastEnemySpawnOrder = 0
		self:ClearPreparedEnemyIntent(reason)

		local playerEntity = self:FindUnitEntity("player_01")
		if isvalid(playerEntity) == false then
			result.Reason = "PLAYER_MISSING"
			return result
		end
		self:CleanupRegisteredEnemies(reason)
		self.PlayerEntity = playerEntity
		self:ConfigureUnit(playerEntity, "player_01", "Player", self.PlayerStartCell, "Right", 100, 1)
		self:StartStageById(self.StageId)

		result.Success = true
		result.Reason = reason
		log("[BattleReset] completed reason=" .. reason .. " seed=" .. self.RunSeed .. " stage=" .. self.StageNumber .. " wave=" .. self.CurrentWave .. "/" .. self.TotalWaves .. " playerCell=" .. self.PlayerStartCell .. " enemyHp=" .. self.CurrentEnemyMaxHp)
		return result
	end

	@ExecSpace("ServerOnly")
	method table ResolvePushImpact(string sourceUnitId)
		-- Re-resolves the front target and moves it one logical cell away from the source.
		local result = {
			Success = false,
			Hit = false,
			Reason = "UNKNOWN",
			SourceUnitId = sourceUnitId,
			TargetUnitId = "",
			TargetCell = -1,
			FromCell = -1,
			ToCell = -1
		}

		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		if isvalid(sourceEntity) == false then
			result.Reason = "SOURCE_NOT_FOUND"
			return result
		end
		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit == nil then
			result.Reason = "SOURCE_COMPONENT_MISSING"
			return result
		end
		if self:IsTeamTurn(sourceUnit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end
		if sourceUnit.IsDead == true then
			result.Reason = "SOURCE_DEAD"
			return result
		end

		local direction = -1
		if sourceUnit.Facing == "Right" then
			direction = 1
		end
		result.TargetCell = sourceUnit.CellIndex + direction
		local targetEntity = self:ResolveFrontTarget(sourceUnitId)
		if isvalid(targetEntity) == false then
			result.Success = true
			result.Reason = self:IsValidCell(result.TargetCell) and "MISS_EMPTY" or "MISS_OUT_OF_BOUNDS"
			log("[BattlePush] resolved source=" .. sourceUnitId .. " target= cell=" .. result.TargetCell .. " reason=" .. result.Reason)
			return result
		end

		local targetUnit = targetEntity:GetComponent("script.BattleUnitComponent")
		result.Hit = true
		result.TargetUnitId = targetUnit.UnitId
		result.FromCell = targetUnit.CellIndex
		result.ToCell = targetUnit.CellIndex + direction
		if targetUnit.Team == "Enemy" and _EnemyTraitRouterLogic:BlocksForcedDisplacement(targetUnit.EnemyTraitIds) then
			result.Success = true
			result.ToCell = result.FromCell
			result.Reason = "PUSH_BLOCKED_HEAVY_TRAIT"
			log("[EnemyTrait] HEAVY blocked push target=" .. result.TargetUnitId .. " cell=" .. result.FromCell)
			return result
		end
		if self:IsValidCell(result.ToCell) == false then
			result.Success = true
			result.Reason = "PUSH_BLOCKED_OUT_OF_BOUNDS"
			log("[BattlePush] resolved source=" .. sourceUnitId .. " target=" .. result.TargetUnitId .. " from=" .. result.FromCell .. " to=" .. result.ToCell .. " reason=" .. result.Reason)
			return result
		end
		if self:IsCellOccupied(result.ToCell, targetUnit.UnitId) then
			result.Success = true
			result.Reason = "PUSH_BLOCKED_OCCUPIED"
			log("[BattlePush] resolved source=" .. sourceUnitId .. " target=" .. result.TargetUnitId .. " from=" .. result.FromCell .. " to=" .. result.ToCell .. " reason=" .. result.Reason)
			return result
		end

		local cellChange = targetUnit:ApplyCellChange(result.ToCell)
		if cellChange.Success == false then
			result.Success = false
			result.Reason = cellChange.Reason
			return result
		end
		self:PlaceEntity(targetEntity, self:GetCellPosition(result.ToCell))
		local movedEvent = UnitMovedEvent()
		movedEvent.UnitId = targetUnit.UnitId
		movedEvent.FromCell = result.FromCell
		movedEvent.ToCell = result.ToCell
		self.Entity:SendEvent(movedEvent)

		result.Success = true
		result.Reason = "PUSHED"
		log("[BattlePush] resolved source=" .. sourceUnitId .. " target=" .. result.TargetUnitId .. " from=" .. result.FromCell .. " to=" .. result.ToCell .. " reason=" .. result.Reason)
		return result
	end

	@ExecSpace("ServerOnly")
	method table ResolvePushImpactOnTarget(string sourceUnitId, string targetUnitId)
		-- Applies the existing one-cell push rule to a target already selected by SkillTargetResolverLogic.
		local result = { Success = false, Hit = false, Reason = "UNKNOWN", SourceUnitId = sourceUnitId, TargetUnitId = targetUnitId, TargetCell = -1, FromCell = -1, ToCell = -1 }
		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		local targetEntity = self:FindUnitEntity(targetUnitId)
		if isvalid(sourceEntity) == false then
			result.Reason = "SOURCE_NOT_FOUND"
			return result
		end
		if isvalid(targetEntity) == false then
			result.Reason = "TARGET_NOT_FOUND"
			return result
		end
		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		local targetUnit = targetEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit == nil or targetUnit == nil then
			result.Reason = "UNIT_COMPONENT_MISSING"
			return result
		end
		if self:IsTeamTurn(sourceUnit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end
		if sourceUnit.IsDead == true or targetUnit.IsDead == true then
			result.Reason = "UNIT_DEAD"
			return result
		end
		if sourceUnit.Team == targetUnit.Team then
			result.Reason = "TARGET_SAME_TEAM"
			return result
		end

		local direction = sourceUnit.Facing == "Right" and 1 or -1
		result.Hit = true
		result.TargetCell = targetUnit.CellIndex
		result.FromCell = targetUnit.CellIndex
		result.ToCell = targetUnit.CellIndex + direction
		-- The impact lands even when displacement is later blocked, so present the hit before those branches.
		self:PlayActiveHitEffect(targetUnitId)
		if targetUnit.Team == "Enemy" and _EnemyTraitRouterLogic:BlocksForcedDisplacement(targetUnit.EnemyTraitIds) then
			result.Success = true
			result.ToCell = result.FromCell
			result.Reason = "PUSH_BLOCKED_HEAVY_TRAIT"
			log("[EnemyTrait] HEAVY blocked push target=" .. targetUnitId .. " cell=" .. result.FromCell)
			return result
		end
		if self:IsValidCell(result.ToCell) == false then
			result.Success = true
			result.Reason = "PUSH_BLOCKED_OUT_OF_BOUNDS"
			return result
		end
		if self:IsCellOccupied(result.ToCell, targetUnitId) then
			result.Success = true
			result.Reason = "PUSH_BLOCKED_OCCUPIED"
			return result
		end

		local cellChange = targetUnit:ApplyCellChange(result.ToCell)
		if cellChange.Success == false then
			result.Reason = cellChange.Reason
			return result
		end
		self:PlaceEntity(targetEntity, self:GetCellPosition(result.ToCell))
		local movedEvent = UnitMovedEvent()
		movedEvent.UnitId = targetUnit.UnitId
		movedEvent.FromCell = result.FromCell
		movedEvent.ToCell = result.ToCell
		self.Entity:SendEvent(movedEvent)
		result.Success = true
		result.Reason = "PUSHED"
		log("[BattlePushTarget] resolved source=" .. sourceUnitId .. " target=" .. targetUnitId .. " from=" .. result.FromCell .. " to=" .. result.ToCell .. " reason=" .. result.Reason)
		return result
	end

	@ExecSpace("ServerOnly")
	method table TryExecuteSkill(string sourceUnitId, string skillId)
		local validation = _ContentValidatorLogic:ValidateSkillById(skillId)
		if validation.Success == false then
			return {
				Success = false,
				Reason = validation.Reason,
				DetailReason = validation.DetailReason or "",
				SourceUnitId = sourceUnitId,
				SkillId = skillId
			}
		end

		local bundle = validation.Data
		local definition = bundle.Definition
		local effectSteps = bundle.EffectSteps
		local contextResult = _SkillExecutionLogic:BuildContext(self, sourceUnitId, skillId, definition)
		if contextResult.Success == false then
			return contextResult
		end

		local runtimeState = self:GetSkillRuntimeState(sourceUnitId)
		if runtimeState == nil then
			return {
				Success = false,
				Reason = "SKILL_RUNTIME_STATE_MISSING",
				SourceUnitId = sourceUnitId,
				SkillId = skillId
			}
		end
		local cooldownResult = runtimeState:CanUseSkill(skillId)
		if cooldownResult.Success == false then
			return {
				Success = false,
				Reason = cooldownResult.Reason,
				RemainingTurns = cooldownResult.RemainingTurns,
				SourceUnitId = sourceUnitId,
				SkillId = skillId
			}
		end
		runtimeState:StartCooldown(skillId, definition.CooldownTurns)

		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		-- Swap the avatar weapon before the motion starts so the swing shows the skill's own weapon.
		self:ApplySkillWeapon(sourceUnitId, sourceEntity, definition)
		local motionProfile = self:GetSkillMotionProfile(definition.MotionProfileId)
		local sourcePresentation = sourceEntity:GetComponent("script.BattleUnitPresentationComponent")
		if sourcePresentation ~= nil then
			if sourceEntity.PlayerControllerComponent ~= nil then
				sourcePresentation:PlayCombatMotion(
					sourceUnitId,
					motionProfile.MotionKey,
					motionProfile.ActionName,
					motionProfile.PlayRate,
					motionProfile.Duration
				)
			else
				local speed = self:GetSkillSpeedMultiplier()
				sourcePresentation:PlaySpriteMotion(
					sourceUnitId,
					definition.CasterMotionRuid or "",
					(definition.CasterMotionPlayRate or 1) * speed,
					(definition.CasterMotionDuration or definition.ActionDuration or 0.1) / speed
				)
			end
		end
		self:BeginSkillEffectPresentation(sourceUnitId, definition)

		local context = contextResult.Data
		local safeImpactDelay = math.max(0, motionProfile.ImpactDelay)
		local resolveEffects = function()
			self.ImpactTimerId = 0
			local effectResult = _SkillExecutionLogic:ExecuteEffectSteps(context, effectSteps)
			if effectResult.Success == false then
				log_warning("[SkillExecution] failed skill=" .. skillId .. " source=" .. sourceUnitId .. " reason=" .. effectResult.Reason)
			end
		end

		self:ClearSkillImpactTimers()
		-- A projectile skill splits the impact in two: the shot leaves at its launch delay, and the
		-- effects resolve only once it has crossed the board to the target cell.
		local launchDelay = safeImpactDelay
		local flightSeconds = 0
		local totalImpactDelay = safeImpactDelay
		if self:HasSkillProjectile(definition) then
			launchDelay = self:GetProjectileLaunchDelay(definition)
			flightSeconds = self:LaunchSkillProjectile(sourceUnitId, definition, launchDelay)
			if flightSeconds > 0 then
				totalImpactDelay = launchDelay + flightSeconds
			end
		end
		if totalImpactDelay <= 0 then
			return _SkillExecutionLogic:ExecuteEffectSteps(context, effectSteps)
		end

		self.ImpactTimerId = _TimerService:SetTimerOnce(resolveEffects, totalImpactDelay)
		log("[SkillExecution] scheduled skill=" .. skillId .. " source=" .. sourceUnitId .. " steps=" .. #effectSteps .. " delay=" .. launchDelay .. " flight=" .. flightSeconds)
		return {
			Success = true,
			Reason = "IMPACT_PENDING",
			SourceUnitId = sourceUnitId,
			SkillId = skillId,
			StepCount = #effectSteps
		}
	end

	@ExecSpace("ServerOnly")
	method void ApplySkillWeapon(string sourceUnitId, Entity sourceEntity, table definition)
		-- Presentation-only hop into the weapon catalog. Never gates execution: a data or costume
		-- problem downgrades to a log line and the skill still resolves.
		if isvalid(sourceEntity) == false then
			return
		end
		local weaponResult = _SkillWeaponEquipLogic:ApplyWeaponForSkill(sourceEntity, definition)
		if weaponResult.Success == false then
			log_warning("[SkillWeapon] skill=" .. (definition.SkillId or "") .. " unit=" .. sourceUnitId .. " reason=" .. weaponResult.Reason)
		end
	end

	@ExecSpace("ServerOnly")
	method void ClearSkillImpactTimers()
		-- One battle action resolves at a time, so a new cast always supersedes any pending impact.
		if self.ImpactTimerId > 0 then
			_TimerService:ClearTimer(self.ImpactTimerId)
			self.ImpactTimerId = 0
		end
		if self.ProjectileTimerId > 0 then
			_TimerService:ClearTimer(self.ProjectileTimerId)
			self.ProjectileTimerId = 0
		end
	end

	method number GetProjectileLaunchDelay(table definition)
		-- The shot leaves with the cast effect by default, so a ranged skill reads as "fire on cast"
		-- rather than waiting for a melee swing's impact frame. ProjectileLaunchDelay only holds it
		-- back, and is scaled like every other duration so it tracks the battle speed multiplier.
		if definition == nil then
			return 0
		end
		local authored = definition.ProjectileLaunchDelay or 0
		if authored <= 0 then
			return 0
		end
		return authored / self:GetSkillSpeedMultiplier()
	end

	method boolean HasSkillProjectile(table definition)
		-- Both columns are required together; the Validator rejects a RUID with no speed, and this
		-- guard keeps a half-authored row from stalling the impact instead of just skipping the visual.
		if definition == nil then
			return false
		end
		local ruid = definition.ProjectileRuid or ""
		local speed = definition.ProjectileSpeed or 0
		return ruid ~= "" and speed > 0
	end

	@ExecSpace("ServerOnly")
	method number GetProjectileAimCell(string sourceUnitId, table definition)
		-- The Target Resolver owns every targeting rule, so the aim point is read from its cell list
		-- rather than re-derived here. Its last entry is the farthest cell the skill reaches: the
		-- blocking enemy for FIRST_ENEMY_FORWARD, the outermost offset for RANGE_OFFSETS.
		local resolved = _SkillTargetResolverLogic:Resolve(self, sourceUnitId, definition)
		if resolved.Success == false then
			return -1
		end
		local cells = resolved.TargetCellIndices
		if cells == nil or #cells == 0 then
			return -1
		end
		return cells[#cells]
	end

	@ExecSpace("ServerOnly")
	method number LaunchSkillProjectile(string sourceUnitId, table definition, number launchDelay)
		-- Schedules the shot for the motion's release frame and returns how long it will be in flight,
		-- so the caller can delay the impact by exactly that much. Returns 0 for every non-projectile
		-- skill, which leaves the original single-timer impact path untouched.
		if self:HasSkillProjectile(definition) == false then
			return 0
		end

		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		if isvalid(sourceEntity) == false then
			log_warning("[SkillProjectile] skipped skill=" .. (definition.SkillId or "") .. " reason=SOURCE_NOT_FOUND")
			return 0
		end
		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit == nil then
			log_warning("[SkillProjectile] skipped skill=" .. (definition.SkillId or "") .. " reason=SOURCE_COMPONENT_MISSING")
			return 0
		end

		local aimCell = self:GetProjectileAimCell(sourceUnitId, definition)
		if aimCell < 0 then
			log_warning("[SkillProjectile] skipped skill=" .. (definition.SkillId or "") .. " reason=NO_AIM_CELL")
			return 0
		end

		local startPosition = self:GetCellPosition(sourceUnit.CellIndex)
		local targetPosition = self:GetCellPosition(aimCell)
		local speed = definition.ProjectileSpeed * self:GetSkillSpeedMultiplier()
		local distance = math.abs(targetPosition.x - startPosition.x)
		if distance <= 0 or speed <= 0 then
			return 0
		end

		local skillId = definition.SkillId or ""
		local projectileRuid = definition.ProjectileRuid
		local projectileScale = definition.ProjectileScale or 1
		local projectileArcHeight = definition.ProjectileArcHeight or 0
		local flipX = sourceUnit.Facing == "Right"
		self.ProjectileSpawnCount = self.ProjectileSpawnCount + 1
		local projectileName = "SkillProjectile_" .. tostring(self.ProjectileSpawnCount)

		local spawnProjectile = function()
			self.ProjectileTimerId = 0
			self:SpawnSkillProjectile(skillId, projectileName, startPosition, targetPosition, speed, projectileRuid, projectileScale, flipX, projectileArcHeight)
		end
		if launchDelay <= 0 then
			spawnProjectile()
		else
			self.ProjectileTimerId = _TimerService:SetTimerOnce(spawnProjectile, launchDelay)
		end

		local flightSeconds = distance / speed
		log("[SkillProjectile] scheduled skill=" .. skillId .. " source=" .. sourceUnitId .. " fromCell=" .. sourceUnit.CellIndex .. " aimCell=" .. aimCell .. " distance=" .. distance .. " speed=" .. speed .. " flight=" .. flightSeconds .. " launchDelay=" .. launchDelay)
		return flightSeconds
	end

	@ExecSpace("ServerOnly")
	method void SpawnSkillProjectile(string skillId, string projectileName, Vector2 startPosition, Vector2 targetPosition, number speed, string projectileRuid, number projectileScale, boolean flipX, number projectileArcHeight)
		-- The model stays native-only and the mover is attached here, so a missing .codeblock can never
		-- silently drop the component out of the spawned entity.
		local mapEntity = self.Entity.CurrentMap
		if mapEntity == nil then
			log_warning("[SkillProjectile] spawn failed skill=" .. skillId .. " reason=MAP_MISSING")
			return
		end

		local projectile = _SpawnService:SpawnByModelId(
			self.ProjectileModelId,
			projectileName,
			Vector3(startPosition.x, startPosition.y, 0),
			mapEntity
		)
		if isvalid(projectile) == false then
			log_warning("[SkillProjectile] spawn failed skill=" .. skillId .. " model=" .. self.ProjectileModelId .. " reason=SPAWN_RETURNED_NIL")
			return
		end

		local mover = projectile:AddComponent("SkillProjectileComponent")
		if mover == nil then
			log_warning("[SkillProjectile] spawn failed skill=" .. skillId .. " reason=COMPONENT_ATTACH_FAILED")
			projectile:Destroy()
			return
		end
		mover:Launch(startPosition, targetPosition, speed, projectileRuid, projectileScale, flipX, self.ProjectileOrderInLayer, projectileArcHeight)
	end

	@ExecSpace("ServerOnly")
	method void BeginSkillEffectPresentation(string sourceUnitId, table definition)
		-- Plays the caster-side effect and latches the target-side effect for this action's impact frame.
		-- Battle actions resolve strictly one at a time, so a single latched slot is enough.
		self.ActiveEffectSkillId = definition.SkillId or ""
		self.ActiveHitEffectRuid = definition.HitEffectRuid or ""
		self.ActiveEffectScale = definition.EffectScale or 1
		self.ActiveEffectFlipX = false

		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		if isvalid(sourceEntity) == false then
			return
		end
		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit ~= nil then
			self.ActiveEffectFlipX = sourceUnit.Facing == "Right"
		end

		local castEffectRuid = definition.CastEffectRuid or ""
		if castEffectRuid == "" then
			return
		end
		local sourcePresentation = sourceEntity:GetComponent("script.BattleUnitPresentationComponent")
		if sourcePresentation == nil then
			log_warning("[BattleEffect] cast skipped unit=" .. sourceUnitId .. " skill=" .. self.ActiveEffectSkillId .. " reason=PRESENTATION_MISSING")
			return
		end
		sourcePresentation:PlaySkillEffect(sourceUnitId, "CAST", castEffectRuid, self.ActiveEffectScale, self.ActiveEffectFlipX, self:GetSkillSpeedMultiplier())
	end

	@ExecSpace("ServerOnly")
	method void PlayActiveHitEffect(string targetUnitId)
		-- Presents the latched hit effect on one target at its impact frame; never gates gameplay resolution.
		if self.ActiveHitEffectRuid == "" then
			return
		end
		local targetEntity = self:FindUnitEntity(targetUnitId)
		if isvalid(targetEntity) == false then
			return
		end
		local targetPresentation = targetEntity:GetComponent("script.BattleUnitPresentationComponent")
		if targetPresentation == nil then
			log_warning("[BattleEffect] hit skipped unit=" .. targetUnitId .. " skill=" .. self.ActiveEffectSkillId .. " reason=PRESENTATION_MISSING")
			return
		end
		targetPresentation:PlaySkillEffect(targetUnitId, "HIT", self.ActiveHitEffectRuid, self.ActiveEffectScale, self.ActiveEffectFlipX, self:GetSkillSpeedMultiplier())
	end

	@ExecSpace("ServerOnly")
	method number GetSkillSpeedMultiplier()
		-- Guarded so a mistyped inspector value can never stall or invert skill playback.
		return math.max(0.1, self.SkillSpeedMultiplier)
	end

	@ExecSpace("ServerOnly")
	method table GetSkillMotionProfile(string motionProfileId)
		-- Authored values describe the skill at 1x; the speed multiplier scales them on the way out,
		-- so the swing, the impact frame, and the effect play rate all move together.
		local speed = self:GetSkillSpeedMultiplier()
		if motionProfileId == "heavy_slash" then
			return {
				MotionKey = self.HeavySlashMotionKey,
				ActionName = self.HeavySlashActionName,
				PlayRate = self.HeavySlashMotionPlayRate * speed,
				Duration = self.HeavySlashMotionDuration / speed,
				ImpactDelay = self.HeavySlashImpactDelay / speed,
				EffectPlayRate = speed
			}
		elseif motionProfileId == "push" then
			return {
				MotionKey = self.PushMotionKey,
				ActionName = self.PushActionName,
				PlayRate = self.PushMotionPlayRate * speed,
				Duration = self.PushMotionDuration / speed,
				ImpactDelay = self.PushImpactDelay / speed,
				EffectPlayRate = speed
			}
		end
		return {
			MotionKey = self.BasicSlashMotionKey,
			ActionName = self.BasicSlashActionName,
			PlayRate = self.BasicSlashMotionPlayRate * speed,
			Duration = self.BasicSlashMotionDuration / speed,
			ImpactDelay = self.BasicSlashImpactDelay / speed,
			EffectPlayRate = speed
		}
	end

	@ExecSpace("ServerOnly")
	method table ResolveFrontAttackImpact(string sourceUnitId, string attackId, number damageAmount)
		-- Re-reads the source cell and facing at impact time, so damage remains board-state based.
		local result = {
			Success = false,
			Hit = false,
			Reason = "UNKNOWN",
			SourceUnitId = sourceUnitId,
			AttackId = attackId,
			TargetUnitId = "",
			TargetCell = -1,
			DamageAmount = 0,
			TargetHpBefore = -1,
			TargetHpAfter = -1
		}

		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		if isvalid(sourceEntity) == false then
			result.Reason = "SOURCE_NOT_FOUND"
			return result
		end

		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit == nil then
			result.Reason = "SOURCE_COMPONENT_MISSING"
			return result
		end
		if self:IsTeamTurn(sourceUnit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end
		if sourceUnit.IsDead == true then
			result.Reason = "SOURCE_DEAD"
			return result
		end

		local facingDirection = -1
		if sourceUnit.Facing == "Right" then
			facingDirection = 1
		end
		result.TargetCell = sourceUnit.CellIndex + facingDirection

		local targetEntity = nil
		if self:IsValidCell(result.TargetCell) then
			targetEntity = self:ResolveFrontTarget(sourceUnitId)
		else
			result.Reason = "MISS_OUT_OF_BOUNDS"
		end

		if isvalid(targetEntity) then
			local targetUnit = targetEntity:GetComponent("script.BattleUnitComponent")
			local damageResult = _EffectRouterLogic:ExecuteEffect(self, "DAMAGE", sourceUnitId, targetUnit.UnitId, damageAmount)
			if damageResult.Success == false then
				result.Reason = "DAMAGE_FAILED_" .. damageResult.Reason
				log_error("[BattleAttack] damage failed source=" .. sourceUnitId .. " target=" .. targetUnit.UnitId .. " reason=" .. damageResult.Reason)
				return result
			end

			result.Hit = true
			result.Reason = "HIT"
			result.TargetUnitId = targetUnit.UnitId
			result.DamageAmount = damageResult.AppliedAmount
			result.TargetHpBefore = damageResult.HpBefore
			result.TargetHpAfter = damageResult.HpAfter
		elseif result.Reason == "UNKNOWN" then
			result.Reason = "MISS_EMPTY"
		end

		local attackEvent = BasicAttackResolvedEvent()
		attackEvent.SourceUnitId = result.SourceUnitId
		attackEvent.AttackId = result.AttackId
		attackEvent.TargetUnitId = result.TargetUnitId
		attackEvent.TargetCell = result.TargetCell
		attackEvent.Hit = result.Hit
		attackEvent.Reason = result.Reason
		attackEvent.DamageAmount = result.DamageAmount
		attackEvent.TargetHpBefore = result.TargetHpBefore
		attackEvent.TargetHpAfter = result.TargetHpAfter
		self.Entity:SendEvent(attackEvent)

		result.Success = true
		log("[BattleAttack] resolved attack=" .. result.AttackId .. " source=" .. result.SourceUnitId .. " facing=" .. sourceUnit.Facing .. " target=" .. result.TargetUnitId .. " cell=" .. result.TargetCell .. " hit=" .. tostring(result.Hit) .. " reason=" .. result.Reason .. " damage=" .. result.DamageAmount .. " hp=" .. result.TargetHpBefore .. "->" .. result.TargetHpAfter)
		return result
	end

	@ExecSpace("ServerOnly")
	method table ResolveSkillHealImpact(string sourceUnitId, string skillId, string targetUnitId, number healAmount)
		-- Restores HP on one impact-time target. Support skills stay castable with no enemy on the board,
		-- so this path never requires a resolved enemy target.
		local result = { Success = false, Hit = false, Reason = "UNKNOWN", SourceUnitId = sourceUnitId, SkillId = skillId, TargetUnitId = targetUnitId, HealAmount = 0, TargetHpBefore = -1, TargetHpAfter = -1 }
		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		local targetEntity = self:FindUnitEntity(targetUnitId)
		if isvalid(sourceEntity) == false then
			result.Reason = "SOURCE_NOT_FOUND"
			return result
		end
		if isvalid(targetEntity) == false then
			result.Reason = "TARGET_NOT_FOUND"
			return result
		end
		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		local targetUnit = targetEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit == nil or targetUnit == nil then
			result.Reason = "UNIT_COMPONENT_MISSING"
			return result
		end
		if self:IsTeamTurn(sourceUnit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end
		if sourceUnit.IsDead == true or targetUnit.IsDead == true then
			result.Reason = "UNIT_DEAD"
			return result
		end
		if sourceUnit.Team ~= targetUnit.Team then
			result.Reason = "TARGET_NOT_ALLY"
			return result
		end

		local healResult = targetUnit:ApplyHealing(healAmount)
		if healResult.Success == false then
			result.Reason = "HEAL_FAILED_" .. healResult.Reason
			return result
		end
		result.Success = true
		result.Hit = true
		result.Reason = "HEALED"
		result.HealAmount = healResult.AppliedAmount
		result.TargetHpBefore = healResult.HpBefore
		result.TargetHpAfter = healResult.HpAfter
		self:PlayActiveHitEffect(targetUnitId)

		local targetPresentation = targetEntity:GetComponent("script.BattleUnitPresentationComponent")
		if targetPresentation ~= nil then
			targetPresentation:RefreshHpDisplay(targetUnitId, targetUnit.Team, targetUnit.CurrentHp, targetUnit.MaxHp)
		end
		log("[BattleHeal] resolved skill=" .. skillId .. " source=" .. sourceUnitId .. " target=" .. targetUnitId .. " amount=" .. result.HealAmount .. " hp=" .. result.TargetHpBefore .. "->" .. result.TargetHpAfter)
		return result
	end

	@ExecSpace("ServerOnly")
	method table ResolveSkillDamageImpact(string sourceUnitId, string skillId, string targetUnitId, integer targetCell, number damageAmount)
		-- Applies damage to an immutable impact-time target selected by the shared skill Target Resolver.
		local result = { Success = false, Hit = false, Reason = "UNKNOWN", SourceUnitId = sourceUnitId, AttackId = skillId, TargetUnitId = targetUnitId, TargetCell = targetCell, DamageAmount = 0, TargetHpBefore = -1, TargetHpAfter = -1 }
		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		local targetEntity = self:FindUnitEntity(targetUnitId)
		if isvalid(sourceEntity) == false then
			result.Reason = "SOURCE_NOT_FOUND"
			return result
		end
		if isvalid(targetEntity) == false then
			result.Reason = "TARGET_NOT_FOUND"
			return result
		end
		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		local targetUnit = targetEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit == nil or targetUnit == nil then
			result.Reason = "UNIT_COMPONENT_MISSING"
			return result
		end
		if self:IsTeamTurn(sourceUnit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end
		if sourceUnit.IsDead == true or targetUnit.IsDead == true then
			result.Reason = "UNIT_DEAD"
			return result
		end
		if sourceUnit.Team == targetUnit.Team then
			result.Reason = "TARGET_SAME_TEAM"
			return result
		end

		local damageResult = _EffectRouterLogic:ExecuteEffect(self, "DAMAGE", sourceUnitId, targetUnitId, damageAmount)
		if damageResult.Success == false then
			result.Reason = "DAMAGE_FAILED_" .. damageResult.Reason
			return result
		end
		result.Success = true
		result.Hit = true
		result.Reason = "HIT"
		result.DamageAmount = damageResult.AppliedAmount
		result.TargetHpBefore = damageResult.HpBefore
		result.TargetHpAfter = damageResult.HpAfter
		self:PlayActiveHitEffect(targetUnitId)

		local attackEvent = BasicAttackResolvedEvent()
		attackEvent.SourceUnitId = sourceUnitId
		attackEvent.AttackId = skillId
		attackEvent.TargetUnitId = targetUnitId
		attackEvent.TargetCell = targetCell
		attackEvent.Hit = true
		attackEvent.Reason = result.Reason
		attackEvent.DamageAmount = result.DamageAmount
		attackEvent.TargetHpBefore = result.TargetHpBefore
		attackEvent.TargetHpAfter = result.TargetHpAfter
		self.Entity:SendEvent(attackEvent)
		log("[BattleSkillDamage] resolved skill=" .. skillId .. " source=" .. sourceUnitId .. " target=" .. targetUnitId .. " cell=" .. targetCell .. " damage=" .. result.DamageAmount .. " hp=" .. result.TargetHpBefore .. "->" .. result.TargetHpAfter)
		return result
	end

	@ExecSpace("ServerOnly")
	method table ApplyDamage(string sourceUnitId, string targetUnitId, number amount)
		-- Owns the single HP mutation path and forwards the first zero-HP transition to death handling.
		local result = {
			Success = false,
			Reason = "UNKNOWN",
			AppliedAmount = 0,
			HpBefore = -1,
			HpAfter = -1
		}

		if amount <= 0 then
			result.Reason = "INVALID_AMOUNT"
			return result
		end

		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		local targetEntity = self:FindUnitEntity(targetUnitId)
		if isvalid(sourceEntity) == false then
			result.Reason = "SOURCE_NOT_FOUND"
			return result
		end
		if isvalid(targetEntity) == false then
			result.Reason = "TARGET_NOT_FOUND"
			return result
		end

		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		local targetUnit = targetEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit == nil or targetUnit == nil then
			result.Reason = "UNIT_COMPONENT_MISSING"
			return result
		end
		if sourceUnit.Team == targetUnit.Team then
			result.Reason = "SAME_TEAM"
			return result
		end
		if sourceUnit.IsDead == true or targetUnit.IsDead == true then
			result.Reason = "UNIT_DEAD"
			return result
		end

		local damageResult = targetUnit:ApplyDamage(amount)
		if damageResult.Success == false then
			result.Reason = damageResult.Reason
			return result
		end
		result.HpBefore = damageResult.HpBefore
		result.HpAfter = damageResult.HpAfter
		result.AppliedAmount = damageResult.AppliedAmount
		if damageResult.ReachedZero == true then
			self:HandleUnitDiedFromSource(targetUnitId, "DAMAGE", sourceUnitId)
		end

		local presentation = targetEntity:GetComponent("script.BattleUnitPresentationComponent")
		if presentation ~= nil and targetEntity.SpriteRendererComponent ~= nil then
			presentation:PlayHitFlash(targetUnitId)
		end

		result.Success = true
		result.Reason = "OK"
		log("[BattleDamage] applied source=" .. sourceUnitId .. " target=" .. targetUnitId .. " amount=" .. result.AppliedAmount .. " hp=" .. result.HpBefore .. "->" .. result.HpAfter)
		return result
	end

	@ExecSpace("ServerOnly")
	method void HandleUnitDied(string unitId, string cause)
		-- Preserves the existing public death entrypoint for non-attributed causes and tests.
		self:HandleUnitDiedFromSource(unitId, cause, "")
	end

	@ExecSpace("ServerOnly")
	method void HandleUnitDiedFromSource(string unitId, string cause, string sourceUnitId)
		-- Marks one unit dead, resolves contextual drops, advances waves, and checks battle completion.
		local unitEntity = self:FindUnitEntity(unitId)
		if isvalid(unitEntity) == false then
			log_error("[BattleDeath] failed unit=" .. unitId .. " reason=UNIT_NOT_FOUND")
			return
		end

		local unit = unitEntity:GetComponent("script.BattleUnitComponent")
		if unit == nil then
			log_error("[BattleDeath] failed unit=" .. unitId .. " reason=COMPONENT_MISSING")
			return
		end
		if self.BattleResult ~= "" then
			log("[BattleDeath] ignored unit=" .. unitId .. " reason=BATTLE_ALREADY_ENDED result=" .. self.BattleResult)
			return
		end
		if unit.IsDead == true then
			log_warning("[BattleDeath] duplicate ignored unit=" .. unitId)
			return
		end

		local deathState = unit:MarkDead()
		if deathState.Success == false then
			log_error("[BattleDeath] state transition failed unit=" .. unitId .. " reason=" .. deathState.Reason)
			return
		end
		if unit.Team == "Enemy" and self.DropRuntime ~= nil then
			local sourceEntity = self:FindUnitEntity(sourceUnitId)
			local sourceUnit = nil
			if isvalid(sourceEntity) then
				sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
			end
			if sourceUnit ~= nil and sourceUnit.Team == "Player" then
				self.CurrentPlayerActionKillCount = self.CurrentPlayerActionKillCount + 1
			end
			local triggerResult = _EnemyDropTriggerResolverLogic:Resolve(unit.IsBoss, self.CurrentPlayerActionKillCount)
			local dropResult = self.DropRuntime:ResolveEnemyDeath(
				self.RunSeed,
				self.StageId,
				self.CurrentWave,
				unit.EnemyDefinitionId,
				unit.UnitId,
				unit.SpawnOrder,
				unit.CellIndex,
				triggerResult.TriggerSnapshot
			)
			if dropResult.Success == false then
				log_error("[BattleDeath] drop failed unit=" .. unitId .. " reason=" .. dropResult.Reason)
			end
		end
		if unit.Team == "Enemy" and self.BoardState ~= nil then
			local livingEnemies = self.BoardState:CollectLivingEnemies()
			if #livingEnemies > 0 then
				log("[BattleDeath] unit=" .. unitId .. " cause=" .. cause .. " result=CONTINUE livingEnemies=" .. #livingEnemies)
				return
			end
		end
		self:ClearForcedSpawnSchedule("ALL_ENEMIES_DEFEATED")
		self:ClearSkillImpactTimers()
		if self.ActionTimerId > 0 then
			_TimerService:ClearTimer(self.ActionTimerId)
			self.ActionTimerId = 0
		end
		if unit.Team == "Enemy" then
			if self.CurrentWave < self.TotalWaves then
				self.TurnState:ClearActionState("WAVE_CLEARED")
				self.TurnState:SetPhase("WaveTransition", "WAVE_CLEARED")
				self:PublishTurnStateSnapshot("WAVE_CLEARED")
				log("[BattleQueueBoundary] boundary=WAVE_CLEARED policy=PRESERVE queue=" .. self.TurnState.QueuedTileIds)
				self:ClearPreparedEnemyIntent("WAVE_CLEARED")
				local clearedWave = self.CurrentWave
				local nextWave = clearedWave + 1
				self.WaveRuntime:ScheduleWaveTransition(clearedWave, nextWave, self.CurrentClearSpawnDelay)
				self:PublishWaveStateSnapshot("WAVE_CLEARED")
				log("[BattleWave] cleared stage=" .. self.StageNumber .. " wave=" .. clearedWave .. "/" .. self.TotalWaves .. " nextWave=" .. nextWave)
				return
			end

			local queuedBeforeVictory = self.TurnState.QueuedTileIds
			self.TurnState:ClearTransientState("STAGE_CLEARED")
			self.TurnState:SetPhase("BattleEnded", "STAGE_CLEARED")
			self:PublishTurnStateSnapshot("STAGE_CLEARED")
			log("[BattleQueueBoundary] boundary=VICTORY policy=CLEAR before=" .. queuedBeforeVictory .. " after=" .. self.TurnState.QueuedTileIds)
			self.WaveRuntime:SetWaveState("StageCleared", "STAGE_CLEARED")
			self:PublishWaveStateSnapshot("STAGE_CLEARED")
			self.BattleResult = "Victory"
		else
			local queuedBeforeDefeat = self.TurnState.QueuedTileIds
			self.TurnState:ClearTransientState("PLAYER_DEFEATED")
			self.TurnState:SetPhase("BattleEnded", "PLAYER_DEFEATED")
			self:PublishTurnStateSnapshot("PLAYER_DEFEATED")
			log("[BattleQueueBoundary] boundary=DEFEAT policy=CLEAR before=" .. queuedBeforeDefeat .. " after=" .. self.TurnState.QueuedTileIds)
			self.WaveRuntime:SetWaveState("Failed", "PLAYER_DEFEATED")
			self:PublishWaveStateSnapshot("PLAYER_DEFEATED")
			self.BattleResult = "Defeat"
		end

		local runResultRecorded = false
		if isvalid(self.PlayerEntity) then
			if self.BattleResult == "Victory" and self.DropRuntime ~= nil then
				local dropRecordKey = self.StageId .. ":" .. tostring(self.EntryRequestId)
				local collectResult = self.DropRuntime:AutoCollectAll(self.PlayerEntity, dropRecordKey)
				if collectResult.Success == false then
					log_error("[BattleResult] drop auto collect failed reason=" .. collectResult.Reason .. " remaining=" .. collectResult.FailedCount)
				end
			elseif self.DropRuntime ~= nil then
				self.DropRuntime:DiscardPending("BATTLE_DEFEAT")
			end
			runResultRecorded = _RunManagerLogic:RecordBattleResult(self.PlayerEntity, self.StageId, self.StageNumber, self.BattleResult, self.EntryRequestId)
		end
		log("[BattleDeath] unit=" .. unitId .. " cause=" .. cause .. " result=" .. self.BattleResult .. " wave=" .. self.CurrentWave)
		log("[BattleResult] result=" .. self.BattleResult .. " stage=" .. self.StageNumber .. " wave=" .. self.CurrentWave .. "/" .. self.TotalWaves .. " turn=" .. self.TurnNumber .. " runRecorded=" .. tostring(runResultRecorded))
		if self.BattleResult == "Victory" and runResultRecorded == true and isvalid(self.PlayerEntity) then
			_StageTransitionManagerLogic:HandleVictoryTransition(self.PlayerEntity, self.StageId)
		end
	end

	@ExecSpace("ServerOnly")
	method void AdvanceClearedWave(integer clearedWave, integer nextWave)
		-- Called only by BattleWaveComponent after its map-scoped transition timer expires.
		if self.BattleResult ~= "" or self.CurrentWave ~= clearedWave then
			return
		end
		self.TurnState:OpenPlayerTurn(self.TurnNumber + 1, "NEXT_WAVE")
		self:PublishTurnStateSnapshot("NEXT_WAVE")
		self.StageTurnNumber = self.TurnNumber
		self:SpawnWave(nextWave)
		if self.CurrentWave == nextWave then
			self.TurnState:SetPhase("PlayerTurn", "NEXT_WAVE_ACTIVE")
			self:PublishTurnStateSnapshot("NEXT_WAVE_ACTIVE")
			self.WaveRuntime:MarkWaveActive("NEXT_WAVE_ACTIVE")
			self:PublishWaveStateSnapshot("NEXT_WAVE_ACTIVE")
			self:ProcessAugmentTrigger("TURN_START", "TURN:" .. tostring(self.TurnNumber), 0)
			self:PrepareEnemyIntent()
		end
	end

	@ExecSpace("ServerOnly")
	method Entity ResolveFrontTarget(string sourceUnitId)
		-- Returns a living opposing unit occupying the source unit's front cell.
		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		if isvalid(sourceEntity) == false then
			return nil
		end

		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit == nil then
			return nil
		end

		local facingDirection = -1
		if sourceUnit.Facing == "Right" then
			facingDirection = 1
		end
		local targetCell = sourceUnit.CellIndex + facingDirection

		if self.BoardState == nil then
			return nil
		end
		local candidate = self.BoardState:FindAtCell(targetCell, sourceUnitId)
		if isvalid(candidate) then
			local unit = candidate:GetComponent("script.BattleUnitComponent")
			if unit ~= nil and unit.Team ~= sourceUnit.Team then
				return candidate
			end
		end
		return nil
	end

	@ExecSpace("Server")
	method void RequestMove(integer direction)
		-- Validates the requesting client before forwarding the move to battle state.
		if isvalid(self.PlayerEntity) == false or self.PlayerEntity.PlayerComponent == nil then
			log_warning("[BattleMove] rejected reason=PLAYER_MISSING")
			return
		end

		if self.PlayerEntity.PlayerComponent.UserId ~= senderUserId then
			log_warning("[BattleMove] rejected reason=INVALID_SENDER")
			return
		end

		if self.BattlePhase ~= "PlayerTurn" then
			-- Silently ignore movement input when battle has ended or during wave transitions
			return
		end

		local result = self:TryQueuePlayerAction("MOVE", direction)
		self:PublishPlayerCommandResult("MOVE", result)
		if result.Success == false then
			log_warning("[BattleQueue] rejected action=MOVE direction=" .. direction .. " reason=" .. result.Reason)
		end
	end

	@ExecSpace("ServerOnly")
	method table RelocateUnitForMechanic(string unitId, integer toCell, string mechanicId)
		-- Provides a validated board-mutation boundary for job handlers without exposing BoardState internals.
		local result = { Success = false, Reason = "UNKNOWN", UnitId = unitId or "", FromCell = -1, ToCell = toCell }
		if self:IsValidCell(toCell) == false then
			result.Reason = "OUT_OF_BOUNDS"
			return result
		end
		local unitEntity = self:FindUnitEntity(unitId)
		if isvalid(unitEntity) == false then
			result.Reason = "UNIT_NOT_FOUND"
			return result
		end
		local unit = unitEntity:GetComponent("script.BattleUnitComponent")
		if unit == nil or unit.IsDead == true then
			result.Reason = "UNIT_UNAVAILABLE"
			return result
		end
		if self:IsCellOccupied(toCell, unitId) then
			result.Reason = "CELL_OCCUPIED"
			return result
		end
		result.FromCell = unit.CellIndex
		local cellChange = unit:ApplyCellChange(toCell)
		if cellChange.Success == false then
			result.Reason = cellChange.Reason
			return result
		end
		self:PlaceEntity(unitEntity, self:GetCellPosition(toCell))
		self:CollectDropsForMovedUnit(unit, toCell)
		local movedEvent = UnitMovedEvent()
		movedEvent.UnitId = unit.UnitId
		movedEvent.FromCell = result.FromCell
		movedEvent.ToCell = toCell
		self.Entity:SendEvent(movedEvent)
		result.Success = true
		result.Reason = "OK"
		log("[JobMechanic] relocated mechanic=" .. mechanicId .. " unit=" .. unitId .. " from=" .. result.FromCell .. " to=" .. toCell)
		return result
	end

	@ExecSpace("ServerOnly")
	method integer ResolveEnemyRelativeMoveDirection(string enemyId, string actionType)
		-- Post-attack movement resolves against the live board after impact/push effects.
		local enemyEntity = self:FindUnitEntity(enemyId)
		local playerEntity = self:FindUnitEntity("player_01")
		if isvalid(enemyEntity) == false or isvalid(playerEntity) == false then
			return 0
		end
		local enemy = enemyEntity:GetComponent("script.BattleUnitComponent")
		local player = playerEntity:GetComponent("script.BattleUnitComponent")
		if enemy == nil or player == nil or enemy.CellIndex == player.CellIndex then
			return 0
		end
		local towardDirection = player.CellIndex > enemy.CellIndex and 1 or -1
		if actionType == "MOVE_AWAY" then
			return -towardDirection
		end
		return towardDirection
	end

	@ExecSpace("ServerOnly")
	method table TryMoveAway(string unitId, integer direction)
		-- Atomically turns away and moves one cell; blocked destinations never change Facing.
		local result = { Success = false, Reason = "UNKNOWN", FromCell = -1, ToCell = -1, PreviousFacing = "", CurrentFacing = "" }
		if direction ~= -1 and direction ~= 1 then
			result.Reason = "INVALID_DIRECTION"
			return result
		end
		local unitEntity = self:FindUnitEntity(unitId)
		if isvalid(unitEntity) == false then
			result.Reason = "UNIT_NOT_FOUND"
			return result
		end
		local unit = unitEntity:GetComponent("script.BattleUnitComponent")
		if unit == nil then
			result.Reason = "UNIT_COMPONENT_MISSING"
			return result
		end
		if self:IsTeamTurn(unit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end
		if unit.IsDead == true then
			result.Reason = "UNIT_DEAD"
			return result
		end

		result.FromCell = unit.CellIndex
		result.ToCell = unit.CellIndex + direction
		result.PreviousFacing = unit.Facing
		result.CurrentFacing = direction > 0 and "Right" or "Left"
		if self:IsValidCell(result.ToCell) == false then
			result.Reason = "OUT_OF_BOUNDS"
			return result
		end
		if self:IsCellOccupied(result.ToCell, unitId) then
			result.Reason = "CELL_OCCUPIED"
			return result
		end

		local facingResult = unit:ApplyFacingState(result.CurrentFacing)
		if facingResult.Success == false then
			result.Reason = facingResult.Reason
			return result
		end
		local moveResult = self:TryMove(unitId, direction)
		if moveResult.Success == false then
			unit:ApplyFacingState(result.PreviousFacing)
			self:ApplyFacing(unitEntity, unit.Facing)
			result.Reason = moveResult.Reason
			return result
		end

		self:ApplyFacing(unitEntity, unit.Facing)
		if result.PreviousFacing ~= result.CurrentFacing then
			local turnedEvent = UnitTurnedEvent()
			turnedEvent.UnitId = unit.UnitId
			turnedEvent.PreviousFacing = result.PreviousFacing
			turnedEvent.CurrentFacing = result.CurrentFacing
			self.Entity:SendEvent(turnedEvent)
		end
		result.Success = true
		result.Reason = "OK"
		log("[BattleMoveAway] success unit=" .. unit.UnitId .. " from=" .. result.FromCell .. " to=" .. result.ToCell .. " facing=" .. result.PreviousFacing .. "->" .. result.CurrentFacing)
		return result
	end

	@ExecSpace("ServerOnly")
	method table TryMove(string unitId, integer direction)
		-- Moves one logical cell after checking phase, range, life, and occupancy.
		local result = {
			Success = false,
			Reason = "UNKNOWN",
			FromCell = -1,
			ToCell = -1
		}

		if direction ~= -1 and direction ~= 1 then
			result.Reason = "INVALID_DIRECTION"
			return result
		end

		local unitEntity = self:FindUnitEntity(unitId)
		if isvalid(unitEntity) == false then
			result.Reason = "UNIT_NOT_FOUND"
			return result
		end

		local unit = unitEntity:GetComponent("script.BattleUnitComponent")
		if unit == nil then
			result.Reason = "UNIT_COMPONENT_MISSING"
			return result
		end

		if self:IsTeamTurn(unit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end

		result.FromCell = unit.CellIndex
		result.ToCell = unit.CellIndex + direction
		if unit.IsDead == true then
			result.Reason = "UNIT_DEAD"
			return result
		end

		if self:IsValidCell(result.ToCell) == false then
			result.Reason = "OUT_OF_BOUNDS"
			return result
		end

		local mechanicResult = nil
		if self:IsCellOccupied(result.ToCell, unitId) then
			local occupiedEntity = self.BoardState:FindAtCell(result.ToCell, unitId)
			if unit.Team == "Player" and self.SelectedJobMechanicId ~= "" and self.SelectedJobMechanicId ~= "NONE" then
				local mechanicContext = {
					BattleSession = self,
					SourceEntity = unitEntity,
					SourceUnit = unit,
					SourceCell = result.FromCell,
					TargetCell = result.ToCell,
					Direction = direction,
					OccupantEntity = occupiedEntity
				}
				local availability = _JobMechanicRouterLogic:CanActivate(self.SelectedJobMechanicId, mechanicContext)
				self.LastJobMechanicId = self.SelectedJobMechanicId
				self.LastJobMechanicSuccess = availability.Success == true and availability.CanActivate == true
				self.LastJobMechanicReason = availability.Reason or "JOB_MECHANIC_UNAVAILABLE"
				self.JobMechanicRevision = self.JobMechanicRevision + 1
				if availability.Success == true and availability.CanActivate == true then
					mechanicResult = _JobMechanicRouterLogic:Execute(self.SelectedJobMechanicId, mechanicContext)
					self.LastJobMechanicSuccess = mechanicResult.Success == true
					self.LastJobMechanicReason = mechanicResult.Reason or "JOB_MECHANIC_FAILED"
					if mechanicResult.Success == false or mechanicResult.AllowSourceMove ~= true then
						result.Reason = mechanicResult.Reason
						return result
					end
				else
					result.DetailReason = availability.Reason
				end
			end
			if self:IsCellOccupied(result.ToCell, unitId) then
				result.Reason = "CELL_OCCUPIED"
				return result
			end
		end

		local cellChange = unit:ApplyCellChange(result.ToCell)
		if cellChange.Success == false then
			result.Reason = cellChange.Reason
			return result
		end
		local position = self:GetCellPosition(result.ToCell)
		self:PlaceEntity(unitEntity, position)
		local pickupResult = self:CollectDropsForMovedUnit(unit, result.ToCell)
		result.PickedUpDropCount = pickupResult.CollectedCount or 0

		local movedEvent = UnitMovedEvent()
		movedEvent.UnitId = unit.UnitId
		movedEvent.FromCell = result.FromCell
		movedEvent.ToCell = result.ToCell
		self.Entity:SendEvent(movedEvent)

		result.Success = true
		result.Reason = mechanicResult ~= nil and mechanicResult.Reason or "OK"
		if mechanicResult ~= nil then
			result.MechanicId = mechanicResult.MechanicId
			result.PushedUnitId = mechanicResult.PushedUnitId
			result.PushedFromCell = mechanicResult.PushedFromCell
			result.PushedToCell = mechanicResult.PushedToCell
		end
		log("[BattleMove] success unit=" .. unit.UnitId .. " from=" .. result.FromCell .. " to=" .. result.ToCell .. " x=" .. position.x)
		return result
	end

	@ExecSpace("ServerOnly")
	method table CollectDropsForMovedUnit(any unit, integer cellIndex)
		-- Keeps movement coordination here while BattleDropComponent owns reward transfer and pending-state mutation.
		if unit == nil or unit.Team ~= "Player" then
			return { Success = true, Reason = "NOT_PLAYER", CollectedCount = 0, FailedCount = 0 }
		end
		if isvalid(self.PlayerEntity) == false then
			return { Success = false, Reason = "PLAYER_MISSING", CollectedCount = 0, FailedCount = 0 }
		end
		local dropRuntime = self:EnsureDropStateComponent()
		if dropRuntime == nil then
			return { Success = false, Reason = "DROP_RUNTIME_MISSING", CollectedCount = 0, FailedCount = 0 }
		end
		local battleRecordKey = self.StageId .. ":" .. tostring(self.EntryRequestId)
		local result = dropRuntime:CollectAtCell(self.PlayerEntity, battleRecordKey, cellIndex)
		if result.FailedCount > 0 then
			log_warning("[BattleDrop] player pickup partial cell=" .. cellIndex .. " failed=" .. result.FailedCount)
		end
		return result
	end

	method Entity FindUnitEntity(string unitId)
		-- Delegates logical unit lookup to the map-scoped BoardState registry.
		if self.BoardState == nil then
			return nil
		end
		return self.BoardState:FindByUnitId(unitId)
	end

	@ExecSpace("ServerOnly")
	method any GetSkillRuntimeState(string unitId)
		local unitEntity = self:FindUnitEntity(unitId)
		if isvalid(unitEntity) == false then
			return nil
		end
		return unitEntity:GetComponent("script.SkillRuntimeStateComponent")
	end

	@ExecSpace("ServerOnly")
	method void AdvancePlayerSkillCooldowns(string reason)
		local runtimeState = self:GetSkillRuntimeState("player_01")
		if runtimeState == nil then
			log_warning("[BattleCooldown] advance skipped reason=SKILL_RUNTIME_STATE_MISSING turn=" .. self.TurnNumber)
			return
		end
		runtimeState:AdvanceCooldowns(1, reason)
	end

	@ExecSpace("ServerOnly")
	method void AdvanceEnemySkillCooldowns(string enemyUnitId, string reason)
		-- Enemy cooldowns advance on that enemy's own action, independent of player queue size.
		local runtimeState = self:GetSkillRuntimeState(enemyUnitId)
		if runtimeState == nil then
			return
		end
		runtimeState:AdvanceCooldowns(1, reason)
	end

	method boolean IsCellOccupied(integer cellIndex, string ignoredUnitId)
		-- Delegates living-cell occupancy to the map-scoped BoardState registry.
		if self.BoardState == nil then
			return false
		end
		return isvalid(self.BoardState:FindAtCell(cellIndex, ignoredUnitId))
	end

	method number GetBoardCenterX()
		-- Calculates the visual center of the current logical battle board.
		return self.CellStartX + self.CellSpacing * (self.CellCount - 1) * 0.5
	end

	@ExecSpace("Client")
	method void LockBoardCamera(number boardCenterX)
		-- Switches away from the moving player to a fixed board-center camera target.
		local player = _UserService.LocalPlayer
		if isvalid(player) == false or player.CameraComponent == nil then
			log_error("[BattleCamera] local player camera missing")
			return
		end

		local anchor = self.Entity:GetChildByName("BattleCameraAnchor", false)
		if isvalid(anchor) == false or anchor.CameraComponent == nil or anchor.TransformComponent == nil then
			log_error("[BattleCamera] BattleCameraAnchor missing")
			return
		end

		local playerCamera = player.CameraComponent
		local boardCamera = anchor.CameraComponent
		local anchorX = anchor.TransformComponent.WorldPosition.x
		boardCamera.CameraOffset = Vector2(boardCenterX - anchorX, playerCamera.CameraOffset.y)
		boardCamera.ScreenOffset = playerCamera.ScreenOffset
		boardCamera.ZoomRatio = playerCamera.ZoomRatio
		boardCamera.ConfineCameraArea = false
		boardCamera.Damping = Vector2(0, 0)
		boardCamera.DeadZone = Vector2(0, 0)
		boardCamera.SoftZone = Vector2(0, 0)

		_CameraService.TransitionBlendTime = 0
		_CameraService:SwitchCameraTo(boardCamera)
		log("[BattleCamera] fixed anchor active centerX=" .. boardCenterX .. " anchorX=" .. anchorX .. " offsetX=" .. boardCamera.CameraOffset.x)
	end

	method boolean IsValidCell(integer cellIndex)
		-- Returns whether the logical cell index is inside the six-cell board.
		return cellIndex >= 0 and cellIndex < self.CellCount
	end

	method Vector2 GetCellPosition(integer cellIndex)
		-- Converts a zero-based logical cell index into the current map's world position.
		local x = self.CellStartX + self.CellSpacing * cellIndex
		return Vector2(x, self.UnitY)
	end

	@ExecSpace("ServerOnly")
	method void PlaceEntity(Entity targetEntity, Vector2 position)
		-- Places Body-based players through MovementComponent and static units through TransformComponent.
		if targetEntity.MovementComponent ~= nil then
			targetEntity.MovementComponent:SetPosition(position)
			return
		end

		if targetEntity.TransformComponent == nil then
			log_error("[BattleSession] TransformComponent missing entity=" .. targetEntity.Name)
			return
		end

		local current = targetEntity.TransformComponent.Position
		targetEntity.TransformComponent.Position = Vector3(position.x, position.y, current.z)
	end

	@ExecSpace("ServerOnly")
	method void TryStartBattle()
		-- Enters the first player turn after a player and at least one wave enemy have registered.
		if self:IsContentValidationReady() == false then
			return
		end
		local playerEntity = self:FindUnitEntity("player_01")
		if isvalid(playerEntity) == false or self.BoardState == nil then
			return
		end
		local livingEnemies = self.BoardState:CollectLivingEnemies()
		if #livingEnemies == 0 then
			return
		end
		self.PlayerEntity = playerEntity
		self.EnemyEntity = livingEnemies[1]

		if self.BattlePhase == "PlayerTurn" then
			return
		end

		self.TurnState:OpenPlayerTurn(1, "BATTLE_READY")
		self:PublishTurnStateSnapshot("BATTLE_READY")
		self.WaveRuntime:MarkWaveActive("BATTLE_READY")
		self:PublishWaveStateSnapshot("BATTLE_READY")
		self.StageTurnNumber = 1
		self:ProcessAugmentTrigger("TURN_START", "TURN:1", 0)
		log("[BattleSession] ready phase=" .. self.BattlePhase .. " stage=" .. self.StageNumber .. " wave=" .. self.CurrentWave .. "/" .. self.TotalWaves .. " turn=" .. self.TurnNumber .. " playerCell=" .. self.PlayerStartCell .. " livingEnemies=" .. #livingEnemies .. " enemyHp=" .. self.CurrentEnemyMaxHp)
		log("[BattleSession] battle started stageId=" .. self.StageId .. " wave=" .. self.CurrentWave)
		self:PrepareEnemyIntent()
	end

end
