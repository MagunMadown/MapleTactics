	@ExecSpace("Server")
	method void RequestDiscardConsumable(string consumableId, integer requestId, integer entryId, integer inventoryRevision)
		if not isvalid(self.PlayerEntity) or self.PlayerEntity.PlayerComponent == nil then return end
		if self.PlayerEntity.PlayerComponent.UserId ~= senderUserId then return end
		local result = self:TryDiscardRunConsumable(self.PlayerEntity, consumableId, requestId, entryId, inventoryRevision)
		result.RequestId = requestId
		result.Action = "DISCARD"
		self:ReceiveConsumableUseResult(result, entryId, senderUserId)
	end

	@ExecSpace("ServerOnly")
	method table TryDiscardRunConsumable(Entity playerEntity, string consumableId, integer requestId, integer entryId, integer inventoryRevision)
