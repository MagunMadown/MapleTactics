	end

	@ExecSpace("ServerOnly")
	method void FlushDamageNumberBatch(table batch)
		-- Dispatch each accepted multi-hit segment before its target can be removed on death.
		if batch == nil or batch.Damages == nil or #batch.Damages == 0 then return end
		local amounts = batch.Damages
		batch.Damages = {}
		self:PresentDamageNumbers(self:FindUnitEntity(batch.SourceUnitId), self:FindUnitEntity(batch.TargetUnitId), amounts, 0.08)
	end

