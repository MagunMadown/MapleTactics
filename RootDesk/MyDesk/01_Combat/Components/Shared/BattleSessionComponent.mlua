	@ExecSpace("ServerOnly")
	method void NotifyBossPhaseAdvanced(integer phaseIndex)
		-- Bridges a boss phase transition to the wave runtime. Ownership stays split: the
		-- wave component decides whether the current wave arms a BOSS_PHASE trigger, and the
		-- actual spawn still runs through EvaluateForcedSpawnAtTurnBoundary on the next turn
		-- boundary, so no enemy is injected while an action is resolving.
		if self.WaveRuntime == nil then
			return
		end
		local trigger = self.WaveRuntime:ApplyBossPhaseTrigger(phaseIndex, "BOSS_PHASE_CHANGED")
		if trigger.Pended == true then
			self:PublishWaveStateSnapshot("BOSS_PHASE_SPAWN_PENDING")
			log("[BattleSession] boss phase reinforcement queued phase=" .. phaseIndex .. " wave=" .. self.WaveRuntime.PendingWaveNumber)
		end
	end

