	@ExecSpace("Client")
	method void ReceiveConsumableUseResult(table result, integer entryId)
		-- Receipts stay on the battle component; UI entities never host a server RPC.
		if entryId ~= self.EntryRequestId or result.RequestId ~= self.ConsumableRequestSequence then return end
		self._T.ConsumablePending = false
		self._T.ConsumableUseResult = result
		self._T.ConsumableReceiptRevision = (self._T.ConsumableReceiptRevision or 0) + 1
	end

	@ExecSpace("Server")
	method void RequestConsumableHudState(integer queryId, integer entryId)
		-- Sends a small owner-only read model because the authored dataset is server-only.
		if not isvalid(self.PlayerEntity) or self.PlayerEntity.PlayerComponent == nil then return end
		if senderUserId ~= self.PlayerEntity.PlayerComponent.UserId then return end
		if self.PlayerEntity.CurrentMap ~= self.Entity or entryId ~= self.EntryRequestId then return end
		self:ReceiveConsumableHudState(self:BuildConsumableHudState(), queryId, entryId, senderUserId)
	end

	@ExecSpace("Client")
	method void ReceiveConsumableHudState(table data, integer queryId, integer entryId)
		-- Ignores delayed responses from an older battle or older query.
		if entryId ~= self.EntryRequestId or queryId < (self._T.ConsumableHudQuery or 0) then return end
		self._T.ConsumableHudQuery = queryId
		self._T.ConsumableHudState = data
	end

