@Component
script BattleSessionComponent extends Component

	@Sync property string BattlePhase = "Setup"
	@Sync property integer TurnNumber = 0
	@Sync property string QueuedActionType = ""
	@Sync property integer QueuedActionDirection = 0
	@Sync property boolean IsActionProcessing = false
	@Sync property string QueuedTileIds = ""
	@Sync property integer QueuedTileCount = 0
	@Sync property string ExecutingTileIds = ""
	@Sync property integer ExecutingTileIndex = 0
	@Sync property integer TileQueueCapacity = 2
	@Sync property string BattleResult = ""
	@Sync property string PreparedEnemyIntentState = "EMPTY"
	@Sync property string PreparedEnemyId = ""
	@Sync property string PreparedEnemyPatternId = ""
	@Sync property integer PreparedEnemyStepIndex = 0
	@Sync property string PreparedEnemyActionType = ""
	@Sync property string PreparedEnemyTileId = ""
	@Sync property integer PreparedEnemyDirection = 0
	@Sync property integer PreparedEnemyTurn = 0
	@Sync property string PreparedEnemyReason = ""
	@Sync property integer StageNumber = 1
	@Sync property string StageId = "stage01"
	@Sync property string StageDisplayName = ""
	@Sync property string WaveTableId = ""
	@Sync property string NextStageId = ""
	@Sync property string StageRuleId = ""
	@Sync property integer StageSchemaVersion = 0
	@Sync property integer RunSeed = 1000
	@Sync property integer EntryRequestId = 0
	@Sync property string EntryMode = ""
	@Sync property string SelectedCharacterId = ""
	@Sync property string SelectedJobId = ""
	@Sync property string SelectedLoadoutId = ""
	@Sync property integer StageTurnNumber = 0
	@Sync property integer CurrentWave = 0
	@Sync property integer TotalWaves = 3
	@Sync property string WaveState = "Setup"
	@Sync property integer WaveSpawnStageTurn = 0
	@Sync property string CurrentWaveSpawnMode = "CLEAR_ONLY"
	@Sync property integer ForceAfterTurns = 0
	@Sync property number ForceAfterSeconds = 0
	@Sync property boolean ForceSpawnPending = false
	@Sync property string ForceSpawnPendingReason = ""
	@Sync property integer CurrentWaveSpawnCount = 2
	@Sync property integer MaxConcurrentEnemies = 5
	@Sync property number CurrentClearSpawnDelay = 0.60

	property integer CellCount = 6
	property number CellStartX = -2.8
	property number CellSpacing = 1.12
	property number UnitY = 0.12
	property integer PlayerStartCell = 2
	property integer LeftEnemyStartCell = 0
	property integer RightEnemyStartCell = 5
	property number CurrentEnemyMaxHp = 1
	property number BasicAttackDamage = 3
	property string BasicSlashMotionKey = "basic_slash"
	property string BasicSlashActionName = "swingO1"
	property number BasicSlashMotionPlayRate = 1
	property number BasicSlashMotionDuration = 0.45
	property number BasicSlashImpactDelay = 0.18
	property number HeavySlashDamage = 6
	property string HeavySlashMotionKey = "heavy_slash"
	property string HeavySlashActionName = "swingO2"
	property number HeavySlashMotionPlayRate = 0.85
	property number HeavySlashMotionDuration = 0.70
	property number HeavySlashImpactDelay = 0.38
	property string PushMotionKey = "push"
	property string PushActionName = "swingO1"
	property number PushMotionPlayRate = 0.9
	property number PushMotionDuration = 0.40
	property number PushImpactDelay = 0.18
	property number MoveActionDuration = 0.12
	property number TurnActionDuration = 0.12
	property number BasicAttackActionDuration = 0.45
	property number HeavySlashActionDuration = 0.70
	property number PushActionDuration = 0.40
	property number EnemyThinkDuration = 0.25
	property number EnemyMoveActionDuration = 0.12
	property number EnemyAttackActionDuration = 0.30
	property string EnemyModelId = "battledummyenemy"
	property string CurrentEnemyDefinitionId = ""
	property number CurrentEnemyBasicAttackDamage = 0
	property string CurrentEnemyPatternId = ""
	property string CurrentEnemyMovementPolicy = ""
	property number WaveTransitionDelay = 0.60
	property boolean AutoStartPrototypeBattle = true
	property string LeftEnemyEntityName = "BattleEnemyLeft"
	property string RightEnemyEntityName = "BattleEnemyRight"
	property Entity PlayerEntity = nil
	property Entity EnemyEntity = nil
	property any BoardState = nil
	property any TurnState = nil
	property any WaveRuntime = nil
	property integer ActionTimerId = 0
	property integer ImpactTimerId = 0
	property integer LastEnemySpawnOrder = 0

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleMoveKeyDown(KeyDownEvent event)
		-- Converts one movement/turn/attack key press into a server-authoritative request.
		if event.key == KeyboardKey.Space then
			log("[BattleInput] turn requested")
			self:RequestTurn()
			return
		end

		if event.key == KeyboardKey.F then
			log("[BattleInput] basic attack requested")
			self:RequestBasicAttack()
			return
		end

		local direction = 0
		if event.key == KeyboardKey.LeftArrow or event.key == KeyboardKey.A then
			direction = -1
		elseif event.key == KeyboardKey.RightArrow or event.key == KeyboardKey.D then
			direction = 1
		end

		if direction ~= 0 then
			log("[BattleInput] move requested direction=" .. direction)
			self:RequestMove(direction)
		end
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleUnitTurnedEvent(UnitTurnedEvent event)
		-- Confirms that subscribers can observe a completed direction change.
		log("[BattleEvent] UnitTurnedEvent received unit=" .. event.UnitId .. " from=" .. event.PreviousFacing .. " to=" .. event.CurrentFacing)
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleUnitMovedEvent(UnitMovedEvent event)
		-- Confirms that subscribers can observe a completed logical move.
		log("[BattleEvent] UnitMovedEvent received unit=" .. event.UnitId .. " from=" .. event.FromCell .. " to=" .. event.ToCell)
	end

	@ExecSpace("ServerOnly")
	@EventSender("Self")
	handler HandleBasicAttackResolvedEvent(BasicAttackResolvedEvent event)
		-- Confirms that subscribers receive both hit and miss attack resolutions.
		log("[BattleEvent] BasicAttackResolvedEvent attack=" .. event.AttackId .. " source=" .. event.SourceUnitId .. " target=" .. event.TargetUnitId .. " cell=" .. event.TargetCell .. " hit=" .. tostring(event.Hit) .. " reason=" .. event.Reason .. " damage=" .. event.DamageAmount .. " hp=" .. event.TargetHpBefore .. "->" .. event.TargetHpAfter)
	end

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- Initializes the map-scoped session. Prototype maps may still opt into automatic Stage 1 start.
		log("[BattleSession] begin map=" .. self.Entity.Name .. " cells=" .. self.CellCount .. " autoStart=" .. tostring(self.AutoStartPrototypeBattle))
		local boardState = self:EnsureBoardStateComponent()
		if boardState == nil then
			log_error("[BattleSession] BoardStateComponent unavailable")
			return
		end
		boardState:ResetRegistry("SESSION_BEGIN")
		local waveRuntime = self:EnsureWaveStateComponent()
		if waveRuntime == nil then
			log_error("[BattleSession] BattleWaveComponent unavailable")
			return
		end
		waveRuntime:ResetWaveState(self.TotalWaves, "SESSION_BEGIN")
		self:PublishWaveStateSnapshot("SESSION_BEGIN")
		local turnState = self:EnsureTurnStateComponent()
		if turnState == nil then
			log_error("[BattleSession] BattleTurnComponent unavailable")
			return
		end
		turnState:ResetTurnState(self.TileQueueCapacity, "SESSION_BEGIN")
		self:PublishTurnStateSnapshot("SESSION_BEGIN")

		if self.AutoStartPrototypeBattle == false then
			log("[BattleSession] waiting for BattleGateway entry")
			return
		end
		local users = _UserService:GetUsersByMapComponent(self.Entity.MapComponent)
		if users ~= nil then
			for _, player in ipairs(users) do
				self:RegisterPlayer(player)
			end
		end

		self:StartStage(1)
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- Prevents a pending action callback from surviving this map-scoped battle session.
		if self.ActionTimerId > 0 then
			_TimerService:ClearTimer(self.ActionTimerId)
			self.ActionTimerId = 0
		end
		if self.ImpactTimerId > 0 then
			_TimerService:ClearTimer(self.ImpactTimerId)
			self.ImpactTimerId = 0
		end
		if self.TurnState ~= nil then
			self.TurnState:ResetTurnState(self.TileQueueCapacity, "SESSION_END")
			self:PublishTurnStateSnapshot("SESSION_END")
		end
		self.BattleResult = ""
		if self.WaveRuntime ~= nil then
			self.WaveRuntime:ResetWaveState(self.TotalWaves, "SESSION_END")
			self:PublishWaveStateSnapshot("SESSION_END")
		end
		self:ClearPreparedEnemyIntent("END_PLAY")
		if self.BoardState ~= nil then
			self.BoardState:ResetRegistry("SESSION_END")
		end
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- Polls only during Setup so a player spawned after the map component can be registered.
		if self.BattlePhase ~= "Setup" then
			return
		end

		local users = _UserService:GetUsersByMapComponent(self.Entity.MapComponent)
		if users ~= nil then
			for _, player in ipairs(users) do
				self:RegisterPlayer(player)
				break
			end
		end

		self:TryStartBattle()
	end

	@ExecSpace("ServerOnly")
	method void OnMapEnter(Entity enteredEntity)
		-- Registers a player that enters this battle map after the session has initialized.
		if enteredEntity == nil or enteredEntity.PlayerComponent == nil then
			return
		end

		local entryState = enteredEntity:GetComponent("script.BattleEntryStateComponent")
		if entryState ~= nil and entryState.EntryState == "PREPARED" then
			local entryResult = _BattleGatewayLogic:ConsumePreparedBattle(enteredEntity, self)
			if entryResult.Success == true then
				return
			end
			log_warning("[BattleSession] prepared entry fallback request=" .. entryState.RequestId .. " reason=" .. entryResult.Reason)
		end
		if self.AutoStartPrototypeBattle == false then
			log("[BattleSession] player waiting for prepared entry player=" .. enteredEntity.Name)
			return
		end
		self:RegisterPlayer(enteredEntity)
		self:TryStartBattle()
	end

	@ExecSpace("ServerOnly")
	method void StartStage(integer stageNumber)
		-- Loads the stage wave table and starts Wave 1 through the same runtime spawn path.
		local normalizedStageNumber = math.max(1, stageNumber)
		self:StartStageById(string.format("stage%02d", normalizedStageNumber), normalizedStageNumber)
	end

	@ExecSpace("ServerOnly")
	method void StartStageById(string stageId, integer stageNumber)
		-- Starts one exact StageId so external lobby and selection systems do not depend on numeric formatting.
		self.StageNumber = math.max(1, stageNumber)
		local stageResult = self:LoadAndApplyStageDefinition(stageId)
		if stageResult.Success == false then
			self.TurnState:SetPhase("DataError", "STAGE_DATA_ERROR")
			self:PublishTurnStateSnapshot("STAGE_DATA_ERROR")
			self.WaveRuntime:SetWaveState("DataError", "STAGE_DATA_ERROR")
			self:PublishWaveStateSnapshot("STAGE_DATA_ERROR")
			log_error("[BattleSession] stage start rejected stage=" .. stageId .. " reason=" .. stageResult.Reason .. " detail=" .. (stageResult.DetailReason or ""))
			return
		end
		self.StageTurnNumber = 0
		self.BattleResult = ""
		self.WaveRuntime:ResetWaveState(self.TotalWaves, "STAGE_START")
		self:PublishWaveStateSnapshot("STAGE_START")
		log("[BattleWave] stage started stage=" .. self.StageNumber .. " stageId=" .. self.StageId .. " waveTable=" .. self.WaveTableId .. " seed=" .. self.RunSeed .. " totalWaves=" .. self.TotalWaves)
		self:SpawnWave(1)
	end

	@ExecSpace("ServerOnly")
	method table LoadAndApplyStageDefinition(string stageId)
		local validation = _ContentValidatorLogic:ValidateStageById(stageId)
		if validation.Success == false then
			return validation
		end

		local definition = validation.Data
		self.StageId = definition.StageId
		self.StageDisplayName = definition.DisplayName
		self.WaveTableId = definition.WaveTableId
		self.NextStageId = definition.NextStageId
		self.StageRuleId = definition.StageRuleId
		self.StageSchemaVersion = definition.SchemaVersion
		self.CellCount = definition.CellCount
		self.CellStartX = definition.CellStartX
		self.CellSpacing = definition.CellSpacing
		self.UnitY = definition.UnitY
		self.PlayerStartCell = definition.PlayerStartCell
		self.TurnState:SetQueueCapacity(definition.QueueCapacity, "STAGE_DEFINITION")
		self:PublishTurnStateSnapshot("STAGE_DEFINITION")
		self.WaveRuntime:SetTotalWaves(validation.TotalWaves, "STAGE_DEFINITION")
		self:PublishWaveStateSnapshot("STAGE_DEFINITION")
		log("[BattleSession] stage definition applied stage=" .. self.StageId .. " display=" .. self.StageDisplayName .. " cells=" .. self.CellCount .. " startX=" .. self.CellStartX .. " spacing=" .. self.CellSpacing .. " playerCell=" .. self.PlayerStartCell .. " queue=" .. self.TileQueueCapacity)
		return validation
	end

	@ExecSpace("ServerOnly")
	method void SpawnWave(integer waveNumber)
		-- Creates one data-defined wave while preserving living enemies from an earlier forced-overlap wave.
		if waveNumber < 1 or waveNumber > self.TotalWaves then
			log_error("[BattleWave] spawn rejected wave=" .. waveNumber .. " total=" .. self.TotalWaves)
			return
		end

		local definition = _StageWaveRepositoryLogic:GetWaveDefinition(self.WaveTableId, waveNumber, self.RunSeed)
		if definition.Success == false then
			self.WaveRuntime:SetWaveState("DataError", "WAVE_DEFINITION_ERROR")
			self:PublishWaveStateSnapshot("WAVE_DEFINITION_ERROR")
			log_error("[BattleWave] definition rejected stage=" .. self.StageId .. " wave=" .. waveNumber .. " reason=" .. definition.Reason)
			return
		end
		if self:CanSpawnWave(definition.SpawnCount, definition.MaxConcurrent) == false then
			self.WaveRuntime:MarkSpawnPending(waveNumber, "CAPACITY_WAIT")
			self:PublishWaveStateSnapshot("CAPACITY_WAIT")
			log_warning("[BattleWave] pending stage=" .. self.StageId .. " wave=" .. waveNumber .. " reason=CAPACITY_WAIT count=" .. definition.SpawnCount .. " maxConcurrent=" .. definition.MaxConcurrent)
			return
		end
		local spawnDefinitions = {}
		local compositionIds = {}
		for spawnIndex = 1, definition.SpawnCount do
			local spawnDefinition = _StageWaveRepositoryLogic:GetEnemySpawnDefinition(definition.EnemyPoolId, waveNumber, spawnIndex, self.RunSeed)
			if spawnDefinition.Success == false then
				self.WaveRuntime:SetWaveState("DataError", "ENEMY_DEFINITION_ERROR")
				self:PublishWaveStateSnapshot("ENEMY_DEFINITION_ERROR")
				log_error("[BattleWave] enemy definition rejected stage=" .. self.StageId .. " wave=" .. waveNumber .. " slot=" .. spawnIndex .. " reason=" .. spawnDefinition.Reason)
				return
			end
			table.insert(spawnDefinitions, spawnDefinition)
			table.insert(compositionIds, spawnDefinition.EnemyDefinitionId)
		end

		local waveBegin = self.WaveRuntime:BeginWave(
			waveNumber,
			definition.SpawnTriggerMode,
			definition.ForceAfterTurns,
			definition.ForceAfterSeconds,
			definition.SpawnCount,
			definition.MaxConcurrent,
			definition.ClearSpawnDelaySeconds,
			math.max(1, self.StageTurnNumber)
		)
		if waveBegin.Success == false then
			log_error("[BattleWave] begin rejected wave=" .. waveNumber .. " reason=" .. waveBegin.Reason)
			return
		end
		self:PublishWaveStateSnapshot("WAVE_BEGIN")
		self:CleanupDefeatedEnemies("BEFORE_WAVE_" .. waveNumber)
		if waveNumber == 1 then
			self.TurnState:ResetTurnState(self.TileQueueCapacity, "FIRST_WAVE_SPAWN")
		else
			self.TurnState:ClearTransientState("WAVE_SPAWN")
		end
		self:PublishTurnStateSnapshot("WAVE_SPAWN")
		self.LastEnemySpawnOrder = 0
		self:ClearPreparedEnemyIntent("WAVE_SPAWN")
		local firstSpawnDefinition = spawnDefinitions[1]
		self.EnemyModelId = firstSpawnDefinition.EnemyModelId
		self.CurrentEnemyDefinitionId = firstSpawnDefinition.EnemyDefinitionId
		self.CurrentEnemyMaxHp = firstSpawnDefinition.MaxHp
		self.CurrentEnemyBasicAttackDamage = firstSpawnDefinition.BasicAttackDamage
		self.CurrentEnemyPatternId = firstSpawnDefinition.PatternId
		self.CurrentEnemyMovementPolicy = firstSpawnDefinition.MovementPolicy
		local spawnedCount = 0
		for spawnIndex = 1, definition.SpawnCount do
			local preferredCell = self.LeftEnemyStartCell
			local searchDirection = 1
			local facing = "Right"
			local side = "left"
			if spawnIndex % 2 == 0 then
				preferredCell = self.RightEnemyStartCell
				searchDirection = -1
				facing = "Left"
				side = "right"
			end
			if spawnIndex > 2 then
				side = side .. "_" .. spawnIndex
			end
			local startCell = self:FindAvailableSpawnCell(preferredCell, searchDirection)
			local enemy = self:SpawnWaveEnemy(side, startCell, facing, waveNumber * 100 + spawnIndex, spawnDefinitions[spawnIndex])
			if isvalid(enemy) then
				spawnedCount = spawnedCount + 1
				if isvalid(self.EnemyEntity) == false then
					self.EnemyEntity = enemy
				end
			end
		end

		if spawnedCount == 0 then
			self.WaveRuntime:SetWaveState("SpawnFailed", "NO_ENEMY_SPAWNED")
			self:PublishWaveStateSnapshot("NO_ENEMY_SPAWNED")
			log_error("[BattleWave] spawn failed stage=" .. self.StageNumber .. " wave=" .. self.CurrentWave)
			return
		end

		self.WaveRuntime:MarkWaveActive("SPAWN_COMPLETED")
		self:PublishWaveStateSnapshot("SPAWN_COMPLETED")
		self:ScheduleForcedSpawnTimer()
		local livingTotal = #self.BoardState:CollectLivingEnemies()
		log("[BattleWave] spawned stage=" .. self.StageNumber .. " wave=" .. self.CurrentWave .. "/" .. self.TotalWaves .. " seed=" .. self.RunSeed .. " enemies=" .. spawnedCount .. " livingTotal=" .. livingTotal .. " composition=" .. table.concat(compositionIds, ",") .. " mode=" .. self.CurrentWaveSpawnMode .. " forceTurns=" .. self.ForceAfterTurns .. " forceSeconds=" .. self.ForceAfterSeconds)
		if waveNumber == 1 then
			self:TryStartBattle()
		end
	end

	@ExecSpace("ServerOnly")
	method boolean CanSpawnWave(integer spawnCount, integer maxConcurrent)
		-- Enforces the configured live-enemy cap and requires enough currently empty board cells.
		if self.BoardState == nil then
			return false
		end
		local livingEnemies = self.BoardState:CollectLivingEnemies()
		if #livingEnemies + spawnCount > maxConcurrent then
			return false
		end
		local emptyCells = 0
		for cellIndex = 0, self.CellCount - 1 do
			if self.BoardState:FindAtCell(cellIndex, "") == nil then
				emptyCells = emptyCells + 1
			end
		end
		return emptyCells >= spawnCount
	end

	@ExecSpace("ServerOnly")
	method void ScheduleForcedSpawnTimer()
		self.WaveRuntime:ScheduleForcedSpawnTimer()
	end

	@ExecSpace("ServerOnly")
	method void ClearForcedSpawnSchedule(string reason)
		self.WaveRuntime:ClearForcedSpawnSchedule(reason)
		self:PublishWaveStateSnapshot(reason)
	end

	@ExecSpace("ServerOnly")
	method void EvaluateForcedSpawnAtTurnBoundary()
		-- Evaluates turn pressure and consumes one pending forced wave only after the full enemy round.
		local evaluation = self.WaveRuntime:EvaluateForcedSpawnAtTurnBoundary(self.StageTurnNumber, self.BattleResult ~= "")
		self:PublishWaveStateSnapshot("TURN_BOUNDARY")
		if evaluation.ShouldSpawn == false then
			return
		end

		self:SpawnWave(evaluation.WaveNumber)
		if self.CurrentWave == evaluation.WaveNumber then
			log("[BattleWave] force spawned reason=" .. evaluation.PendingReason .. " wave=" .. evaluation.WaveNumber .. " stageTurn=" .. self.StageTurnNumber)
		end
	end

	@ExecSpace("ServerOnly")
	method Entity SpawnWaveEnemy(string side, integer startCell, string facing, integer spawnOrder, table spawnDefinition)
		-- Spawns one enemy with a wave-unique name and UnitId, then registers its logical state.
		if self:IsValidCell(startCell) == false then
			log_error("[BattleWave] enemy spawn rejected side=" .. side .. " reason=NO_EMPTY_CELL")
			return nil
		end

		local unitId = "enemy_w" .. self.CurrentWave .. "_" .. side
		local entityName = "BattleEnemy_W" .. self.CurrentWave .. "_" .. side
		local position = self:GetCellPosition(startCell)
		local enemy = _SpawnService:SpawnByModelId(
			spawnDefinition.EnemyModelId,
			entityName,
			Vector3(position.x, position.y, 0),
			self.Entity
		)
		if isvalid(enemy) == false then
			log_error("[BattleWave] SpawnByModelId failed model=" .. spawnDefinition.EnemyModelId .. " unit=" .. unitId)
			return nil
		end

		self:ConfigureUnit(enemy, unitId, "Enemy", startCell, facing, spawnDefinition.MaxHp, spawnOrder)
		local enemyUnit = enemy:GetComponent("script.BattleUnitComponent")
		if enemyUnit ~= nil then
			enemyUnit.EnemyDefinitionId = spawnDefinition.EnemyDefinitionId
			enemyUnit.BasicAttackDamage = spawnDefinition.BasicAttackDamage
			enemyUnit.EnemyPatternId = spawnDefinition.PatternId
			enemyUnit.EnemyMovementPolicy = spawnDefinition.MovementPolicy
			log("[EnemyData] applied unit=" .. unitId .. " definition=" .. enemyUnit.EnemyDefinitionId .. " hp=" .. enemyUnit.MaxHp .. " attack=" .. enemyUnit.BasicAttackDamage .. " pattern=" .. enemyUnit.EnemyPatternId .. " movement=" .. enemyUnit.EnemyMovementPolicy .. " roll=" .. spawnDefinition.SelectionRoll .. "/" .. spawnDefinition.TotalWeight)
		end
		return enemy
	end

	@ExecSpace("ServerOnly")
	method integer FindAvailableSpawnCell(integer preferredCell, integer searchDirection)
		-- Finds an empty cell from the requested board edge so a surviving player is never overlapped.
		local direction = searchDirection
		if direction ~= -1 then
			direction = 1
		end
		for offset = 0, self.CellCount - 1 do
			local cell = preferredCell + (offset * direction)
			if self:IsValidCell(cell) and self.BoardState:FindAtCell(cell, "") == nil then
				return cell
			end
		end
		return -1
	end

	@ExecSpace("ServerOnly")
	method void CleanupRegisteredEnemies(string reason)
		-- Unregisters and destroys only runtime enemy entities while preserving the stage player.
		if self.BoardState == nil then
			return
		end

		local registeredUnits = self.BoardState:CollectRegisteredUnits()
		for _, unitEntity in ipairs(registeredUnits) do
			local unit = unitEntity:GetComponent("script.BattleUnitComponent")
			if unit ~= nil and unit.Team == "Enemy" then
				self.BoardState:UnregisterUnit(unit.UnitId)
				if isvalid(unitEntity) then
					_EntityService:Destroy(unitEntity)
				end
			end
		end
		self.EnemyEntity = nil
		log("[BattleWave] enemies cleaned reason=" .. reason)
	end

	@ExecSpace("ServerOnly")
	method void CleanupDefeatedEnemies(string reason)
		-- Removes dead enemies only so forced waves can overlap with survivors from earlier waves.
		if self.BoardState == nil then
			return
		end
		local removedCount = 0
		local registeredUnits = self.BoardState:CollectRegisteredUnits()
		for _, unitEntity in ipairs(registeredUnits) do
			local unit = unitEntity:GetComponent("script.BattleUnitComponent")
			if unit ~= nil and unit.Team == "Enemy" and unit.IsDead == true then
				self.BoardState:UnregisterUnit(unit.UnitId)
				if isvalid(unitEntity) then
					_EntityService:Destroy(unitEntity)
				end
				removedCount = removedCount + 1
			end
		end
		log("[BattleWave] defeated enemies cleaned reason=" .. reason .. " count=" .. removedCount)
	end

	@ExecSpace("ServerOnly")
	method void RegisterPlayer(Entity player)
		-- Initializes one player as the controllable logical battle unit.
		if player == nil or player.PlayerComponent == nil then
			return
		end

		if self.PlayerEntity ~= nil and self.PlayerEntity == player then
			return
		end

		local previousRunSeed = self.RunSeed
		self.PlayerEntity = player
		local runState = _RunManagerLogic:EnsureRunState(player, self.RunSeed)
		if runState ~= nil then
			self.RunSeed = runState.RunSeed
			log("[BattleRun] context synced sequence=" .. runState.RunSequence .. " seed=" .. self.RunSeed .. " state=" .. runState.RunState)
		end
		if player.PlayerControllerComponent ~= nil then
			player.PlayerControllerComponent.Enable = false
		end

		if player.MovementComponent ~= nil then
			player.MovementComponent:Stop()
		end

		self:ConfigureUnit(player, "player_01", "Player", self.PlayerStartCell, "Right", 100, 1)
		if self.CurrentWave > 0 and previousRunSeed ~= self.RunSeed then
			log("[BattleRun] rebuilding for restored seed previous=" .. previousRunSeed .. " current=" .. self.RunSeed)
			self:RebuildBattleState("RUN_CONTEXT_SYNC")
		end
	end

	@ExecSpace("ServerOnly")
	method any EnsureBoardStateComponent()
		-- Prefers the dedicated map child so each runtime-state entity owns one script component.
		local boardState = self.Entity:GetComponent("script.BoardStateComponent")
		local stateEntity = self.Entity:GetChildByName("BattleBoardState")
		if stateEntity ~= nil then
			boardState = stateEntity:GetComponent("script.BoardStateComponent")
		end
		if boardState == nil then
			boardState = self.Entity:AddComponent("BoardStateComponent")
		end
		if boardState == nil then
			log_error("[BattleSession] failed to attach BoardStateComponent entity=" .. self.Entity.Name)
			return nil
		end
		self.BoardState = boardState
		return boardState
	end

	@ExecSpace("ServerOnly")
	method any EnsureTurnStateComponent()
		-- BattleTurnComponent is the single mutable owner of turn, action-slot, and skill-queue state.
		local turnState = self.Entity:GetComponent("script.BattleTurnComponent")
		local stateEntity = self.Entity:GetChildByName("BattleTurnState")
		if stateEntity ~= nil then
			turnState = stateEntity:GetComponent("script.BattleTurnComponent")
		end
		if turnState == nil then
			turnState = self.Entity:AddComponent("BattleTurnComponent")
		end
		if turnState == nil then
			log_error("[BattleSession] failed to attach BattleTurnComponent entity=" .. self.Entity.Name)
			return nil
		end
		self.TurnState = turnState
		return turnState
	end

	@ExecSpace("ServerOnly")
	method void PublishTurnStateSnapshot(string reason)
		-- Temporary compatibility bridge: external readers may keep using BattleSession while the owner is BattleTurnComponent.
		local turnState = self.TurnState
		if turnState == nil then
			turnState = self:EnsureTurnStateComponent()
		end
		if turnState == nil then
			return
		end
		self.BattlePhase = turnState.BattlePhase
		self.TurnNumber = turnState.TurnNumber
		self.QueuedActionType = turnState.QueuedActionType
		self.QueuedActionDirection = turnState.QueuedActionDirection
		self.IsActionProcessing = turnState.IsActionProcessing
		self.QueuedTileIds = turnState.QueuedTileIds
		self.QueuedTileCount = turnState.QueuedTileCount
		self.ExecutingTileIds = turnState.ExecutingTileIds
		self.ExecutingTileIndex = turnState.ExecutingTileIndex
		self.TileQueueCapacity = turnState.TileQueueCapacity
		if reason ~= "" then
			log("[BattleSession] turn snapshot reason=" .. reason .. " phase=" .. self.BattlePhase .. " turn=" .. self.TurnNumber .. " queue=" .. self.QueuedTileCount .. "/" .. self.TileQueueCapacity)
		end
	end

	@ExecSpace("ServerOnly")
	method any EnsureWaveStateComponent()
		-- Prefers the dedicated map child so Wave state and Timer lifetime stay isolated from Session.
		local waveRuntime = self.Entity:GetComponent("script.BattleWaveComponent")
		local stateEntity = self.Entity:GetChildByName("BattleWaveState")
		if stateEntity ~= nil then
			waveRuntime = stateEntity:GetComponent("script.BattleWaveComponent")
		end
		if waveRuntime == nil then
			waveRuntime = self.Entity:AddComponent("BattleWaveComponent")
		end
		if waveRuntime == nil then
			log_error("[BattleSession] failed to attach BattleWaveComponent entity=" .. self.Entity.Name)
			return nil
		end
		self.WaveRuntime = waveRuntime
		return waveRuntime
	end

	@ExecSpace("ServerOnly")
	method void PublishWaveStateSnapshot(string reason)
		-- Temporary compatibility bridge for existing HUD and external Snapshot consumers.
		local waveRuntime = self.WaveRuntime
		if waveRuntime == nil then
			waveRuntime = self:EnsureWaveStateComponent()
		end
		if waveRuntime == nil then
			return
		end
		self.CurrentWave = waveRuntime.CurrentWave
		self.TotalWaves = waveRuntime.TotalWaves
		self.WaveState = waveRuntime.WaveState
		self.WaveSpawnStageTurn = waveRuntime.WaveSpawnStageTurn
		self.CurrentWaveSpawnMode = waveRuntime.CurrentWaveSpawnMode
		self.ForceAfterTurns = waveRuntime.ForceAfterTurns
		self.ForceAfterSeconds = waveRuntime.ForceAfterSeconds
		self.ForceSpawnPending = waveRuntime.ForceSpawnPending
		self.ForceSpawnPendingReason = waveRuntime.ForceSpawnPendingReason
		self.CurrentWaveSpawnCount = waveRuntime.CurrentWaveSpawnCount
		self.MaxConcurrentEnemies = waveRuntime.MaxConcurrentEnemies
		self.CurrentClearSpawnDelay = waveRuntime.CurrentClearSpawnDelay
		if reason ~= "" then
			log("[BattleSession] wave snapshot reason=" .. reason .. " wave=" .. self.CurrentWave .. "/" .. self.TotalWaves .. " state=" .. self.WaveState .. " pending=" .. tostring(self.ForceSpawnPending))
		end
	end

	@ExecSpace("ServerOnly")
	method any EnsureUnitComponent(Entity targetEntity)
		-- Returns the target's BattleUnitComponent, attaching it at runtime when necessary.
		local unit = targetEntity:GetComponent("script.BattleUnitComponent")
		if unit == nil then
			unit = targetEntity:AddComponent("BattleUnitComponent")
		end

		if unit == nil then
			log_error("[BattleSession] failed to attach BattleUnitComponent entity=" .. targetEntity.Name)
		end
		return unit
	end

	@ExecSpace("ServerOnly")
	method any EnsurePresentationComponent(Entity targetEntity)
		-- Attaches optional visual behavior to runtime-created players while preserving placed enemy settings.
		local presentation = targetEntity:GetComponent("script.BattleUnitPresentationComponent")
		if presentation == nil then
			presentation = targetEntity:AddComponent("BattleUnitPresentationComponent")
		end

		if presentation == nil then
			log_error("[BattleSession] failed to attach BattleUnitPresentationComponent entity=" .. targetEntity.Name)
		end
		return presentation
	end

	@ExecSpace("ServerOnly")
	method any EnsureSkillRuntimeStateComponent(Entity targetEntity)
		-- Keeps mutable cooldowns on their owning unit rather than the map session.
		local runtimeState = targetEntity:GetComponent("script.SkillRuntimeStateComponent")
		if runtimeState == nil then
			runtimeState = targetEntity:AddComponent("SkillRuntimeStateComponent")
		end
		if runtimeState == nil then
			log_error("[BattleSession] failed to attach SkillRuntimeStateComponent entity=" .. targetEntity.Name)
		end
		return runtimeState
	end

	@ExecSpace("ServerOnly")
	method void ConfigureUnit(Entity targetEntity, string unitId, string team, integer cellIndex, string facing, number maxHp, integer spawnOrder)
		-- Writes the initial logical state and places the entity at its cell position.
		if self:IsValidCell(cellIndex) == false then
			log_error("[BattleSession] invalid initial cell=" .. cellIndex .. " unit=" .. unitId)
			return
		end

		local unit = self:EnsureUnitComponent(targetEntity)
		if unit == nil then
			return
		end
		self:EnsurePresentationComponent(targetEntity)
		local skillRuntimeState = self:EnsureSkillRuntimeStateComponent(targetEntity)
		if skillRuntimeState == nil then
			return
		end
		skillRuntimeState:ResetSkillRuntimeState("UNIT_CONFIGURED")

		unit.UnitId = unitId
		unit.Team = team
		unit.SpawnOrder = spawnOrder
		unit.CellIndex = cellIndex
		unit.Facing = facing
		unit.MaxHp = maxHp
		unit.CurrentHp = maxHp
		unit.IsDead = false
		self:ApplyFacing(targetEntity, facing)

		local position = self:GetCellPosition(cellIndex)
		self:PlaceEntity(targetEntity, position)
		if team == "Player" and targetEntity.PlayerComponent ~= nil then
			self:LockBoardCamera(self:GetBoardCenterX(), targetEntity.PlayerComponent.UserId)
		end
		if self.BoardState == nil then
			log_error("[BattleSession] registry missing during configure unit=" .. unitId)
			return
		end
		local registerResult = self.BoardState:RegisterUnit(targetEntity)
		if registerResult.Success == false then
			log_error("[BattleSession] registry rejected unit=" .. unitId .. " reason=" .. registerResult.Reason)
			return
		end
		log("[BattleSession] unit registered id=" .. unitId .. " team=" .. team .. " cell=" .. cellIndex .. " spawnOrder=" .. spawnOrder .. " x=" .. position.x)
	end

	@ExecSpace("Server")
	method void RequestTurn()
		-- Validates the requesting client before forwarding the turn request.
		if isvalid(self.PlayerEntity) == false or self.PlayerEntity.PlayerComponent == nil then
			log_warning("[BattleTurn] rejected reason=PLAYER_MISSING")
			return
		end

		if self.PlayerEntity.PlayerComponent.UserId ~= senderUserId then
			log_warning("[BattleTurn] rejected reason=INVALID_SENDER")
			return
		end

		local result = self:TryQueuePlayerAction("TURN", 0)
		if result.Success == false then
			log_warning("[BattleQueue] rejected action=TURN reason=" .. result.Reason)
		end
	end

	@ExecSpace("ServerOnly")
	method table TryQueuePlayerAction(string actionType, integer direction)
		-- Accepts at most one player action and keeps the slot occupied until presentation time ends.
		local result = { Success = false, Reason = "UNKNOWN" }

		if actionType ~= "MOVE" and actionType ~= "TURN" and actionType ~= "BASIC_ATTACK" and actionType ~= "HEAVY_SLASH" then
			result.Reason = "INVALID_ACTION"
			return result
		end

		if actionType == "MOVE" and direction ~= -1 and direction ~= 1 then
			result.Reason = "INVALID_DIRECTION"
			return result
		end

		result = self.TurnState:TryReserveImmediateAction(actionType, direction)
		if result.Success == false then
			return result
		end
		self:PublishTurnStateSnapshot("IMMEDIATE_ACTION_QUEUED")
		log("[BattleQueue] queued action=" .. actionType .. " direction=" .. direction)
		self:ExecuteQueuedAction()
		return result
	end

	@ExecSpace("ServerOnly")
	method void ExecuteQueuedAction()
		-- Dispatches the queued action through the existing authoritative action functions.
		local actionType = self.TurnState.QueuedActionType
		local direction = self.TurnState.QueuedActionDirection
		if actionType == "" then
			return
		end

		log("[BattleQueue] started action=" .. actionType .. " direction=" .. direction)

		local actionResult = nil
		if actionType == "MOVE" then
			actionResult = self:TryMove("player_01", direction)
		elseif actionType == "TURN" then
			actionResult = self:TryTurn("player_01")
		elseif actionType == "BASIC_ATTACK" then
			actionResult = self:TryBasicAttack("player_01")
		elseif actionType == "HEAVY_SLASH" then
			actionResult = self:TryHeavySlash("player_01")
		end

		if actionResult == nil or actionResult.Success == false then
			local reason = "EXECUTION_FAILED"
			if actionResult ~= nil then
				reason = actionResult.Reason
			end
			self:CompleteQueuedAction(actionType, false, reason)
			return
		end

		local duration = self:GetActionDuration(actionType)
		local complete = function()
			self:CompleteQueuedAction(actionType, true, actionResult.Reason)
		end
		self.ActionTimerId = _TimerService:SetTimerOnce(complete, duration)
	end

	@ExecSpace("ServerOnly")
	method number GetActionDuration(string actionType)
		if actionType == "MOVE" then
			return math.max(0.05, self.MoveActionDuration)
		elseif actionType == "TURN" then
			return math.max(0.05, self.TurnActionDuration)
		elseif actionType == "BASIC_ATTACK" then
			return math.max(0.1, self.BasicAttackActionDuration)
		elseif actionType == "HEAVY_SLASH" then
			return math.max(0.1, self.HeavySlashActionDuration)
		elseif actionType == "PUSH" then
			return math.max(0.1, self.PushActionDuration)
		end

		return 0.05
	end

	@ExecSpace("ServerOnly")
	method void CompleteQueuedAction(string actionType, boolean success, string reason)
		-- A valid player action hands control to the enemy; invalid actions release input immediately.
		self.ActionTimerId = 0
		self.TurnState:CompleteImmediateAction(reason)
		self:PublishTurnStateSnapshot("IMMEDIATE_ACTION_COMPLETED")
		log("[BattleQueue] completed action=" .. actionType .. " success=" .. tostring(success) .. " reason=" .. reason)
		if self.BattleResult ~= "" then
			return
		end

		if success == true then
			self:BeginEnemyTurn()
			return
		end

	end

	@ExecSpace("ServerOnly")
	method void BeginEnemyTurn()
		-- Executes the intent that stayed visible and immutable throughout the player turn.
		if self.PreparedEnemyIntentState ~= "PREPARED" then
			log_warning("[BattleEnemyIntent] missing before enemy turn; preparing fallback turn=" .. self.TurnNumber)
			self.LastEnemySpawnOrder = 0
			self:PrepareNextEnemyIntent()
		end

		self.TurnState:BeginEnemyTurn("ENEMY_" .. self.PreparedEnemyActionType, self.PreparedEnemyDirection, "PREPARED_INTENT")
		self:PublishTurnStateSnapshot("ENEMY_TURN_BEGIN")
		log("[BattleEnemyIntent] hold enemy=" .. self.PreparedEnemyId .. " pattern=" .. self.PreparedEnemyPatternId .. " step=" .. self.PreparedEnemyStepIndex .. " action=" .. self.PreparedEnemyActionType .. " tile=" .. self.PreparedEnemyTileId .. " turn=" .. self.PreparedEnemyTurn)
		log("[BattleTurnFlow] phase=EnemyTurn turn=" .. self.TurnNumber)

		local execute = function()
			self:ExecutePreparedEnemyIntent()
		end
		self.ActionTimerId = _TimerService:SetTimerOnce(execute, math.max(0.05, self.EnemyThinkDuration))
	end

	@ExecSpace("ServerOnly")
	method table BuildEnemyIntent(string enemyUnitId)
		-- Builds one prototype PatternStep while keeping tracking and fixed-facing movement semantics separate.
		local intent = {
			ActionType = "WAIT",
			TileId = "",
			Direction = 0,
			Reason = "UNIT_MISSING",
			PatternId = "",
			StepIndex = 1
		}

		local playerEntity = self:FindUnitEntity("player_01")
		local enemyEntity = self:FindUnitEntity(enemyUnitId)
		if isvalid(playerEntity) == false or isvalid(enemyEntity) == false then
			return intent
		end

		local player = playerEntity:GetComponent("script.BattleUnitComponent")
		local enemy = enemyEntity:GetComponent("script.BattleUnitComponent")
		if player == nil or enemy == nil or player.IsDead == true or enemy.IsDead == true then
			intent.Reason = "UNIT_UNAVAILABLE"
			return intent
		end
		intent.PatternId = enemy.EnemyPatternId
		local movementPolicy = enemy.EnemyMovementPolicy

		local cellDelta = player.CellIndex - enemy.CellIndex
		if cellDelta == 0 then
			intent.Reason = "SAME_CELL"
			return intent
		end

		local playerDirection = 1
		if cellDelta < 0 then
			playerDirection = -1
		end

		if movementPolicy == "FIXED_FACING" then
			local fixedDirection = self:GetFacingDirection(enemy.Facing)
			local frontCell = enemy.CellIndex + fixedDirection
			if math.abs(cellDelta) == 1 and player.CellIndex == frontCell then
				intent.ActionType = "EXECUTE_TILE"
				intent.TileId = "basic_slash"
				intent.Reason = "PLAYER_ADJACENT_IN_FRONT"
			else
				intent.ActionType = "MOVE_FIXED_FACING"
				intent.Direction = fixedDirection
				intent.Reason = "ADVANCE_FIXED_FACING"
			end
			return intent
		end

		if movementPolicy ~= "TRACK_PLAYER" then
			intent.Reason = "INVALID_MOVEMENT_POLICY"
			log_warning("[BattleEnemyIntent] invalid movement policy=" .. movementPolicy .. " enemy=" .. enemyUnitId)
			return intent
		end

		if self:GetFacingDirection(enemy.Facing) ~= playerDirection then
			intent.ActionType = "TURN_TO_PLAYER"
			intent.Direction = playerDirection
			intent.Reason = "PLAYER_SIDE_CHANGED"
			return intent
		end

		if math.abs(cellDelta) == 1 then
			intent.ActionType = "EXECUTE_TILE"
			intent.TileId = "basic_slash"
			intent.Reason = "PLAYER_ADJACENT_IN_FRONT"
			return intent
		end

		intent.ActionType = "MOVE_TOWARD"
		intent.Direction = playerDirection
		intent.Reason = "APPROACH_PLAYER"
		return intent
	end

	@ExecSpace("ServerOnly")
	method table PrepareEnemyIntent()
		-- Starts a new enemy round by selecting the first living enemy in stable SpawnOrder.
		self.LastEnemySpawnOrder = 0
		return self:PrepareNextEnemyIntent()
	end

	@ExecSpace("ServerOnly")
	method table PrepareNextEnemyIntent()
		-- Selects the next living enemy whose SpawnOrder follows the last completed enemy.
		local result = {
			Success = false,
			Reason = "UNKNOWN"
		}

		if self.BattleResult ~= "" then
			result.Reason = "BATTLE_ENDED"
			return result
		end
		if self.PreparedEnemyIntentState ~= "EMPTY" then
			result.Reason = "INTENT_ALREADY_PREPARED"
			return result
		end

		if self.BoardState == nil then
			result.Reason = "REGISTRY_MISSING"
			return result
		end
		local livingEnemies = self.BoardState:CollectLivingEnemies()
		local selectedUnitId = ""
		for _, enemyEntity in ipairs(livingEnemies) do
			local enemyUnit = enemyEntity:GetComponent("script.BattleUnitComponent")
			if enemyUnit ~= nil and enemyUnit.SpawnOrder > self.LastEnemySpawnOrder then
				selectedUnitId = enemyUnit.UnitId
				break
			end
		end
		if selectedUnitId == "" then
			result.Reason = "NO_NEXT_LIVING_ENEMY"
			return result
		end

		return self:PrepareEnemyIntentForUnit(selectedUnitId)
	end

	@ExecSpace("ServerOnly")
	method table PrepareEnemyIntentForUnit(string enemyUnitId)
		-- Converts one enemy's prototype PatternStep into the synchronized read-only runtime snapshot.
		local result = {
			Success = false,
			Reason = "UNKNOWN"
		}
		if self.BattleResult ~= "" then
			result.Reason = "BATTLE_ENDED"
			return result
		end
		if self.PreparedEnemyIntentState ~= "EMPTY" then
			result.Reason = "INTENT_ALREADY_PREPARED"
			return result
		end

		local intent = self:BuildEnemyIntent(enemyUnitId)
		self.PreparedEnemyIntentState = "PREPARED"
		self.PreparedEnemyId = enemyUnitId
		self.PreparedEnemyPatternId = intent.PatternId
		self.PreparedEnemyStepIndex = intent.StepIndex
		self.PreparedEnemyActionType = intent.ActionType
		self.PreparedEnemyTileId = intent.TileId
		self.PreparedEnemyDirection = intent.Direction
		self.PreparedEnemyTurn = self.TurnNumber
		self.PreparedEnemyReason = intent.Reason

		result.Success = true
		result.Reason = "PREPARED"
		local preparedMovementPolicy = ""
		local preparedEnemyEntity = self:FindUnitEntity(self.PreparedEnemyId)
		if isvalid(preparedEnemyEntity) then
			local preparedEnemyUnit = preparedEnemyEntity:GetComponent("script.BattleUnitComponent")
			if preparedEnemyUnit ~= nil then
				preparedMovementPolicy = preparedEnemyUnit.EnemyMovementPolicy
			end
		end
		log("[BattleEnemyIntent] prepare enemy=" .. self.PreparedEnemyId .. " pattern=" .. self.PreparedEnemyPatternId .. " step=" .. self.PreparedEnemyStepIndex .. " action=" .. self.PreparedEnemyActionType .. " tile=" .. self.PreparedEnemyTileId .. " direction=" .. self.PreparedEnemyDirection .. " turn=" .. self.PreparedEnemyTurn .. " policy=" .. preparedMovementPolicy .. " reason=" .. self.PreparedEnemyReason)
		return result
	end

	@ExecSpace("ServerOnly")
	method table GetPreparedEnemyIntent()
		-- Returns a copy so callers cannot mutate the synchronized snapshot fields.
		return {
			State = self.PreparedEnemyIntentState,
			EnemyId = self.PreparedEnemyId,
			PatternId = self.PreparedEnemyPatternId,
			StepIndex = self.PreparedEnemyStepIndex,
			ActionType = self.PreparedEnemyActionType,
			TileId = self.PreparedEnemyTileId,
			Direction = self.PreparedEnemyDirection,
			PreparedTurn = self.PreparedEnemyTurn,
			Reason = self.PreparedEnemyReason
		}
	end

	@ExecSpace("ServerOnly")
	method void ExecutePreparedEnemyIntent()
		-- Reuses the authoritative action paths without rebuilding the prepared PatternStep.
		self.ActionTimerId = 0
		if self.PreparedEnemyIntentState ~= "PREPARED" then
			log_error("[BattleEnemyIntent] execute rejected state=" .. self.PreparedEnemyIntentState)
			self:CompleteEnemyTurn("WAIT", false, "INTENT_NOT_PREPARED")
			return
		end

		local intent = self:GetPreparedEnemyIntent()
		self.PreparedEnemyIntentState = "EXECUTING"
		self.TurnState:UpdateEnemyAction("ENEMY_" .. intent.ActionType, intent.Direction)
		self:PublishTurnStateSnapshot("ENEMY_ACTION")
		log("[BattleEnemyIntent] execute enemy=" .. intent.EnemyId .. " pattern=" .. intent.PatternId .. " step=" .. intent.StepIndex .. " action=" .. intent.ActionType .. " tile=" .. intent.TileId .. " preparedTurn=" .. intent.PreparedTurn .. " currentTurn=" .. self.TurnNumber)

		local actionResult = nil
		if intent.ActionType == "MOVE_TOWARD" then
			actionResult = self:TryMove(intent.EnemyId, intent.Direction)
		elseif intent.ActionType == "MOVE_FIXED_FACING" then
			actionResult = self:TryMove(intent.EnemyId, intent.Direction)
			if actionResult.Success == false and (actionResult.Reason == "OUT_OF_BOUNDS" or actionResult.Reason == "CELL_OCCUPIED") then
				log("[BattleEnemyIntent] fixed move blocked; wait enemy=" .. intent.EnemyId .. " direction=" .. intent.Direction .. " reason=" .. actionResult.Reason)
				actionResult = {
					Success = true,
					Reason = "WAIT_" .. actionResult.Reason
				}
				self.TurnState:UpdateEnemyAction("ENEMY_WAIT", 0)
				self:PublishTurnStateSnapshot("ENEMY_WAIT")
			end
		elseif intent.ActionType == "TURN_TO_PLAYER" then
			actionResult = self:TryFaceDirection(intent.EnemyId, intent.Direction)
		elseif intent.ActionType == "EXECUTE_TILE" and intent.TileId == "basic_slash" then
			actionResult = self:TryBasicAttack(intent.EnemyId)
		else
			actionResult = { Success = true, Reason = intent.Reason }
		end

		local success = actionResult ~= nil and actionResult.Success == true
		local reason = "EXECUTION_FAILED"
		if actionResult ~= nil then
			reason = actionResult.Reason
		end

		local duration = self:GetEnemyActionDuration(intent.ActionType)
		local complete = function()
			self:CompletePreparedEnemyIntent(intent.EnemyId, intent.PatternId, intent.StepIndex, intent.ActionType, intent.TileId, success, reason)
		end
		self.ActionTimerId = _TimerService:SetTimerOnce(complete, duration)
	end

	@ExecSpace("ServerOnly")
	method number GetEnemyActionDuration(string actionType)
		-- Returns the presentation lock duration for each prepared enemy action meaning.
		if actionType == "MOVE_TOWARD" or actionType == "MOVE_FIXED_FACING" then
			return math.max(0.05, self.EnemyMoveActionDuration)
		elseif actionType == "TURN_TO_PLAYER" then
			return math.max(0.05, self.TurnActionDuration)
		elseif actionType == "EXECUTE_TILE" then
			return math.max(0.1, self.EnemyAttackActionDuration)
		end
		return 0.05
	end

	@ExecSpace("ServerOnly")
	method void CompletePreparedEnemyIntent(string enemyId, string patternId, integer stepIndex, string actionType, string tileId, boolean success, string reason)
		-- Completes one enemy snapshot, then advances to the next living enemy before ending the round.
		log("[BattleEnemyIntent] complete enemy=" .. enemyId .. " pattern=" .. patternId .. " step=" .. stepIndex .. " action=" .. actionType .. " tile=" .. tileId .. " success=" .. tostring(success) .. " reason=" .. reason)
		local completedEnemy = self:FindUnitEntity(enemyId)
		if isvalid(completedEnemy) then
			local completedUnit = completedEnemy:GetComponent("script.BattleUnitComponent")
			if completedUnit ~= nil then
				self.LastEnemySpawnOrder = completedUnit.SpawnOrder
			end
		end
		self:ClearPreparedEnemyIntent("COMPLETED")
		if self.BattleResult == "" then
			local nextResult = self:PrepareNextEnemyIntent()
			if nextResult.Success == true then
				log("[BattleEnemyIntent] advance next=" .. self.PreparedEnemyId .. " afterSpawnOrder=" .. self.LastEnemySpawnOrder)
				self:BeginEnemyTurn()
				return
			end
		end
		self:CompleteEnemyTurn(actionType, success, reason)
	end

	@ExecSpace("ServerOnly")
	method void ClearPreparedEnemyIntent(string reason)
		-- Clears the runtime snapshot without selecting the next PatternStep.
		if self.PreparedEnemyIntentState ~= "EMPTY" then
			log("[BattleEnemyIntent] clear enemy=" .. self.PreparedEnemyId .. " state=" .. self.PreparedEnemyIntentState .. " reason=" .. reason)
		end
		self.PreparedEnemyIntentState = "EMPTY"
		self.PreparedEnemyId = ""
		self.PreparedEnemyPatternId = ""
		self.PreparedEnemyStepIndex = 0
		self.PreparedEnemyActionType = ""
		self.PreparedEnemyTileId = ""
		self.PreparedEnemyDirection = 0
		self.PreparedEnemyTurn = 0
		self.PreparedEnemyReason = ""
	end

	@ExecSpace("ServerOnly")
	method void CompleteEnemyTurn(string actionType, boolean success, string reason)
		-- Ends the full ordered enemy round and reopens the next player turn.
		self.ActionTimerId = 0
		if self.BattleResult ~= "" then
			self.TurnState:ClearTransientState("BATTLE_ENDED")
			self:PublishTurnStateSnapshot("BATTLE_ENDED")
			log("[BattleEnemy] completed action=" .. actionType .. " success=" .. tostring(success) .. " reason=" .. reason .. " result=" .. self.BattleResult)
			return
		end

		self.TurnState:CompleteEnemyTurn("ENEMY_ROUND_COMPLETED")
		self:PublishTurnStateSnapshot("PLAYER_TURN_REOPENED")
		self.StageTurnNumber = self.TurnNumber
		self:AdvancePlayerSkillCooldowns("PLAYER_TURN_" .. self.TurnNumber)
		self.LastEnemySpawnOrder = 0
		self:EvaluateForcedSpawnAtTurnBoundary()
		log("[BattleEnemy] completed action=" .. actionType .. " success=" .. tostring(success) .. " reason=" .. reason)
		log("[BattleTurnFlow] phase=PlayerTurn turn=" .. self.TurnNumber .. " stageTurn=" .. self.StageTurnNumber .. " wave=" .. self.CurrentWave)
		self:PrepareEnemyIntent()
	end

	@ExecSpace("ServerOnly")
	method boolean IsTeamTurn(string team)
		if team == "Player" then
			return self.BattlePhase == "PlayerTurn"
		elseif team == "Enemy" then
			return self.BattlePhase == "EnemyTurn"
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method table TryTurn(string unitId)
		-- Reverses a living unit's logical and visual facing without moving cells.
		local result = {
			Success = false,
			Reason = "UNKNOWN",
			PreviousFacing = "",
			CurrentFacing = ""
		}

		local unitEntity = self:FindUnitEntity(unitId)
		if isvalid(unitEntity) == false then
			result.Reason = "UNIT_NOT_FOUND"
			return result
		end

		local unit = unitEntity:GetComponent("script.BattleUnitComponent")
		if unit == nil then
			result.Reason = "UNIT_COMPONENT_MISSING"
			return result
		end

		if self:IsTeamTurn(unit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end

		if unit.IsDead == true then
			result.Reason = "UNIT_DEAD"
			return result
		end

		result.PreviousFacing = unit.Facing
		if unit.Facing == "Right" then
			unit.Facing = "Left"
		else
			unit.Facing = "Right"
		end
		result.CurrentFacing = unit.Facing
		self:ApplyFacing(unitEntity, unit.Facing)

		local turnedEvent = UnitTurnedEvent()
		turnedEvent.UnitId = unit.UnitId
		turnedEvent.PreviousFacing = result.PreviousFacing
		turnedEvent.CurrentFacing = result.CurrentFacing
		self.Entity:SendEvent(turnedEvent)

		result.Success = true
		result.Reason = "OK"
		log("[BattleTurn] success unit=" .. unit.UnitId .. " from=" .. result.PreviousFacing .. " to=" .. result.CurrentFacing .. " cell=" .. unit.CellIndex)
		return result
	end

	@ExecSpace("ServerOnly")
	method table TryFaceDirection(string unitId, integer direction)
		-- Sets one living unit to an explicit prepared direction without deriving it again from the current target position.
		local result = {
			Success = false,
			Reason = "UNKNOWN",
			PreviousFacing = "",
			CurrentFacing = ""
		}

		if direction ~= -1 and direction ~= 1 then
			result.Reason = "INVALID_DIRECTION"
			return result
		end

		local unitEntity = self:FindUnitEntity(unitId)
		if isvalid(unitEntity) == false then
			result.Reason = "UNIT_NOT_FOUND"
			return result
		end

		local unit = unitEntity:GetComponent("script.BattleUnitComponent")
		if unit == nil then
			result.Reason = "UNIT_COMPONENT_MISSING"
			return result
		end
		if self:IsTeamTurn(unit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end
		if unit.IsDead == true then
			result.Reason = "UNIT_DEAD"
			return result
		end

		result.PreviousFacing = unit.Facing
		result.CurrentFacing = "Right"
		if direction < 0 then
			result.CurrentFacing = "Left"
		end

		if result.PreviousFacing == result.CurrentFacing then
			result.Success = true
			result.Reason = "ALREADY_FACING"
			log("[BattleTurn] kept unit=" .. unit.UnitId .. " facing=" .. result.CurrentFacing .. " cell=" .. unit.CellIndex)
			return result
		end

		unit.Facing = result.CurrentFacing
		self:ApplyFacing(unitEntity, unit.Facing)

		local turnedEvent = UnitTurnedEvent()
		turnedEvent.UnitId = unit.UnitId
		turnedEvent.PreviousFacing = result.PreviousFacing
		turnedEvent.CurrentFacing = result.CurrentFacing
		self.Entity:SendEvent(turnedEvent)

		result.Success = true
		result.Reason = "OK"
		log("[BattleTurn] success unit=" .. unit.UnitId .. " from=" .. result.PreviousFacing .. " to=" .. result.CurrentFacing .. " cell=" .. unit.CellIndex .. " source=PREPARED_DIRECTION")
		return result
	end

	method integer GetFacingDirection(string facing)
		-- Converts the logical facing string into a stable one-cell direction.
		if facing == "Right" then
			return 1
		end
		return -1
	end

	@ExecSpace("ServerOnly")
	method void ApplyFacing(Entity targetEntity, string facing)
		-- Uses the native player look direction so the three-layer avatar renderer turns correctly.
		if targetEntity.PlayerControllerComponent == nil then
			return
		end

		if facing == "Right" then
			targetEntity.PlayerControllerComponent.LookDirectionX = 1
		else
			targetEntity.PlayerControllerComponent.LookDirectionX = -1
		end
	end

	@ExecSpace("Server")
	method void RequestBasicAttack()
		-- Validates the requesting client before resolving a basic front-cell attack.
		if isvalid(self.PlayerEntity) == false or self.PlayerEntity.PlayerComponent == nil then
			log_warning("[BattleAttack] rejected reason=PLAYER_MISSING")
			return
		end

		if self.PlayerEntity.PlayerComponent.UserId ~= senderUserId then
			log_warning("[BattleAttack] rejected reason=INVALID_SENDER")
			return
		end

		local result = self:TryQueuePlayerAction("BASIC_ATTACK", 0)
		if result.Success == false then
			log_warning("[BattleQueue] rejected action=BASIC_ATTACK reason=" .. result.Reason)
		end
	end

	@ExecSpace("Server")
	method void RequestQueueTile(string tileId)
		-- Validates the requesting player before registering one supported tile in the queue slot.
		if self:IsValidPlayerRequest(senderUserId) == false then
			log_warning("[BattleTileQueue] register rejected tile=" .. tileId .. " reason=INVALID_SENDER")
			return
		end

		local result = self:TryQueueTile(tileId)
		if result.Success == false then
			log_warning("[BattleTileQueue] register rejected tile=" .. tileId .. " reason=" .. result.Reason)
		end
	end

	@ExecSpace("Server")
	method void RequestExecuteQueuedTile()
		-- Validates the requesting player before executing the registered tile.
		if self:IsValidPlayerRequest(senderUserId) == false then
			log_warning("[BattleTileQueue] execute rejected reason=INVALID_SENDER")
			return
		end

		local result = self:TryExecuteQueuedTile()
		if result.Success == false then
			log_warning("[BattleTileQueue] execute rejected reason=" .. result.Reason)
		end
	end

	@ExecSpace("Server")
	method void RequestClearQueuedTile()
		-- Validates the requesting player before clearing the registered tile.
		if self:IsValidPlayerRequest(senderUserId) == false then
			log_warning("[BattleTileQueue] clear rejected reason=INVALID_SENDER")
			return
		end

		local result = self:TryClearQueuedTile()
		if result.Success == false then
			log_warning("[BattleTileQueue] clear rejected reason=" .. result.Reason)
		end
	end

	@ExecSpace("ServerOnly")
	method boolean IsValidPlayerRequest(string requestingUserId)
		-- Confirms that a client request belongs to the registered solo player.
		if isvalid(self.PlayerEntity) == false or self.PlayerEntity.PlayerComponent == nil then
			return false
		end

		return self.PlayerEntity.PlayerComponent.UserId == requestingUserId
	end

	@ExecSpace("ServerOnly")
	method table TryQueueTile(string tileId)
		-- Appends one supported tile up to the configurable queue capacity.
		local result = {
			Success = false,
			Reason = "UNKNOWN",
			QueueIndex = -1,
			QueueCount = self.QueuedTileCount
		}

		local capacity = self.TurnState.TileQueueCapacity

		local skillValidation = _ContentValidatorLogic:ValidateSkillById(tileId)
		if skillValidation.Success == false then
			result.Reason = skillValidation.Reason
			result.DetailReason = skillValidation.DetailReason or ""
			return result
		end

		local runtimeState = self:GetSkillRuntimeState("player_01")
		if runtimeState == nil then
			result.Reason = "SKILL_RUNTIME_STATE_MISSING"
			return result
		end
		local cooldownResult = runtimeState:CanUseSkill(tileId)
		if cooldownResult.Success == false then
			result.Reason = cooldownResult.Reason
			result.RemainingTurns = cooldownResult.RemainingTurns
			return result
		end
		local definition = skillValidation.Data.Definition
		if definition.CooldownTurns > 0 and self.TurnState:QueueContainsSkill(self.TurnState.QueuedTileIds, tileId) then
			result.Reason = "COOLDOWN_RESERVED"
			result.RemainingTurns = definition.CooldownTurns
			return result
		end

		result = self.TurnState:TryAppendSkill(tileId)
		if result.Success == false then
			return result
		end
		self:PublishTurnStateSnapshot("SKILL_QUEUED")
		log("[BattleTileQueue] registered tile=" .. tileId .. " index=" .. result.QueueIndex .. " count=" .. result.QueueCount .. "/" .. capacity .. " turn=" .. self.TurnNumber)
		return result
	end

	@ExecSpace("ServerOnly")
	method table TryExecuteQueuedTile()
		-- Freezes the registered queue and starts an arbitrary-length sequential execution pass.
		local result = self.TurnState:TryFreezeSkillQueue()
		if result.Success == false then
			return result
		end
		self:PublishTurnStateSnapshot("SKILL_QUEUE_FROZEN")
		log("[BattleTileQueue] execution started count=" .. self:GetTileIdCount(self.ExecutingTileIds) .. " capacity=" .. self.TileQueueCapacity .. " turn=" .. self.TurnNumber)
		self:ExecuteNextQueuedTile()
		return result
	end

	@ExecSpace("ServerOnly")
	method void ExecuteNextQueuedTile()
		-- Resolves exactly one tile, then advances only after its action duration has completed.
		local tileCount = self.TurnState:GetTileIdCount(self.TurnState.ExecutingTileIds)
		if self.TurnState.ExecutingTileIndex <= 0 or self.TurnState.ExecutingTileIndex > tileCount then
			self:CompleteTileQueueExecution(true, "QUEUE_COMPLETE")
			return
		end

		local tileId = self.TurnState:GetTileIdAt(self.TurnState.ExecutingTileIds, self.TurnState.ExecutingTileIndex)
		local actionType = self:GetTileActionType(tileId)
		if actionType == "" then
			self:CompleteTileQueueExecution(false, "UNKNOWN_SKILL")
			return
		end

		self.TurnState:SetExecutingAction(actionType, 0)
		self:PublishTurnStateSnapshot("SKILL_EXECUTING")
		log("[BattleTileQueue] tile started index=" .. self.ExecutingTileIndex .. "/" .. tileCount .. " tile=" .. tileId .. " action=" .. actionType)

		local actionResult = nil
		if actionType == "EXECUTE_SKILL" then
			actionResult = self:TryExecuteSkill("player_01", tileId)
		end

		if actionResult == nil or actionResult.Success == false then
			local reason = "EXECUTION_FAILED"
			if actionResult ~= nil then
				reason = actionResult.Reason
			end
			self:CompleteTileQueueExecution(false, reason)
			return
		end

		local completedIndex = self.TurnState.ExecutingTileIndex
		local duration = self:GetSkillActionDuration(tileId)
		local complete = function()
			self.ActionTimerId = 0
			log("[BattleTileQueue] tile completed index=" .. completedIndex .. "/" .. tileCount .. " tile=" .. tileId .. " reason=" .. actionResult.Reason)
			if self.BattleResult ~= "" then
				self:CompleteTileQueueExecution(true, "BATTLE_ENDED")
				return
			end
			self.TurnState:AdvanceExecutingSkill()
			self:PublishTurnStateSnapshot("SKILL_ADVANCED")
			self:ExecuteNextQueuedTile()
		end
		self.ActionTimerId = _TimerService:SetTimerOnce(complete, duration)
	end

	@ExecSpace("ServerOnly")
	method void CompleteTileQueueExecution(boolean success, string reason)
		-- Clears execution state once, then hands control to the enemy only after the full queue succeeds.
		local executedCount = self.TurnState:GetTileIdCount(self.TurnState.ExecutingTileIds)
		self.ActionTimerId = 0
		self.TurnState:CompleteSkillQueue(reason)
		self:PublishTurnStateSnapshot("SKILL_QUEUE_COMPLETED")
		log("[BattleTileQueue] execution completed success=" .. tostring(success) .. " reason=" .. reason .. " count=" .. executedCount)

		if self.BattleResult ~= "" then
			return
		end
		if success then
			self:BeginEnemyTurn()
			return
		end
	end

	method string AppendTileId(string serializedQueue, string tileId)
		if serializedQueue == "" then
			return tileId
		end
		return serializedQueue .. "|" .. tileId
	end

	method boolean QueueContainsSkill(string serializedQueue, string skillId)
		for queuedSkillId in string.gmatch(serializedQueue, "([^|]+)") do
			if queuedSkillId == skillId then
				return true
			end
		end
		return false
	end

	method integer GetTileIdCount(string serializedQueue)
		if serializedQueue == "" then
			return 0
		end
		local count = 0
		for _ in string.gmatch(serializedQueue, "([^|]+)") do
			count = count + 1
		end
		return count
	end

	method string GetTileIdAt(string serializedQueue, integer targetIndex)
		if targetIndex <= 0 then
			return ""
		end
		local index = 0
		for tileId in string.gmatch(serializedQueue, "([^|]+)") do
			index = index + 1
			if index == targetIndex then
				return tileId
			end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method string GetTileActionType(string tileId)
		local validation = _ContentValidatorLogic:ValidateSkillById(tileId)
		if validation.Success == true then
			return "EXECUTE_SKILL"
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method number GetSkillActionDuration(string skillId)
		local validation = _ContentValidatorLogic:ValidateSkillById(skillId)
		if validation.Success == false then
			return 0.1
		end
		return math.max(0.1, validation.Data.Definition.ActionDuration)
	end

	@ExecSpace("ServerOnly")
	method table TryClearQueuedTile()
		-- Clears every registered tile only while the player still owns an idle input phase.
		local result = { Success = false, Reason = "UNKNOWN" }
		if self.TurnState.QueuedTileCount <= 0 or self.TurnState.QueuedTileIds == "" then
			result.Reason = "QUEUE_EMPTY"
			return result
		end

		local clearedCount = self.TurnState.QueuedTileCount
		result = self.TurnState:TryClearQueuedSkills()
		if result.Success == false then
			return result
		end
		self:PublishTurnStateSnapshot("SKILL_QUEUE_CLEARED")
		log("[BattleTileQueue] cleared count=" .. clearedCount .. " turn=" .. self.TurnNumber)
		return result
	end

	@ExecSpace("Server")
	method void RequestResetBattle()
		-- Accepts Reset only from the registered solo player after the battle has ended.
		if self:IsValidPlayerRequest(senderUserId) == false then
			log_warning("[BattleReset] rejected reason=INVALID_SENDER")
			return
		end

		local result = self:ResetBattle()
		if result.Success == false then
			log_warning("[BattleReset] rejected reason=" .. result.Reason)
		end
	end

	@ExecSpace("ServerOnly")
	method table ResetBattle()
		-- Restarts a completed battle while preserving the current run seed.
		local result = {
			Success = false,
			Reason = "UNKNOWN"
		}

		if self.BattleResult == "" then
			result.Reason = "BATTLE_NOT_ENDED"
			return result
		end
		return self:RebuildBattleState("RESET")
	end

	@ExecSpace("ServerOnly")
	method table StartNewRun(integer runSeed)
		-- Asks the player-owned run state to begin, then rebuilds this map-scoped battle.
		if isvalid(self.PlayerEntity) == false then
			return {
				Success = false,
				Reason = "PLAYER_MISSING"
			}
		end
		local runState = _RunManagerLogic:StartNewRun(self.PlayerEntity, runSeed)
		if runState == nil then
			return {
				Success = false,
				Reason = "RUN_STATE_UNAVAILABLE"
			}
		end
		self.RunSeed = runState.RunSeed
		log("[BattleRun] new run requested sequence=" .. runState.RunSequence .. " seed=" .. self.RunSeed)
		return self:RebuildBattleState("NEW_RUN")
	end

	@ExecSpace("ServerOnly")
	method table InitializeFromEntry(Entity playerEntity, string stageId, string characterId, string jobId, string loadoutId, integer runSeed, string entryMode, integer requestId)
		-- Public map-session initializer used only through BattleGatewayLogic.
		local result = {
			Success = false,
			Reason = "UNKNOWN",
			RequestId = requestId,
			StageId = stageId
		}
		if isvalid(playerEntity) == false or playerEntity.PlayerComponent == nil then
			result.Reason = "INVALID_PLAYER"
			return result
		end
		if stageId == nil or stageId == "" then
			result.Reason = "INVALID_STAGE_ID"
			return result
		end
		local stageValidation = _ContentValidatorLogic:ValidateStageById(stageId)
		if stageValidation.Success == false then
			result.Reason = stageValidation.Reason
			result.DetailReason = stageValidation.DetailReason or ""
			return result
		end
		if entryMode ~= "NEW_RUN" and entryMode ~= "CONTINUE_RUN" then
			result.Reason = "INVALID_ENTRY_MODE"
			return result
		end

		local runState = nil
		if entryMode == "NEW_RUN" then
			runState = _RunManagerLogic:StartNewRun(playerEntity, runSeed)
		else
			runState = _RunManagerLogic:EnsureRunState(playerEntity, runSeed)
		end
		if runState == nil then
			result.Reason = "RUN_STATE_UNAVAILABLE"
			return result
		end

		local stageNumberText = string.match(stageId, "%d+")
		local stageNumber = tonumber(stageNumberText) or runState.CurrentStageNumber
		self.StageNumber = math.max(1, stageNumber)
		local applyResult = self:LoadAndApplyStageDefinition(stageId)
		if applyResult.Success == false then
			result.Reason = applyResult.Reason
			result.DetailReason = applyResult.DetailReason or ""
			return result
		end
		self.RunSeed = runState.RunSeed
		self.EntryRequestId = requestId
		self.EntryMode = entryMode
		self.SelectedCharacterId = characterId or ""
		self.SelectedJobId = jobId or ""
		self.SelectedLoadoutId = loadoutId or ""
		self:RegisterPlayer(playerEntity)

		local rebuildResult = self:RebuildBattleState("BATTLE_ENTRY")
		result.Success = rebuildResult.Success
		result.Reason = rebuildResult.Reason
		log("[BattleSession] entry initialized request=" .. requestId .. " stage=" .. self.StageId .. " character=" .. self.SelectedCharacterId .. " job=" .. self.SelectedJobId .. " loadout=" .. self.SelectedLoadoutId .. " seed=" .. self.RunSeed .. " mode=" .. self.EntryMode .. " success=" .. tostring(result.Success))
		return result
	end

	@ExecSpace("ServerOnly")
	method table GetBattleSnapshot()
		-- Stable read model for server-side lobby, waiting, result, and flow controllers.
		local turnState = self:EnsureTurnStateComponent()
		local waveRuntime = self:EnsureWaveStateComponent()
		return {
			Success = true,
			Reason = "OK",
			EntryRequestId = self.EntryRequestId,
			EntryMode = self.EntryMode,
			StageId = self.StageId,
			StageDisplayName = self.StageDisplayName,
			WaveTableId = self.WaveTableId,
			NextStageId = self.NextStageId,
			StageRuleId = self.StageRuleId,
			StageSchemaVersion = self.StageSchemaVersion,
			StageNumber = self.StageNumber,
			RunSeed = self.RunSeed,
			CharacterId = self.SelectedCharacterId,
			JobId = self.SelectedJobId,
			LoadoutId = self.SelectedLoadoutId,
			BattlePhase = turnState.BattlePhase,
			BattleResult = self.BattleResult,
			TurnNumber = turnState.TurnNumber,
			CurrentWave = waveRuntime.CurrentWave,
			TotalWaves = waveRuntime.TotalWaves,
			CellCount = self.CellCount,
			PlayerStartCell = self.PlayerStartCell,
			QueueCapacity = turnState.TileQueueCapacity
		}
	end

	@ExecSpace("ServerOnly")
	method table RebuildBattleState(string reason)
		-- Clears transient battle state, then rebuilds the selected Stage through the normal spawn path.
		local result = {
			Success = false,
			Reason = "UNKNOWN"
		}

		if self.ActionTimerId > 0 then
			_TimerService:ClearTimer(self.ActionTimerId)
			self.ActionTimerId = 0
		end
		if self.ImpactTimerId > 0 then
			_TimerService:ClearTimer(self.ImpactTimerId)
			self.ImpactTimerId = 0
		end
		self.WaveRuntime:ClearAllTimers(reason)

		self.BattleResult = ""
		self.StageTurnNumber = 0
		self.TurnState:ResetTurnState(self.TileQueueCapacity, reason)
		self:PublishTurnStateSnapshot(reason)
		self.LastEnemySpawnOrder = 0
		self:ClearPreparedEnemyIntent(reason)

		local playerEntity = self:FindUnitEntity("player_01")
		if isvalid(playerEntity) == false then
			result.Reason = "PLAYER_MISSING"
			return result
		end
		self:CleanupRegisteredEnemies(reason)
		self.PlayerEntity = playerEntity
		self:ConfigureUnit(playerEntity, "player_01", "Player", self.PlayerStartCell, "Right", 100, 1)
		self:StartStageById(self.StageId, self.StageNumber)

		result.Success = true
		result.Reason = reason
		log("[BattleReset] completed reason=" .. reason .. " seed=" .. self.RunSeed .. " stage=" .. self.StageNumber .. " wave=" .. self.CurrentWave .. "/" .. self.TotalWaves .. " playerCell=" .. self.PlayerStartCell .. " enemyHp=" .. self.CurrentEnemyMaxHp)
		return result
	end

	@ExecSpace("ServerOnly")
	method table TryPush(string sourceUnitId)
		return self:TryExecuteSkill(sourceUnitId, "push")
	end

	@ExecSpace("ServerOnly")
	method table TryPushWithDefinition(string sourceUnitId, table definition, table effectStep)
		-- Starts the push presentation, then resolves board displacement at the configured impact frame.
		local result = {
			Success = false,
			Reason = "UNKNOWN",
			SourceUnitId = sourceUnitId
		}

		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		if isvalid(sourceEntity) == false then
			result.Reason = "SOURCE_NOT_FOUND"
			return result
		end

		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit == nil then
			result.Reason = "SOURCE_COMPONENT_MISSING"
			return result
		end
		if self:IsTeamTurn(sourceUnit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end
		if sourceUnit.IsDead == true then
			result.Reason = "SOURCE_DEAD"
			return result
		end

		local motionProfile = self:GetSkillMotionProfile(definition.MotionProfileId)
		local sourcePresentation = sourceEntity:GetComponent("script.BattleUnitPresentationComponent")
		if sourcePresentation ~= nil and sourceEntity.PlayerControllerComponent ~= nil then
			sourcePresentation:PlayCombatMotion(
				sourceUnitId,
				motionProfile.MotionKey,
				motionProfile.ActionName,
				motionProfile.PlayRate,
				motionProfile.Duration
			)
		end

		local safeImpactDelay = math.max(0, motionProfile.ImpactDelay)
		if safeImpactDelay <= 0 then
			return _EffectRouterLogic:ExecuteEffect(self, effectStep.EffectType, sourceUnitId, "", effectStep.Value)
		end
		if self.ImpactTimerId > 0 then
			_TimerService:ClearTimer(self.ImpactTimerId)
			self.ImpactTimerId = 0
		end

		local scheduledAt = _UtilLogic.ElapsedSeconds
		local resolveImpact = function()
			self.ImpactTimerId = 0
			local elapsed = _UtilLogic.ElapsedSeconds - scheduledAt
			log("[BattleImpact] triggered effect=PUSH elapsed=" .. tostring(elapsed))
			local impactResult = _EffectRouterLogic:ExecuteEffect(self, effectStep.EffectType, sourceUnitId, "", effectStep.Value)
			if impactResult.Success == false then
				log_warning("[BattlePush] failed source=" .. sourceUnitId .. " reason=" .. impactResult.Reason)
			end
		end
		self.ImpactTimerId = _TimerService:SetTimerOnce(resolveImpact, safeImpactDelay)

		result.Success = true
		result.Reason = "IMPACT_PENDING"
		log("[BattleImpact] scheduled effect=PUSH delay=" .. tostring(safeImpactDelay))
		return result
	end

	@ExecSpace("ServerOnly")
	method table ResolvePushImpact(string sourceUnitId)
		-- Re-resolves the front target and moves it one logical cell away from the source.
		local result = {
			Success = false,
			Hit = false,
			Reason = "UNKNOWN",
			SourceUnitId = sourceUnitId,
			TargetUnitId = "",
			TargetCell = -1,
			FromCell = -1,
			ToCell = -1
		}

		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		if isvalid(sourceEntity) == false then
			result.Reason = "SOURCE_NOT_FOUND"
			return result
		end
		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit == nil then
			result.Reason = "SOURCE_COMPONENT_MISSING"
			return result
		end
		if self:IsTeamTurn(sourceUnit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end
		if sourceUnit.IsDead == true then
			result.Reason = "SOURCE_DEAD"
			return result
		end

		local direction = -1
		if sourceUnit.Facing == "Right" then
			direction = 1
		end
		result.TargetCell = sourceUnit.CellIndex + direction
		local targetEntity = self:ResolveFrontTarget(sourceUnitId)
		if isvalid(targetEntity) == false then
			result.Success = true
			result.Reason = self:IsValidCell(result.TargetCell) and "MISS_EMPTY" or "MISS_OUT_OF_BOUNDS"
			log("[BattlePush] resolved source=" .. sourceUnitId .. " target= cell=" .. result.TargetCell .. " reason=" .. result.Reason)
			return result
		end

		local targetUnit = targetEntity:GetComponent("script.BattleUnitComponent")
		result.Hit = true
		result.TargetUnitId = targetUnit.UnitId
		result.FromCell = targetUnit.CellIndex
		result.ToCell = targetUnit.CellIndex + direction
		if self:IsValidCell(result.ToCell) == false then
			result.Success = true
			result.Reason = "PUSH_BLOCKED_OUT_OF_BOUNDS"
			log("[BattlePush] resolved source=" .. sourceUnitId .. " target=" .. result.TargetUnitId .. " from=" .. result.FromCell .. " to=" .. result.ToCell .. " reason=" .. result.Reason)
			return result
		end
		if self:IsCellOccupied(result.ToCell, targetUnit.UnitId) then
			result.Success = true
			result.Reason = "PUSH_BLOCKED_OCCUPIED"
			log("[BattlePush] resolved source=" .. sourceUnitId .. " target=" .. result.TargetUnitId .. " from=" .. result.FromCell .. " to=" .. result.ToCell .. " reason=" .. result.Reason)
			return result
		end

		targetUnit.CellIndex = result.ToCell
		self:PlaceEntity(targetEntity, self:GetCellPosition(result.ToCell))
		local movedEvent = UnitMovedEvent()
		movedEvent.UnitId = targetUnit.UnitId
		movedEvent.FromCell = result.FromCell
		movedEvent.ToCell = result.ToCell
		self.Entity:SendEvent(movedEvent)

		result.Success = true
		result.Reason = "PUSHED"
		log("[BattlePush] resolved source=" .. sourceUnitId .. " target=" .. result.TargetUnitId .. " from=" .. result.FromCell .. " to=" .. result.ToCell .. " reason=" .. result.Reason)
		return result
	end

	@ExecSpace("ServerOnly")
	method table TryBasicAttack(string sourceUnitId)
		return self:TryExecuteSkill(sourceUnitId, "basic_slash")
	end

	@ExecSpace("ServerOnly")
	method table TryHeavySlash(string sourceUnitId)
		return self:TryExecuteSkill(sourceUnitId, "heavy_slash")
	end

	@ExecSpace("ServerOnly")
	method table TryExecuteSkill(string sourceUnitId, string skillId)
		local validation = _ContentValidatorLogic:ValidateSkillById(skillId)
		if validation.Success == false then
			return {
				Success = false,
				Reason = validation.Reason,
				DetailReason = validation.DetailReason or "",
				SourceUnitId = sourceUnitId,
				SkillId = skillId
			}
		end

		local bundle = validation.Data
		local definition = bundle.Definition
		local effectSteps = bundle.EffectSteps
		local contextResult = _SkillExecutionLogic:BuildContext(self, sourceUnitId, skillId, definition)
		if contextResult.Success == false then
			return contextResult
		end

		local runtimeState = self:GetSkillRuntimeState(sourceUnitId)
		if runtimeState == nil then
			return {
				Success = false,
				Reason = "SKILL_RUNTIME_STATE_MISSING",
				SourceUnitId = sourceUnitId,
				SkillId = skillId
			}
		end
		local cooldownResult = runtimeState:CanUseSkill(skillId)
		if cooldownResult.Success == false then
			return {
				Success = false,
				Reason = cooldownResult.Reason,
				RemainingTurns = cooldownResult.RemainingTurns,
				SourceUnitId = sourceUnitId,
				SkillId = skillId
			}
		end
		runtimeState:StartCooldown(skillId, definition.CooldownTurns)

		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		local motionProfile = self:GetSkillMotionProfile(definition.MotionProfileId)
		local sourcePresentation = sourceEntity:GetComponent("script.BattleUnitPresentationComponent")
		if sourcePresentation ~= nil and sourceEntity.PlayerControllerComponent ~= nil then
			sourcePresentation:PlayCombatMotion(
				sourceUnitId,
				motionProfile.MotionKey,
				motionProfile.ActionName,
				motionProfile.PlayRate,
				motionProfile.Duration
			)
		end

		local context = contextResult.Data
		local safeImpactDelay = math.max(0, motionProfile.ImpactDelay)
		local resolveEffects = function()
			self.ImpactTimerId = 0
			local effectResult = _SkillExecutionLogic:ExecuteEffectSteps(context, effectSteps)
			if effectResult.Success == false then
				log_warning("[SkillExecution] failed skill=" .. skillId .. " source=" .. sourceUnitId .. " reason=" .. effectResult.Reason)
			end
		end
		if safeImpactDelay <= 0 then
			return _SkillExecutionLogic:ExecuteEffectSteps(context, effectSteps)
		end
		if self.ImpactTimerId > 0 then
			_TimerService:ClearTimer(self.ImpactTimerId)
			self.ImpactTimerId = 0
		end

		self.ImpactTimerId = _TimerService:SetTimerOnce(resolveEffects, safeImpactDelay)
		log("[SkillExecution] scheduled skill=" .. skillId .. " source=" .. sourceUnitId .. " steps=" .. #effectSteps .. " delay=" .. safeImpactDelay)
		return {
			Success = true,
			Reason = "IMPACT_PENDING",
			SourceUnitId = sourceUnitId,
			SkillId = skillId,
			StepCount = #effectSteps
		}
	end

	@ExecSpace("ServerOnly")
	method table GetSkillMotionProfile(string motionProfileId)
		if motionProfileId == "heavy_slash" then
			return {
				MotionKey = self.HeavySlashMotionKey,
				ActionName = self.HeavySlashActionName,
				PlayRate = self.HeavySlashMotionPlayRate,
				Duration = self.HeavySlashMotionDuration,
				ImpactDelay = self.HeavySlashImpactDelay
			}
		elseif motionProfileId == "push" then
			return {
				MotionKey = self.PushMotionKey,
				ActionName = self.PushActionName,
				PlayRate = self.PushMotionPlayRate,
				Duration = self.PushMotionDuration,
				ImpactDelay = self.PushImpactDelay
			}
		end
		return {
			MotionKey = self.BasicSlashMotionKey,
			ActionName = self.BasicSlashActionName,
			PlayRate = self.BasicSlashMotionPlayRate,
			Duration = self.BasicSlashMotionDuration,
			ImpactDelay = self.BasicSlashImpactDelay
		}
	end

	@ExecSpace("ServerOnly")
	method table TryFrontAttack(string sourceUnitId, string attackId, number damageAmount, string motionKey, string actionName, number motionPlayRate, number motionDuration, number impactDelay)
		-- Starts presentation immediately, then resolves the logical front-cell hit at the attack's impact frame.
		local result = {
			Success = false,
			Hit = false,
			Reason = "UNKNOWN",
			SourceUnitId = sourceUnitId,
			AttackId = attackId,
			TargetUnitId = "",
			TargetCell = -1,
			DamageAmount = 0,
			TargetHpBefore = -1,
			TargetHpAfter = -1
		}

		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		if isvalid(sourceEntity) == false then
			result.Reason = "SOURCE_NOT_FOUND"
			return result
		end

		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit == nil then
			result.Reason = "SOURCE_COMPONENT_MISSING"
			return result
		end

		if self:IsTeamTurn(sourceUnit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end

		if sourceUnit.IsDead == true then
			result.Reason = "SOURCE_DEAD"
			return result
		end

		local sourcePresentation = sourceEntity:GetComponent("script.BattleUnitPresentationComponent")
		if sourcePresentation ~= nil and sourceEntity.PlayerControllerComponent ~= nil then
			sourcePresentation:PlayCombatMotion(
				sourceUnitId,
				motionKey,
				actionName,
				motionPlayRate,
				motionDuration
			)
		end

		local safeImpactDelay = math.max(0, impactDelay)
		if safeImpactDelay <= 0 then
			return self:ResolveFrontAttackImpact(sourceUnitId, attackId, damageAmount)
		end

		if self.ImpactTimerId > 0 then
			_TimerService:ClearTimer(self.ImpactTimerId)
			self.ImpactTimerId = 0
		end

		local scheduledAt = _UtilLogic.ElapsedSeconds
		local resolveImpact = function()
			self.ImpactTimerId = 0
			local elapsed = _UtilLogic.ElapsedSeconds - scheduledAt
			log("[BattleImpact] triggered attack=" .. attackId .. " elapsed=" .. tostring(elapsed))
			local impactResult = self:ResolveFrontAttackImpact(sourceUnitId, attackId, damageAmount)
			if impactResult.Success == false then
				log_warning("[BattleImpact] failed attack=" .. attackId .. " reason=" .. impactResult.Reason)
			end
		end
		self.ImpactTimerId = _TimerService:SetTimerOnce(resolveImpact, safeImpactDelay)

		result.Success = true
		result.Reason = "IMPACT_PENDING"
		log("[BattleImpact] scheduled attack=" .. attackId .. " delay=" .. tostring(safeImpactDelay))
		return result
	end

	@ExecSpace("ServerOnly")
	method table ResolveFrontAttackImpact(string sourceUnitId, string attackId, number damageAmount)
		-- Re-reads the source cell and facing at impact time, so damage remains board-state based.
		local result = {
			Success = false,
			Hit = false,
			Reason = "UNKNOWN",
			SourceUnitId = sourceUnitId,
			AttackId = attackId,
			TargetUnitId = "",
			TargetCell = -1,
			DamageAmount = 0,
			TargetHpBefore = -1,
			TargetHpAfter = -1
		}

		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		if isvalid(sourceEntity) == false then
			result.Reason = "SOURCE_NOT_FOUND"
			return result
		end

		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit == nil then
			result.Reason = "SOURCE_COMPONENT_MISSING"
			return result
		end
		if self:IsTeamTurn(sourceUnit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end
		if sourceUnit.IsDead == true then
			result.Reason = "SOURCE_DEAD"
			return result
		end

		local facingDirection = -1
		if sourceUnit.Facing == "Right" then
			facingDirection = 1
		end
		result.TargetCell = sourceUnit.CellIndex + facingDirection

		local targetEntity = nil
		if self:IsValidCell(result.TargetCell) then
			targetEntity = self:ResolveFrontTarget(sourceUnitId)
		else
			result.Reason = "MISS_OUT_OF_BOUNDS"
		end

		if isvalid(targetEntity) then
			local targetUnit = targetEntity:GetComponent("script.BattleUnitComponent")
			local damageResult = _EffectRouterLogic:ExecuteEffect(self, "DAMAGE", sourceUnitId, targetUnit.UnitId, damageAmount)
			if damageResult.Success == false then
				result.Reason = "DAMAGE_FAILED_" .. damageResult.Reason
				log_error("[BattleAttack] damage failed source=" .. sourceUnitId .. " target=" .. targetUnit.UnitId .. " reason=" .. damageResult.Reason)
				return result
			end

			result.Hit = true
			result.Reason = "HIT"
			result.TargetUnitId = targetUnit.UnitId
			result.DamageAmount = damageResult.AppliedAmount
			result.TargetHpBefore = damageResult.HpBefore
			result.TargetHpAfter = damageResult.HpAfter
		elseif result.Reason == "UNKNOWN" then
			result.Reason = "MISS_EMPTY"
		end

		local attackEvent = BasicAttackResolvedEvent()
		attackEvent.SourceUnitId = result.SourceUnitId
		attackEvent.AttackId = result.AttackId
		attackEvent.TargetUnitId = result.TargetUnitId
		attackEvent.TargetCell = result.TargetCell
		attackEvent.Hit = result.Hit
		attackEvent.Reason = result.Reason
		attackEvent.DamageAmount = result.DamageAmount
		attackEvent.TargetHpBefore = result.TargetHpBefore
		attackEvent.TargetHpAfter = result.TargetHpAfter
		self.Entity:SendEvent(attackEvent)

		result.Success = true
		log("[BattleAttack] resolved attack=" .. result.AttackId .. " source=" .. result.SourceUnitId .. " facing=" .. sourceUnit.Facing .. " target=" .. result.TargetUnitId .. " cell=" .. result.TargetCell .. " hit=" .. tostring(result.Hit) .. " reason=" .. result.Reason .. " damage=" .. result.DamageAmount .. " hp=" .. result.TargetHpBefore .. "->" .. result.TargetHpAfter)
		return result
	end

	@ExecSpace("ServerOnly")
	method table ApplyDamage(string sourceUnitId, string targetUnitId, number amount)
		-- Owns the single HP mutation path and forwards the first zero-HP transition to death handling.
		local result = {
			Success = false,
			Reason = "UNKNOWN",
			AppliedAmount = 0,
			HpBefore = -1,
			HpAfter = -1
		}

		if amount <= 0 then
			result.Reason = "INVALID_AMOUNT"
			return result
		end

		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		local targetEntity = self:FindUnitEntity(targetUnitId)
		if isvalid(sourceEntity) == false then
			result.Reason = "SOURCE_NOT_FOUND"
			return result
		end
		if isvalid(targetEntity) == false then
			result.Reason = "TARGET_NOT_FOUND"
			return result
		end

		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		local targetUnit = targetEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit == nil or targetUnit == nil then
			result.Reason = "UNIT_COMPONENT_MISSING"
			return result
		end
		if sourceUnit.Team == targetUnit.Team then
			result.Reason = "SAME_TEAM"
			return result
		end
		if sourceUnit.IsDead == true or targetUnit.IsDead == true then
			result.Reason = "UNIT_DEAD"
			return result
		end

		result.HpBefore = targetUnit.CurrentHp
		result.HpAfter = math.max(0, result.HpBefore - amount)
		result.AppliedAmount = result.HpBefore - result.HpAfter
		targetUnit.CurrentHp = result.HpAfter
		if result.HpAfter <= 0 and targetUnit.IsDead == false then
			self:HandleUnitDied(targetUnitId, "DAMAGE")
		end

		local presentation = targetEntity:GetComponent("script.BattleUnitPresentationComponent")
		if presentation ~= nil and targetEntity.SpriteRendererComponent ~= nil then
			presentation:PlayHitFlash(targetUnitId)
		end

		result.Success = true
		result.Reason = "OK"
		log("[BattleDamage] applied source=" .. sourceUnitId .. " target=" .. targetUnitId .. " amount=" .. result.AppliedAmount .. " hp=" .. result.HpBefore .. "->" .. result.HpAfter)
		return result
	end

	@ExecSpace("ServerOnly")
	method void HandleUnitDied(string unitId, string cause)
		-- Marks one unit dead exactly once, advances finite waves, and clears the stage after the final wave.
		local unitEntity = self:FindUnitEntity(unitId)
		if isvalid(unitEntity) == false then
			log_error("[BattleDeath] failed unit=" .. unitId .. " reason=UNIT_NOT_FOUND")
			return
		end

		local unit = unitEntity:GetComponent("script.BattleUnitComponent")
		if unit == nil then
			log_error("[BattleDeath] failed unit=" .. unitId .. " reason=COMPONENT_MISSING")
			return
		end
		if unit.IsDead == true then
			log_warning("[BattleDeath] duplicate ignored unit=" .. unitId)
			return
		end

		unit.CurrentHp = math.max(0, unit.CurrentHp)
		unit.IsDead = true
		if unit.Team == "Enemy" and self.BoardState ~= nil then
			local livingEnemies = self.BoardState:CollectLivingEnemies()
			if #livingEnemies > 0 then
				log("[BattleDeath] unit=" .. unitId .. " cause=" .. cause .. " result=CONTINUE livingEnemies=" .. #livingEnemies)
				return
			end
		end
		self:ClearForcedSpawnSchedule("ALL_ENEMIES_DEFEATED")
		if self.ImpactTimerId > 0 then
			_TimerService:ClearTimer(self.ImpactTimerId)
			self.ImpactTimerId = 0
		end
		if self.ActionTimerId > 0 then
			_TimerService:ClearTimer(self.ActionTimerId)
			self.ActionTimerId = 0
		end
		self.TurnState:ClearTransientState("UNIT_DIED")
		self:PublishTurnStateSnapshot("UNIT_DIED")
		if unit.Team == "Enemy" then
			if self.CurrentWave < self.TotalWaves then
				self.TurnState:SetPhase("WaveTransition", "WAVE_CLEARED")
				self:PublishTurnStateSnapshot("WAVE_CLEARED")
				self:ClearPreparedEnemyIntent("WAVE_CLEARED")
				local clearedWave = self.CurrentWave
				local nextWave = clearedWave + 1
				self.WaveRuntime:ScheduleWaveTransition(clearedWave, nextWave, self.CurrentClearSpawnDelay)
				self:PublishWaveStateSnapshot("WAVE_CLEARED")
				log("[BattleWave] cleared stage=" .. self.StageNumber .. " wave=" .. clearedWave .. "/" .. self.TotalWaves .. " nextWave=" .. nextWave)
				return
			end

			self.TurnState:SetPhase("BattleEnded", "STAGE_CLEARED")
			self:PublishTurnStateSnapshot("STAGE_CLEARED")
			self.WaveRuntime:SetWaveState("StageCleared", "STAGE_CLEARED")
			self:PublishWaveStateSnapshot("STAGE_CLEARED")
			self.BattleResult = "Victory"
		else
			self.TurnState:SetPhase("BattleEnded", "PLAYER_DEFEATED")
			self:PublishTurnStateSnapshot("PLAYER_DEFEATED")
			self.WaveRuntime:SetWaveState("Failed", "PLAYER_DEFEATED")
			self:PublishWaveStateSnapshot("PLAYER_DEFEATED")
			self.BattleResult = "Defeat"
		end

		local runResultRecorded = false
		if isvalid(self.PlayerEntity) then
			runResultRecorded = _RunManagerLogic:RecordBattleResult(self.PlayerEntity, self.StageNumber, self.BattleResult)
		end
		log("[BattleDeath] unit=" .. unitId .. " cause=" .. cause .. " result=" .. self.BattleResult .. " wave=" .. self.CurrentWave)
		log("[BattleResult] result=" .. self.BattleResult .. " stage=" .. self.StageNumber .. " wave=" .. self.CurrentWave .. "/" .. self.TotalWaves .. " turn=" .. self.TurnNumber .. " runRecorded=" .. tostring(runResultRecorded))
	end

	@ExecSpace("ServerOnly")
	method void AdvanceClearedWave(integer clearedWave, integer nextWave)
		-- Called only by BattleWaveComponent after its map-scoped transition timer expires.
		if self.BattleResult ~= "" or self.CurrentWave ~= clearedWave then
			return
		end
		self.TurnState:OpenPlayerTurn(self.TurnNumber + 1, "NEXT_WAVE")
		self:PublishTurnStateSnapshot("NEXT_WAVE")
		self.StageTurnNumber = self.TurnNumber
		self:SpawnWave(nextWave)
		if self.CurrentWave == nextWave then
			self.TurnState:SetPhase("PlayerTurn", "NEXT_WAVE_ACTIVE")
			self:PublishTurnStateSnapshot("NEXT_WAVE_ACTIVE")
			self.WaveRuntime:MarkWaveActive("NEXT_WAVE_ACTIVE")
			self:PublishWaveStateSnapshot("NEXT_WAVE_ACTIVE")
			self:PrepareEnemyIntent()
		end
	end

	@ExecSpace("ServerOnly")
	method Entity ResolveFrontTarget(string sourceUnitId)
		-- Returns a living opposing unit occupying the source unit's front cell.
		local sourceEntity = self:FindUnitEntity(sourceUnitId)
		if isvalid(sourceEntity) == false then
			return nil
		end

		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit == nil then
			return nil
		end

		local facingDirection = -1
		if sourceUnit.Facing == "Right" then
			facingDirection = 1
		end
		local targetCell = sourceUnit.CellIndex + facingDirection

		if self.BoardState == nil then
			return nil
		end
		local candidate = self.BoardState:FindAtCell(targetCell, sourceUnitId)
		if isvalid(candidate) then
			local unit = candidate:GetComponent("script.BattleUnitComponent")
			if unit ~= nil and unit.Team ~= sourceUnit.Team then
				return candidate
			end
		end
		return nil
	end

	@ExecSpace("Server")
	method void RequestMove(integer direction)
		-- Validates the requesting client before forwarding the move to battle state.
		if isvalid(self.PlayerEntity) == false or self.PlayerEntity.PlayerComponent == nil then
			log_warning("[BattleMove] rejected reason=PLAYER_MISSING")
			return
		end

		if self.PlayerEntity.PlayerComponent.UserId ~= senderUserId then
			log_warning("[BattleMove] rejected reason=INVALID_SENDER")
			return
		end

		local result = self:TryQueuePlayerAction("MOVE", direction)
		if result.Success == false then
			log_warning("[BattleQueue] rejected action=MOVE direction=" .. direction .. " reason=" .. result.Reason)
		end
	end

	@ExecSpace("ServerOnly")
	method table TryMove(string unitId, integer direction)
		-- Moves one logical cell after checking phase, range, life, and occupancy.
		local result = {
			Success = false,
			Reason = "UNKNOWN",
			FromCell = -1,
			ToCell = -1
		}

		if direction ~= -1 and direction ~= 1 then
			result.Reason = "INVALID_DIRECTION"
			return result
		end

		local unitEntity = self:FindUnitEntity(unitId)
		if isvalid(unitEntity) == false then
			result.Reason = "UNIT_NOT_FOUND"
			return result
		end

		local unit = unitEntity:GetComponent("script.BattleUnitComponent")
		if unit == nil then
			result.Reason = "UNIT_COMPONENT_MISSING"
			return result
		end

		if self:IsTeamTurn(unit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end

		result.FromCell = unit.CellIndex
		result.ToCell = unit.CellIndex + direction
		if unit.IsDead == true then
			result.Reason = "UNIT_DEAD"
			return result
		end

		if self:IsValidCell(result.ToCell) == false then
			result.Reason = "OUT_OF_BOUNDS"
			return result
		end

		if self:IsCellOccupied(result.ToCell, unitId) then
			result.Reason = "CELL_OCCUPIED"
			return result
		end

		unit.CellIndex = result.ToCell
		local position = self:GetCellPosition(result.ToCell)
		self:PlaceEntity(unitEntity, position)

		local movedEvent = UnitMovedEvent()
		movedEvent.UnitId = unit.UnitId
		movedEvent.FromCell = result.FromCell
		movedEvent.ToCell = result.ToCell
		self.Entity:SendEvent(movedEvent)

		result.Success = true
		result.Reason = "OK"
		log("[BattleMove] success unit=" .. unit.UnitId .. " from=" .. result.FromCell .. " to=" .. result.ToCell .. " x=" .. position.x)
		return result
	end

	method Entity FindUnitEntity(string unitId)
		-- Delegates logical unit lookup to the map-scoped BoardState registry.
		if self.BoardState == nil then
			return nil
		end
		return self.BoardState:FindByUnitId(unitId)
	end

	@ExecSpace("ServerOnly")
	method any GetSkillRuntimeState(string unitId)
		local unitEntity = self:FindUnitEntity(unitId)
		if isvalid(unitEntity) == false then
			return nil
		end
		return unitEntity:GetComponent("script.SkillRuntimeStateComponent")
	end

	@ExecSpace("ServerOnly")
	method void AdvancePlayerSkillCooldowns(string reason)
		local runtimeState = self:GetSkillRuntimeState("player_01")
		if runtimeState == nil then
			log_warning("[BattleCooldown] advance skipped reason=SKILL_RUNTIME_STATE_MISSING turn=" .. self.TurnNumber)
			return
		end
		runtimeState:AdvanceCooldowns(1, reason)
	end

	method boolean IsCellOccupied(integer cellIndex, string ignoredUnitId)
		-- Delegates living-cell occupancy to the map-scoped BoardState registry.
		if self.BoardState == nil then
			return false
		end
		return isvalid(self.BoardState:FindAtCell(cellIndex, ignoredUnitId))
	end

	method number GetBoardCenterX()
		-- Calculates the visual center of the current logical battle board.
		return self.CellStartX + self.CellSpacing * (self.CellCount - 1) * 0.5
	end

	@ExecSpace("Client")
	method void LockBoardCamera(number boardCenterX)
		-- Switches away from the moving player to a fixed board-center camera target.
		local player = _UserService.LocalPlayer
		if isvalid(player) == false or player.CameraComponent == nil then
			log_error("[BattleCamera] local player camera missing")
			return
		end

		local anchor = self.Entity:GetChildByName("BattleCameraAnchor", false)
		if isvalid(anchor) == false or anchor.CameraComponent == nil or anchor.TransformComponent == nil then
			log_error("[BattleCamera] BattleCameraAnchor missing")
			return
		end

		local playerCamera = player.CameraComponent
		local boardCamera = anchor.CameraComponent
		local anchorX = anchor.TransformComponent.WorldPosition.x
		boardCamera.CameraOffset = Vector2(boardCenterX - anchorX, playerCamera.CameraOffset.y)
		boardCamera.ScreenOffset = playerCamera.ScreenOffset
		boardCamera.ZoomRatio = playerCamera.ZoomRatio
		boardCamera.ConfineCameraArea = false
		boardCamera.Damping = Vector2(0, 0)
		boardCamera.DeadZone = Vector2(0, 0)
		boardCamera.SoftZone = Vector2(0, 0)

		_CameraService.TransitionBlendTime = 0
		_CameraService:SwitchCameraTo(boardCamera)
		log("[BattleCamera] fixed anchor active centerX=" .. boardCenterX .. " anchorX=" .. anchorX .. " offsetX=" .. boardCamera.CameraOffset.x)
	end

	method boolean IsValidCell(integer cellIndex)
		-- Returns whether the logical cell index is inside the six-cell board.
		return cellIndex >= 0 and cellIndex < self.CellCount
	end

	method Vector2 GetCellPosition(integer cellIndex)
		-- Converts a zero-based logical cell index into the current map's world position.
		local x = self.CellStartX + self.CellSpacing * cellIndex
		return Vector2(x, self.UnitY)
	end

	@ExecSpace("ServerOnly")
	method void PlaceEntity(Entity targetEntity, Vector2 position)
		-- Places Body-based players through MovementComponent and static units through TransformComponent.
		if targetEntity.MovementComponent ~= nil then
			targetEntity.MovementComponent:SetPosition(position)
			return
		end

		if targetEntity.TransformComponent == nil then
			log_error("[BattleSession] TransformComponent missing entity=" .. targetEntity.Name)
			return
		end

		local current = targetEntity.TransformComponent.Position
		targetEntity.TransformComponent.Position = Vector3(position.x, position.y, current.z)
	end

	@ExecSpace("ServerOnly")
	method void TryStartBattle()
		-- Enters the first player turn after a player and at least one wave enemy have registered.
		local playerEntity = self:FindUnitEntity("player_01")
		if isvalid(playerEntity) == false or self.BoardState == nil then
			return
		end
		local livingEnemies = self.BoardState:CollectLivingEnemies()
		if #livingEnemies == 0 then
			return
		end
		self.PlayerEntity = playerEntity
		self.EnemyEntity = livingEnemies[1]

		if self.BattlePhase == "PlayerTurn" then
			return
		end

		self.TurnState:OpenPlayerTurn(1, "BATTLE_READY")
		self:PublishTurnStateSnapshot("BATTLE_READY")
		self.WaveRuntime:MarkWaveActive("BATTLE_READY")
		self:PublishWaveStateSnapshot("BATTLE_READY")
		self.StageTurnNumber = 1
		log("[BattleSession] ready phase=" .. self.BattlePhase .. " stage=" .. self.StageNumber .. " wave=" .. self.CurrentWave .. "/" .. self.TotalWaves .. " turn=" .. self.TurnNumber .. " playerCell=" .. self.PlayerStartCell .. " livingEnemies=" .. #livingEnemies .. " enemyHp=" .. self.CurrentEnemyMaxHp)
		self:PrepareEnemyIntent()
	end

end
