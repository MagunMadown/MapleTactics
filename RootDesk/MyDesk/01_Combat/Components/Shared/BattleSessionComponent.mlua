	@ExecSpace("ServerOnly")
	method table TrySkillTestAssignSlot(integer slotIndex, string skillId)
		-- Skill test map only: equips any valid player skill into one fixed battle slot.
		if self.SkillTestMode ~= true then
			return { Success = false, Reason = "NOT_SKILL_TEST_MAP" }
		end
		if slotIndex ~= math.floor(slotIndex) or slotIndex < 1 or slotIndex > self.SkillSlotCount then
			return { Success = false, Reason = "SLOT_INDEX_OUT_OF_RANGE" }
		end
		if isvalid(self.PlayerEntity) == false then
			return { Success = false, Reason = "PLAYER_UNAVAILABLE" }
		end
		local validation = _ContentValidatorLogic:ValidateSkillById(skillId)
		if validation.Success == false then
			return { Success = false, Reason = validation.DetailReason or validation.Reason }
		end
		local inventory = self.PlayerEntity:GetComponent("script.PlayerRunInventoryComponent")
		if inventory == nil then
			return { Success = false, Reason = "RUN_INVENTORY_UNAVAILABLE" }
		end
		local applyResult = inventory:ApplySkillTestBarSlot(slotIndex, skillId)
		if applyResult.Success == false then
			return applyResult
		end
		self:RefreshSkillTestPresentation("SKILL_TEST_ASSIGN")
		log("[SkillTest] slot assigned slot=" .. tostring(slotIndex) .. " skill=" .. skillId .. " slots=" .. self.SkillSlotIds)
		return { Success = true, Reason = "OK", SlotIds = self.SkillSlotIds }
	end

	@ExecSpace("ServerOnly")
	method table TrySkillTestAssignUtility(string jobId)
		-- Skill test map only: makes the utility button use another job's utility so every utility can be tried.
		if self.SkillTestMode ~= true then
			return { Success = false, Reason = "NOT_SKILL_TEST_MAP" }
		end
		local bundle = _SkillDefinitionRepositoryLogic:GetUtilitySkillBundle(jobId)
		if bundle.Success == false then
			return bundle
		end
		local definition = bundle.Definition
		self.SkillTestUtilityJobId = jobId
		self.UtilitySkillId = definition.SkillId
		self.UtilitySkillIconRuid = definition.IconRuid
		self.UtilityMaxCooldown = definition.CooldownTurns
		local runtime = self:GetSkillRuntimeState("player_01")
		if runtime ~= nil then
			runtime:ResetSkillRuntimeState("SKILL_TEST_UTILITY_ASSIGN")
		end
		self.UtilityRemainingCooldown = 0
		-- Warm the new utility's clips and sounds so its first cast looks like every later one.
		local ruids = {}
		local seen = {}
		for _, ruid in ipairs({ definition.CastEffectRuid, definition.HitEffectRuid, definition.CellEffectRuid, definition.ProjectileRuid, definition.CastSoundRuid, definition.HitSoundRuid }) do
			self:CollectPresentationRuid(ruids, seen, ruid)
		end
		if #ruids > 0 and isvalid(self.PlayerEntity) and self.PlayerEntity.PlayerComponent ~= nil then
			self:PreloadSkillPresentation(table.concat(ruids, "|"), self.PlayerEntity.PlayerComponent.UserId)
		end
		self:PublishTurnStateSnapshot("SKILL_TEST_UTILITY")
		log("[SkillTest] utility assigned job=" .. jobId .. " skill=" .. definition.SkillId)
		return { Success = true, Reason = "OK", SkillId = definition.SkillId }
	end

	@ExecSpace("ServerOnly")
	method void RefreshSkillTestUtility()
		-- Re-reads the equipped utility so an edited cooldown or icon reaches the utility HUD.
		if self.SkillTestMode ~= true or self.UtilitySkillId == "" then
			return
		end
		local jobId = self.SkillTestUtilityJobId ~= "" and self.SkillTestUtilityJobId or self.SelectedJobId
		local bundle = _SkillDefinitionRepositoryLogic:GetUtilitySkillBundle(jobId)
		if bundle.Success == false then
			return
		end
		self.UtilitySkillIconRuid = bundle.Definition.IconRuid
		self.UtilityMaxCooldown = bundle.Definition.CooldownTurns
		self.UtilityRemainingCooldown = math.min(self.UtilityRemainingCooldown, self.UtilityMaxCooldown)
	end

	@ExecSpace("ServerOnly")
	method void RefreshSkillTestPresentation(string reason)
		-- Forces the slot rebuild so edited names/cooldowns/icons reach the HUD even when ownership is unchanged.
		if self.SkillTestMode ~= true or isvalid(self.PlayerEntity) == false then
			return
		end
		self.SkillSlotSourceSnapshot = ""
		self:RefreshSkillSlots(reason, self.PlayerEntity)
	end

	@ExecSpace("ServerOnly")
	method table ResetSkillTestCooldowns()
		if self.SkillTestMode ~= true then
			return { Success = false, Reason = "NOT_SKILL_TEST_MAP" }
		end
		local runtimeState = self:GetSkillRuntimeState("player_01")
		if runtimeState == nil then
			return { Success = false, Reason = "SKILL_RUNTIME_STATE_MISSING" }
		end
		runtimeState:ResetSkillRuntimeState("SKILL_TEST_RESET")
		self.UtilityRemainingCooldown = 0
		log("[SkillTest] cooldowns reset")
		return { Success = true, Reason = "OK" }
	end

	@ExecSpace("ServerOnly")
	method table RestoreSkillTestDummy()
		if self.SkillTestMode ~= true or self.BoardState == nil then
			return { Success = false, Reason = "NOT_SKILL_TEST_MAP" }
		end
		local restored = 0
		for _, enemyEntity in ipairs(self.BoardState:CollectLivingEnemies()) do
			local unit = enemyEntity:GetComponent("script.BattleUnitComponent")
			if unit ~= nil then
				unit:RestoreCurrentHp(unit.MaxHp)
				restored = restored + 1
			end
		end
		log("[SkillTest] dummy restored count=" .. tostring(restored))
		return { Success = restored > 0, Reason = restored > 0 and "OK" or "NO_DUMMY" }
	end

