	@ExecSpace("ServerOnly")
	method void PublishQueueReorderReceipt(integer fromIndex, integer toIndex, table result)
		self.QueueLastRequestId = self.LastProcessedQueueReorderRequestId
		self.QueueLastRequestSuccess = result ~= nil and result.Success == true
		self.QueueLastRequestReason = result ~= nil and result.Reason or "UNKNOWN"
		self.QueueLastSourceIndex = fromIndex
		self.QueueLastTargetIndex = toIndex
		self.QueueLastOrderRevision = self.TurnState ~= nil and self.TurnState.QueueOrderRevision or 0
		self.QueueReorderReceiptRevision = self.QueueReorderReceiptRevision + 1
		log("[BattleQueueReorder] receipt request=" .. tostring(self.QueueLastRequestId)
			.. " success=" .. tostring(self.QueueLastRequestSuccess)
			.. " reason=" .. self.QueueLastRequestReason
			.. " from=" .. tostring(fromIndex)
			.. " to=" .. tostring(toIndex)
			.. " queueRevision=" .. tostring(self.QueueLastOrderRevision)
			.. " queued=" .. tostring(self.TurnState ~= nil and self.TurnState.QueuedTileIds or "")
			.. " executing=" .. tostring(self.TurnState ~= nil and self.TurnState.ExecutingTileIds or ""))
	end

