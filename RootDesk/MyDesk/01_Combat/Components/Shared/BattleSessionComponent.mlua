	method void AdvanceClearedWave(integer clearedWave, integer nextWave)
		-- Called only by BattleWaveComponent after its map-scoped transition timer expires.
		local wait = self._T.waveMotionCompletion
		if wait ~= nil and wait.Entry == self.EntryRequestId and wait.ClearedWave == clearedWave and wait.NextWave == nextWave then
			self._T.waveMotionCompletion = nil
			self:MarkMotionCompletionReady(wait.Sequence)
		end
	end

