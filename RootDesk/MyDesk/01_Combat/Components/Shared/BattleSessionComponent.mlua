	end

	@ExecSpace("Server")
	method void RequestMissingMotionPresentations(integer sequence, integer entry, integer epoch, string missingReceipts)
		if isvalid(self.PlayerEntity) == false or self.PlayerEntity.PlayerComponent == nil or self.PlayerEntity.PlayerComponent.UserId ~= senderUserId or self.PlayerEntity.CurrentMap ~= self.Entity then return end
		local wait = self._T.motionCompletionWaits ~= nil and self._T.motionCompletionWaits[sequence] or nil
		local ledger = self._T.motionPresentationLedger
		if wait == nil or not wait.Sealed or wait.Entry ~= entry or wait.Epoch ~= epoch or self.EntryRequestId ~= entry then return end
		if ledger == nil or ledger.Epoch ~= epoch then return end
		_BattleMotionCompletionLogic:ResendMissingMotionPresentations(self, ledger, wait, entry, epoch, missingReceipts, senderUserId)
	end

	@ExecSpace("Server")
	method void ConfirmMotionCompletion(integer sequence, integer entry, integer epoch, integer receipts)
		-- This acknowledgement can only release an existing server-owned callback; it cannot apply damage or choose actions.
		if isvalid(self.PlayerEntity) == false or self.PlayerEntity.PlayerComponent == nil or self.PlayerEntity.PlayerComponent.UserId ~= senderUserId or self.PlayerEntity.CurrentMap ~= self.Entity then return end
		local wait = self._T.motionCompletionWaits ~= nil and self._T.motionCompletionWaits[sequence] or nil
		if wait == nil or not wait.Sealed or wait.Entry ~= entry or wait.Epoch ~= epoch or self.EntryRequestId ~= entry or receipts ~= wait.ExpectedReceipts then return end
		wait.ClientReady = true
		self:TryReleaseMotionCompletionWait(sequence)
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- Entry polling belongs to the entry owner; the component keeps lifecycle dispatch.
		if _BattleEntryLogic:UpdateEntryPolicy(self, delta) then return end
		self:UpdatePlayerGridLandingCheck(delta)
		if not isvalid(self.PlayerEntity) or self.PlayerEntity.CurrentMap ~= self.Entity then
			-- Clean an interrupted move once, then leave an inactive map's snapshots alone.
			if self._T.playerGridMove ~= nil then self:UpdatePlayerGridMove(delta) end
			if self._T.enemyGridMove ~= nil then self:UpdateEnemyGridMove(delta) end
			if self.HudRelicSnapshot ~= "" then self.HudRelicSnapshot = "" end
			self._T.HudRelicCache = nil
			return
		end
		self:RefreshHudProgressSnapshot()
		self:UpdatePlayerGridMove(delta)
		self:UpdateEnemyGridMove(delta)
		self:RefreshPlayerHpSnapshot("")
		if self.BattlePhase == "Setup" then
			self:TryStartBattle()
		end
		self:RefreshHudRelicSnapshot()
	end

	@ExecSpace("ServerOnly")
	method void RefreshPlayerHpSnapshot(string reason)
		-- Delegates to the owner while keeping session state and the public call boundary.
		_BattleUiStateLogic:RefreshPlayerHpSnapshot(self, reason)
	end

	@ExecSpace("ServerOnly")
	method void OnMapEnter(Entity enteredEntity)
		-- Registers a player that enters this battle map after the session has initialized.
		if enteredEntity == nil or enteredEntity.PlayerComponent == nil then
			return
		end
		local entryState = enteredEntity:GetComponent("script.BattleEntryStateComponent")
		if entryState ~= nil and entryState.EntryState == "PREPARED" then
			local runState = enteredEntity:GetComponent("script.PlayerRunStateComponent")
			self.PrototypeTestEntryActive = runState ~= nil and runState.PrototypeTestMode == true
			self.EntryPolicyResolved = true
			log("[BattleSession] prepared entry detected request=" .. entryState.RequestId .. " stage=" .. entryState.StageId .. " prototype=" .. tostring(self.PrototypeTestEntryActive))
			local entryResult = _BattleGatewayLogic:ConsumePreparedBattle(enteredEntity, self)
			if entryResult.Success == true then
				return
			end
			log_warning("[BattleSession] prepared entry blocked request=" .. entryState.RequestId .. " reason=" .. entryResult.Reason)
			return
		end
		if self.EntryPolicyResolved == true then
			log("[BattleSession] duplicate map entry ignored player=" .. enteredEntity.Name)
			return
		end

		log("[BattleSession] map entered player=" .. enteredEntity.Name)
		if self.AutoStartPrototypeBattle == false then
			self.EntryPolicyResolved = true
			log("[BattleSession] player waiting for prepared entry player=" .. enteredEntity.Name)
			return
		end
		self.EntryPolicyResolved = true
		local stageResolution = self:ResolvePrototypeTestStage()
		if stageResolution.Success == false then
			log_error("[BattlePrototypeEntry] stage resolution rejected map=" .. self.Entity.Name .. " reason=" .. stageResolution.Reason .. " detail=" .. (stageResolution.DetailReason or ""))
			return
		end
		local targetStageId = stageResolution.StageId
		log("[BattleSession] no prepared entry, prototype auto start player=" .. enteredEntity.Name .. " stage=" .. targetStageId .. " source=" .. stageResolution.Source)
		local testResult = self:StartPrototypeBattleFromMap(enteredEntity, targetStageId)
		if testResult.Success == false then
			if testResult.Retryable == true then
				self:QueuePrototypeBattleEntryRetry(enteredEntity, targetStageId, testResult.Reason)
			else
				log_error("[BattlePrototypeEntry] rejected stage=" .. targetStageId .. " reason=" .. testResult.Reason .. " detail=" .. (testResult.DetailReason or ""))
			end
		end
	end

	@ExecSpace("ServerOnly")
	method table ResolvePrototypeTestStage()
		-- Delegates to the owner while keeping session state and the public call boundary.
		return _BattleEntryLogic:ResolvePrototypeTestStage(self)
