@Component
script EnemyIntentComponent extends Component

	@Sync property string IntentState = "EMPTY"
	@Sync property string EnemyId = ""
	@Sync property string PatternId = ""
	@Sync property integer StepIndex = 0
	@Sync property string ActionType = ""
	@Sync property string TileId = ""
	@Sync property integer TelegraphTurnsRemaining = 0
	@Sync property integer Direction = 0
	@Sync property integer PreparedTurn = 0
	@Sync property string IntentReason = ""
	@Sync property integer IntentRevision = 0

	@ExecSpace("ServerOnly")
	method void ResetIntent(string reason)
		-- Clears the map-scoped prepared intent without selecting another enemy action.
		if self.IntentState ~= "EMPTY" then
			log("[EnemyIntentState] clear enemy=" .. self.EnemyId .. " state=" .. self.IntentState .. " reason=" .. reason)
		end
		self.IntentState = "EMPTY"
		self.EnemyId = ""
		self.PatternId = ""
		self.StepIndex = 0
		self.ActionType = ""
		self.TileId = ""
		self.TelegraphTurnsRemaining = 0
		self.Direction = 0
		self.PreparedTurn = 0
		self.IntentReason = ""
		self.IntentRevision = self.IntentRevision + 1
	end

	@ExecSpace("ServerOnly")
	method table TryPrepare(string enemyId, string patternId, integer stepIndex, string actionType, string tileId, integer telegraphTurnsRemaining, integer direction, integer preparedTurn, string reason)
		-- Stores one immutable Prepare-to-Execute snapshot owned by this map-scoped component.
		local result = { Success = false, Reason = "UNKNOWN", Revision = self.IntentRevision }
		if self.IntentState ~= "EMPTY" then
			result.Reason = "INTENT_ALREADY_PREPARED"
			return result
		end
		if enemyId == "" or actionType == "" then
			result.Reason = "INVALID_INTENT"
			return result
		end

		self.IntentState = "PREPARED"
		self.EnemyId = enemyId
		self.PatternId = patternId
		self.StepIndex = math.max(1, stepIndex)
		self.ActionType = actionType
		self.TileId = tileId
		self.TelegraphTurnsRemaining = math.max(0, telegraphTurnsRemaining)
		self.Direction = direction
		self.PreparedTurn = math.max(0, preparedTurn)
		self.IntentReason = reason
		self.IntentRevision = self.IntentRevision + 1
		result.Success = true
		result.Reason = "PREPARED"
		result.Revision = self.IntentRevision
		log("[EnemyIntentState] prepared enemy=" .. self.EnemyId .. " pattern=" .. self.PatternId .. " step=" .. self.StepIndex .. " action=" .. self.ActionType .. " telegraphRemaining=" .. self.TelegraphTurnsRemaining .. " revision=" .. self.IntentRevision)
		return result
	end

	@ExecSpace("ServerOnly")
	method table TryBeginExecution()
		-- Moves the currently prepared snapshot to EXECUTING without changing its action payload.
		local result = { Success = false, Reason = "INTENT_NOT_PREPARED", Revision = self.IntentRevision }
		if self.IntentState ~= "PREPARED" then
			return result
		end
		self.IntentState = "EXECUTING"
		self.IntentRevision = self.IntentRevision + 1
		result.Success = true
		result.Reason = "EXECUTING"
		result.Revision = self.IntentRevision
		log("[EnemyIntentState] executing enemy=" .. self.EnemyId .. " action=" .. self.ActionType .. " revision=" .. self.IntentRevision)
		return result
	end

	@ExecSpace("ServerOnly")
	method table GetSnapshot()
		-- Returns a copy so callers and UI adapters cannot mutate the authoritative intent state.
		return {
			State = self.IntentState,
			EnemyId = self.EnemyId,
			PatternId = self.PatternId,
			StepIndex = self.StepIndex,
			ActionType = self.ActionType,
			TileId = self.TileId,
			TelegraphTurnsRemaining = self.TelegraphTurnsRemaining,
			Direction = self.Direction,
			PreparedTurn = self.PreparedTurn,
			Reason = self.IntentReason,
			Revision = self.IntentRevision
		}
	end

end
