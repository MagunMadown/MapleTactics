@Component
script CellWalkerComponent extends Component

	@Description("Map path prefix of the cells; cells are named <prefix>1 .. <prefix>N.")
	property string CellPathPrefix = "/maps/mushroom_walk_test/MushroomCells/Cell"
	property integer CellCount = 5
	property number StepSeconds = 1.0
	property number OffsetY = 0.0
	property number HopSeconds = 0.4
	property number HopHeight = 0.3

	property integer CurrentIndex = 0
	property integer TimerId = 0
	property boolean IsHopping = false
	property number HopElapsed = 0
	property Vector3 HopFrom = Vector3(0, 0, 0)
	property Vector3 HopTo = Vector3(0, 0, 0)

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self.CurrentIndex = 1
		self.Entity.TransformComponent.WorldPosition = self:GetCellPosition(1)
		-- Last cell wraps by teleporting back to the first one; every other step is a hop.
		self.TimerId = _TimerService:SetTimerRepeat(function() self:Step() end, self.StepSeconds, self.StepSeconds)
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		if self.TimerId ~= 0 then
			_TimerService:ClearTimer(self.TimerId)
			self.TimerId = 0
		end
	end

	@ExecSpace("ServerOnly")
	method Vector3 GetCellPosition(integer index)
		local cell = _EntityService:GetEntityByPath(self.CellPathPrefix .. tostring(index))
		if cell == nil then
			log_warning("CellWalkerComponent: cell not found: " .. self.CellPathPrefix .. tostring(index))
			return self.Entity.TransformComponent.WorldPosition
		end
		local p = cell.TransformComponent.WorldPosition
		return Vector3(p.x, p.y + self.OffsetY, self.Entity.TransformComponent.WorldPosition.z)
	end

	@ExecSpace("ServerOnly")
	method void Step()
		local nextIndex = self.CurrentIndex + 1
		if nextIndex > self.CellCount then
			nextIndex = 1
			self.IsHopping = false
			self.CurrentIndex = nextIndex
			self.Entity.TransformComponent.WorldPosition = self:GetCellPosition(nextIndex)
			log("CellWalker teleport -> cell " .. tostring(nextIndex))
			return
		end
		self.HopFrom = self.Entity.TransformComponent.WorldPosition
		self.HopTo = self:GetCellPosition(nextIndex)
		self.HopElapsed = 0
		self.IsHopping = true
		self.CurrentIndex = nextIndex
		log("CellWalker hop -> cell " .. tostring(nextIndex))
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		if self.IsHopping == false then return end
		self.HopElapsed = self.HopElapsed + delta
		local t = math.min(1, self.HopElapsed / math.max(0.01, self.HopSeconds))
		local x = self.HopFrom.x + (self.HopTo.x - self.HopFrom.x) * t
		local y = self.HopFrom.y + (self.HopTo.y - self.HopFrom.y) * t + math.sin(math.pi * t) * self.HopHeight
		self.Entity.TransformComponent.WorldPosition = Vector3(x, y, self.HopTo.z)
		if t >= 1 then
			self.IsHopping = false
		end
	end

end
