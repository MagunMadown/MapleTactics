@Component
script BattleDropPresentationComponent extends Component

	property string DropModelId = "battledroppickup"
	property string CurrencySpriteRuid = "a724200c454c4fcf878b0a3cdbb706d6"
	property string ConsumableSpriteRuid = "f02d66457cea4f63b1d9f4abaec1f4ad"
	property number CellStartX = -2.8
	property number CellSpacing = 1.12
	property number UnitY = 0.12
	property number DropHeightOffset = 0.04
	property number FloatAmplitude = 0.06
	property number FloatCycleTime = 0.9
	property any SpawnedDropEntities = nil
	property any SpriteCenterOffsets = nil
	property integer SpawnSequence = 0

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self.SpawnedDropEntities = {}
		self.SpriteCenterOffsets = {}
		log("[BattleDropPresentation] ready model=" .. self.DropModelId)
	end

	@ExecSpace("ServerOnly")
	method void ConfigureBoard(number cellStartX, number cellSpacing, number unitY)
		self.CellStartX = cellStartX
		self.CellSpacing = cellSpacing
		self.UnitY = unitY
		log("[BattleDropPresentation] board configured startX=" .. cellStartX .. " spacing=" .. cellSpacing .. " unitY=" .. unitY)
	end

	@ExecSpace("ServerOnly")
	method table ShowDrop(string rewardKey, string dropType, string dropRefId, integer amount, integer cellIndex)
		local result = { Success = false, Reason = "UNKNOWN", RewardKey = rewardKey or "", Entity = nil }
		if rewardKey == nil or rewardKey == "" then
			result.Reason = "DROP_REWARD_KEY_MISSING"
			return result
		end
		if cellIndex < 0 then
			result.Reason = "DROP_CELL_INVALID"
			return result
		end
		if self.SpawnedDropEntities == nil then
			self.SpawnedDropEntities = {}
		end
		local existing = self.SpawnedDropEntities[rewardKey]
		if isvalid(existing) then
			result.Success = true
			result.Reason = "DROP_ALREADY_VISIBLE"
			result.Entity = existing
			return result
		end

		local spriteRuid = self:ResolveSpriteRuid(dropType, dropRefId)
		if spriteRuid == "" then
			result.Reason = "DROP_SPRITE_UNRESOLVED"
			return result
		end
		local dropX = self.CellStartX + (cellIndex * self.CellSpacing)
		local dropY = self.UnitY
		local footholds = self.Entity.FootholdComponent
		if footholds ~= nil then
			-- Match BattleSessionComponent.PlaceEntity so rewards sit on the same floor as units.
			local foothold = footholds:Raycast(Vector2(dropX, self.UnitY + 0.5), Vector2(0, -1), 10)
			if foothold ~= nil and foothold:IsVertical() == false then
				dropY = foothold:GetYByX(dropX)
			end
		end
		local visualX = dropX + self:ResolveSpriteCenterOffsetX(spriteRuid)
		local spawnPosition = Vector3(visualX, dropY + self.DropHeightOffset, 0)
		self.SpawnSequence = self.SpawnSequence + 1
		local dropEntity = _SpawnService:SpawnByModelId(
			self.DropModelId,
			"BattleDrop_" .. tostring(self.SpawnSequence),
			spawnPosition,
			self.Entity
		)
		if isvalid(dropEntity) == false then
			result.Reason = "DROP_MODEL_SPAWN_FAILED"
			log_error("[BattleDropPresentation] spawn failed model=" .. self.DropModelId .. " key=" .. rewardKey)
			return result
		end

		local sprite = dropEntity.SpriteRendererComponent
		if sprite ~= nil then
			sprite.SpriteRUID = spriteRuid
			sprite.OrderInLayer = 3
		end
		local tween = dropEntity.TweenFloatingComponent
		if tween ~= nil then
			tween.Amplitude = self.FloatAmplitude
			tween.OneCycleTime = self.FloatCycleTime
			tween.TweenType = EaseType.QuadEaseInOut
			tween.AutoDestroy = false
			tween.AutoStart = true
			tween:RestartFromCurrentPosition()
		end
		self.SpawnedDropEntities[rewardKey] = dropEntity
		result.Success = true
		result.Reason = "DROP_PRESENTED"
		result.Entity = dropEntity
		log("[BattleDropPresentation] shown key=" .. rewardKey .. " reward=" .. dropType .. ":" .. dropRefId .. " amount=" .. amount .. " cell=" .. cellIndex .. " sprite=" .. spriteRuid)
		return result
	end

	@ExecSpace("ServerOnly")
	method void AttractDrop(string rewardKey, Entity player)
		local drop = self.SpawnedDropEntities ~= nil and self.SpawnedDropEntities[rewardKey] or nil
		if not isvalid(drop) then return end
		if not isvalid(player) or player.CurrentMap ~= self.Entity then
			self:RemoveDrop(rewardKey, "MAGNET_TARGET_UNAVAILABLE")
			return
		end
		self._T.MagnetFlights = self._T.MagnetFlights or {}
		if self._T.MagnetFlights[rewardKey] ~= nil then return end
		if drop.TweenFloatingComponent ~= nil then drop.TweenFloatingComponent:Stop(false) end
		local start = drop.TransformComponent.WorldPosition
		self._T.MagnetFlights[rewardKey] = { Player = player, Start = Vector3(start.x, start.y, start.z), Elapsed = 0 }
		log("[BattleDrop] magnet attraction started key=" .. rewardKey)
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		local flights = self._T.MagnetFlights
		if flights == nil then return end
		for key, flight in pairs(flights) do
			local drop = self.SpawnedDropEntities ~= nil and self.SpawnedDropEntities[key] or nil
			local player = flight.Player
			if not isvalid(drop) or not isvalid(player) or player.CurrentMap ~= self.Entity then
				self:RemoveDrop(key, "MAGNET_TARGET_LEFT")
				flights[key] = nil
			else
				flight.Elapsed = flight.Elapsed + math.max(0, delta)
				local target = player
				local relics = player:GetComponent("script.PlayerRunRelicEffectComponent")
				local pet = relics ~= nil and relics._T.MagnetPetFollower or nil
				if isvalid(pet) and pet.CurrentMap == self.Entity then target = pet end
				local finish = target.TransformComponent.WorldPosition
				local t = math.min(1, flight.Elapsed / 0.5)
				local pull = t * t
				local start = flight.Start
				drop.TransformComponent.WorldPosition = Vector3(start.x + (finish.x - start.x) * pull,
					start.y + (finish.y + 0.2 - start.y) * pull + math.sin(t * math.pi) * 0.35, start.z)
				if t >= 1 then
					self:RemoveDrop(key, "MAGNET_ABSORBED")
					flights[key] = nil
				end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method boolean RemoveDrop(string rewardKey, string reason)
		if self.SpawnedDropEntities == nil then
			return false
		end
		local dropEntity = self.SpawnedDropEntities[rewardKey]
		self.SpawnedDropEntities[rewardKey] = nil
		if isvalid(dropEntity) == false then
			return false
		end
		_EntityService:Destroy(dropEntity)
		log("[BattleDropPresentation] removed key=" .. rewardKey .. " reason=" .. reason)
		return true
	end

	@ExecSpace("ServerOnly")
	method integer ClearAll(string reason)
		self._T.MagnetFlights = nil
		local removedCount = 0
		if self.SpawnedDropEntities ~= nil then
			for rewardKey, dropEntity in pairs(self.SpawnedDropEntities) do
				if isvalid(dropEntity) then
					_EntityService:Destroy(dropEntity)
					removedCount = removedCount + 1
				end
			end
		end
		self.SpawnedDropEntities = {}
		log("[BattleDropPresentation] cleared reason=" .. reason .. " removed=" .. removedCount)
		return removedCount
	end

	@ExecSpace("ServerOnly")
	method integer GetVisibleDropCount()
		local count = 0
		if self.SpawnedDropEntities == nil then
			return count
		end
		for rewardKey, dropEntity in pairs(self.SpawnedDropEntities) do
			if isvalid(dropEntity) then
				count = count + 1
			else
				self.SpawnedDropEntities[rewardKey] = nil
			end
		end
		return count
	end

	@ExecSpace("ServerOnly")
	method string ResolveSpriteRuid(string dropType, string dropRefId)
		if dropType == "CURRENCY" then
			return self.CurrencySpriteRuid
		end
		if dropType == "CONSUMABLE" then
			local definition = _ConsumableDefinitionRepositoryLogic:GetDefinition(dropRefId)
			if definition.Success and definition.IconKey ~= nil and definition.IconKey ~= "" then
				return definition.IconKey
			end
			log_warning("[BattleDropPresentation] ICONRESOURCE REQUIRED ref=" .. tostring(dropRefId))
			return self.ConsumableSpriteRuid
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method number ResolveSpriteCenterOffsetX(string spriteRuid)
		if self.SpriteCenterOffsets == nil then self.SpriteCenterOffsets = {} end
		local cached = self.SpriteCenterOffsets[spriteRuid]
		if cached ~= nil then return cached end

		local loaded, sprite = pcall(function()
			local resourceType = _ResourceService:GetTypeAndWait(spriteRuid)
			if resourceType == ResourceType.Sprite then
				return _ResourceService:LoadSpriteAndWait(spriteRuid)
			end
			if resourceType == ResourceType.AnimationClip then
				local clip = _ResourceService:LoadAnimationClipAndWait(spriteRuid)
				if clip ~= nil and clip.IsLoadComplete then
					for _, frame in ipairs(clip.Frames:ToTable()) do
						if frame.FrameIndex == 0 then return frame.FrameSprite end
					end
				end
			end
			return nil
		end)
		local offsetX = 0
		if loaded and sprite ~= nil and sprite.IsLoadComplete and sprite.PixelPerUnit > 0 then
			-- Sprite pivots can lie outside the image; center its visible width on the logical cell.
			offsetX = (sprite.PivotPixel.x - sprite.Width * 0.5) / sprite.PixelPerUnit
		end
		self.SpriteCenterOffsets[spriteRuid] = offsetX
		return offsetX
	end

end
