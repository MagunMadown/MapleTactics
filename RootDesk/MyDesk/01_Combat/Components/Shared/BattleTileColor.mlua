@Component
script BattleTileColor extends Component

	-- Attach once to the map root. BattlePlatformHUD renders the shared six cells.
	-- Coordinates describe the visual board only; combat and footholds are independent.
	property Vector2 PlatformOrigin = Vector2(-2.8, -0.1)
	property number PlatformSpacing = 1.12
	property Color TileColor = Color(1, 1, 1, 1)

end
