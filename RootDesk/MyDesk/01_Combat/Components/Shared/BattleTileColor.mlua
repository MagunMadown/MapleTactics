@Component
script BattleTileColor extends Component

	property Color TileColor = Color(0.38, 0.64, 0.20, 1.0)

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- Fills each battle cell with one flat color at play start.
		local renderer = self.Entity.PixelRendererComponent
		if renderer == nil then
			log_error("[BattleTileColor] PixelRendererComponent missing: " .. self.Entity.Name)
			return
		end

		renderer:ResetWithColor(10, 1, self.TileColor)
		log("[BattleTileColor] filled " .. self.Entity.Name)
	end

end
