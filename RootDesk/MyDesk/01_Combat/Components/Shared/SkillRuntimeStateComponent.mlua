@Component
script SkillRuntimeStateComponent extends Component

	@Sync property string CooldownSnapshot = ""
	@Sync property integer CooldownRevision = 0
	property any RemainingCooldowns = nil
	property table FreshPlayerCooldowns = {}

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self:EnsureCooldownTable()
		self:RefreshCooldownSnapshot("BEGIN_PLAY")
		log("[SkillRuntimeState] ready entity=" .. self.Entity.Name)
	end

	@ExecSpace("ServerOnly")
	method void ResetSkillRuntimeState(string reason)
		self.RemainingCooldowns = {}
		self.FreshPlayerCooldowns = {}
		self:RefreshCooldownSnapshot(reason)
		log("[SkillRuntimeState] reset entity=" .. self.Entity.Name .. " reason=" .. reason)
	end

	@ExecSpace("ServerOnly")
	method table CanUseSkill(string skillId)
		local remainingTurns = self:GetRemainingCooldown(skillId)
		if remainingTurns > 0 then
			return {
				Success = false,
				Reason = "COOLDOWN_ACTIVE",
				SkillId = skillId,
				RemainingTurns = remainingTurns
			}
		end
		return {
			Success = true,
			Reason = "READY",
			SkillId = skillId,
			RemainingTurns = 0
		}
	end

	@ExecSpace("ServerOnly")
	method integer GetRemainingCooldown(string skillId)
		self:EnsureCooldownTable()
		return math.max(0, math.floor(tonumber(self.RemainingCooldowns[skillId]) or 0))
	end

	@ExecSpace("ServerOnly")
	method void StartCooldown(string skillId, integer cooldownTurns)
		self:EnsureCooldownTable()
		local normalizedTurns = math.max(0, math.floor(cooldownTurns))
		if normalizedTurns <= 0 then
			return
		end
		self.RemainingCooldowns[skillId] = normalizedTurns
		self:RefreshCooldownSnapshot("SKILL_USED")
		log("[SkillRuntimeState] cooldown started entity=" .. self.Entity.Name .. " skill=" .. skillId .. " remaining=" .. normalizedTurns)
	end

	@ExecSpace("ServerOnly")
	method void StartPlayerCooldown(string skillId, integer cooldownTurns)
		-- The casting action does not count toward its own cooldown; enemy starts use StartCooldown.
		self:StartCooldown(skillId, cooldownTurns)
		if cooldownTurns > 0 then self.FreshPlayerCooldowns[skillId] = true end
	end

	@ExecSpace("ServerOnly")
	method void AdvancePlayerCooldowns(string reason)
		-- Clear protection once per consumed player action, including an entire execution queue.
		local excluded = self.FreshPlayerCooldowns
		self.FreshPlayerCooldowns = {}
		self:AdvanceCooldownsExcept(1, reason, excluded)
	end

	@ExecSpace("ServerOnly")
	method void AdvanceCooldowns(integer elapsedTurns, string reason)
		-- Explicit cooldown reductions and enemy actions do not consume player action protection.
		self:AdvanceCooldownsExcept(elapsedTurns, reason, {})
	end

	@ExecSpace("ServerOnly")
	method void AdvanceCooldownsExcept(integer elapsedTurns, string reason, table excluded)
		-- Apply a clock tick without reducing skills started during that same player action.
		self:EnsureCooldownTable()
		local normalizedTurns = math.max(0, math.floor(elapsedTurns))
		if normalizedTurns <= 0 then
			return
		end

		local changed = false
		for skillId, remainingTurns in pairs(self.RemainingCooldowns) do
			if excluded[skillId] ~= true then
			local nextTurns = math.max(0, math.floor(tonumber(remainingTurns) or 0) - normalizedTurns)
			if nextTurns <= 0 then
				self.RemainingCooldowns[skillId] = nil
			else
				self.RemainingCooldowns[skillId] = nextTurns
			end
			changed = true
			end
		end
		if changed == false then
			return
		end

		self:RefreshCooldownSnapshot(reason)
		log("[SkillRuntimeState] cooldown advanced entity=" .. self.Entity.Name .. " elapsed=" .. normalizedTurns .. " reason=" .. reason .. " snapshot=" .. self.CooldownSnapshot)
	end

	@ExecSpace("ServerOnly")
	method table ReduceCooldown(string skillId, integer amount)
		-- Mutates the existing turn-based cooldown and publishes the same HUD snapshot.
		local before = self:GetRemainingCooldown(skillId)
		if amount <= 0 or before <= 0 then
			return { Success = false, Reason = "SKILL_NOT_ON_COOLDOWN", AppliedAmount = 0 }
		end
		local after = math.max(0, before - amount)
		self.RemainingCooldowns[skillId] = after > 0 and after or nil
		self:RefreshCooldownSnapshot("TIME_SAND")
		log("[BattleConsumable] cooldown skill=" .. skillId .. " before=" .. before .. " after=" .. after)
		return { Success = true, Reason = "COOLDOWN_REDUCED", AppliedAmount = before - after, CooldownBefore = before, CooldownAfter = after }
	end

	@ExecSpace("ServerOnly")
	method void EnsureCooldownTable()
		if self.RemainingCooldowns == nil then
			self.RemainingCooldowns = {}
		end
	end

	@ExecSpace("ServerOnly")
	method void RefreshCooldownSnapshot(string reason)
		self:EnsureCooldownTable()
		local skillIds = {}
		for skillId, remainingTurns in pairs(self.RemainingCooldowns) do
			if math.floor(tonumber(remainingTurns) or 0) > 0 then
				table.insert(skillIds, skillId)
			end
		end
		table.sort(skillIds)

		local entries = {}
		for _, skillId in ipairs(skillIds) do
			table.insert(entries, skillId .. ":" .. self:GetRemainingCooldown(skillId))
		end
		self.CooldownSnapshot = table.concat(entries, "|")
		self.CooldownRevision = self.CooldownRevision + 1
		log("[SkillRuntimeState] snapshot entity=" .. self.Entity.Name .. " revision=" .. self.CooldownRevision .. " reason=" .. reason .. " value=" .. self.CooldownSnapshot)
	end

end
