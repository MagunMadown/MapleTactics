@Component
script HidePlayerOnMapComponent extends Component

	-- Attach to a map entity whose scene should not show the player's avatar or name tag.
	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- Re-apply every frame so late spawns and avatar refreshes cannot re-show the player.
		local player = _UserService.LocalPlayer
		if isvalid(player) == false or player.CurrentMap ~= self.Entity then
			return
		end
		if player.AvatarRendererComponent ~= nil and player.AvatarRendererComponent.Enable then
			player.AvatarRendererComponent.Enable = false
		end
		if player.NameTagComponent ~= nil and player.NameTagComponent.Enable then
			player.NameTagComponent.Enable = false
		end
	end

end
