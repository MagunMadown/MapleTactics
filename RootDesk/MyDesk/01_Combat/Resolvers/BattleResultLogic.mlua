@Logic
script BattleResultLogic extends Logic

	@ExecSpace("ServerOnly")
	method table ForfeitToLobby(any session)
		-- Menu "return to lobby": ends a running battle as an abandoned run, then reuses the defeat return.
		if isvalid(session.PlayerEntity) == false then
			return { Success = false, Reason = "PLAYER_MISSING" }
		end
		session:ClearSkillImpactTimers()
		if session.ActionTimerId > 0 then
			_TimerService:ClearTimer(session.ActionTimerId)
			session.ActionTimerId = 0
		end
		if session.BattleResult == "" then
			session.TurnState:ClearTransientState("PLAYER_FORFEIT")
			session.TurnState:SetPhase("BattleEnded", "PLAYER_FORFEIT")
			session:PublishTurnStateSnapshot("PLAYER_FORFEIT")
			session.WaveRuntime:SetWaveState("Failed", "PLAYER_FORFEIT")
			session.WaveRuntime:CancelPendingSpawns("PLAYER_FORFEIT")
			session:PublishWaveStateSnapshot("PLAYER_FORFEIT")
			if session.DropRuntime ~= nil then session.DropRuntime:DiscardPending("BATTLE_FORFEIT") end
			local playerUnit = session.PlayerEntity:GetComponent("script.BattleUnitComponent")
			if playerUnit ~= nil then playerUnit:ClearAttackBuffs() end
			local relics = session.PlayerEntity:GetComponent("script.PlayerRunRelicEffectComponent")
			if relics ~= nil then relics:EndBattleEffects() end
		end
		session.BattleResult = "Defeat"
		local resetResult = _RunManagerLogic:AbandonRun(session.PlayerEntity, "MENU_LOBBY_RETURN")
		if resetResult.Success == false then
			session.BattleResult = ""
			return resetResult
		end
		session.ResultDefeatReset = resetResult
		log("[BattleForfeit] run abandoned stage=" .. tostring(session.StageId) .. " turn=" .. tostring(session.TurnNumber))
		local returned = session:ReturnToLobbyAfterDefeat()
		_NewPlayerTutorialLogic:ReleaseAfterReturn(session, returned)
		return returned
	end

	@ExecSpace("ServerOnly")
	method table ReturnToLobbyAfterDefeat(any session)
		-- Resets the failed run and its entry payload before requesting the authoritative lobby transfer.
		if session.BattleResult ~= "Defeat" then
			return { Success = false, Reason = "BATTLE_NOT_DEFEATED" }
		end
		if isvalid(session.PlayerEntity) == false then
			return { Success = false, Reason = "PLAYER_MISSING" }
		end
		local entryState = _BattleGatewayLogic:GetOrCreateEntryState(session.PlayerEntity)
		if entryState == nil then
			return { Success = false, Reason = "ENTRY_STATE_UNAVAILABLE" }
		end

		local resetResult = session.ResultDefeatReset
		if resetResult.Success ~= true then
			resetResult = _RunManagerLogic:ResetFailedRun(session.PlayerEntity, "BATTLE_DEFEAT_RETURN")
			if resetResult.Success then session.ResultDefeatReset = resetResult end
		end
		if resetResult.Success == false then
			return resetResult
		end
		entryState:ResetToIdle("BATTLE_DEFEAT_RETURN")
		session.BattleResult = ""
		session.PlayerExitObservedAfterBattle = true
		log("[BattleDefeatReturn] map session result cleared and fresh entry armed before transfer")
		local navigationResult = _MapTeleportManager:TeleportPlayer(
			session.PlayerEntity,
			"lobby",
			Vector3(-27.3686, -7.92, 0),
			"BATTLE_DEFEAT_RETURN"
		)
		if navigationResult.Success == false then
			session.WaveRuntime:CancelPendingSpawns("PLAYER_DEFEATED")
			session.BattleResult = "Defeat"
			session.PlayerExitObservedAfterBattle = false
			return navigationResult
		end
		log("[BattleDefeatReturn] completed player=" .. session.PlayerEntity.Name .. " previousSequence=" .. resetResult.RunSequence .. " destination=lobby")
		return { Success = true, Reason = "LOBBY_TRANSFER_REQUESTED", RunSequence = resetResult.RunSequence }
	end

	@ExecSpace("ServerOnly")
	method void ResetUnionRewardPresentation(any session, string reason)
		-- Clears the previous run receipt before building the next battle snapshot.
		session.UnionRewardRunId = 0
		session.UnionRewardBasePoints = 0
		session.UnionRewardBonusPoints = 0
		session.UnionRewardFinalPoints = 0
		session.UnionRewardAscensionLevel = 0
		session.UnionRewardAscensionCoinMultiplier = 1
		session.UnionRewardUnionBonusPoints = 0
		session.UnionRewardAscensionBonusPoints = 0
		session.UnionRewardFirstClearCoinBonus = 0
		session.UnionRewardWasCommitted = false
		session.UnionRewardWasDuplicate = false
		session.UnionRewardRunEnded = false
		session.UnionRewardRunEndReason = reason or ""
		session.UnionRewardRevision = session.UnionRewardRevision + 1
	end

	@ExecSpace("ServerOnly")
	method void RefreshUnionRewardPresentation(any session)
		-- Copies the committed server receipt and its bonus categories into client-safe sync fields.
		if isvalid(session.PlayerEntity) == false then
			return
		end
		local snapshot = _UnionRewardServiceLogic:GetRunRewardSnapshot(session.PlayerEntity)
		if snapshot.Success == false then
			log_warning("[BattleResult] Union reward snapshot unavailable reason=" .. snapshot.Reason)
			return
		end
		session.UnionRewardRunId = snapshot.RewardRunId or 0
		session.UnionRewardBasePoints = snapshot.BaseUnionPoints or 0
		session.UnionRewardBonusPoints = snapshot.BonusUnionPoints or 0
		session.UnionRewardFinalPoints = snapshot.FinalUnionPoints or 0
		session.UnionRewardAscensionLevel = snapshot.AscensionLevel or 0
		session.UnionRewardAscensionCoinMultiplier = snapshot.AscensionCoinMultiplier or 1
		session.UnionRewardUnionBonusPoints = snapshot.UnionBonusUnionPoints or snapshot.BonusUnionPoints or 0
		session.UnionRewardAscensionBonusPoints = snapshot.AscensionBonusUnionPoints or 0
		session.UnionRewardFirstClearCoinBonus = snapshot.FirstClearCoinBonus or 0
		session.UnionRewardWasCommitted = snapshot.WasCommitted == true
		session.UnionRewardWasDuplicate = snapshot.WasDuplicate == true
		session.UnionRewardRunEnded = snapshot.RunEnded == true
		session.UnionRewardRunEndReason = snapshot.RunEndReason or ""
		session.UnionRewardRevision = session.UnionRewardRevision + 1
		log("[BattleResult] Union reward runId=" .. session.UnionRewardRunId .. " base=" .. session.UnionRewardBasePoints .. " bonus=" .. session.UnionRewardBonusPoints .. " final=" .. session.UnionRewardFinalPoints .. " ascension=" .. session.UnionRewardAscensionLevel .. " multiplier=" .. session.UnionRewardAscensionCoinMultiplier .. " unionBonus=" .. session.UnionRewardUnionBonusPoints .. " ascensionBonus=" .. session.UnionRewardAscensionBonusPoints .. " firstClear=" .. session.UnionRewardFirstClearCoinBonus .. " committed=" .. tostring(session.UnionRewardWasCommitted) .. " ended=" .. tostring(session.UnionRewardRunEnded))
	end

	@ExecSpace("ServerOnly")
	method void RecordRunConsumedPlayerTurn(any session)
		-- Observes successful handoff or wave-clearing execution; enemy turns and duplicate commits are excluded.
		if session.TurnState == nil or session.TurnState.BattlePhase ~= "PlayerTurn" or isvalid(session.PlayerEntity) == false then
			return
		end
		local combatStats = session.PlayerEntity:GetComponent("script.PlayerRunCombatStatsComponent")
		if combatStats == nil then
			return
		end
		local consumptionKey = tostring(session.Entity.Id) .. ":" .. session.StageId .. ":" .. tostring(session.EntryRequestId)
			.. ":" .. tostring(session.HudContextRevision) .. ":" .. tostring(session.TurnState.StateRevision)
		combatStats:RecordConsumedTurn(consumptionKey)
	end

	@ExecSpace("ServerOnly")
	method void RecordRoundReward(any session, string rewardType, string refId, integer amount, string receipt)
		-- Capture accepted grants, never inventory differences: using an item cannot erase its pickup.
		amount = math.max(0, math.floor(amount or 0))
		if amount == 0 or session.StageId == "" or session._T.RoundRewardEntries == nil then return end
		local key = rewardType .. "~" .. refId
		local receiptKey = receipt .. ":" .. key
		if session._T.RoundRewardReceipts[receiptKey] then return end
		session._T.RoundRewardReceipts[receiptKey] = true
		local entry = session._T.RoundRewardEntries[key]
		if entry == nil then
			local name, icon = refId, ""
			if rewardType == "CONSUMABLE" then
				local definition = _ConsumableDefinitionRepositoryLogic:GetDefinition(refId)
				if definition.Success then name = definition.DisplayName; icon = definition.IconKey end
			elseif rewardType == "ITEM" then
				local relics = session.PlayerEntity:GetComponent("script.PlayerRunRelicEffectComponent")
				local definition = relics ~= nil and relics.Definitions[refId] or nil
				if definition ~= nil then name = definition.DisplayName; icon = definition.IconImageRUID or "" end
			elseif rewardType == "REROLL" then name = "증강 리롤권"
			elseif rewardType == "HEAL_CHARGE" then
				name = "힐 사용 횟수"
				local definition = _SkillDefinitionRepositoryLogic:GetSkillDefinition("heal")
				if definition.Success then icon = definition.IconRuid or "" end
			elseif rewardType == "CURRENCY" and refId == "gold" then name = "메소" end
			local cleanedText, replacementCount = string.gsub(name, "[|~]", " ")
			name = cleanedText
			entry = { Type = rewardType, Id = refId, Amount = 0, Name = name, Icon = icon }
			session._T.RoundRewardEntries[key] = entry
		end
		entry.Amount = entry.Amount + amount
		if rewardType == "CURRENCY" and refId == "gold" then session.ResultGold = session.ResultGold + amount end
		local keys, rows = {}, {}
		for id, _ in pairs(session._T.RoundRewardEntries) do table.insert(keys, id) end
		table.sort(keys)
		for _, id in ipairs(keys) do
			local item = session._T.RoundRewardEntries[id]
			table.insert(rows, item.Type .. "~" .. item.Id .. "~" .. tostring(item.Amount) .. "~" .. item.Name .. "~" .. item.Icon)
		end
		session.ResultRewardSnapshot = table.concat(rows, "|")
		log("[RoundReward] received=" .. key .. " amount=" .. amount .. " total=" .. entry.Amount)
	end

	@ExecSpace("ServerOnly")
	method void ContinueResult(any session)
		-- Continues a validated result with the original entry checks around yielding work.
		if _NewPlayerTutorialLogic:TryFinishSession(session) ~= nil then return end
		if session.ResultRecorded == false then
			local resultContext = session:CaptureBattleResultContext()
			local recorded = _RunManagerLogic:RecordBattleResult(session.PlayerEntity, session.StageId, session.StageNumber, session.BattleResult, session.EntryRequestId)
			if session:IsBattleResultContextCurrent(resultContext) == false then
				log_warning("[BattleResult] stale result retry cancelled")
				return
			end
			session.ResultRecorded = recorded
			if session.ResultRecorded then session:RefreshUnionRewardPresentation() end
		end
		if session.ResultRecorded == false then session.ResultReady = true return end
		if session.BattleResult == "Defeat" then
			local result = session:ReturnToLobbyAfterDefeat()
			if result.Success == false then session.ResultReady = true end
			session:PublishPlayerCommandResult("RETURN_TO_LOBBY", result)
			return
		end
		local transitionContext = session:CaptureBattleResultContext()
		if transitionContext == nil then return end
		-- A normal victory transition prepares the next entry on the same player component before teleporting.
		transitionContext.AllowPlayerEntryAdvance = true
		if session.UnionRewardRunEnded and session.UnionRewardWasCommitted then
			_StageTransitionManagerLogic:HandleCompletedRunTransition(session.PlayerEntity)
		else
			_StageTransitionManagerLogic:HandleVictoryTransition(session.PlayerEntity, session.StageId)
		end
		if session:IsBattleResultContextCurrent(transitionContext) == false then return end
		local retryContext = session:CaptureBattleResultContext()
		session.ResultTransitionTimerId = _TimerService:SetTimerOnce(function()
			if session:IsBattleResultContextCurrent(retryContext) == false then return end
			session.ResultTransitionTimerId = 0
			session.ResultReady = true
		end, 8)
	end

end
