@Logic
script EnemyTraitRouterLogic extends Logic

	@ExecSpace("ServerOnly")
	method table BuildActionPlan(string traitIds, table baseIntent, boolean isBoss)
		-- Traits decorate an already-resolved pattern intent; they do not own pattern or board state.
		local result = { Success = false, Reason = "INVALID_BASE_INTENT", Actions = {}, TraitIds = traitIds or "" }
		if baseIntent == nil or baseIntent.ActionType == nil or baseIntent.ActionType == "" then
			return result
		end
		table.insert(result.Actions, self:CopyIntent(baseIntent))

		if self:HasTrait(traitIds, "DOUBLE_STRIKE") and baseIntent.ActionType == "EXECUTE_TILE" then
			local repeated = self:CopyIntent(baseIntent)
			repeated.Reason = "TRAIT_DOUBLE_STRIKE"
			table.insert(result.Actions, repeated)
		end

		-- Shogun Showdown-style default: ordinary enemies step away after resolving
		-- an attack. AGGRO reverses that movement; HOLD_POSITION opts out. Bosses
		-- author their recovery movement explicitly in EnemyPatternSteps.
		if baseIntent.ActionType == "EXECUTE_TILE" and isBoss ~= true then
			local postAttackActionType = self:GetPostAttackActionType(traitIds)
			if postAttackActionType ~= "" then
				local postAttackAction = self:CopyIntent(baseIntent)
				postAttackAction.ActionType = postAttackActionType
				postAttackAction.TileId = ""
				postAttackAction.Direction = 0
				postAttackAction.TelegraphTurnsRemaining = 0
				postAttackAction.Reason = "POST_ATTACK_" .. postAttackActionType
				table.insert(result.Actions, postAttackAction)
			end
		end

		result.Success = true
		result.Reason = "PLAN_BUILT"
		return result
	end

	method table CopyIntent(table intent)
		return {
			ActionType = intent.ActionType,
			TileId = intent.TileId or "",
			Direction = math.floor(tonumber(intent.Direction) or 0),
			Reason = intent.Reason or "PLANNED",
			PatternId = intent.PatternId or "",
			StepIndex = math.max(1, math.floor(tonumber(intent.StepIndex) or 1)),
			PatternStepCount = math.max(0, math.floor(tonumber(intent.PatternStepCount) or 0)),
			TelegraphTurnsRemaining = math.max(0, math.floor(tonumber(intent.TelegraphTurnsRemaining) or 0))
		}
	end

	method boolean HasTrait(string traitIds, string traitId)
		for currentTraitId in string.gmatch(traitIds or "", "([^|]+)") do
			if currentTraitId == traitId then
				return true
			end
		end
		return false
	end

	method string GetPostAttackActionType(string traitIds)
		if self:HasTrait(traitIds, "HOLD_POSITION") then
			return ""
		end
		if self:HasTrait(traitIds, "AGGRO") then
			return "MOVE_TOWARD"
		end
		return "MOVE_AWAY"
	end

	method number GetEnemyThinkDuration(string traitIds, number defaultDuration)
		if self:HasTrait(traitIds, "QUICK") then
			return math.min(math.max(0.05, defaultDuration), 0.05)
		end
		return math.max(0.05, defaultDuration)
	end

	method boolean BlocksForcedDisplacement(string traitIds)
		return self:HasTrait(traitIds, "HEAVY")
	end

	method table ValidateTraitIds(string traitIds)
		local supported = { QUICK = true, HEAVY = true, DOUBLE_STRIKE = true, EXPLOSIVE = true, REACTIVE_SHIELD = true, AGGRO = true, HOLD_POSITION = true }
		local seen = {}
		for traitId in string.gmatch(traitIds or "", "([^|]+)") do
			if supported[traitId] ~= true then
				return { Success = false, Reason = "UNSUPPORTED_ENEMY_TRAIT", TraitId = traitId }
			end
			if seen[traitId] == true then
				return { Success = false, Reason = "DUPLICATE_ENEMY_TRAIT", TraitId = traitId }
			end
			seen[traitId] = true
		end
		if seen.AGGRO == true and seen.HOLD_POSITION == true then
			return { Success = false, Reason = "CONFLICTING_POST_ATTACK_TRAITS", TraitId = "AGGRO|HOLD_POSITION" }
		end
		return { Success = true, Reason = "OK" }
	end

end
