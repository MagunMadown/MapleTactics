@Logic
script ConsumableEffectRouterLogic

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- Reports the closed primitive router while effect behavior remains in independent handler objects.
		log("[ConsumableEffect] router ready types=HEAL,COOLDOWN_REDUCTION,CLEANSE")
	end

	@ExecSpace("ServerOnly")
	method table Execute(table definition, any targetUnit, string targetSkillId)
		-- Routes a validated definition to an independent primitive-effect object.
		if definition == nil then
			return { Success = false, Reason = "CONSUMABLE_DEFINITION_MISSING" }
		end
		if targetUnit == nil or targetUnit.IsDead then
			return { Success = false, Reason = "TARGET_UNIT_UNAVAILABLE" }
		end
		if definition.EffectType == "HEAL" then
			return _ConsumableHealEffectLogic:Execute(definition, targetUnit)
		end
		if definition.EffectType == "COOLDOWN_REDUCTION" then
			local inventory = targetUnit.Entity:GetComponent("script.PlayerRunInventoryComponent")
			local runtime = targetUnit.Entity:GetComponent("script.SkillRuntimeStateComponent")
			if inventory == nil or runtime == nil or targetSkillId == nil or targetSkillId == "" then
				return { Success = false, Reason = "INVALID_SKILL_TARGET" }
			end
			if inventory:CanUseSkill(targetSkillId).Success ~= true then
				return { Success = false, Reason = "SKILL_NOT_OWNED" }
			end
			return runtime:ReduceCooldown(targetSkillId, math.floor(definition.EffectValue))
		end
		if definition.EffectType == "CLEANSE" then
			local cleanse = targetUnit:RemoveNegativeStatusEffects()
			if cleanse.Success ~= true or (cleanse.AppliedAmount or 0) <= 0 then
				return { Success = false, Reason = cleanse.Reason or "NO_NEGATIVE_STATUS_EFFECTS", AppliedAmount = 0 }
			end
			return cleanse
		end
		return { Success = false, Reason = "CONSUMABLE_EFFECT_NOT_REGISTERED", EffectType = definition.EffectType }
	end

end
