@Logic
script ConsumableEffectRouterLogic

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- Reports the closed primitive router while effect behavior remains in independent handler objects.
		log("[ConsumableEffect] router ready types=HEAL")
	end

	@ExecSpace("ServerOnly")
	method table Execute(table definition, any targetUnit)
		-- Routes a validated definition to an independent primitive-effect object.
		if definition == nil then
			return { Success = false, Reason = "CONSUMABLE_DEFINITION_MISSING" }
		end
		if definition.EffectType == "HEAL" then
			return _ConsumableHealEffectLogic:Execute(definition, targetUnit)
		end
		return { Success = false, Reason = "CONSUMABLE_EFFECT_NOT_REGISTERED", EffectType = definition.EffectType }
	end

end
