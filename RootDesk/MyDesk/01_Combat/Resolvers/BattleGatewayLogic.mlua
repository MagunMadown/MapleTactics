@Logic
script BattleGatewayLogic extends Logic

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		log("[BattleGateway] ready")
	end

	@ExecSpace("ServerOnly")
	method any GetOrCreateEntryState(Entity playerEntity)
		if isvalid(playerEntity) == false or playerEntity.PlayerComponent == nil then
			log_error("[BattleGateway] entry state unavailable reason=INVALID_PLAYER")
			return nil
		end

		local entryState = playerEntity:GetComponent("script.BattleEntryStateComponent")
		if entryState == nil then
			entryState = playerEntity:AddComponent("BattleEntryStateComponent")
		end
		if entryState == nil then
			log_error("[BattleGateway] entry state unavailable reason=COMPONENT_ATTACH_FAILED player=" .. playerEntity.Name)
			return nil
		end
		return entryState
	end

	@ExecSpace("ServerOnly")
	method table PrepareBattleEntry(Entity playerEntity, string stageId, string characterId, string jobId, string loadoutId, integer runSeed, string entryMode)
		local entryState = self:GetOrCreateEntryState(playerEntity)
		if entryState == nil then
			return {
				Success = false,
				Reason = "ENTRY_STATE_UNAVAILABLE",
				RequestId = 0
			}
		end
		return entryState:Prepare(stageId, characterId, jobId, loadoutId, runSeed, entryMode)
	end

	@ExecSpace("Server")
	method void RequestPrepareBattleEntry(string stageId, string characterId, string jobId, string loadoutId, integer runSeed, string entryMode)
		local playerEntity = _UserService:GetUserEntityByUserId(senderUserId)
		local result = self:PrepareBattleEntry(playerEntity, stageId, characterId, jobId, loadoutId, runSeed, entryMode)
		if result.Success == false then
			log_warning("[BattleGateway] prepare rejected user=" .. senderUserId .. " reason=" .. result.Reason)
		end
	end

	@ExecSpace("ServerOnly")
	method table PrepareLobbyBattleEntry(Entity playerEntity)
		-- High-level lobby boundary: callers do not fabricate optional compatibility metadata.
		local context = _RunManagerLogic:GetLobbyBattleEntryContext(playerEntity)
		if context.Success == false then
			return { Success = false, Reason = context.Reason, RequestId = 0 }
		end
		return self:PrepareBattleEntry(
			playerEntity,
			context.StageId,
			context.CharacterId,
			context.JobId,
			context.LoadoutId,
			context.RunSeed,
			context.EntryMode
		)
	end

	@ExecSpace("ServerOnly")
	method table PrepareLobbyStageEntry(Entity playerEntity, string requestedStageId)
		-- Validates a world-map stage selection against the authoritative lobby run context.
		local context = _RunManagerLogic:GetLobbyBattleEntryContext(playerEntity)
		if context.Success == false then
			return { Success = false, Reason = context.Reason, RequestId = 0 }
		end
		if requestedStageId == nil or requestedStageId == "" then
			return { Success = false, Reason = "INVALID_STAGE_ID", RequestId = 0 }
		end
		if context.StageId ~= requestedStageId then
			log_warning("[BattleGateway] world map stage rejected requested=" .. requestedStageId .. " expected=" .. context.StageId)
			return { Success = false, Reason = "STAGE_NOT_AVAILABLE", RequestId = 0 }
		end
		return self:PrepareBattleEntry(
			playerEntity,
			context.StageId,
			context.CharacterId,
			context.JobId,
			context.LoadoutId,
			context.RunSeed,
			context.EntryMode
		)
	end

	@ExecSpace("Server")
	method void RequestPrepareLobbyStageEntry(string requestedStageId)
		-- Prepares and transfers the stage selected from the lobby world map.
		local playerEntity = _UserService:GetUserEntityByUserId(senderUserId)
		local result = self:PrepareLobbyStageEntry(playerEntity, requestedStageId)
		if result.Success == false then
			log_warning("[BattleGateway] world map prepare rejected user=" .. senderUserId .. " stage=" .. requestedStageId .. " reason=" .. result.Reason)
			self:NotifyLobbyBattleEntryResult(false, result.Reason, requestedStageId, senderUserId)
			return
		end
		local transferResult = self:TransferPreparedLobbyBattleEntry(playerEntity, result.RequestId)
		if transferResult.Success == false then
			log_warning("[BattleGateway] world map transfer rejected user=" .. senderUserId .. " stage=" .. requestedStageId .. " reason=" .. transferResult.Reason)
			self:NotifyLobbyBattleEntryResult(false, transferResult.Reason, requestedStageId, senderUserId)
			return
		end
		self:NotifyLobbyBattleEntryResult(true, transferResult.Reason, requestedStageId, senderUserId)
	end

	@ExecSpace("Server")
	method void RequestPrepareLobbyBattleEntry()
		-- Prepares and transfers one lobby entry, then reports the result to the requesting client's button.
		local playerEntity = _UserService:GetUserEntityByUserId(senderUserId)
		local result = self:PrepareLobbyBattleEntry(playerEntity)
		if result.Success == false then
			log_warning("[BattleGateway] lobby prepare rejected user=" .. senderUserId .. " reason=" .. result.Reason)
			self:NotifyLobbyBattleEntryResult(false, result.Reason, "", senderUserId)
			return
		end
		local transferResult = self:TransferPreparedLobbyBattleEntry(playerEntity, result.RequestId)
		if transferResult.Success == false then
			log_warning("[BattleGateway] lobby transfer rejected user=" .. senderUserId .. " request=" .. result.RequestId .. " reason=" .. transferResult.Reason)
			self:NotifyLobbyBattleEntryResult(false, transferResult.Reason, "", senderUserId)
			return
		end
		self:NotifyLobbyBattleEntryResult(true, transferResult.Reason, "", senderUserId)
	end

	@ExecSpace("Client")
	method void NotifyLobbyBattleEntryResult(boolean success, string reason, string requestedStageId)
		-- Forwards only the request outcome to the lobby UI; the UI never performs battle or transfer work.
		local uiRoot = _EntityService:GetEntityByPath("/ui/DefaultGroup")
		if isvalid(uiRoot) == false then
			log_warning("[Lobby] battle entry result ignored reason=UI_ROOT_MISSING")
			return
		end
		local startButton = uiRoot:GetComponent("script.LobbyStartButtonComponent")
		if startButton == nil then
			log_warning("[Lobby] battle entry result ignored reason=START_BUTTON_COMPONENT_MISSING")
		else
			startButton:HandleBattleEntryResult(success, reason)
		end
		local stageNodePath = "/ui/PopupGroup/MapTeleportPopup/HenesysCityBranchBtn"
		if requestedStageId == "region_01_stage_02" then
			local localPlayer = _UserService.LocalPlayer
			local runState = nil
			if isvalid(localPlayer) then
				runState = localPlayer:GetComponent("script.PlayerRunStateComponent")
			end
			if runState ~= nil and runState.SelectedWorldMapBranch == "LOWER" then
				stageNodePath = "/ui/PopupGroup/MapTeleportPopup/ElliniaBranchBtn"
			else
				stageNodePath = "/ui/PopupGroup/MapTeleportPopup/KerningCityBranchBtn"
			end
		elseif requestedStageId == "region_01_stage_03" then
			stageNodePath = "/ui/PopupGroup/MapTeleportPopup/PerionCityBranchBtn"
		elseif requestedStageId == "region_01_stage_04" then
			stageNodePath = "/ui/PopupGroup/MapTeleportPopup/ElliniaBranchBtn"
		end
		local stageNode = _EntityService:GetEntityByPath(stageNodePath)
		if isvalid(stageNode) then
			local stageButton = stageNode:GetComponent("script.WorldMapStageButtonComponent")
			if stageButton ~= nil then
				stageButton:HandleEntryResult(success, reason)
			end
		else
			log_warning("[WorldMap] stage entry result ignored reason=STAGE_NODE_MISSING")
		end
	end

	@ExecSpace("ServerOnly")
	method table TransferPreparedLobbyBattleEntry(Entity playerEntity, integer requestId)
		local result = { Success = false, Reason = "UNKNOWN", RequestId = requestId }
		if isvalid(playerEntity) == false or playerEntity.PlayerComponent == nil then
			result.Reason = "INVALID_PLAYER"
			log_warning("[BattleGateway] transfer blocked request=" .. tostring(requestId) .. " reason=" .. result.Reason)
			return result
		end

		local entryState = playerEntity:GetComponent("script.BattleEntryStateComponent")
		if entryState == nil then
			result.Reason = "ENTRY_STATE_UNAVAILABLE"
			log_warning("[BattleGateway] transfer blocked request=" .. tostring(requestId) .. " reason=" .. result.Reason)
			return result
		end
		if entryState.EntryState ~= "PREPARED" then
			result.Reason = "ENTRY_NOT_PREPARED"
			log_warning("[BattleGateway] transfer blocked request=" .. tostring(requestId) .. " reason=" .. result.Reason .. " state=" .. entryState.EntryState)
			return result
		end
		if entryState.RequestId ~= requestId then
			result.Reason = "ENTRY_REQUEST_MISMATCH"
			log_warning("[BattleGateway] transfer blocked request=" .. tostring(requestId) .. " reason=" .. result.Reason .. " current=" .. entryState.RequestId)
			return result
		end
		if entryState.StageId == nil or entryState.StageId == "" then
			result.Reason = "INVALID_STAGE_ID"
			log_warning("[BattleGateway] transfer blocked request=" .. tostring(requestId) .. " reason=" .. result.Reason)
			return result
		end
		log("[BattleGateway] lobby battle entry prepared stageId=" .. entryState.StageId .. " request=" .. requestId)

		local route = _StageMapRouteRepositoryLogic:GetMapRoute(entryState.StageId)
		if route == nil or route.Success ~= true then
			result.Reason = route == nil and "STAGE_MAP_ROUTE_RESULT_MISSING" or route.Reason
			log_warning("[BattleGateway] transfer blocked stageId=" .. entryState.StageId .. " request=" .. requestId .. " reason=" .. result.Reason)
			return result
		end
		if route.MapId == nil or route.MapId == "" then
			result.Reason = "STAGE_MAP_ROUTE_MAP_ID_MISSING"
			log_warning("[BattleGateway] transfer blocked stageId=" .. entryState.StageId .. " request=" .. requestId .. " reason=" .. result.Reason)
			return result
		end
		log("[BattleGateway] battle route resolved stageId=" .. entryState.StageId .. " mapId=" .. route.MapId)

		if entryState:TryMarkTransferRequested(requestId) == false then
			result.Reason = "DUPLICATE_TRANSFER_REQUEST"
			log_warning("[BattleGateway] transfer blocked stageId=" .. entryState.StageId .. " request=" .. requestId .. " reason=" .. result.Reason)
			return result
		end

		local spawnX = route.SpawnX or 0
		local spawnY = route.SpawnY or 0
		log("[BattleGateway] transferring player mapId=" .. route.MapId .. " spawn=(" .. tostring(spawnX) .. "," .. tostring(spawnY) .. ") request=" .. requestId)
		local navigationResult = _MapTeleportManager:TeleportPlayer(
			playerEntity,
			route.MapId,
			Vector3(spawnX, spawnY, 0),
			"LOBBY_BATTLE_ENTRY"
		)
		if navigationResult.Success == false then
			result.Reason = navigationResult.Reason
			log_warning("[BattleGateway] transfer dispatch failed stageId=" .. entryState.StageId .. " request=" .. requestId .. " reason=" .. result.Reason)
			return result
		end
		result.Success = true
		result.Reason = "TRANSFER_REQUESTED"
		result.StageId = entryState.StageId
		result.MapId = route.MapId
		result.SpawnX = spawnX
		result.SpawnY = spawnY
		return result
	end

	@ExecSpace("ServerOnly")
	method table StartPreparedBattle(Entity playerEntity)
		if isvalid(playerEntity) == false or playerEntity.PlayerComponent == nil then
			return {
				Success = false,
				Reason = "INVALID_PLAYER",
				RequestId = 0
			}
		end
		local entryState = self:GetOrCreateEntryState(playerEntity)
		if entryState == nil then
			return {
				Success = false,
				Reason = "ENTRY_STATE_UNAVAILABLE",
				RequestId = 0
			}
		end
		if entryState.EntryState ~= "PREPARED" then
			return {
				Success = false,
				Reason = "ENTRY_NOT_PREPARED",
				RequestId = entryState.RequestId
			}
		end
		local currentMap = playerEntity.CurrentMap
		if isvalid(currentMap) == false then
			return entryState:RecordFailure("CURRENT_MAP_UNAVAILABLE")
		end
		local battleSession = currentMap:GetComponent("script.BattleSessionComponent")
		if battleSession == nil then
			return entryState:RecordFailure("BATTLE_SESSION_NOT_FOUND")
		end
		return self:ConsumePreparedBattle(playerEntity, battleSession)
	end

	@ExecSpace("Server")
	method void RequestStartPreparedBattle()
		local playerEntity = _UserService:GetUserEntityByUserId(senderUserId)
		local result = self:StartPreparedBattle(playerEntity)
		if result.Success == false then
			log_warning("[BattleGateway] start rejected user=" .. senderUserId .. " reason=" .. result.Reason)
		end
	end

	@ExecSpace("ServerOnly")
	method table BeginBattle(Entity playerEntity, string stageId, string characterId, string jobId, string loadoutId, integer runSeed, string entryMode)
		local prepareResult = self:PrepareBattleEntry(playerEntity, stageId, characterId, jobId, loadoutId, runSeed, entryMode)
		if prepareResult.Success == false then
			return prepareResult
		end
		return self:StartPreparedBattle(playerEntity)
	end

	@ExecSpace("Server")
	method void RequestBeginBattle(string stageId, string characterId, string jobId, string loadoutId, integer runSeed, string entryMode)
		-- Single-call Client facade for flows where the player is already inside a battle map.
		local playerEntity = _UserService:GetUserEntityByUserId(senderUserId)
		local result = self:BeginBattle(playerEntity, stageId, characterId, jobId, loadoutId, runSeed, entryMode)
		if result.Success == false then
			log_warning("[BattleGateway] begin rejected user=" .. senderUserId .. " reason=" .. result.Reason)
		end
	end

	@ExecSpace("ServerOnly")
	method table ConsumePreparedBattle(Entity playerEntity, any battleSession)
		-- Claims the player-owned request before run initialization can yield to another map-entry callback.
		if isvalid(playerEntity) == false or battleSession == nil then
			return {
				Success = false,
				Reason = "INVALID_BATTLE_CONTEXT",
				RequestId = 0
			}
		end
		local entryState = self:GetOrCreateEntryState(playerEntity)
		if entryState == nil then
			return {
				Success = false,
				Reason = "ENTRY_STATE_UNAVAILABLE",
				RequestId = 0
			}
		end
		local claimResult = entryState:BeginInitialization()
		if claimResult.Success == false then
			log("[BattleGateway] duplicate consume ignored request=" .. entryState.RequestId .. " reason=" .. claimResult.Reason)
			return claimResult
		end

		local startResult = battleSession:InitializeFromEntry(
			playerEntity,
			entryState.StageId,
			entryState.CharacterId,
			entryState.JobId,
			entryState.LoadoutId,
			entryState.RunSeed,
			entryState.EntryMode,
			entryState.RequestId
		)
		if startResult.Success == false then
			-- A failed initialization must not remain eligible for the map re-entry poll.
			entryState:Cancel(startResult.Reason)
			log_warning("[BattleGateway] consume rejected request=" .. entryState.RequestId .. " reason=" .. startResult.Reason)
			return startResult
		end

		local markResult = entryState:MarkStarted()
		if markResult.Success == false then
			log_warning("[BattleGateway] start commit rejected request=" .. entryState.RequestId .. " reason=" .. markResult.Reason)
			return markResult
		end
		log("[BattleGateway] consumed request=" .. entryState.RequestId .. " stage=" .. entryState.StageId .. " result=" .. startResult.Reason)
		if markResult.Success == true then
			log("[BattleGateway] prepared battle consumed stageId=" .. entryState.StageId .. " request=" .. entryState.RequestId)
		end
		return {
			Success = markResult.Success,
			Reason = startResult.Reason,
			RequestId = entryState.RequestId,
			StageId = entryState.StageId
		}
	end

	@ExecSpace("ServerOnly")
	method table CancelBattleEntry(Entity playerEntity, string reason)
		local entryState = self:GetOrCreateEntryState(playerEntity)
		if entryState == nil then
			return {
				Success = false,
				Reason = "ENTRY_STATE_UNAVAILABLE",
				RequestId = 0
			}
		end
		return entryState:Cancel(reason)
	end

	@ExecSpace("Server")
	method void RequestCancelBattleEntry()
		local playerEntity = _UserService:GetUserEntityByUserId(senderUserId)
		local result = self:CancelBattleEntry(playerEntity, "CANCELLED_BY_PLAYER")
		if result.Success == false then
			log_warning("[BattleGateway] cancel rejected user=" .. senderUserId .. " reason=" .. result.Reason)
		end
	end

	@ExecSpace("ServerOnly")
	method table GetBattleEntrySnapshot(Entity playerEntity)
		local entryState = self:GetOrCreateEntryState(playerEntity)
		if entryState == nil then
			return {
				Success = false,
				Reason = "ENTRY_STATE_UNAVAILABLE"
			}
		end
		return entryState:GetSnapshot()
	end

end
