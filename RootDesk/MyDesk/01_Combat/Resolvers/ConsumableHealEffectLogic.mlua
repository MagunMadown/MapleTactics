@Logic
script ConsumableHealEffectLogic extends Logic

	@ExecSpace("ServerOnly")
	method table Execute(table definition, any targetUnit)
		-- Delegates HP mutation to the target unit owner and returns a normalized effect result.
		if targetUnit == nil then
			return { Success = false, Reason = "TARGET_UNIT_MISSING", AppliedAmount = 0 }
		end
		local amount = definition.EffectValue
		if targetUnit.Team == "Player" then
			local relics = targetUnit.Entity:GetComponent("script.PlayerRunRelicEffectComponent")
			if relics ~= nil then amount = amount + relics:GetSpecialEffectValue("CONSUMABLE_HEAL_BONUS") end
		end
		local healing = targetUnit:ApplyHealing(amount)
		return {
			Success = healing.Success,
			Reason = healing.Reason,
			AppliedAmount = healing.AppliedAmount or 0,
			HpBefore = healing.HpBefore or -1,
			HpAfter = healing.HpAfter or -1,
			EffectType = definition.EffectType
		}
	end

end
