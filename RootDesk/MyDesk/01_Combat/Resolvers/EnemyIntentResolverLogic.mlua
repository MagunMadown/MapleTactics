@Logic
script EnemyIntentResolverLogic extends Logic

	@ExecSpace("ServerOnly")
	method table ResolvePatternIntent(table context, table steps)
		-- Traverses failure branches from the runner-owned current Step without owning mutable enemy state.
		local intent = self:CreateWaitIntent("INVALID_CONTEXT", "")
		if context == nil then
			return intent
		end
		intent.PatternId = context.PatternId or ""
		if steps == nil or #steps == 0 then
			intent.Reason = "PATTERN_STEPS_EMPTY"
			return intent
		end
		intent.PatternStepCount = #steps

		local enemyCell = context.EnemyCellIndex
		local playerCell = context.PlayerCellIndex
		if enemyCell == nil or playerCell == nil then
			intent.Reason = "CELL_CONTEXT_MISSING"
			return intent
		end
		local cellDelta = playerCell - enemyCell
		if cellDelta == 0 then
			intent.Reason = "SAME_CELL"
			return intent
		end
		local distance = math.abs(cellDelta)
		local playerDirection = 1
		if cellDelta < 0 then
			playerDirection = -1
		end
		local facingDirection = -1
		if context.EnemyFacing == "Right" then
			facingDirection = 1
		end

		local stepsByIndex = {}
		for _, step in ipairs(steps) do
			stepsByIndex[step.StepIndex] = step
		end
		local currentStepIndex = math.max(1, math.floor(tonumber(context.StartStepIndex) or 1))
		local visited = {}
		for attempt = 1, #steps do
			local step = stepsByIndex[currentStepIndex]
			if step == nil then
				intent.Reason = "PATTERN_STEP_NOT_FOUND"
				intent.StepIndex = currentStepIndex
				return intent
			end
			if self:IsConditionSatisfied(context, step, distance) == true
				and self:IsActionApplicable(step.ActionType, enemyCell, playerCell, playerDirection, facingDirection) == true then
				return self:CreateIntentFromStep(context, step, playerDirection, facingDirection, #steps)
			end
			visited[currentStepIndex] = true
			local nextStepIndex = step.NextStepOnFailure
			if nextStepIndex == nil or nextStepIndex <= 0 then
				nextStepIndex = currentStepIndex + 1
				if nextStepIndex > #steps then
					nextStepIndex = 1
				end
			end
			if visited[nextStepIndex] == true then
				intent.Reason = "PATTERN_FAILURE_BRANCH_CYCLE"
				intent.StepIndex = currentStepIndex
				return intent
			end
			currentStepIndex = nextStepIndex
		end

		intent.Reason = "NO_APPLICABLE_PATTERN_STEP"
		return intent
	end

	method boolean IsConditionSatisfied(table context, table step, integer distance)
		if step.ConditionType == "ALWAYS" then
			return true
		elseif step.ConditionType == "DISTANCE_EQ" then
			return distance == math.floor(tonumber(step.ParamA) or -1)
		elseif step.ConditionType == "DISTANCE_LE" then
			return distance <= math.floor(tonumber(step.ParamA) or -1)
		elseif step.ConditionType == "HP_RATIO_LE" then
			local maxHp = tonumber(context.EnemyMaxHp) or 0
			if maxHp <= 0 then
				return false
			end
			local hpRatio = (tonumber(context.EnemyCurrentHp) or 0) / maxHp
			return hpRatio <= (tonumber(step.ParamA) or -1)
		elseif step.ConditionType == "CELL_FREE" then
			local cellFreeBySelector = context.CellFreeBySelector
			if cellFreeBySelector == nil then
				return false
			end
			return cellFreeBySelector[step.ParamA or ""] == true
		end
		return false
	end

	method boolean IsActionApplicable(string actionType, integer enemyCell, integer playerCell, integer playerDirection, integer facingDirection)
		-- Action applicability prevents no-op TURN rows and attacks through the enemy's back side.
		if actionType == "TURN_TO_PLAYER" then
			return facingDirection ~= playerDirection
		elseif actionType == "EXECUTE_TILE" then
			-- The Pattern condition owns distance and the Skill definition owns target range.
			-- This applicability check only prevents an attack through the enemy's back side.
			return facingDirection == playerDirection
		end
		return true
	end

	method table CreateIntentFromStep(table context, table step, integer playerDirection, integer facingDirection, integer stepCount)
		local direction = 0
		if step.ActionType == "TURN_TO_PLAYER" or step.ActionType == "MOVE_TOWARD" then
			direction = playerDirection
		elseif step.ActionType == "MOVE_AWAY" then
			direction = -playerDirection
		elseif step.ActionType == "MOVE_FIXED_FACING" then
			direction = facingDirection
		end
		local telegraphTurnsRemaining = 0
		if step.ActionType == "TELEGRAPH_TILE" then
			telegraphTurnsRemaining = math.floor(tonumber(context.TelegraphTurnsRemaining) or 0)
			if telegraphTurnsRemaining <= 0 then
				telegraphTurnsRemaining = math.max(1, math.floor(tonumber(step.TelegraphTurns) or 0))
			end
		end
		return {
			ActionType = step.ActionType,
			TileId = step.TileId or "",
			Direction = direction,
			Reason = "PATTERN_STEP_SELECTED",
			PatternId = context.PatternId or "",
			StepIndex = step.StepIndex,
			PatternStepCount = stepCount,
			TelegraphTurnsRemaining = telegraphTurnsRemaining
		}
	end

	method table CreateWaitIntent(string reason, string patternId)
		return {
			ActionType = "WAIT",
			TileId = "",
			Direction = 0,
			Reason = reason,
			PatternId = patternId or "",
			StepIndex = 1,
			PatternStepCount = 0,
			TelegraphTurnsRemaining = 0
		}
	end

end
