@Logic
script EffectRouterLogic extends Logic

	@ExecSpace("ServerOnly")
	method table ExecuteEffectStep(table context, table effectStep)
		local result = {
			Success = false,
			Reason = "UNKNOWN_EFFECT",
			EffectType = "",
			StepIndex = 0
		}
		if context == nil or context.BattleSession == nil or effectStep == nil then
			result.Reason = "INVALID_EFFECT_CONTEXT"
			return result
		end
		result.EffectType = effectStep.EffectType or ""
		result.StepIndex = effectStep.StepIndex or 0

		log("[BattleEffectRouter] step dispatch skill=" .. context.SkillId .. " step=" .. result.StepIndex .. " effect=" .. result.EffectType .. " source=" .. context.SourceUnitId .. " target=" .. context.PrimaryTargetUnitId)
		if result.EffectType == "DAMAGE" then
			result = _DamageEffectExecutorLogic:Execute(context, effectStep)
		elseif result.EffectType == "SEAL" or result.EffectType == "POISON_MIST" then
			result = context.BattleSession:ExecuteEnemySpecialEffect(context, effectStep)
		elseif result.EffectType == "PUSH" then
			result = _PushEffectExecutorLogic:Execute(context, effectStep)
		elseif result.EffectType == "HEAL" then
			result = _HealEffectExecutorLogic:Execute(context, effectStep)
		elseif _BuffEffectExecutorLogic:IsBuffEffectType(result.EffectType) then
			result = _BuffEffectExecutorLogic:Execute(context, effectStep)
		elseif _MoveSelfEffectExecutorLogic:IsMoveEffectType(result.EffectType) then
			result = _MoveSelfEffectExecutorLogic:Execute(context, effectStep)
		else
			log_warning("[BattleEffectRouter] step rejected skill=" .. context.SkillId .. " step=" .. result.StepIndex .. " effect=" .. result.EffectType .. " reason=" .. result.Reason)
			return result
		end

		-- Executors return their own result tables; restore routing metadata before logging/returning.
		result.StepIndex = result.StepIndex or effectStep.StepIndex or 0
		result.EffectType = result.EffectType or effectStep.EffectType or ""
		log("[BattleEffectRouter] step resolved skill=" .. context.SkillId .. " step=" .. result.StepIndex .. " effect=" .. result.EffectType .. " success=" .. tostring(result.Success) .. " reason=" .. result.Reason)
		return result
	end

	@ExecSpace("ServerOnly")
	method table ExecuteEffect(any battleSession, string effectType, string sourceUnitId, string targetUnitId, number amount, string attackId)
		-- Routes one supported primitive effect to the existing authoritative battle-state mutation path.
		-- Keep the originating attack ID when forwarding damage for impact presentation.
		local result = {
			Success = false,
			Reason = "UNKNOWN_EFFECT"
		}

		if battleSession == nil then
			result.Reason = "SESSION_MISSING"
			log_error("[BattleEffectRouter] rejected effect=" .. effectType .. " reason=" .. result.Reason)
			return result
		end

		log("[BattleEffectRouter] dispatch effect=" .. effectType .. " source=" .. sourceUnitId .. " target=" .. targetUnitId .. " amount=" .. tostring(amount))
		if effectType == "DAMAGE" then
			result = battleSession:ApplyDamage(sourceUnitId, targetUnitId, amount, attackId)
		elseif effectType == "PUSH" then
			result = battleSession:ResolvePushImpact(sourceUnitId)
		else
			log_warning("[BattleEffectRouter] rejected effect=" .. effectType .. " reason=" .. result.Reason)
			return result
		end

		log("[BattleEffectRouter] resolved effect=" .. effectType .. " success=" .. tostring(result.Success) .. " reason=" .. result.Reason)
		return result
	end

end
