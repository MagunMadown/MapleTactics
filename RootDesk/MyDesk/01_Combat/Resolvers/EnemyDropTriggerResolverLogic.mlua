@Logic
script EnemyDropTriggerResolverLogic

	@ExecSpace("ServerOnly")
	method table Resolve(boolean isBoss, integer playerActionKillOrdinal)
		-- Converts death context into a deterministic ordered set of drop trigger contracts.
		local triggers = { "ANY_KILL" }
		if playerActionKillOrdinal >= 2 then
			table.insert(triggers, "COMBO_KILL")
		end
		if isBoss == true then
			table.insert(triggers, "BOSS_KILL")
		end
		return { Success = true, Reason = "OK", Triggers = triggers, TriggerSnapshot = table.concat(triggers, "|"), PlayerActionKillOrdinal = playerActionKillOrdinal, IsBoss = isBoss }
	end

end
