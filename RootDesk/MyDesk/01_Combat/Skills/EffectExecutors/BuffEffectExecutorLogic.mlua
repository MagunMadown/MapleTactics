@Logic
script BuffEffectExecutorLogic extends Logic

	@ExecSpace("ServerOnly")
	method table Execute(table context, table effectStep)
		-- Grants one self-support buff (next-attack bonus, timed max HP, timed defense) on the units chosen by the row's selector.
		local result = {
			Success = false,
			Reason = "INVALID_EFFECT_CONTEXT",
			EffectType = effectStep.EffectType or "",
			StepIndex = effectStep.StepIndex or 0,
			Value = effectStep.Value or 0,
			Hit = false,
			TargetUnitId = "",
			TargetUnitIds = {},
			Results = {}
		}
		local battleSession = context.BattleSession
		if battleSession == nil then
			result.Reason = "SESSION_MISSING"
			return result
		end
		if self:IsBuffEffectType(result.EffectType) == false then
			result.Reason = "UNSUPPORTED_BUFF_TYPE"
			return result
		end

		local turns = self:ParseDurationTurns(effectStep)
		local targetUnitIds = _SkillTargetResolverLogic:SelectEffectTargets(context, effectStep.TargetSelector)
		if #targetUnitIds == 0 then
			result.Success = true
			result.Reason = "MISS_EMPTY"
			return result
		end

		for _, targetUnitId in ipairs(targetUnitIds) do
			local buffResult = battleSession:ResolveSkillBuffImpact(
				context.SourceUnitId,
				context.SkillId,
				targetUnitId,
				result.EffectType,
				effectStep.Value,
				turns
			)
			table.insert(result.Results, buffResult)
			if buffResult.Success == false then
				result.Reason = buffResult.Reason
				return result
			end
			result.Hit = true
			table.insert(result.TargetUnitIds, targetUnitId)
			if result.TargetUnitId == "" then
				result.TargetUnitId = targetUnitId
			end
		end

		result.Success = true
		result.Reason = "BUFF_APPLIED"
		return result
	end

	method boolean IsBuffEffectType(string effectType)
		-- Single source of truth for which EffectTypes this executor owns; the Router and Validator both ask here.
		return effectType == "NEXT_ATTACK_BONUS" or effectType == "MAX_HP_BUFF" or effectType == "DEFENSE_BUFF"
	end

	method boolean IsTimedBuffEffectType(string effectType)
		-- Timed buffs count down on the enemy-round clock and therefore require a duration in ParameterA.
		return effectType == "MAX_HP_BUFF" or effectType == "DEFENSE_BUFF"
	end

	method integer ParseDurationTurns(table effectStep)
		-- ParameterA holds the duration as a whole enemy-round count. The next-attack bonus has no duration.
		local turns = tonumber(effectStep.ParameterA)
		if turns == nil then
			return 0
		end
		return math.floor(turns)
	end

	@ExecSpace("ServerOnly")
	method string DescribeBuffEffects(string effectSetId)
		-- Player-facing buff summary shared by the Codex and skill reward tooltips so the wording lives in one place.
		if effectSetId == nil or effectSetId == "" then
			return ""
		end
		local effectResult = _SkillDefinitionRepositoryLogic:GetEffectSteps(effectSetId)
		if effectResult.Success == false then
			return ""
		end
		local parts = {}
		for _, effectStep in ipairs(effectResult.Steps) do
			local valueText = self:FormatNumber(effectStep.Value or 0)
			local turns = self:ParseDurationTurns(effectStep)
			if effectStep.EffectType == "NEXT_ATTACK_BONUS" then
				table.insert(parts, "다음 공격 피해 +" .. valueText)
			elseif effectStep.EffectType == "MAX_HP_BUFF" then
				table.insert(parts, "최대 HP +" .. valueText .. " (" .. tostring(turns) .. "턴)")
			elseif effectStep.EffectType == "DEFENSE_BUFF" then
				table.insert(parts, "방어력 +" .. valueText .. " (" .. tostring(turns) .. "턴)")
			end
		end
		return table.concat(parts, ", ")
	end

	method string FormatNumber(number value)
		-- Prints authored whole numbers without a trailing ".0".
		if value == math.floor(value) then
			return tostring(math.floor(value))
		end
		return tostring(value)
	end

end
