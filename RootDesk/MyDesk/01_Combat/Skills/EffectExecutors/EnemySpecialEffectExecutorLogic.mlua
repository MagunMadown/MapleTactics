@Logic
script EnemySpecialEffectExecutorLogic extends Logic

	method boolean IsHostileStatusEffect(string effectType)
		-- Enemy-only player statuses routed through the hostile special-effect path.
		return effectType == "IGNITE" or effectType == "FROSTBITE" or effectType == "CONFUSE"
	end

	@ExecSpace("ServerOnly")
	method table ExecuteEnemySpecialEffect(any session, table context, table step)
		-- Uses the shared impact-time cell/target snapshot and keeps hostile effects enemy-only.
		local source = session:FindUnitEntity(context.SourceUnitId)
		local unit = isvalid(source) and source:GetComponent("script.BattleUnitComponent") or nil
		if unit == nil or unit.IsDead or unit.Team ~= "Enemy" or not session:IsTeamTurn("Enemy") then
			return { Success = false, Reason = "INVALID_HOSTILE_EFFECT_SOURCE" }
		end
		local turns = math.floor(tonumber(step.ParameterA) or 0)
		if turns < 1 then return { Success = false, Reason = "INVALID_HOSTILE_EFFECT_DURATION" } end
		if session:IsHostileStatusEffect(step.EffectType) then
			local hit = false
			local reason = "MISS_EMPTY"
			for _, targetId in ipairs(_SkillTargetResolverLogic:SelectEffectTargets(context, step.TargetSelector)) do
				local target = session:FindUnitEntity(targetId)
				local targetUnit = isvalid(target) and target:GetComponent("script.BattleUnitComponent") or nil
				if targetUnit ~= nil and not targetUnit.IsDead and targetUnit.Team == "Player" then
					local applied = targetUnit:ApplyHostileStatus(step.EffectType, turns, step.Value or 0, context.SourceUnitId)
					reason = applied.Reason
					hit = hit or applied.Hit == true
				end
			end
			return { Success = true, Hit = hit, EffectType = step.EffectType, Reason = reason }
		end
		if step.EffectType == "SEAL" then
			local hit = false
			for _, targetId in ipairs(context.TargetUnitIds or {}) do
				local target = session:FindUnitEntity(targetId)
				local targetUnit = isvalid(target) and target:GetComponent("script.BattleUnitComponent") or nil
				if targetUnit ~= nil and not targetUnit.IsDead and targetUnit.Team == "Player" then
					targetUnit:ApplySeal(turns)
					session:PlayActiveHitEffect(targetId)
					hit = true
				end
			end
			return { Success = true, Hit = hit, EffectType = "SEAL", Reason = hit and "SEALED" or "MISS_EMPTY" }
		end
		if step.EffectType ~= "POISON_MIST" or step.Value <= 0 then
			return { Success = false, Reason = "UNKNOWN_HOSTILE_EFFECT" }
		end
		session:RemovePoisonMistsForSource(context.SourceUnitId)
		local cells = {}
		for _, cell in ipairs(context.TargetCellIndices or {}) do
			if session:IsValidCell(cell) then table.insert(cells, cell) end
		end
		table.insert(session._T.PoisonMists, { SourceUnitId = context.SourceUnitId, Cells = cells, Damage = step.Value, Turns = turns })
		session:PublishPoisonMistCells()
		log("[PoisonMist] created source=" .. context.SourceUnitId .. " cells=" .. session.PoisonMistCellSnapshot .. " turns=" .. tostring(turns))
		return { Success = true, EffectType = "POISON_MIST", Reason = "POISON_MIST_CREATED" }
	end

	@ExecSpace("ServerOnly")
	method void ClearPoisonMists(any session)
		-- Releases all map-scoped hazards on reset, teardown or defeat.
		session._T.PoisonMists = {}
		session.PoisonMistCellSnapshot = ""
	end

	@ExecSpace("ServerOnly")
	method void RemovePoisonMistsForSource(any session, string sourceUnitId)
		-- A dying caster cannot damage players during its death presentation.
		local remaining = {}
		for _, mist in ipairs(session._T.PoisonMists or {}) do
			if mist.SourceUnitId ~= sourceUnitId then table.insert(remaining, mist) end
		end
		session._T.PoisonMists = remaining
		session:PublishPoisonMistCells()
	end

	@ExecSpace("ServerOnly")
	method void PublishPoisonMistCells(any session)
		-- Existing client floor telegraphs render these occupied hazard cells until expiry.
		local cells = {}
		local seen = {}
		for _, mist in ipairs(session._T.PoisonMists or {}) do
			for _, cell in ipairs(mist.Cells) do
				if not seen[cell] then table.insert(cells, tostring(cell)); seen[cell] = true end
			end
		end
		session.PoisonMistCellSnapshot = table.concat(cells, "|")
	end

	@ExecSpace("ServerOnly")
	method void AdvancePoisonMists(any session)
		-- A player gets a complete movement opportunity before each fixed one-point area tick.
		local player = isvalid(session.PlayerEntity) and session.PlayerEntity:GetComponent("script.BattleUnitComponent") or nil
		if player == nil or player.IsDead or session.BattleResult ~= "" then session:ClearPoisonMists(); return end
		local remaining = {}
		for _, mist in ipairs(session._T.PoisonMists or {}) do
			local source = session:FindUnitEntity(mist.SourceUnitId)
			local unit = isvalid(source) and source:GetComponent("script.BattleUnitComponent") or nil
			if unit ~= nil and not unit.IsDead then
				for _, cell in ipairs(mist.Cells) do
					if player.CellIndex == cell and not player.IsAirborne then
						local result = session:ApplyDamage(mist.SourceUnitId, player.UnitId, mist.Damage, "commander_poison_mist")
						log("[PoisonMist] tick cell=" .. tostring(cell) .. " damage=" .. tostring(result.AppliedAmount or 0))
						break
					end
				end
				if session.BattleResult ~= "" then session:ClearPoisonMists(); return end
				mist.Turns = mist.Turns - 1
				if mist.Turns > 0 then table.insert(remaining, mist) end
			end
		end
		session._T.PoisonMists = remaining
		session:PublishPoisonMistCells()
	end

	method boolean IsPlayerSealed(any session)
		-- Reads synchronized status on either side without exposing mutation to the client.
		local unit = session:GetPlayerStatusUnit()
		return unit ~= nil and unit.SealTurns > 0
	end

	method any GetPlayerStatusUnit(any session)
		-- Resolves the player's battle unit on either side for synchronized status reads.
		local player = session.PlayerEntity
		if session:IsClient() then player = _UserService.LocalPlayer end
		if not isvalid(player) then return nil end
		return player:GetComponent("script.BattleUnitComponent")
	end

	method boolean IsPlayerFrostbitten(any session)
		-- Frostbite blocks grid moves and session-moving utilities, not attacks or facing.
		local unit = session:GetPlayerStatusUnit()
		return unit ~= nil and unit.FrostbiteTurns > 0
	end

	@ExecSpace("ServerOnly")
	method void ResolvePlayerConfusion(any session, string skillId, table definition)
		-- Spin before targeting, but do not spend a charge on a cast already blocked by cooldown or cost.
		local unit = session:GetPlayerStatusUnit()
		if unit == nil or unit.IsDead or unit.ConfuseTurns <= 0 then return end
		local runtime = session:GetSkillRuntimeState("player_01")
		if runtime == nil or runtime:CanUseSkill(skillId).Success ~= true then return end
		if definition.CostType == "HEAL_CHARGE" then
			local player = session:FindUnitEntity("player_01")
			local inventory = isvalid(player) and player:GetComponent("script.PlayerRunInventoryComponent") or nil
			if inventory == nil or (not inventory.HealUnlimited and inventory:GetHealCharges() < definition.CostValue)
				or unit.CurrentHp >= unit.MaxHp then return end
		end
		unit.ConfuseTurns = unit.ConfuseTurns - 1
		local turned = session:TryTurn("player_01")
		log("[BattleStatus] confusion reversed skill=" .. skillId .. " facing=" .. unit.Facing .. " turned=" .. tostring(turned.Success))
	end

end
