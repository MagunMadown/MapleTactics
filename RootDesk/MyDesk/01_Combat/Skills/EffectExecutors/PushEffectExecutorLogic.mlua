@Logic
script PushEffectExecutorLogic extends Logic

	@ExecSpace("ServerOnly")
	method table Execute(table context, table effectStep)
		local result = {
			Success = false,
			Reason = "INVALID_EFFECT_CONTEXT",
			EffectType = "PUSH",
			StepIndex = effectStep.StepIndex or 0,
			Value = effectStep.Value or 0,
			Hit = false,
			TargetUnitId = "",
			TargetUnitIds = {},
			Results = {}
		}
		if context.BattleSession == nil then
			result.Reason = "SESSION_MISSING"
			return result
		end

		local targetUnitIds = _SkillTargetResolverLogic:SelectEffectTargets(context, effectStep.TargetSelector)
		if #targetUnitIds == 0 then
			result.Success = true
			result.Reason = "MISS_EMPTY"
			return result
		end

		local isPull = effectStep.EffectType == "PULL"
		result.EffectType = effectStep.EffectType or "PUSH"
		for _, targetUnitId in ipairs(targetUnitIds) do
			local pushResult = nil
			if isPull then
				-- PULL drags the target to Value cells in front of the caster (1 = right in front).
				pushResult = context.BattleSession:ResolvePullImpactOnTarget(context.SourceUnitId, targetUnitId, math.max(1, math.floor(tonumber(effectStep.Value) or 1)))
			else
				pushResult = context.BattleSession:ResolvePushImpactOnTarget(context.SourceUnitId, targetUnitId)
			end
			table.insert(result.Results, pushResult)
			if pushResult.Success == false then
				result.Reason = pushResult.Reason
				return result
			end
			if pushResult.Hit == true then
				result.Hit = true
				table.insert(result.TargetUnitIds, targetUnitId)
				if result.TargetUnitId == "" then
					result.TargetUnitId = targetUnitId
				end
			end
		end
		result.Success = true
		result.Reason = result.Hit and (isPull and "PULL_RESOLVED" or "PUSH_RESOLVED") or "MISS_EMPTY"
		return result
	end

end
