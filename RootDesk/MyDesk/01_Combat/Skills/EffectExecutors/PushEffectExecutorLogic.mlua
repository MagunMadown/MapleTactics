@Logic
script PushEffectExecutorLogic

	@ExecSpace("ServerOnly")
	method table Execute(table context, table effectStep)
		local result = {
			Success = false,
			Reason = "INVALID_EFFECT_CONTEXT",
			EffectType = "PUSH",
			StepIndex = effectStep.StepIndex or 0,
			Value = effectStep.Value or 0
		}
		if context.BattleSession == nil then
			result.Reason = "SESSION_MISSING"
			return result
		end

		local pushResult = context.BattleSession:ResolvePushImpact(context.SourceUnitId)
		pushResult.EffectType = "PUSH"
		pushResult.StepIndex = effectStep.StepIndex
		pushResult.Value = effectStep.Value
		if pushResult.TargetUnitId ~= nil and pushResult.TargetUnitId ~= "" then
			context.PrimaryTargetUnitId = pushResult.TargetUnitId
		end
		return pushResult
	end

end
