@Logic
script DamageEffectExecutorLogic

	@ExecSpace("ServerOnly")
	method table Execute(table context, table effectStep)
		local result = {
			Success = false,
			Reason = "INVALID_EFFECT_CONTEXT",
			EffectType = "DAMAGE",
			StepIndex = effectStep.StepIndex or 0,
			Value = 0,
			Hit = false,
			TargetUnitId = "",
			TargetUnitIds = {},
			Results = {}
		}
		local battleSession = context.BattleSession
		if battleSession == nil then
			result.Reason = "SESSION_MISSING"
			return result
		end

		local damageAmount = effectStep.Value
		if effectStep.ParameterA == "SOURCE_BASIC_ATTACK" then
			local sourceEntity = battleSession:FindUnitEntity(context.SourceUnitId)
			if isvalid(sourceEntity) == false then
				result.Reason = "SOURCE_NOT_FOUND"
				return result
			end
			local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
			if sourceUnit == nil then
				result.Reason = "SOURCE_COMPONENT_MISSING"
				return result
			end
			damageAmount = sourceUnit.BasicAttackDamage
		end

		local targetUnitIds = _SkillTargetResolverLogic:SelectEffectTargets(context, effectStep.TargetSelector)
		if #targetUnitIds == 0 then
			result.Success = true
			result.Reason = "MISS_EMPTY"
			result.Value = damageAmount
			return result
		end

		for _, targetUnitId in ipairs(targetUnitIds) do
			local damageResult = battleSession:ResolveSkillDamageImpact(
				context.SourceUnitId,
				context.SkillId,
				targetUnitId,
				context.TargetCellsByUnitId[targetUnitId] or -1,
				damageAmount
			)
			table.insert(result.Results, damageResult)
			if damageResult.Success == false then
				result.Reason = damageResult.Reason
				return result
			end
			if damageResult.Hit == true then
				result.Hit = true
				table.insert(result.TargetUnitIds, targetUnitId)
				if result.TargetUnitId == "" then
					result.TargetUnitId = targetUnitId
				end
			end
			if battleSession.BattleResult ~= "" then
				break
			end
		end
		result.Success = true
		result.Reason = result.Hit and "HIT" or "MISS_EMPTY"
		result.Value = damageAmount
		return result
	end

end
