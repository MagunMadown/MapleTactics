@Logic
script HealEffectExecutorLogic extends Logic

	@ExecSpace("ServerOnly")
	method table Execute(table context, table effectStep)
		-- Restores HP on the units chosen by the effect row's selector, mirroring the DAMAGE executor's shape.
		local result = {
			Success = false,
			Reason = "INVALID_EFFECT_CONTEXT",
			EffectType = "HEAL",
			StepIndex = effectStep.StepIndex or 0,
			Value = effectStep.Value or 0,
			Hit = false,
			TargetUnitId = "",
			TargetUnitIds = {},
			Results = {}
		}
		local battleSession = context.BattleSession
		if battleSession == nil then
			result.Reason = "SESSION_MISSING"
			return result
		end

		local targetUnitIds = _SkillTargetResolverLogic:SelectEffectTargets(context, effectStep.TargetSelector)
		if #targetUnitIds == 0 then
			result.Success = true
			result.Reason = "MISS_EMPTY"
			return result
		end

		for _, targetUnitId in ipairs(targetUnitIds) do
			local healResult = battleSession:ResolveSkillHealImpact(
				context.SourceUnitId,
				context.SkillId,
				targetUnitId,
				effectStep.Value
			)
			table.insert(result.Results, healResult)
			if healResult.Success == false then
				result.Reason = healResult.Reason
				return result
			end
			if healResult.Hit == true then
				result.Hit = true
				table.insert(result.TargetUnitIds, targetUnitId)
				if result.TargetUnitId == "" then
					result.TargetUnitId = targetUnitId
				end
			end
		end

		result.Success = true
		result.Reason = result.Hit and "HEALED" or "MISS_EMPTY"
		return result
	end

	@ExecSpace("ServerOnly")
	method table ResolveSkillHealImpact(any session, string sourceUnitId, string skillId, string targetUnitId, number healAmount)
		-- Restores HP on one impact-time target. Support skills stay castable with no enemy on the board,
		-- so this path never requires a resolved enemy target.
		local result = { Success = false, Hit = false, Reason = "UNKNOWN", SourceUnitId = sourceUnitId, SkillId = skillId, TargetUnitId = targetUnitId, HealAmount = 0, TargetHpBefore = -1, TargetHpAfter = -1 }
		local sourceEntity = session:FindUnitEntity(sourceUnitId)
		local targetEntity = session:FindUnitEntity(targetUnitId)
		if isvalid(sourceEntity) == false then
			result.Reason = "SOURCE_NOT_FOUND"
			return result
		end
		if isvalid(targetEntity) == false then
			result.Reason = "TARGET_NOT_FOUND"
			return result
		end
		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		local targetUnit = targetEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit == nil or targetUnit == nil then
			result.Reason = "UNIT_COMPONENT_MISSING"
			return result
		end
		if session:IsTeamTurn(sourceUnit.Team) == false then
			result.Reason = "INVALID_PHASE"
			return result
		end
		if sourceUnit.IsDead == true or targetUnit.IsDead == true then
			result.Reason = "UNIT_DEAD"
			return result
		end
		if sourceUnit.Team ~= targetUnit.Team then
			result.Reason = "TARGET_NOT_ALLY"
			return result
		end

		local healResult = targetUnit:ApplyHealing(healAmount)
		local context = session._T.RelicDamageContext
		if context ~= nil and context.SourceUnitId == sourceUnitId and context.SkillId == skillId
			and sourceUnit.Team == "Player" and (healResult.Success or healResult.Reason == "HP_ALREADY_FULL") then
			if _AugmentRuntimeLogic:QueueSkillRegeneration(context, targetUnit) then healResult.Success = true end
		end
		if healResult.Success == false then
			result.Reason = "HEAL_FAILED_" .. healResult.Reason
			return result
		end
		result.Success = true
		result.Hit = true
		result.Reason = "HEALED"
		result.HealAmount = healResult.AppliedAmount
		result.TargetHpBefore = healResult.HpBefore
		result.TargetHpAfter = healResult.HpAfter
		session:PlayActiveHitEffect(targetUnitId)

		log("[BattleHeal] resolved skill=" .. skillId .. " source=" .. sourceUnitId .. " target=" .. targetUnitId .. " amount=" .. result.HealAmount .. " hp=" .. result.TargetHpBefore .. "->" .. result.TargetHpAfter)
		return result
	end

end
