@Logic
script SkillWeaponEquipLogic extends Logic

	@ExecSpace("ServerOnly")
	method table ApplyWeaponForSkill(Entity unitEntity, table definition)
		-- Swaps the caster's avatar weapon to the one the skill row declares, at skill-start time so
		-- the swing motion already shows the right weapon. Purely presentational: every failure path
		-- returns a reason instead of blocking, so a costume or data problem can never stall a turn.
		local weaponType = ""
		if definition ~= nil then
			weaponType = definition.WeaponType or ""
		end
		local result = {
			Success = false,
			Reason = "UNKNOWN",
			WeaponType = weaponType,
			EquipSlot = "",
			WeaponRuid = ""
		}
		if weaponType == "" then
			-- Authored as "keep whatever is equipped" — every enemy row and any weapon-agnostic skill.
			result.Success = true
			result.Reason = "NO_WEAPON_REQUIRED"
			return result
		end
		if isvalid(unitEntity) == false then
			result.Reason = "UNIT_UNAVAILABLE"
			return result
		end

		local costume = unitEntity.CostumeManagerComponent
		if costume == nil then
			-- Enemies have no avatar. Authoring a WeaponType on an enemy skill is a data mistake,
			-- not a runtime failure, so it only warns.
			result.Reason = "COSTUME_MANAGER_MISSING"
			log_warning("[SkillWeapon] skipped unit=" .. unitEntity.Name .. " weaponType=" .. weaponType .. " reason=" .. result.Reason)
			return result
		end

		local weapon = _WeaponDefinitionRepositoryLogic:GetWeaponDefinition(weaponType)
		if weapon.Success == false then
			result.Reason = weapon.Reason
			log_warning("[SkillWeapon] skipped unit=" .. unitEntity.Name .. " weaponType=" .. weaponType .. " reason=" .. result.Reason)
			return result
		end
		if weapon.Enabled ~= true then
			result.Reason = "WEAPON_DISABLED"
			log_warning("[SkillWeapon] skipped unit=" .. unitEntity.Name .. " weaponType=" .. weaponType .. " reason=" .. result.Reason)
			return result
		end
		if weapon.WeaponRuid == "" then
			result.Reason = "WEAPON_RUID_MISSING"
			log_warning("[SkillWeapon] skipped unit=" .. unitEntity.Name .. " weaponType=" .. weaponType .. " reason=" .. result.Reason)
			return result
		end
		if _WeaponDefinitionRepositoryLogic:IsSupportedEquipSlot(weapon.EquipSlot) == false then
			result.Reason = "UNSUPPORTED_WEAPON_EQUIP_SLOT"
			log_warning("[SkillWeapon] skipped unit=" .. unitEntity.Name .. " weaponType=" .. weaponType .. " reason=" .. result.Reason)
			return result
		end

		result.EquipSlot = weapon.EquipSlot
		result.WeaponRuid = weapon.WeaponRuid
		result.SubWeaponRuid = weapon.SubWeaponRuid or ""
		if self:IsAlreadyEquipped(costume, weapon) == true then
			result.Success = true
			result.Reason = "ALREADY_EQUIPPED"
			return result
		end

		-- The 2H slot consumes the 1H and sub-weapon slots, so all three are cleared before equipping;
		-- otherwise a leftover 1H item stays visible under a two-handed weapon, or a blade left in the
		-- sub-weapon slot follows the caster into the next skill's weapon.
		costume:SetEquip(MapleAvatarItemCategory.OneHandedWeapon, "")
		costume:SetEquip(MapleAvatarItemCategory.TwoHandedWeapon, "")
		costume:SetEquip(MapleAvatarItemCategory.SubWeapon, "")
		if weapon.EquipSlot == "TWO_HANDED" then
			costume:SetEquip(MapleAvatarItemCategory.TwoHandedWeapon, weapon.WeaponRuid)
		else
			costume:SetEquip(MapleAvatarItemCategory.OneHandedWeapon, weapon.WeaponRuid)
			-- Dual wield: the main hand keeps the one-handed weapon and the sub-weapon slot carries
			-- the second item. Only reachable on a ONE_HANDED row, per the validator.
			if result.SubWeaponRuid ~= "" then
				costume:SetEquip(MapleAvatarItemCategory.SubWeapon, result.SubWeaponRuid)
			end
		end

		result.Success = true
		result.Reason = "OK"
		log("[SkillWeapon] equipped unit=" .. unitEntity.Name .. " weaponType=" .. weaponType .. " slot=" .. weapon.EquipSlot .. " ruid=" .. weapon.WeaponRuid .. " sub=" .. result.SubWeaponRuid)
		return result
	end

	method boolean IsAlreadyEquipped(any costume, table weapon)
		-- Reads the synced equip properties instead of GetEquip, which is ClientOnly. Skipping the
		-- redundant re-equip avoids a visible costume rebuild every time the same weapon is reused.
		if weapon.EquipSlot == "TWO_HANDED" then
			return costume.CustomTwoHandedWeaponEquip == weapon.WeaponRuid
		end
		-- A dual-wield row only counts as equipped when both hands already match; otherwise switching
		-- between two skills that share a main weapon but differ in the sub slot would skip the swap.
		return costume.CustomOneHandedWeaponEquip == weapon.WeaponRuid
			and costume.CustomSubWeaponEquip == (weapon.SubWeaponRuid or "")
	end

end
