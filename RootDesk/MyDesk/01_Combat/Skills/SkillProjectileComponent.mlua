@Component
script SkillProjectileComponent extends Component

	property number Speed = 12
	property number FlightTime = 0
	property number ElapsedTime = 0
	property number ArcHeight = 0
	property boolean Launched = false

	@ExecSpace("ServerOnly")
	method void Launch(Vector2 startPosition, Vector2 targetPosition, number speed, string projectileRuid, number scale, boolean flipX, number orderInLayer, number arcHeight)
		-- Sends this projectile from the caster toward the target cell. Purely presentational: the
		-- battle resolves damage on its own timer, so a projectile that dies early only costs the visual.
		local transform = self.Entity.TransformComponent
		if transform == nil then
			log_warning("[SkillProjectile] launch skipped reason=TRANSFORM_MISSING")
			self.Entity:Destroy()
			return
		end

		local renderer = self.Entity.SpriteRendererComponent
		if renderer ~= nil and projectileRuid ~= "" then
			renderer.SpriteRUID = projectileRuid
			-- Projectile art is authored facing left, matching the skill effect clips.
			renderer.FlipX = flipX
			renderer.OrderInLayer = orderInLayer
		end

		local safeScale = math.max(0.05, scale)
		transform.Scale = Vector3(safeScale, safeScale, 1)
		transform.Position = Vector3(startPosition.x, startPosition.y, transform.Position.z)

		local dx = targetPosition.x - startPosition.x
		local dy = targetPosition.y - startPosition.y
		local distance = math.sqrt(dx * dx + dy * dy)
		local safeSpeed = math.max(0.1, speed)
		self.Speed = safeSpeed
		self.FlightTime = distance / safeSpeed
		self.ElapsedTime = 0
		self.ArcHeight = math.max(0, arcHeight)
		-- Both endpoints are kept so the flight can be replayed as a parametric path. A straight shot
		-- could advance by velocity alone, but an arc needs the absolute progress along the line to
		-- place its apex, so both shapes share one formula.
		self._T.startX = startPosition.x
		self._T.startY = startPosition.y
		self._T.targetX = targetPosition.x
		self._T.targetY = targetPosition.y
		self.Launched = true
		log("[SkillProjectile] launched entity=" .. self.Entity.Name .. " ruid=" .. projectileRuid .. " distance=" .. distance .. " speed=" .. safeSpeed .. " flight=" .. self.FlightTime .. " scale=" .. safeScale .. " arc=" .. self.ArcHeight .. " flipX=" .. tostring(flipX))
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		-- Body-less entity, so the position is written directly rather than driven by a Body velocity.
		if self.Launched == false then
			return
		end

		self.ElapsedTime = self.ElapsedTime + delta
		if self.ElapsedTime >= self.FlightTime then
			log("[SkillProjectile] arrived entity=" .. self.Entity.Name .. " elapsed=" .. self.ElapsedTime)
			self.Launched = false
			self.Entity:Destroy()
			return
		end

		local transform = self.Entity.TransformComponent
		if transform == nil then
			return
		end

		local progress = 0
		if self.FlightTime > 0 then
			progress = self.ElapsedTime / self.FlightTime
		end
		local x = self._T.startX + (self._T.targetX - self._T.startX) * progress
		local y = self._T.startY + (self._T.targetY - self._T.startY) * progress
		if self.ArcHeight > 0 then
			-- 4h·t·(1-t) peaks at exactly ArcHeight when t = 0.5 and is 0 at both ends, so the shot
			-- leaves and lands on the straight line no matter how long the flight is.
			y = y + self.ArcHeight * 4 * progress * (1 - progress)
		end
		transform.Position = Vector3(x, y, transform.Position.z)
	end

end
