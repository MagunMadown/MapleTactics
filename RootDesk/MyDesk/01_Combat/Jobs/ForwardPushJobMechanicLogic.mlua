@Logic
script ForwardPushJobMechanicLogic

	@ExecSpace("ServerOnly")
	method table CanActivate(table context)
		-- Validates the warrior-only forward collision without mutating board state.
		local result = {
			Success = true,
			Reason = "FORWARD_PUSH_UNAVAILABLE",
			MechanicId = "FORWARD_PUSH",
			CanActivate = false,
			PushToCell = -1
		}
		if context == nil or context.BattleSession == nil or context.SourceUnit == nil then
			result.Success = false
			result.Reason = "INVALID_JOB_MECHANIC_CONTEXT"
			return result
		end
		if isvalid(context.OccupantEntity) == false then
			result.Reason = "TARGET_NOT_FOUND"
			return result
		end
		local targetUnit = context.OccupantEntity:GetComponent("script.BattleUnitComponent")
		if targetUnit == nil or targetUnit.IsDead == true then
			result.Reason = "TARGET_UNAVAILABLE"
			return result
		end
		if targetUnit.Team == context.SourceUnit.Team then
			result.Reason = "ALLY_BLOCKED"
			return result
		end
		local facingDirection = context.SourceUnit.Facing == "Left" and -1 or 1
		if context.Direction ~= facingDirection then
			result.Reason = "NOT_MOVING_FORWARD"
			return result
		end
		local pushToCell = context.TargetCell + context.Direction
		result.PushToCell = pushToCell
		result.TargetUnitId = targetUnit.UnitId
		if context.BattleSession:IsValidCell(pushToCell) == false then
			result.Reason = "PUSH_OUT_OF_BOUNDS"
			return result
		end
		if context.BattleSession:IsCellOccupied(pushToCell, targetUnit.UnitId) then
			result.Reason = "PUSH_CELL_OCCUPIED"
			return result
		end
		result.CanActivate = true
		result.Reason = "FORWARD_PUSH_READY"
		return result
	end

	@ExecSpace("ServerOnly")
	method table Execute(table context)
		-- Pushes the blocking enemy first so the normal MOVE path can occupy its former cell.
		local availability = self:CanActivate(context)
		if availability.Success == false or availability.CanActivate == false then
			availability.ConsumedTurn = false
			return availability
		end
		local relocation = context.BattleSession:RelocateUnitForMechanic(
			availability.TargetUnitId,
			availability.PushToCell,
			"FORWARD_PUSH"
		)
		if relocation.Success == false then
			return {
				Success = false,
				Reason = relocation.Reason,
				MechanicId = "FORWARD_PUSH",
				CanActivate = false,
				ConsumedTurn = false
			}
		end
		return {
			Success = true,
			Reason = "FORWARD_PUSH_APPLIED",
			MechanicId = "FORWARD_PUSH",
			CanActivate = true,
			AllowSourceMove = true,
			ConsumedTurn = true,
			PushedUnitId = availability.TargetUnitId,
			PushedFromCell = relocation.FromCell,
			PushedToCell = relocation.ToCell
		}
	end

	@ExecSpace("ServerOnly")
	method table GetPreview(table context)
		-- Returns a stable preview DTO for future debug and production UI adapters.
		local availability = self:CanActivate(context)
		return {
			Success = availability.Success,
			Reason = availability.Reason,
			MechanicId = "FORWARD_PUSH",
			CanActivate = availability.CanActivate == true,
			SourceCell = context ~= nil and context.SourceCell or -1,
			TargetCell = context ~= nil and context.TargetCell or -1,
			PushToCell = availability.PushToCell or -1,
			PreviewType = "PUSH_LINE"
		}
	end

end
