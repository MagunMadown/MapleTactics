@Logic
script JobMechanicRouterLogic

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- Job mechanics are character rules, not queueable SkillDefinitions.
		log("[JobMechanic] router ready mechanics=NONE|FORWARD_PUSH")
	end

	@ExecSpace("ServerOnly")
	method boolean IsRegistered(string mechanicId)
		-- Keeps data validation independent from concrete mechanic implementations.
		return mechanicId == "NONE" or mechanicId == "FORWARD_PUSH"
	end

	@ExecSpace("ServerOnly")
	method table CanActivate(string mechanicId, table context)
		-- Delegates availability checks to the registered concrete handler.
		if self:IsRegistered(mechanicId) == false then
			return { Success = false, Reason = "JOB_MECHANIC_NOT_REGISTERED", MechanicId = mechanicId or "", CanActivate = false }
		end
		if mechanicId == "FORWARD_PUSH" then
			return _ForwardPushJobMechanicLogic:CanActivate(context)
		end
		return { Success = true, Reason = "NO_ACTIVE_JOB_MECHANIC", MechanicId = mechanicId, CanActivate = false }
	end

	@ExecSpace("ServerOnly")
	method table Execute(string mechanicId, table context)
		-- Executes only through a registered handler so BattleSession never branches by job id.
		local availability = self:CanActivate(mechanicId, context)
		if availability.Success == false then
			return availability
		end
		if mechanicId == "FORWARD_PUSH" then
			return _ForwardPushJobMechanicLogic:Execute(context)
		end
		return { Success = false, Reason = availability.Reason, MechanicId = mechanicId, ConsumedTurn = false }
	end

	@ExecSpace("ServerOnly")
	method table GetPreview(string mechanicId, table context)
		-- Normalizes handler-specific previews behind one UI-facing contract.
		if mechanicId == "FORWARD_PUSH" then
			return _ForwardPushJobMechanicLogic:GetPreview(context)
		end
		local availability = self:CanActivate(mechanicId, context)
		return {
			Success = availability.Success,
			Reason = availability.Reason,
			MechanicId = mechanicId or "",
			CanActivate = availability.CanActivate == true,
			SourceCell = context ~= nil and context.SourceCell or -1,
			TargetCell = context ~= nil and context.TargetCell or -1,
			PreviewType = "NONE"
		}
	end

	@ExecSpace("ServerOnly")
	method table GetUiState(string mechanicId, table context)
		-- Adds common turn and cooldown fields without exposing concrete handlers to UI callers.
		local preview = self:GetPreview(mechanicId, context)
		return {
			Success = preview.Success,
			Reason = preview.Reason,
			MechanicId = mechanicId or "",
			CanActivate = preview.CanActivate,
			ConsumesTurn = mechanicId == "FORWARD_PUSH",
			CooldownRemaining = 0,
			PreviewType = preview.PreviewType,
			SourceCell = preview.SourceCell,
			TargetCell = preview.TargetCell
		}
	end

end
