@Logic
script AugmentRuntimeLogic extends Logic

	property integer MaxEventDepth = 4

	@ExecSpace("ServerOnly")
	method table ProcessTrigger(Entity playerEntity, string triggerType, table context)
		-- Resolves owned augments through Trigger, Condition, and Effect stages in stable order.
		local result = { Success = false, Reason = "UNKNOWN", TriggerType = triggerType or "", CandidateCount = 0, ExecutedCount = 0, SkippedCount = 0, Effects = {} }
		if _AugmentTriggerRouterLogic:IsRegistered(triggerType) == false then
			result.Reason = "AUGMENT_TRIGGER_NOT_REGISTERED"
			return result
		end
		if context == nil or context.SourceUnit == nil then
			result.Reason = "INVALID_AUGMENT_CONTEXT"
			return result
		end
		local depth = context ~= nil and context.Depth or 0
		if depth >= self.MaxEventDepth then
			result.Reason = "AUGMENT_MAX_DEPTH_REACHED"
			return result
		end
		local augmentState = _RunManagerLogic:GetOrCreateRunAugmentState(playerEntity)
		if augmentState == nil then
			result.Reason = "RUN_AUGMENT_STATE_UNAVAILABLE"
			return result
		end
		local candidates = {}
		for _, owned in ipairs(augmentState:GetOwnedEntries()) do
			local bundle = _AugmentDefinitionRepositoryLogic:GetBundle(owned.AugmentId)
			if bundle.Success == true then
				for _, effect in ipairs(bundle.Effects) do
					if effect.TriggerType == triggerType then
						table.insert(candidates, { Effect = effect, Stacks = owned.Stacks, AcquiredOrder = owned.AcquiredOrder, SourceType = owned.SourceType })
					end
				end
			end
		end
		table.sort(candidates, function(left, right)
			if left.Effect.Priority ~= right.Effect.Priority then
				return left.Effect.Priority < right.Effect.Priority
			end
			if left.AcquiredOrder ~= right.AcquiredOrder then
				return left.AcquiredOrder < right.AcquiredOrder
			end
			if left.Effect.Seq ~= right.Effect.Seq then
				return left.Effect.Seq < right.Effect.Seq
			end
			return left.Effect.AugmentId < right.Effect.AugmentId
		end)
		result.CandidateCount = #candidates
		for _, candidate in ipairs(candidates) do
			local effect = candidate.Effect
			local effectSourceTag = "AUGMENT:" .. effect.AugmentId .. ":" .. tostring(effect.Seq)
			local sourceTag = context ~= nil and context.SourceTag or ""
			if candidate.SourceType == "JOB" and triggerType == "TURN_START" and effect.EffectType == "HEAL" then
				result.SkippedCount = result.SkippedCount + 1
				table.insert(result.Effects, { Success = false, Reason = "JOB_TURN_HEAL_DISABLED", AugmentId = effect.AugmentId, Seq = effect.Seq, SourceTag = effectSourceTag })
				log("[AugmentRuntime] automatic job heal skipped augment=" .. effect.AugmentId .. " trigger=" .. triggerType)
			elseif sourceTag == effectSourceTag then
				result.SkippedCount = result.SkippedCount + 1
				table.insert(result.Effects, { Success = false, Reason = "SOURCE_TAG_REENTRY_BLOCKED", AugmentId = effect.AugmentId, Seq = effect.Seq, SourceTag = effectSourceTag })
			else
				local condition = _AugmentConditionRouterLogic:Evaluate(effect, context)
				if condition.Success == false or condition.Passed == false then
					result.SkippedCount = result.SkippedCount + 1
					table.insert(result.Effects, { Success = condition.Success, Reason = condition.Reason, AugmentId = effect.AugmentId, Seq = effect.Seq, SourceTag = effectSourceTag })
				else
					effect.Amount = effect.Amount * candidate.Stacks
					local effectContext = {
						BattleSession = context.BattleSession,
						SourceEntity = context.SourceEntity,
						SourceUnit = context.SourceUnit,
						TurnNumber = context.TurnNumber,
						SourceTag = effectSourceTag,
						Depth = depth + 1
					}
					local execution = _AugmentEffectRouterLogic:Execute(effect, effectContext)
					execution.AugmentId = effect.AugmentId
					execution.Seq = effect.Seq
					execution.SourceTag = effectSourceTag
					table.insert(result.Effects, execution)
					if execution.Success == true then
						result.ExecutedCount = result.ExecutedCount + 1
					else
						result.SkippedCount = result.SkippedCount + 1
					end
					log("[AugmentRuntime] effect trigger=" .. triggerType .. " augment=" .. effect.AugmentId .. " seq=" .. effect.Seq .. " effect=" .. effect.EffectType .. " success=" .. tostring(execution.Success) .. " reason=" .. execution.Reason .. " depth=" .. (depth + 1))
				end
			end
		end
		result.Success = true
		result.Reason = "PROCESSED"
		log("[AugmentRuntime] trigger=" .. triggerType .. " candidates=" .. result.CandidateCount .. " executed=" .. result.ExecutedCount .. " skipped=" .. result.SkippedCount .. " depth=" .. depth)
		return result
	end


	@ExecSpace("ServerOnly")
	method boolean CanBindSkillAugment(table definition, table steps, table augment)
		-- Skill tier upgrades and skill augments are independent.
		local effect = augment.Effects[1]
		if effect == nil or not _AugmentContentValidatorLogic:IsSkillModifierValid(effect) then return false end
		if definition.CostType == "HEAL_CHARGE" and effect.ParamA ~= "REGEN_HEAL" then return effect.ParamA == "HEAL_CHARGES" or effect.ParamA == "HEAL_UNLIMITED" end
		if effect.ParamA == "HEAL_CHARGES" or effect.ParamA == "HEAL_UNLIMITED" then return false end
		if effect.ParamA == "HIDDEN_COOLDOWN" then return definition.CooldownTurns > 1 end
		local damage = nil
		local damageCount = 0
		local heal = nil
		local control = false
		local moving = false
		local buff = false
		for _, step in ipairs(steps) do
			if step.EffectType == "DAMAGE" then damage = step; damageCount = damageCount + 1 end
			if step.EffectType == "HEAL" then heal = step end
			if _BuffEffectExecutorLogic:IsBuffEffectType(step.EffectType) then buff = true end
			if step.EffectType == "STUN" or step.EffectType == "FREEZE" then control = true end
			if step.EffectType == "MOVE_SELF" then moving = true end
		end
		local kind = effect.ParamA
		if kind == "REGEN_HEAL" then return heal ~= nil and heal.Value > effect.Amount and (definition.RegenHealAmount or 0) == 0 end
		if kind == "BUFF_DURATION" then
			if (definition.BuffDurationStacks or 0) >= 2 then return false end
			for _, step in ipairs(steps) do
				if self:IsExtendableBuff(step.EffectType) and (tonumber(step.ParameterA) or 0) > 0 then return true end
			end
			return false
		end
		if kind == "BUFF_COOLDOWN" then return buff and damageCount == 0 and definition.CooldownTurns > 1 end
		if buff and damageCount == 0 then
			return kind == "ZERO_DAMAGE_FREE_LOAD" and definition.ZeroDamage ~= true and definition.FreePlay ~= true
		end
		local cooldown = tonumber(effect.ParamB)
		if cooldown < 0 and definition.CooldownTurns <= 1 then return false end
		if damageCount ~= 1 or damage.ParameterA == "SOURCE_BASIC_ATTACK" then return false end
		if kind == "ZERO_DAMAGE_FREE_LOAD" then return definition.ZeroDamage ~= true and definition.FreePlay ~= true and damage.Value > 0 end
		if definition.ZeroDamage == true and kind ~= "RANGE" then return false end
		local hits = _DamageEffectExecutorLogic:GetHitCount(damage)
		local single = damage.TargetSelector == "PRIMARY_TARGET" or definition.TargetingType == "FRONT_CELL" or definition.TargetingType == "FIRST_ENEMY_FORWARD"
		if kind == "FIRST_STRIKE" then
			return damage.Value > 0 and (definition.FirstStrikeStacks or 0) < 2
		elseif kind == "EXECUTE" then
			return damage.Value > 0 and (definition.ExecuteStacks or 0) < 2
		elseif kind == "KILL_REFUND" then
			return damage.Value > 0 and definition.CooldownTurns > 1 and (definition.KillRefund or 0) == 0
		elseif kind == "SHOCKWAVE" then
			return damage.Value > 0 and single and (definition.ShockwaveDamage or 0) == 0
		elseif kind == "HEAVY_PUSH" then
			if damage.Value <= 0 or moving or (definition.HeavyPush or 0) > 0 then return false end
			for _, step in ipairs(steps) do
				if step.EffectType == "PUSH" or step.EffectType == "PULL" then return false end
			end
			return true
		elseif kind == "BATTLE_STANCE" then
			return damage.Value > 0 and (definition.BattleStance or 0) == 0
		elseif kind == "QUICK" then
			return hits == 1 and damage.Value - effect.Amount >= 1
		elseif kind == "POWER" or kind == "PRECISE" then
			if hits ~= 1 or not single then return false end
			return true
		elseif kind == "VOLLEY" then
			return hits >= 2 and (definition.WeaponType == "BOW" or definition.WeaponType == "CROSSBOW" or definition.WeaponType == "CLAW" or definition.WeaponType == "GUN")
		elseif kind == "COMPACT" then
			return hits >= 3 and hits - effect.Amount >= 2
		elseif kind == "AREA" then
			return hits == 1 and not single
		elseif kind == "RANGE" then
			if moving or definition.Range >= 6 or (definition.ProjectileRuid or "") == "" then return false end
			if definition.TargetingType == "FIRST_ENEMY_FORWARD" or definition.TargetingType == "FIRST_ENEMY_PIERCE" then return true end
			if definition.TargetingType ~= "RANGE_OFFSETS" then return false end
			for offset in string.gmatch(definition.TargetOffsets or "", "([^|]+)") do
				if (tonumber(offset) or 0) <= 0 then return false end
			end
			return (definition.TargetOffsets or "") ~= ""
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method string GetBoundSkillAugment(Entity player, string skillId)
		-- Ignores stale run state and keeps enemy/global skill definitions immutable.
		if not isvalid(player) then return "" end
		local run = player:GetComponent("script.PlayerRunStateComponent")
		local state = player:GetComponent("script.PlayerRunAugmentComponent")
		if run == nil or state == nil or run.RunSequence <= 0 or state.ActiveRunSequence ~= run.RunSequence then return "" end
		return state:GetSkillAugmentId(skillId)
	end

	@ExecSpace("ServerOnly")
	method table BuildSkillBundle(Entity player, table definition, table steps, string overrideAugmentId)
		-- Apply owned modifiers in order and retain their names for additive upgrade comparisons.
		local result = self:ApplySkillModifier(definition, steps, "")
		local owner = isvalid(player) and player:GetComponent("script.PlayerRunAugmentComponent") or nil
		local run = isvalid(player) and player:GetComponent("script.PlayerRunStateComponent") or nil
		local ids = {}
		if overrideAugmentId ~= "NONE" and owner ~= nil and run ~= nil and owner.ActiveRunSequence == run.RunSequence then
			ids = owner:GetSkillAugmentIds(definition.SkillId)
		end
		if overrideAugmentId ~= "" and overrideAugmentId ~= "NONE" then table.insert(ids, overrideAugmentId) end
		local names = {}
		local descriptions = {}
		for _, id in ipairs(ids) do
			result = self:ApplySkillModifier(result.Definition, result.EffectSteps, id)
			if result.AugmentId ~= "" then
				table.insert(names, result.AugmentName)
				table.insert(descriptions, result.Description)
			end
		end
		result.AugmentNames = names
		result.AugmentName = names[#names] or ""
		result.Description = table.concat(descriptions, "\n")
		result.AugmentStage = #ids
		result.Definition.SkillAugmentName = result.AugmentName
		result.Definition.SkillAugmentDescription = result.Description
		return result
	end

	@ExecSpace("ServerOnly")
	method table ApplySkillModifier(table definition, table steps, string augmentId)
		-- Copies the current accumulated bundle before applying one validated trade-off.
		local result = { Definition = {}, EffectSteps = {}, AugmentId = "", AugmentName = "", Description = "" }
		for key, value in pairs(definition) do result.Definition[key] = value end
		for _, step in ipairs(steps) do
			local copied = {}
			for key, value in pairs(step) do copied[key] = value end
			table.insert(result.EffectSteps, copied)
		end
		if augmentId == "" or augmentId == "NONE" then return result end
		local checked = _AugmentContentValidatorLogic:ValidateById(augmentId)
		-- Eligibility is checked when granting/offering. Replaying owned modifiers must survive tier upgrades.
		if not checked.Success then return result end
		local effect = checked.Data.Effects[1]
		local kind = effect.ParamA
		if kind == "HEAL_CHARGES" then
			-- Preview metadata only. This reward never changes the combat skill or binds a modifier.
			if augmentId ~= "" then
				result.AugmentId = augmentId
				result.AugmentName = checked.Data.Definition.NameKey
				result.Description = checked.Data.Definition.DescriptionKey
			end
			return result
		end
		local amount = effect.Amount
		local tuned = result.Definition
		tuned.CooldownTurns = math.max(1, definition.CooldownTurns + tonumber(effect.ParamB))
		if kind == "HEAL_UNLIMITED" then tuned.CostValue = 0 end
		if kind == "ZERO_DAMAGE_FREE_LOAD" then
			tuned.FreePlay = true
			tuned.ZeroDamage = true
		end
		for _, step in ipairs(result.EffectSteps) do
			if kind == "REGEN_HEAL" and step.EffectType == "HEAL" then step.Value = math.max(1, step.Value - amount) end
			if kind == "BUFF_DURATION" and self:IsExtendableBuff(step.EffectType) then
				step.ParameterA = tostring((tonumber(step.ParameterA) or 0) + amount)
			end
			if step.EffectType == "DAMAGE" then
				if kind == "ZERO_DAMAGE_FREE_LOAD" then step.Value = 0 end
				if kind == "POWER" or kind == "AREA" then step.Value = step.Value + amount end
				if kind == "QUICK" then step.Value = math.max(1, step.Value - amount) end
				if kind == "VOLLEY" or kind == "COMPACT" then
					local delta = kind == "VOLLEY" and amount or -amount
					step.ParameterB = tostring(_DamageEffectExecutorLogic:GetHitCount(step) + delta)
					if (tuned.ProjectileRuid or "") ~= "" then tuned.ProjectileCount = tonumber(step.ParameterB) end
				end
			end
		end
		if kind == "RANGE" then
			tuned.Range = math.min(6, tuned.Range + amount)
			if tuned.TargetingType == "RANGE_OFFSETS" then
				local offsets = {}
				local last = 0
				for token in string.gmatch(tuned.TargetOffsets, "([^|]+)") do
					table.insert(offsets, token)
					last = math.max(last, tonumber(token) or 0)
				end
				for index = 1, amount do table.insert(offsets, tostring(last + index)) end
				tuned.TargetOffsets = table.concat(offsets, "|")
			end
		end
		result.AugmentId = augmentId
		result.AugmentName = checked.Data.Definition.NameKey
		result.Description = checked.Data.Definition.DescriptionKey
		if kind == "FIRST_STRIKE" then
			tuned.FirstStrikeStacks = (definition.FirstStrikeStacks or 0) + 1
			tuned.FirstStrikeDamage = (definition.FirstStrikeDamage or 0) + amount
		elseif kind == "EXECUTE" then
			tuned.ExecuteStacks = (definition.ExecuteStacks or 0) + 1
			tuned.ExecuteDamage = (definition.ExecuteDamage or 0) + amount
		elseif kind == "KILL_REFUND" then tuned.KillRefund = amount
		elseif kind == "SHOCKWAVE" then tuned.ShockwaveDamage = amount
		elseif kind == "HEAVY_PUSH" then tuned.HeavyPush = amount
		elseif kind == "BATTLE_STANCE" then tuned.BattleStance = amount
		elseif kind == "REGEN_HEAL" then tuned.RegenHealAmount = amount
		elseif kind == "BUFF_DURATION" then tuned.BuffDurationStacks = (definition.BuffDurationStacks or 0) + 1 end
		tuned.AugmentCooldownFloor = 1
		tuned.SkillAugmentId = augmentId
		tuned.SkillAugmentName = result.AugmentName
		tuned.SkillAugmentDescription = result.Description
		tuned.PreciseRefund = (definition.PreciseRefund or 0) + (kind == "PRECISE" and amount or 0)
		return result
	end

	@ExecSpace("ServerOnly")
	method table GetEffectiveSkillBundle(Entity player, string skillId)
		-- One validated read model serves execution, queue duration and skill HUD.
		local checked = _ContentValidatorLogic:ValidateSkillById(skillId)
		if not checked.Success then return checked end
		return { Success = true, Data = self:BuildSkillBundle(player, checked.Data.Definition, checked.Data.EffectSteps, "") }
	end

	method boolean IsExtendableBuff(string effectType)
		-- Only turn-based buffs extend; attack/venom hit charges and combo queues keep their budgets.
		return effectType == "DEFENSE_BUFF" or effectType == "MAX_HP_BUFF"
			or effectType == "GUARD_BUFF" or effectType == "DAMAGE_CAP_BUFF"
	end


	@ExecSpace("ServerOnly")
	method number GetConditionalDamageBonus(table context, string sourceUnitId, string skillId, any targetUnit)
		-- Sample HP on the first direct hit per target/cast, shared by melee and delayed projectiles.
		if context == nil or context.SourceUnitId ~= sourceUnitId or context.SkillId ~= skillId
			or context.Definition == nil or context.Definition.ZeroDamage == true then return 0 end
		context.AugmentDamageTargets = context.AugmentDamageTargets or {}
		if context.AugmentDamageTargets[targetUnit.UnitId] then return 0 end
		context.AugmentDamageTargets[targetUnit.UnitId] = true
		local bonus = 0
		if targetUnit.CurrentHp >= targetUnit.MaxHp then bonus = bonus + (context.Definition.FirstStrikeDamage or 0) end
		if targetUnit.CurrentHp > 0 and targetUnit.CurrentHp * 10 <= targetUnit.MaxHp * 3 then
			bonus = bonus + (context.Definition.ExecuteDamage or 0)
		end
		return bonus
	end

	@ExecSpace("ServerOnly")
	method void OnSkillDamageApplied(table context, Entity sourceEntity, any targetUnit, table damageResult)
		-- Record once-per-cast follow-ups before death handling can finish the encounter.
		if context == nil or context.Definition == nil or context.Definition.ZeroDamage == true
			or damageResult.AppliedAmount <= 0 then return end
		local definition = context.Definition
		local session = context.BattleSession
		local sourceUnit = sourceEntity:GetComponent("script.BattleUnitComponent")
		if sourceUnit == nil or sourceUnit.Team ~= "Player" or targetUnit.Team ~= "Enemy" then return end
		if (definition.KillRefund or 0) > 0 and damageResult.ReachedZero == true and not context.AugmentKillRefunded then
			context.AugmentKillRefunded = true
			local cooldown = session:GetSkillRuntimeState(context.SourceUnitId)
			if cooldown ~= nil then
				cooldown:ReduceCooldown(context.SkillId, math.min(definition.KillRefund, math.max(0, cooldown:GetRemainingCooldown(context.SkillId) - 1)))
				log("[SkillAugment] kill refund skill=" .. context.SkillId)
			end
		end
		if (definition.BattleStance or 0) > 0 and not context.AugmentStanceApplied then
			context.AugmentStanceApplied = true
			-- Shared stance key refreshes one defensive stance instead of stacking it across skills.
			sourceUnit:ApplyTimedBuff("AUGMENT_BATTLE_STANCE", "DEFENSE", definition.BattleStance, 1)
		end
		if (definition.ShockwaveDamage or 0) > 0 and context.AugmentShockwaveCell == nil then
			context.AugmentShockwaveCell = targetUnit.CellIndex
			context.AugmentShockwavePrimary = targetUnit.UnitId
		end
		if (definition.HeavyPush or 0) > 0 then
			context.AugmentPushTargets = context.AugmentPushTargets or {}
			context.AugmentPushSeen = context.AugmentPushSeen or {}
			if not context.AugmentPushSeen[targetUnit.UnitId] then
				context.AugmentPushSeen[targetUnit.UnitId] = true
				table.insert(context.AugmentPushTargets, targetUnit.UnitId)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void CompleteSkillAugment(table context)
		-- Resolve extra hits/displacement after all original hits, without changing volley targeting mid-cast.
		if context.AugmentCompletionNotified then return end
		context.AugmentCompletionNotified = true
		local session = context.BattleSession
		if session == nil or session.EntryRequestId ~= context.EntryRequestId or session.BattleResult ~= "" then return end
		local source = session:FindUnitEntity(context.SourceUnitId)
		if not isvalid(source) then return end
		local unit = source:GetComponent("script.BattleUnitComponent")
		if unit == nil or unit.IsDead or unit.Team ~= "Player" then return end
		local definition = context.Definition
		if definition.ZeroDamage == true then return end
		if context.AugmentShockwaveCell ~= nil and (definition.ShockwaveDamage or 0) > 0 then
			local seen = {}
			for _, offset in ipairs({ -1, 1 }) do
				if session.EntryRequestId ~= context.EntryRequestId or session.BattleResult ~= "" then break end
				local cell = context.AugmentShockwaveCell + offset
				local target = session.BoardState:FindAtCell(cell, context.SourceUnitId)
				if session:IsValidCell(cell) and isvalid(target) then
					local enemy = target:GetComponent("script.BattleUnitComponent")
					if enemy ~= nil and enemy.Team == "Enemy" and not enemy.IsDead
						and enemy.UnitId ~= context.AugmentShockwavePrimary and not seen[enemy.UnitId] then
						seen[enemy.UnitId] = true
						-- A distinct fixed-damage ID blocks attack bonuses, venom, refunds and recursive shockwaves.
						session:ApplyDamage(context.SourceUnitId, enemy.UnitId, definition.ShockwaveDamage, "AUGMENT_SHOCKWAVE")
					end
				end
			end
			log("[SkillAugment] shockwave skill=" .. context.SkillId .. " cell=" .. context.AugmentShockwaveCell)
		end
		for _, targetId in ipairs(context.AugmentPushTargets or {}) do
			if session.EntryRequestId ~= context.EntryRequestId or session.BattleResult ~= "" then break end
			session:ResolvePushImpactOnTarget(context.SourceUnitId, targetId)
		end
	end

	@ExecSpace("ServerOnly")
	method boolean QueueSkillRegeneration(table context, any targetUnit)
		-- One heal-over-time entry per skill/target; recasting refreshes two future ticks.
		if context == nil or context.Definition == nil or (context.Definition.RegenHealAmount or 0) <= 0
			or targetUnit.IsDead then return false end
		local session = context.BattleSession
		if session == nil then return false end
		targetUnit._T.AugmentRegeneration = targetUnit._T.AugmentRegeneration or {}
		targetUnit._T.AugmentRegeneration[context.SkillId] = {
			Amount = context.Definition.RegenHealAmount, Remaining = 2, LastTurn = session.TurnNumber,
			Entry = session.EntryRequestId, MapId = tostring(session.Entity.Id)
		}
		log("[SkillAugment] regeneration queued skill=" .. context.SkillId .. " target=" .. targetUnit.UnitId)
		return true
	end

	@ExecSpace("ServerOnly")
	method void AdvanceSkillRegeneration(any session, any unit)
		-- Never heal on the cast turn, duplicate triggers, death, or a different battle entry.
		local entries = unit._T.AugmentRegeneration
		if entries == nil then return end
		local remove = {}
		for skillId, entry in pairs(entries) do
			if unit.IsDead or entry.Entry ~= session.EntryRequestId or entry.MapId ~= tostring(session.Entity.Id) or session.BattleResult ~= "" then
				table.insert(remove, skillId)
			elseif session.TurnNumber > entry.LastTurn then
				entry.LastTurn = session.TurnNumber
				entry.Remaining = entry.Remaining - 1
				local healed = unit:ApplyHealing(entry.Amount)
				if healed.Success then
					session:PlayActiveHitEffect(unit.UnitId)
					session:RefreshPlayerHpSnapshot("AUGMENT_REGENERATION")
				end
				log("[SkillAugment] regeneration tick skill=" .. skillId .. " remaining=" .. entry.Remaining)
				if entry.Remaining <= 0 then table.insert(remove, skillId) end
			end
		end
		for _, skillId in ipairs(remove) do entries[skillId] = nil end
	end

end
