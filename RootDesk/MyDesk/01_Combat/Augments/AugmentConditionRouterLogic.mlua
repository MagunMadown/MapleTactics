@Logic
script AugmentConditionRouterLogic

	@ExecSpace("ServerOnly")
	method boolean IsRegistered(string conditionType)
		-- Keeps condition validation aligned with executable handlers.
		return conditionType == "ALWAYS" or conditionType == "HP_RATIO_LE"
	end

	@ExecSpace("ServerOnly")
	method table Evaluate(table effectDefinition, table context)
		-- Evaluates one side-effect-free condition against the event context.
		local conditionType = effectDefinition.ConditionType or ""
		if self:IsRegistered(conditionType) == false then
			return { Success = false, Reason = "AUGMENT_CONDITION_NOT_REGISTERED", Passed = false, ConditionType = conditionType }
		end
		if conditionType == "ALWAYS" then
			return { Success = true, Reason = "CONDITION_PASSED", Passed = true, ConditionType = conditionType }
		end
		local sourceUnit = context ~= nil and context.SourceUnit or nil
		if sourceUnit == nil or sourceUnit.MaxHp <= 0 then
			return { Success = false, Reason = "AUGMENT_CONDITION_CONTEXT_MISSING", Passed = false, ConditionType = conditionType }
		end
		local hpRatio = sourceUnit.CurrentHp / sourceUnit.MaxHp
		local passed = hpRatio <= effectDefinition.ConditionValue
		return {
			Success = true,
			Reason = passed and "CONDITION_PASSED" or "CONDITION_NOT_MET",
			Passed = passed,
			ConditionType = conditionType,
			ActualValue = hpRatio,
			RequiredValue = effectDefinition.ConditionValue
		}
	end

end
