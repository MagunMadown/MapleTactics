@Logic
script AugmentEffectRouterLogic

	@ExecSpace("ServerOnly")
	method boolean IsRegistered(string effectType, string targetType)
		-- Registers atomic augment effects only when their target contract is executable.
		return effectType == "HEAL" and targetType == "SELF"
	end

	@ExecSpace("ServerOnly")
	method table Execute(table effectDefinition, table context)
		-- Delegates state mutation to an atomic effect handler.
		if self:IsRegistered(effectDefinition.EffectType, effectDefinition.TargetType) == false then
			return { Success = false, Reason = "AUGMENT_EFFECT_NOT_REGISTERED", EffectType = effectDefinition.EffectType or "", TargetType = effectDefinition.TargetType or "" }
		end
		if effectDefinition.EffectType == "HEAL" then
			return _AugmentHealEffectLogic:Execute(effectDefinition, context)
		end
		return { Success = false, Reason = "AUGMENT_EFFECT_NOT_REGISTERED", EffectType = effectDefinition.EffectType or "" }
	end

end
