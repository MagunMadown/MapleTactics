@Logic
script AugmentHealEffectLogic

	@ExecSpace("ServerOnly")
	method table Execute(table effectDefinition, table context)
		-- Applies a SELF heal through BattleUnitComponent without owning HP state.
		if effectDefinition.TargetType ~= "SELF" then
			return { Success = false, Reason = "AUGMENT_TARGET_NOT_SUPPORTED", EffectType = "HEAL" }
		end
		local targetUnit = context ~= nil and context.SourceUnit or nil
		if targetUnit == nil then
			return { Success = false, Reason = "AUGMENT_TARGET_MISSING", EffectType = "HEAL" }
		end
		local result = targetUnit:ApplyHealing(effectDefinition.Amount)
		result.EffectType = "HEAL"
		result.TargetType = "SELF"
		return result
	end

end
