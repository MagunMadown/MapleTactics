@Component
script TEMP_GrassPlatformPreview extends Component

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Initialize the removable six-cell animation comparison.
        self._T.Ready = false
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Hide only the original platform artwork while all six preview effects exist.
        local player = _UserService.LocalPlayer
        if isvalid(player) == false or player.CurrentMap ~= self.Entity.CurrentMap then
            self:RestoreOriginalVisual()
            return
        end
        if self._T.Ready ~= true then
            local count = 0
            for index = 1, 6 do
                local effect = self.Entity:GetChildByName("Highlight" .. tostring(index))
                if isvalid(effect) and effect.SpriteRendererComponent ~= nil then
                    count = count + 1
                end
            end
            if count ~= 6 then return end
            self._T.Ready = true
            log("[TEMP_PlatformAB] ready: 6 transparent cells; left 3=A, right 3=B")
        end
        if self._T.Active ~= true then
            local layout = self.Entity.CurrentMap:GetComponent("script.BattleTileColor")
            if layout == nil then return end
            self._T.Layout = layout
            self._T.OriginalEnable = layout.Enable
            layout.Enable = false
            self._T.Active = true
            log("[TEMP_PlatformAB] active map=" .. self.Entity.CurrentMap.Name .. "; original platform artwork hidden")
        end
    end

    @ExecSpace("ClientOnly")
    method void RestoreOriginalVisual()
        -- Restore the original artwork when leaving or deleting the temporary preview.
        if self._T.Active == true then
            if isvalid(self._T.Layout) then self._T.Layout.Enable = self._T.OriginalEnable end
            self._T.Active = false
            log("[TEMP_PlatformAB] original visual restored")
        end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Release the temporary override without changing any saved combat or UI settings.
        self:RestoreOriginalVisual()
    end

end
