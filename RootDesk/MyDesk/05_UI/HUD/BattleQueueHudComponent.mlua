@Component
script BattleQueueHudComponent extends Component

	property TextGUIRendererComponent TurnText = "9131478e-61b4-4407-aa83-e7a6713b52e1"
	property TextGUIRendererComponent QueueText = "2de108e0-4a2c-47d5-978b-95abcc41cfc4"
	property TextGUIRendererComponent StateText = "58f909f5-23c5-4f42-8146-636e325bc6f2"
	property SpriteGUIRendererComponent QueueSlotSprite = "0d724bbe-bc8a-4688-b32f-4d0e1e9db038"
	property ButtonComponent BasicSlashButton = "6c09c873-3f2a-4205-866a-506bb96e8ea3"
	property ButtonComponent HeavySlashButton = "bc90b79c-4e8f-4299-81f8-204963e1ac3f"
	property ButtonComponent PushButton = "1d567770-8c5d-4fce-bd4d-3927c5883427"
	property ButtonComponent ExecuteButton = "564a6e86-cad3-49f8-a18f-927f1bb729c3"
	property ButtonComponent ClearButton = "e46286f2-7013-4c7a-8c03-fd7ca3e887c8"
	property SpriteGUIRendererComponent ResultPanelSprite = "6f0764a9-6582-48bb-8163-cb30159fcf81"
	property TextGUIRendererComponent ResultText = "03d1ba1c-ffab-4aac-8fee-cb226a46b86e"
	property ButtonComponent ResetButton = "bf41edb1-bbbf-44d6-9d43-630e31343807"
	property SpriteGUIRendererComponent ResetButtonSprite = "bf41edb1-bbbf-44d6-9d43-630e31343807"
	property TextGUIRendererComponent ResetButtonText = "bf41edb1-bbbf-44d6-9d43-630e31343807"
	property number RefreshInterval = 0.05
	property number RefreshElapsed = 0
	property string LastSignature = ""
	property any BasicSlashClickHandler = nil
	property any HeavySlashClickHandler = nil
	property any PushClickHandler = nil
	property any ExecuteClickHandler = nil
	property any ClearClickHandler = nil
	property any ResetClickHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- The HUD is presentation-only. BattleSessionComponent remains the source of truth.
		log("[BattleQueueHUD] ready")
		self.BasicSlashClickHandler = self.BasicSlashButton.Entity:ConnectEvent(ButtonClickEvent, self.OnBasicSlashClicked)
		self.HeavySlashClickHandler = self.HeavySlashButton.Entity:ConnectEvent(ButtonClickEvent, self.OnHeavySlashClicked)
		self.PushClickHandler = self.PushButton.Entity:ConnectEvent(ButtonClickEvent, self.OnPushClicked)
		self.ExecuteClickHandler = self.ExecuteButton.Entity:ConnectEvent(ButtonClickEvent, self.OnExecuteClicked)
		self.ClearClickHandler = self.ClearButton.Entity:ConnectEvent(ButtonClickEvent, self.OnClearClicked)
		self.ResetClickHandler = self.ResetButton.Entity:ConnectEvent(ButtonClickEvent, self.OnResetClicked)
		self:RefreshHud(true)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- Disconnects button callbacks so UI reloads cannot duplicate tile requests.
		if self.BasicSlashClickHandler ~= nil then
			self.BasicSlashButton.Entity:DisconnectEvent(ButtonClickEvent, self.BasicSlashClickHandler)
			self.BasicSlashClickHandler = nil
		end
		if self.HeavySlashClickHandler ~= nil then
			self.HeavySlashButton.Entity:DisconnectEvent(ButtonClickEvent, self.HeavySlashClickHandler)
			self.HeavySlashClickHandler = nil
		end
		if self.PushClickHandler ~= nil then
			self.PushButton.Entity:DisconnectEvent(ButtonClickEvent, self.PushClickHandler)
			self.PushClickHandler = nil
		end
		if self.ExecuteClickHandler ~= nil then
			self.ExecuteButton.Entity:DisconnectEvent(ButtonClickEvent, self.ExecuteClickHandler)
			self.ExecuteClickHandler = nil
		end
		if self.ClearClickHandler ~= nil then
			self.ClearButton.Entity:DisconnectEvent(ButtonClickEvent, self.ClearClickHandler)
			self.ClearClickHandler = nil
		end
		if self.ResetClickHandler ~= nil then
			self.ResetButton.Entity:DisconnectEvent(ButtonClickEvent, self.ResetClickHandler)
			self.ResetClickHandler = nil
		end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- A short poll also covers sync updates that arrive after UI initialization.
		self.RefreshElapsed = self.RefreshElapsed + delta
		if self.RefreshElapsed < self.RefreshInterval then
			return
		end

		self.RefreshElapsed = 0
		self:RefreshHud(false)
	end

	@ExecSpace("ClientOnly")
	method void RefreshHud(boolean force)
		-- Mirrors the registered tile, running action, phase, and input availability from the map session.
		local session = self:GetBattleSession()
		if session == nil then
			self:SetUnavailableState("전투 세션 없음")
			return
		end

		local phaseLabel = self:GetPhaseLabel(session.BattlePhase)
		local visibleQueue = session.QueuedTileIds
		local activeIndex = 0
		if session.ExecutingTileIds ~= "" then
			visibleQueue = session.ExecutingTileIds
			activeIndex = session.ExecutingTileIndex
		end
		local queueLabel = self:GetQueueLabel(visibleQueue, activeIndex, session.TileQueueCapacity)
		local inputLabel = "타일 선택"
		if session.IsActionProcessing then
			if activeIndex > 0 then
				inputLabel = "큐 실행 중 " .. activeIndex .. "/" .. self:GetTileCount(visibleQueue)
			else
				inputLabel = "처리 중"
			end
		elseif session.QueuedTileCount > 0 then
			inputLabel = session.QueuedTileCount .. "/" .. session.TileQueueCapacity .. " · 실행 대기"
		end

		if session.BattleResult ~= "" then
			inputLabel = "전투 종료"
			queueLabel = session.BattleResult == "Victory" and "승리" or "패배"
		end

		local signature = session.BattlePhase .. ":" .. session.TurnNumber .. ":" .. session.QueuedActionType .. ":" .. session.QueuedTileIds .. ":" .. session.ExecutingTileIds .. ":" .. session.ExecutingTileIndex .. ":" .. session.QueuedTileCount .. ":" .. session.TileQueueCapacity .. ":" .. tostring(session.IsActionProcessing) .. ":" .. session.BattleResult
		if force == false and self.LastSignature == signature then
			return
		end

		self.LastSignature = signature
		self.TurnText.Text = "TURN " .. session.TurnNumber
		self.QueueText.Text = queueLabel
		self.StateText.Text = phaseLabel .. "  ·  " .. inputLabel

		local canChooseTile = session.BattleResult == "" and session.BattlePhase == "PlayerTurn" and session.IsActionProcessing == false and session.QueuedTileCount < session.TileQueueCapacity
		local canUseQueuedTile = session.BattleResult == "" and session.BattlePhase == "PlayerTurn" and session.IsActionProcessing == false and session.QueuedTileCount > 0
		self.BasicSlashButton.Enable = canChooseTile
		self.HeavySlashButton.Enable = canChooseTile
		self.PushButton.Enable = canChooseTile
		self.ExecuteButton.Enable = canUseQueuedTile
		self.ClearButton.Enable = canUseQueuedTile
		if visibleQueue == "" then
			self.QueueSlotSprite.Color = Color(0.15, 0.20, 0.28, 1)
		elseif activeIndex > 0 then
			self.QueueSlotSprite.Color = Color(0.22, 0.40, 0.24, 1)
		else
			self.QueueSlotSprite.Color = Color(0.38, 0.30, 0.12, 1)
		end
		self:SetResultVisibility(session.BattleResult)

		log("[BattleQueueHUD] refreshed phase=" .. session.BattlePhase .. " turn=" .. session.TurnNumber .. " queued=" .. session.QueuedTileIds .. " executing=" .. session.ExecutingTileIds .. " index=" .. session.ExecutingTileIndex .. " count=" .. session.QueuedTileCount .. "/" .. session.TileQueueCapacity .. " action=" .. session.QueuedActionType .. " processing=" .. tostring(session.IsActionProcessing) .. " result=" .. session.BattleResult)
	end

	@ExecSpace("ClientOnly")
	method void SetUnavailableState(string reason)
		-- Shows a safe inactive state until the local player and map session are available.
		local signature = "Unavailable:" .. reason
		if self.LastSignature == signature then
			return
		end

		self.LastSignature = signature
		self.TurnText.Text = "TURN -"
		self.QueueText.Text = "전투 대기"
		self.StateText.Text = reason
		self.BasicSlashButton.Enable = false
		self.HeavySlashButton.Enable = false
		self.PushButton.Enable = false
		self.ExecuteButton.Enable = false
		self.ClearButton.Enable = false
		self:SetResultVisibility("")
		log("[BattleQueueHUD] unavailable reason=" .. reason)
	end

	@ExecSpace("ClientOnly")
	method void SetResultVisibility(string battleResult)
		-- Shows the compact result panel only after the synchronized battle result is final.
		local visible = battleResult ~= ""
		self.ResultPanelSprite.Enable = visible
		self.ResultText.Enable = visible
		self.ResetButton.Enable = visible
		self.ResetButtonSprite.Enable = visible
		self.ResetButtonText.Enable = visible
		if visible then
			self.ResultText.Text = battleResult == "Victory" and "VICTORY" or "DEFEAT"
		end
	end

	@ExecSpace("ClientOnly")
	method any GetBattleSession()
		-- Returns the local player's current map-scoped battle session component.
		local player = _UserService.LocalPlayer
		if player == nil or player.CurrentMap == nil then
			return nil
		end

		return player.CurrentMap:GetComponent("script.BattleSessionComponent")
	end

	@ExecSpace("ClientOnly")
	method void OnBasicSlashClicked()
		-- Requests registration of the first minimal attack tile without executing it immediately.
		local session = self:GetBattleSession()
		if session == nil then
			log_warning("[BattleQueueHUD] register click ignored reason=SESSION_MISSING")
			return
		end

		log("[BattleQueueHUD] register clicked tile=basic_slash")
		session:RequestQueueTile("basic_slash")
	end

	@ExecSpace("ClientOnly")
	method void OnHeavySlashClicked()
		-- Registers the second attack tile while preserving the same one-slot queue rules.
		local session = self:GetBattleSession()
		if session == nil then
			log_warning("[BattleQueueHUD] register click ignored tile=heavy_slash reason=SESSION_MISSING")
			return
		end

		log("[BattleQueueHUD] register clicked tile=heavy_slash")
		session:RequestQueueTile("heavy_slash")
	end

	@ExecSpace("ClientOnly")
	method void OnPushClicked()
		-- Registers a displacement tile that moves the current front target one cell away at impact time.
		local session = self:GetBattleSession()
		if session == nil then
			log_warning("[BattleQueueHUD] register click ignored tile=push reason=SESSION_MISSING")
			return
		end

		log("[BattleQueueHUD] register clicked tile=push")
		session:RequestQueueTile("push")
	end

	@ExecSpace("ClientOnly")
	method void OnExecuteClicked()
		-- Requests execution of the currently registered tile through the server battle session.
		local session = self:GetBattleSession()
		if session == nil then
			log_warning("[BattleQueueHUD] execute click ignored reason=SESSION_MISSING")
			return
		end

		log("[BattleQueueHUD] execute clicked")
		session:RequestExecuteQueuedTile()
	end

	@ExecSpace("ClientOnly")
	method void OnClearClicked()
		-- Requests removal of the registered tile without consuming the player's turn.
		local session = self:GetBattleSession()
		if session == nil then
			log_warning("[BattleQueueHUD] clear click ignored reason=SESSION_MISSING")
			return
		end

		log("[BattleQueueHUD] clear clicked")
		session:RequestClearQueuedTile()
	end

	@ExecSpace("ClientOnly")
	method void OnResetClicked()
		-- Requests restoration of the current map-scoped battle after a final result.
		local session = self:GetBattleSession()
		if session == nil then
			log_warning("[BattleQueueHUD] reset click ignored reason=SESSION_MISSING")
			return
		end

		log("[BattleQueueHUD] reset clicked")
		session:RequestResetBattle()
	end

	@ExecSpace("ClientOnly")
	method string GetPhaseLabel(string phase)
		-- Converts synchronized phase keys into compact Korean HUD labels.
		if phase == "Setup" then
			return "전투 준비"
		elseif phase == "PlayerTurn" then
			return "플레이어 턴"
		elseif phase == "EnemyTurn" then
			return "적 턴"
		elseif phase == "BattleEnded" then
			return "전투 종료"
		end

		return phase
	end

	@ExecSpace("ClientOnly")
	method string GetQueueLabel(string serializedQueue, integer activeIndex, integer capacity)
		-- Renders any queue length without requiring one hard-coded UI entity per slot.
		if serializedQueue == "" then
			return "빈 큐  (0/" .. capacity .. ")"
		end

		local label = ""
		local index = 0
		for tileId in string.gmatch(serializedQueue, "([^|]+)") do
			index = index + 1
			if label ~= "" then
				label = label .. "  →  "
			end
			local prefix = "["
			if index == activeIndex then
				prefix = "▶["
			end
			label = label .. prefix .. self:GetTileLabel(tileId) .. "]"
		end
		return label .. "  (" .. index .. "/" .. capacity .. ")"
	end

	@ExecSpace("ClientOnly")
	method string GetTileLabel(string tileId)
		if tileId == "basic_slash" then
			return "기본 베기"
		elseif tileId == "heavy_slash" then
			return "강한 베기"
		elseif tileId == "push" then
			return "밀치기"
		end
		return tileId
	end

	@ExecSpace("ClientOnly")
	method integer GetTileCount(string serializedQueue)
		if serializedQueue == "" then
			return 0
		end
		local count = 0
		for _ in string.gmatch(serializedQueue, "([^|]+)") do
			count = count + 1
		end
		return count
	end

	@ExecSpace("ClientOnly")
	method string GetActionLabel(string actionType)
		-- Converts internal action identifiers into player-facing queue text.
		if actionType == "" then
			return "대기"
		elseif actionType == "MOVE" then
			return "이동"
		elseif actionType == "TURN" then
			return "방향 전환"
		elseif actionType == "BASIC_ATTACK" then
			return "기본 공격"
		elseif actionType == "HEAVY_SLASH" then
			return "강한 베기"
		elseif actionType == "PUSH" then
			return "밀치기"
		elseif actionType == "ENEMY_THINK" then
			return "적 행동 준비"
		elseif actionType == "ENEMY_MOVE" then
			return "적 이동"
		elseif actionType == "ENEMY_BASIC_ATTACK" then
			return "적 기본 공격"
		elseif actionType == "ENEMY_WAIT" then
			return "적 대기"
		end

		return actionType
	end

end
