@Component
script BattleQueueHudComponent extends Component

	property TextGUIRendererComponent TurnText = "9131478e-61b4-4407-aa83-e7a6713b52e1"
	property TextGUIRendererComponent QueueText = "2de108e0-4a2c-47d5-978b-95abcc41cfc4"
	property TextGUIRendererComponent StateText = "58f909f5-23c5-4f42-8146-636e325bc6f2"
	property SpriteGUIRendererComponent QueueSlotSprite = "0d724bbe-bc8a-4688-b32f-4d0e1e9db038"
	property ButtonComponent BasicSlashButton = "6c09c873-3f2a-4205-866a-506bb96e8ea3"
	property ButtonComponent HeavySlashButton = "bc90b79c-4e8f-4299-81f8-204963e1ac3f"
	property ButtonComponent PushButton = "1d567770-8c5d-4fce-bd4d-3927c5883427"
	property ButtonComponent ExecuteButton = "564a6e86-cad3-49f8-a18f-927f1bb729c3"
	property ButtonComponent ClearButton = "e46286f2-7013-4c7a-8c03-fd7ca3e887c8"
	property SpriteGUIRendererComponent ResultPanelSprite = "6f0764a9-6582-48bb-8163-cb30159fcf81"
	property TextGUIRendererComponent ResultText = "03d1ba1c-ffab-4aac-8fee-cb226a46b86e"
	property ButtonComponent ResetButton = "bf41edb1-bbbf-44d6-9d43-630e31343807"
	property SpriteGUIRendererComponent ResetButtonSprite = "bf41edb1-bbbf-44d6-9d43-630e31343807"
	property TextGUIRendererComponent ResetButtonText = "bf41edb1-bbbf-44d6-9d43-630e31343807"
	property number RefreshInterval = 0.05
	property number RefreshElapsed = 0
	property string LastSignature = ""
	property any BasicSlashClickHandler = nil
	property any HeavySlashClickHandler = nil
	property any PushClickHandler = nil
	property any ExecuteClickHandler = nil
	property any ClearClickHandler = nil
	property any ResetClickHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- The HUD reads turn state from BattleTurnComponent and sends commands through BattleSessionComponent.
		log("[BattleQueueHUD] ready")
		self.BasicSlashClickHandler = self.BasicSlashButton.Entity:ConnectEvent(ButtonClickEvent, self.OnBasicSlashClicked)
		self.HeavySlashClickHandler = self.HeavySlashButton.Entity:ConnectEvent(ButtonClickEvent, self.OnHeavySlashClicked)
		self.PushClickHandler = self.PushButton.Entity:ConnectEvent(ButtonClickEvent, self.OnPushClicked)
		self.ExecuteClickHandler = self.ExecuteButton.Entity:ConnectEvent(ButtonClickEvent, self.OnExecuteClicked)
		self.ClearClickHandler = self.ClearButton.Entity:ConnectEvent(ButtonClickEvent, self.OnClearClicked)
		self.ResetClickHandler = self.ResetButton.Entity:ConnectEvent(ButtonClickEvent, self.OnResetClicked)
		self:RefreshHud(true)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- Disconnects button callbacks so UI reloads cannot duplicate tile requests.
		if self.BasicSlashClickHandler ~= nil then
			self.BasicSlashButton.Entity:DisconnectEvent(ButtonClickEvent, self.BasicSlashClickHandler)
			self.BasicSlashClickHandler = nil
		end
		if self.HeavySlashClickHandler ~= nil then
			self.HeavySlashButton.Entity:DisconnectEvent(ButtonClickEvent, self.HeavySlashClickHandler)
			self.HeavySlashClickHandler = nil
		end
		if self.PushClickHandler ~= nil then
			self.PushButton.Entity:DisconnectEvent(ButtonClickEvent, self.PushClickHandler)
			self.PushClickHandler = nil
		end
		if self.ExecuteClickHandler ~= nil then
			self.ExecuteButton.Entity:DisconnectEvent(ButtonClickEvent, self.ExecuteClickHandler)
			self.ExecuteClickHandler = nil
		end
		if self.ClearClickHandler ~= nil then
			self.ClearButton.Entity:DisconnectEvent(ButtonClickEvent, self.ClearClickHandler)
			self.ClearClickHandler = nil
		end
		if self.ResetClickHandler ~= nil then
			self.ResetButton.Entity:DisconnectEvent(ButtonClickEvent, self.ResetClickHandler)
			self.ResetClickHandler = nil
		end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- A short poll also covers sync updates that arrive after UI initialization.
		self.RefreshElapsed = self.RefreshElapsed + delta
		if self.RefreshElapsed < self.RefreshInterval then
			return
		end

		self.RefreshElapsed = 0
		self:RefreshHud(false)
	end

	@ExecSpace("ClientOnly")
	method void RefreshHud(boolean force)
		-- Mirrors the registered tile, running action, phase, and input availability from the map session.
		local session = self:GetBattleSession()
		local turnState = self:GetBattleTurnState()
		local waveState = self:GetBattleWaveState()
		if session == nil or turnState == nil or waveState == nil then
			self:SetUnavailableState("전투 상태 없음")
			return
		end
		local uiState = session:GetBattleUiState()
		if uiState == nil or uiState.Success == false then
			self:SetUnavailableState(uiState == nil and "UI 상태 없음" or uiState.Reason)
			return
		end
		local queueState = uiState.PlayerQueue

		local phaseLabel = self:GetPhaseLabel(uiState.Phase)
		local visibleQueue = queueState.QueuedTileIds
		local activeIndex = 0
		if queueState.ExecutingTileIds ~= "" then
			visibleQueue = queueState.ExecutingTileIds
			activeIndex = queueState.ExecutingIndex
		end
		local queueLabel = self:GetQueueLabel(visibleQueue, activeIndex, queueState.EffectiveCapacity)
		local inputLabel = "타일 선택"
		if uiState.IsProcessing then
			if activeIndex > 0 then
				inputLabel = "큐 실행 중 " .. activeIndex .. "/" .. self:GetTileCount(visibleQueue)
			else
				inputLabel = "처리 중"
			end
		elseif queueState.Count > 0 then
			inputLabel = queueState.Count .. "/" .. queueState.EffectiveCapacity .. " · 실행 대기"
		end
		if uiState.Phase == "WaveTransition" then
			inputLabel = "다음 웨이브 준비"
		end

		if uiState.BattleResult ~= "" then
			inputLabel = "전투 종료"
			queueLabel = uiState.BattleResult == "Victory" and "승리" or "패배"
		end

		local enemyIntentLabel = self:GetEnemyIntentLabel(uiState)
		local reinforcementLabel = self:GetReinforcementLabel(session.StageTurnNumber, waveState)
		local cooldownSnapshot = uiState.CooldownSnapshot
		local cooldownLabel = self:GetCooldownLabel(cooldownSnapshot)
		local signature = session.StageNumber .. ":" .. session.StageTurnNumber .. ":" .. uiState.RevisionKey .. ":" .. waveState.CurrentWaveSpawnMode .. ":" .. waveState.ForceAfterTurns .. ":" .. waveState.WaveSpawnStageTurn .. ":" .. tostring(waveState.ForceSpawnPending) .. ":" .. waveState.ForceSpawnPendingReason .. ":" .. tostring(uiState.Drops.Revision) .. ":" .. tostring(uiState.RunInventory.Revision)
		if force == false and self.LastSignature == signature then
			return
		end

		self.LastSignature = signature
		self.TurnText.Text = "TURN " .. uiState.TurnNumber
		self.QueueText.Text = queueLabel
		local consumableLabel = uiState.RunInventory.ConsumableSnapshot == "" and "없음" or uiState.RunInventory.ConsumableSnapshot
		self.StateText.Text = "STAGE " .. session.StageNumber .. "  ·  WAVE " .. waveState.CurrentWave .. "/" .. waveState.TotalWaves .. "  ·  " .. reinforcementLabel .. "  ·  " .. phaseLabel .. "  ·  " .. inputLabel .. "  ·  " .. cooldownLabel .. "  ·  DROP " .. uiState.Drops.PendingCount .. "  ·  소비품 " .. consumableLabel .. " (H 사용)  ·  적 예고: " .. enemyIntentLabel

		local canChooseTile = uiState.Commands.CanQueue
		local canUseQueuedTile = uiState.Commands.CanExecute
		local ownedSkills = uiState.RunInventory.SkillSnapshot
		self.BasicSlashButton.Enable = canChooseTile and self:IsSkillOwned(ownedSkills, "basic_slash") and self:GetCooldownTurns(cooldownSnapshot, "basic_slash") <= 0
		self.HeavySlashButton.Enable = canChooseTile and self:IsSkillOwned(ownedSkills, "heavy_slash") and self:GetCooldownTurns(cooldownSnapshot, "heavy_slash") <= 0 and self:QueueContainsSkill(queueState.QueuedTileIds, "heavy_slash") == false
		self.PushButton.Enable = canChooseTile and self:IsSkillOwned(ownedSkills, "push") and self:GetCooldownTurns(cooldownSnapshot, "push") <= 0 and self:QueueContainsSkill(queueState.QueuedTileIds, "push") == false
		self.ExecuteButton.Enable = canUseQueuedTile
		self.ClearButton.Enable = uiState.Commands.CanClear
		if visibleQueue == "" then
			self.QueueSlotSprite.Color = Color(0.15, 0.20, 0.28, 1)
		elseif activeIndex > 0 then
			self.QueueSlotSprite.Color = Color(0.22, 0.40, 0.24, 1)
		else
			self.QueueSlotSprite.Color = Color(0.38, 0.30, 0.12, 1)
		end
		self:SetResultVisibility(uiState.BattleResult)

		log("[BattleQueueHUD] refreshed stage=" .. session.StageNumber .. " wave=" .. waveState.CurrentWave .. "/" .. waveState.TotalWaves .. " waveState=" .. waveState.WaveState .. " reinforcement=" .. reinforcementLabel .. " phase=" .. turnState.BattlePhase .. " turn=" .. turnState.TurnNumber .. " queued=" .. turnState.QueuedTileIds .. " executing=" .. turnState.ExecutingTileIds .. " index=" .. turnState.ExecutingTileIndex .. " count=" .. turnState.QueuedTileCount .. "/" .. turnState.TileQueueCapacity .. " action=" .. turnState.QueuedActionType .. " processing=" .. tostring(turnState.IsActionProcessing) .. " cooldowns=" .. cooldownSnapshot .. " intentState=" .. session.PreparedEnemyIntentState .. " intentAction=" .. session.PreparedEnemyActionType .. " intentTile=" .. session.PreparedEnemyTileId .. " intentTelegraphRemaining=" .. session.PreparedEnemyTelegraphTurnsRemaining .. " intentTurn=" .. session.PreparedEnemyTurn .. " result=" .. session.BattleResult)
	end

	@ExecSpace("ClientOnly")
	method void SetUnavailableState(string reason)
		-- Shows a safe inactive state until the local player and map session are available.
		local signature = "Unavailable:" .. reason
		if self.LastSignature == signature then
			return
		end

		self.LastSignature = signature
		self.TurnText.Text = "TURN -"
		self.QueueText.Text = "전투 대기"
		self.StateText.Text = reason
		self.BasicSlashButton.Enable = false
		self.HeavySlashButton.Enable = false
		self.PushButton.Enable = false
		self.ExecuteButton.Enable = false
		self.ClearButton.Enable = false
		self:SetResultVisibility("")
		log("[BattleQueueHUD] unavailable reason=" .. reason)
	end

	@ExecSpace("ClientOnly")
	method void SetResultVisibility(string battleResult)
		-- Shows the compact result panel only after the synchronized battle result is final.
		local visible = battleResult ~= ""
		self.ResultPanelSprite.Enable = visible
		self.ResultText.Enable = visible
		self.ResetButton.Enable = visible
		self.ResetButtonSprite.Enable = visible
		self.ResetButtonText.Enable = visible
		if visible then
			self.ResultText.Text = battleResult == "Victory" and "VICTORY" or "DEFEAT"
		end
	end

	@ExecSpace("ClientOnly")
	method any GetBattleSession()
		-- Returns the local player's current map-scoped battle session component.
		local player = _UserService.LocalPlayer
		if player == nil or player.CurrentMap == nil then
			return nil
		end

		return player.CurrentMap:GetComponent("script.BattleSessionComponent")
	end

	@ExecSpace("ClientOnly")
	method any GetBattleTurnState()
		local player = _UserService.LocalPlayer
		if player == nil or player.CurrentMap == nil then
			return nil
		end
		local stateEntity = player.CurrentMap:GetChildByName("BattleTurnState")
		if stateEntity == nil then
			return player.CurrentMap:GetComponent("script.BattleTurnComponent")
		end
		return stateEntity:GetComponent("script.BattleTurnComponent")
	end

	@ExecSpace("ClientOnly")
	method any GetBattleWaveState()
		local player = _UserService.LocalPlayer
		if player == nil or player.CurrentMap == nil then
			return nil
		end
		local stateEntity = player.CurrentMap:GetChildByName("BattleWaveState")
		if stateEntity == nil then
			return player.CurrentMap:GetComponent("script.BattleWaveComponent")
		end
		return stateEntity:GetComponent("script.BattleWaveComponent")
	end

	@ExecSpace("ClientOnly")
	method any GetLocalSkillRuntimeState()
		local player = _UserService.LocalPlayer
		if player == nil then
			return nil
		end
		return player:GetComponent("script.SkillRuntimeStateComponent")
	end

	@ExecSpace("ClientOnly")
	method integer GetCooldownTurns(string cooldownSnapshot, string skillId)
		for entry in string.gmatch(cooldownSnapshot, "([^|]+)") do
			local entrySkillId = string.match(entry, "^([^:]+):")
			local remainingTurns = string.match(entry, ":(%d+)$")
			if entrySkillId == skillId then
				return math.max(0, math.floor(tonumber(remainingTurns) or 0))
			end
		end
		return 0
	end

	@ExecSpace("ClientOnly")
	method string GetCooldownLabel(string cooldownSnapshot)
		if cooldownSnapshot == "" then
			return "쿨타임 준비"
		end
		local labels = {}
		for entry in string.gmatch(cooldownSnapshot, "([^|]+)") do
			local skillId = string.match(entry, "^([^:]+):")
			local remainingTurns = string.match(entry, ":(%d+)$")
			if skillId ~= nil then
				table.insert(labels, self:GetTileLabel(skillId) .. " " .. remainingTurns)
			end
		end
		if #labels == 0 then
			return "쿨타임 준비"
		end
		return "CD " .. table.concat(labels, ", ")
	end

	@ExecSpace("ClientOnly")
	method boolean QueueContainsSkill(string serializedQueue, string skillId)
		for queuedSkillId in string.gmatch(serializedQueue, "([^|]+)") do
			if queuedSkillId == skillId then
				return true
			end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method boolean IsSkillOwned(string skillSnapshot, string skillId)
		-- Reads the TargetUserSync id~amount ownership DTO without duplicating server authority.
		for entry in string.gmatch(skillSnapshot or "", "([^|]+)") do
			local separator, _ = string.find(entry, "~", 1, true)
			if separator ~= nil and string.sub(entry, 1, separator - 1) == skillId then
				return (tonumber(string.sub(entry, separator + 1)) or 0) > 0
			end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method void OnBasicSlashClicked()
		-- Requests registration of the first minimal attack tile without executing it immediately.
		local session = self:GetBattleSession()
		if session == nil then
			log_warning("[BattleQueueHUD] register click ignored reason=SESSION_MISSING")
			return
		end

		log("[BattleQueueHUD] register clicked tile=basic_slash")
		session:RequestQueueTile("basic_slash")
	end

	@ExecSpace("ClientOnly")
	method void OnHeavySlashClicked()
		-- Registers the second attack tile while preserving the same one-slot queue rules.
		local session = self:GetBattleSession()
		if session == nil then
			log_warning("[BattleQueueHUD] register click ignored tile=heavy_slash reason=SESSION_MISSING")
			return
		end

		log("[BattleQueueHUD] register clicked tile=heavy_slash")
		session:RequestQueueTile("heavy_slash")
	end

	@ExecSpace("ClientOnly")
	method void OnPushClicked()
		-- Registers a displacement tile that moves the current front target one cell away at impact time.
		local session = self:GetBattleSession()
		if session == nil then
			log_warning("[BattleQueueHUD] register click ignored tile=push reason=SESSION_MISSING")
			return
		end

		log("[BattleQueueHUD] register clicked tile=push")
		session:RequestQueueTile("push")
	end

	@ExecSpace("ClientOnly")
	method void OnExecuteClicked()
		-- Requests execution of the currently registered tile through the server battle session.
		local session = self:GetBattleSession()
		if session == nil then
			log_warning("[BattleQueueHUD] execute click ignored reason=SESSION_MISSING")
			return
		end

		log("[BattleQueueHUD] execute clicked")
		session:RequestExecuteQueuedTile()
	end

	@ExecSpace("ClientOnly")
	method void OnClearClicked()
		-- Requests removal of the registered tile without consuming the player's turn.
		local session = self:GetBattleSession()
		if session == nil then
			log_warning("[BattleQueueHUD] clear click ignored reason=SESSION_MISSING")
			return
		end

		log("[BattleQueueHUD] clear clicked")
		session:RequestClearQueuedTile()
	end

	@ExecSpace("ClientOnly")
	method void OnResetClicked()
		-- Requests restoration of the current map-scoped battle after a final result.
		local session = self:GetBattleSession()
		if session == nil then
			log_warning("[BattleQueueHUD] reset click ignored reason=SESSION_MISSING")
			return
		end

		log("[BattleQueueHUD] reset clicked")
		session:RequestResetBattle()
	end

	@ExecSpace("ClientOnly")
	method string GetPhaseLabel(string phase)
		-- Converts synchronized phase keys into compact Korean HUD labels.
		if phase == "Setup" then
			return "전투 준비"
		elseif phase == "PlayerTurn" then
			return "플레이어 턴"
		elseif phase == "EnemyTurn" then
			return "적 턴"
		elseif phase == "WaveTransition" then
			return "웨이브 완료"
		elseif phase == "BattleEnded" then
			return "전투 종료"
		end

		return phase
	end

	@ExecSpace("ClientOnly")
	method string GetReinforcementLabel(integer stageTurnNumber, any waveState)
		-- Displays the synchronized pressure rule without duplicating server spawn decisions.
		if waveState.CurrentWave >= waveState.TotalWaves then
			return "마지막 웨이브"
		end
		if waveState.ForceSpawnPending == true then
			return "증원 대기"
		end
		if waveState.CurrentWaveSpawnMode == "TURN_LIMIT" or waveState.CurrentWaveSpawnMode == "TURN_OR_TIME" then
			local elapsedTurns = math.max(0, stageTurnNumber - waveState.WaveSpawnStageTurn)
			local remainingTurns = math.max(0, waveState.ForceAfterTurns - elapsedTurns)
			if waveState.CurrentWaveSpawnMode == "TURN_OR_TIME" then
				return "증원 " .. remainingTurns .. "턴/시간"
			end
			return "증원까지 " .. remainingTurns .. "턴"
		elseif waveState.CurrentWaveSpawnMode == "TIME_LIMIT" then
			return "시간제 증원"
		end
		return "전멸 시 증원"
	end

	@ExecSpace("ClientOnly")
	method string GetQueueLabel(string serializedQueue, integer activeIndex, integer capacity)
		-- Renders any queue length without requiring one hard-coded UI entity per slot.
		if serializedQueue == "" then
			return "빈 큐  (0/" .. capacity .. ")"
		end

		local label = ""
		local index = 0
		for tileId in string.gmatch(serializedQueue, "([^|]+)") do
			index = index + 1
			if label ~= "" then
				label = label .. "  →  "
			end
			local prefix = "["
			if index == activeIndex then
				prefix = "▶["
			end
			label = label .. prefix .. self:GetTileLabel(tileId) .. "]"
		end
		return label .. "  (" .. index .. "/" .. capacity .. ")"
	end

	@ExecSpace("ClientOnly")
	method string GetTileLabel(string tileId)
		if tileId == "basic_slash" then
			return "기본 베기"
		elseif tileId == "heavy_slash" then
			return "강한 베기"
		elseif tileId == "push" then
			return "밀치기"
		elseif tileId == "slash_push_combo" then
			return "베고 밀치기"
		end
		return tileId
	end

	@ExecSpace("ClientOnly")
	method string GetEnemyIntentLabel(table uiState)
		-- Renders every synchronized enemy plan in SpawnOrder without duplicating AI decisions.
		if uiState == nil or uiState.EnemyIntents == nil or #uiState.EnemyIntents == 0 then
			return "준비 중"
		end
		local labels = {}
		for _, intent in ipairs(uiState.EnemyIntents) do
			local label = intent.CommandType
			if intent.CommandType == "EXECUTE_TILE" then
				label = self:GetTileLabel(intent.TileId)
			elseif intent.CommandType == "TELEGRAPH_TILE" then
				label = self:GetTileLabel(intent.TileId) .. " 예고 " .. intent.TelegraphTurnsRemaining .. "턴"
			elseif intent.CommandType == "MOVE_TOWARD" then
				label = "추적 접근"
			elseif intent.CommandType == "MOVE_AWAY" then
				label = "후퇴"
			elseif intent.CommandType == "MOVE_FIXED_FACING" then
				label = "고정 방향 전진"
			elseif intent.CommandType == "TURN_TO_PLAYER" then
				label = "플레이어 방향 전환"
			elseif intent.CommandType == "WAIT" then
				label = "대기"
			elseif intent.State == "COMPLETED" then
				label = "행동 완료"
			end
			local prefix = "#" .. tostring(intent.SpawnOrder)
			if intent.State == "EXECUTING" then
				prefix = prefix .. " 실행"
			end
			if intent.ActionCount > 1 then
				label = label .. " " .. intent.CurrentActionIndex .. "/" .. intent.ActionCount
			end
			if intent.TraitIds ~= "" then
				label = label .. " [" .. intent.TraitIds .. "]"
			end
			table.insert(labels, prefix .. " " .. label)
		end
		return table.concat(labels, " / ")
	end

	@ExecSpace("ClientOnly")
	method integer GetTileCount(string serializedQueue)
		if serializedQueue == "" then
			return 0
		end
		local count = 0
		for _ in string.gmatch(serializedQueue, "([^|]+)") do
			count = count + 1
		end
		return count
	end

	@ExecSpace("ClientOnly")
	method string GetActionLabel(string actionType)
		-- Converts internal action identifiers into player-facing queue text.
		if actionType == "" then
			return "대기"
		elseif actionType == "MOVE" then
			return "이동"
		elseif actionType == "TURN" then
			return "방향 전환"
		elseif actionType == "BASIC_ATTACK" then
			return "기본 공격"
		elseif actionType == "HEAVY_SLASH" then
			return "강한 베기"
		elseif actionType == "PUSH" then
			return "밀치기"
		elseif actionType == "ENEMY_MOVE_TOWARD" then
			return "적 추적 이동"
		elseif actionType == "ENEMY_MOVE_FIXED_FACING" then
			return "적 고정 방향 이동"
		elseif actionType == "ENEMY_TURN_TO_PLAYER" then
			return "적 방향 전환"
		elseif actionType == "ENEMY_EXECUTE_TILE" then
			return "적 기본 공격"
		elseif actionType == "ENEMY_WAIT" then
			return "적 대기"
		end

		return actionType
	end

end
