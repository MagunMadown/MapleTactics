@Component
script PlayerOverheadQueueHudComponent extends Component

	property Entity ReservationQueue = "22e2a4fe-44a2-44c3-a14b-aa8d19add365"
	property UITransformComponent ReservationQueueTransform = "22e2a4fe-44a2-44c3-a14b-aa8d19add365"
	property Entity QueueSlot01 = "e1e8d80a-7f73-4e33-bca7-f2a5a750fda7"
	property Entity QueueSlot02 = "c7a4ea66-58e8-4dc4-9892-73920fe70a0f"
	property Entity QueueSlot03 = "0680cab0-99a6-47c9-9635-5524bb8fb610"
	property Entity QueueSlot04 = "5c8a6a01-721d-41eb-8d94-a9eefe275556"
	property Entity QueueSlot05 = "f329167f-e29d-430e-8354-0ca01842ea3d"
	property Entity QueueSlot06 = "24be138d-8984-4482-b850-ab8312bce585"
	-- Reuse each slot's front-most InnerBackground as the icon surface. The former SkillIcon
	-- entities render behind it (displayOrder 1 vs 3), which made only the dark cell visible.
	property SpriteGUIRendererComponent SkillIcon01 = "df893bbe-214c-430c-8d0c-4b414510ab38"
	property SpriteGUIRendererComponent SkillIcon02 = "78f2e6c2-3c78-4e13-b8ed-17f350f8f8cf"
	property SpriteGUIRendererComponent SkillIcon03 = "e263a898-94e8-499f-bf59-4fd25e7ed1e0"
	property SpriteGUIRendererComponent SkillIcon04 = "48c09223-5d50-43d8-918d-e7d3b17a6aaf"
	property SpriteGUIRendererComponent SkillIcon05 = "4aab1647-ec75-4c89-8378-ea6a607ac009"
	property SpriteGUIRendererComponent SkillIcon06 = "318b5cf9-dbf8-49f8-b55a-d2b9eff5ac56"
	property ButtonComponent QueueDragButton01 = "df893bbe-214c-430c-8d0c-4b414510ab38"
	property ButtonComponent QueueDragButton02 = "78f2e6c2-3c78-4e13-b8ed-17f350f8f8cf"
	property ButtonComponent QueueDragButton03 = "e263a898-94e8-499f-bf59-4fd25e7ed1e0"
	property ButtonComponent QueueDragButton04 = "48c09223-5d50-43d8-918d-e7d3b17a6aaf"
	property ButtonComponent QueueDragButton05 = "4aab1647-ec75-4c89-8378-ea6a607ac009"
	property ButtonComponent QueueDragButton06 = "318b5cf9-dbf8-49f8-b55a-d2b9eff5ac56"
	property SpriteGUIRendererComponent QueueDragGhost = "4f9549e7-8f1b-4a24-a89b-025c88b9dfe4"
	property Entity CoveredSkillIcon01 = "635992c8-f68a-436e-a5c6-7ace2d40aeff"
	property Entity CoveredSkillIcon02 = "0f3f9d7c-08dd-4750-bc88-17100d9485c9"
	property Entity CoveredSkillIcon03 = "8f11a178-2391-4069-bdd7-c1b4b3860c2e"
	property Entity CoveredSkillIcon04 = "b0aabd94-85db-46c2-b6be-8fe075e414f1"
	property Entity CoveredSkillIcon05 = "ec49004f-4095-4451-9580-b66557ce9cdb"
	property Entity CoveredSkillIcon06 = "c78e0e14-6d8b-494c-bdc6-1ebdf14d8179"
	property TextGUIRendererComponent SkillNameText01 = "3881fea7-e02f-4876-9422-62d4160ccd01"
	property TextGUIRendererComponent SkillNameText02 = "ec82408b-8c65-42b9-97e1-a8e9b90bd4af"
	property TextGUIRendererComponent SkillNameText03 = "1aad877b-1fb7-462a-a1ae-97e8a2e34952"
	property TextGUIRendererComponent SkillNameText04 = "6c57539b-ba9e-490b-84b7-ab10c406f8d7"
	property TextGUIRendererComponent SkillNameText05 = "35ff658a-1433-466e-a1aa-30b3203888c6"
	property TextGUIRendererComponent SkillNameText06 = "00fcff66-4e10-4774-a8ef-acfaa643b685"
	property Entity QueueDropRegion = "f75c88c2-ef3c-465b-aa9a-8007b1a2f9ac"
	property UITransformComponent QueueDropRegionTransform = "f75c88c2-ef3c-465b-aa9a-8007b1a2f9ac"
	property string DefaultSkillIconRuid = "1705e3c5b2c146ac9a699f96fb067408"
	property integer QueueMaxSlots = 6
	property number QueueSlotSize = 76
	property number QueueSlotSpacing = 76
	property number QueueFirstSlotCenterOffsetY = -24
	property integer CurrentQueueCapacity = 0
	property integer CurrentQueueCount = 0
	property integer CurrentVisibleSlotCount = 0
	property integer CurrentQueueOrderRevision = 0
	property boolean QueueInteractionAvailable = false
	property boolean QueueReorderAvailable = false
	property string CurrentQueuedTileIds = ""
	property boolean BottomSkillDragTargetActive = false
	property boolean BottomSkillDragTargetValid = false
	property number QueueDragThreshold = 10
	property number QueueDragGhostAlpha = 0.86
	property number QueueDragSourceAlpha = 0.42
	property number QueueDragGhostOffsetX = 14
	property number QueueDragGhostOffsetY = 18
	property number QueueReorderPendingTimeout = 1.00
	property number QueueDropMarginX = 22
	property number QueueDropMarginY = 20
	property number QueuePreviewShiftDuration = 0.10
	property number QueuePreviewSettleDuration = 0.14
	property number QueuePreviewCancelDuration = 0.12
	property number QueueEmptyRevealDuration = 0.11
	property number QueueEmptyRevealOffsetY = 10
	property integer QueueReorderNextRequestId = 0
	property integer QueueReorderPendingRequestId = 0
	property number QueueReorderPendingElapsed = 0
	property integer QueueReorderLastReceiptRevision = 0
	property string IconSnapshot = ""
	property number PlayerHeadOffsetY = 1.65
	property number RefreshInterval = 0.05
	property number RefreshElapsed = 0
	property string LastSignature = ""
	property Entity UtilitySkillHUD = "f42118e7-10a5-428b-a958-77752a8e4b8c"
	property UITransformComponent UtilitySkillHUDTransform = "f42118e7-10a5-428b-a958-77752a8e4b8c"
	property SpriteGUIRendererComponent UtilityIcon = "a17311dd-c941-496d-a43c-5d1fbc7242ae"
	property Entity UtilityCooldownPipContainer = "db94f1e4-293f-4d64-98e0-2b9b18177b8d"
	property integer UtilityCooldownPipPoolSize = 4
	property number UtilityHudOffsetX = 94
	property number UtilityHudOffsetY = -24
	property string UtilitySkillId = ""
	property integer UtilityMaxCooldown = 0
	property integer UtilityRemainingCooldown = 0
	property boolean UtilityRuntimeAvailable = false

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self._T.QueueItemDragHandlers = {}
		self:ResetQueueItemDragState()
		self:ResetQueuePreviewState()
		self:SetCoveredIconsHidden()
		self:BindQueueItemDragHandlers()
		self:BuildUtilityCooldownPipView()
		self:HideUtilityCooldownHud("INITIALIZE")
		self:SetQueueHidden("INITIALIZE")
		log("[PlayerOverheadQueueHUD] ready maxSlots=" .. tostring(self.QueueMaxSlots) .. " utilityPips=" .. tostring(self.UtilityCooldownPipPoolSize))
	end

	@ExecSpace("ClientOnly")
	method void SetCoveredIconsHidden()
		-- These legacy icon entities sit below the opaque InnerBackground and are no longer used.
		if self.CoveredSkillIcon01 ~= nil then
			self.CoveredSkillIcon01.Enable = false
		end
		if self.CoveredSkillIcon02 ~= nil then
			self.CoveredSkillIcon02.Enable = false
		end
		if self.CoveredSkillIcon03 ~= nil then
			self.CoveredSkillIcon03.Enable = false
		end
		if self.CoveredSkillIcon04 ~= nil then
			self.CoveredSkillIcon04.Enable = false
		end
		if self.CoveredSkillIcon05 ~= nil then
			self.CoveredSkillIcon05.Enable = false
		end
		if self.CoveredSkillIcon06 ~= nil then
			self.CoveredSkillIcon06.Enable = false
		end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		self:UpdateQueueSlotMotion(delta)
		self:UpdateQueueEmptyReveal(delta)
		self:UpdateQueueSuccessSettle(delta)
		local player = _UserService.LocalPlayer
		local session = self:GetBattleSession(player)
		if session == nil then
			self:CleanupQueueItemDragVisuals(false)
			self.QueueReorderPendingRequestId = 0
			self.QueueReorderPendingElapsed = 0
			self:SetQueueHidden("NOT_IN_BATTLE")
			self:HideUtilityCooldownHud("NOT_IN_BATTLE")
			return
		end

		if self.QueueReorderPendingRequestId > 0 then
			self.QueueReorderPendingElapsed = self.QueueReorderPendingElapsed + delta
			if self.QueueReorderPendingElapsed >= self.QueueReorderPendingTimeout then
				log_warning("[PlayerQueueDrag] receipt timeout request=" .. tostring(self.QueueReorderPendingRequestId))
				self.QueueReorderPendingRequestId = 0
				self.QueueReorderPendingElapsed = 0
				self._T.QueuePreviewPending = false
				self:StartAuthoritativeQueueMotion(self.QueuePreviewCancelDuration)
			end
		end

		self:UpdatePlayerTracking(player)
		self.RefreshElapsed = self.RefreshElapsed + delta
		if self.RefreshElapsed < self.RefreshInterval then
			return
		end

		self.RefreshElapsed = 0
		self:RefreshQueue(session)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		self:DisconnectQueueItemDragHandlers()
		self:CleanupQueueItemDragVisuals(false)
		self.QueueReorderPendingRequestId = 0
		self.QueueReorderPendingElapsed = 0
		self:ResetQueuePreviewState()
		self:SetQueueHidden("END_PLAY")
		self:HideUtilityCooldownHud("END_PLAY")
	end

	@ExecSpace("ClientOnly")
	method any GetBattleSession(Entity player)
		if isvalid(player) == false or player.CurrentMap == nil then
			return nil
		end

		return player.CurrentMap:GetComponent("script.BattleSessionComponent")
	end

	@ExecSpace("ClientOnly")
	method void UpdatePlayerTracking(Entity player)
		if isvalid(player) == false or player.TransformComponent == nil then
			return
		end

		local worldPosition = player.TransformComponent.WorldPosition
		local screenPosition = _UILogic:WorldToScreenPosition(Vector2(worldPosition.x, worldPosition.y + self.PlayerHeadOffsetY))
		local uiPosition = _UILogic:ScreenToUIPosition(screenPosition)
		if self.ReservationQueueTransform ~= nil then
			local visibleSlotCount = math.max(1, math.min(self.QueueMaxSlots, self.CurrentVisibleSlotCount))
			local centerOffsetY = self.QueueFirstSlotCenterOffsetY + math.max(0, visibleSlotCount - 1) * self.QueueSlotSpacing * 0.5
			self.ReservationQueueTransform.anchoredPosition = Vector2(uiPosition.x, uiPosition.y + centerOffsetY)
		end
		if self.UtilitySkillHUDTransform ~= nil then
			-- Align beside the lowest reservation slot so the utility HUD never covers the avatar.
			self.UtilitySkillHUDTransform.anchoredPosition = Vector2(uiPosition.x + self.UtilityHudOffsetX, uiPosition.y + self.UtilityHudOffsetY)
		end
	end

	@ExecSpace("ClientOnly")
	method void BuildUtilityCooldownPipView()
		-- Cache the authored four-pip pool once. No utility runtime entity is created by this HUD.
		self._T.UtilityCooldownPips = {}
		if isvalid(self.UtilityCooldownPipContainer) == false then
			return
		end
		for pipIndex = 1, self.UtilityCooldownPipPoolSize do
			local pip = self.UtilityCooldownPipContainer:GetChildByName("UtilityCooldownPip0" .. tostring(pipIndex), false)
			if isvalid(pip) then
				table.insert(self._T.UtilityCooldownPips, pip)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void SetUtilityCooldownState(string utilitySkillId, string iconRuid, integer maxCooldown, integer remainingCooldown, boolean runtimeAvailable)
		-- Future utility runtime/presenter boundary. This view never starts or decrements cooldowns itself.
		if runtimeAvailable == false or utilitySkillId == nil or utilitySkillId == "" or maxCooldown <= 0 then
			self:HideUtilityCooldownHud("RUNTIME_UNAVAILABLE")
			return
		end
		if iconRuid == nil or iconRuid == "" then
			-- UtilitySkillDefinitions currently author no icon RUID; do not invent a placeholder.
			self:HideUtilityCooldownHud("ICON_DATA_MISSING")
			return
		end

		self.UtilityRuntimeAvailable = true
		self.UtilitySkillId = utilitySkillId
		self.UtilityMaxCooldown = math.max(0, math.min(self.UtilityCooldownPipPoolSize, maxCooldown))
		self.UtilityRemainingCooldown = math.max(0, math.min(self.UtilityMaxCooldown, remainingCooldown))
		self.UtilityIcon.ImageRUID = DataRef(iconRuid)
		self.UtilityIcon.Type = ImageType.Simple
		self.UtilityIcon.DropShadow = false
		self.UtilityIcon.Color = Color(1, 1, 1, 1)
		self.UtilityIcon.Entity.Enable = true
		self.UtilityIcon.Enable = true
		self.UtilityCooldownPipContainer.Enable = true
		self.UtilitySkillHUD.Enable = true
		self:RefreshUtilityCooldownPips(self.UtilityMaxCooldown, self.UtilityRemainingCooldown)
	end

	@ExecSpace("ClientOnly")
	method void RefreshUtilityCooldownPips(integer maxCooldown, integer remainingCooldown)
		-- Mirrors the bottom skill bar: recovered pips fill left-to-right, ready means all active.
		local visibleCount = math.max(0, math.min(self.UtilityCooldownPipPoolSize, maxCooldown))
		local clampedRemaining = math.max(0, math.min(visibleCount, remainingCooldown))
		local recoveredCount = visibleCount - clampedRemaining
		local pipWidth = 10
		local pipHeight = 6
		local pipSpacing = 2
		local rowWidth = visibleCount * pipWidth + math.max(0, visibleCount - 1) * pipSpacing
		local activeColor = Color(1.00, 0.72, 0.18, 1)
		local inactiveColor = Color(0.48, 0.52, 0.58, 1)
		for pipIndex, pip in ipairs(self._T.UtilityCooldownPips or {}) do
			local visible = pipIndex <= visibleCount
			pip.Enable = visible
			if pip.UITransformComponent ~= nil then
				local x = -rowWidth * 0.5 + pipWidth * 0.5 + (pipIndex - 1) * (pipWidth + pipSpacing)
				pip.UITransformComponent.anchoredPosition = Vector2(x, 0)
				pip.UITransformComponent.RectSize = Vector2(pipWidth, pipHeight)
			end
			if pip.SpriteGUIRendererComponent ~= nil then
				pip.SpriteGUIRendererComponent.Enable = visible
				if pipIndex <= recoveredCount then
					pip.SpriteGUIRendererComponent.Color = activeColor
				else
					pip.SpriteGUIRendererComponent.Color = inactiveColor
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void HideUtilityCooldownHud(string reason)
		self.UtilityRuntimeAvailable = false
		self.UtilitySkillId = ""
		self.UtilityMaxCooldown = 0
		self.UtilityRemainingCooldown = 0
		if self.UtilitySkillHUD ~= nil then
			self.UtilitySkillHUD.Enable = false
		end
		if self.UtilityIcon ~= nil then
			self.UtilityIcon.Enable = false
			if self.UtilityIcon.Entity ~= nil then
				self.UtilityIcon.Entity.Enable = false
			end
		end
		if self.UtilityCooldownPipContainer ~= nil then
			self.UtilityCooldownPipContainer.Enable = false
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshQueue(any session)
		self:SyncIconSnapshot(session)
		local uiState = session:GetBattleUiState()
		if uiState == nil or uiState.Success == false or uiState.PlayerQueue == nil then
			self:SetQueueHidden("SNAPSHOT_UNAVAILABLE")
			return
		end

		local queueState = uiState.PlayerQueue
		local positionsBeforeRefresh = self:CaptureQueueSlotYPositions()
		local previousQueueCount = self.CurrentQueueCount
		local previousVisibleSlotCount = self.CurrentVisibleSlotCount
		local previewWasPending = self._T.QueuePreviewPending == true
		local previewSnapshot = self._T.QueuePreviewPendingSnapshot or ""
		local previewRevision = self._T.QueuePreviewPendingRevision or 0
		self:ConsumeQueueReorderReceipt(queueState)
		local queueCapacity = math.max(1, math.min(self.QueueMaxSlots, queueState.EffectiveCapacity or 1))
		local serializedQueue = queueState.QueuedTileIds or ""
		local firstVisibleIndex = 1
		local source = "QUEUED"
		if queueState.ExecutingTileIds ~= nil and queueState.ExecutingTileIds ~= "" then
			serializedQueue = queueState.ExecutingTileIds
			firstVisibleIndex = math.max(1, queueState.ExecutingIndex or 1)
			source = "EXECUTING"
		end

		local visibleSkills = self:GetVisibleSkills(serializedQueue, firstVisibleIndex)
		local queueCount = queueState.Count or 0
		local visibleSlotCount = math.max(1, math.min(queueCapacity, queueCount))
		if source == "QUEUED" and queueCount < queueCapacity then
			visibleSlotCount = math.min(queueCapacity, queueCount + 1)
		elseif source == "EXECUTING" then
			visibleSlotCount = math.max(1, math.min(queueCapacity, #visibleSkills))
		end
		local queueInteractionAvailable = source == "QUEUED"
			and uiState.Commands ~= nil
			and uiState.Commands.CanQueue == true
		local queueReorderAvailable = source == "QUEUED"
			and uiState.Commands ~= nil
			and uiState.Commands.CanReorder == true
		local queueOrderRevision = queueState.QueueOrderRevision or 0
		local reorderReceiptRevision = queueState.ReorderReceipt ~= nil and (queueState.ReorderReceipt.Revision or 0) or 0
		-- The icon snapshot is part of the signature because it syncs independently of the queue: without
		-- it, icons that arrive after the tiles were already drawn would stay on the placeholder.
		local signature = source .. ":" .. tostring(firstVisibleIndex) .. ":" .. tostring(queueCapacity) .. ":" .. tostring(visibleSlotCount) .. ":" .. tostring(queueOrderRevision) .. ":" .. tostring(reorderReceiptRevision) .. ":" .. tostring(queueInteractionAvailable) .. ":" .. tostring(queueReorderAvailable) .. ":" .. table.concat(visibleSkills, "|") .. ":" .. self.IconSnapshot
		if self.LastSignature == signature then
			return
		end

		self.LastSignature = signature
		self.CurrentQueueCapacity = queueCapacity
		self.CurrentQueueCount = queueCount
		self.CurrentVisibleSlotCount = visibleSlotCount
		self.CurrentQueueOrderRevision = queueOrderRevision
		self.QueueInteractionAvailable = queueInteractionAvailable
		self.QueueReorderAvailable = queueReorderAvailable
		self.CurrentQueuedTileIds = source == "QUEUED" and serializedQueue or ""
		self:ValidateQueueItemDragSnapshot()
		self:UpdateQueueLayout(visibleSlotCount)
		for slotIndex = 1, self.QueueMaxSlots do
			self:SetSlot(slotIndex, visibleSkills[slotIndex] or "", slotIndex <= visibleSlotCount)
		end

		local receiptResult = self._T.QueuePreviewReceiptResult or ""
		local activePreviewMatches = self._T.QueueItemDragCandidate == true
			and source == "QUEUED"
			and self._T.QueueItemDragExpectedRevision == queueOrderRevision
			and self.CurrentQueuedTileIds == serializedQueue
		local pendingPreviewMatches = previewWasPending
			and receiptResult == ""
			and source == "QUEUED"
			and previewRevision == queueOrderRevision
			and previewSnapshot == serializedQueue
		if activePreviewMatches or pendingPreviewMatches then
			self:RestoreQueueSlotYPositions(positionsBeforeRefresh)
		elseif receiptResult == "REJECT" then
			self:RestoreQueueSlotYPositions(positionsBeforeRefresh)
			self:StartAuthoritativeQueueMotion(self.QueuePreviewCancelDuration)
		elseif receiptResult == "SUCCESS" then
			self:StartQueueSuccessSettle()
		end
		self._T.QueuePreviewReceiptResult = ""

		if source == "QUEUED"
			and receiptResult == ""
			and queueCount > previousQueueCount
			and queueCount < queueCapacity
			and visibleSlotCount > previousVisibleSlotCount then
			self:StartQueueEmptyReveal(queueCount + 1)
		end
		if self._T.QueueItemDragCandidate == true then
			self:ApplyQueueItemDragVisuals()
		else
			self:ApplyBottomSkillDragTargetFeedback()
		end
		if self.QueueDropRegion ~= nil then
			self.QueueDropRegion.Enable = queueInteractionAvailable
		end
		self.ReservationQueue.Enable = visibleSlotCount > 0
		log("[PlayerOverheadQueueHUD] refreshed source=" .. source .. " first=" .. firstVisibleIndex .. " capacity=" .. tostring(queueCapacity) .. " count=" .. tostring(self.CurrentQueueCount) .. " slots=" .. tostring(visibleSlotCount) .. " visible=" .. #visibleSkills .. " queueRevision=" .. tostring(queueOrderRevision) .. " drop=" .. tostring(queueInteractionAvailable) .. " queue=" .. serializedQueue)
	end

	@ExecSpace("ClientOnly")
	method table GetVisibleSkills(string serializedQueue, integer firstVisibleIndex)
		local visibleSkills = {}
		local queueIndex = 0
		for skillId in string.gmatch(serializedQueue or "", "([^|]+)") do
			queueIndex = queueIndex + 1
			if queueIndex >= firstVisibleIndex and #visibleSkills < self.QueueMaxSlots then
				table.insert(visibleSkills, skillId)
			end
		end
		return visibleSkills
	end

	@ExecSpace("ClientOnly")
	method ButtonComponent GetQueueDragButton(integer queueIndex)
		if queueIndex == 1 then return self.QueueDragButton01 end
		if queueIndex == 2 then return self.QueueDragButton02 end
		if queueIndex == 3 then return self.QueueDragButton03 end
		if queueIndex == 4 then return self.QueueDragButton04 end
		if queueIndex == 5 then return self.QueueDragButton05 end
		if queueIndex == 6 then return self.QueueDragButton06 end
		return nil
	end

	@ExecSpace("ClientOnly")
	method integer ResolveQueueDragIndex(Entity sourceEntity)
		if isvalid(sourceEntity) == false then
			return 0
		end
		for queueIndex = 1, self.QueueMaxSlots do
			local button = self:GetQueueDragButton(queueIndex)
			if button ~= nil and button.Entity == sourceEntity then
				return queueIndex
			end
		end
		return 0
	end

	@ExecSpace("ClientOnly")
	method void BindQueueItemDragHandlers()
		for queueIndex = 1, self.QueueMaxSlots do
			local button = self:GetQueueDragButton(queueIndex)
			if button ~= nil and isvalid(button.Entity) then
				local sourceEntity = button.Entity
				table.insert(self._T.QueueItemDragHandlers, {
					Entity = sourceEntity,
					BeginDrag = sourceEntity:ConnectEvent(UITouchBeginDragEvent, self.OnQueueItemBeginDrag),
					Drag = sourceEntity:ConnectEvent(UITouchDragEvent, self.OnQueueItemDrag),
					EndDrag = sourceEntity:ConnectEvent(UITouchEndDragEvent, self.OnQueueItemEndDrag)
				})
			end
		end
		log("[PlayerQueueDrag] handlers bound count=" .. tostring(#self._T.QueueItemDragHandlers))
	end

	@ExecSpace("ClientOnly")
	method void DisconnectQueueItemDragHandlers()
		local handlers = self._T.QueueItemDragHandlers or {}
		for index = 1, #handlers do
			local record = handlers[index]
			if record ~= nil and isvalid(record.Entity) then
				if record.BeginDrag ~= nil then record.Entity:DisconnectEvent(UITouchBeginDragEvent, record.BeginDrag) end
				if record.Drag ~= nil then record.Entity:DisconnectEvent(UITouchDragEvent, record.Drag) end
				if record.EndDrag ~= nil then record.Entity:DisconnectEvent(UITouchEndDragEvent, record.EndDrag) end
			end
		end
		self._T.QueueItemDragHandlers = {}
	end

	@ExecSpace("ClientOnly")
	method void ResetQueueItemDragState()
		self._T.QueueItemDragSourceType = "NONE"
		self._T.QueueItemDragCandidate = false
		self._T.QueueItemDragActive = false
		self._T.QueueItemDragTouchId = 0
		self._T.QueueItemDragDistance = 0
		self._T.QueueItemDragSourceIndex = 0
		self._T.QueueItemDragTargetIndex = 0
		self._T.QueueItemDragExpectedRevision = 0
		self._T.QueueItemDragSourceSkillId = ""
		self._T.QueueItemDragLastTouchPoint = nil
	end

	@ExecSpace("ClientOnly")
	method void ResetQueuePreviewState()
		self._T.QueuePreviewTargetIndex = 0
		self._T.QueuePreviewPending = false
		self._T.QueuePreviewPendingSourceIndex = 0
		self._T.QueuePreviewPendingTargetIndex = 0
		self._T.QueuePreviewPendingRevision = 0
		self._T.QueuePreviewPendingSnapshot = ""
		self._T.QueuePreviewReceiptResult = ""
		self._T.QueueSlotMotionActive = false
		self._T.QueueSlotMotionElapsed = 0
		self._T.QueueSlotMotionDuration = 0
		self._T.QueueSlotMotionStartY = {}
		self._T.QueueSlotMotionTargetY = {}
		self._T.QueueEmptyRevealSlotIndex = 0
		self._T.QueueEmptyRevealElapsed = 0
		self._T.QueueSuccessSettleActive = false
		self._T.QueueSuccessSettleElapsed = 0
	end

	@ExecSpace("ClientOnly")
	method number GetQueueSlotBaseY(integer queueIndex, integer visibleSlotCount)
		local count = math.max(1, math.min(self.QueueMaxSlots, visibleSlotCount))
		local firstLocalY = -math.max(0, count - 1) * self.QueueSlotSpacing * 0.5
		return firstLocalY + (queueIndex - 1) * self.QueueSlotSpacing
	end

	@ExecSpace("ClientOnly")
	method table CaptureQueueSlotYPositions()
		local positions = {}
		for slotIndex = 1, self.QueueMaxSlots do
			local slot = self:GetSlotEntity(slotIndex)
			if isvalid(slot) and slot.UITransformComponent ~= nil then
				positions[slotIndex] = slot.UITransformComponent.anchoredPosition.y
			end
		end
		return positions
	end

	@ExecSpace("ClientOnly")
	method void RestoreQueueSlotYPositions(table positions)
		if positions == nil then
			return
		end
		for slotIndex = 1, self.QueueMaxSlots do
			local y = positions[slotIndex]
			local slot = self:GetSlotEntity(slotIndex)
			if y ~= nil and isvalid(slot) and slot.UITransformComponent ~= nil then
				slot.UITransformComponent.anchoredPosition = Vector2(0, y)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void StartQueueSlotMotion(table targetYBySlot, number duration)
		self._T.QueueSlotMotionStartY = self:CaptureQueueSlotYPositions()
		self._T.QueueSlotMotionTargetY = targetYBySlot or {}
		self._T.QueueSlotMotionElapsed = 0
		self._T.QueueSlotMotionDuration = math.max(0.01, duration)
		self._T.QueueSlotMotionActive = true
	end

	@ExecSpace("ClientOnly")
	method void UpdateQueueSlotMotion(number delta)
		if self._T.QueueSlotMotionActive ~= true then
			return
		end
		self._T.QueueSlotMotionElapsed = self._T.QueueSlotMotionElapsed + delta
		local progress = math.min(1, self._T.QueueSlotMotionElapsed / self._T.QueueSlotMotionDuration)
		local eased = 1 - (1 - progress) * (1 - progress)
		local starts = self._T.QueueSlotMotionStartY or {}
		local targets = self._T.QueueSlotMotionTargetY or {}
		for slotIndex = 1, self.QueueMaxSlots do
			local startY = starts[slotIndex]
			local targetY = targets[slotIndex]
			local slot = self:GetSlotEntity(slotIndex)
			if startY ~= nil and targetY ~= nil and isvalid(slot) and slot.UITransformComponent ~= nil then
				local y = startY + (targetY - startY) * eased
				slot.UITransformComponent.anchoredPosition = Vector2(0, y)
			end
		end
		if progress >= 1 then
			self._T.QueueSlotMotionActive = false
		end
	end

	@ExecSpace("ClientOnly")
	method void StartAuthoritativeQueueMotion(number duration)
		local targets = {}
		for slotIndex = 1, self.CurrentVisibleSlotCount do
			targets[slotIndex] = self:GetQueueSlotBaseY(slotIndex, self.CurrentVisibleSlotCount)
		end
		self._T.QueuePreviewTargetIndex = 0
		self:StartQueueSlotMotion(targets, duration)
	end

	@ExecSpace("ClientOnly")
	method void StartQueuePreviewMotion(integer targetIndex)
		local sourceIndex = self._T.QueueItemDragSourceIndex or 0
		if targetIndex < 1 or targetIndex > self.CurrentQueueCount then
			targetIndex = 0
		end
		if self._T.QueuePreviewTargetIndex == targetIndex then
			return
		end
		self._T.QueuePreviewTargetIndex = targetIndex
		local targets = {}
		for slotIndex = 1, self.CurrentVisibleSlotCount do
			local previewIndex = slotIndex
			if targetIndex > 0 and targetIndex ~= sourceIndex then
				if slotIndex == sourceIndex then
					previewIndex = targetIndex
				elseif sourceIndex < targetIndex and slotIndex > sourceIndex and slotIndex <= targetIndex then
					previewIndex = slotIndex - 1
				elseif sourceIndex > targetIndex and slotIndex >= targetIndex and slotIndex < sourceIndex then
					previewIndex = slotIndex + 1
				end
			end
			targets[slotIndex] = self:GetQueueSlotBaseY(previewIndex, self.CurrentVisibleSlotCount)
		end
		self:StartQueueSlotMotion(targets, self.QueuePreviewShiftDuration)
	end

	@ExecSpace("ClientOnly")
	method void StartQueueEmptyReveal(integer slotIndex)
		if slotIndex < 1 or slotIndex > self.CurrentVisibleSlotCount then
			return
		end
		local slot = self:GetSlotEntity(slotIndex)
		if isvalid(slot) == false or slot.UITransformComponent == nil then
			return
		end
		local targetY = self:GetQueueSlotBaseY(slotIndex, self.CurrentVisibleSlotCount)
		slot.UITransformComponent.anchoredPosition = Vector2(0, targetY - self.QueueEmptyRevealOffsetY)
		self._T.QueueEmptyRevealSlotIndex = slotIndex
		self._T.QueueEmptyRevealElapsed = 0
		self:StartQueueSlotMotion({ [slotIndex] = targetY }, self.QueueEmptyRevealDuration)
	end

	@ExecSpace("ClientOnly")
	method void UpdateQueueEmptyReveal(number delta)
		local slotIndex = self._T.QueueEmptyRevealSlotIndex or 0
		if slotIndex <= 0 then
			return
		end
		self._T.QueueEmptyRevealElapsed = self._T.QueueEmptyRevealElapsed + delta
		local progress = math.min(1, self._T.QueueEmptyRevealElapsed / math.max(0.01, self.QueueEmptyRevealDuration))
		local eased = 1 - (1 - progress) * (1 - progress)
		local slot = self:GetSlotEntity(slotIndex)
		local background = isvalid(slot) and slot:GetChildByName("Background", false) or nil
		if isvalid(background) and background.SpriteGUIRendererComponent ~= nil then
			background.SpriteGUIRendererComponent.Color = Color(0.38, 0.34, 0.30, 0.12 + 0.36 * eased)
		end
		if progress >= 1 then
			self._T.QueueEmptyRevealSlotIndex = 0
		end
	end

	@ExecSpace("ClientOnly")
	method void StartQueueSuccessSettle()
		self._T.QueueSuccessSettleActive = true
		self._T.QueueSuccessSettleElapsed = 0
	end

	@ExecSpace("ClientOnly")
	method void UpdateQueueSuccessSettle(number delta)
		if self._T.QueueSuccessSettleActive ~= true then
			return
		end
		self._T.QueueSuccessSettleElapsed = self._T.QueueSuccessSettleElapsed + delta
		local progress = math.min(1, self._T.QueueSuccessSettleElapsed / math.max(0.01, self.QueuePreviewSettleDuration))
		for slotIndex = 1, self.CurrentQueueCount do
			local slot = self:GetSlotEntity(slotIndex)
			local background = isvalid(slot) and slot:GetChildByName("Background", false) or nil
			if isvalid(background) and background.SpriteGUIRendererComponent ~= nil then
				local remaining = 1 - progress
				if slotIndex == 1 then
					background.SpriteGUIRendererComponent.Color = Color(
						0.92 + (0.34 - 0.92) * remaining,
						0.66 + (0.74 - 0.66) * remaining,
						0.26 + (1.00 - 0.26) * remaining,
						1.00)
				elseif slotIndex == 2 then
					background.SpriteGUIRendererComponent.Color = Color(
						0.82 + (0.34 - 0.82) * remaining,
						0.57 + (0.74 - 0.57) * remaining,
						0.22 + (1.00 - 0.22) * remaining,
						0.98)
				else
					background.SpriteGUIRendererComponent.Color = Color(
						0.72 + (0.34 - 0.72) * remaining,
						0.49 + (0.74 - 0.49) * remaining,
						0.18 + (1.00 - 0.18) * remaining,
						0.96)
				end
			end
		end
		if progress >= 1 then
			self._T.QueueSuccessSettleActive = false
		end
	end

	@ExecSpace("ClientOnly")
	method string GetQueuedSkillIdAt(integer queueIndex)
		local currentIndex = 0
		for skillId in string.gmatch(self.CurrentQueuedTileIds or "", "([^|]+)") do
			currentIndex = currentIndex + 1
			if currentIndex == queueIndex then
				return skillId
			end
		end
		return ""
	end

	@ExecSpace("ClientOnly")
	method boolean CanBeginQueueItemDrag(integer queueIndex)
		if self.QueueReorderPendingRequestId > 0
			or self.QueueReorderAvailable ~= true
			or queueIndex < 1
			or queueIndex > self.CurrentQueueCount then
			return false
		end
		return self:GetQueuedSkillIdAt(queueIndex) ~= ""
	end

	@ExecSpace("ClientOnly")
	method void OnQueueItemBeginDrag(UITouchBeginDragEvent dragEvent)
		local sourceIndex = self:ResolveQueueDragIndex(dragEvent.Entity)
		if sourceIndex <= 0
			or (dragEvent.TouchId ~= -1 and dragEvent.TouchId <= 0)
			or self:CanBeginQueueItemDrag(sourceIndex) == false then
			return
		end

		self:CleanupQueueItemDragVisuals(false)
		self.BottomSkillDragTargetActive = false
		self.BottomSkillDragTargetValid = false
		self._T.QueueItemDragSourceType = "QUEUED_SKILL"
		self._T.QueueItemDragCandidate = true
		self._T.QueueItemDragTouchId = dragEvent.TouchId
		self._T.QueueItemDragDistance = 0
		self._T.QueueItemDragSourceIndex = sourceIndex
		self._T.QueueItemDragTargetIndex = sourceIndex
		self._T.QueueItemDragExpectedRevision = self.CurrentQueueOrderRevision
		self._T.QueueItemDragSourceSkillId = self:GetQueuedSkillIdAt(sourceIndex)
		self._T.QueueItemDragLastTouchPoint = dragEvent.TouchPoint
		log("[PlayerQueueDrag] begin candidate source=" .. tostring(sourceIndex)
			.. " skill=" .. self._T.QueueItemDragSourceSkillId
			.. " revision=" .. tostring(self._T.QueueItemDragExpectedRevision))
	end

	@ExecSpace("ClientOnly")
	method void OnQueueItemDrag(UITouchDragEvent dragEvent)
		if self._T.QueueItemDragSourceType ~= "QUEUED_SKILL"
			or self._T.QueueItemDragCandidate ~= true
			or dragEvent.TouchId ~= self._T.QueueItemDragTouchId then
			return
		end
		local delta = dragEvent.TouchDelta
		self._T.QueueItemDragLastTouchPoint = dragEvent.TouchPoint
		self._T.QueueItemDragDistance = self._T.QueueItemDragDistance + math.sqrt(delta.x * delta.x + delta.y * delta.y)
		if self._T.QueueItemDragActive ~= true then
			if self._T.QueueItemDragDistance < self.QueueDragThreshold then
				return
			end
			self:ActivateQueueItemDrag(dragEvent.TouchPoint)
		end
		if self._T.QueueItemDragActive == true then
			self:UpdateQueueItemDragDestination(dragEvent.TouchPoint)
			self:UpdateQueueItemDragGhost(dragEvent.TouchPoint)
		end
	end

	@ExecSpace("ClientOnly")
	method void ActivateQueueItemDrag(Vector2 touchPoint)
		local sourceIndex = self._T.QueueItemDragSourceIndex or 0
		if self:CanBeginQueueItemDrag(sourceIndex) == false
			or self:GetQueuedSkillIdAt(sourceIndex) ~= self._T.QueueItemDragSourceSkillId then
			self:CleanupQueueItemDragVisuals(true)
			return
		end
		self._T.QueueItemDragActive = true
		if self.QueueDragGhost ~= nil then
			self.QueueDragGhost.ImageRUID = DataRef(self:GetSkillIconRuid(self._T.QueueItemDragSourceSkillId))
			self.QueueDragGhost.Type = ImageType.Simple
			self.QueueDragGhost.DropShadow = false
			self.QueueDragGhost.Color = Color(1, 1, 1, self.QueueDragGhostAlpha)
			self.QueueDragGhost.Entity.Enable = true
			self.QueueDragGhost.Enable = true
		end
		self:UpdateQueueItemDragDestination(touchPoint)
		self:UpdateQueueItemDragGhost(touchPoint)
		log("[PlayerQueueDrag] activated source=" .. tostring(sourceIndex)
			.. " threshold=" .. tostring(self.QueueDragThreshold))
	end

	@ExecSpace("ClientOnly")
	method integer ResolveQueueItemDropIndex(Vector2 touchPoint)
		-- QueueIndex is explicit: index 1 is the bottom execution position, then increases upward.
		-- Only occupied compact-list positions are valid targets; empty capacity cells never match.
		if self.CurrentQueueCount <= 0 or self.ReservationQueueTransform == nil then
			return 0
		end
		local uiPosition = _UILogic:ScreenToUIPosition(touchPoint)
		for queueIndex = 1, math.min(self.QueueMaxSlots, self.CurrentQueueCount) do
			local slot = self:GetSlotEntity(queueIndex)
			if isvalid(slot) and slot.UITransformComponent ~= nil then
				local slotTransform = slot.UITransformComponent
				-- Resolve against the authoritative slot guide, not the animated preview transform.
				-- This keeps the insertion target stable while neighbouring items shift visually.
				local centerX = self.ReservationQueueTransform.anchoredPosition.x
				local centerY = self.ReservationQueueTransform.anchoredPosition.y
					+ self:GetQueueSlotBaseY(queueIndex, self.CurrentVisibleSlotCount)
				local minX = centerX - slotTransform.RectSize.x * slotTransform.Pivot.x
				local maxX = minX + slotTransform.RectSize.x
				local minY = centerY - slotTransform.RectSize.y * slotTransform.Pivot.y
				local maxY = minY + slotTransform.RectSize.y
				if uiPosition.x >= minX and uiPosition.x <= maxX
					and uiPosition.y >= minY and uiPosition.y <= maxY then
					return queueIndex
				end
			end
		end
		return 0
	end

	@ExecSpace("ClientOnly")
	method void UpdateQueueItemDragDestination(Vector2 touchPoint)
		self._T.QueueItemDragTargetIndex = self:ResolveQueueItemDropIndex(touchPoint)
		self:StartQueuePreviewMotion(self._T.QueueItemDragTargetIndex)
		self:ApplyQueueItemDragVisuals()
	end

	@ExecSpace("ClientOnly")
	method void UpdateQueueItemDragGhost(Vector2 touchPoint)
		if self._T.QueueItemDragActive ~= true
			or self.QueueDragGhost == nil
			or self.QueueDragGhost.Entity.UITransformComponent == nil then
			return
		end
		local uiPosition = _UILogic:ScreenToUIPosition(touchPoint)
		local ghostX = math.max(-924, math.min(924, uiPosition.x + self.QueueDragGhostOffsetX))
		local ghostY = math.max(-504, math.min(504, uiPosition.y + self.QueueDragGhostOffsetY))
		self.QueueDragGhost.Entity.UITransformComponent.anchoredPosition = Vector2(ghostX, ghostY)
	end

	@ExecSpace("ClientOnly")
	method void ApplyQueueItemDragVisuals()
		if self._T.QueueItemDragActive ~= true then
			return
		end
		local sourceIndex = self._T.QueueItemDragSourceIndex or 0
		local targetIndex = self._T.QueueItemDragTargetIndex or 0
		for queueIndex = 1, math.min(self.QueueMaxSlots, self.CurrentQueueCount) do
			local slot = self:GetSlotEntity(queueIndex)
			local background = isvalid(slot) and slot:GetChildByName("Background", false) or nil
			if isvalid(background) and background.SpriteGUIRendererComponent ~= nil then
				background.SpriteGUIRendererComponent.Color = queueIndex == sourceIndex and targetIndex > 0 and targetIndex ~= sourceIndex
					and Color(0.34, 0.74, 1.00, 0.82)
					or self:GetQueueSlotBackgroundColor(queueIndex)
			end
			local icon = self:GetSlotIcon(queueIndex)
			if icon ~= nil then
				icon.Color = queueIndex == sourceIndex
					and Color(1, 1, 1, self.QueueDragSourceAlpha)
					or Color(1, 1, 1, 1)
			end
		end
		if self.QueueDragGhost ~= nil then
			local hasValidMove = targetIndex > 0 and targetIndex ~= sourceIndex
			self.QueueDragGhost.Color = hasValidMove
				and Color(1, 1, 1, self.QueueDragGhostAlpha)
				or Color(0.62, 0.66, 0.72, self.QueueDragGhostAlpha * 0.72)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnQueueItemEndDrag(UITouchEndDragEvent dragEvent)
		if self._T.QueueItemDragSourceType ~= "QUEUED_SKILL"
			or self._T.QueueItemDragCandidate ~= true
			or dragEvent.TouchId ~= self._T.QueueItemDragTouchId then
			return
		end
		if self._T.QueueItemDragActive ~= true then
			self:CleanupQueueItemDragVisuals(false)
			self:StartAuthoritativeQueueMotion(self.QueuePreviewCancelDuration)
			return
		end

		local sourceIndex = self._T.QueueItemDragSourceIndex or 0
		local targetIndex = self:ResolveQueueItemDropIndex(dragEvent.TouchPoint)
		local expectedRevision = self._T.QueueItemDragExpectedRevision or 0
		local sourceSkillId = self._T.QueueItemDragSourceSkillId or ""

		if targetIndex <= 0 then
			self:CleanupQueueItemDragVisuals(false)
			self:StartAuthoritativeQueueMotion(self.QueuePreviewCancelDuration)
			log("[PlayerQueueDrag] cancelled source=" .. tostring(sourceIndex) .. " reason=OUTSIDE_QUEUE")
			return
		end
		if targetIndex == sourceIndex then
			self:CleanupQueueItemDragVisuals(false)
			self:StartAuthoritativeQueueMotion(self.QueuePreviewCancelDuration)
			log("[PlayerQueueDrag] no-op source=" .. tostring(sourceIndex) .. " target=" .. tostring(targetIndex))
			return
		end
		if self.QueueReorderAvailable ~= true
			or expectedRevision ~= self.CurrentQueueOrderRevision
			or self:GetQueuedSkillIdAt(sourceIndex) ~= sourceSkillId then
			self:CleanupQueueItemDragVisuals(false)
			self:StartAuthoritativeQueueMotion(self.QueuePreviewCancelDuration)
			log_warning("[PlayerQueueDrag] cancelled stale source=" .. tostring(sourceIndex)
				.. " target=" .. tostring(targetIndex)
				.. " expectedRevision=" .. tostring(expectedRevision)
				.. " currentRevision=" .. tostring(self.CurrentQueueOrderRevision))
			return
		end
		self:CleanupQueueItemDragVisuals(false)
		self:SubmitQueueReorderRequest(sourceIndex, targetIndex, expectedRevision)
		if self.QueueReorderPendingRequestId > 0 then
			self._T.QueuePreviewPending = true
			self._T.QueuePreviewPendingSourceIndex = sourceIndex
			self._T.QueuePreviewPendingTargetIndex = targetIndex
			self._T.QueuePreviewPendingRevision = expectedRevision
			self._T.QueuePreviewPendingSnapshot = self.CurrentQueuedTileIds
		else
			self:StartAuthoritativeQueueMotion(self.QueuePreviewCancelDuration)
		end
	end

	@ExecSpace("ClientOnly")
	method void SubmitQueueReorderRequest(integer sourceIndex, integer targetIndex, integer expectedRevision)
		if self.QueueReorderPendingRequestId > 0 then
			return
		end
		local player = _UserService.LocalPlayer
		local session = self:GetBattleSession(player)
		if session == nil then
			return
		end
		self.QueueReorderNextRequestId = math.max(self.QueueReorderNextRequestId, session.QueueLastRequestId or 0) + 1
		local requestId = self.QueueReorderNextRequestId
		self.QueueReorderPendingRequestId = requestId
		self.QueueReorderPendingElapsed = 0
		log("[PlayerQueueDrag] reorder submitted request=" .. tostring(requestId)
			.. " source=" .. tostring(sourceIndex)
			.. " target=" .. tostring(targetIndex)
			.. " revision=" .. tostring(expectedRevision))
		-- The gesture emits exactly one server proposal containing indices and concurrency metadata.
		-- It never calls reservation, removal, execution, cooldown, or turn-advance paths.
		session:RequestMoveQueuedTile(sourceIndex, targetIndex, requestId, expectedRevision)
	end

	@ExecSpace("ClientOnly")
	method void ConsumeQueueReorderReceipt(any queueState)
		local receipt = queueState ~= nil and queueState.ReorderReceipt or nil
		if receipt == nil then
			return
		end
		local receiptRevision = receipt.Revision or 0
		if receiptRevision <= self.QueueReorderLastReceiptRevision then
			return
		end
		self.QueueReorderLastReceiptRevision = receiptRevision
		self.QueueReorderNextRequestId = math.max(self.QueueReorderNextRequestId, receipt.RequestId or 0)
		if self.QueueReorderPendingRequestId <= 0 or receipt.RequestId ~= self.QueueReorderPendingRequestId then
			return
		end
		self.QueueReorderPendingRequestId = 0
		self.QueueReorderPendingElapsed = 0
		self._T.QueuePreviewPending = false
		if receipt.Success == true then
			self._T.QueuePreviewReceiptResult = "SUCCESS"
			log("[PlayerQueueDrag] authoritative success request=" .. tostring(receipt.RequestId)
				.. " source=" .. tostring(receipt.SourceIndex)
				.. " target=" .. tostring(receipt.TargetIndex)
				.. " revision=" .. tostring(receipt.QueueOrderRevision))
		else
			self._T.QueuePreviewReceiptResult = "REJECT"
			log_warning("[PlayerQueueDrag] authoritative reject request=" .. tostring(receipt.RequestId)
				.. " reason=" .. tostring(receipt.Reason))
		end
	end

	@ExecSpace("ClientOnly")
	method void ValidateQueueItemDragSnapshot()
		if self._T.QueueItemDragCandidate ~= true then
			return
		end
		local sourceIndex = self._T.QueueItemDragSourceIndex or 0
		if self.QueueReorderAvailable ~= true
			or self._T.QueueItemDragExpectedRevision ~= self.CurrentQueueOrderRevision
			or self:GetQueuedSkillIdAt(sourceIndex) ~= self._T.QueueItemDragSourceSkillId then
			log_warning("[PlayerQueueDrag] active gesture invalidated by authoritative queue refresh")
			self:CleanupQueueItemDragVisuals(false)
		end
	end

	@ExecSpace("ClientOnly")
	method void CleanupQueueItemDragVisuals(boolean refreshAuthoritative)
		if self.QueueDragGhost ~= nil then
			self.QueueDragGhost.Enable = false
			if self.QueueDragGhost.Entity ~= nil then
				self.QueueDragGhost.Entity.Enable = false
			end
		end
		for queueIndex = 1, self.QueueMaxSlots do
			local icon = self:GetSlotIcon(queueIndex)
			if icon ~= nil then
				icon.Color = Color(1, 1, 1, 1)
			end
			local slot = self:GetSlotEntity(queueIndex)
			local background = isvalid(slot) and slot:GetChildByName("Background", false) or nil
			if isvalid(background) and background.SpriteGUIRendererComponent ~= nil then
				background.SpriteGUIRendererComponent.Color = queueIndex <= self.CurrentQueueCount
					and self:GetQueueSlotBackgroundColor(queueIndex)
					or self:GetQueueEmptySlotBackgroundColor()
			end
		end
		self:ResetQueueItemDragState()
		if refreshAuthoritative then
			self.LastSignature = ""
			local player = _UserService.LocalPlayer
			local session = self:GetBattleSession(player)
			if session ~= nil then
				self:RefreshQueue(session)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void UpdateQueueLayout(integer visibleSlotCount)
		local count = math.max(1, math.min(self.QueueMaxSlots, visibleSlotCount))
		local stackHeight = self.QueueSlotSize + math.max(0, count - 1) * self.QueueSlotSpacing
		if self.ReservationQueueTransform ~= nil then
			self.ReservationQueueTransform.RectSize = Vector2(84, stackHeight)
		end
		if self.QueueDropRegionTransform ~= nil then
			self.QueueDropRegionTransform.anchoredPosition = Vector2(0, 0)
			self.QueueDropRegionTransform.RectSize = Vector2(
				84 + self.QueueDropMarginX * 2,
				stackHeight + self.QueueDropMarginY * 2)
		end
		for slotIndex = 1, self.QueueMaxSlots do
			local slot = self:GetSlotEntity(slotIndex)
			if isvalid(slot) and slot.UITransformComponent ~= nil then
				slot.UITransformComponent.anchoredPosition = Vector2(0, self:GetQueueSlotBaseY(slotIndex, count))
				slot.UITransformComponent.RectSize = Vector2(self.QueueSlotSize, self.QueueSlotSize)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method boolean IsPointInsideQueueDropRegion(Vector2 touchPoint)
		-- Passive coordinate test only. QueueDropRegion intentionally owns no input component.
		if self.CurrentVisibleSlotCount <= 0
			or self.ReservationQueueTransform == nil
			or self.QueueDropRegionTransform == nil then
			return false
		end
		local uiPosition = _UILogic:ScreenToUIPosition(touchPoint)
		local regionCenterX = self.ReservationQueueTransform.anchoredPosition.x + self.QueueDropRegionTransform.anchoredPosition.x
		local regionCenterY = self.ReservationQueueTransform.anchoredPosition.y + self.QueueDropRegionTransform.anchoredPosition.y
		local regionSize = self.QueueDropRegionTransform.RectSize
		local regionPivot = self.QueueDropRegionTransform.Pivot
		local minX = regionCenterX - regionSize.x * regionPivot.x
		local maxX = minX + regionSize.x
		local minY = regionCenterY - regionSize.y * regionPivot.y
		local maxY = minY + regionSize.y
		return uiPosition.x >= minX and uiPosition.x <= maxX
			and uiPosition.y >= minY and uiPosition.y <= maxY
	end

	@ExecSpace("ClientOnly")
	method boolean CanAcceptBottomSkillDrop()
		-- Responsive guidance only. The existing reservation server path remains authoritative.
		return self.QueueInteractionAvailable == true
			and self.CurrentQueueCount < self.CurrentQueueCapacity
	end

	@ExecSpace("ClientOnly")
	method void SetBottomSkillDragTargetFeedback(boolean active, boolean validTarget)
		local nextActive = active == true
		local nextValid = nextActive and validTarget == true
		if self.BottomSkillDragTargetActive == nextActive and self.BottomSkillDragTargetValid == nextValid then
			return
		end
		self.BottomSkillDragTargetActive = nextActive
		self.BottomSkillDragTargetValid = nextValid
		if nextActive then
			self.ReservationQueue.Enable = true
			self:ApplyBottomSkillDragTargetFeedback()
			return
		end

		-- Restore immediately from the latest authoritative snapshot when the pointer leaves.
		self.LastSignature = ""
		local player = _UserService.LocalPlayer
		local session = self:GetBattleSession(player)
		if session ~= nil then
			self:RefreshQueue(session)
		else
			self:SetQueueHidden("DRAG_TARGET_CLEARED")
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplyBottomSkillDragTargetFeedback()
		if self.BottomSkillDragTargetActive ~= true then
			return
		end
		local visibleSlotCount = math.max(1, math.min(self.QueueMaxSlots, self.CurrentVisibleSlotCount))
		local highlightColor = self.BottomSkillDragTargetValid
			and Color(0.34, 0.74, 1.00, 0.78)
			or Color(0.50, 0.54, 0.60, 0.46)
		for slotIndex = 1, visibleSlotCount do
			local slot = self:GetSlotEntity(slotIndex)
			local background = isvalid(slot) and slot:GetChildByName("Background", false) or nil
			if isvalid(slot) then
				slot.Enable = true
			end
			if isvalid(background) and background.SpriteGUIRendererComponent ~= nil then
				background.Enable = true
				background.SpriteGUIRendererComponent.Enable = true
				background.SpriteGUIRendererComponent.Color = highlightColor
			end
		end
	end

	@ExecSpace("ClientOnly")
	method Color GetQueueSlotBackgroundColor(integer slotIndex)
		if slotIndex == 1 then
			return Color(0.92, 0.66, 0.26, 1.00)
		elseif slotIndex == 2 then
			return Color(0.82, 0.57, 0.22, 0.98)
		end
		return Color(0.72, 0.49, 0.18, 0.96)
	end

	@ExecSpace("ClientOnly")
	method Color GetQueueEmptySlotBackgroundColor()
		return Color(0.38, 0.34, 0.30, 0.48)
	end

	@ExecSpace("ClientOnly")
	method void SetSlot(integer slotIndex, string skillId, boolean capacityActive)
		local slot = self:GetSlotEntity(slotIndex)
		local icon = self:GetSlotIcon(slotIndex)
		local label = self:GetSlotLabel(slotIndex)
		local dragButton = self:GetQueueDragButton(slotIndex)
		if slot == nil or icon == nil or label == nil then
			return
		end

		local visible = capacityActive and skillId ~= nil and skillId ~= ""
		slot.Enable = capacityActive
		local background = slot:GetChildByName("Background", false)
		if isvalid(background) then
			background.Enable = capacityActive
			if background.SpriteGUIRendererComponent ~= nil then
				background.SpriteGUIRendererComponent.Color = visible
					and self:GetQueueSlotBackgroundColor(slotIndex)
					or self:GetQueueEmptySlotBackgroundColor()
			end
		end
		if icon.Entity ~= nil then
			icon.Entity.Enable = visible
		end
		icon.Enable = visible
		if dragButton ~= nil then
			-- Only occupied, editable queued items intercept drag input. Executing/empty cells
			-- remain presentation-only even when their icon entity is visible.
			dragButton.Enable = visible and self.QueueReorderAvailable
		end
		-- The vertical position already communicates execution order; reserve the tile face for the real skill icon.
		label.Enable = false
		if visible then
			local iconRuid = self:GetSkillIconRuid(skillId)
			icon.ImageRUID = DataRef(iconRuid)
			-- Skill icons are ordinary sprites. Sliced mode expects 9-slice metadata and can render
			-- dynamically assigned icons as a black block when that metadata does not exist.
			icon.Type = ImageType.Simple
			icon.DropShadow = false
			-- Some authored queue icon renderers start transparent. Restore an opaque tint whenever
			-- the slot is reused so assigning the real RUID also makes it visible above the player.
			icon.Color = Color(1, 1, 1, 1)
			log("[PlayerOverheadQueueHUD] icon applied slot=" .. tostring(slotIndex) .. " skill=" .. skillId .. " ruid=" .. iconRuid)
		else
			icon.ImageRUID = DataRef(self.DefaultSkillIconRuid)
		end
	end

	@ExecSpace("ClientOnly")
	method void SyncIconSnapshot(any session)
		-- The skill DataSets are server-only, so icons arrive as a synced "skillId~iconRuid|..." string.
		-- Reparsed only when it changes, since the queue refreshes many times per second.
		local snapshot = session.SkillIconSnapshot or ""
		if snapshot == self.IconSnapshot and self._T.IconMap ~= nil then
			return
		end

		self.IconSnapshot = snapshot
		local iconMap = {}
		local count = 0
		for record in string.gmatch(snapshot, "([^|]+)") do
			local skillId = string.match(record, "^([^~]+)")
			local iconRuid = string.match(record, "~(.+)$")
			if skillId ~= nil and iconRuid ~= nil then
				iconMap[skillId] = iconRuid
				count = count + 1
			end
		end
		self._T.IconMap = iconMap
		log("[PlayerOverheadQueueHUD] icon snapshot parsed count=" .. tostring(count))
	end

	@ExecSpace("ClientOnly")
	method string GetSkillIconRuid(string skillId)
		-- Falls back to the placeholder when a skill authored no icon, so a blank cell shows an
		-- obviously-default tile instead of an empty one.
		local iconMap = self._T.IconMap
		if iconMap ~= nil and iconMap[skillId] ~= nil then
			return iconMap[skillId]
		end
		return self.DefaultSkillIconRuid
	end

	@ExecSpace("ClientOnly")
	method Entity GetSlotEntity(integer slotIndex)
		if slotIndex == 1 then
			return self.QueueSlot01
		elseif slotIndex == 2 then
			return self.QueueSlot02
		elseif slotIndex == 3 then
			return self.QueueSlot03
		elseif slotIndex == 4 then
			return self.QueueSlot04
		elseif slotIndex == 5 then
			return self.QueueSlot05
		end
		return self.QueueSlot06
	end

	@ExecSpace("ClientOnly")
	method SpriteGUIRendererComponent GetSlotIcon(integer slotIndex)
		if slotIndex == 1 then
			return self.SkillIcon01
		elseif slotIndex == 2 then
			return self.SkillIcon02
		elseif slotIndex == 3 then
			return self.SkillIcon03
		elseif slotIndex == 4 then
			return self.SkillIcon04
		elseif slotIndex == 5 then
			return self.SkillIcon05
		end
		return self.SkillIcon06
	end

	@ExecSpace("ClientOnly")
	method TextGUIRendererComponent GetSlotLabel(integer slotIndex)
		if slotIndex == 1 then
			return self.SkillNameText01
		elseif slotIndex == 2 then
			return self.SkillNameText02
		elseif slotIndex == 3 then
			return self.SkillNameText03
		elseif slotIndex == 4 then
			return self.SkillNameText04
		elseif slotIndex == 5 then
			return self.SkillNameText05
		end
		return self.SkillNameText06
	end

	@ExecSpace("ClientOnly")
	method void SetQueueHidden(string reason)
		if self._T.QueueItemDragCandidate == true then
			self:CleanupQueueItemDragVisuals(false)
		end
		local signature = "HIDDEN:" .. reason
		if self.LastSignature == signature then
			return
		end

		self.LastSignature = signature
		self.RefreshElapsed = 0
		self.CurrentQueueCapacity = 0
		self.CurrentQueueCount = 0
		self.CurrentVisibleSlotCount = 0
		self.CurrentQueueOrderRevision = 0
		self.QueueInteractionAvailable = false
		self.QueueReorderAvailable = false
		self.CurrentQueuedTileIds = ""
		self.BottomSkillDragTargetActive = false
		self.BottomSkillDragTargetValid = false
		self:ResetQueuePreviewState()
		if self.ReservationQueue ~= nil then
			self.ReservationQueue.Enable = false
		end
		if self.QueueDropRegion ~= nil then
			self.QueueDropRegion.Enable = false
		end
		for slotIndex = 1, self.QueueMaxSlots do
			local slot = self:GetSlotEntity(slotIndex)
			if slot ~= nil then
				slot.Enable = false
			end
		end
	end

end
