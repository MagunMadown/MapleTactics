@Component
script MouseTooltipUIComponent extends Component

	property Entity TooltipPanel = "774dad3d-8d93-4d45-8664-6084fe9a0013"
	property Entity TooltipTextEntity = "b562758d-31d8-42a9-8520-8c074d95f89d"
	property TextGUIRendererComponent TooltipText = "b562758d-31d8-42a9-8520-8c074d95f89d"
	property number CursorGap = 24
	property number EdgeMargin = 18
	property number MinWidth = 160
	property number MaxWidth = 560
	property number MinHeight = 64
	property number MaxHeight = 220
	property number HorizontalPadding = 40
	property number VerticalPadding = 24
	property number GlyphWidth = 22
	property number LineHeight = 28
	property string ActiveOwnerKey = ""
	property boolean IsShowing = false
	property Vector2 LastCursorPosition = Vector2(-100000, -100000)
	property integer SkillHoverRequestId = 0
	property string HoverSkillId = ""
	property Entity HoverMap = nil
	property number SkillHoverRefreshInterval = 1
	property number SkillHoverResponseTimeout = 3

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self._T.SkillHoverCache = {}
		self._T.SkillHoverCacheMap = nil
		self._T.NextLiveSkillHover = 0
		self:ForceHide()
		log("[MouseTooltip] shared controller ready")
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		if self.IsShowing == false then return end
		local cursorPosition = _InputService:GetCursorPosition()
		if cursorPosition.x == self.LastCursorPosition.x and cursorPosition.y == self.LastCursorPosition.y then return end
		self:UpdatePosition(cursorPosition)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		self:ForceHide()
	end

	@ExecSpace("ClientOnly")
	method void Show(string ownerKey, string text)
		if ownerKey == nil or ownerKey == "" or text == nil or text == "" then return end
		if isvalid(self.TooltipPanel) == false or self.TooltipText == nil then
			log_warning("[MouseTooltip] show rejected owner=" .. ownerKey .. " reason=BINDING_MISSING")
			return
		end
		-- Live previews often return identical text. Keep its layout and scroll position.
		if self.IsShowing and self.TooltipPanel.Enable and self.ActiveOwnerKey == ownerKey and self._T.DisplayText == text then return end
		if ownerKey ~= "battle_skill" and ownerKey ~= "enemy_skill" and self.HoverSkillId ~= "" then self:ForceHide() end
		self.ActiveOwnerKey = ownerKey
		self._T.DisplayText = text
		self.TooltipText.HorizontalAlignment = TextHorizontalAlignmentOption.Left
		self.TooltipText.VerticalAlignment = TextVerticalAlignmentOption.Top
		self.TooltipText.Text = text
		self:ResizeToText(text)
		-- The tooltip group sits in UILayerLogic's Cursor layer, above every window.
		_GameUIPolishLogic:FitVerticalScrollLayouts(self.Entity)
		-- Hot Reload can preserve Visible=false from an older ForceHide implementation.
		-- Normalize visibility when showing, then use Enable only for subsequent hide/show.
		self.TooltipPanel.Visible = true
		if isvalid(self.TooltipTextEntity) then
			self.TooltipTextEntity.Visible = true
			self.TooltipTextEntity.Enable = true
		end
		self.TooltipPanel.Enable = true
		self.IsShowing = true
		self.LastCursorPosition = Vector2(-100000, -100000)
		self:UpdatePosition(_InputService:GetCursorPosition())
		log("[MouseTooltip] shown owner=" .. ownerKey
			.. " panelEnable=" .. tostring(self.TooltipPanel.Enable)
			.. " panelVisible=" .. tostring(self.TooltipPanel.Visible))
	end

	@ExecSpace("ClientOnly")
	method void Hide(string ownerKey)
		if ownerKey ~= nil and ownerKey ~= "" and ownerKey ~= self.ActiveOwnerKey then return end
		local hiddenOwnerKey = self.ActiveOwnerKey
		local wasShowing = self.IsShowing
		self:ForceHide()
		if wasShowing then
			log("[MouseTooltip] hidden owner=" .. hiddenOwnerKey)
		end
	end

	@ExecSpace("ClientOnly")
	method void ForceHide()
		self.HoverSkillId = ""
		self.HoverMap = nil
		self.SkillHoverRequestId = self.SkillHoverRequestId + 1
		self._T.PendingSkillHover = nil
		self._T.DisplayText = nil
		self:ApplySkillRange(nil, {})
		if isvalid(self.TooltipPanel) then self.TooltipPanel.Enable = false end
		self.ActiveOwnerKey = ""
		self.IsShowing = false
		self.LastCursorPosition = Vector2(-100000, -100000)
	end

	@ExecSpace("ClientOnly")
	method void ResizeToText(string text)
		if isvalid(self.TooltipPanel) == false or self.TooltipPanel.UITransformComponent == nil then return end
		if isvalid(self.TooltipTextEntity) == false or self.TooltipTextEntity.UITransformComponent == nil then return end
		local maxLineUnits = 0
		local lineCount = 0
		local startIndex = 1
		local measuredText, _ = string.gsub(text, "<[^>]+>", "")
		local textLength = string.len(measuredText)
		while startIndex <= textLength + 1 do
			local newlineIndex, newlineEndIndex = string.find(measuredText, "\n", startIndex, true)
			local lineEnd = textLength
			if newlineIndex ~= nil then lineEnd = newlineIndex - 1 end
			local lineText = string.sub(measuredText, startIndex, lineEnd)
			maxLineUnits = math.max(maxLineUnits, self:GetTextWidthUnits(lineText))
			lineCount = lineCount + 1
			if newlineIndex == nil then break end
			startIndex = newlineEndIndex + 1
		end
		local screenEdge = _UILogic:ScreenToUIPosition(Vector2(_UILogic.ScreenWidth, _UILogic.ScreenHeight))
		local reader = self.TooltipTextEntity:GetComponent("script.ScrollableTextComponent")
		local gutter = reader ~= nil and (self.MaxWidth - reader:GetContentWidth(self.MaxWidth)) or 14
		local panelWidth = math.max(80, math.min(screenEdge.x * 2 - self.EdgeMargin * 2, math.max(self.MinWidth, math.min(self.MaxWidth, self.TooltipText:GetPreferredWidth(text) + self.HorizontalPadding + gutter))))
		-- Measure the same content width used by the clipped text, including its scrollbar gutter.
		local textWidth = math.max(1, panelWidth - self.HorizontalPadding)
		local measureWidth = reader ~= nil and reader:GetContentWidth(textWidth) or math.max(1, textWidth - 14)
		local preferred = self.TooltipText:GetPreferredHeight(text, measureWidth) + 8
		local wantedHeight = math.max(preferred, lineCount * self.LineHeight) + self.VerticalPadding
		local maxHeight = math.max(64, screenEdge.y * 2 - self.EdgeMargin * 2)
		local panelHeight = math.max(self.MinHeight, math.min(maxHeight, wantedHeight))
		-- A tooltip that fits on screen shows everything at once: no scrolling and no scrollbar. Only text taller
		-- than the screen keeps the scroll viewport.
		local scrollLayout = self.TooltipTextEntity.ScrollLayoutGroupComponent
		if scrollLayout ~= nil then
			local fits = wantedHeight <= maxHeight
			scrollLayout.UseScroll = fits == false
			scrollLayout.ScrollBarVisible = fits and ScrollBarVisibility.Hide or ScrollBarVisibility.AutoHide
		end
		self.TooltipPanel.UITransformComponent.RectSize = Vector2(panelWidth, panelHeight)
		-- Center the inset text box so wrapped lines share one left edge and equal padding.
		local textTransform = self.TooltipTextEntity.UITransformComponent
		textTransform.AlignmentOption = AlignmentType.Center
		textTransform.AnchorsMin = Vector2(0.5, 0.5)
		textTransform.AnchorsMax = Vector2(0.5, 0.5)
		textTransform.Pivot = Vector2(0.5, 0.5)
		textTransform.anchoredPosition = Vector2.zero
		self.TooltipTextEntity.UITransformComponent.RectSize = Vector2(math.max(1, panelWidth - self.HorizontalPadding), math.max(1, panelHeight - self.VerticalPadding))
		if reader ~= nil then reader:RefreshText() end
	end

	@ExecSpace("ClientOnly")
	method string ColorizeSkillText(string text)
		local lines = {}
		for line in string.gmatch(text or "", "[^\n]+") do
			local cleanedText, replacementCount = string.gsub(line, "^%s*(.-)%s*$", "%1")
			line = cleanedText
			local color = "E0E8EE"
			if #lines == 0 then color = "63E4D6"
			elseif string.find(line, "연계", 1, true) == 1 then color = "FFC76B"
			elseif string.find(line, "증강:", 1, true) == 1 then color = "C4A4FF"
			elseif string.find(line, "회복:", 1, true) == 1 then color = "88E3AB" end
			table.insert(lines, "<color=#" .. color .. ">" .. line .. "</color>")
		end
		return table.concat(lines, "\n")
	end

	@ExecSpace("ClientOnly")
	method void RequestSkillHover(Entity map, string skillId, string signature)
		-- One live preview in flight prevents a slow reply from being superseded every 0.3s.
		if not isvalid(map) or skillId == "" then return end
		local sameSkill = self.ActiveOwnerKey == "battle_skill" and self.HoverMap == map and self.HoverSkillId == skillId
		local now = _UtilLogic.ElapsedSeconds
		local session = map:GetComponent("script.BattleSessionComponent")
		if session == nil then return end
		if self._T.SkillHoverCacheMap ~= map then
			self._T.SkillHoverCacheMap = map
			self._T.SkillHoverCache = {}
		end
		local cache = self._T.SkillHoverCache or {}
		self._T.SkillHoverCache = cache
		local previousSignature = self._T.SkillHoverSignature
		self.HoverMap = map
		self.HoverSkillId = skillId
		self._T.SkillHoverSignature = signature
		self.ActiveOwnerKey = "battle_skill"
		if not sameSkill then
			self:ApplySkillRange(nil, {})
			self._T.PendingSkillHover = nil
			self.IsShowing = false
			if isvalid(self.TooltipPanel) then self.TooltipPanel.Enable = false end
		end
		local cached = cache[skillId]
		if cached ~= nil and cached.Signature == signature and now < cached.Expires then
			if not self.IsShowing then
				self.TooltipText.IsRichText = true
				self:Show("battle_skill", self:ColorizeSkillText(cached.Text))
				self:ApplySkillRange(map, cached.Cells)
			end
			return
		end
		local pending = self._T.PendingSkillHover
		if pending ~= nil and pending.Map == map and pending.SkillId == skillId
			and now - pending.Started < math.max(0.5, self.SkillHoverResponseTimeout) then return end
		if sameSkill and previousSignature == signature and now < (self._T.NextLiveSkillHover or 0) then return end
		self.SkillHoverRequestId = self.SkillHoverRequestId + 1
		self._T.PendingSkillHover = { Map = map, SkillId = skillId, Signature = signature, Started = now, RequestId = self.SkillHoverRequestId }
		self._T.NextLiveSkillHover = now + math.max(0.2, self.SkillHoverRefreshInterval)
		session:RequestSkillHover(skillId, self.SkillHoverRequestId)
	end

	@ExecSpace("ClientOnly")
	method void ReceiveSkillHover(Entity map, string skillId, integer requestId, string text, table cells)
		if self.ActiveOwnerKey ~= "battle_skill" or self.HoverMap ~= map or self.HoverSkillId ~= skillId or self.SkillHoverRequestId ~= requestId then return end
		local pending = self._T.PendingSkillHover
		if pending == nil or pending.RequestId ~= requestId then return end
		self._T.PendingSkillHover = nil
		if pending.Signature ~= self._T.SkillHoverSignature then
			-- The actor changed while the response was travelling; fetch the latest state once.
			self._T.NextLiveSkillHover = 0
			self:RequestSkillHover(map, skillId, self._T.SkillHoverSignature)
			return
		end
		self._T.SkillHoverCache = self._T.SkillHoverCache or {}
		self._T.SkillHoverCache[skillId] = { Signature = pending.Signature, Text = text, Cells = cells, Expires = _UtilLogic.ElapsedSeconds + math.max(0.2, self.SkillHoverRefreshInterval) }
		self.TooltipText.IsRichText = true
		self:Show("battle_skill", self:ColorizeSkillText(text))
		self:ApplySkillRange(map, cells)
		if self._T.LastSkillHoverText ~= text then
			self._T.LastSkillHoverText = text
			log("[SkillHover] shown skill=" .. skillId .. " cells=" .. tostring(#cells))
		end
	end

	@ExecSpace("ClientOnly")
	method void RequestEnemySkillHover(Entity map, string enemyUnitId, string skillId, string signature)
		-- Enemy queue hover; keyed by enemy+skill so two enemies with the same skill show their own range.
		local hoverKey = enemyUnitId .. ":" .. skillId
		if self.HoverMap == map and self.HoverSkillId == hoverKey and self._T.SkillHoverSignature == signature then return end
		local session = map:GetComponent("script.BattleSessionComponent")
		if session == nil then return end
		self._T.PendingSkillHover = nil
		self:ApplySkillRange(nil, {})
		self.HoverMap = map
		self.HoverSkillId = hoverKey
		self._T.SkillHoverSignature = signature
		self.SkillHoverRequestId = self.SkillHoverRequestId + 1
		self.ActiveOwnerKey = "enemy_skill"
		self.IsShowing = false
		if isvalid(self.TooltipPanel) then self.TooltipPanel.Enable = false end
		session:RequestEnemySkillHover(enemyUnitId, skillId, self.SkillHoverRequestId)
	end

	@ExecSpace("ClientOnly")
	method void ReceiveEnemySkillHover(Entity map, string hoverKey, integer requestId, string text, table cells)
		if self.ActiveOwnerKey ~= "enemy_skill" or self.HoverMap ~= map or self.HoverSkillId ~= hoverKey or self.SkillHoverRequestId ~= requestId then return end
		self.TooltipText.IsRichText = true
		self:Show("enemy_skill", self:ColorizeEnemySkillText(text))
		self:ApplySkillRange(map, cells)
		log("[EnemySkillHover] shown key=" .. hoverKey .. " cells=" .. tostring(#cells))
	end

	@ExecSpace("ClientOnly")
	method string ColorizeEnemySkillText(string text)
		-- Enemy titles read hostile (red), special tags and statuses gold, telegraph warnings pink.
		local lines = {}
		for line in string.gmatch(text or "", "[^\n]+") do
			local color = "E0E8EE"
			if #lines == 0 then color = string.find(line, "[특수 공격]", 1, true) ~= nil and "FFB347" or "FF8A7A"
			elseif string.find(line, "효과:", 1, true) == 1 then color = "FFC76B"
			elseif string.find(line, "예고", 1, true) == 1 then color = "FF9FB0" end
			table.insert(lines, "<color=#" .. color .. ">" .. line .. "</color>")
		end
		return table.concat(lines, "\n")
	end

	@ExecSpace("ClientOnly")
	method void ApplySkillRange(Entity map, table cells)
		local root = _EntityService:GetEntityByPath("/ui/BattlePlatformHUD")
		local platforms = isvalid(root) and root:GetComponent("script.BattlePlatformUIComponent") or nil
		if platforms ~= nil then platforms:SetSkillRange(map, cells) end
	end

	@ExecSpace("ClientOnly")
	method number GetTextWidthUnits(string text)
		local units = 0
		local index = 1
		local byteLength = string.len(text)
		while index <= byteLength do
			local value = string.byte(text, index)
			if value < 128 then
				if value == 32 then units = units + 0.45 else units = units + 0.6 end
				index = index + 1
			elseif value < 224 then
				units = units + 1
				index = index + 2
			elseif value < 240 then
				units = units + 1
				index = index + 3
			else
				units = units + 1
				index = index + 4
			end
		end
		return units
	end

	@ExecSpace("ClientOnly")
	method void UpdatePosition(Vector2 cursorPosition)
		if isvalid(self.TooltipPanel) == false or self.TooltipPanel.UITransformComponent == nil then return end
		self.LastCursorPosition = cursorPosition
		local transform = self.TooltipPanel.UITransformComponent
		local size = transform.RectSize
		local cursorUIPosition = _UILogic:ScreenToUIPosition(cursorPosition)
		local halfWidth = size.x * 0.5
		local halfHeight = size.y * 0.5
		local screenEdge = _UILogic:ScreenToUIPosition(Vector2(_UILogic.ScreenWidth, _UILogic.ScreenHeight))
		local maxX = math.max(0, screenEdge.x - halfWidth - self.EdgeMargin)
		local maxY = math.max(0, screenEdge.y - halfHeight - self.EdgeMargin)
		local tooltipX = cursorUIPosition.x + self.CursorGap + halfWidth
		local tooltipY = cursorUIPosition.y - self.CursorGap - halfHeight
		if tooltipX > maxX then tooltipX = cursorUIPosition.x - self.CursorGap - halfWidth end
		if tooltipY < -maxY then tooltipY = cursorUIPosition.y + self.CursorGap + halfHeight end
		tooltipX = math.max(-maxX, math.min(maxX, tooltipX))
		tooltipY = math.max(-maxY, math.min(maxY, tooltipY))
		transform.anchoredPosition = Vector2(tooltipX, tooltipY)
	end

end
