@Logic
script GameUIPolishLogic extends Logic

	property table Animations = {}
	property number ToastRemaining = 0
	property number SoundCooldown = 0

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self:FitVerticalScrollLayouts(_EntityService:GetEntityByPath("/ui"))
		log("[UIPolish] vertical scroll widths initialized")
	end

	@ExecSpace("ClientOnly")
	method void FitVerticalScrollLayouts(Entity root)
		-- Fit authored rows and newly cloned rows whenever their window opens.
		if isvalid(root) == false then return end
		if root.ScrollLayoutGroupComponent ~= nil then
			self:FitVerticalScrollLayout(root.ScrollLayoutGroupComponent)
		end
		for _, layout in ipairs(root:GetChildComponentsByTypeName("MOD.Core.ScrollLayoutGroupComponent", true)) do
			self:FitVerticalScrollLayout(layout)
		end
	end

	@ExecSpace("ClientOnly")
	method void FitVerticalScrollLayout(ScrollLayoutGroupComponent layout)
		-- Reserve the vertical bar so its appearance cannot create horizontal overflow.
		if layout == nil or layout.UseScroll ~= true or layout.Type ~= LayoutGroupType.Vertical then return end
		local entity = layout.Entity
		if isvalid(entity) == false or entity.UITransformComponent == nil then return end
		layout:SetScrollNormalizedPosition(UITransformAxis.Horizontal, 0)
		if layout.ScrollBarVisible ~= ScrollBarVisibility.Hide then layout.ScrollBarVisible = ScrollBarVisibility.AutoHide end
		local viewportWidth = entity.UITransformComponent.RectSize.x
		if viewportWidth <= 0 then return end
		local padding = layout.Padding
		local horizontalPadding = padding ~= nil and (padding.left + padding.right) or 0
		local width = math.max(1, viewportWidth - horizontalPadding - math.max(14, layout.ScrollBarThickness) - 2)
		for _, child in ipairs(entity.Children:ToTable()) do
			if isvalid(child) and child.UITransformComponent ~= nil then
				local transform = child.UITransformComponent
				if transform.RectSize.x > width then
					transform.RectSize = Vector2(width, transform.RectSize.y)
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void FitLabel(TextGUIRendererComponent text, number size)
		-- Runtime font changes must update BestFit bounds as well as FontSize.
		if text == nil then return end
		text.FontSize = size
		text.BestFit = true
		text.MaxSize = size
		text.MinSize = math.min(size, math.max(14, math.floor(size * 0.75)))
		text.Overflow = TextOverflowMode.Ellipsis
	end

	@ExecSpace("ClientOnly")
	method void BringUIGroupToFront(Entity root)
		-- Resolve the current stack when opening; Maker can renumber authored group orders.
		if isvalid(root) == false then return end
		self:FitVerticalScrollLayouts(root)
		if root.UIGroupComponent == nil then return end
		local ui = _EntityService:GetEntityByPath("/ui")
		if isvalid(ui) == false then return end
		local group = root.UIGroupComponent
		local highest = group.GroupOrder
		local lastSibling = 0
		for _, other in ipairs(ui:GetChildComponentsByTypeName("MOD.Core.UIGroupComponent", true)) do
			if other.GroupType == group.GroupType then
				highest = math.max(highest, other.GroupOrder)
			end
			if other.Entity.UITransformComponent ~= nil then
				lastSibling = math.max(lastSibling, _UILogic:GetSiblingIndex(other.Entity.UITransformComponent))
			end
		end
		group.GroupOrder = highest + 1
		-- Groups draw in sibling order, which the loaded hierarchy does not always derive from GroupOrder
		-- (and a runtime GroupOrder change does not re-sort it), so move the group to the last sibling too.
		if root.UITransformComponent ~= nil then
			_UILogic:SetSiblingIndex(root.UITransformComponent, lastSibling)
		end
		log("[UIPolish] front=" .. root.Name .. " order=" .. tostring(group.GroupOrder) .. " sibling=" .. tostring(lastSibling))
	end

	@ExecSpace("ClientOnly")
	method void PlayClick()
		-- Limits duplicate sound playback when several handlers observe one click.
		if self.SoundCooldown > 0 then return end
		self.SoundCooldown = 0.06
		_GameSettingsLogic:PlayUISound("972843e759204d3e9ad84e7d3fa94f83", 0.35)
	end

	@ExecSpace("ClientOnly")
	method void SetWindowVisible(Entity window, boolean visible)
		-- Reversible fades share one duration and never leave an invisible clickable modal.
		if isvalid(window) == false then return end
		if visible then self:FitVerticalScrollLayouts(window) end
		local canvas = window.CanvasGroupComponent
		if canvas == nil then window:SetEnable(visible) return end
		local from = window.Enable and canvas.GroupAlpha or 0
		if visible == false and window.Enable == false then return end
		window:SetEnable(true)
		canvas.Interactable = visible
		canvas.BlocksRaycasts = true
		self.Animations[window.Id] = { Entity = window, From = from, To = visible and 1 or 0, Time = 0, Visible = visible }
	end

	@ExecSpace("ClientOnly")
	method void HideWindowImmediately(Entity window)
		-- Cancels pending fades when a map change invalidates the screen context.
		if isvalid(window) == false then return end
		self.Animations[window.Id] = nil
		window:SetEnable(false)
		if window.CanvasGroupComponent ~= nil then window.CanvasGroupComponent.GroupAlpha = 1 end
	end

	@ExecSpace("ClientOnly")
	method boolean IsTransitioning()
		-- Keeps lobby shortcuts blocked during the brief closing fade.
		return next(self.Animations) ~= nil
	end

	@ExecSpace("ClientOnly")
	method void ShowToast(string title, string detail)
		-- Reuses the existing toast layer with one compact two-line notification.
		local toastGroup = _EntityService:GetEntityByPath("/ui/ToastGroup")
		local toast = _EntityService:GetEntityByPath("/ui/ToastGroup/PolishToast")
		if isvalid(toastGroup) == false or isvalid(toast) == false then return end
		local heading = _EntityService:GetEntityByPath("/ui/ToastGroup/PolishToast/Title")
		local body = _EntityService:GetEntityByPath("/ui/ToastGroup/PolishToast/Detail")
		heading.TextGUIRendererComponent.Text = title
		body.TextGUIRendererComponent.Text = detail
		local height = math.max(30, math.min(220, body.TextGUIRendererComponent:GetPreferredHeight(detail, 538) + 8))
		toast.UITransformComponent.RectSize = Vector2(600, height + 80)
		local edge = _UILogic:ScreenToUIPosition(Vector2(_UILogic.ScreenWidth, _UILogic.ScreenHeight))
		toast.UITransformComponent.anchoredPosition = Vector2(0, edge.y - 40 - (height + 80) * 0.5)
		heading.UITransformComponent.anchoredPosition = Vector2(0, (height + 80) * 0.5 - 28)
		body.UITransformComponent.RectSize = Vector2(552, height)
		body.UITransformComponent.anchoredPosition = Vector2(0, -24)
		-- DefaultShow=false keeps the root inactive until a notification is requested.
		toastGroup:SetEnable(true)
		toast:SetEnable(true)
		toast.CanvasGroupComponent.GroupAlpha = 1
		self.ToastRemaining = math.max(3.2, math.min(12, height / 20))
		log("[UIPolish] toast shown title=" .. title)
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- Advances short client-only fades independently of gameplay or storage.
		self.SoundCooldown = math.max(0, self.SoundCooldown - delta)
		for id, animation in pairs(self.Animations) do
			local entity = animation.Entity
			if isvalid(entity) == false then self.Animations[id] = nil
			else
				animation.Time = math.min(0.14, animation.Time + delta)
				local ratio = animation.Time / 0.14
				local eased = 1 - (1 - ratio) * (1 - ratio)
				entity.CanvasGroupComponent.GroupAlpha = animation.From + (animation.To - animation.From) * eased
				if ratio >= 1 then
					entity:SetEnable(animation.Visible)
					entity.CanvasGroupComponent.GroupAlpha = 1
					self.Animations[id] = nil
				end
			end
		end
		if self.ToastRemaining > 0 then
			local toast = _EntityService:GetEntityByPath("/ui/ToastGroup/PolishToast")
			local hovering = false
			if isvalid(toast) then
				local cursor = _UILogic:ScreenToUIPosition(_InputService:GetCursorPosition())
				local rect = toast.UITransformComponent
				hovering = math.abs(cursor.x - rect.anchoredPosition.x) <= rect.RectSize.x * 0.5 and math.abs(cursor.y - rect.anchoredPosition.y) <= rect.RectSize.y * 0.5
			end
			if not hovering then self.ToastRemaining = math.max(0, self.ToastRemaining - delta) end
			if isvalid(toast) then
				toast.CanvasGroupComponent.GroupAlpha = math.min(1, self.ToastRemaining / 0.25)
				if self.ToastRemaining == 0 then toast:SetEnable(false) log("[UIPolish] toast hidden") end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- Drops entity references and restores every animated window to its requested state.
		for _, animation in pairs(self.Animations) do
			if isvalid(animation.Entity) then
				animation.Entity:SetEnable(animation.Visible)
				animation.Entity.CanvasGroupComponent.GroupAlpha = 1
			end
		end
		self.Animations = {}
		self.ToastRemaining = 0
		local toast = _EntityService:GetEntityByPath("/ui/ToastGroup/PolishToast")
		if isvalid(toast) then toast:SetEnable(false) end
	end
end
