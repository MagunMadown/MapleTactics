@Logic
script GameUIPolishLogic extends Logic

	property table Animations = {}
	property number ToastRemaining = 0
	property number SoundCooldown = 0

	@ExecSpace("ClientOnly")
	method void PlayClick()
		-- Limits duplicate sound playback when several handlers observe one click.
		if self.SoundCooldown > 0 then return end
		self.SoundCooldown = 0.06
		_GameSettingsLogic:PlayUISound("972843e759204d3e9ad84e7d3fa94f83", 0.35)
	end

	@ExecSpace("ClientOnly")
	method void SetWindowVisible(Entity window, boolean visible)
		-- Reversible fades share one duration and never leave an invisible clickable modal.
		if isvalid(window) == false then return end
		local canvas = window.CanvasGroupComponent
		if canvas == nil then window:SetEnable(visible) return end
		local from = window.Enable and canvas.GroupAlpha or 0
		if visible == false and window.Enable == false then return end
		window:SetEnable(true)
		canvas.Interactable = visible
		canvas.BlocksRaycasts = true
		self.Animations[window.Id] = { Entity = window, From = from, To = visible and 1 or 0, Time = 0, Visible = visible }
	end

	@ExecSpace("ClientOnly")
	method void HideWindowImmediately(Entity window)
		-- Cancels pending fades when a map change invalidates the screen context.
		if isvalid(window) == false then return end
		self.Animations[window.Id] = nil
		window:SetEnable(false)
		if window.CanvasGroupComponent ~= nil then window.CanvasGroupComponent.GroupAlpha = 1 end
	end

	@ExecSpace("ClientOnly")
	method boolean IsTransitioning()
		-- Keeps lobby shortcuts blocked during the brief closing fade.
		return next(self.Animations) ~= nil
	end

	@ExecSpace("ClientOnly")
	method void ShowToast(string title, string detail)
		-- Reuses the existing toast layer with one compact two-line notification.
		local toast = _EntityService:GetEntityByPath("/ui/ToastGroup/PolishToast")
		if isvalid(toast) == false then return end
		local heading = _EntityService:GetEntityByPath("/ui/ToastGroup/PolishToast/Title")
		local body = _EntityService:GetEntityByPath("/ui/ToastGroup/PolishToast/Detail")
		heading.TextGUIRendererComponent.Text = title
		body.TextGUIRendererComponent.Text = detail
		toast:SetEnable(true)
		toast.CanvasGroupComponent.GroupAlpha = 1
		self.ToastRemaining = 3.2
		log("[UIPolish] toast shown title=" .. title)
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- Advances short client-only fades independently of gameplay or storage.
		self.SoundCooldown = math.max(0, self.SoundCooldown - delta)
		for id, animation in pairs(self.Animations) do
			local entity = animation.Entity
			if isvalid(entity) == false then self.Animations[id] = nil
			else
				animation.Time = math.min(0.14, animation.Time + delta)
				local ratio = animation.Time / 0.14
				local eased = 1 - (1 - ratio) * (1 - ratio)
				entity.CanvasGroupComponent.GroupAlpha = animation.From + (animation.To - animation.From) * eased
				if ratio >= 1 then
					entity:SetEnable(animation.Visible)
					entity.CanvasGroupComponent.GroupAlpha = 1
					self.Animations[id] = nil
				end
			end
		end
		if self.ToastRemaining > 0 then
			self.ToastRemaining = math.max(0, self.ToastRemaining - delta)
			local toast = _EntityService:GetEntityByPath("/ui/ToastGroup/PolishToast")
			if isvalid(toast) then
				toast.CanvasGroupComponent.GroupAlpha = math.min(1, self.ToastRemaining / 0.25)
				if self.ToastRemaining == 0 then toast:SetEnable(false) log("[UIPolish] toast hidden") end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- Drops entity references and restores every animated window to its requested state.
		for _, animation in pairs(self.Animations) do
			if isvalid(animation.Entity) then
				animation.Entity:SetEnable(animation.Visible)
				animation.Entity.CanvasGroupComponent.GroupAlpha = 1
			end
		end
		self.Animations = {}
		self.ToastRemaining = 0
		local toast = _EntityService:GetEntityByPath("/ui/ToastGroup/PolishToast")
		if isvalid(toast) then toast:SetEnable(false) end
	end
end
