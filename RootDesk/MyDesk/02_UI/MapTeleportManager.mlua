@Logic
script MapTeleportManager extends Logic
	property number PreTransferUiDelay = 0.15
	property table PendingTransfers = {}

	@ExecSpace("ServerOnly")
	method void OnInitialize()
		-- Configure the entry map before the first player is created.
		_DefaultUserEnterLeaveLogic.StartPoint = "/maps/lobby"
		log("[MapNavigation] start point=/maps/lobby")
	end

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- Announces the single server-side boundary used by every map transfer flow.
		self.PendingTransfers = {}
		log("[MapNavigation] ready")
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- Releases all pre-transfer timers when the world session ends.
		for _, pending in pairs(self.PendingTransfers) do
			if pending.TimerId > 0 then _TimerService:ClearTimer(pending.TimerId) end
		end
		self.PendingTransfers = {}
	end

	@ExecSpace("ServerOnly")
	method void CancelPendingTransfer(Entity playerEntity, string reason)
		-- Invalidates a delayed transfer before a newer destination or run reset is accepted.
		if isvalid(playerEntity) == false or playerEntity.PlayerComponent == nil then return end
		local userId = playerEntity.PlayerComponent.UserId
		local pending = self.PendingTransfers[userId]
		if pending == nil then return end
		self.PendingTransfers[userId] = nil
		if pending.TimerId > 0 then _TimerService:ClearTimer(pending.TimerId) end
		log("[MapNavigation] pending transfer cancelled user=" .. userId .. " reason=" .. (reason or "UNSPECIFIED"))
	end

	@ExecSpace("ServerOnly")
	method table CapturePendingTransfer(Entity playerEntity, string source)
		-- Makes each accepted request replace older stage and pre-transfer reservations for this player.
		self:CancelPendingTransfer(playerEntity, source)
		_StageTransitionManagerLogic:CancelPendingTransition(playerEntity, source)
		local runState = playerEntity:GetComponent("script.PlayerRunStateComponent")
		local pending = {
			PlayerEntity = playerEntity, UserId = playerEntity.PlayerComponent.UserId,
			SourceMap = playerEntity.CurrentMap, TimerId = 0,
			RunSequence = runState ~= nil and runState.RunSequence or -1
		}
		self.PendingTransfers[pending.UserId] = pending
		return pending
	end

	@ExecSpace("ServerOnly")
	method boolean ConsumePendingTransfer(table pending)
		-- Claims only the latest request while the same player remains in its original map and run.
		local current = self:IsPendingTransferCurrent(pending)
		if self.PendingTransfers[pending.UserId] == pending then self.PendingTransfers[pending.UserId] = nil end
		return current
	end

	@ExecSpace("ServerOnly")
	method boolean IsPendingTransferCurrent(table pending)
		if self.PendingTransfers[pending.UserId] ~= pending then return false end
		local playerEntity = pending.PlayerEntity
		if isvalid(playerEntity) == false or isvalid(pending.SourceMap) == false or playerEntity.CurrentMap ~= pending.SourceMap then return false end
		local runState = playerEntity:GetComponent("script.PlayerRunStateComponent")
		local runSequence = runState ~= nil and runState.RunSequence or -1
		return runSequence == pending.RunSequence
	end

	@ExecSpace("ServerOnly")
	method void WaitForDestination(table pending, string destination, Vector3 position, string source, integer attempts)
		if not self:IsPendingTransferCurrent(pending) then
			if self.PendingTransfers[pending.UserId] == pending then self.PendingTransfers[pending.UserId] = nil end
			return
		end
		local map = _EntityService:GetEntityByPath("/maps/" .. destination)
		if isvalid(map) and map.MapComponent ~= nil then
			if self:ConsumePendingTransfer(pending) then self:TeleportPlayer(pending.PlayerEntity, destination, position, source) end
			return
		end
		if attempts <= 0 then
			self.PendingTransfers[pending.UserId] = nil
			self:NotifyUnavailableDestination(destination, pending.UserId)
			return
		end
		pending.TimerId = _TimerService:SetTimerOnce(function()
			self:WaitForDestination(pending, destination, position, source, attempts - 1)
		end, 0.5)
		if pending.TimerId == 0 then
			self.PendingTransfers[pending.UserId] = nil
			self:NotifyUnavailableDestination(destination, pending.UserId)
		end
	end

	@ExecSpace("ServerOnly")
	method table TeleportPlayer(Entity playerEntity, string destinationMapName, Vector3 targetPosition, string source)
		-- Validates and dispatches one authoritative map transfer for server-owned flows.
		local result = {
			Success = false,
			Reason = "UNKNOWN",
			DestinationMapName = destinationMapName or "",
			Source = source or "UNSPECIFIED"
		}
		if isvalid(playerEntity) == false or playerEntity.PlayerComponent == nil then
			result.Reason = "INVALID_PLAYER"
			log_warning("[MapNavigation] transfer rejected source=" .. result.Source .. " reason=" .. result.Reason)
			return result
		end
		if destinationMapName == nil or destinationMapName == "" then
			result.Reason = "DESTINATION_MAP_MISSING"
			log_warning("[MapNavigation] transfer rejected player=" .. playerEntity.Name .. " source=" .. result.Source .. " reason=" .. result.Reason)
			return result
		end

		-- Wait in the source map for up to ten seconds without replaying reward logic.
		local destination = _EntityService:GetEntityByPath("/maps/" .. destinationMapName)
		if not isvalid(destination) or destination.MapComponent == nil then
			local waiting = self:CapturePendingTransfer(playerEntity, result.Source)
			self:WaitForDestination(waiting, destinationMapName, targetPosition, result.Source, 20)
			result.Success = self.PendingTransfers[waiting.UserId] == waiting
			result.Reason = result.Success and "WAITING_FOR_DESTINATION" or "DESTINATION_MAP_UNAVAILABLE"
			return result
		end
		local pending = self:CapturePendingTransfer(playerEntity, result.Source)
		self:PrepareClientForMapTransfer(result.Source, playerEntity.PlayerComponent.UserId)
		local targetPlayer = playerEntity
		local targetMapName = destinationMapName
		local targetMapPosition = targetPosition
		local transferSource = result.Source
		local requestTransfer = function()
			if self:ConsumePendingTransfer(pending) == false then
				log_warning("[MapNavigation] delayed transfer cancelled map=" .. targetMapName .. " source=" .. transferSource .. " reason=STALE_REQUEST")
				return
			end
			-- Reward screens use this boundary directly, without the lobby gateway.
			-- Record arrival eligibility only for the prepared battle's destination,
			-- never for the intermediate reward map visited before it.
			local entry = targetPlayer:GetComponent("script.BattleEntryStateComponent")
			if entry ~= nil and entry.EntryState == "PREPARED" then
				local route = _StageMapRouteRepositoryLogic:GetMapRoute(entry.StageId)
				if route ~= nil and route.Success == true and route.MapId == targetMapName then
					entry:TryMarkTransferRequested(entry.RequestId)
				end
			end
			_TeleportService:TeleportToMapPosition(targetPlayer, targetMapPosition, targetMapName)
			log("[MapNavigation] transfer requested player=" .. targetPlayer.Name .. " map=" .. targetMapName .. " pos=" .. tostring(targetMapPosition) .. " source=" .. transferSource)
		end
		pending.TimerId = _TimerService:SetTimerOnce(requestTransfer, math.max(0.05, self.PreTransferUiDelay))
		if pending.TimerId == 0 then
			log_warning("[MapNavigation] pre-transfer delay unavailable map=" .. destinationMapName .. " source=" .. result.Source .. " fallback=IMMEDIATE")
			requestTransfer()
		end
		result.Success = true
		result.Reason = "TRANSFER_REQUESTED"
		log("[MapNavigation] transfer scheduled player=" .. playerEntity.Name .. " map=" .. destinationMapName .. " delay=" .. tostring(self.PreTransferUiDelay) .. " source=" .. result.Source)
		return result
	end

	@ExecSpace("ServerOnly")
	method table TeleportPlayerToSpawn(Entity playerEntity, string destinationMapName, string spawnEntityName, string source)
		-- Transfers to the destination map entity so the map-owned SpawnLocation remains authoritative.
		local result = {
			Success = false,
			Reason = "UNKNOWN",
			DestinationMapName = destinationMapName or "",
			Source = source or "UNSPECIFIED"
		}
		if isvalid(playerEntity) == false or playerEntity.PlayerComponent == nil then
			result.Reason = "INVALID_PLAYER"
			log_warning("[MapNavigation] spawn transfer rejected source=" .. result.Source .. " reason=" .. result.Reason)
			return result
		end
		if destinationMapName == nil or destinationMapName == "" then
			result.Reason = "DESTINATION_MAP_MISSING"
			log_warning("[MapNavigation] spawn transfer rejected player=" .. playerEntity.Name .. " source=" .. result.Source .. " reason=" .. result.Reason)
			return result
		end

		local resolvedSpawnName = spawnEntityName or "SpawnLocation"
		if resolvedSpawnName == "" then
			resolvedSpawnName = "SpawnLocation"
		end
		local destinationEntityPath = "/maps/" .. destinationMapName .. "/" .. resolvedSpawnName
		local pending = self:CapturePendingTransfer(playerEntity, result.Source)
		self:PrepareClientForMapTransfer(result.Source, playerEntity.PlayerComponent.UserId)
		local targetPlayer = playerEntity
		local targetPath = destinationEntityPath
		local transferSource = result.Source
		local requestTransfer = function()
			if self:ConsumePendingTransfer(pending) == false then
				log_warning("[MapNavigation] delayed spawn transfer cancelled path=" .. targetPath .. " source=" .. transferSource .. " reason=STALE_REQUEST")
				return
			end
			_TeleportService:TeleportToEntityPath(targetPlayer, targetPath)
			log("[MapNavigation] spawn transfer requested player=" .. targetPlayer.Name .. " path=" .. targetPath .. " source=" .. transferSource)
		end
		pending.TimerId = _TimerService:SetTimerOnce(requestTransfer, math.max(0.05, self.PreTransferUiDelay))
		if pending.TimerId == 0 then
			log_warning("[MapNavigation] pre-transfer delay unavailable path=" .. destinationEntityPath .. " source=" .. result.Source .. " fallback=IMMEDIATE")
			requestTransfer()
		end
		result.Success = true
		result.Reason = "SPAWN_TRANSFER_REQUESTED"
		result.SpawnEntityPath = destinationEntityPath
		log("[MapNavigation] spawn transfer scheduled player=" .. playerEntity.Name .. " path=" .. destinationEntityPath .. " delay=" .. tostring(self.PreTransferUiDelay) .. " source=" .. result.Source)
		return result
	end


	@ExecSpace("Client")
	method void NotifyUnavailableDestination(string destination)
		_GameUIPolishLogic:ShowToast("목적지 맵을 불러오지 못했습니다", "잠시 후 다시 시도해 주세요. 현재 맵에 머무릅니다.")
	end


	@ExecSpace("Client")
	method void PrepareClientForMapTransfer(string source)
		-- Covers the old map and clears persistent UI before the destination is shown.
		local transitionRoot = _EntityService:GetEntityByPath("/ui/MapTransitionUI")
		if isvalid(transitionRoot) then
			local controller = transitionRoot:GetChildByName("Controller", false)
			if isvalid(controller) then
				local transition = controller:GetComponent("script.MapTransitionUIComponent")
				if transition ~= nil then
					transition:BeginTransfer(source)
				end
			end
		end
		local battleHudRoot = _EntityService:GetEntityByPath("/ui/BattleQueueHUD")
		if isvalid(battleHudRoot) then
			local battleHud = battleHudRoot:GetComponent("script.BattleQueueHudComponent")
			if battleHud == nil then
				local controller = battleHudRoot:GetChildByName("Controller", false)
				if isvalid(controller) then
					battleHud = controller:GetComponent("script.BattleQueueHudComponent")
				end
			end
			if battleHud ~= nil then
				battleHud:PrepareForMapTransfer(source)
			end
		end
		local defaultUiRoot = _EntityService:GetEntityByPath("/ui/DefaultGroup")
		if isvalid(defaultUiRoot) then
			local minimapUI = defaultUiRoot:GetComponent("script.MinimapUI")
			if minimapUI ~= nil then
				minimapUI:CloseWorldMapForTransfer(source)
			end
		end
		log("[MapNavigation] client UI prepared source=" .. (source or "UNSPECIFIED"))
	end

	@ExecSpace("Server")
	method void RequestTeleport(string destinationMapName, Vector3 targetPosition, string source)
		-- Accepts a client request only when it matches the server-stored next run map.
		local playerEntity = _UserService:GetUserEntityByUserId(senderUserId)
		if isvalid(playerEntity) == false then
			log_warning("[MapNavigation] client transfer rejected user=" .. senderUserId .. " reason=INVALID_PLAYER")
			return
		end
		local runState = playerEntity:GetComponent("script.PlayerRunStateComponent")
		local expectedMapName = ""
		if runState ~= nil and runState.PendingNextStageMapName ~= nil then
			expectedMapName = runState.PendingNextStageMapName
		end
		if destinationMapName == nil or destinationMapName == "" or destinationMapName ~= expectedMapName then
			log_warning("[MapNavigation] client transfer rejected user=" .. senderUserId .. " requested=" .. tostring(destinationMapName) .. " expected=" .. expectedMapName .. " reason=DESTINATION_NOT_AUTHORIZED")
			return
		end
		local rewardRoute = _StageTransitionManagerLogic:ResolveGraphTransition(runState.LastCompletedStageId)
		if rewardRoute.Success == true and rewardRoute.NextShopMapId == destinationMapName then
			local transferred = _StageTransitionManagerLogic:EnterRewardShop(playerEntity)
			if transferred.Success then runState.PendingNextStageMapName = ""
			else log_warning("[MapNavigation] reward shop transfer failed reason=" .. transferred.Reason) end
			return
		end
		runState.PendingNextStageMapName = ""
		self:TeleportPlayer(playerEntity, destinationMapName, targetPosition, source)
	end

end
