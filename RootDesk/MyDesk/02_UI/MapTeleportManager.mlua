@Logic
script MapTeleportManager extends Logic

	@ExecSpace("Server")
	method void RequestTeleport(Entity player, string destinationMapName, Vector3 targetPos)
		        -- Teleports target player to the specified map and position.
		        if not isvalid(player) then
		            log_warning("MapTeleportManager: Player entity is invalid.")
		            return
		        end
		
		        log("MapTeleportManager: Teleporting player to map -> " .. destinationMapName)
		        _TeleportService:TeleportToMapPosition(player, targetPos, destinationMapName)
	end

	@ExecSpace("ClientOnly")
	method void RequestTeleportFromClient(string destinationMapName, Vector3 targetPos)
		        -- Client interface for requesting map teleportation.
		        local localPlayer = _UserService.LocalPlayer
		        if isvalid(localPlayer) then
		            self:RequestTeleport(localPlayer, destinationMapName, targetPos)
		        else
		            log_warning("MapTeleportManager: LocalPlayer is invalid.")
		        end
	end

end