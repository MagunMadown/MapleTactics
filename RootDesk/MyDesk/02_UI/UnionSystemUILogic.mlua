@Logic
script UnionSystemUILogic extends Logic

    property string WindowPath = "/ui/UnionSystemUI/UnionWindow"
    property string FramePath = "/ui/UnionSystemUI/UnionWindow/UnionFrame"
    property Entity UnionWindow = nil
    property ButtonComponent CloseButton = nil
    property ButtonComponent ResetButton = nil
    property TextGUIRendererComponent RankCodeText = nil
    property TextGUIRendererComponent RankNameText = nil
    property TextGUIRendererComponent GrowthText = nil
    property TextGUIRendererComponent CoinValueText = nil
    property TextGUIRendererComponent TotalPointsText = nil
    property TextGUIRendererComponent SpentPointsText = nil
    property TextGUIRendererComponent AvailablePointsText = nil
    property TextGUIRendererComponent EffectsText = nil
    property TextGUIRendererComponent PointStripText = nil
    property TextGUIRendererComponent StatusText = nil
    property table StatIds = {}
    property table JobIds = {}
    property table StatRowsById = {}
    property table StatCards = {}
    property table StatLevelTexts = {}
    property table StatEffectTexts = {}
    property table StatCostTexts = {}
    property table StatStatusTexts = {}
    property table StatIncreaseButtons = {}
    property table StatIncreaseHandlers = {}
    property table JobGradeTexts = {}
    property table JobProgressTexts = {}
    property table JobContributionTexts = {}
    property table UiHandlers = {}
    property boolean IsUiConnected = false
    property boolean IsWindowOpen = false
    property boolean IsRequestPending = false
    property boolean BindingWarningLogged = false
    property integer SnapshotRequestId = 0
    property integer MutationSequence = 0
    property integer CurrentSpentPoints = 0
    property string LastMutationMessage = ""

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleUnionKeyDown(KeyDownEvent event)
        if self.IsWindowOpen and event.key == KeyboardKey.Escape then self:CloseWindow() end
    end

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self:InitializeIds()
        self:EnsureUiConnection()
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        if self.IsUiConnected and isvalid(self.UnionWindow) == false then self:DisconnectUiEvents() end
        if self.IsUiConnected == false then self:EnsureUiConnection() end
        if self.IsWindowOpen and self:IsLocalPlayerInLobby() == false then self:CloseWindow() end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        self:DisconnectUiEvents()
        self.IsWindowOpen = false
        self.IsRequestPending = false
    end

    method void InitializeIds()
        self.StatIds = {
            "MAX_HP", "MESO_GAIN_RATE", "ITEM_DROP_RATE", "UNION_COIN_GAIN_RATE",
            "STARTING_POTION", "INVENTORY_SLOT", "AUGMENT_REROLL", "STARTING_SKILL"
        }
        self.JobIds = { "warrior", "mage", "archer", "thief", "pirate" }
    end

    @ExecSpace("ClientOnly")
    method boolean OpenWindow()
        if self.IsWindowOpen then return false end
        if self:IsLocalPlayerInLobby() == false or self:IsOtherLobbyPopupOpen() then
            log("[UnionUI2026] open rejected reason=LOBBY_NAVIGATION_BUSY")
            return false
        end
        if self:EnsureUiConnection() == false then
            log_error("[UnionUI2026] open failed reason=UI_BINDING_MISSING")
            return false
        end
        self.IsWindowOpen = true
        self:SetWindowEnabled(true)
        self:RefreshSnapshot("유니온 정보를 불러오는 중입니다.")
        log("[UnionUI2026] opened")
        return true
    end

    @ExecSpace("ClientOnly")
    method void CloseWindow()
        if self.IsWindowOpen == false then return end
        self.IsWindowOpen = false
        self.IsRequestPending = false
        self.SnapshotRequestId = self.SnapshotRequestId + 1
        self:SetWindowEnabled(false)
        log("[UnionUI2026] closed")
    end

    @ExecSpace("ClientOnly")
    method boolean IsOpen()
        return self.IsWindowOpen
    end

    @ExecSpace("ClientOnly")
    method void OnCloseButtonClicked()
        self:CloseWindow()
    end

    @ExecSpace("ClientOnly")
    method void OnResetButtonClicked()
        if self.IsWindowOpen == false or self.IsRequestPending then return end
        if self.CurrentSpentPoints <= 0 then
            self:SetStatus("초기화할 배분 포인트가 없습니다.")
            return
        end
        self:BeginRequest("전체 배분을 무료로 초기화하는 중입니다.")
        self.MutationSequence = self.MutationSequence + 1
        self:RequestResetUnionStats(self:BuildMutationRequestId("RESET", ""), self.SnapshotRequestId)
    end

    @ExecSpace("ClientOnly")
    method void OnIncreaseClicked(string statId)
        if self.IsWindowOpen == false or self.IsRequestPending then return end
        local row = self.StatRowsById[statId]
        if row == nil or row.CanIncrease ~= true then
            self:SetStatus(self:LocalizeReason(row ~= nil and row.IncreaseReason or "STAT_DATA_UNAVAILABLE"))
            return
        end
        self:BeginRequest(row.DisplayName .. " 포인트를 배분하는 중입니다.")
        self.MutationSequence = self.MutationSequence + 1
        self:RequestIncreaseUnionStat(statId, self:BuildMutationRequestId("INCREASE", statId), self.SnapshotRequestId)
    end

    @ExecSpace("ClientOnly")
    method void RefreshSnapshot(string statusMessage)
        if self.IsWindowOpen == false or self.IsRequestPending then return end
        self:BeginRequest(statusMessage)
        self:RequestUnionAllocationSnapshot(self.SnapshotRequestId)
    end

    @ExecSpace("ClientOnly")
    method void BeginRequest(string statusMessage)
        self.IsRequestPending = true
        self.SnapshotRequestId = self.SnapshotRequestId + 1
        self.StatRowsById = {}
        self.LastMutationMessage = ""
        self:SetStatus(statusMessage)
        self:RefreshAllCards()
    end

    @ExecSpace("ClientOnly")
    method string BuildMutationRequestId(string operation, string statId)
        local elapsed = math.floor((_UtilLogic.ElapsedSeconds or 0) * 1000)
        return "union-ui:" .. operation .. ":" .. (statId or "") .. ":" .. tostring(elapsed) .. ":" .. tostring(self.MutationSequence)
    end

    @ExecSpace("Server")
    method void RequestUnionAllocationSnapshot(integer requestId)
        self:SendAuthoritativeSnapshot(requestId, senderUserId)
    end

    @ExecSpace("Server")
    method void RequestIncreaseUnionStat(string statId, string mutationRequestId, integer requestId)
        local userEntity = _UserService:GetUserEntityByUserId(senderUserId)
        if isvalid(userEntity) == false or userEntity.PlayerComponent == nil then
            self:ReceiveMutationResult(requestId, false, "PLAYER_UNAVAILABLE", senderUserId)
            self:SendAuthoritativeSnapshot(requestId, senderUserId)
            return
        end
        local result = _UnionStatAllocationServiceLogic:TryIncreaseUnionStat(userEntity, statId or "", mutationRequestId or "")
        self:ReceiveMutationResult(requestId, result.Success == true, result.Reason or "UNKNOWN", senderUserId)
        self:SendAuthoritativeSnapshot(requestId, senderUserId)
        log("[UnionUI2026] increase user=" .. senderUserId .. " stat=" .. (statId or "") .. " success=" .. tostring(result.Success) .. " reason=" .. (result.Reason or "UNKNOWN"))
    end

    @ExecSpace("Server")
    method void RequestResetUnionStats(string mutationRequestId, integer requestId)
        local userEntity = _UserService:GetUserEntityByUserId(senderUserId)
        if isvalid(userEntity) == false or userEntity.PlayerComponent == nil then
            self:ReceiveMutationResult(requestId, false, "PLAYER_UNAVAILABLE", senderUserId)
            self:SendAuthoritativeSnapshot(requestId, senderUserId)
            return
        end
        local result = _UnionStatAllocationServiceLogic:TryResetUnionStats(userEntity, mutationRequestId or "")
        self:ReceiveMutationResult(requestId, result.Success == true, result.Reason or "UNKNOWN", senderUserId)
        self:SendAuthoritativeSnapshot(requestId, senderUserId)
        log("[UnionUI2026] reset user=" .. senderUserId .. " success=" .. tostring(result.Success) .. " changed=" .. tostring(result.WasReset == true) .. " reason=" .. (result.Reason or "UNKNOWN"))
    end

    @ExecSpace("ServerOnly")
    method void SendAuthoritativeSnapshot(integer requestId, string recipientUserId)
        local userEntity = _UserService:GetUserEntityByUserId(recipientUserId)
        if isvalid(userEntity) == false or userEntity.PlayerComponent == nil then
            self:SendSnapshotFailure(requestId, "PLAYER_UNAVAILABLE", recipientUserId)
            return
        end
        local allocationResult = _UnionStatAllocationServiceLogic:GetUnionStatAllocationSnapshot(userEntity)
        local effectResult = _UnionEffectResolverLogic:GetEffectSnapshot(userEntity)
        if allocationResult.Success == false or type(allocationResult.Snapshot) ~= "table" then
            self:SendSnapshotFailure(requestId, allocationResult.Reason or "UNION_ALLOCATION_UNAVAILABLE", recipientUserId)
            return
        end
        if effectResult.Success == false or type(effectResult.EffectSnapshot) ~= "table" then
            self:SendSnapshotFailure(requestId, effectResult.Reason or "UNION_EFFECT_UNAVAILABLE", recipientUserId)
            return
        end
        local snapshot = allocationResult.Snapshot
        local rank = snapshot.CurrentUnionRank or {}
        self:ReceiveUnionSummary(
            requestId, true, "OK", rank.RankId or "UNION_I", rank.DisplayName or "UNION I",
            math.floor(tonumber(snapshot.UnionCoins) or 0),
            math.floor(tonumber(snapshot.LifetimeUnionGrowth) or 0),
            math.floor(tonumber(snapshot.TotalUnionStatPoints) or 0),
            math.floor(tonumber(snapshot.SpentUnionStatPoints) or 0),
            math.floor(tonumber(snapshot.AvailableUnionStatPoints) or 0),
            self:BuildAppliedEffectsText(effectResult.EffectSnapshot),
            recipientUserId
        )
        local statCount = 0
        for _, row in ipairs(snapshot.Stats or {}) do
            statCount = statCount + 1
            self:ReceiveUnionStatRow(
                requestId, row.StatId or "", row.Category or "", row.DisplayName or row.StatId or "", row.Description or "",
                math.floor(tonumber(row.CurrentLevel) or 0), math.floor(tonumber(row.MaxLevel) or 0),
                tonumber(row.CurrentEffectValue) or 0, row.IsImplemented == true,
                row.RequiredUnionRank or "", row.CurrentUnionRank or rank.RankId or "", row.IsRankUnlocked == true,
                math.floor(tonumber(row.NextPointCost) or 0), row.CanIncrease == true,
                row.IncreaseReason or "UNKNOWN", math.floor(tonumber(row.SortOrder) or 0),
                recipientUserId
            )
        end
        local jobCount = 0
        for _, jobId in ipairs({ "warrior", "mage", "archer", "thief", "pirate" }) do
            local grade = snapshot.JobGrades ~= nil and snapshot.JobGrades[jobId] or nil
            if grade ~= nil then
                jobCount = jobCount + 1
                self:ReceiveUnionJobRow(
                    requestId, jobId, math.floor(tonumber(grade.Progress) or 0),
                    grade.GradeId or "NONE", grade.DisplayName or grade.GradeId or "NONE",
                    math.floor(tonumber(grade.StatPointContribution) or 0), recipientUserId
                )
            end
        end
        self:ReceiveUnionSnapshotComplete(requestId, true, "OK", statCount, jobCount, recipientUserId)
        log("[UnionUI2026] snapshot user=" .. recipientUserId .. " stats=" .. tostring(statCount) .. " jobs=" .. tostring(jobCount))
    end

    @ExecSpace("ServerOnly")
    method void SendSnapshotFailure(integer requestId, string reason, string recipientUserId)
        self:ReceiveUnionSummary(requestId, false, reason or "UNKNOWN", "UNION_I", "유니온 정보 없음", 0, 0, 0, 0, 0, "적용 효과를 불러오지 못했습니다.", recipientUserId)
        self:ReceiveUnionSnapshotComplete(requestId, false, reason or "UNKNOWN", 0, 0, recipientUserId)
    end

    @ExecSpace("Client")
    method void ReceiveUnionSummary(integer requestId, boolean success, string reason, string rankId, string rankDisplayName, integer unionCoins, integer lifetimeUnionGrowth, integer totalPoints, integer spentPoints, integer availablePoints, string appliedEffects)
        if self.IsWindowOpen == false or requestId ~= self.SnapshotRequestId then return end
        if success == false then self:SetStatus(self:LocalizeReason(reason)) return end
        self.CurrentSpentPoints = math.max(0, spentPoints)
        self:SetText(self.RankCodeText, self:BuildRankCode(rankId))
        self:SetText(self.RankNameText, rankDisplayName)
        self:SetText(self.GrowthText, self:FormatInteger(lifetimeUnionGrowth))
        self:SetText(self.CoinValueText, self:FormatInteger(unionCoins))
        self:SetText(self.TotalPointsText, self:FormatInteger(totalPoints))
        self:SetText(self.SpentPointsText, self:FormatInteger(spentPoints))
        self:SetText(self.AvailablePointsText, self:FormatInteger(availablePoints))
        self:SetText(self.PointStripText, "POINT   " .. self:FormatInteger(spentPoints) .. " / " .. self:FormatInteger(totalPoints))
        self:SetText(self.EffectsText, appliedEffects)
        if self.EffectsText ~= nil and isvalid(self.EffectsText.Entity) then
            local hasAppliedEffects = appliedEffects ~= nil and appliedEffects ~= "" and appliedEffects ~= "적용 중인 효과가 없습니다."
            self.EffectsText.HorizontalAlignment = hasAppliedEffects and 1 or 2
            self.EffectsText.VerticalAlignment = hasAppliedEffects and 256 or 512
        end
    end

    @ExecSpace("Client")
    method void ReceiveUnionStatRow(integer requestId, string statId, string category, string displayName, string description, integer currentLevel, integer maxLevel, number currentEffectValue, boolean isImplemented, string requiredUnionRank, string currentUnionRank, boolean isRankUnlocked, integer nextPointCost, boolean canIncrease, string increaseReason, integer sortOrder)
        if self.IsWindowOpen == false or requestId ~= self.SnapshotRequestId then return end
        self.StatRowsById[statId] = {
            StatId = statId, Category = category, DisplayName = displayName, Description = description,
            CurrentLevel = currentLevel, MaxLevel = maxLevel, CurrentEffectValue = currentEffectValue,
            IsImplemented = isImplemented, RequiredUnionRank = requiredUnionRank,
            CurrentUnionRank = currentUnionRank, IsRankUnlocked = isRankUnlocked,
            NextPointCost = nextPointCost, CanIncrease = canIncrease,
            IncreaseReason = increaseReason, SortOrder = sortOrder
        }
    end

    @ExecSpace("Client")
    method void ReceiveUnionJobRow(integer requestId, string jobId, integer progress, string gradeId, string gradeDisplayName, integer contribution)
        if self.IsWindowOpen == false or requestId ~= self.SnapshotRequestId then return end
        local resolvedGradeDisplayName = gradeDisplayName
        if (jobId == "warrior" or jobId == "mage" or jobId == "archer" or jobId == "thief" or jobId == "pirate") and (resolvedGradeDisplayName == nil or resolvedGradeDisplayName == "" or resolvedGradeDisplayName == "NONE") then
            resolvedGradeDisplayName = "-"
        end
        self:SetText(self.JobGradeTexts[jobId], resolvedGradeDisplayName)
        self:SetText(self.JobProgressTexts[jobId], "진행 " .. self:FormatInteger(progress))
        local contributionText = "+" .. self:FormatInteger(contribution) .. "P"
        self:SetText(self.JobContributionTexts[jobId], contributionText)
    end

    @ExecSpace("Client")
    method void ReceiveMutationResult(integer requestId, boolean success, string reason)
        if self.IsWindowOpen == false or requestId ~= self.SnapshotRequestId then return end
        self.LastMutationMessage = success and "변경이 저장되고 최신 유니온 정보로 갱신되었습니다." or self:LocalizeReason(reason)
    end

    @ExecSpace("Client")
    method void ReceiveUnionSnapshotComplete(integer requestId, boolean success, string reason, integer statCount, integer jobCount)
        if self.IsWindowOpen == false or requestId ~= self.SnapshotRequestId then return end
        self.IsRequestPending = false
        self:RefreshAllCards()
        if success == false then self:SetStatus(self:LocalizeReason(reason)) return end
        if self.LastMutationMessage ~= "" then
            self:SetStatus(self.LastMutationMessage)
        else
            self:SetStatus("최신 유니온 정보 · 스탯 " .. tostring(statCount) .. "개 · 직업 " .. tostring(jobCount) .. "개")
        end
    end

    method string BuildAppliedEffectsText(table effects)
        local lines = {}
        self:AppendPercentEffectLine(lines, "메소 획득", effects.MesoGainRate)
        self:AppendPercentEffectLine(lines, "아이템 드롭", effects.ItemDropRate)
        self:AppendPercentEffectLine(lines, "유니온 코인 획득", effects.UnionPointGainRate)
        self:AppendFlatEffectLine(lines, "최대 체력", effects.MaxHPBonus)
        self:AppendFlatEffectLine(lines, "시작 포션", effects.StartingPotionBonus)
        self:AppendFlatEffectLine(lines, "인벤토리 슬롯", effects.InventorySlotBonus)
        self:AppendFlatEffectLine(lines, "어그먼트 리롤", effects.AugmentRerollBonus)
        self:AppendFlatEffectLine(lines, "시작 스킬", effects.StartingSkillBonus)
        if #lines == 0 then return "적용 중인 효과가 없습니다." end
        return table.concat(lines, "\n")
    end

    method void AppendFlatEffectLine(table lines, string label, number value)
        local resolved = math.floor(tonumber(value) or 0)
        if resolved > 0 then table.insert(lines, label .. " +" .. tostring(resolved)) end
    end

    method void AppendPercentEffectLine(table lines, string label, number value)
        local resolved = math.floor((tonumber(value) or 0) * 100 + 0.5)
        if resolved > 0 then table.insert(lines, label .. " +" .. tostring(resolved) .. "%") end
    end

    @ExecSpace("ClientOnly")
    method void RefreshAllCards()
        for _, statId in ipairs(self.StatIds) do self:RenderStatCard(statId) end
        self:SetButtonEnabled(self.ResetButton, self.IsRequestPending == false and self.CurrentSpentPoints > 0)
    end

    @ExecSpace("ClientOnly")
    method void RenderStatCard(string statId)
        local row = self.StatRowsById[statId]
        local card = self.StatCards[statId]
        local button = self.StatIncreaseButtons[statId]
        if row == nil then
            self:SetText(self.StatLevelTexts[statId], "-  /  -")
            self:SetText(self.StatEffectTexts[statId], "—")
            self:SetText(self.StatCostTexts[statId], "다음 -")
            self:SetText(self.StatStatusTexts[statId], self.IsRequestPending and "처리 중" or "")
            if self.StatEffectTexts[statId] ~= nil and isvalid(self.StatEffectTexts[statId].Entity) then
                self.StatEffectTexts[statId].FontSize = 28
                self.StatEffectTexts[statId].FontStyle = 1
                self.StatEffectTexts[statId].FontColor = Color(0.95, 0.97, 0.98, 1)
                self.StatEffectTexts[statId].Underlay = true
            end
            if button ~= nil and isvalid(button.Entity) and button.Entity.TextGUIRendererComponent ~= nil then
                button.Entity.TextGUIRendererComponent.Text = "+"
                button.Entity.TextGUIRendererComponent.FontSize = 16
            end
            self:SetButtonEnabled(button, false)
            self:ApplyStatButtonVisual(button, false)
            if isvalid(card) and card.SpriteGUIRendererComponent ~= nil then
                card.SpriteGUIRendererComponent.Color = Color(0.24, 0.35, 0.43, 0.98)
                card.SpriteGUIRendererComponent.Outline = true
                card.SpriteGUIRendererComponent.OutlineColor = Color(0.15, 0.23, 0.28, 0.96)
                card.SpriteGUIRendererComponent.OutlineWidth = 1
            end
            return
        end

        local isRankLocked = row.IsRankUnlocked ~= true or row.IncreaseReason == "RANK_LOCKED"
        local isMaxLevel = row.CurrentLevel >= row.MaxLevel
        self:SetText(self.StatLevelTexts[statId], tostring(row.CurrentLevel) .. "  /  " .. tostring(row.MaxLevel))
        if isRankLocked then
            self:SetText(self.StatEffectTexts[statId], string.gsub(row.RequiredUnionRank or "UNION", "_", " ") .. " 필요")
            if self.StatEffectTexts[statId] ~= nil and isvalid(self.StatEffectTexts[statId].Entity) then
                self.StatEffectTexts[statId].FontSize = 18
                self.StatEffectTexts[statId].FontStyle = 1
                self.StatEffectTexts[statId].FontColor = Color(0.84, 0.89, 0.92, 1)
                self.StatEffectTexts[statId].Underlay = false
            end
        else
            self:SetText(self.StatEffectTexts[statId], self:FormatEffectValue(statId, row.CurrentEffectValue))
            if self.StatEffectTexts[statId] ~= nil and isvalid(self.StatEffectTexts[statId].Entity) then
                self.StatEffectTexts[statId].FontSize = 28
                self.StatEffectTexts[statId].FontStyle = 1
                self.StatEffectTexts[statId].FontColor = Color(0.96, 0.98, 0.99, 1)
                self.StatEffectTexts[statId].Underlay = true
            end
        end
        self:SetText(self.StatCostTexts[statId], row.CurrentLevel >= row.MaxLevel and "다음 MAX" or "다음 " .. tostring(row.NextPointCost) .. "P")
        self:SetText(self.StatStatusTexts[statId], self.IsRequestPending and "처리 중" or (isMaxLevel and "MAX" or (row.IsImplemented ~= true and "준비 중" or "")))

        local canIncrease = self.IsRequestPending == false and row.CanIncrease == true
        if button ~= nil and isvalid(button.Entity) and button.Entity.TextGUIRendererComponent ~= nil then
            button.Entity.TextGUIRendererComponent.Text = isMaxLevel and "MAX" or "+"
            button.Entity.TextGUIRendererComponent.FontSize = isMaxLevel and 11 or 16
        end
        self:SetButtonEnabled(button, canIncrease)
        self:ApplyStatButtonVisual(button, canIncrease)

        if isvalid(card) and card.SpriteGUIRendererComponent ~= nil then
            -- Keep all allocation tiles in the dark union-panel family while
            -- preserving subtle locked/max/selected state differences.
            if row.IsImplemented ~= true or isRankLocked then
                card.SpriteGUIRendererComponent.Color = Color(0.24, 0.35, 0.43, 0.98)
            elseif isMaxLevel then
                card.SpriteGUIRendererComponent.Color = Color(0.25, 0.42, 0.42, 0.98)
            else
                card.SpriteGUIRendererComponent.Color = Color(0.26, 0.38, 0.47, 0.99)
            end
            card.SpriteGUIRendererComponent.Outline = true
            if row.IsSelected == true then
                card.SpriteGUIRendererComponent.OutlineColor = Color(0.49, 0.73, 0.82, 1)
                card.SpriteGUIRendererComponent.OutlineWidth = 2
            else
                card.SpriteGUIRendererComponent.OutlineColor = Color(0.15, 0.23, 0.28, 0.96)
                card.SpriteGUIRendererComponent.OutlineWidth = 1
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void ApplyStatButtonVisual(ButtonComponent button, boolean enabled)
        if button == nil or isvalid(button.Entity) == false then return end
        if button.Entity.SpriteGUIRendererComponent ~= nil then
            button.Entity.SpriteGUIRendererComponent.Color = enabled and Color(0.20, 0.31, 0.38, 0.88) or Color(0.16, 0.24, 0.29, 0.62)
        end
        if button.Entity.TextGUIRendererComponent ~= nil then
            button.Entity.TextGUIRendererComponent.FontColor = enabled and Color(0.93, 0.96, 0.97, 1) or Color(0.58, 0.64, 0.67, 1)
        end
    end

    method string GetStatEffectLabel(string statId, string fallbackLabel)
        if statId == "UNION_COIN_GAIN_RATE" then return "코인 획득량" end
        if statId == "STARTING_POTION" then return "시작 물약" end
        if statId == "AUGMENT_REROLL" then return "증강 리롤" end
        return fallbackLabel or statId
    end

    method string FormatEffectValue(string statId, number value)
        if statId == "MESO_GAIN_RATE" or statId == "ITEM_DROP_RATE" or statId == "UNION_COIN_GAIN_RATE" then
            return "+" .. tostring(math.floor((tonumber(value) or 0) * 100 + 0.5)) .. "%"
        end
        return "+" .. tostring(math.floor(tonumber(value) or 0))
    end

    method string StatStateLabel(table row)
        if row.IsImplemented ~= true then return "준비 중" end
        if row.CurrentLevel >= row.MaxLevel then return "최대 레벨" end
        if row.IsRankUnlocked ~= true or row.IncreaseReason == "RANK_LOCKED" then return "잠김 · " .. (row.RequiredUnionRank or "등급 필요") end
        if row.IncreaseReason == "INSUFFICIENT_UNION_STAT_POINTS" then return "포인트 부족" end
        if row.CanIncrease == true then return "+ 배분 가능" end
        return self:LocalizeReason(row.IncreaseReason)
    end

    method string BuildRankCode(string rankId)
        if rankId == "UNION_V" then return "V" end
        if rankId == "UNION_IV" then return "IV" end
        if rankId == "UNION_III" then return "III" end
        if rankId == "UNION_II" then return "II" end
        return "I"
    end

    method string LocalizeReason(string reason)
        if reason == "OK" then return "완료되었습니다." end
        if reason == "STAT_NOT_IMPLEMENTED" then return "아직 구현되지 않은 유니온 스탯입니다." end
        if reason == "MAX_LEVEL" then return "이미 최대 레벨입니다." end
        if reason == "RANK_LOCKED" then return "필요 유니온 등급을 달성하지 못했습니다." end
        if reason == "INSUFFICIENT_UNION_STAT_POINTS" then return "사용 가능한 유니온 포인트가 부족합니다." end
        if reason == "UNION_STATS_ALREADY_RESET" then return "이미 모든 배분이 초기화되어 있습니다." end
        if reason == "INVALID_STAT_ID" or reason == "UNION_STAT_NOT_FOUND" then return "알 수 없는 유니온 스탯입니다." end
        if reason == "INVALID_ALLOCATION_REQUEST_ID" or reason == "ALLOCATION_REQUEST_ID_CONFLICT" then return "유효하지 않은 유니온 변경 요청입니다." end
        if reason == "PROFILE_MUTATION_IN_PROGRESS" or reason == "PROFILE_MUTATION_BUSY" or reason == "PROFILE_WRITE_CONFLICT" then return "다른 유니온 변경을 처리 중입니다." end
        if reason == "PLAYER_UNAVAILABLE" then return "플레이어 정보를 불러올 수 없습니다." end
        if reason == "STAT_DATA_UNAVAILABLE" then return "스탯 정보를 불러올 수 없습니다." end
        return reason or "UNKNOWN"
    end

    method string FormatInteger(integer value)
        local text = tostring(math.max(0, math.floor(tonumber(value) or 0)))
        local length = string.len(text)
        local parts = {}
        while length > 3 do
            table.insert(parts, 1, string.sub(text, length - 2, length))
            length = length - 3
        end
        table.insert(parts, 1, string.sub(text, 1, length))
        return table.concat(parts, ",")
    end

    @ExecSpace("ClientOnly")
    method boolean EnsureUiConnection()
        if self.IsUiConnected then return true end
        if #self.StatIds == 0 or #self.JobIds == 0 then self:InitializeIds() end
        self.UnionWindow = _EntityService:GetEntityByPath(self.WindowPath)
        if isvalid(self.UnionWindow) == false then return self:ReportBindingWait() end
        self.CloseButton = self:GetButton(self.FramePath .. "/HeaderBar/CloseButton")
        local summary = self.FramePath .. "/SummaryPanel"
        self.ResetButton = self:GetButton(summary .. "/ResetButton")
        self.RankCodeText = self:GetText(summary .. "/RankCard/RankCodeText")
        self.RankNameText = self:GetText(summary .. "/RankCard/RankNameText")
        self.GrowthText = self:GetText(summary .. "/RankCard/GrowthText")
        self.CoinValueText = self:GetText(summary .. "/CoinCard/CoinValueText")
        self.TotalPointsText = self:GetText(summary .. "/PointCard/TotalPointsText")
        self.SpentPointsText = self:GetText(summary .. "/PointCard/SpentPointsText")
        self.AvailablePointsText = self:GetText(summary .. "/PointCard/AvailablePointsText")
        self.EffectsText = self:GetText(summary .. "/EffectsCard/EffectsText")
        self.PointStripText = self:GetText(self.FramePath .. "/ActiveStatsPanel/FutureRelicCard/LabelText")
        self.StatusText = self:GetText(summary .. "/StatusText")
        if self.CloseButton == nil or self.ResetButton == nil or self.RankCodeText == nil or self.RankNameText == nil or self.GrowthText == nil or self.CoinValueText == nil or self.TotalPointsText == nil or self.SpentPointsText == nil or self.AvailablePointsText == nil or self.EffectsText == nil or self.PointStripText == nil or self.StatusText == nil then
            return self:ReportBindingWait()
        end
        self.StatCards = {}
        self.StatLevelTexts = {}
        self.StatEffectTexts = {}
        self.StatCostTexts = {}
        self.StatStatusTexts = {}
        self.StatIncreaseButtons = {}
        self.StatIncreaseHandlers = {}
        local active = self.FramePath .. "/ActiveStatsPanel"
        for _, statId in ipairs(self.StatIds) do
            local cardPath = active .. "/" .. statId .. "Card"
            local card = _EntityService:GetEntityByPath(cardPath)
            local button = self:GetButton(cardPath .. "/IncreaseButton")
            local levelText = self:GetText(cardPath .. "/LevelText")
            local effectText = self:GetText(cardPath .. "/EffectText")
            local costText = self:GetText(cardPath .. "/CostText")
            local statusText = self:GetText(cardPath .. "/StatusText")
            if isvalid(card) == false or button == nil or levelText == nil or effectText == nil or costText == nil or statusText == nil then return self:ReportBindingWait() end
            self.StatCards[statId] = card
            self.StatIncreaseButtons[statId] = button
            self.StatLevelTexts[statId] = levelText
            self.StatEffectTexts[statId] = effectText
            self.StatCostTexts[statId] = costText
            self.StatStatusTexts[statId] = statusText
            local capturedStatId = statId
            self.StatIncreaseHandlers[statId] = button.Entity:ConnectEvent(ButtonClickEvent, function() self:OnIncreaseClicked(capturedStatId) end)
        end
        self.JobGradeTexts = {}
        self.JobProgressTexts = {}
        self.JobContributionTexts = {}
        local jobs = self.FramePath .. "/JobGradePanel"
        for _, jobId in ipairs(self.JobIds) do
            local cardPath = jobs .. "/" .. jobId .. "Card"
            self.JobGradeTexts[jobId] = self:GetText(cardPath .. "/GradeText")
            self.JobProgressTexts[jobId] = self:GetText(cardPath .. "/ProgressText")
            self.JobContributionTexts[jobId] = self:GetText(cardPath .. "/ContributionText")
            if self.JobGradeTexts[jobId] == nil or self.JobProgressTexts[jobId] == nil or self.JobContributionTexts[jobId] == nil then return self:ReportBindingWait() end
        end
        self.UiHandlers.Close = self.CloseButton.Entity:ConnectEvent(ButtonClickEvent, self.OnCloseButtonClicked)
        self.UiHandlers.Reset = self.ResetButton.Entity:ConnectEvent(ButtonClickEvent, self.OnResetButtonClicked)
        self.IsUiConnected = true
        self.BindingWarningLogged = false
        self:SetWindowEnabled(self.IsWindowOpen)
        self:RefreshAllCards()
        log("[UnionUI2026] allocation UI ready")
        return true
    end

    @ExecSpace("ClientOnly")
    method void DisconnectUiEvents()
        self:DisconnectButtonEvent(self.CloseButton, self.UiHandlers.Close)
        self:DisconnectButtonEvent(self.ResetButton, self.UiHandlers.Reset)
        for statId, button in pairs(self.StatIncreaseButtons) do self:DisconnectButtonEvent(button, self.StatIncreaseHandlers[statId]) end
        self.UiHandlers = {}
        self.StatIncreaseHandlers = {}
        self.StatCards = {}
        self.StatLevelTexts = {}
        self.StatEffectTexts = {}
        self.StatCostTexts = {}
        self.StatStatusTexts = {}
        self.StatIncreaseButtons = {}
        self.JobGradeTexts = {}
        self.JobProgressTexts = {}
        self.JobContributionTexts = {}
        self.IsUiConnected = false
    end

    @ExecSpace("ClientOnly")
    method boolean ReportBindingWait()
        if self.BindingWarningLogged == false then
            self.BindingWarningLogged = true
            log_warning("[UnionUI2026] waiting for allocation UI bindings")
        end
        return false
    end

    @ExecSpace("ClientOnly")
    method ButtonComponent GetButton(string path)
        local entity = _EntityService:GetEntityByPath(path)
        return isvalid(entity) and entity.ButtonComponent or nil
    end

    @ExecSpace("ClientOnly")
    method TextGUIRendererComponent GetText(string path)
        local entity = _EntityService:GetEntityByPath(path)
        return isvalid(entity) and entity.TextGUIRendererComponent or nil
    end

    @ExecSpace("ClientOnly")
    method void DisconnectButtonEvent(ButtonComponent button, any handlerId)
        if button ~= nil and isvalid(button.Entity) and handlerId ~= nil then button.Entity:DisconnectEvent(ButtonClickEvent, handlerId) end
    end

    @ExecSpace("ClientOnly")
    method void SetButtonEnabled(ButtonComponent button, boolean enabled)
        if button ~= nil and isvalid(button.Entity) then button.Enable = enabled end
    end

    @ExecSpace("ClientOnly")
    method void SetWindowEnabled(boolean enabled)
        if isvalid(self.UnionWindow) then self.UnionWindow:SetEnable(enabled) end
    end

    @ExecSpace("ClientOnly")
    method void SetText(TextGUIRendererComponent renderer, string value)
        if renderer ~= nil and isvalid(renderer.Entity) then renderer.Text = value or "" end
    end

    @ExecSpace("ClientOnly")
    method void SetStatus(string value)
        self:SetText(self.StatusText, value)
    end

    @ExecSpace("ClientOnly")
    method boolean IsLocalPlayerInLobby()
        local player = _UserService.LocalPlayer
        return isvalid(player) and isvalid(player.CurrentMap) and player.CurrentMap.Name == "lobby"
    end

    @ExecSpace("ClientOnly")
    method boolean IsOtherLobbyPopupOpen()
        if _LobbyCharacterSelectionLogic:IsOpen() or _LobbyCodexLogic:IsOpen() then return true end
        local uiRoot = _EntityService:GetEntityByPath("/ui/DefaultGroup")
        if isvalid(uiRoot) then
            local minimapUI = uiRoot:GetComponent("script.MinimapUI")
            if minimapUI ~= nil and minimapUI:IsWorldMapOpen() then return true end
        end
        return false
    end

end
