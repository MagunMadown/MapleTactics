@Logic
script UnionSystemUILogic extends Logic

    property string WindowPath = "/ui/UnionSystemUI/UnionWindow"
    property string FramePath = "/ui/UnionSystemUI/UnionWindow/UnionFrame"
    property Entity UnionWindow = nil
    property Entity MajorConfirmationOverlay = nil
    property ButtonComponent CloseButton = nil
    property ButtonComponent RefreshButton = nil
    property ButtonComponent PurchaseButton = nil
    property ButtonComponent ConfirmPurchaseButton = nil
    property ButtonComponent CancelPurchaseButton = nil
    property TextGUIRendererComponent RankCodeText = nil
    property TextGUIRendererComponent RankNameText = nil
    property TextGUIRendererComponent CurrentPointsText = nil
    property TextGUIRendererComponent LifetimePointsText = nil
    property TextGUIRendererComponent BoardTierText = nil
    property TextGUIRendererComponent AppliedEffectsText = nil
    property TextGUIRendererComponent LoadStatusText = nil
    property TextGUIRendererComponent SelectedNameText = nil
    property TextGUIRendererComponent SelectedStateText = nil
    property TextGUIRendererComponent SelectedDescriptionText = nil
    property TextGUIRendererComponent SelectedLevelsText = nil
    property TextGUIRendererComponent CurrentEffectText = nil
    property TextGUIRendererComponent NextEffectText = nil
    property TextGUIRendererComponent NextCostText = nil
    property TextGUIRendererComponent RequiredRankText = nil
    property TextGUIRendererComponent PrerequisiteText = nil
    property TextGUIRendererComponent CoreRankText = nil
    property TextGUIRendererComponent PurchaseButtonText = nil
    property TextGUIRendererComponent ConfirmationMessageText = nil
    property TextGUIRendererComponent ConfirmationCostText = nil
    property Entity BlockShopPanel = nil
    property ButtonComponent BlockShopButton = nil
    property ButtonComponent ShopCloseButton = nil
    property ButtonComponent ShopPurchaseButton = nil
    property TextGUIRendererComponent ShopCurrencyText = nil
    property TextGUIRendererComponent ShopBlockNameText = nil
    property TextGUIRendererComponent ShopOwnedText = nil
    property TextGUIRendererComponent ShopRequiredRankText = nil
    property TextGUIRendererComponent ShopPriceText = nil
    property TextGUIRendererComponent ShopStatusText = nil
    property TextGUIRendererComponent ShopPurchaseButtonText = nil
    property table ShopPreviewCells = {}
    property table UpgradeNodePaths = {}
    property table UpgradeNodeEntities = {}
    property table UpgradeLabelEntities = {}
    property table UpgradeCellPaths = {}
    property table UpgradeCellEntities = {}
    property table UpgradeNodeHandlers = {}
    property table UpgradeRowsById = {}
    property table UiHandlers = {}
    property string SelectedUpgradeId = ""
    property string PendingMajorUpgradeId = ""
    property string LastMutationMessage = ""
    property boolean IsUiConnected = false
    property boolean IsWindowOpen = false
    property boolean IsRequestPending = false
    property boolean BindingWarningLogged = false
    property integer SnapshotRequestId = 0
    property integer CurrentBoardTier = 1
    property string CurrentRankDisplayName = "UNION I"
    property integer CurrentLifetimeUnionPoints = 0
    property string NextRankDisplayName = "UNION II"
    property integer NextRankThreshold = 1000
    property integer NextRankBoardTier = 2
    property boolean PurchaseFeedbackPending = false
    property integer PurchaseFeedbackTimerId = 0
    property boolean IsBlockShopOpen = false
    property boolean IsBlockShopRequestPending = false
    property integer BlockShopRequestId = 0
    property string ShopBlockId = ""
    property string ShopPurchaseRequestId = ""
    property boolean ShopCanPurchase = false

    @ExecSpace("ClientOnly")
    @EventSender("Service", "InputService")
    handler HandleUnionKeyDown(KeyDownEvent event)
        if self.IsWindowOpen == false or event.key ~= KeyboardKey.Escape then return end
        if self.IsBlockShopOpen then self:CloseBlockShop() return end
        if self.PendingMajorUpgradeId ~= "" then self:HideMajorConfirmation() return end
        self:CloseWindow()
    end

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self:InitializeUpgradeNodePaths()
        self:InitializeUpgradeCellPaths()
        self:EnsureUiConnection()
        self:SetWindowEnabled(false)
        log("[UnionUI] NPC-entry Union Battle Map territory UI ready")
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        if self.IsUiConnected == false then self:EnsureUiConnection() end
        if self.IsWindowOpen and self:IsLocalPlayerInLobby() == false then self:CloseWindow() return end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        if self.PurchaseFeedbackTimerId > 0 then _TimerService:ClearTimer(self.PurchaseFeedbackTimerId) self.PurchaseFeedbackTimerId = 0 end
        self:DisconnectUiEvents()
        self.IsWindowOpen = false
        self.IsRequestPending = false
        self.IsBlockShopOpen = false
        self.IsBlockShopRequestPending = false
    end

    @ExecSpace("ClientOnly")
    method void InitializeUpgradeNodePaths()
        local grid = self.FramePath .. "/BoardPanel/BoardGridFrame"
        self.UpgradeNodePaths = {
            MESO_GAIN_RATE = grid .. "/GrowthRegion/MesoGainNode",
            ITEM_DROP_RATE = grid .. "/GrowthRegion/ItemDropNode",
            UNION_POINT_GAIN_RATE = grid .. "/GrowthRegion/UnionPointNode",
            MAX_HP = grid .. "/CombatRegion/MaxHpNode",
            STARTING_POTION = grid .. "/CombatRegion/StartingPotionNode",
            INVENTORY_SLOT = grid .. "/ExplorationRegion/InventorySlotNode",
            STARTING_RANDOM_RELIC = grid .. "/ExplorationRegion/RandomRelicNode",
            AUGMENT_REROLL = grid .. "/TacticsRegion/AugmentRerollNode",
            STARTING_SKILL = grid .. "/TacticsRegion/StartingSkillNode"
        }
    end

    @ExecSpace("ClientOnly")
    method void InitializeUpgradeCellPaths()
        -- Each list is ordered from the Union Core toward the outer territory; purchased level fills this order.
        local layer = self.FramePath .. "/BoardPanel/BoardGridFrame/GridCellLayer"
        self.UpgradeCellPaths = {
            MESO_GAIN_RATE = { layer .. "/Cell_03_06", layer .. "/Cell_02_07", layer .. "/Cell_01_10", layer .. "/Cell_01_03", layer .. "/Cell_01_04" },
            ITEM_DROP_RATE = { layer .. "/Cell_03_04", layer .. "/Cell_02_05", layer .. "/Cell_01_08", layer .. "/Cell_01_01", layer .. "/Cell_01_07" },
            UNION_POINT_GAIN_RATE = { layer .. "/Cell_03_08", layer .. "/Cell_02_10", layer .. "/Cell_02_02" },
            MAX_HP = { layer .. "/Cell_04_05", layer .. "/Cell_04_04", layer .. "/Cell_04_03" },
            STARTING_POTION = { layer .. "/Cell_05_03", layer .. "/Cell_05_02" },
            INVENTORY_SLOT = { layer .. "/Cell_04_08", layer .. "/Cell_04_09", layer .. "/Cell_04_10" },
            STARTING_RANDOM_RELIC = { layer .. "/Cell_06_12" },
            AUGMENT_REROLL = { layer .. "/Cell_06_06", layer .. "/Cell_07_04" },
            STARTING_SKILL = { layer .. "/Cell_08_12" }
        }
    end

    @ExecSpace("ClientOnly")
    method void OnCloseButtonClicked()
        self:CloseWindow()
    end

    @ExecSpace("ClientOnly")
    method void OnRefreshButtonClicked()
        self:RefreshSnapshot()
    end

    @ExecSpace("ClientOnly")
    method void OnPurchaseClicked()
        if self.IsRequestPending then return end
        local row = self.UpgradeRowsById[self.SelectedUpgradeId]
        if row == nil or row.CanPurchase ~= true then
            self:SetText(self.LoadStatusText, self:LocalizeReason(row ~= nil and row.PurchaseReason or "UPGRADE_DATA_UNAVAILABLE"))
            return
        end
        if row.IsMajor == true then self:ShowMajorConfirmation(row) return end
        self:SubmitPurchaseRequest(row.UpgradeId)
    end

    @ExecSpace("ClientOnly")
    method void OnConfirmPurchaseClicked()
        local upgradeId = self.PendingMajorUpgradeId
        self:HideMajorConfirmation()
        if upgradeId ~= "" then self:SubmitPurchaseRequest(upgradeId) end
    end

    @ExecSpace("ClientOnly")
    method void OnCancelPurchaseClicked()
        self:HideMajorConfirmation()
    end

    @ExecSpace("ClientOnly")
    method void OnBlockShopButtonClicked()
        self:OpenBlockShop()
    end

    @ExecSpace("ClientOnly")
    method void OnShopCloseButtonClicked()
        self:CloseBlockShop()
    end

    @ExecSpace("ClientOnly")
    method void OnShopPurchaseButtonClicked()
        if self.IsBlockShopRequestPending then return end
        if self.ShopCanPurchase == false or self.ShopBlockId == "" or self.ShopPurchaseRequestId == "" then
            self:SetText(self.ShopStatusText, self:LocalizeReason("BLOCK_PURCHASE_UNAVAILABLE"))
            return
        end
        self.IsBlockShopRequestPending = true
        self.BlockShopRequestId = self.BlockShopRequestId + 1
        self:SetButtonEnabled(self.ShopPurchaseButton, false)
        self:SetText(self.ShopStatusText, "구매 처리 중...")
        self:RequestPurchaseUnionBlock(self.ShopBlockId, self.ShopPurchaseRequestId, self.BlockShopRequestId)
    end

    @ExecSpace("ClientOnly")
    method void OpenBlockShop()
        if self.IsWindowOpen == false or self.IsBlockShopOpen then return end
        self.IsBlockShopOpen = true
        if isvalid(self.BlockShopPanel) then self.BlockShopPanel:SetEnable(true) end
        self:RefreshBlockShop()
        log("[UnionBlockShopUI] opened")
    end

    @ExecSpace("ClientOnly")
    method void CloseBlockShop()
        self.IsBlockShopOpen = false
        self.IsBlockShopRequestPending = false
        self.BlockShopRequestId = self.BlockShopRequestId + 1
        if isvalid(self.BlockShopPanel) then self.BlockShopPanel:SetEnable(false) end
    end

    @ExecSpace("ClientOnly")
    method void RefreshBlockShop()
        if self.IsWindowOpen == false or self.IsBlockShopOpen == false or self.IsBlockShopRequestPending then return end
        self.IsBlockShopRequestPending = true
        self.BlockShopRequestId = self.BlockShopRequestId + 1
        self.ShopBlockId = ""
        self.ShopPurchaseRequestId = ""
        self.ShopCanPurchase = false
        self:SetButtonEnabled(self.ShopPurchaseButton, false)
        self:SetText(self.ShopStatusText, "상점 정보를 불러오는 중입니다.")
        self:RequestUnionBlockShopSnapshot(self.BlockShopRequestId)
    end

    @ExecSpace("ClientOnly")
    method boolean OpenWindow()
        if self.IsWindowOpen then return false end
        if self:IsLocalPlayerInLobby() == false or self:IsOtherLobbyPopupOpen() then
            log("[UnionUI] open rejected reason=LOBBY_NAVIGATION_BUSY")
            return false
        end
        if self:EnsureUiConnection() == false then log_error("[UnionUI] open failed reason=UI_BINDING_MISSING") return false end
        self.IsWindowOpen = true
        self.SelectedUpgradeId = ""
        self:SetWindowEnabled(true)
        self:CloseBlockShop()
        self:HideMajorConfirmation()
        self:RefreshSnapshot()
        log("[UnionUI] opened")
        return true
    end

    @ExecSpace("ClientOnly")
    method void CloseWindow()
        if self.IsWindowOpen == false then return end
        self.IsWindowOpen = false
        self.IsRequestPending = false
        self.SnapshotRequestId = self.SnapshotRequestId + 1
        self:CloseBlockShop()
        self:HideMajorConfirmation()
        self:SetWindowEnabled(false)
        self:SetRefreshEnabled(true)
        log("[UnionUI] closed")
    end

    @ExecSpace("ClientOnly")
    method boolean IsOpen()
        return self.IsWindowOpen
    end

    @ExecSpace("ClientOnly")
    method void RefreshSnapshot()
        if self.IsWindowOpen == false or self.IsRequestPending then return end
        self:BeginAuthoritativeRequest("데이터를 불러오는 중...")
        self:RequestUnionSnapshot(self.SnapshotRequestId)
    end

    @ExecSpace("ClientOnly")
    method void BeginAuthoritativeRequest(string statusText)
        self.IsRequestPending = true
        self.SnapshotRequestId = self.SnapshotRequestId + 1
        self.UpgradeRowsById = {}
        self.LastMutationMessage = ""
        self:SetRefreshEnabled(false)
        self:SetText(self.LoadStatusText, statusText)
        self:RefreshDetailPanel()
    end

    @ExecSpace("ClientOnly")
    method void SubmitPurchaseRequest(string upgradeId)
        -- Client sends only UpgradeId; price and resulting level stay server-owned.
        if upgradeId == nil or upgradeId == "" or self.IsRequestPending then return end
        self:BeginAuthoritativeRequest("구매 처리 중...")
        self:RequestPurchaseUpgrade(upgradeId, self.SnapshotRequestId)
    end

    @ExecSpace("Server")
    method void RequestUnionSnapshot(integer requestId)
        self:SendAuthoritativeSnapshot(requestId, senderUserId)
    end

    @ExecSpace("Server")
    method void RequestPurchaseUpgrade(string upgradeId, integer requestId)
        local userEntity = _UserService:GetUserEntityByUserId(senderUserId)
        if isvalid(userEntity) == false or userEntity.PlayerComponent == nil then
            self:ReceiveUnionMutationResult(requestId, false, "PLAYER_UNAVAILABLE", senderUserId)
            self:SendAuthoritativeSnapshot(requestId, senderUserId)
            return
        end
        local result = _UnionProfileRepositoryLogic:TryPurchaseUpgrade(userEntity, upgradeId or "")
        self:ReceiveUnionMutationResult(requestId, result.Success == true, result.Reason or "UNKNOWN", senderUserId)
        self:SendAuthoritativeSnapshot(requestId, senderUserId)
        log("[UnionUI] purchase user=" .. senderUserId .. " id=" .. (upgradeId or "") .. " success=" .. tostring(result.Success) .. " reason=" .. (result.Reason or "UNKNOWN"))
    end

    @ExecSpace("Server")
    method void RequestUnionBlockShopSnapshot(integer requestId)
        self:SendBlockShopSnapshot(requestId, senderUserId)
    end

    @ExecSpace("Server")
    method void RequestPurchaseUnionBlock(string blockId, string purchaseRequestId, integer requestId)
        local userEntity = _UserService:GetUserEntityByUserId(senderUserId)
        if isvalid(userEntity) == false or userEntity.PlayerComponent == nil then
            self:ReceiveUnionBlockPurchaseResult(requestId, false, "PLAYER_UNAVAILABLE", false, senderUserId)
            self:SendBlockShopSnapshot(requestId, senderUserId)
            return
        end
        local result = _UnionBlockShopServiceLogic:TryPurchaseUnionBlock(userEntity, blockId or "", purchaseRequestId or "")
        self:ReceiveUnionBlockPurchaseResult(requestId, result.Success == true, result.Reason or "UNKNOWN", result.WasDuplicate == true, senderUserId)
        self:SendBlockShopSnapshot(requestId, senderUserId)
        log("[UnionBlockShopUI] purchase user=" .. senderUserId .. " blockId=" .. (blockId or "") .. " success=" .. tostring(result.Success) .. " reason=" .. (result.Reason or "UNKNOWN"))
    end

    @ExecSpace("ServerOnly")
    method void SendBlockShopSnapshot(integer requestId, string recipientUserId)
        local userEntity = _UserService:GetUserEntityByUserId(recipientUserId)
        if isvalid(userEntity) == false or userEntity.PlayerComponent == nil then
            self:ReceiveUnionBlockShopSnapshot(requestId, false, "PLAYER_UNAVAILABLE", 0, "", "", "", "", "", 0, "", 0, 0, false, "PLAYER_UNAVAILABLE", recipientUserId)
            return
        end
        local snapshot = _UnionBlockShopServiceLogic:GetUnionBlockShopSnapshot(userEntity)
        if snapshot.Success == false or snapshot.BlockCount <= 0 then
            self:ReceiveUnionBlockShopSnapshot(requestId, false, snapshot.Reason or "BLOCK_SHOP_UNAVAILABLE", snapshot.UnionPoints or 0, snapshot.CurrentUnionRank or "", snapshot.PurchaseRequestId or "", "", "", "", 0, "", 0, 0, false, snapshot.Reason or "BLOCK_SHOP_UNAVAILABLE", recipientUserId)
            return
        end
        local row = snapshot.Blocks[1]
        self:ReceiveUnionBlockShopSnapshot(requestId, true, "OK", snapshot.UnionPoints, snapshot.CurrentUnionRank, snapshot.PurchaseRequestId, row.BlockId, row.DisplayName, row.ShapeCells, row.ShopCost, row.RequiredUnionRank, row.MaxOwned, row.OwnedQuantity, row.CanPurchase, row.PurchaseReason, recipientUserId)
    end

    @ExecSpace("Client")
    method void ReceiveUnionBlockPurchaseResult(integer requestId, boolean success, string reason, boolean wasDuplicate)
        if requestId ~= self.BlockShopRequestId or self.IsBlockShopOpen == false then return end
        if success then
            self:SetText(self.ShopStatusText, wasDuplicate and "이미 처리된 구매 요청입니다." or "블록을 구매했습니다.")
        else
            self:SetText(self.ShopStatusText, self:LocalizeReason(reason))
        end
    end

    @ExecSpace("Client")
    method void ReceiveUnionBlockShopSnapshot(integer requestId, boolean success, string reason, integer unionPoints, string currentRank, string purchaseRequestId, string blockId, string displayName, string shapeCells, integer shopCost, string requiredRank, integer maxOwned, integer ownedQuantity, boolean canPurchase, string purchaseReason)
        if requestId ~= self.BlockShopRequestId or self.IsBlockShopOpen == false then return end
        self.IsBlockShopRequestPending = false
        if success == false then
            self.ShopBlockId = ""
            self.ShopPurchaseRequestId = ""
            self.ShopCanPurchase = false
            self:SetButtonEnabled(self.ShopPurchaseButton, false)
            self:SetText(self.ShopStatusText, self:LocalizeReason(reason))
            return
        end
        self.ShopBlockId = blockId
        self.ShopPurchaseRequestId = purchaseRequestId
        self.ShopCanPurchase = canPurchase
        self:SetText(self.ShopCurrencyText, "유니온 코인 " .. tostring(unionPoints))
        self:SetText(self.ShopBlockNameText, displayName)
        self:SetText(self.ShopOwnedText, "보유 " .. tostring(ownedQuantity) .. " / " .. tostring(maxOwned))
        self:SetText(self.ShopRequiredRankText, "필요 등급 " .. requiredRank)
        self:SetText(self.ShopPriceText, "가격 " .. tostring(shopCost) .. " 유니온 코인")
        self:RenderShopShapePreview(shapeCells)
        self:SetButtonEnabled(self.ShopPurchaseButton, canPurchase)
        if ownedQuantity >= maxOwned then
            self:SetText(self.ShopPurchaseButtonText, "구매 완료")
            self:SetText(self.ShopStatusText, "최대 보유 수량에 도달했습니다.")
        elseif purchaseReason == "INSUFFICIENT_UNION_COIN" then
            self:SetText(self.ShopPurchaseButtonText, "코인 부족")
            self:SetText(self.ShopStatusText, "유니온 코인이 부족합니다.")
        elseif purchaseReason == "UNION_RANK_LOCKED" then
            self:SetText(self.ShopPurchaseButtonText, "등급 잠김")
            self:SetText(self.ShopStatusText, "필요 유니온 등급을 달성하지 못했습니다.")
        else
            self:SetText(self.ShopPurchaseButtonText, "구매")
            self:SetText(self.ShopStatusText, "구매할 수 있습니다.")
        end
        log("[UnionBlockShopUI] snapshot blockId=" .. blockId .. " owned=" .. tostring(ownedQuantity) .. "/" .. tostring(maxOwned) .. " coin=" .. tostring(unionPoints) .. " rank=" .. currentRank)
    end

    @ExecSpace("ClientOnly")
    method void RenderShopShapePreview(string shapeCells)
        -- Positions generic preview cells only from the normalized shape-repository payload.
        local parsedCells = {}
        local minX = nil
        local maxX = nil
        local minY = nil
        local maxY = nil
        for xToken, yToken in string.gmatch(shapeCells or "", "(-?%d+):(-?%d+)") do
            local x = tonumber(xToken)
            local y = tonumber(yToken)
            if x ~= nil and y ~= nil then
                table.insert(parsedCells, { X = x, Y = y })
                if minX == nil or x < minX then minX = x end
                if maxX == nil or x > maxX then maxX = x end
                if minY == nil or y < minY then minY = y end
                if maxY == nil or y > maxY then maxY = y end
            end
        end
        local centerX = minX ~= nil and (minX + maxX) * 0.5 or 0
        local centerY = minY ~= nil and (minY + maxY) * 0.5 or 0
        for index, cellEntity in ipairs(self.ShopPreviewCells) do
            local cell = parsedCells[index]
            if isvalid(cellEntity) and cell ~= nil then
                cellEntity:SetEnable(true)
                cellEntity.UITransformComponent.anchoredPosition = Vector2((cell.X - centerX) * 64, (centerY - cell.Y) * 64)
            elseif isvalid(cellEntity) then
                cellEntity:SetEnable(false)
            end
        end
    end

    @ExecSpace("ServerOnly")
    method void SendAuthoritativeSnapshot(integer requestId, string recipientUserId)
        local userEntity = _UserService:GetUserEntityByUserId(recipientUserId)
        if isvalid(userEntity) == false or userEntity.PlayerComponent == nil then self:SendUnionSnapshotFailure(requestId, "PLAYER_UNAVAILABLE", recipientUserId) return end
        local profileResult = _UnionProfileRepositoryLogic:GetUnionSnapshot(userEntity)
        local effectResult = _UnionEffectResolverLogic:GetEffectSnapshot(userEntity)
        local definitionResult = _UnionUpgradeDefinitionRepositoryLogic:GetAllDefinitions()
        if profileResult.Success == false or type(profileResult.Snapshot) ~= "table" then self:SendUnionSnapshotFailure(requestId, profileResult.Reason or "UNION_PROFILE_UNAVAILABLE", recipientUserId) return end
        if effectResult.Success == false or type(effectResult.EffectSnapshot) ~= "table" then self:SendUnionSnapshotFailure(requestId, effectResult.Reason or "UNION_EFFECT_UNAVAILABLE", recipientUserId) return end
        if definitionResult.Success == false then self:SendUnionSnapshotFailure(requestId, definitionResult.Reason or "UNION_DEFINITIONS_UNAVAILABLE", recipientUserId) return end
        local profile = profileResult.Snapshot
        local effects = effectResult.EffectSnapshot
        local boardTier = math.floor(tonumber(effects.UnlockedBoardTier) or 1)
        local boardRankNames = self:BuildBoardTierRankNames()
        local lifetimeUnionPoints = math.floor(tonumber(profile.LifetimeUnionPoints) or 0)
        local nextRank = self:ResolveNextRankProgress(lifetimeUnionPoints)
        self:ReceiveUnionSnapshot(requestId, true, "OK", self:BuildRankCode(effects.RankId or "UNION_I"), effects.RankDisplayName or "UNION I", math.floor(tonumber(profile.UnionPoints) or 0), lifetimeUnionPoints, boardTier, self:BuildAppliedEffectsText(effects), boardRankNames.Growth, boardRankNames.CombatExploration, boardRankNames.Tactics, boardRankNames.Major, nextRank.DisplayName, nextRank.Threshold, nextRank.BoardTier, recipientUserId)
        self:SendUpgradeRows(requestId, userEntity, profile, definitionResult.Definitions, recipientUserId)
        self:ReceiveUnionUpgradeRowsComplete(requestId, true, "OK", #definitionResult.Definitions, recipientUserId)
        log("[UnionUI] snapshot user=" .. recipientUserId .. " upgrades=" .. #definitionResult.Definitions .. " boardTier=" .. tostring(boardTier))
    end

    @ExecSpace("ServerOnly")
    method void SendUpgradeRows(integer requestId, Entity userEntity, table profile, table definitions, string recipientUserId)
        for _, definition in ipairs(definitions or {}) do
            local upgradeId = definition.UpgradeId
            local purchasedLevel = math.floor(tonumber(profile.PurchasedLevels[upgradeId]) or 0)
            local purchaseCheck = _UnionProfileRepositoryLogic:CanPurchaseUpgrade(userEntity, upgradeId)
            local currentEffectText = "-"
            local currentLevelDefinition = nil
            if purchasedLevel > 0 then
                local currentDefinition = _UnionUpgradeDefinitionRepositoryLogic:GetLevelDefinition(upgradeId, purchasedLevel)
                if currentDefinition.Success == true then currentLevelDefinition = currentDefinition currentEffectText = self:FormatEffectText(definition.EffectType, currentDefinition.EffectValue) end
            end
            local nextEffectText = "MAX LEVEL"
            local nextCost = 0
            local requiredRankId = ""
            local requiredRankDisplayName = ""
            local requiredBoardTier = 0
            local requiredUpgradeId = ""
            local requiredUpgradeDisplayName = ""
            local requiredUpgradeLevel = 0
            if purchasedLevel < definition.MaxLevel then
                local nextDefinition = _UnionUpgradeDefinitionRepositoryLogic:GetLevelDefinition(upgradeId, purchasedLevel + 1)
                if nextDefinition.Success == true then
                    nextEffectText = self:FormatEffectText(definition.EffectType, nextDefinition.EffectValue)
                    nextCost = nextDefinition.Cost
                    requiredRankId = nextDefinition.RequiredUnionRank or ""
                    requiredUpgradeId = nextDefinition.RequiredUpgradeId or ""
                    requiredUpgradeLevel = math.floor(tonumber(nextDefinition.RequiredUpgradeLevel) or 0)
                    local rankDefinition = _UnionRankDefinitionRepositoryLogic:GetDefinition(requiredRankId)
                    if rankDefinition.Success == true then requiredRankDisplayName = rankDefinition.DisplayName requiredBoardTier = rankDefinition.UnlockedBoardTier end
                    if requiredUpgradeId ~= "" then
                        local prerequisiteDefinition = _UnionUpgradeDefinitionRepositoryLogic:GetDefinition(requiredUpgradeId)
                        requiredUpgradeDisplayName = prerequisiteDefinition.Success == true and prerequisiteDefinition.DisplayName or requiredUpgradeId
                    end
                else
                    nextEffectText = "정의 오류"
                end
            end
            if purchasedLevel >= definition.MaxLevel and currentLevelDefinition ~= nil then
                requiredRankId = currentLevelDefinition.RequiredUnionRank or ""
                requiredUpgradeId = currentLevelDefinition.RequiredUpgradeId or ""
                requiredUpgradeLevel = math.floor(tonumber(currentLevelDefinition.RequiredUpgradeLevel) or 0)
                local rankDefinition = _UnionRankDefinitionRepositoryLogic:GetDefinition(requiredRankId)
                if rankDefinition.Success == true then requiredRankDisplayName = rankDefinition.DisplayName requiredBoardTier = rankDefinition.UnlockedBoardTier end
                if requiredUpgradeId ~= "" then
                    local prerequisiteDefinition = _UnionUpgradeDefinitionRepositoryLogic:GetDefinition(requiredUpgradeId)
                    requiredUpgradeDisplayName = prerequisiteDefinition.Success == true and prerequisiteDefinition.DisplayName or requiredUpgradeId
                end
            end
            local visualState = self:ResolveVisualState(purchasedLevel, definition.MaxLevel, purchaseCheck)
            local levelBoardTiers = self:BuildLevelBoardTierText(upgradeId, definition.MaxLevel)
            self:ReceiveUnionUpgradeRow(requestId, upgradeId, definition.DisplayName, definition.Description, definition.EffectType, definition.MaxLevel, definition.IsMajor == true, purchasedLevel, visualState, currentEffectText, nextEffectText, nextCost, purchaseCheck.CanPurchase == true, purchaseCheck.Reason or "UNKNOWN", requiredRankId, requiredRankDisplayName, requiredBoardTier, requiredUpgradeId, requiredUpgradeDisplayName, requiredUpgradeLevel, levelBoardTiers, recipientUserId)
        end
    end

    @ExecSpace("ServerOnly")
    method string BuildLevelBoardTierText(string upgradeId, integer maxLevel)
        -- Resolve every visible path cell from server-owned level and rank definitions.
        local tiers = {}
        for level = 1, math.max(0, maxLevel) do
            local levelResult = _UnionUpgradeDefinitionRepositoryLogic:GetLevelDefinition(upgradeId, level)
            local tier = 1
            if levelResult.Success == true then
                local rankResult = _UnionRankDefinitionRepositoryLogic:GetDefinition(levelResult.RequiredUnionRank or "")
                if rankResult.Success == true then tier = math.max(1, math.floor(tonumber(rankResult.UnlockedBoardTier) or 1)) end
            end
            table.insert(tiers, tostring(tier))
        end
        return table.concat(tiers, ",")
    end

    @ExecSpace("ServerOnly")
    method string ResolveVisualState(integer purchasedLevel, integer maxLevel, table purchaseCheck)
        if purchasedLevel >= maxLevel then return "MAX_LEVEL" end
        local reason = purchaseCheck.Reason or "UNKNOWN"
        if reason == "UNION_RANK_LOCKED" then return "RANK_LOCKED" end
        if reason == "UNION_PREREQUISITE_LOCKED" then return "PREREQUISITE_LOCKED" end
        if reason == "INSUFFICIENT_UNION_POINTS" then return "INSUFFICIENT_POINTS" end
        if purchasedLevel > 0 then return "PURCHASED" end
        return "AVAILABLE"
    end

    @ExecSpace("ServerOnly")
    method table BuildBoardTierRankNames()
        local names = { Growth = "", CombatExploration = "", Tactics = "", Major = "" }
        local rankResult = _UnionRankDefinitionRepositoryLogic:GetAllDefinitions()
        if rankResult.Success == false then return names end
        for _, rank in ipairs(rankResult.Definitions or {}) do
            local tier = math.floor(tonumber(rank.UnlockedBoardTier) or 0)
            if tier == 2 then names.Growth = rank.DisplayName or rank.RankId end
            if tier == 3 then names.CombatExploration = rank.DisplayName or rank.RankId end
            if tier == 4 then names.Tactics = rank.DisplayName or rank.RankId end
            if tier == 5 then names.Major = rank.DisplayName or rank.RankId end
        end
        return names
    end

    @ExecSpace("ServerOnly")
    method table ResolveNextRankProgress(integer lifetimeUnionPoints)
        -- Find the first higher threshold so the default panel can show the next board expansion.
        local result = { DisplayName = "최고 등급", Threshold = 0, BoardTier = 5 }
        local rankResult = _UnionRankDefinitionRepositoryLogic:GetAllDefinitions()
        if rankResult.Success == false then return result end
        for _, rank in ipairs(rankResult.Definitions or {}) do
            local threshold = math.max(0, math.floor(tonumber(rank.MinLifetimeUnionPoints) or 0))
            if threshold > lifetimeUnionPoints then
                result.DisplayName = rank.DisplayName or rank.RankId or "다음 등급"
                result.Threshold = threshold
                result.BoardTier = math.max(1, math.floor(tonumber(rank.UnlockedBoardTier) or 1))
                return result
            end
        end
        return result
    end

    @ExecSpace("ServerOnly")
    method string FormatEffectText(string effectType, number effectValue)
        if effectType == "MESO_GAIN_RATE" or effectType == "ITEM_DROP_RATE" or effectType == "UNION_POINT_GAIN_RATE" then return "+" .. tostring(math.floor(effectValue * 100 + 0.5)) .. "%" end
        return "+" .. tostring(math.floor(effectValue + 0.5))
    end

    @ExecSpace("ServerOnly")
    method void SendUnionSnapshotFailure(integer requestId, string reason, string recipientUserId)
        self:ReceiveUnionSnapshot(requestId, false, reason or "UNKNOWN", "-", "유니온 정보 없음", 0, 0, 1, "적용 효과를 불러오지 못했습니다.", "", "", "", "", "", 0, 1, recipientUserId)
        self:ReceiveUnionUpgradeRowsComplete(requestId, false, reason or "UNKNOWN", 0, recipientUserId)
    end

    @ExecSpace("Client")
    method void ReceiveUnionSnapshot(integer requestId, boolean success, string reason, string rankCode, string rankDisplayName, integer unionPoints, integer lifetimeUnionPoints, integer boardTier, string appliedEffects, string growthRankName, string combatExplorationRankName, string tacticsRankName, string majorRankName, string nextRankDisplayName, integer nextRankThreshold, integer nextRankBoardTier)
        if self.IsWindowOpen == false or requestId ~= self.SnapshotRequestId then return end
        if success == false then self:SetText(self.LoadStatusText, self:LocalizeReason(reason)) return end
        self.CurrentBoardTier = math.max(1, boardTier)
        self.CurrentRankDisplayName = rankDisplayName
        self.CurrentLifetimeUnionPoints = math.max(0, lifetimeUnionPoints)
        self.NextRankDisplayName = nextRankDisplayName or ""
        self.NextRankThreshold = math.max(0, nextRankThreshold)
        self.NextRankBoardTier = math.max(1, nextRankBoardTier)
        self:SetText(self.RankCodeText, rankCode)
        self:SetText(self.RankNameText, rankDisplayName)
        self:SetText(self.CurrentPointsText, self:FormatInteger(unionPoints))
        self:SetText(self.LifetimePointsText, "누적 유니온 포인트  " .. self:FormatInteger(lifetimeUnionPoints))
        self:SetText(self.BoardTierText, "BOARD TIER " .. tostring(self.CurrentBoardTier) .. " / 5")
        self:SetText(self.AppliedEffectsText, appliedEffects)
        self:SetText(self.CoreRankText, rankDisplayName)
        self:ApplyBoardTierVisuals(self.CurrentBoardTier, growthRankName, combatExplorationRankName, tacticsRankName, majorRankName)
    end

    @ExecSpace("Client")
    method void ReceiveUnionUpgradeRow(integer requestId, string upgradeId, string displayName, string description, string effectType, integer maxLevel, boolean isMajor, integer purchasedLevel, string visualState, string currentEffectText, string nextEffectText, integer nextCost, boolean canPurchase, string purchaseReason, string requiredRankId, string requiredRankDisplayName, integer requiredBoardTier, string requiredUpgradeId, string requiredUpgradeDisplayName, integer requiredUpgradeLevel, string levelBoardTiers)
        if self.IsWindowOpen == false or requestId ~= self.SnapshotRequestId then return end
        self.UpgradeRowsById[upgradeId] = {
            UpgradeId = upgradeId, DisplayName = displayName, Description = description, EffectType = effectType,
            MaxLevel = maxLevel, IsMajor = isMajor, PurchasedLevel = purchasedLevel, VisualState = visualState,
            CurrentEffectText = currentEffectText, NextEffectText = nextEffectText, NextCost = nextCost, CanPurchase = canPurchase, PurchaseReason = purchaseReason,
            RequiredRankId = requiredRankId, RequiredRankDisplayName = requiredRankDisplayName, RequiredBoardTier = requiredBoardTier,
            RequiredUpgradeId = requiredUpgradeId, RequiredUpgradeDisplayName = requiredUpgradeDisplayName,
            RequiredUpgradeLevel = requiredUpgradeLevel, LevelBoardTiers = levelBoardTiers
        }
    end

    @ExecSpace("Client")
    method void ReceiveUnionUpgradeRowsComplete(integer requestId, boolean success, string reason, integer rowCount)
        if self.IsWindowOpen == false or requestId ~= self.SnapshotRequestId then return end
        self.IsRequestPending = false
        self:SetRefreshEnabled(true)
        if success == false then self:SetText(self.LoadStatusText, self:LocalizeReason(reason)) return end
        self:RefreshAllNodeVisuals()
        self:RefreshDetailPanel()
        if self.LastMutationMessage ~= "" then self:SetText(self.LoadStatusText, self.LastMutationMessage) else self:SetText(self.LoadStatusText, "유니온 정보 갱신 완료 · " .. tostring(rowCount) .. "개 강화") end
        if self.PurchaseFeedbackPending then self:PlayPurchaseFeedback() end
    end

    @ExecSpace("Client")
    method void ReceiveUnionMutationResult(integer requestId, boolean success, string reason)
        if self.IsWindowOpen == false or requestId ~= self.SnapshotRequestId then return end
        self.PurchaseFeedbackPending = success
        self.LastMutationMessage = success and "구매 완료 · 효과가 즉시 적용되었습니다." or self:LocalizeReason(reason)
    end

    method string BuildAppliedEffectsText(table effects)
        local lines = {}
        self:AppendPercentEffectLine(lines, "메소 획득", effects.MesoGainRate)
        self:AppendPercentEffectLine(lines, "아이템 드롭", effects.ItemDropRate)
        self:AppendPercentEffectLine(lines, "유니온 포인트 획득", effects.UnionPointGainRate)
        self:AppendFlatEffectLine(lines, "최대 체력", effects.MaxHPBonus)
        self:AppendFlatEffectLine(lines, "시작 포션", effects.StartingPotionBonus)
        self:AppendFlatEffectLine(lines, "인벤토리 슬롯", effects.InventorySlotBonus)
        self:AppendFlatEffectLine(lines, "증강 리롤", effects.AugmentRerollBonus)
        self:AppendFlatEffectLine(lines, "시작 스킬", effects.StartingSkillBonus)
        self:AppendFlatEffectLine(lines, "시작 랜덤 유물", effects.StartingRandomRelicBonus)
        if #lines == 0 then return "적용 중인 효과가 없습니다." end
        return table.concat(lines, "   ")
    end

    method void AppendFlatEffectLine(table lines, string label, number value)
        local resolved = math.floor(tonumber(value) or 0)
        if resolved > 0 then table.insert(lines, label .. " +" .. tostring(resolved)) end
    end

    method void AppendPercentEffectLine(table lines, string label, number value)
        local resolved = math.floor((tonumber(value) or 0) * 100 + 0.5)
        if resolved > 0 then table.insert(lines, label .. " +" .. tostring(resolved) .. "%") end
    end

    method string BuildRankCode(string rankId)
        if rankId == "UNION_V" then return "V" end
        if rankId == "UNION_IV" then return "IV" end
        if rankId == "UNION_III" then return "III" end
        if rankId == "UNION_II" then return "II" end
        return "I"
    end

    @ExecSpace("ClientOnly")
    method void SelectUpgrade(string upgradeId)
        if self.UpgradeRowsById[upgradeId] == nil then return end
        if self.SelectedUpgradeId == upgradeId then self.SelectedUpgradeId = "" else self.SelectedUpgradeId = upgradeId end
        self:RefreshAllNodeVisuals()
        self:RefreshDetailPanel()
    end

    @ExecSpace("ClientOnly")
    method void RefreshAllNodeVisuals()
        for upgradeId, entity in pairs(self.UpgradeNodeEntities) do if isvalid(entity) then self:ApplyNodeVisual(entity, self.UpgradeRowsById[upgradeId], upgradeId == self.SelectedUpgradeId, upgradeId) end end
    end

    @ExecSpace("ClientOnly")
    method void ApplyNodeVisual(Entity entity, table row, boolean selected, string upgradeId)
        -- The node entity is only a transparent territory hit target; cells carry all progression visuals.
        if entity.SpriteGUIRendererComponent ~= nil then
            entity.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 0.01)
            entity.SpriteGUIRendererComponent.Outline = false
        end
        local labelEntity = self.UpgradeLabelEntities[upgradeId]
        if isvalid(labelEntity) and labelEntity.TextGUIRendererComponent ~= nil then
            local prefix = selected and "▶ " or (row ~= nil and row.IsMajor and "◆ " or "")
            if row == nil then
                labelEntity.TextGUIRendererComponent.Text = self:GetNodeShortLabel(upgradeId) .. "  ·/·"
                labelEntity.TextGUIRendererComponent.FontColor = Color(0.74, 0.75, 0.70, 1)
            else
                labelEntity.TextGUIRendererComponent.Text = prefix .. self:GetNodeShortLabel(upgradeId) .. "  " .. tostring(row.PurchasedLevel) .. "/" .. tostring(row.MaxLevel)
                labelEntity.TextGUIRendererComponent.FontColor = row.IsMajor and Color(0.96, 0.82, 0.42, 1) or Color(0.96, 0.94, 0.86, 1)
            end
        end
        self:ApplyTerritoryVisual(upgradeId, row, selected)
    end

    @ExecSpace("ClientOnly")
    method void ApplyTerritoryVisual(string upgradeId, table row, boolean selected)
        -- Fill path cells in purchase order and keep later rank territory visible but dimmed.
        local cells = self.UpgradeCellEntities[upgradeId] or {}
        local levelTiers = self:ParseIntegerList(row ~= nil and row.LevelBoardTiers or "")
        local purchasedLevel = row ~= nil and math.max(0, row.PurchasedLevel) or 0
        local maxLevel = row ~= nil and math.max(0, row.MaxLevel) or #cells
        for index, cell in ipairs(cells) do
            local requiredTier = math.max(1, math.floor(tonumber(levelTiers[index]) or 1))
            local purchased = index <= purchasedLevel
            local rankUnlocked = self.CurrentBoardTier >= requiredTier
            local nextCell = index == purchasedLevel + 1 and index <= maxLevel
            self:ApplyTerritoryCellVisual(cell, upgradeId, purchased, rankUnlocked, nextCell, selected, row ~= nil and row.IsMajor == true)
        end
    end

    @ExecSpace("ClientOnly")
    method void ApplyTerritoryCellVisual(Entity cell, string upgradeId, boolean purchased, boolean rankUnlocked, boolean nextCell, boolean selected, boolean isMajor)
        -- Use one unified board palette with subtle regional hue and gold selection feedback.
        if isvalid(cell) == false or cell.SpriteGUIRendererComponent == nil then return end
        local sprite = cell.SpriteGUIRendererComponent
        if purchased then
            sprite.Color = self:ResolveTerritoryColor(upgradeId)
        elseif rankUnlocked then
            sprite.Color = Color(0.34, 0.36, 0.34, 0.80)
        else
            sprite.Color = Color(0.14, 0.16, 0.17, 0.62)
        end
        sprite.Outline = true
        if selected then
            sprite.OutlineWidth = 3
            sprite.OutlineColor = Color(1.00, 0.84, 0.34, 1)
        elseif purchased and isMajor then
            sprite.OutlineWidth = 3
            sprite.OutlineColor = Color(0.96, 0.73, 0.24, 1)
        elseif nextCell and rankUnlocked then
            sprite.OutlineWidth = 2
            sprite.OutlineColor = self:ResolveTerritoryColor(upgradeId)
        elseif rankUnlocked then
            sprite.OutlineWidth = 1
            sprite.OutlineColor = Color(0.53, 0.55, 0.50, 0.76)
        else
            sprite.OutlineWidth = 1
            sprite.OutlineColor = Color(0.27, 0.29, 0.29, 0.68)
        end
    end

    @ExecSpace("ClientOnly")
    method Color ResolveTerritoryColor(string upgradeId)
        -- Region hues remain muted so the four paths read as one Union Battle Map.
        if upgradeId == "MESO_GAIN_RATE" or upgradeId == "ITEM_DROP_RATE" or upgradeId == "UNION_POINT_GAIN_RATE" then return Color(0.69, 0.61, 0.32, 0.96) end
        if upgradeId == "MAX_HP" or upgradeId == "STARTING_POTION" then return Color(0.62, 0.37, 0.31, 0.96) end
        if upgradeId == "INVENTORY_SLOT" or upgradeId == "STARTING_RANDOM_RELIC" then return Color(0.30, 0.55, 0.55, 0.96) end
        return Color(0.43, 0.48, 0.66, 0.96)
    end

    @ExecSpace("ClientOnly")
    method table ParseIntegerList(string value)
        -- Snapshot strings avoid trusting client-authored tier values while remaining RPC-safe.
        local values = {}
        for token in string.gmatch(value or "", "[^,]+") do table.insert(values, math.floor(tonumber(token) or 1)) end
        return values
    end

    @ExecSpace("ClientOnly")
    method string GetNodeShortLabel(string upgradeId)
        if upgradeId == "MESO_GAIN_RATE" then return "메소" end
        if upgradeId == "ITEM_DROP_RATE" then return "드롭" end
        if upgradeId == "UNION_POINT_GAIN_RATE" then return "유니온" end
        if upgradeId == "MAX_HP" then return "HP" end
        if upgradeId == "STARTING_POTION" then return "물약" end
        if upgradeId == "INVENTORY_SLOT" then return "인벤" end
        if upgradeId == "STARTING_RANDOM_RELIC" then return "유물" end
        if upgradeId == "AUGMENT_REROLL" then return "리롤" end
        if upgradeId == "STARTING_SKILL" then return "스킬" end
        return upgradeId
    end

    @ExecSpace("ClientOnly")
    method void ApplyBoardTierVisuals(integer boardTier, string growthRankName, string combatExplorationRankName, string tacticsRankName, string majorRankName)
        local grid = self.FramePath .. "/BoardPanel/BoardGridFrame"
        self:SetRegionTint(grid .. "/GrowthRegion", boardTier >= 2, growthRankName)
        self:SetRegionTint(grid .. "/CombatRegion", boardTier >= 3, combatExplorationRankName)
        self:SetRegionTint(grid .. "/ExplorationRegion", boardTier >= 3, combatExplorationRankName)
        self:SetRegionTint(grid .. "/TacticsRegion", boardTier >= 4, tacticsRankName)
    end

    @ExecSpace("ClientOnly")
    method void SetRegionTint(string path, boolean unlocked, string requiredRankName)
        local entity = _EntityService:GetEntityByPath(path)
        if isvalid(entity) and entity.SpriteGUIRendererComponent ~= nil then entity.SpriteGUIRendererComponent.Color = unlocked and Color(0.45, 0.43, 0.36, 0.025) or Color(0.14, 0.16, 0.16, 0.09) end
        local lockText = self:GetText(path .. "/RegionLockText")
        if unlocked then self:SetText(lockText, "") else self:SetText(lockText, requiredRankName ~= "" and requiredRankName .. " 필요" or "상위 등급 필요") end
    end

    @ExecSpace("ClientOnly")
    method void RefreshDetailPanel()
        local row = self.UpgradeRowsById[self.SelectedUpgradeId]
        if self.SelectedUpgradeId == "" then
            self:RefreshDefaultDetailPanel()
            return
        end
        if row == nil then
            self:SetText(self.SelectedNameText, "영토 정보를 불러오는 중")
            self:SetText(self.SelectedStateText, "갱신 중")
            self:SetText(self.SelectedDescriptionText, "서버의 유니온 진행 정보를 기다리고 있습니다.")
            self:SetText(self.SelectedLevelsText, "현재 Lv.0")
            self:SetText(self.CurrentEffectText, "현재 효과  -")
            self:SetText(self.NextEffectText, "다음 레벨 효과  -")
            self:SetText(self.NextCostText, "필요 유니온 포인트  -")
            self:SetText(self.RequiredRankText, "필요 유니온 등급  -")
            self:SetText(self.PrerequisiteText, "선행 강화  -")
            self:SetPurchaseButton(false, "대기")
            return
        end
        self:SetText(self.SelectedNameText, row.DisplayName .. (row.IsMajor and "  [MAJOR]" or ""))
        self:SetText(self.SelectedStateText, self:VisualStateLabel(row.VisualState))
        self:SetText(self.SelectedDescriptionText, row.Description)
        self:SetText(self.SelectedLevelsText, "현재 Lv." .. tostring(row.PurchasedLevel) .. " / " .. tostring(row.MaxLevel) .. " · 구매 즉시 영구 적용")
        self:SetText(self.CurrentEffectText, row.PurchasedLevel > 0 and "현재 효과  " .. row.DisplayName .. " " .. row.CurrentEffectText or "현재 효과  적용 효과 없음")
        self:SetText(self.NextEffectText, row.PurchasedLevel >= row.MaxLevel and "다음 효과  MAX LEVEL" or "다음 효과  " .. row.DisplayName .. " " .. row.NextEffectText)
        self:SetText(self.NextCostText, row.PurchasedLevel >= row.MaxLevel and "필요 유니온 포인트  -" or "필요 유니온 포인트  " .. self:FormatInteger(row.NextCost))
        self:SetText(self.RequiredRankText, "필요 유니온 등급  " .. (row.RequiredRankDisplayName ~= "" and row.RequiredRankDisplayName or "없음"))
        self:SetText(self.PrerequisiteText, row.RequiredUpgradeDisplayName ~= "" and "선행 강화  " .. row.RequiredUpgradeDisplayName .. " Lv." .. tostring(row.RequiredUpgradeLevel) or "선행 강화  없음")
        if row.VisualState == "MAX_LEVEL" then self:SetPurchaseButton(false, "MAX LEVEL")
        elseif row.CanPurchase == true then self:SetPurchaseButton(self.IsRequestPending == false, row.IsMajor and "확인 후 구매" or "구매")
        elseif row.VisualState == "RANK_LOCKED" then self:SetPurchaseButton(false, "등급 잠김")
        elseif row.VisualState == "PREREQUISITE_LOCKED" then self:SetPurchaseButton(false, "선행 강화 필요")
        elseif row.VisualState == "INSUFFICIENT_POINTS" then self:SetPurchaseButton(false, "포인트 부족")
        else self:SetPurchaseButton(false, "구매 불가") end
    end

    @ExecSpace("ClientOnly")
    method void RefreshDefaultDetailPanel()
        -- Nothing selected: summarize current board state and the next rank expansion.
        self:SetText(self.SelectedNameText, "다음 유니온 등급")
        self:SetText(self.SelectedStateText, self.CurrentRankDisplayName)
        if self.NextRankThreshold > 0 then
            self:SetText(self.SelectedDescriptionText, self.NextRankDisplayName .. " 달성 시 외곽 영토와 다음 강화 경로가 개방됩니다.")
            self:SetText(self.SelectedLevelsText, self:FormatInteger(self.CurrentLifetimeUnionPoints) .. " / " .. self:FormatInteger(self.NextRankThreshold))
            self:SetText(self.CurrentEffectText, "현재 보드  BOARD TIER " .. tostring(self.CurrentBoardTier) .. " / 5")
            self:SetText(self.NextEffectText, "다음 확장  BOARD TIER " .. tostring(self.NextRankBoardTier) .. " / 5")
            self:SetText(self.NextCostText, "필요 누적 유니온 포인트  " .. self:FormatInteger(self.NextRankThreshold))
        else
            self:SetText(self.SelectedDescriptionText, "최고 유니온 등급을 달성했습니다.")
            self:SetText(self.SelectedLevelsText, "누적 " .. self:FormatInteger(self.CurrentLifetimeUnionPoints))
            self:SetText(self.CurrentEffectText, "현재 보드  BOARD TIER " .. tostring(self.CurrentBoardTier) .. " / 5")
            self:SetText(self.NextEffectText, "모든 유니온 영토가 개방되었습니다.")
            self:SetText(self.NextCostText, "필요 누적 유니온 포인트  -")
        end
        self:SetText(self.RequiredRankText, "영토를 선택하면 강화 상세 정보가 표시됩니다.")
        self:SetText(self.PrerequisiteText, "구매한 레벨만큼 전투지도 셀이 점유됩니다.")
        self:SetPurchaseButton(false, "영토를 선택하세요")
    end

    @ExecSpace("ClientOnly")
    method void ShowMajorConfirmation(table row)
        self.PendingMajorUpgradeId = row.UpgradeId
        self:SetText(self.ConfirmationMessageText, row.DisplayName .. "은(는) 주요 업그레이드입니다.\n구매 즉시 영구 적용됩니다.")
        self:SetText(self.ConfirmationCostText, "유니온 포인트  " .. tostring(row.NextCost))
        if isvalid(self.MajorConfirmationOverlay) then self.MajorConfirmationOverlay:SetEnable(true) end
    end

    @ExecSpace("ClientOnly")
    method void HideMajorConfirmation()
        self.PendingMajorUpgradeId = ""
        if isvalid(self.MajorConfirmationOverlay) then self.MajorConfirmationOverlay:SetEnable(false) end
    end

    @ExecSpace("ClientOnly")
    method void PlayPurchaseFeedback()
        self.PurchaseFeedbackPending = false
        local row = self.UpgradeRowsById[self.SelectedUpgradeId]
        local cells = self.UpgradeCellEntities[self.SelectedUpgradeId] or {}
        local cell = row ~= nil and cells[math.max(1, row.PurchasedLevel)] or nil
        if isvalid(cell) and cell.SpriteGUIRendererComponent ~= nil then
            cell.SpriteGUIRendererComponent.Outline = true
            cell.SpriteGUIRendererComponent.OutlineWidth = 7
            cell.SpriteGUIRendererComponent.OutlineColor = Color(1.00, 0.82, 0.28, 1)
        end
        if self.PurchaseFeedbackTimerId > 0 then _TimerService:ClearTimer(self.PurchaseFeedbackTimerId) end
        self.PurchaseFeedbackTimerId = _TimerService:SetTimerOnce(function()
            self.PurchaseFeedbackTimerId = 0
            if self.IsWindowOpen then self:RefreshAllNodeVisuals() end
        end, 0.7)
    end

    @ExecSpace("ClientOnly")
    method string FormatInteger(integer value)
        local text = tostring(math.max(0, math.floor(tonumber(value) or 0)))
        local length = string.len(text)
        local parts = {}
        while length > 3 do
            table.insert(parts, 1, string.sub(text, length - 2, length))
            length = length - 3
        end
        table.insert(parts, 1, string.sub(text, 1, length))
        return table.concat(parts, ",")
    end

    @ExecSpace("ClientOnly")
    method string VisualStateLabel(string visualState)
        if visualState == "AVAILABLE" then return "강화 가능" end
        if visualState == "PURCHASED" then return "보유" end
        if visualState == "MAX_LEVEL" then return "최대 레벨" end
        if visualState == "RANK_LOCKED" then return "등급 잠김" end
        if visualState == "PREREQUISITE_LOCKED" then return "선행 잠김" end
        if visualState == "INSUFFICIENT_POINTS" then return "포인트 부족" end
        return visualState or "알 수 없음"
    end

    @ExecSpace("ClientOnly")
    method string LocalizeReason(string reason)
        if reason == "INSUFFICIENT_UNION_POINTS" then return "유니온 포인트가 부족합니다." end
        if reason == "INSUFFICIENT_UNION_COIN" then return "유니온 코인이 부족합니다." end
        if reason == "UNION_RANK_LOCKED" then return "유니온 등급이 부족합니다." end
        if reason == "UNION_PREREQUISITE_LOCKED" then return "선행 강화가 필요합니다." end
        if reason == "MAX_LEVEL_REACHED" then return "이미 최대 레벨입니다." end
        if reason == "MAX_OWNED" then return "최대 보유 수량에 도달했습니다." end
        if reason == "PURCHASE_IN_PROGRESS" or reason == "PROFILE_MUTATION_IN_PROGRESS" or reason == "PROFILE_MUTATION_BUSY" then return "다른 유니온 변경을 처리 중입니다." end
        if reason == "INVALID_UPGRADE_ID" or reason == "UNION_UPGRADE_NOT_FOUND" then return "알 수 없는 유니온 업그레이드입니다." end
        if reason == "INVALID_BLOCK_ID" or reason == "UNION_BLOCK_NOT_FOUND" or reason == "BLOCK_NOT_FOUND" then return "알 수 없는 유니온 블록입니다." end
        if reason == "BLOCK_PURCHASE_UNAVAILABLE" then return "현재 블록을 구매할 수 없습니다." end
        if reason == "INVALID_PURCHASE_REQUEST_ID" or reason == "PURCHASE_REQUEST_ID_REUSED" then return "유효하지 않은 구매 요청입니다." end
        if reason == "UNION_LOADOUT_REMOVED" then return "활성화 설정은 제거되었습니다. 구매한 효과는 항상 적용됩니다." end
        if reason == "OK" then return "완료되었습니다." end
        return reason or "UNKNOWN"
    end

    @ExecSpace("ClientOnly")
    method boolean EnsureUiConnection()
        if self.IsUiConnected then return true end
        self.UnionWindow = _EntityService:GetEntityByPath(self.WindowPath)
        self.MajorConfirmationOverlay = _EntityService:GetEntityByPath(self.FramePath .. "/MajorConfirmationOverlay")
        self.BlockShopPanel = _EntityService:GetEntityByPath(self.FramePath .. "/BlockShopPanel")
        if isvalid(self.UnionWindow) == false or isvalid(self.MajorConfirmationOverlay) == false or isvalid(self.BlockShopPanel) == false then return self:ReportBindingWait() end
        local right = self.FramePath .. "/RightPanel"
        local detail = right .. "/UpgradeDetailPanel"
        self.CloseButton = self:GetButton(self.FramePath .. "/HeaderBar/CloseButton")
        self.RefreshButton = self:GetButton(right .. "/RefreshButton")
        self.PurchaseButton = self:GetButton(detail .. "/PurchaseButton")
        self.PurchaseButtonText = self:GetText(detail .. "/PurchaseButton")
        self.ConfirmPurchaseButton = self:GetButton(self.FramePath .. "/MajorConfirmationOverlay/ConfirmationDialog/ConfirmPurchaseButton")
        self.CancelPurchaseButton = self:GetButton(self.FramePath .. "/MajorConfirmationOverlay/ConfirmationDialog/CancelPurchaseButton")
        self.RankCodeText = self:GetText(right .. "/RankEmblemFrame/RankCodeText")
        self.RankNameText = self:GetText(right .. "/RankNameText")
        self.CurrentPointsText = self:GetText(right .. "/PointsPanel/CurrentUnionPointsText")
        self.LifetimePointsText = self:GetText(right .. "/PointsPanel/LifetimeUnionPointsText")
        self.BoardTierText = self:GetText(self.FramePath .. "/BoardPanel/BoardTierText")
        self.AppliedEffectsText = self:GetText(right .. "/AppliedEffectsPanel/AppliedEffectsText")
        self.LoadStatusText = self:GetText(right .. "/LoadStatusText")
        self.SelectedNameText = self:GetText(detail .. "/SelectedNameText")
        self.SelectedStateText = self:GetText(detail .. "/SelectedStateText")
        self.SelectedDescriptionText = self:GetText(detail .. "/SelectedDescriptionText")
        self.SelectedLevelsText = self:GetText(detail .. "/SelectedLevelsText")
        self.CurrentEffectText = self:GetText(detail .. "/CurrentEffectText")
        self.NextEffectText = self:GetText(detail .. "/NextEffectText")
        self.NextCostText = self:GetText(detail .. "/NextCostText")
        self.RequiredRankText = self:GetText(detail .. "/RequiredRankText")
        self.PrerequisiteText = self:GetText(detail .. "/PrerequisiteText")
        self.CoreRankText = self:GetText(self.FramePath .. "/BoardPanel/BoardGridFrame/UnionCore/CoreRankText")
        self.ConfirmationMessageText = self:GetText(self.FramePath .. "/MajorConfirmationOverlay/ConfirmationDialog/ConfirmationMessageText")
        self.ConfirmationCostText = self:GetText(self.FramePath .. "/MajorConfirmationOverlay/ConfirmationDialog/ConfirmationCostText")
        local shop = self.FramePath .. "/BlockShopPanel"
        local shopCard = shop .. "/BlockItemCard"
        self.BlockShopButton = self:GetButton(self.FramePath .. "/HeaderBar/BlockShopButton")
        self.ShopCloseButton = self:GetButton(shop .. "/TitleBar/ShopCloseButton")
        self.ShopPurchaseButton = self:GetButton(shopCard .. "/ShopPurchaseButton")
        self.ShopPurchaseButtonText = self:GetText(shopCard .. "/ShopPurchaseButton")
        self.ShopCurrencyText = self:GetText(shop .. "/CurrencyPanel/ShopCurrencyText")
        self.ShopBlockNameText = self:GetText(shopCard .. "/BlockNameText")
        self.ShopOwnedText = self:GetText(shopCard .. "/ShopOwnedText")
        self.ShopRequiredRankText = self:GetText(shopCard .. "/ShopRequiredRankText")
        self.ShopPriceText = self:GetText(shopCard .. "/ShopPriceText")
        self.ShopStatusText = self:GetText(shop .. "/ShopStatusText")
        self.ShopPreviewCells = {}
        for index = 1, 3 do
            local previewCell = _EntityService:GetEntityByPath(shopCard .. "/ShapePreviewPanel/PreviewCell" .. tostring(index))
            if isvalid(previewCell) == false or previewCell.UITransformComponent == nil then return self:ReportBindingWait() end
            table.insert(self.ShopPreviewCells, previewCell)
        end
        if self:AreRequiredBindingsReady() == false or self:ConnectUpgradeNodes() == false then return self:ReportBindingWait() end
        self.UiHandlers.Close = self.CloseButton.Entity:ConnectEvent(ButtonClickEvent, self.OnCloseButtonClicked)
        self.UiHandlers.Refresh = self.RefreshButton.Entity:ConnectEvent(ButtonClickEvent, self.OnRefreshButtonClicked)
        self.UiHandlers.Purchase = self.PurchaseButton.Entity:ConnectEvent(ButtonClickEvent, self.OnPurchaseClicked)
        self.UiHandlers.Confirm = self.ConfirmPurchaseButton.Entity:ConnectEvent(ButtonClickEvent, self.OnConfirmPurchaseClicked)
        self.UiHandlers.Cancel = self.CancelPurchaseButton.Entity:ConnectEvent(ButtonClickEvent, self.OnCancelPurchaseClicked)
        self.UiHandlers.BlockShop = self.BlockShopButton.Entity:ConnectEvent(ButtonClickEvent, self.OnBlockShopButtonClicked)
        self.UiHandlers.ShopClose = self.ShopCloseButton.Entity:ConnectEvent(ButtonClickEvent, self.OnShopCloseButtonClicked)
        self.UiHandlers.ShopPurchase = self.ShopPurchaseButton.Entity:ConnectEvent(ButtonClickEvent, self.OnShopPurchaseButtonClicked)
        self.IsUiConnected = true
        self.BindingWarningLogged = false
        self:SetWindowEnabled(self.IsWindowOpen)
        self.BlockShopPanel:SetEnable(self.IsBlockShopOpen)
        self:HideMajorConfirmation()
        self:RefreshDetailPanel()
        return true
    end

    @ExecSpace("ClientOnly")
    method boolean ConnectUpgradeNodes()
        self.UpgradeNodeEntities = {}
        self.UpgradeLabelEntities = {}
        self.UpgradeCellEntities = {}
        self.UpgradeNodeHandlers = {}
        for upgradeId, path in pairs(self.UpgradeNodePaths) do
            local entity = _EntityService:GetEntityByPath(path)
            local labelEntity = _EntityService:GetEntityByPath(path .. "/PathLabel")
            if isvalid(entity) == false or entity.ButtonComponent == nil or entity.SpriteGUIRendererComponent == nil or isvalid(labelEntity) == false or labelEntity.TextGUIRendererComponent == nil then return false end
            local cellEntities = {}
            for _, cellPath in ipairs(self.UpgradeCellPaths[upgradeId] or {}) do
                local cellEntity = _EntityService:GetEntityByPath(cellPath)
                if isvalid(cellEntity) == false or cellEntity.SpriteGUIRendererComponent == nil then return false end
                table.insert(cellEntities, cellEntity)
            end
            if #cellEntities == 0 then return false end
            self.UpgradeNodeEntities[upgradeId] = entity
            self.UpgradeLabelEntities[upgradeId] = labelEntity
            self.UpgradeCellEntities[upgradeId] = cellEntities
            local capturedUpgradeId = upgradeId
            self.UpgradeNodeHandlers[upgradeId] = entity:ConnectEvent(ButtonClickEvent, function() self:SelectUpgrade(capturedUpgradeId) end)
        end
        return true
    end

    @ExecSpace("ClientOnly")
    method boolean AreRequiredBindingsReady()
        return self.CloseButton ~= nil and self.RefreshButton ~= nil and self.PurchaseButton ~= nil and self.ConfirmPurchaseButton ~= nil and self.CancelPurchaseButton ~= nil and self.RankCodeText ~= nil and self.RankNameText ~= nil and self.CurrentPointsText ~= nil and self.LifetimePointsText ~= nil and self.BoardTierText ~= nil and self.AppliedEffectsText ~= nil and self.LoadStatusText ~= nil and self.SelectedNameText ~= nil and self.SelectedStateText ~= nil and self.SelectedDescriptionText ~= nil and self.SelectedLevelsText ~= nil and self.CurrentEffectText ~= nil and self.NextEffectText ~= nil and self.NextCostText ~= nil and self.RequiredRankText ~= nil and self.PrerequisiteText ~= nil and self.CoreRankText ~= nil and self.PurchaseButtonText ~= nil and self.ConfirmationMessageText ~= nil and self.ConfirmationCostText ~= nil and self.BlockShopButton ~= nil and self.ShopCloseButton ~= nil and self.ShopPurchaseButton ~= nil and self.ShopPurchaseButtonText ~= nil and self.ShopCurrencyText ~= nil and self.ShopBlockNameText ~= nil and self.ShopOwnedText ~= nil and self.ShopRequiredRankText ~= nil and self.ShopPriceText ~= nil and self.ShopStatusText ~= nil and #self.ShopPreviewCells == 3
    end

    @ExecSpace("ClientOnly")
    method boolean ReportBindingWait()
        if self.BindingWarningLogged == false then self.BindingWarningLogged = true log_warning("[UnionUI] waiting for Union Battle Map territory bindings") end
        return false
    end

    @ExecSpace("ClientOnly")
    method ButtonComponent GetButton(string path)
        local entity = _EntityService:GetEntityByPath(path)
        return isvalid(entity) and entity.ButtonComponent or nil
    end

    @ExecSpace("ClientOnly")
    method TextGUIRendererComponent GetText(string path)
        local entity = _EntityService:GetEntityByPath(path)
        return isvalid(entity) and entity.TextGUIRendererComponent or nil
    end

    @ExecSpace("ClientOnly")
    method void DisconnectUiEvents()
        self:DisconnectButtonEvent(self.CloseButton, self.UiHandlers.Close)
        self:DisconnectButtonEvent(self.RefreshButton, self.UiHandlers.Refresh)
        self:DisconnectButtonEvent(self.PurchaseButton, self.UiHandlers.Purchase)
        self:DisconnectButtonEvent(self.ConfirmPurchaseButton, self.UiHandlers.Confirm)
        self:DisconnectButtonEvent(self.CancelPurchaseButton, self.UiHandlers.Cancel)
        self:DisconnectButtonEvent(self.BlockShopButton, self.UiHandlers.BlockShop)
        self:DisconnectButtonEvent(self.ShopCloseButton, self.UiHandlers.ShopClose)
        self:DisconnectButtonEvent(self.ShopPurchaseButton, self.UiHandlers.ShopPurchase)
        for upgradeId, entity in pairs(self.UpgradeNodeEntities) do local handlerId = self.UpgradeNodeHandlers[upgradeId] if isvalid(entity) and handlerId ~= nil then entity:DisconnectEvent(ButtonClickEvent, handlerId) end end
        self.UiHandlers = {}
        self.UpgradeNodeHandlers = {}
        self.UpgradeNodeEntities = {}
        self.UpgradeLabelEntities = {}
        self.UpgradeCellEntities = {}
        self.ShopPreviewCells = {}
        self.IsUiConnected = false
    end

    @ExecSpace("ClientOnly")
    method void DisconnectButtonEvent(ButtonComponent button, any handlerId)
        if button ~= nil and isvalid(button.Entity) and handlerId ~= nil then button.Entity:DisconnectEvent(ButtonClickEvent, handlerId) end
    end

    @ExecSpace("ClientOnly")
    method void SetPurchaseButton(boolean enabled, string label)
        self:SetButtonEnabled(self.PurchaseButton, enabled)
        self:SetText(self.PurchaseButtonText, label)
        if self.PurchaseButton ~= nil and isvalid(self.PurchaseButton.Entity) and self.PurchaseButton.Entity.SpriteGUIRendererComponent ~= nil then self.PurchaseButton.Entity.SpriteGUIRendererComponent.Color = enabled and Color(0.23, 0.49, 0.34, 1) or Color(0.42, 0.22, 0.23, 0.82) end
    end

    @ExecSpace("ClientOnly")
    method void SetButtonEnabled(ButtonComponent button, boolean enabled)
        if button ~= nil and isvalid(button.Entity) then button.Enable = enabled end
    end

    @ExecSpace("ClientOnly")
    method void SetRefreshEnabled(boolean enabled)
        self:SetButtonEnabled(self.RefreshButton, enabled)
    end

    @ExecSpace("ClientOnly")
    method void SetWindowEnabled(boolean enabled)
        if isvalid(self.UnionWindow) then self.UnionWindow:SetEnable(enabled) end
    end

    @ExecSpace("ClientOnly")
    method void SetText(TextGUIRendererComponent renderer, string value)
        if renderer ~= nil and isvalid(renderer.Entity) then renderer.Text = value or "" end
    end

    @ExecSpace("ClientOnly")
    method boolean IsLocalPlayerInLobby()
        local player = _UserService.LocalPlayer
        return isvalid(player) and isvalid(player.CurrentMap) and player.CurrentMap.Name == "lobby"
    end

    @ExecSpace("ClientOnly")
    method boolean IsOtherLobbyPopupOpen()
        if _LobbyCharacterSelectionLogic:IsOpen() or _LobbyCodexLogic:IsOpen() then return true end
        local uiRoot = _EntityService:GetEntityByPath("/ui/DefaultGroup")
        if isvalid(uiRoot) then
            local minimapUI = uiRoot:GetComponent("script.MinimapUI")
            if minimapUI ~= nil and minimapUI:IsWorldMapOpen() then return true end
        end
        return false
    end

end
