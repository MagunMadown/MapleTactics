@Component
script MapTeleportButton extends Component

	property string TargetMapName = "map01"

	property Vector3 TargetPosition = Vector3(0, 0, 0)

	property string MapDisplayName = ""

	property any clickHandler = nil

	property any hoverEnterHandler = nil

	property any hoverExitHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- Connects click and hover events for this teleport button.
		log("MapTeleportButton: Initializing component for target map -> " .. self.TargetMapName)
		
		self.clickHandler = self.Entity:ConnectEvent(ButtonClickEvent, self.OnButtonClick)
		self.hoverEnterHandler = self.Entity:ConnectEvent(UITouchEnterEvent, self.OnHoverEnter)
		self.hoverExitHandler = self.Entity:ConnectEvent(UITouchExitEvent, self.OnHoverExit)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- Disconnects all event handlers on cleanup.
		if self.clickHandler then
			self.Entity:DisconnectEvent(ButtonClickEvent, self.clickHandler)
			self.clickHandler = nil
		end
		if self.hoverEnterHandler then
			self.Entity:DisconnectEvent(UITouchEnterEvent, self.hoverEnterHandler)
			self.hoverEnterHandler = nil
		end
		if self.hoverExitHandler then
			self.Entity:DisconnectEvent(UITouchExitEvent, self.hoverExitHandler)
			self.hoverExitHandler = nil
		end
	end

	@ExecSpace("ClientOnly")
	method void OnButtonClick(ButtonClickEvent event)
		-- Requests map teleportation with injected TargetMapName and TargetPosition.
		log("MapTeleportButton: Clicked for map -> " .. self.TargetMapName .. ", pos -> " .. tostring(self.TargetPosition))
		_MapTeleportManager:RequestTeleportFromClient(self.TargetMapName, self.TargetPosition)
		
		local popup = _EntityService:GetEntityByPath("/ui/PopupGroup/MapTeleportPopup")
		if isvalid(popup) then
			popup.Enable = false
			popup.Visible = false
		end
	end

	@ExecSpace("ClientOnly")
	method void OnHoverEnter(UITouchEnterEvent event)
		-- Displays tooltip with injected MapDisplayName or TargetMapName.
		local text = self.MapDisplayName
		if text == "" or text == nil then
			text = self.TargetMapName
		end
		
		log("MapTeleportButton: Hover enter on " .. self.Entity.Name .. " with text: " .. text)
		
		local targetPos = Vector2(0, 0)
		if isvalid(self.Entity.UITransformComponent) then
			local bPos = self.Entity.UITransformComponent.anchoredPosition
			targetPos = Vector2(bPos.x, bPos.y + 40)
		end
		if isvalid(event) and event.TouchPoint ~= nil and (event.TouchPoint.x ~= 0 or event.TouchPoint.y ~= 0) then
			local posX = event.TouchPoint.x
			local posY = event.TouchPoint.y
			if posX > 960 or posX < -960 or posY > 540 or posY < -540 then
				posX = posX - 960
				posY = posY - 540
			end
			targetPos = Vector2(posX + 20, posY + 20)
		end
		
		local minimapUIEntity = _EntityService:GetEntityByPath("/ui/DefaultGroup")
		if isvalid(minimapUIEntity) then
			---@type MinimapUI
			local minimapUI = minimapUIEntity:GetComponent("script.MinimapUI")
			if isvalid(minimapUI) then
				minimapUI:ShowTooltip(text, targetPos)
			else
				log_warning("MapTeleportButton: MinimapUI component not found on /ui/DefaultGroup")
			end
		else
			log_warning("MapTeleportButton: Entity at /ui/DefaultGroup not found")
		end
	end

	@ExecSpace("ClientOnly")
	method void OnHoverExit(UITouchExitEvent event)
		-- Hides tooltip.
		log("MapTeleportButton: Hover exit on " .. self.Entity.Name)
		local minimapUIEntity = _EntityService:GetEntityByPath("/ui/DefaultGroup")
		if isvalid(minimapUIEntity) then
			---@type MinimapUI
			local minimapUI = minimapUIEntity:GetComponent("script.MinimapUI")
			if isvalid(minimapUI) then
				minimapUI:HideTooltip()
			end
		end
	end

end