@Component
script MinimapUI extends Component

	property number TravelDuration = 1.15

	property integer TravelTimerId = 0

	property number TravelProgress = 0

	property boolean IsWorldMapOpenState = false

	property Vector2 TravelStartPosition = Vector2(-733, 29)

	property string CurrentMode = "LOBBY_STAGE"

	property string SelectedRouteId = ""

	property boolean RouteSelectionLocked = false

	property integer LastObservedCompletedStageCount = -1

	property string LastObservedWorldMapBranch = "__UNSET__"

	property any ShopClickHandler = nil

	property any LowerShopClickHandler = nil

	property any KerningPerionShopClickHandler = nil

	property any ElliniaNautilusShopClickHandler = nil

	property any PerionSleepywoodShopClickHandler = nil

	property any NautilusSleepywoodShopClickHandler = nil

	property any HenesysUpperShopTooltipEnterHandler = nil

	property any HenesysUpperShopTooltipExitHandler = nil

	property any HenesysLowerShopTooltipEnterHandler = nil

	property any HenesysLowerShopTooltipExitHandler = nil

	property any KerningPerionShopTooltipEnterHandler = nil

	property any KerningPerionShopTooltipExitHandler = nil

	property any ElliniaNautilusShopTooltipEnterHandler = nil

	property any ElliniaNautilusShopTooltipExitHandler = nil

	property any PerionSleepywoodShopTooltipEnterHandler = nil

	property any PerionSleepywoodShopTooltipExitHandler = nil

	property any NautilusSleepywoodShopTooltipEnterHandler = nil

	property any NautilusSleepywoodShopTooltipExitHandler = nil

	property any ShopCloseHandler = nil

	property any WorldMapCloseHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- Initializes the persistent world-map controller through its stable UI path.
		self.IsWorldMapOpenState = false
		local travelAvatar = self:GetTravelAvatar()
		if isvalid(travelAvatar) and isvalid(travelAvatar.UITransformComponent) then
			self.TravelStartPosition = travelAvatar.UITransformComponent.anchoredPosition
		end
		self:ConnectWorldMapButtons()
		self:RefreshWorldMapProgress("begin_play")
		log("[WorldMap] controller ready popup=" .. tostring(isvalid(self:GetWorldMapPopup())))
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- Releases the travel animation timer when the UI controller is destroyed.
		self.IsWorldMapOpenState = false
		self:StopTravelAnimation(true)
		self:DisconnectWorldMapButtons()
	end

	@ExecSpace("ClientOnly")
	method void OnMapEnter(Entity mapEntity)
		-- Guarantees the world map is hidden outside the lobby.
		if self.CurrentMode == "LOBBY_STAGE" and isvalid(mapEntity) and mapEntity.Name ~= "lobby" then
			self:CloseWorldMapForTransfer(mapEntity.Name)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- Refreshes synced progression while visible and closes a stale popup after transfer.
		local popup = self:GetWorldMapPopup()
		if isvalid(popup) == false or popup.Enable == false or popup.Visible == false then
			return
		end
		local player = _UserService.LocalPlayer
		if self.CurrentMode == "LOBBY_STAGE" and isvalid(player) and isvalid(player.CurrentMap) and player.CurrentMap.Name ~= "lobby" then
			self:CloseWorldMapForTransfer(player.CurrentMap.Name)
			return
		end
		if self.CurrentMode ~= "LOBBY_STAGE" then
			return
		end
		local completedStageCount = self:GetCompletedStageCount()
		local selectedBranch = self:GetSelectedWorldMapBranch()
		if completedStageCount ~= self.LastObservedCompletedStageCount or selectedBranch ~= self.LastObservedWorldMapBranch then
			self:RefreshWorldMapProgress("sync_changed")
		end
	end

	@ExecSpace("ClientOnly")
	method boolean OpenWorldMap(string source)
		return self:OpenWorldMapMode("LOBBY_STAGE", source, "")
	end

	@ExecSpace("ClientOnly")
	method boolean OpenWorldMapMode(string mode, string source, string selectedRouteId)
		-- Reuses one world map for lobby entry, shop choice, and the locked post-shop route.
		self.CurrentMode = mode or "LOBBY_STAGE"
		self.SelectedRouteId = selectedRouteId or ""
		if self.ShopClickHandler == nil or self.LowerShopClickHandler == nil or self.WorldMapCloseHandler == nil then
			self:DisconnectWorldMapButtons()
			self:ConnectWorldMapButtons()
		end
		-- Keep the shared base map synchronized in every presentation mode. Choice
		-- modes add overlays; they must not replace the already-rendered world map.
		self:RefreshWorldMapProgress(source)
		self:ConfigureWorldMapMode()
		if self:SetWorldMapVisible(true) == false then
			log_warning("[WorldMap] open failed mode=" .. self.CurrentMode .. " source=" .. source .. " reason=UI_MISSING")
			return false
		end
		if self.CurrentMode == "POST_SHOP_ROUTE" then
			self:ShowTravelAvatarAtRoute(self.SelectedRouteId)
		elseif self.CurrentMode == "SHOP_CHOICE" then
			-- Henesys has already been cleared when this mandatory route choice opens.
			self:ShowTravelAvatarAtCity("HenesysCityBranchBtn")
		else
			self:ShowTravelAvatarAtStart()
		end
		log("[WorldMap] opened mode=" .. self.CurrentMode .. " source=" .. source .. " route=" .. self.SelectedRouteId)
		return true
	end

	@ExecSpace("ClientOnly")
	method void ConfigureWorldMapMode()
		local henesys = self:GetWorldMapEntity("HenesysCityBranchBtn")
		local upper = self:GetWorldMapEntity("UpperShopBranchBtn")
		local lower = self:GetWorldMapEntity("LowerShopBranchBtn")
		local upperLine = self:GetWorldMapEntity("UpperRouteLine")
		local lowerLine = self:GetWorldMapEntity("LowerRouteLine")
		local ellinia = self:GetWorldMapEntity("ElliniaBranchBtn")
		local kerning = self:GetWorldMapEntity("KerningCityBranchBtn")
		local upperLock = self:GetWorldMapEntity("UpperRouteLock")
		local lowerLock = self:GetWorldMapEntity("LowerRouteLock")
		local legacyUpperShop = self:GetWorldMapEntity("ShopVisitBtn")
		local legacyLowerShop = self:GetWorldMapEntity("LowerShopVisitBtn")
		local lobbyStage = self.CurrentMode == "LOBBY_STAGE"
		local shopChoice = self.CurrentMode == "SHOP_CHOICE"
		local postShop = self.CurrentMode == "POST_SHOP_ROUTE"
		local showBaseMap = lobbyStage or shopChoice or postShop
		-- Preserve the city graph while SHOP_CHOICE is displayed. The route-choice
		-- controls below are an overlay on the map, not a replacement for it.
		self:SetNodeVisible(henesys, showBaseMap)
		self:SetNodeVisible(upper, shopChoice)
		self:SetNodeVisible(lower, shopChoice)
		self:SetNodeVisible(upperLine, shopChoice or (postShop and self.SelectedRouteId == "shop_upper"))
		self:SetNodeVisible(lowerLine, shopChoice or (postShop and self.SelectedRouteId == "shop_lower"))
		if shopChoice then
			self.RouteSelectionLocked = false
			local upperButton = isvalid(upper) and upper:GetComponent("script.WorldMapRunNodeButtonComponent") or nil
			local lowerButton = isvalid(lower) and lower:GetComponent("script.WorldMapRunNodeButtonComponent") or nil
			if upperButton ~= nil then upperButton:ResetForChoice() end
			if lowerButton ~= nil then lowerButton:ResetForChoice() end
		end
		self:SetNodeVisible(ellinia, showBaseMap)
		self:SetNodeVisible(kerning, showBaseMap)
		self:SetNodeVisible(legacyUpperShop, lobbyStage)
		self:SetNodeVisible(legacyLowerShop, lobbyStage)
		if shopChoice then
			-- Base city nodes stay visible for continuity, but only the two route
			-- overlay buttons may accept input during the mandatory choice.
			self:SetButtonEnabled(henesys, false)
			self:SetButtonEnabled(ellinia, false)
			self:SetButtonEnabled(kerning, false)
		end
		local upperSelected = self.SelectedRouteId == "shop_upper"
		local lowerSelected = self.SelectedRouteId == "shop_lower"
		if postShop then
			self:SetButtonEnabled(kerning, upperSelected)
			self:SetButtonEnabled(ellinia, lowerSelected)
		end
		self:SetNodeVisible(upperLock, postShop and not upperSelected)
		self:SetNodeVisible(lowerLock, postShop and not lowerSelected)
		log("[WorldMap] mode configured mode=" .. self.CurrentMode .. " base=" .. tostring(showBaseMap) .. " choice=" .. tostring(shopChoice) .. " route=" .. self.SelectedRouteId)
	end

	@ExecSpace("ClientOnly")
	method boolean TryLockRouteSelection()
		if self.RouteSelectionLocked then
			return false
		end
		self.RouteSelectionLocked = true
		return true
	end

	@ExecSpace("ClientOnly")
	method void SetNodeVisible(any entity, boolean visible)
		if isvalid(entity) then
			entity.Enable = visible
			entity.Visible = visible
		end
	end

	@ExecSpace("ClientOnly")
	method void SetButtonEnabled(any entity, boolean enabled)
		if isvalid(entity) and entity.ButtonComponent ~= nil then
			entity.ButtonComponent.Enable = enabled
		end
	end

	@ExecSpace("ClientOnly")
	method void ConnectWorldMapButtons()
		-- Owns the close and shop overlay events from the persistent UI controller.
		local shopButton = self:GetWorldMapEntity("ShopVisitBtn")
		if isvalid(shopButton) then
			self.ShopClickHandler = shopButton:ConnectEvent(ButtonClickEvent, self.OnShopVisitClicked)
			self.HenesysUpperShopTooltipEnterHandler = shopButton:ConnectEvent(UITouchEnterEvent, self.OnHenesysUpperShopTooltipEnter)
			self.HenesysUpperShopTooltipExitHandler = shopButton:ConnectEvent(UITouchExitEvent, self.OnHenesysUpperShopTooltipExit)
		end
		local lowerShopButton = self:GetWorldMapEntity("LowerShopVisitBtn")
		if isvalid(lowerShopButton) then
			self.LowerShopClickHandler = lowerShopButton:ConnectEvent(ButtonClickEvent, self.OnLowerShopVisitClicked)
			self.HenesysLowerShopTooltipEnterHandler = lowerShopButton:ConnectEvent(UITouchEnterEvent, self.OnHenesysLowerShopTooltipEnter)
			self.HenesysLowerShopTooltipExitHandler = lowerShopButton:ConnectEvent(UITouchExitEvent, self.OnHenesysLowerShopTooltipExit)
		end
		local kerningPerionShop = self:GetWorldMapEntity("KerningPerionShopVisitBtn")
		if isvalid(kerningPerionShop) then
			self.KerningPerionShopClickHandler = kerningPerionShop:ConnectEvent(ButtonClickEvent, self.OnKerningPerionShopLockedClicked)
			self.KerningPerionShopTooltipEnterHandler = kerningPerionShop:ConnectEvent(UITouchEnterEvent, self.OnKerningPerionShopTooltipEnter)
			self.KerningPerionShopTooltipExitHandler = kerningPerionShop:ConnectEvent(UITouchExitEvent, self.OnKerningPerionShopTooltipExit)
		end
		local elliniaNautilusShop = self:GetWorldMapEntity("ElliniaNautilusShopVisitBtn")
		if isvalid(elliniaNautilusShop) then
			self.ElliniaNautilusShopClickHandler = elliniaNautilusShop:ConnectEvent(ButtonClickEvent, self.OnElliniaNautilusShopLockedClicked)
			self.ElliniaNautilusShopTooltipEnterHandler = elliniaNautilusShop:ConnectEvent(UITouchEnterEvent, self.OnElliniaNautilusShopTooltipEnter)
			self.ElliniaNautilusShopTooltipExitHandler = elliniaNautilusShop:ConnectEvent(UITouchExitEvent, self.OnElliniaNautilusShopTooltipExit)
		end
		local perionSleepywoodShop = self:GetWorldMapEntity("PerionSleepywoodShopVisitBtn")
		if isvalid(perionSleepywoodShop) then
			self.PerionSleepywoodShopClickHandler = perionSleepywoodShop:ConnectEvent(ButtonClickEvent, self.OnPerionSleepywoodShopLockedClicked)
			self.PerionSleepywoodShopTooltipEnterHandler = perionSleepywoodShop:ConnectEvent(UITouchEnterEvent, self.OnPerionSleepywoodShopTooltipEnter)
			self.PerionSleepywoodShopTooltipExitHandler = perionSleepywoodShop:ConnectEvent(UITouchExitEvent, self.OnPerionSleepywoodShopTooltipExit)
		end
		local nautilusSleepywoodShop = self:GetWorldMapEntity("NautilusSleepywoodShopVisitBtn")
		if isvalid(nautilusSleepywoodShop) then
			self.NautilusSleepywoodShopClickHandler = nautilusSleepywoodShop:ConnectEvent(ButtonClickEvent, self.OnNautilusSleepywoodShopLockedClicked)
			self.NautilusSleepywoodShopTooltipEnterHandler = nautilusSleepywoodShop:ConnectEvent(UITouchEnterEvent, self.OnNautilusSleepywoodShopTooltipEnter)
			self.NautilusSleepywoodShopTooltipExitHandler = nautilusSleepywoodShop:ConnectEvent(UITouchExitEvent, self.OnNautilusSleepywoodShopTooltipExit)
		end
		local shopCloseButton = self:GetWorldMapEntity("ShopVisitPanel/ShopCloseBtn")
		if isvalid(shopCloseButton) then
			self.ShopCloseHandler = shopCloseButton:ConnectEvent(ButtonClickEvent, self.OnShopCloseClicked)
		end
		local worldMapCloseButton = self:GetWorldMapEntity("WorldMapCloseBtn")
		if isvalid(worldMapCloseButton) then
			self.WorldMapCloseHandler = worldMapCloseButton:ConnectEvent(ButtonClickEvent, self.OnWorldMapCloseClicked)
		end
		log("[WorldMap] interaction handlers connected upperShop=" .. tostring(isvalid(shopButton)) .. " lowerShop=" .. tostring(isvalid(lowerShopButton)))
	end

	@ExecSpace("ClientOnly")
	method void DisconnectWorldMapButtons()
		-- Releases UI event handlers without affecting other popup consumers.
		local shopButton = self:GetWorldMapEntity("ShopVisitBtn")
		if isvalid(shopButton) and self.ShopClickHandler ~= nil then
			shopButton:DisconnectEvent(ButtonClickEvent, self.ShopClickHandler)
		end
		local lowerShopButton = self:GetWorldMapEntity("LowerShopVisitBtn")
		if isvalid(lowerShopButton) and self.LowerShopClickHandler ~= nil then
			lowerShopButton:DisconnectEvent(ButtonClickEvent, self.LowerShopClickHandler)
		end
		if isvalid(shopButton) and self.HenesysUpperShopTooltipEnterHandler ~= nil then
			shopButton:DisconnectEvent(UITouchEnterEvent, self.HenesysUpperShopTooltipEnterHandler)
		end
		if isvalid(shopButton) and self.HenesysUpperShopTooltipExitHandler ~= nil then
			shopButton:DisconnectEvent(UITouchExitEvent, self.HenesysUpperShopTooltipExitHandler)
		end
		if isvalid(lowerShopButton) and self.HenesysLowerShopTooltipEnterHandler ~= nil then
			lowerShopButton:DisconnectEvent(UITouchEnterEvent, self.HenesysLowerShopTooltipEnterHandler)
		end
		if isvalid(lowerShopButton) and self.HenesysLowerShopTooltipExitHandler ~= nil then
			lowerShopButton:DisconnectEvent(UITouchExitEvent, self.HenesysLowerShopTooltipExitHandler)
		end
		local kerningPerionShop = self:GetWorldMapEntity("KerningPerionShopVisitBtn")
		if isvalid(kerningPerionShop) and self.KerningPerionShopClickHandler ~= nil then
			kerningPerionShop:DisconnectEvent(ButtonClickEvent, self.KerningPerionShopClickHandler)
		end
		if isvalid(kerningPerionShop) and self.KerningPerionShopTooltipEnterHandler ~= nil then
			kerningPerionShop:DisconnectEvent(UITouchEnterEvent, self.KerningPerionShopTooltipEnterHandler)
		end
		if isvalid(kerningPerionShop) and self.KerningPerionShopTooltipExitHandler ~= nil then
			kerningPerionShop:DisconnectEvent(UITouchExitEvent, self.KerningPerionShopTooltipExitHandler)
		end
		local elliniaNautilusShop = self:GetWorldMapEntity("ElliniaNautilusShopVisitBtn")
		if isvalid(elliniaNautilusShop) and self.ElliniaNautilusShopClickHandler ~= nil then
			elliniaNautilusShop:DisconnectEvent(ButtonClickEvent, self.ElliniaNautilusShopClickHandler)
		end
		if isvalid(elliniaNautilusShop) and self.ElliniaNautilusShopTooltipEnterHandler ~= nil then
			elliniaNautilusShop:DisconnectEvent(UITouchEnterEvent, self.ElliniaNautilusShopTooltipEnterHandler)
		end
		if isvalid(elliniaNautilusShop) and self.ElliniaNautilusShopTooltipExitHandler ~= nil then
			elliniaNautilusShop:DisconnectEvent(UITouchExitEvent, self.ElliniaNautilusShopTooltipExitHandler)
		end
		local perionSleepywoodShop = self:GetWorldMapEntity("PerionSleepywoodShopVisitBtn")
		if isvalid(perionSleepywoodShop) and self.PerionSleepywoodShopClickHandler ~= nil then
			perionSleepywoodShop:DisconnectEvent(ButtonClickEvent, self.PerionSleepywoodShopClickHandler)
		end
		if isvalid(perionSleepywoodShop) and self.PerionSleepywoodShopTooltipEnterHandler ~= nil then
			perionSleepywoodShop:DisconnectEvent(UITouchEnterEvent, self.PerionSleepywoodShopTooltipEnterHandler)
		end
		if isvalid(perionSleepywoodShop) and self.PerionSleepywoodShopTooltipExitHandler ~= nil then
			perionSleepywoodShop:DisconnectEvent(UITouchExitEvent, self.PerionSleepywoodShopTooltipExitHandler)
		end
		local nautilusSleepywoodShop = self:GetWorldMapEntity("NautilusSleepywoodShopVisitBtn")
		if isvalid(nautilusSleepywoodShop) and self.NautilusSleepywoodShopClickHandler ~= nil then
			nautilusSleepywoodShop:DisconnectEvent(ButtonClickEvent, self.NautilusSleepywoodShopClickHandler)
		end
		if isvalid(nautilusSleepywoodShop) and self.NautilusSleepywoodShopTooltipEnterHandler ~= nil then
			nautilusSleepywoodShop:DisconnectEvent(UITouchEnterEvent, self.NautilusSleepywoodShopTooltipEnterHandler)
		end
		if isvalid(nautilusSleepywoodShop) and self.NautilusSleepywoodShopTooltipExitHandler ~= nil then
			nautilusSleepywoodShop:DisconnectEvent(UITouchExitEvent, self.NautilusSleepywoodShopTooltipExitHandler)
		end
		local shopCloseButton = self:GetWorldMapEntity("ShopVisitPanel/ShopCloseBtn")
		if isvalid(shopCloseButton) and self.ShopCloseHandler ~= nil then
			shopCloseButton:DisconnectEvent(ButtonClickEvent, self.ShopCloseHandler)
		end
		local worldMapCloseButton = self:GetWorldMapEntity("WorldMapCloseBtn")
		if isvalid(worldMapCloseButton) and self.WorldMapCloseHandler ~= nil then
			worldMapCloseButton:DisconnectEvent(ButtonClickEvent, self.WorldMapCloseHandler)
		end
		self.ShopClickHandler = nil
		self.LowerShopClickHandler = nil
		self.KerningPerionShopClickHandler = nil
		self.ElliniaNautilusShopClickHandler = nil
		self.PerionSleepywoodShopClickHandler = nil
		self.NautilusSleepywoodShopClickHandler = nil
		self.HenesysUpperShopTooltipEnterHandler = nil
		self.HenesysUpperShopTooltipExitHandler = nil
		self.HenesysLowerShopTooltipEnterHandler = nil
		self.HenesysLowerShopTooltipExitHandler = nil
		self.KerningPerionShopTooltipEnterHandler = nil
		self.KerningPerionShopTooltipExitHandler = nil
		self.ElliniaNautilusShopTooltipEnterHandler = nil
		self.ElliniaNautilusShopTooltipExitHandler = nil
		self.PerionSleepywoodShopTooltipEnterHandler = nil
		self.PerionSleepywoodShopTooltipExitHandler = nil
		self.NautilusSleepywoodShopTooltipEnterHandler = nil
		self.NautilusSleepywoodShopTooltipExitHandler = nil
		self.ShopCloseHandler = nil
		self.WorldMapCloseHandler = nil
	end

	@ExecSpace("ClientOnly")
	method integer GetCompletedStageCount()
		-- Reads the server-synced progression owner without inventing a client-side save value.
		local player = _UserService.LocalPlayer
		if isvalid(player) == false then
			return 0
		end
		local runState = player:GetComponent("script.PlayerRunStateComponent")
		if runState == nil then
			return 0
		end
		return runState.CompletedStageCount
	end

	@ExecSpace("ClientOnly")
	method string GetSelectedWorldMapBranch()
		-- Reads the server-authoritative upper/lower route choice from synced run state.
		local player = _UserService.LocalPlayer
		if isvalid(player) == false then
			return ""
		end
		local runState = player:GetComponent("script.PlayerRunStateComponent")
		if runState == nil then
			return ""
		end
		return runState.SelectedWorldMapBranch or ""
	end

	@ExecSpace("ClientOnly")
	method void RefreshWorldMapProgress(string reason)
		-- Unlocks two mutually exclusive shop branches after Henesys: upper Kerning or lower Ellinia.
		local completedStageCount = self:GetCompletedStageCount()
		local selectedBranch = self:GetSelectedWorldMapBranch()
		self.LastObservedCompletedStageCount = completedStageCount
		self.LastObservedWorldMapBranch = selectedBranch
		local henesysNode = self:GetWorldMapEntity("HenesysCityBranchBtn")
		local kerningNode = self:GetWorldMapEntity("KerningCityBranchBtn")
		local elliniaNode = self:GetWorldMapEntity("ElliniaBranchBtn")
		for _, node in ipairs({ henesysNode, kerningNode, elliniaNode }) do
			if isvalid(node) then
				local stageButton = node:GetComponent("script.WorldMapStageButtonComponent")
				if stageButton ~= nil then
					stageButton:ResetForLobby(reason)
				end
			end
		end

		local branchAvailable = completedStageCount >= 1
		local upperAvailable = branchAvailable and (selectedBranch == "" or selectedBranch == "UPPER")
		local lowerAvailable = branchAvailable and (selectedBranch == "" or selectedBranch == "LOWER")
		self:SetWorldMapShopAvailable("ShopVisitBtn", upperAvailable)
		self:SetWorldMapShopAvailable("LowerShopVisitBtn", lowerAvailable)
		self:SetWorldMapShopAvailable("KerningPerionShopVisitBtn", false)
		self:SetWorldMapShopAvailable("ElliniaNautilusShopVisitBtn", false)
		self:SetWorldMapShopAvailable("PerionSleepywoodShopVisitBtn", false)
		self:SetWorldMapShopAvailable("NautilusSleepywoodShopVisitBtn", false)
		self:SetWorldMapEntityVisible("KerningLockText", completedStageCount < 1 or selectedBranch ~= "UPPER")
		self:SetWorldMapEntityVisible("ElliniaLock", completedStageCount < 1 or selectedBranch ~= "LOWER")
		self:SetWorldMapEntityVisible("PerionLockText", true)
		local clearBadge = self:GetWorldMapEntity("HenesysClearBadge")
		if isvalid(clearBadge) then
			clearBadge.Enable = branchAvailable
			clearBadge.Visible = branchAvailable
		end
		local statusText = self:GetWorldMapEntity("ProgressGuideText")
		if isvalid(statusText) and isvalid(statusText.TextGUIRendererComponent) then
			if completedStageCount <= 0 then
				statusText.TextGUIRendererComponent.Text = "헤네시스 1-1을 클리어하면 상점과 커닝시티가 열립니다."
			elseif selectedBranch == "" then
				statusText.TextGUIRendererComponent.Text = "위 상점은 커닝시티, 아래 상점은 엘리니아로 이어집니다. 하나를 선택하세요."
			elseif selectedBranch == "UPPER" then
				statusText.TextGUIRendererComponent.Text = "위쪽 상점을 선택했습니다. 커닝시티로 이동하세요."
			elseif selectedBranch == "LOWER" then
				statusText.TextGUIRendererComponent.Text = "아래쪽 상점을 선택했습니다. 엘리니아로 이동하세요."
			else
				statusText.TextGUIRendererComponent.Text = "선택한 경로를 확인하세요."
			end
		end
		log("[WorldMap] progression refreshed completed=" .. completedStageCount .. " branch=" .. selectedBranch .. " upper=" .. tostring(upperAvailable) .. " lower=" .. tostring(lowerAvailable) .. " reason=" .. (reason or ""))
	end

	@ExecSpace("ClientOnly")
	method void SetWorldMapShopAvailable(string relativePath, boolean available)
		-- Keeps shop hover/click input alive while visually distinguishing locked future edges.
		local entity = self:GetWorldMapEntity(relativePath)
		if isvalid(entity) and isvalid(entity.ButtonComponent) then
			entity.ButtonComponent.Enable = true
		end
		if isvalid(entity) and isvalid(entity.SpriteGUIRendererComponent) then
			if available then
				entity.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
			else
				entity.SpriteGUIRendererComponent.Color = Color(0.35, 0.35, 0.35, 0.62)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void SetWorldMapEntityVisible(string relativePath, boolean visible)
		-- Applies one lock-label visibility state without duplicating path checks.
		local entity = self:GetWorldMapEntity(relativePath)
		if isvalid(entity) then
			entity.Enable = visible
			entity.Visible = visible
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowShopRequirementTooltip(string ownerKey, string message)
		-- Uses the shared cursor tooltip for both current and future route shops.
		local tooltipUI = self:GetTooltipUI()
		if tooltipUI ~= nil then
			tooltipUI:Show(ownerKey, message)
			log("[WorldMap] shop tooltip shown owner=" .. ownerKey .. " message=" .. message)
		else
			log_warning("[WorldMap] shop tooltip unavailable owner=" .. ownerKey)
		end
	end

	@ExecSpace("ClientOnly")
	method void HideShopRequirementTooltip(string ownerKey)
		local tooltipUI = self:GetTooltipUI()
		if tooltipUI ~= nil then
			tooltipUI:Hide(ownerKey)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnHenesysUpperShopTooltipEnter()
		self:ShowShopRequirementTooltip("world_map_shop:henesys_upper", "헤네시스 클리어 필요")
	end

	@ExecSpace("ClientOnly")
	method void OnHenesysUpperShopTooltipExit()
		self:HideShopRequirementTooltip("world_map_shop:henesys_upper")
	end

	@ExecSpace("ClientOnly")
	method void OnHenesysLowerShopTooltipEnter()
		self:ShowShopRequirementTooltip("world_map_shop:henesys_lower", "헤네시스 클리어 필요")
	end

	@ExecSpace("ClientOnly")
	method void OnHenesysLowerShopTooltipExit()
		self:HideShopRequirementTooltip("world_map_shop:henesys_lower")
	end

	@ExecSpace("ClientOnly")
	method void OnKerningPerionShopTooltipEnter()
		self:ShowShopRequirementTooltip("world_map_shop:kerning_perion", "커닝시티 클리어 필요")
	end

	@ExecSpace("ClientOnly")
	method void OnKerningPerionShopTooltipExit()
		self:HideShopRequirementTooltip("world_map_shop:kerning_perion")
	end

	@ExecSpace("ClientOnly")
	method void OnElliniaNautilusShopTooltipEnter()
		self:ShowShopRequirementTooltip("world_map_shop:ellinia_nautilus", "엘리니아 클리어 필요")
