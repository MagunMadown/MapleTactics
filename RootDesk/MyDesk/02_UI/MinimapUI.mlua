@Component
script MinimapUI extends Component

	property Entity MapNameTextEntity = "50e7fb3f-8ae2-4e6c-b3be-cb02b1ad4f26"

	property Entity MapTeleportPopupEntity = "10fa65dc-6cac-43ce-b1a4-e8f8ee1a8c08"

	property Entity WorldMapBtnEntity = "a0c3e781-48da-440d-b1b8-904337b8578b"

	property any worldMapBtnHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- Connect UI events and initialize Minimap state.
		log("MinimapUI: Initializing UI component.")
		self:UpdateMapName()
		self:ConnectAllButtons()
	end

	@ExecSpace("ClientOnly")
	method void ConnectAllButtons()
		-- Connects click events for WorldMap toggle buttons and Close button.
		local worldMapBtn = _EntityService:GetEntityByPath("/ui/DefaultGroup/MinimapPanel/WorldMapButton")
		if isvalid(worldMapBtn) and not self.worldMapBtnHandler then
			self.worldMapBtnHandler = worldMapBtn:ConnectEvent(ButtonClickEvent, self.OnWorldMapBtnClick)
			log("MinimapUI: Connected WorldMapButton.")
		end
		
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- Disconnect UI event handlers on cleanup.
		local worldMapBtn = _EntityService:GetEntityByPath("/ui/DefaultGroup/MinimapPanel/WorldMapButton")
		if isvalid(worldMapBtn) and self.worldMapBtnHandler then
			worldMapBtn:DisconnectEvent(ButtonClickEvent, self.worldMapBtnHandler)
			self.worldMapBtnHandler = nil
		end
		
	end

	@ExecSpace("ClientOnly")
	method void OnMapEnter(Entity mapEntity)
		-- Updates the label and guarantees the world map is hidden outside the lobby.
		self:UpdateMapName()
		if isvalid(mapEntity) and mapEntity.Name ~= "loby" then
			self:CloseWorldMapForTransfer(mapEntity.Name)
		end
	end

	@ExecSpace("ClientOnly")
	method void UpdateMapName()
		-- Updates the map name display label on the Minimap HUD.
		local mapName = "map01"
		if isvalid(self.Entity.CurrentMap) then
			mapName = self.Entity.CurrentMap.Name
		end
		
		log("MinimapUI: Current map name is " .. mapName)
		
		local mapNameTextEntity = _EntityService:GetEntityByPath("/ui/DefaultGroup/MinimapPanel/MapNameText")
		if isvalid(mapNameTextEntity) then
			local textComp = mapNameTextEntity.TextGUIRendererComponent
			if isvalid(textComp) then
				local displayName = mapName
				if mapName == "map01" then
					displayName = "[map01] 시작 마을"
				elseif mapName == "map02" then
					displayName = "[map02] 수련장"
				end
				textComp.Text = displayName
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnWorldMapBtnClick(ButtonClickEvent event)
		-- Toggles the shared world map popup.
		log("MinimapUI: WorldMap button clicked.")
		self:ConnectAllButtons()

		local popup = _EntityService:GetEntityByPath("/ui/PopupGroup/MapTeleportPopup")
		if isvalid(popup) and popup.Enable then
			self:CloseWorldMap("QUICK_TOGGLE")
			return
		end
		self:OpenWorldMap("QUICK_BUTTON")
	end

	@ExecSpace("ClientOnly")
	method boolean OpenWorldMap(string source)
		-- Opens the shared world map through one reusable client-side boundary.
		local popupGroup = _EntityService:GetEntityByPath("/ui/PopupGroup")
		local popup = _EntityService:GetEntityByPath("/ui/PopupGroup/MapTeleportPopup")
		if isvalid(popupGroup) == false or isvalid(popup) == false then
			log_warning("[WorldMap] open failed source=" .. source .. " reason=UI_MISSING")
			return false
		end
		popupGroup.Enable = true
		popupGroup.Visible = true
		popup.Enable = true
		popup.Visible = true
		log("[WorldMap] opened source=" .. source)
		return true
	end

	@ExecSpace("ClientOnly")
	method void CloseWorldMap(string source)
		-- Closes the shared world map and its transient tooltip.
		local popup = _EntityService:GetEntityByPath("/ui/PopupGroup/MapTeleportPopup")
		if isvalid(popup) then
			popup.Enable = false
			popup.Visible = false
		end
		self:HideTooltip()
		local uiRoot = _EntityService:GetEntityByPath("/ui/DefaultGroup")
		if isvalid(uiRoot) then
			local startButton = uiRoot:GetComponent("script.LobbyStartButtonComponent")
			if startButton ~= nil then
				startButton:HandleWorldMapClosed()
			end
		end
		log("[WorldMap] closed source=" .. source)
	end

	@ExecSpace("ClientOnly")
	method void CloseWorldMapForTransfer(string targetStageId)
		-- Closes the world map for an accepted transfer without unlocking lobby input.
		local popup = _EntityService:GetEntityByPath("/ui/PopupGroup/MapTeleportPopup")
		if isvalid(popup) then
			popup.Enable = false
			popup.Visible = false
		end
		self:HideTooltip()
		log("[WorldMap] closed for transfer stage=" .. targetStageId)
	end

	@ExecSpace("ClientOnly")
	method void ShowTooltip(string text, Vector2 pos)
		-- Displays tooltip panel with specified text near target button/mouse.
		local tooltipPanel = _EntityService:GetEntityByPath("/ui/PopupGroup/MapTeleportPopup/HoverTooltipPanel")
		if isvalid(tooltipPanel) then
			tooltipPanel.Enable = true
			tooltipPanel.Visible = true
			
			if isvalid(tooltipPanel.UITransformComponent) then
				tooltipPanel.UITransformComponent.anchoredPosition = pos
			end
		end
		
		local tooltipTextEntity = _EntityService:GetEntityByPath("/ui/PopupGroup/MapTeleportPopup/HoverTooltipPanel/TooltipText")
		if isvalid(tooltipTextEntity) then
			local textComp = tooltipTextEntity.TextGUIRendererComponent
			if isvalid(textComp) then
				textComp.Text = text
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void HideTooltip()
		-- Hides the tooltip panel.
		local tooltipPanel = _EntityService:GetEntityByPath("/ui/PopupGroup/MapTeleportPopup/HoverTooltipPanel")
		if isvalid(tooltipPanel) then
			tooltipPanel.Enable = false
			tooltipPanel.Visible = false
		end
	end

end
