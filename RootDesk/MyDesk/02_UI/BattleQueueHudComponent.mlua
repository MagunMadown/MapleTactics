	property TextGUIRendererComponent SkillSlot2Label = "bc90b79c-4e8f-4299-81f8-204963e1ac3f"
	property TextGUIRendererComponent SkillSlot3Label = "1d567770-8c5d-4fce-bd4d-3927c5883427"
	property TextGUIRendererComponent SkillSlot4Label = "3a0b0b69-33e8-4bfc-a58a-a65f4fcbfc52"
