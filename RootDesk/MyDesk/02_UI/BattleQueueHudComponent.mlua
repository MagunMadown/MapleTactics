	property string SlotSkillNames = ""
	property string SlotSkillCooldownTurns = ""
	property integer CooldownPipPoolSize = 4
	property number BuffIconSpacing = 62
	property any ExecuteClickHandler = nil
	property any ResetClickHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- The view binds UI controls and consumes presentation state without reading battle components directly.
		log("[BattleQueueHUD] ready")
		self:ApplyHorizontalStateTextLayout()
		self._T.SkillIconFeedbackTimers = {}
		self._T.SkillSlotDragHandlers = {}
		self._T.SkillSlotReorderSuccessSourceIndex = 0
		self._T.SkillSlotReorderSuccessTargetIndex = 0
		self:ResetSkillSlotDragState()
		self:BuildSkillCooldownPipViews()
		self:BuildBuffBarView()
		self:SetHudContextVisible(false, "INITIALIZING")
		self.PresenterStateChangedHandler = _BattleHudPresenterLogic:ConnectEvent(BattleHudStateChangedEvent, self.OnPresenterStateChanged)
		self.PresenterCommandResultHandler = _BattleHudPresenterLogic:ConnectEvent(BattleHudCommandResultEvent, self.OnPresenterCommandResult)
		self.SkillSlot1ClickHandler = self.SkillSlot1Button.Entity:ConnectEvent(ButtonClickEvent, self.OnSkillSlot1Clicked)
		self.SkillSlot2ClickHandler = self.SkillSlot2Button.Entity:ConnectEvent(ButtonClickEvent, self.OnSkillSlot2Clicked)
		self.SkillSlot3ClickHandler = self.SkillSlot3Button.Entity:ConnectEvent(ButtonClickEvent, self.OnSkillSlot3Clicked)
		self.SkillSlot4ClickHandler = self.SkillSlot4Button.Entity:ConnectEvent(ButtonClickEvent, self.OnSkillSlot4Clicked)
		self.SkillSlot5ClickHandler = self.SkillSlot5Button.Entity:ConnectEvent(ButtonClickEvent, self.OnSkillSlot5Clicked)
		self.SkillSlot6ClickHandler = self.SkillSlot6Button.Entity:ConnectEvent(ButtonClickEvent, self.OnSkillSlot6Clicked)
		self:BindSkillSlotDragHandlers()
		self.ExecuteClickHandler = self.ExecuteButton.Entity:ConnectEvent(ButtonClickEvent, self.OnExecuteClicked)
		self.ResetClickHandler = self.ResetButton.Entity:ConnectEvent(ButtonClickEvent, self.OnResetClicked)
		self:RefreshHud(true)
	end

	@ExecSpace("ClientOnly")
	method void ApplyHorizontalStateTextLayout()
		-- Force the shared status label to remain a single horizontal strip on every battle map.
		if self.StateText == nil or self.StateText.Entity == nil then
			return
		end
		local transform = self.StateText.Entity.UITransformComponent
		if transform ~= nil then
			transform.RectSize = Vector2(math.max(1, self.StateTextWidth), math.max(1, self.StateTextHeight))
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		self:HideSkillHover()
		-- Disconnects button callbacks so UI reloads cannot duplicate tile requests.
		for slotIndex = 1, 6 do
			self:StopSkillIconFeedback(slotIndex)
		end
		if self.InputFeedbackTimerId > 0 then
			_TimerService:ClearTimer(self.InputFeedbackTimerId)
			self.InputFeedbackTimerId = 0
		end
		self.InputFeedbackText = ""
		self:DestroyBuffIconViews()
		self:DisconnectSkillSlotDragHandlers()
		self:CleanupSkillSlotDragVisuals(false)
		if self.SkillSlotReorderPendingTimerId > 0 then
			_TimerService:ClearTimer(self.SkillSlotReorderPendingTimerId)
			self.SkillSlotReorderPendingTimerId = 0
		end
		if self.PresenterStateChangedHandler ~= nil then
			_BattleHudPresenterLogic:DisconnectEvent(BattleHudStateChangedEvent, self.PresenterStateChangedHandler)
			self.PresenterStateChangedHandler = nil
		end
		if self.PresenterCommandResultHandler ~= nil then
			_BattleHudPresenterLogic:DisconnectEvent(BattleHudCommandResultEvent, self.PresenterCommandResultHandler)
			self.PresenterCommandResultHandler = nil
		end
		if self.SkillSlot1ClickHandler ~= nil then
			self.SkillSlot1Button.Entity:DisconnectEvent(ButtonClickEvent, self.SkillSlot1ClickHandler)
			self.SkillSlot1ClickHandler = nil
		end
		if self.SkillSlot2ClickHandler ~= nil then
			self.SkillSlot2Button.Entity:DisconnectEvent(ButtonClickEvent, self.SkillSlot2ClickHandler)
			self.SkillSlot2ClickHandler = nil
		end
		if self.SkillSlot3ClickHandler ~= nil then
			self.SkillSlot3Button.Entity:DisconnectEvent(ButtonClickEvent, self.SkillSlot3ClickHandler)
			self.SkillSlot3ClickHandler = nil
		end
		if self.SkillSlot4ClickHandler ~= nil then
			self.SkillSlot4Button.Entity:DisconnectEvent(ButtonClickEvent, self.SkillSlot4ClickHandler)
			self.SkillSlot4ClickHandler = nil
		end
		if self.SkillSlot5ClickHandler ~= nil then
			self.SkillSlot5Button.Entity:DisconnectEvent(ButtonClickEvent, self.SkillSlot5ClickHandler)
			self.SkillSlot5ClickHandler = nil
		end
		if self.SkillSlot6ClickHandler ~= nil then
			self.SkillSlot6Button.Entity:DisconnectEvent(ButtonClickEvent, self.SkillSlot6ClickHandler)
			self.SkillSlot6ClickHandler = nil
		end
		if self.ExecuteClickHandler ~= nil then
			self.ExecuteButton.Entity:DisconnectEvent(ButtonClickEvent, self.ExecuteClickHandler)
			self.ExecuteClickHandler = nil
		end
		if self.ResetClickHandler ~= nil then
			self.ResetButton.Entity:DisconnectEvent(ButtonClickEvent, self.ResetClickHandler)
			self.ResetClickHandler = nil
		end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- Keep buff and hover refresh under one client lifecycle callback.
		self:RefreshBuffBar()
		self._T.SkillHoverElapsed = (self._T.SkillHoverElapsed or 0) + delta
		if self._T.SkillHoverElapsed < 0.15 then return end
		self._T.SkillHoverElapsed = 0
		if not self.IsHudContextVisible or self._T.SkillSlotDragActive or self.IsMapTransferPending then self:HideSkillHover() return end
		local player = _UserService.LocalPlayer
		if not isvalid(player) or not isvalid(player.CurrentMap) then self:HideSkillHover() return end
		local session = player.CurrentMap:GetComponent("script.BattleSessionComponent")
		if session == nil or session.BattleResult ~= "" then self:HideSkillHover() return end
		local cursor = _InputService:GetCursorPosition()
		local skillId = ""
		for index = 1, 6 do
			local button = self:GetSkillSlotButton(index)
			if button ~= nil and button.Entity.EnabledInHierarchy then
				local transform = button.Entity.UITransformComponent
				local point = _UILogic:ScreenToLocalUIPosition(cursor, transform)
				local half = transform.RectSize * 0.5
				if math.abs(point.x) <= half.x and math.abs(point.y) <= half.y then skillId = self:GetSlotSkillId(index) break end
			end
		end
		if skillId == "" then self:HideSkillHover() return end
		local root = _EntityService:GetEntityByPath("/ui/MouseTooltipGroup")
		local tooltip = isvalid(root) and root:GetComponent("script.MouseTooltipUIComponent") or nil
		if tooltip == nil then return end
		local unit = player:GetComponent("script.BattleUnitComponent")
		local signature = tostring(session.EntryRequestId) .. ":" .. tostring(session.TurnNumber) .. ":" .. tostring(session.EnemyPlanRevision) .. ":" .. tostring(session.SkillSlotRevision)
			.. ":" .. tostring(unit ~= nil and unit.CellIndex or -1) .. ":" .. tostring(unit ~= nil and unit.Facing or "")
		tooltip:RequestSkillHover(player.CurrentMap, skillId, signature)
	end

	@ExecSpace("ClientOnly")
	method void HideSkillHover()
		local root = _EntityService:GetEntityByPath("/ui/MouseTooltipGroup")
		local tooltip = isvalid(root) and root:GetComponent("script.MouseTooltipUIComponent") or nil
		if tooltip ~= nil and tooltip.ActiveOwnerKey == "battle_skill" then tooltip:Hide("battle_skill") end
	end

	@ExecSpace("ClientOnly")
	method void RefreshHud(boolean force)
		-- Renders the latest Presenter snapshot; this view has no map/session/runtime dependencies.
		local presenterState = _BattleHudPresenterLogic:GetCurrentState()
		if self.IsMapTransferPending then
			local player = _UserService.LocalPlayer
			local currentMapName = ""
			if isvalid(player) and isvalid(player.CurrentMap) then
				currentMapName = player.CurrentMap.Name
			end
			local localSession = _BattleHudPresenterLogic:GetBattleSession()
			local destinationReady = false
			if presenterState ~= nil and presenterState.ContextReason ~= "MAP_TRANSFER_PENDING" then
				if localSession == nil and currentMapName ~= "" and currentMapName ~= self.MapTransferSourceMapName then
					destinationReady = true
				elseif localSession ~= nil and presenterState.Success == true and presenterState.Session ~= nil
					and presenterState.Session.MapId == player.CurrentMap.Id
					and presenterState.Session.EntryRequestId == localSession.EntryRequestId
					and presenterState.Session.HudContextRevision == localSession.HudContextRevision
					and presenterState.UiState ~= nil and presenterState.UiState.BattleResult == "" then
					destinationReady = true
				end
			end
			if destinationReady == false then
				self:SetHudContextVisible(false, "MAP_TRANSFER_PENDING")
				return
			end
			self.IsMapTransferPending = false
			self.MapTransferSourceMapName = ""
			log("[BattleQueueHUD] map transfer lock released map=" .. currentMapName)
		end
		if presenterState == nil or presenterState.Success == false or presenterState.ContextVisible == false then
			local reason = presenterState == nil and "PRESENTER_STATE_MISSING" or presenterState.ContextReason
			self.HasQueueFeedbackSnapshot = false
			self.LastQueuedTileIds = ""
			self:SetHudContextVisible(false, reason)
			self:SetUnavailableState("전투 상태 없음")
			return
		end
		local session = presenterState.Session
		local turnState = presenterState.Turn
		local waveState = presenterState.Wave
		local uiState = presenterState.UiState
		self:ConsumeSkillSlotReorderReceipt(session)
		self:SetHudContextVisible(true, "BATTLE_CONTEXT_READY")
		local queueState = uiState.PlayerQueue
		local runFlowUi = presenterState.RunFlowUi
		local runFlowRevision = ""
		if runFlowUi ~= nil and runFlowUi.Success == true then
			runFlowRevision = runFlowUi.RevisionKey
		end

		local phaseLabel = self:GetPhaseLabel(uiState.Phase)
		local visibleQueue = queueState.QueuedTileIds
		local activeIndex = 0
		if queueState.ExecutingTileIds ~= "" then
			visibleQueue = queueState.ExecutingTileIds
			activeIndex = queueState.ExecutingIndex
		end
		local slotQueueIds = queueState.QueuedTileIds
		if queueState.ExecutingTileIds ~= "" then
			slotQueueIds = self:GetQueueFromIndex(queueState.ExecutingTileIds, activeIndex)
		end
		local queueLabel = self:GetQueueLabel(visibleQueue, activeIndex, queueState.EffectiveCapacity)
		local inputLabel = self:GetPlayerActionStateLabel(uiState.PlayerActionState, activeIndex, visibleQueue, queueState)
		if uiState.RunInventory.HealUnlimited then
			inputLabel = inputLabel .. " · 힐 ∞"
		elseif (uiState.RunInventory.HealCharges or -1) >= 0 then
			inputLabel = inputLabel .. " · 힐 " .. tostring(uiState.RunInventory.HealCharges) .. "/5"
		end
		if uiState.PlayerSealed == true then inputLabel = "봉인 · 이동/방향 전환 또는 정화로 해제" end
		if (uiState.PoisonMistCells or "") ~= "" then inputLabel = inputLabel .. " · 독안개: 표시된 칸을 피하세요" end
		if uiState.Phase == "WaveTransition" then
			inputLabel = "다음 웨이브 준비"
		end

		if uiState.BattleResult ~= "" then
			inputLabel = "전투 종료"
			queueLabel = uiState.BattleResult == "Victory" and "승리" or "패배"
		end
		local transitionLabel = ""
		if uiState.BattleResult == "Victory" then
			transitionLabel = self:GetRunTransitionLabel(runFlowUi)
		end

		local enemyIntentLabel = self:GetEnemyIntentCompactLabel(uiState)
		local cooldownSnapshot = uiState.CooldownSnapshot
		local iconSnapshot = session.SkillIconSnapshot or ""
		local signature = presenterState.RevisionKey .. ":" .. runFlowRevision .. ":" .. iconSnapshot .. ":" .. tostring(uiState.RunInventory.HealCharges or -1) .. ":" .. tostring(uiState.RunInventory.HealUnlimited) .. ":" .. tostring(_GameSettingsLogic.Revision)
		if force == false and self.LastSignature == signature then
			return
		end

		self.LastSignature = signature
		self._T.HealCharges = uiState.RunInventory.HealCharges or -1
		self._T.HealUnlimited = uiState.RunInventory.HealUnlimited
		self:SyncIconSnapshot(iconSnapshot)
		self.TurnText.Text = "턴 " .. uiState.TurnNumber
		self.QueueText.Text = queueLabel
		-- StateText is a narrow one-line HUD slot. Keep only turn-critical information here;
		-- detailed cooldown/drop/inventory snapshots remain available from GetBattleUiState.
		self.StateText.Text = "스테이지 " .. session.StageNumber .. "  ·  웨이브 " .. waveState.CurrentWave .. "/" .. waveState.TotalWaves .. "  ·  " .. phaseLabel .. "  ·  " .. inputLabel
		if enemyIntentLabel ~= "" then
			self.StateText.Text = self.StateText.Text .. "  ·  " .. enemyIntentLabel
		end
		if transitionLabel ~= "" then
			self.StateText.Text = "이동 이벤트  ·  " .. transitionLabel
		end
		if self.InputFeedbackText ~= "" then
			self.StateText.Text = self.InputFeedbackText
		end

		local canChooseTile = uiState.Commands.CanQueue
		local canUseQueuedTile = uiState.Commands.CanExecute
		local ownedSkills = uiState.RunInventory.SkillSnapshot
		self.SlotSkillIds = session.SkillSlotIds
		self.SlotSkillNames = session.SkillSlotNames
		self.SlotSkillCooldownTurns = session.SkillSlotCooldownTurns or ""
		local queuedSkillForPop = self:CaptureQueuedSkillForFeedback(queueState.QueuedTileIds)
		self:RefreshSkillSlots(canChooseTile, ownedSkills, cooldownSnapshot, slotQueueIds)
		if self._T.SkillSlotDragActive == true then
			self:ApplySkillSlotDragSourceTreatment()
			if self._T.SkillSlotDragLastTouchPoint ~= nil then
				self:UpdateSkillSlotDragDestination(self._T.SkillSlotDragLastTouchPoint)
			else
				self:SetSkillSlotDragTarget(self._T.SkillSlotDragHoverIndex)
			end
		end
		self:ConsumeSkillSlotReorderSuccessFeedback()
		if queuedSkillForPop ~= "" then
			local queuedSlotIndex = self:FindSkillSlotIndex(queuedSkillForPop)
			if queuedSlotIndex > 0 then
				self:PlayQueueIconPop(queuedSlotIndex, queuedSkillForPop)
			end
		end
		self.ExecuteButton.Enable = canUseQueuedTile
		self.CanClearQueue = uiState.Commands.CanClear
		if visibleQueue == "" then
			self.QueueSlotSprite.Color = Color(0.15, 0.20, 0.28, 1)
		elseif activeIndex > 0 then
			self.QueueSlotSprite.Color = Color(0.22, 0.40, 0.24, 1)
		else
			self.QueueSlotSprite.Color = Color(0.38, 0.30, 0.12, 1)
		end
		self:SetResultVisibility(uiState.BattleResult, session.StageId, uiState.UnionReward)

	end

	@ExecSpace("ClientOnly")
	method void OnPresenterStateChanged(BattleHudStateChangedEvent stateChangedEvent)
		self:RefreshHud(true)
	end

	@ExecSpace("ClientOnly")
	method void OnPresenterCommandResult(BattleHudCommandResultEvent commandResultEvent)
		log("[BattleQueueHUD] command result type=" .. commandResultEvent.CommandType .. " success=" .. tostring(commandResultEvent.Success) .. " reason=" .. commandResultEvent.Reason .. " revision=" .. tostring(commandResultEvent.Revision))
		self:ShowInputFeedback(commandResultEvent.CommandType, commandResultEvent.Success, commandResultEvent.Reason)
	end

	@ExecSpace("ClientOnly")
	method string GetPlayerActionStateLabel(string playerActionState, integer activeIndex, string visibleQueue, table queueState)
		if playerActionState == "MOVING" then
			return "이동 중"
		elseif playerActionState == "TURNING" then
			return "방향 전환 중"
		elseif playerActionState == "EXECUTING_ATTACK" then
			return "공격 실행 중 " .. activeIndex .. "/" .. self:GetTileCount(visibleQueue)
		elseif playerActionState == "WAITING_ENEMY_TURN" then
			return "적 행동 대기"
		elseif playerActionState == "PREPARING_ATTACK" then
			return queueState.Count .. "/" .. queueState.EffectiveCapacity .. " · 공격 준비"
		elseif playerActionState == "READY" then
			return "입력 가능"
		end
		return "행동 잠금"
	end

	@ExecSpace("ClientOnly")
	method void ShowInputFeedback(string commandType, boolean success, string reason)
		if self.InputFeedbackTimerId > 0 then
			_TimerService:ClearTimer(self.InputFeedbackTimerId)
			self.InputFeedbackTimerId = 0
		end

		local commandLabel = commandType
		if commandType == "MOVE" then
			commandLabel = "이동"
		elseif commandType == "TURN" then
			commandLabel = "방향 전환"
		elseif commandType == "QUEUE_TILE" then
			commandLabel = "공격 준비"
		elseif commandType == "EXECUTE_QUEUE" then
			commandLabel = "공격 실행"
		elseif commandType == "UTILITY" then
			commandLabel = "고유 스킬"
		end

		if success == true and reason == "INPUT_RECEIVED" then
			self.InputFeedbackText = "입력 확인  ·  " .. commandLabel
			self.SkillSlot1Button.Enable = false
			self.SkillSlot2Button.Enable = false
			self.SkillSlot3Button.Enable = false
			self.SkillSlot4Button.Enable = false
			self.SkillSlot5Button.Enable = false
			self.SkillSlot6Button.Enable = false
			self.ExecuteButton.Enable = false
			self.CanClearQueue = false
		elseif success == true then
			self.InputFeedbackText = "처리 확인  ·  " .. commandLabel
		elseif reason == "LOCAL_INPUT_PENDING" then
			self.InputFeedbackText = "행동 처리 중  ·  추가 입력 차단"
		elseif string.find(reason or "", "WAITING_ENEMY_TURN", 1, true) ~= nil then
			self.InputFeedbackText = "적 행동 중  ·  입력 차단"
		elseif reason == "PLAYER_SEALED" then
			self.InputFeedbackText = "봉인 상태 · 이동/방향 전환 또는 정화로 해제"
		elseif reason == "QUEUE_EMPTY" then
			self.InputFeedbackText = "실행할 공격이 없습니다"
		else
			self.InputFeedbackText = "입력 거절  ·  " .. tostring(reason)
		end

		self.StateText.Text = self.InputFeedbackText
		local clearFeedback = function()
			self.InputFeedbackTimerId = 0
			self.InputFeedbackText = ""
			self:RefreshHud(true)
		end
		self.InputFeedbackTimerId = _TimerService:SetTimerOnce(clearFeedback, math.max(0.20, self.InputFeedbackDuration))
	end

	@ExecSpace("ClientOnly")
	method void SetHudContextVisible(boolean visible, string reason)
		-- Keeps the UIGroup and controller alive while hiding only battle-specific content outside battle maps.
		if self.QueuePanelEntity ~= nil then
			self.QueuePanelEntity.Enable = visible
		end
		if visible == false and self.ResultPanelEntity ~= nil then
			_GameUIPolishLogic:HideWindowImmediately(self.ResultPanelEntity)
		end
		if self.HasHudContextState and self.IsHudContextVisible == visible then
			return
		end

		self.HasHudContextState = true
		self.IsHudContextVisible = visible
		log("[BattleQueueHUD] context visible=" .. tostring(visible) .. " reason=" .. tostring(reason))
	end

	@ExecSpace("ClientOnly")
	method void PrepareForMapTransfer(string source)
		-- Clears persistent battle HUD state before the local player receives the destination map.
		local player = _UserService.LocalPlayer
		self.MapTransferSourceMapName = ""
		if isvalid(player) and isvalid(player.CurrentMap) then
			self.MapTransferSourceMapName = player.CurrentMap.Name
		end
		self.IsMapTransferPending = true
		_BattleHudPresenterLogic:PrepareForMapTransfer()
		if self.InputFeedbackTimerId > 0 then
			_TimerService:ClearTimer(self.InputFeedbackTimerId)
			self.InputFeedbackTimerId = 0
		end
		self.InputFeedbackText = ""
		self.HasQueueFeedbackSnapshot = false
		self.LastQueuedTileIds = ""
		self:SetResultVisibility("", "", nil)
		self:SetHudContextVisible(false, "MAP_TRANSFER_" .. (source or "UNSPECIFIED"))
		log("[BattleQueueHUD] prepared for map transfer source=" .. (source or "UNSPECIFIED") .. " map=" .. self.MapTransferSourceMapName)
	end

	@ExecSpace("ClientOnly")
	method void SetUnavailableState(string reason)
		-- Shows a safe inactive state until the local player and map session are available.
		local signature = "Unavailable:" .. reason
		if self.LastSignature == signature then
			return
		end

		self.LastSignature = signature
		self.TurnText.Text = "TURN -"
		self.QueueText.Text = "전투 대기"
		self.StateText.Text = reason
		self.SkillSlot1Button.Enable = false
		self.SkillSlot2Button.Enable = false
		self.SkillSlot3Button.Enable = false
		self.SkillSlot4Button.Enable = false
		self.SkillSlot5Button.Enable = false
		self.SkillSlot6Button.Enable = false
		self:HideAllSkillCooldownTexts()
		self:HideAllSkillCooldownPips()
		self.ExecuteButton.Enable = false
		self.CanClearQueue = false
		self:SetResultVisibility("", "", nil)
		log("[BattleQueueHUD] unavailable reason=" .. reason)
	end

	@ExecSpace("ClientOnly")
	method void SetResultVisibility(string battleResult, string stageId, table unionReward)
		-- Shows the receipt after the final death presentation, keeping it visible during transfer.
		local hasCommittedReward = unionReward ~= nil and unionReward.WasCommitted == true and unionReward.RunEnded == true
		local visible = self.IsHudContextVisible and (battleResult == "Defeat" or battleResult == "Victory")
		local session = _BattleHudPresenterLogic:GetBattleSession()
		if self._T.ResultEntryId ~= (session ~= nil and session.EntryRequestId or "") then
			self._T.ResultEntryId = session ~= nil and session.EntryRequestId or ""
			self._T.ResultShown = false
		end
		if visible == false then self._T.ResultShown = false end
		if visible and session ~= nil and session.ResultReady then self._T.ResultShown = true end
		visible = visible and self._T.ResultShown == true
		local rewardVisible = visible and hasCommittedReward
		local lobbyReturnVisible = visible
		if self.ResultPanelEntity ~= nil then
			if visible then
				if self.ResultPanelEntity.Enable == false then _GameUIPolishLogic:SetWindowVisible(self.ResultPanelEntity, true) end
			else
				_GameUIPolishLogic:HideWindowImmediately(self.ResultPanelEntity)
			end
		end
		self.ResultPanelSprite.Enable = visible
		self.ResultText.Enable = visible
		self.UnionRewardText.Enable = rewardVisible
		self.UnionRewardBreakdownText.Enable = rewardVisible
		self.ResetButton.Enable = lobbyReturnVisible and session ~= nil and session.ResultReady
		self.ResetButtonSprite.Enable = lobbyReturnVisible
		self.ResetButtonText.Enable = lobbyReturnVisible
		if visible then
			local summary = _EntityService:GetEntityByPath("/ui/BattleQueueHUD/ResultPanel/Summary")
			if isvalid(summary) and session ~= nil then
				local stageName = _EntityService:GetEntityByPath("/ui/BattleQueueHUD/ResultPanel/StageName")
				if isvalid(stageName) then stageName.TextGUIRendererComponent.Text = session.StageDisplayName end
				summary.TextGUIRendererComponent.Text = "처치  " .. tostring(session.ResultKillCount) .. "마리    ·    소요 시간  " .. string.format("%02d:%02d", math.floor(session.ResultElapsedSeconds / 60), session.ResultElapsedSeconds % 60)
			end
			self:RenderRoundRewards(session, rewardVisible)
			self.ResultText.Text = battleResult == "Victory" and "전투 승리" or "전투 종료"
			if rewardVisible then
				self.UnionRewardText.Text = "이번 런 정산 · 유니온 코인 +" .. tostring(unionReward.FinalUnionPoints or 0)
				self.UnionRewardBreakdownText.Text = "기본 +" .. tostring(unionReward.BaseUnionPoints or 0) .. "    유니온 보너스 +" .. tostring(unionReward.BonusUnionPoints or 0)
			end
			if lobbyReturnVisible then
				self.ResetButtonText.Text = session ~= nil and session.ResultReady and ((battleResult == "Defeat" or hasCommittedReward) and "로비로 돌아가기" or "보상 확인 · 다음으로") or "처리 중..."
			end
		end
		if battleResult ~= "" then
			log("[BattleQueueHUD] result visibility stage=" .. tostring(stageId) .. " result=" .. battleResult .. " rewardVisible=" .. tostring(rewardVisible) .. " lobbyReturnVisible=" .. tostring(lobbyReturnVisible))
		end
	end

	@ExecSpace("ClientOnly")
	method string GetRunTransitionLabel(table runFlowUi)
		-- Presents the prepared run transition without moving maps or interpreting NodeDefinitions in UI code.
		if runFlowUi == nil or runFlowUi.Success == false then
			return "다음 콘텐츠 확인 중"
		end
		local contentType = runFlowUi.Transition.ContentType
		if contentType == nil or contentType == "" then
			contentType = self:GetFirstSnapshotValue(runFlowUi.AvailableContentTypes)
		end
		local destinationLabel = "다음 콘텐츠"
		if contentType == "SHOP" then
			destinationLabel = "상점"
		elseif contentType == "BATTLE" or contentType == "BOSS" then
			destinationLabel = "다음 전투"
		elseif contentType == "EVENT" then
			destinationLabel = "이벤트"
		elseif contentType == "REST" then
			destinationLabel = "휴식"
		elseif runFlowUi.RunFlowState == "RUN_COMPLETED" then
			return "런을 완료했습니다"
		end
		return destinationLabel .. "으로 이동합니다"
	end

	@ExecSpace("ClientOnly")
	method string GetFirstSnapshotValue(string snapshot)
		for value in string.gmatch(snapshot or "", "([^|]+)") do
			return value
		end
		return ""
	end

	@ExecSpace("ClientOnly")
	method integer GetCooldownTurns(string cooldownSnapshot, string skillId)
		for entry in string.gmatch(cooldownSnapshot, "([^|]+)") do
			local entrySkillId = string.match(entry, "^([^:]+):")
			local remainingTurns = string.match(entry, ":(%d+)$")
			if entrySkillId == skillId then
				return math.max(0, math.floor(tonumber(remainingTurns) or 0))
			end
		end
		return 0
	end

	@ExecSpace("ClientOnly")
	method string GetCooldownLabel(string cooldownSnapshot)
		if cooldownSnapshot == "" then
			return "쿨타임 준비"
		end
		local labels = {}
		for entry in string.gmatch(cooldownSnapshot, "([^|]+)") do
			local skillId = string.match(entry, "^([^:]+):")
			local remainingTurns = string.match(entry, ":(%d+)$")
			if skillId ~= nil then
				table.insert(labels, self:GetTileLabel(skillId) .. " " .. remainingTurns)
			end
		end
		if #labels == 0 then
			return "쿨타임 준비"
		end
		return "CD " .. table.concat(labels, ", ")
	end

	@ExecSpace("ClientOnly")
	method boolean QueueContainsSkill(string serializedQueue, string skillId)
		for queuedSkillId in string.gmatch(serializedQueue, "([^|]+)") do
			if queuedSkillId == skillId then
				return true
			end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method integer GetQueueOrder(string serializedQueue, string skillId)
		local queueOrder = 0
		for queuedSkillId in string.gmatch(serializedQueue or "", "([^|]+)") do
			queueOrder = queueOrder + 1
			if queuedSkillId == skillId then
				return queueOrder
			end
		end
		return 0
	end

	@ExecSpace("ClientOnly")
	method boolean IsSkillOwned(string skillSnapshot, string skillId)
		-- Reads the TargetUserSync id~amount ownership DTO without duplicating server authority.
		for entry in string.gmatch(skillSnapshot or "", "([^|]+)") do
			local separator, _ = string.find(entry, "~", 1, true)
			if separator ~= nil and string.sub(entry, 1, separator - 1) == skillId then
				return (tonumber(string.sub(entry, separator + 1)) or 0) > 0
			end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method string GetFixedSkillSlotToken(string snapshot, integer slotIndex)
		if slotIndex < 1 or slotIndex > 6 then
			return ""
		end
		local serialized = snapshot or ""
		local startIndex = 1
		for currentIndex = 1, slotIndex do
			local separatorIndex, _ = string.find(serialized, "|", startIndex, true)
			if separatorIndex == nil then
				if currentIndex == slotIndex then
					return string.sub(serialized, startIndex)
				end
				return ""
			end
			if currentIndex == slotIndex then
				return string.sub(serialized, startIndex, separatorIndex - 1)
			end
			startIndex = separatorIndex + 1
		end
		return ""
	end

	@ExecSpace("ClientOnly")
	method string GetSlotSkillId(integer slotIndex)
		-- Slots are assigned server-side from the owned skill set, so the HUD only reads the assignment.
		return self:GetFixedSkillSlotToken(self.SlotSkillIds, slotIndex)
	end

	@ExecSpace("ClientOnly")
	method integer FindSkillSlotIndex(string skillId)
		for slotIndex = 1, 6 do
			if self:GetSlotSkillId(slotIndex) == skillId then
				return slotIndex
			end
		end
		return 0
	end

	@ExecSpace("ClientOnly")
	method string CaptureQueuedSkillForFeedback(string queuedTileIds)
		-- Only an authoritative Queue growth produces the confirmation pop; initial hydration and clears stay silent.
		local currentQueue = queuedTileIds or ""
		if self.HasQueueFeedbackSnapshot == false then
			self.HasQueueFeedbackSnapshot = true
			self.LastQueuedTileIds = currentQueue
			return ""
		end

		local previousCount = self:GetTileCount(self.LastQueuedTileIds)
		local currentCount = self:GetTileCount(currentQueue)
		self.LastQueuedTileIds = currentQueue
		if currentCount <= previousCount then
			return ""
		end

		local index = 0
		local queuedSkillId = ""
		for skillId in string.gmatch(currentQueue, "([^|]+)") do
			index = index + 1
			if index == currentCount then
				queuedSkillId = skillId
			end
		end
		return queuedSkillId
	end

	@ExecSpace("ClientOnly")
	method SpriteGUIRendererComponent GetSkillIcon(integer slotIndex)
		if slotIndex == 1 then
			return self.SkillSlot1Icon
		elseif slotIndex == 2 then
			return self.SkillSlot2Icon
		elseif slotIndex == 3 then
			return self.SkillSlot3Icon
		elseif slotIndex == 4 then
			return self.SkillSlot4Icon
		elseif slotIndex == 5 then
			return self.SkillSlot5Icon
		elseif slotIndex == 6 then
			return self.SkillSlot6Icon
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method ButtonComponent GetSkillSlotButton(integer slotIndex)
		if slotIndex == 1 then return self.SkillSlot1Button end
		if slotIndex == 2 then return self.SkillSlot2Button end
		if slotIndex == 3 then return self.SkillSlot3Button end
		if slotIndex == 4 then return self.SkillSlot4Button end
		if slotIndex == 5 then return self.SkillSlot5Button end
		if slotIndex == 6 then return self.SkillSlot6Button end
		return nil
	end

	@ExecSpace("ClientOnly")
	method SpriteGUIRendererComponent GetSkillSlotDragTargetHighlight(integer slotIndex)
		if slotIndex == 1 then return self.SkillSlot1DragTargetHighlight end
		if slotIndex == 2 then return self.SkillSlot2DragTargetHighlight end
		if slotIndex == 3 then return self.SkillSlot3DragTargetHighlight end
		if slotIndex == 4 then return self.SkillSlot4DragTargetHighlight end
		if slotIndex == 5 then return self.SkillSlot5DragTargetHighlight end
		if slotIndex == 6 then return self.SkillSlot6DragTargetHighlight end
		return nil
	end

	@ExecSpace("ClientOnly")
	method integer ResolveSkillSlotIndex(Entity slotEntity)
		if isvalid(slotEntity) == false then
			return 0
		end
		for slotIndex = 1, 6 do
			local button = self:GetSkillSlotButton(slotIndex)
			if button ~= nil and button.Entity == slotEntity then
				return slotIndex
			end
		end
		return 0
	end

	@ExecSpace("ClientOnly")
	method void BindSkillSlotDragHandlers()
		for slotIndex = 1, 6 do
			local button = self:GetSkillSlotButton(slotIndex)
			if button ~= nil and isvalid(button.Entity) then
				local slotEntity = button.Entity
				table.insert(self._T.SkillSlotDragHandlers, {
					Entity = slotEntity,
					BeginDrag = slotEntity:ConnectEvent(UITouchBeginDragEvent, self.OnSkillSlotBeginDrag),
					Drag = slotEntity:ConnectEvent(UITouchDragEvent, self.OnSkillSlotDrag),
					EndDrag = slotEntity:ConnectEvent(UITouchEndDragEvent, self.OnSkillSlotEndDrag),
					Enter = slotEntity:ConnectEvent(UITouchEnterEvent, self.OnSkillSlotDragEnter),
					Exit = slotEntity:ConnectEvent(UITouchExitEvent, self.OnSkillSlotDragExit)
				})
			end
		end
		log("[BattleSkillSlotDrag] handlers bound count=" .. tostring(#self._T.SkillSlotDragHandlers))
	end

	@ExecSpace("ClientOnly")
	method void DisconnectSkillSlotDragHandlers()
		local handlers = self._T.SkillSlotDragHandlers or {}
		for index = 1, #handlers do
			local record = handlers[index]
			if record ~= nil and isvalid(record.Entity) then
				if record.BeginDrag ~= nil then record.Entity:DisconnectEvent(UITouchBeginDragEvent, record.BeginDrag) end
				if record.Drag ~= nil then record.Entity:DisconnectEvent(UITouchDragEvent, record.Drag) end
				if record.EndDrag ~= nil then record.Entity:DisconnectEvent(UITouchEndDragEvent, record.EndDrag) end
				if record.Enter ~= nil then record.Entity:DisconnectEvent(UITouchEnterEvent, record.Enter) end
				if record.Exit ~= nil then record.Entity:DisconnectEvent(UITouchExitEvent, record.Exit) end
			end
		end
		self._T.SkillSlotDragHandlers = {}
	end

	@ExecSpace("ClientOnly")
	method void ResetSkillSlotDragState()
		self._T.SkillSlotDragCandidate = false
		self._T.SkillSlotDragActive = false
		self._T.SkillSlotDragSourceIndex = 0
		self._T.SkillSlotDragHoverIndex = 0
		self._T.SkillSlotDragDestinationType = "INVALID"
		self._T.SkillSlotDragTouchId = 0
		self._T.SkillSlotDragDistance = 0
		self._T.SkillSlotDragExpectedRevision = 0
		self._T.SkillSlotDragLastTouchPoint = nil
		self._T.SkillSlotDragCancelling = false
	end

	@ExecSpace("ClientOnly")
	method boolean CanBeginSkillSlotDrag(integer slotIndex)
		if self.PendingSkillSlotReorderRequestId > 0
			or self._T.SkillSlotDragCancelling == true
			or (_UtilLogic.ElapsedSeconds or 0) < self.SuppressSkillDragUntil
			or self:GetSlotSkillId(slotIndex) == "" then
			return false
		end
		local presenterState = _BattleHudPresenterLogic:GetCurrentState()
		if presenterState == nil or presenterState.Success == false or presenterState.ContextVisible == false then
			return false
		end
		local uiState = presenterState.UiState
		return uiState ~= nil and uiState.Commands ~= nil and uiState.Commands.CanMove == true
	end

	@ExecSpace("ClientOnly")
	method integer GetCurrentSkillSlotRevision()
		local presenterState = _BattleHudPresenterLogic:GetCurrentState()
		if presenterState == nil or presenterState.Session == nil then
			return 0
		end
		return presenterState.Session.SkillSlotRevision or 0
	end

	@ExecSpace("ClientOnly")
	method void OnSkillSlotBeginDrag(UITouchBeginDragEvent dragEvent)
		local sourceIndex = self:ResolveSkillSlotIndex(dragEvent.Entity)
		if sourceIndex <= 0 or (dragEvent.TouchId ~= -1 and dragEvent.TouchId <= 0) or self:CanBeginSkillSlotDrag(sourceIndex) == false then
			return
		end
		self:CleanupSkillSlotDragVisuals(false)
		self._T.SkillSlotDragCandidate = true
		self._T.SkillSlotDragSourceIndex = sourceIndex
		self._T.SkillSlotDragHoverIndex = sourceIndex
		self._T.SkillSlotDragTouchId = dragEvent.TouchId
		self._T.SkillSlotDragDistance = 0
		self._T.SkillSlotDragExpectedRevision = self:GetCurrentSkillSlotRevision()
		self._T.SkillSlotDragLastTouchPoint = dragEvent.TouchPoint
		local overheadQueueHud = self:GetOverheadQueueHud()
		if overheadQueueHud ~= nil then
			overheadQueueHud:SetBottomSkillDragPresentationActive(true)
		end
		log("[BattleSkillSlotDrag] begin candidate source=" .. tostring(sourceIndex) .. " touch=" .. tostring(dragEvent.TouchId) .. " revision=" .. tostring(self._T.SkillSlotDragExpectedRevision))
	end

	@ExecSpace("ClientOnly")
	method void OnSkillSlotDrag(UITouchDragEvent dragEvent)
		if self._T.SkillSlotDragCandidate ~= true or dragEvent.TouchId ~= self._T.SkillSlotDragTouchId then
			return
		end
		local delta = dragEvent.TouchDelta
		self._T.SkillSlotDragLastTouchPoint = dragEvent.TouchPoint
		self._T.SkillSlotDragDistance = self._T.SkillSlotDragDistance + math.sqrt(delta.x * delta.x + delta.y * delta.y)
		if self._T.SkillSlotDragActive ~= true then
			if self._T.SkillSlotDragDistance < self.SkillSlotDragThreshold then
				return
			end
			self:ActivateSkillSlotDrag(dragEvent.TouchPoint)
		end
		self:UpdateSkillSlotDragGhost(dragEvent.TouchPoint)
		self:UpdateSkillSlotDragDestination(dragEvent.TouchPoint)
	end

	@ExecSpace("ClientOnly")
	method void ActivateSkillSlotDrag(Vector2 touchPoint)
		local sourceIndex = self._T.SkillSlotDragSourceIndex
		if sourceIndex <= 0 or self:CanBeginSkillSlotDrag(sourceIndex) == false then
			self:CleanupSkillSlotDragVisuals(true)
			return
		end
		self._T.SkillSlotDragActive = true
		self.SuppressSkillClickUntil = (_UtilLogic.ElapsedSeconds or 0) + self.SkillSlotDragClickSuppressionSeconds
		local skillId = self:GetSlotSkillId(sourceIndex)
		local iconRuid = self:GetSkillIconRuid(skillId)
		if self.SkillDragGhost ~= nil then
			self.SkillDragGhost.ImageRUID = DataRef(iconRuid)
			self.SkillDragGhost.Color = Color(1, 1, 1, self.SkillSlotDragGhostAlpha)
			if self.SkillDragGhost.Entity.UITransformComponent ~= nil then
				local ghostTransform = self.SkillDragGhost.Entity.UITransformComponent
				if self._T.SkillSlotDragGhostBaseSize == nil then
					self._T.SkillSlotDragGhostBaseSize = ghostTransform.RectSize
				end
				local baseSize = self._T.SkillSlotDragGhostBaseSize
				ghostTransform.RectSize = Vector2(baseSize.x * 1.04, baseSize.y * 1.04)
			end
			self.SkillDragGhost.Entity.Enable = true
			self.SkillDragGhost.Enable = true
		end
		self:ApplySkillSlotDragSourceTreatment()
		self:UpdateSkillSlotDragGhost(touchPoint)
		local overheadQueueHud = self:GetOverheadQueueHud()
		if overheadQueueHud ~= nil then
			overheadQueueHud:SetBottomSkillDragPresentationActive(true)
		end
		self:UpdateSkillSlotDragDestination(touchPoint)
		log("[BattleSkillSlotDrag] activated source=" .. tostring(sourceIndex) .. " skill=" .. skillId .. " threshold=" .. tostring(self.SkillSlotDragThreshold))
	end

	@ExecSpace("ClientOnly")
	method any GetOverheadQueueHud()
		local controller = _EntityService:GetEntityByPath("/ui/TacticsPlayerOverheadHUD/Controller")
		if isvalid(controller) == false then
			return nil
		end
		return controller:GetComponent("script.PlayerOverheadQueueHudComponent")
	end

	@ExecSpace("ClientOnly")
	method table ResolveSkillSlotDragDestination(Vector2 touchPoint)
		-- Resolve exactly one destination from the final pointer coordinates. Queue wins if
		-- authored geometry ever overlaps the bottom bar.
		local overheadQueueHud = self:GetOverheadQueueHud()
		if overheadQueueHud ~= nil and overheadQueueHud:IsPointInsideQueueDropRegion(touchPoint) then
			return {
				Type = "QUEUE",
				TargetIndex = 0,
				QueueValid = overheadQueueHud:CanAcceptBottomSkillDrop()
			}
		end
		local targetIndex = self:ResolveSkillSlotAtTouchPoint(touchPoint)
		if targetIndex > 0 and targetIndex ~= (self._T.SkillSlotDragSourceIndex or 0) then
			return { Type = "BAR_SLOT", TargetIndex = targetIndex, QueueValid = false }
		end
		return { Type = "INVALID", TargetIndex = 0, QueueValid = false }
	end

	@ExecSpace("ClientOnly")
	method void UpdateSkillSlotDragDestination(Vector2 touchPoint)
		local destination = self:ResolveSkillSlotDragDestination(touchPoint)
		self._T.SkillSlotDragDestinationType = destination.Type
		self._T.SkillSlotDragHoverIndex = destination.TargetIndex
		local overheadQueueHud = self:GetOverheadQueueHud()
		if destination.Type == "QUEUE" then
			self:SetSkillSlotDragTarget(0)
			if overheadQueueHud ~= nil then
				overheadQueueHud:SetBottomSkillDragTargetFeedback(true, destination.QueueValid)
			end
			if self.SkillDragGhost ~= nil then
				self.SkillDragGhost.Color = destination.QueueValid
					and Color(0.86, 0.95, 1.00, self.SkillSlotDragGhostAlpha)
					or Color(0.66, 0.68, 0.72, 0.52)
			end
			return
		end
		if overheadQueueHud ~= nil then
			overheadQueueHud:SetBottomSkillDragTargetFeedback(false, false)
		end
		self:SetSkillSlotDragTarget(destination.TargetIndex)
	end

	@ExecSpace("ClientOnly")
	method void UpdateSkillSlotDragGhost(Vector2 touchPoint)
		if self._T.SkillSlotDragActive ~= true or self.SkillDragGhost == nil or self.SkillDragGhost.Entity.UITransformComponent == nil then
			return
		end
		local uiPosition = _UILogic:ScreenToUIPosition(touchPoint)
		local ghostX = math.max(-924, math.min(924, uiPosition.x + self.SkillSlotDragGhostOffsetX))
		local ghostY = math.max(-504, math.min(504, uiPosition.y + self.SkillSlotDragGhostOffsetY))
		self.SkillDragGhost.Entity.UITransformComponent.anchoredPosition = Vector2(ghostX, ghostY)
	end

	@ExecSpace("ClientOnly")
	method void ApplySkillSlotDragSourceTreatment()
		local sourceIcon = self:GetSkillIcon(self._T.SkillSlotDragSourceIndex or 0)
		if sourceIcon ~= nil then
			sourceIcon.Color = Color(0.55, 0.60, 0.68, 0.34)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnSkillSlotDragEnter(UITouchEnterEvent touchEvent)
		if self._T.SkillSlotDragCandidate ~= true or touchEvent.TouchId ~= self._T.SkillSlotDragTouchId then
			return
		end
		local targetIndex = self:ResolveSkillSlotIndex(touchEvent.Entity)
		self._T.SkillSlotDragHoverIndex = targetIndex
		if self._T.SkillSlotDragActive == true then
			self:SetSkillSlotDragTarget(targetIndex)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnSkillSlotDragExit(UITouchExitEvent touchEvent)
		if self._T.SkillSlotDragCandidate ~= true or touchEvent.TouchId ~= self._T.SkillSlotDragTouchId then
			return
		end
		local targetIndex = self:ResolveSkillSlotIndex(touchEvent.Entity)
		if self._T.SkillSlotDragHoverIndex == targetIndex then
			self._T.SkillSlotDragHoverIndex = 0
			self:SetSkillSlotDragTarget(0)
		end
	end

	@ExecSpace("ClientOnly")
	method integer ResolveSkillSlotAtTouchPoint(Vector2 touchPoint)
		local uiPosition = _UILogic:ScreenToUIPosition(touchPoint)
		local queueTransform = nil
		if isvalid(self.QueuePanelEntity) then
			queueTransform = self.QueuePanelEntity.UITransformComponent
		end
		if queueTransform == nil then
			return 0
		end
		-- The queue and its six slots are BottomCenter anchored. Compare in the same
		-- top-level UI coordinate space as ScreenToUIPosition; GetWorldCorners uses
		-- Maker viewport coordinates and cannot be mixed with simulated screen input.
		local queueBottom = -(_UILogic.ScreenHeight * 0.5) + queueTransform.anchoredPosition.y
		local queueCenterX = queueTransform.anchoredPosition.x
		for slotIndex = 1, 6 do
			local button = self:GetSkillSlotButton(slotIndex)
			if button ~= nil and isvalid(button.Entity) and button.Entity.UITransformComponent ~= nil then
				local slotTransform = button.Entity.UITransformComponent
				local minX = queueCenterX + slotTransform.anchoredPosition.x - (slotTransform.RectSize.x * slotTransform.Pivot.x)
				local maxX = minX + slotTransform.RectSize.x
				local minY = queueBottom + slotTransform.anchoredPosition.y - (slotTransform.RectSize.y * slotTransform.Pivot.y)
				local maxY = minY + slotTransform.RectSize.y
				if uiPosition.x >= minX and uiPosition.x <= maxX and uiPosition.y >= minY and uiPosition.y <= maxY then
					return slotIndex
				end
			end
		end
		return 0
	end

	@ExecSpace("ClientOnly")
	method void SetSkillSlotDragTarget(integer targetIndex)
		local sourceIndex = self._T.SkillSlotDragSourceIndex or 0
		local targetSkillId = ""
		if targetIndex > 0 and targetIndex ~= sourceIndex then
			targetSkillId = self:GetSlotSkillId(targetIndex)
		end
		for slotIndex = 1, 6 do
			local highlight = self:GetSkillSlotDragTargetHighlight(slotIndex)
			if highlight ~= nil then
				local isValidTarget = self._T.SkillSlotDragActive == true
					and slotIndex == targetIndex
					and slotIndex ~= self._T.SkillSlotDragSourceIndex
				if isValidTarget == true then
					if targetSkillId == "" then
						highlight.Color = Color(1.0, 0.82, 0.32, 0.58)
					else
						highlight.Color = Color(1.0, 0.82, 0.32, 0.90)
					end
				end
				highlight.Entity.Enable = isValidTarget
				highlight.Enable = isValidTarget
			end
		end
		if self.SkillDragGhost ~= nil and self._T.SkillSlotDragActive == true then
			local hasValidTarget = targetIndex > 0 and targetIndex ~= sourceIndex
			if self.PendingSkillSlotReorderRequestId > 0 then
				self.SkillDragGhost.Color = Color(1, 1, 1, 0.62)
			elseif hasValidTarget == false then
				self.SkillDragGhost.Color = Color(0.72, 0.75, 0.80, 0.58)
			elseif targetSkillId == "" then
				self.SkillDragGhost.Color = Color(1, 1, 1, 0.82)
			else
				self.SkillDragGhost.Color = Color(1, 1, 1, self.SkillSlotDragGhostAlpha)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnSkillSlotEndDrag(UITouchEndDragEvent dragEvent)
		if self._T.SkillSlotDragCandidate ~= true or dragEvent.TouchId ~= self._T.SkillSlotDragTouchId then
			return
		end
		if self._T.SkillSlotDragActive ~= true then
			self:CleanupSkillSlotDragVisuals(true)
			return
		end

		self.SuppressSkillClickUntil = (_UtilLogic.ElapsedSeconds or 0) + self.SkillSlotDragClickSuppressionSeconds
		self._T.SkillSlotDragLastTouchPoint = dragEvent.TouchPoint
		local sourceIndex = self._T.SkillSlotDragSourceIndex
		local destination = self:ResolveSkillSlotDragDestination(dragEvent.TouchPoint)
		local targetIndex = destination.TargetIndex
		self._T.SkillSlotDragDestinationType = destination.Type
		self._T.SkillSlotDragHoverIndex = targetIndex
		local expectedRevision = self._T.SkillSlotDragExpectedRevision
		local overheadQueueHud = self:GetOverheadQueueHud()
		if overheadQueueHud ~= nil then
			overheadQueueHud:SetBottomSkillDragPresentationActive(false)
			overheadQueueHud:SetBottomSkillDragTargetFeedback(false, false)
		end
		if destination.Type == "QUEUE" then
			if destination.QueueValid ~= true or self:CanBeginSkillSlotDrag(sourceIndex) == false then
				log("[BattleSkillSlotDrag] cancelled source=" .. tostring(sourceIndex) .. " destination=QUEUE reason=QUEUE_NOT_AVAILABLE")
				self:PlaySkillSlotDragCancelFeedback(sourceIndex)
				return
			end
			-- Cleanup keeps the source Skill in the bar. The original slot-based reservation
			-- boundary submits exactly one existing RequestQueueTile command.
			self:CleanupSkillSlotDragVisuals(true)
			self:RequestSlotSkill(sourceIndex, true)
			log("[BattleSkillSlotDrag] queue reservation submitted source=" .. tostring(sourceIndex))
			return
		end
		local validTarget = destination.Type == "BAR_SLOT"
			and targetIndex > 0
			and targetIndex ~= sourceIndex
			and self:CanBeginSkillSlotDrag(sourceIndex)
		if validTarget == false then
			log("[BattleSkillSlotDrag] cancelled source=" .. tostring(sourceIndex) .. " target=" .. tostring(targetIndex) .. " reason=INVALID_TARGET")
			self:PlaySkillSlotDragCancelFeedback(sourceIndex)
			return
		end

		self:SetSkillSlotDragPendingVisual(targetIndex)
		self:RequestAuthoritativeSkillSlotReorder(sourceIndex, targetIndex, expectedRevision)
	end

	@ExecSpace("ClientOnly")
	method Vector2 GetSkillSlotTopLevelUIPosition(integer slotIndex)
		local button = self:GetSkillSlotButton(slotIndex)
		if button == nil or isvalid(button.Entity) == false or button.Entity.UITransformComponent == nil or isvalid(self.QueuePanelEntity) == false or self.QueuePanelEntity.UITransformComponent == nil then
			return Vector2(0, 0)
		end
		local queueTransform = self.QueuePanelEntity.UITransformComponent
		local slotTransform = button.Entity.UITransformComponent
		local queueBottom = -(_UILogic.ScreenHeight * 0.5) + queueTransform.anchoredPosition.y
		return Vector2(queueTransform.anchoredPosition.x + slotTransform.anchoredPosition.x, queueBottom + slotTransform.anchoredPosition.y)
	end

	@ExecSpace("ClientOnly")
	method void SetSkillSlotDragPendingVisual(integer targetIndex)
		self._T.SkillSlotDragHoverIndex = targetIndex
		self:SetSkillSlotDragTarget(targetIndex)
		if self.SkillDragGhost ~= nil and self.SkillDragGhost.Entity.UITransformComponent ~= nil then
			self.SkillDragGhost.Entity.UITransformComponent.anchoredPosition = self:GetSkillSlotTopLevelUIPosition(targetIndex)
			self.SkillDragGhost.Color = Color(1, 1, 1, 0.62)
		end
	end

	@ExecSpace("ClientOnly")
	method void PlaySkillSlotDragCancelFeedback(integer sourceIndex)
		self._T.SkillSlotDragCandidate = false
		self._T.SkillSlotDragActive = false
		self._T.SkillSlotDragCancelling = true
		self:SetSkillSlotDragTarget(0)
		if self.SkillDragGhost == nil or self.SkillDragGhost.Entity.UITransformComponent == nil then
			self:CleanupSkillSlotDragVisuals(true)
			return
		end
		self.SkillDragGhost.Entity.UITransformComponent.anchoredPosition = self:GetSkillSlotTopLevelUIPosition(sourceIndex)
		self.SkillDragGhost.Color = Color(0.72, 0.75, 0.80, 0.44)
		if self.SkillSlotDragVisualTimerId > 0 then
			_TimerService:ClearTimer(self.SkillSlotDragVisualTimerId)
		end
		self.SkillSlotDragVisualTimerId = _TimerService:SetTimerOnce(function()
			self.SkillSlotDragVisualTimerId = 0
			self:CleanupSkillSlotDragVisuals(true)
		end, self.SkillSlotDragCancelDuration)
	end

	@ExecSpace("ClientOnly")
	method void RequestAuthoritativeSkillSlotReorder(integer sourceIndex, integer targetIndex, integer expectedRevision)
		local presenterState = _BattleHudPresenterLogic:GetCurrentState()
		local lastRequestId = 0
		local currentReceiptRevision = 0
		if presenterState ~= nil and presenterState.Session ~= nil then
			lastRequestId = presenterState.Session.SkillSlotLastRequestId or 0
			currentReceiptRevision = presenterState.Session.SkillSlotReorderReceiptRevision or 0
		end
		local elapsedRequestId = math.floor((_UtilLogic.ElapsedSeconds or 0) * 1000)
		local requestId = math.max(lastRequestId + 1, elapsedRequestId)
		self.PendingSkillSlotReorderRequestId = requestId
		self.PendingSkillSlotReorderReceiptRevision = currentReceiptRevision + 1
		_BattleHudPresenterLogic:RequestReorderBattleSkillSlot(sourceIndex, targetIndex, requestId, expectedRevision)
		if self.SkillSlotReorderPendingTimerId > 0 then
			_TimerService:ClearTimer(self.SkillSlotReorderPendingTimerId)
		end
		local pendingRequestId = requestId
		local timeout = function()
			if self.PendingSkillSlotReorderRequestId == pendingRequestId then
				log_warning("[BattleSkillSlotDrag] pending timeout request=" .. tostring(pendingRequestId))
				self.PendingSkillSlotReorderRequestId = 0
				self.PendingSkillSlotReorderReceiptRevision = 0
				self.SkillSlotReorderPendingTimerId = 0
				self:PlaySkillSlotDragCancelFeedback(self._T.SkillSlotDragSourceIndex or 0)
			end
		end
		self.SkillSlotReorderPendingTimerId = _TimerService:SetTimerOnce(timeout, self.SkillSlotReorderPendingTimeout)
		log("[BattleSkillSlotDrag] reorder pending request=" .. tostring(requestId) .. " source=" .. tostring(sourceIndex) .. " target=" .. tostring(targetIndex) .. " revision=" .. tostring(expectedRevision))
	end

	@ExecSpace("ClientOnly")
	method void ConsumeSkillSlotReorderReceipt(any session)
		if self.PendingSkillSlotReorderRequestId <= 0
			or session == nil
			or session.SkillSlotLastRequestId ~= self.PendingSkillSlotReorderRequestId
			or (session.SkillSlotReorderReceiptRevision or 0) < self.PendingSkillSlotReorderReceiptRevision then
			return
		end
		if self.SkillSlotReorderPendingTimerId > 0 then
			_TimerService:ClearTimer(self.SkillSlotReorderPendingTimerId)
			self.SkillSlotReorderPendingTimerId = 0
		end
		log("[BattleSkillSlotDrag] authoritative result request=" .. tostring(session.SkillSlotLastRequestId) .. " success=" .. tostring(session.SkillSlotLastRequestSuccess) .. " reason=" .. tostring(session.SkillSlotLastRequestReason) .. " slots=" .. tostring(session.SkillSlotIds))
		local sourceIndex = self._T.SkillSlotDragSourceIndex or 0
		local targetIndex = self._T.SkillSlotDragHoverIndex or 0
		self.PendingSkillSlotReorderRequestId = 0
		self.PendingSkillSlotReorderReceiptRevision = 0
		if session.SkillSlotLastRequestSuccess == true then
			self:CleanupSkillSlotDragVisuals(false)
			self._T.SkillSlotReorderSuccessSourceIndex = sourceIndex
			self._T.SkillSlotReorderSuccessTargetIndex = targetIndex
		else
			self:PlaySkillSlotDragCancelFeedback(sourceIndex)
		end
	end

	@ExecSpace("ClientOnly")
	method void CleanupSkillSlotDragVisuals(boolean refreshHud)
		local overheadQueueHud = self:GetOverheadQueueHud()
		if overheadQueueHud ~= nil then
			overheadQueueHud:SetBottomSkillDragPresentationActive(false)
			overheadQueueHud:SetBottomSkillDragTargetFeedback(false, false)
		end
		if self.SkillSlotDragVisualTimerId > 0 then
			_TimerService:ClearTimer(self.SkillSlotDragVisualTimerId)
			self.SkillSlotDragVisualTimerId = 0
		end
		if self.SkillDragGhost ~= nil then
			if self.SkillDragGhost.Entity.UITransformComponent ~= nil and self._T.SkillSlotDragGhostBaseSize ~= nil then
				self.SkillDragGhost.Entity.UITransformComponent.RectSize = self._T.SkillSlotDragGhostBaseSize
			end
			self.SkillDragGhost.Enable = false
			self.SkillDragGhost.Entity.Enable = false
		end
		self:SetSkillSlotDragTarget(0)
		self:ResetSkillSlotDragState()
		if refreshHud == true then
			self:RefreshHud(true)
		end
	end

	@ExecSpace("ClientOnly")
	method void ConsumeSkillSlotReorderSuccessFeedback()
		local sourceIndex = self._T.SkillSlotReorderSuccessSourceIndex or 0
		local targetIndex = self._T.SkillSlotReorderSuccessTargetIndex or 0
		if sourceIndex <= 0 or targetIndex <= 0 then
			return
		end
		self._T.SkillSlotReorderSuccessSourceIndex = 0
		self._T.SkillSlotReorderSuccessTargetIndex = 0
		self:PlaySkillSlotReorderSnap(sourceIndex)
		self:PlaySkillSlotReorderSnap(targetIndex)
		log("[BattleSkillSlotDrag] success feedback source=" .. tostring(sourceIndex) .. " target=" .. tostring(targetIndex) .. " duration=" .. tostring(self.SkillSlotReorderSuccessDuration))
	end

	@ExecSpace("ClientOnly")
	method void PlaySkillSlotReorderSnap(integer slotIndex)
		self:StopSkillIconFeedback(slotIndex)
		local icon = self:GetSkillIcon(slotIndex)
		if icon == nil or isvalid(icon.Entity) == false or icon.Entity.UITransformComponent == nil then
			return
		end
		local iconEntity = icon.Entity
		local baseSize = iconEntity.UITransformComponent.RectSize
		local timerRecords = self._T.SkillIconFeedbackTimers or {}
		self._T.SkillIconFeedbackTimers = timerRecords
		local record = { BaseSize = baseSize, MidTimerId = 0, RestoreTimerId = 0 }
		timerRecords[slotIndex] = record
		iconEntity.UITransformComponent.RectSize = Vector2(baseSize.x * 0.90, baseSize.y * 0.90)
		record.MidTimerId = _TimerService:SetTimerOnce(function()
			if isvalid(iconEntity) and iconEntity.UITransformComponent ~= nil then
				iconEntity.UITransformComponent.RectSize = Vector2(baseSize.x * 1.04, baseSize.y * 1.04)
			end
		end, self.SkillSlotReorderSuccessDuration * 0.43)
		record.RestoreTimerId = _TimerService:SetTimerOnce(function()
			if isvalid(iconEntity) and iconEntity.UITransformComponent ~= nil then
				iconEntity.UITransformComponent.RectSize = baseSize
			end
			if self._T.SkillIconFeedbackTimers ~= nil then
				self._T.SkillIconFeedbackTimers[slotIndex] = nil
			end
		end, self.SkillSlotReorderSuccessDuration)
	end

	@ExecSpace("ClientOnly")
	method void StopSkillIconFeedback(integer slotIndex)
		local timerRecords = self._T.SkillIconFeedbackTimers
		if timerRecords == nil then
			return
		end
		local record = timerRecords[slotIndex]
		if record == nil then
			return
		end
		if record.MidTimerId ~= nil and record.MidTimerId > 0 then
			_TimerService:ClearTimer(record.MidTimerId)
		end
		if record.RestoreTimerId ~= nil and record.RestoreTimerId > 0 then
			_TimerService:ClearTimer(record.RestoreTimerId)
		end
		local icon = self:GetSkillIcon(slotIndex)
		if icon ~= nil and isvalid(icon.Entity) and icon.Entity.UITransformComponent ~= nil then
			icon.Entity.UITransformComponent.RectSize = record.BaseSize
		end
		timerRecords[slotIndex] = nil
	end

	@ExecSpace("ClientOnly")
	method number ResolveQueuePopDuration()
		-- The Presenter remains the UI boundary; the tuning value originates from BattleSessionComponent.
		local state = _BattleHudPresenterLogic:GetCurrentState()
		if state == nil or state.UiState == nil or state.UiState.CombatFeel == nil then
			return 0
		end
		return math.max(0.08, math.min(0.12, state.UiState.CombatFeel.QueuePopDuration))
	end

	@ExecSpace("ClientOnly")
	method void PlaySkillIconScaleSequence(integer slotIndex, number immediateScale, number middleScale)
		-- RectSize scaling is visual-only and runs independently from the command/turn pipeline.
		self:StopSkillIconFeedback(slotIndex)
		local icon = self:GetSkillIcon(slotIndex)
		if icon == nil or isvalid(icon.Entity) == false or icon.Entity.UITransformComponent == nil then
			return
		end
		local duration = self:ResolveQueuePopDuration()
		if duration <= 0 then
			return
		end
		local iconEntity = icon.Entity
		local baseSize = iconEntity.UITransformComponent.RectSize
		local timerRecords = self._T.SkillIconFeedbackTimers
		if timerRecords == nil then
			timerRecords = {}
			self._T.SkillIconFeedbackTimers = timerRecords
		end
		local record = { BaseSize = baseSize, MidTimerId = 0, RestoreTimerId = 0 }
		timerRecords[slotIndex] = record
		iconEntity.UITransformComponent.RectSize = Vector2(baseSize.x * immediateScale, baseSize.y * immediateScale)
		record.MidTimerId = _TimerService:SetTimerOnce(function()
			if isvalid(iconEntity) and iconEntity.UITransformComponent ~= nil then
				iconEntity.UITransformComponent.RectSize = Vector2(baseSize.x * middleScale, baseSize.y * middleScale)
			end
		end, duration * 0.42)
		record.RestoreTimerId = _TimerService:SetTimerOnce(function()
			if isvalid(iconEntity) and iconEntity.UITransformComponent ~= nil then
				iconEntity.UITransformComponent.RectSize = baseSize
			end
			if self._T.SkillIconFeedbackTimers ~= nil then
				self._T.SkillIconFeedbackTimers[slotIndex] = nil
			end
		end, duration)
	end

	@ExecSpace("ClientOnly")
	method void PlaySkillIconPunch(integer slotIndex)
		self:PlaySkillIconScaleSequence(slotIndex, self.SkillPunchScale, 0.97)
	end

	@ExecSpace("ClientOnly")
	method void PlayQueueIconPop(integer slotIndex, string skillId)
		self:PlaySkillIconScaleSequence(slotIndex, self.QueuePopStartScale, self.QueuePopPeakScale)
		if self.QueueConfirmSoundRUID ~= "" then
			_GameSettingsLogic:PlayUISound(self.QueueConfirmSoundRUID, self.QueueConfirmSoundVolume)
		end
		log("[BattleQueueHUD] queue feedback slot=" .. tostring(slotIndex) .. " skill=" .. skillId .. " duration=" .. tostring(self:ResolveQueuePopDuration()))
	end

	@ExecSpace("ClientOnly")
	method string GetSlotSkillName(integer slotIndex)
		return self:GetFixedSkillSlotToken(self.SlotSkillNames, slotIndex)
	end

	@ExecSpace("ClientOnly")
	method integer GetSlotMaxCooldown(integer slotIndex)
		local token = self:GetFixedSkillSlotToken(self.SlotSkillCooldownTurns, slotIndex)
		return math.max(0, math.floor(tonumber(token) or 0))
	end

	@ExecSpace("ClientOnly")
	method void BuildSkillCooldownPipViews()
		-- Cache the authored four-pip pool once. Refreshes only recolor/reposition these entities.
		self._T.SkillCooldownPipViews = {}
		local buttons = {
			self.SkillSlot1Button,
			self.SkillSlot2Button,
			self.SkillSlot3Button,
			self.SkillSlot4Button,
			self.SkillSlot5Button,
			self.SkillSlot6Button
		}
		for slotIndex = 1, 6 do
			local view = { Container = nil, Pips = {} }
			local button = buttons[slotIndex]
			if button ~= nil and isvalid(button.Entity) then
				view.Container = button.Entity:GetChildByName("CooldownPipContainer", false)
				if isvalid(view.Container) then
					for pipIndex = 1, self.CooldownPipPoolSize do
						local pip = view.Container:GetChildByName("CooldownPip0" .. tostring(pipIndex), false)
						if isvalid(pip) then
							table.insert(view.Pips, pip)
						end
					end
				end
			end
			self._T.SkillCooldownPipViews[slotIndex] = view
		end
	end

	@ExecSpace("ClientOnly")
	method void HideAllSkillCooldownPips()
		local views = self._T.SkillCooldownPipViews
		if views == nil then
			return
		end
		for _, view in ipairs(views) do
			if view ~= nil and isvalid(view.Container) then
				view.Container.Enable = false
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshSkillChargePips(integer slotIndex, string skillId)
		-- Only charge-based healing skills show pips; cooldowns retain their existing numeric overlay.
		local views = self._T.SkillCooldownPipViews
		local view = views ~= nil and views[slotIndex] or nil
		if view == nil or isvalid(view.Container) == false then
			return
		end
		-- The catalog is server-only; these are the two existing charge-skill IDs in the synchronized slots.
		local isHeal = skillId == "heal" or skillId == "heal_ii"
		local charges = self._T.HealCharges or -1
		if isHeal == false or charges < 0 or self._T.HealUnlimited then
			view.Container.Enable = false
			return
		end
		local visibleCount = 5
		local template = view.Pips[1]
		if isvalid(template) == false then view.Container.Enable = false return end
		for pipIndex = #view.Pips + 1, visibleCount do
			local pip = template:Clone("HealChargePip" .. tostring(pipIndex))
			if isvalid(pip) == false then view.Container.Enable = false return end
			table.insert(view.Pips, pip)
		end
		view.Container.Enable = true
		local recoveredCount = math.max(0, math.min(visibleCount, charges))
		local pipWidth = 14
		local pipHeight = 8
		local pipSpacing = 3
		local rowWidth = visibleCount * pipWidth + math.max(0, visibleCount - 1) * pipSpacing
		local activeColor = Color(1.00, 0.72, 0.18, 1)
		local inactiveColor = Color(0.48, 0.52, 0.58, 1)
		for pipIndex, pip in ipairs(view.Pips) do
			local visible = pipIndex <= visibleCount
			pip.Enable = visible
			if pip.UITransformComponent ~= nil then
				local x = -rowWidth * 0.5 + pipWidth * 0.5 + (pipIndex - 1) * (pipWidth + pipSpacing)
				pip.UITransformComponent.anchoredPosition = Vector2(x, 0)
				pip.UITransformComponent.RectSize = Vector2(pipWidth, pipHeight)
			end
			if pip.SpriteGUIRendererComponent ~= nil then
				pip.SpriteGUIRendererComponent.Enable = visible
				if pipIndex <= recoveredCount then
					pip.SpriteGUIRendererComponent.Color = activeColor
				else
					pip.SpriteGUIRendererComponent.Color = inactiveColor
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void BuildBuffBarView()
		-- The authored row holds one hidden template; each active buff gets a clone of it, reused across refreshes.
		self._T.BuffIconViews = {}
		self._T.BuffBarSignature = ""
		self._T.BuffIconTemplate = nil
		local buffBar = isvalid(self.QueuePanelEntity) and self.QueuePanelEntity:GetChildByName("BuffBar", false) or nil
		if isvalid(buffBar) then
			self._T.BuffIconTemplate = buffBar:GetChildByName("BuffIconTemplate", false)
		end
		if isvalid(self._T.BuffIconTemplate) then
			self._T.BuffIconTemplate.Enable = false
		else
			log_warning("[BattleBuffHUD] template missing path=QueuePanel/BuffBar/BuffIconTemplate")
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshBuffBar()
		-- Draws the local player's timed buffs as skill icons with their remaining turn count.
		local snapshot = ""
		local player = _UserService.LocalPlayer
		if self.IsHudContextVisible and isvalid(player) then
			local unit = player:GetComponent("script.BattleUnitComponent")
			if unit ~= nil and unit.IsDead == false then
				snapshot = unit.ActiveBuffSnapshot or ""
			end
		end
		local signature = snapshot .. ":" .. self.IconSnapshot
		if signature == self._T.BuffBarSignature then
			return
		end
		self._T.BuffBarSignature = signature
		local template = self._T.BuffIconTemplate
		local views = self._T.BuffIconViews
		if isvalid(template) == false or views == nil then
			return
		end

		local buffs = {}
		for record in string.gmatch(snapshot, "([^|]+)") do
			local skillId = string.match(record, "^([^~]+)~")
			local turns = tonumber(string.match(record, "^[^~]+~(%d+)") or "") or 0
			local iconRuid = string.match(record, "^[^~]+~%d+~(.+)$")
			if skillId ~= nil and turns > 0 then
				if iconRuid == nil or iconRuid == "" then
					iconRuid = self:GetSkillIconRuid(skillId)
				end
				table.insert(buffs, { SkillId = skillId, Turns = math.floor(turns), IconRuid = iconRuid })
			end
		end
		for index = #views + 1, #buffs do
			local view = template:Clone("BuffIcon" .. tostring(index))
			if isvalid(view) == false then
				break
			end
			table.insert(views, view)
		end
		for index, view in ipairs(views) do
			local buff = buffs[index]
			view.Enable = buff ~= nil
			if buff ~= nil then
				view.UITransformComponent.anchoredPosition = Vector2((index - 1) * self.BuffIconSpacing, 0)
				local icon = view:GetChildByName("Icon", false)
				if isvalid(icon) then
					icon.SpriteGUIRendererComponent.ImageRUID = DataRef(buff.IconRuid)
				end
				local turnText = view:GetChildByName("TurnText", false)
				if isvalid(turnText) then
					turnText.TextGUIRendererComponent.Text = tostring(buff.Turns)
				end
			end
		end
		log("[BattleBuffHUD] refreshed count=" .. tostring(#buffs) .. " buffs=" .. snapshot)
	end

	@ExecSpace("ClientOnly")
	method void DestroyBuffIconViews()
		for _, view in ipairs(self._T.BuffIconViews or {}) do
			if isvalid(view) then
				view:Destroy()
			end
		end
		self._T.BuffIconViews = {}
		self._T.BuffBarSignature = ""
	end

	@ExecSpace("ClientOnly")
	method void SyncIconSnapshot(string snapshot)
		-- Parses the server-synced skill icon records only when their serialized value changes.
		if snapshot == self.IconSnapshot and self._T.IconMap ~= nil then
			return
		end
		self.IconSnapshot = snapshot
		local iconMap = {}
		local count = 0
		for record in string.gmatch(snapshot or "", "([^|]+)") do
			local skillId = string.match(record, "^([^~]+)")
			local iconRuid = string.match(record, "~(.+)$")
			if skillId ~= nil and iconRuid ~= nil and iconRuid ~= "" then
				iconMap[skillId] = iconRuid
				count = count + 1
			end
		end
		self._T.IconMap = iconMap
		log("[BattleQueueHUD] icon snapshot parsed count=" .. tostring(count))
	end

	@ExecSpace("ClientOnly")
	method string GetSkillIconRuid(string skillId)
		-- Returns the authored icon for this skill or the shared placeholder when the snapshot has no record.
		local iconMap = self._T.IconMap
		if iconMap ~= nil and iconMap[skillId] ~= nil then
			return iconMap[skillId]
		end
		return self.DefaultSkillIconRuid
	end

	@ExecSpace("ClientOnly")
	method void RefreshSkillSlots(boolean canChooseTile, string ownedSkills, string cooldownSnapshot, string queuedTileIds)
		-- The bar has six display slots while the reservation queue keeps its independent three-entry capacity.
		local buttons = {
			self.SkillSlot1Button,
			self.SkillSlot2Button,
			self.SkillSlot3Button,
			self.SkillSlot4Button,
			self.SkillSlot5Button,
			self.SkillSlot6Button
		}
		local labels = {
			self.SkillSlot1Label,
			self.SkillSlot2Label,
			self.SkillSlot3Label,
			self.SkillSlot4Label,
			self.SkillSlot5Label,
			self.SkillSlot6Label
		}
		local icons = {
			self.SkillSlot1Icon,
			self.SkillSlot2Icon,
			self.SkillSlot3Icon,
			self.SkillSlot4Icon,
			self.SkillSlot5Icon,
			self.SkillSlot6Icon
		}
		local queuedHighlights = {
			self.SkillSlot1QueuedHighlight,
			self.SkillSlot2QueuedHighlight,
			self.SkillSlot3QueuedHighlight,
			self.SkillSlot4QueuedHighlight,
			self.SkillSlot5QueuedHighlight,
			self.SkillSlot6QueuedHighlight
		}
		local queueOrderBadges = {
			self.SkillSlot1QueueOrderBadge,
			self.SkillSlot2QueueOrderBadge,
			self.SkillSlot3QueueOrderBadge,
			self.SkillSlot4QueueOrderBadge,
			self.SkillSlot5QueueOrderBadge,
			self.SkillSlot6QueueOrderBadge
		}
		local cooldownTexts = {
			self.SkillSlot1CooldownText,
			self.SkillSlot2CooldownText,
			self.SkillSlot3CooldownText,
			self.SkillSlot4CooldownText,
			self.SkillSlot5CooldownText,
			self.SkillSlot6CooldownText
		}

		for slotIndex = 1, 6 do
			self:RefreshSkillSlot(slotIndex, buttons[slotIndex], labels[slotIndex], icons[slotIndex], queuedHighlights[slotIndex], queueOrderBadges[slotIndex], cooldownTexts[slotIndex], canChooseTile, ownedSkills, cooldownSnapshot, queuedTileIds)
			self:RefreshSlotKeyText(buttons[slotIndex], slotIndex)
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshSlotKeyText(ButtonComponent button, integer slotIndex)
		-- The small corner badge shows the key bound to this slot in the settings window.
		local keyText = isvalid(button.Entity) and button.Entity:GetChildByName("SlotKeyText", false) or nil
		if isvalid(keyText) == false then return end
		local label = _GameSettingsLogic:GetActionKeyShortLabel("SLOT_" .. tostring(slotIndex))
		local renderer = keyText.TextGUIRendererComponent
		if renderer.Text == label then return end
		renderer.Text = label
		renderer.FontSize = string.len(label) <= 2 and 20 or 14
	end

	@ExecSpace("ClientOnly")
	method void HideAllSkillCooldownTexts()
		local cooldownTexts = {
			self.SkillSlot1CooldownText,
			self.SkillSlot2CooldownText,
			self.SkillSlot3CooldownText,
			self.SkillSlot4CooldownText,
			self.SkillSlot5CooldownText,
			self.SkillSlot6CooldownText
		}
		for _, cooldownText in ipairs(cooldownTexts) do
			cooldownText.Text = ""
			cooldownText.Enable = false
			cooldownText.Entity.Enable = false
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshSkillSlot(integer slotIndex, ButtonComponent button, TextGUIRendererComponent label, SpriteGUIRendererComponent icon, SpriteGUIRendererComponent queuedHighlight, TextGUIRendererComponent queueOrderBadge, TextGUIRendererComponent cooldownText, boolean canChooseTile, string ownedSkills, string cooldownSnapshot, string queuedTileIds)
		-- Renders one slot from its server-assigned skill: empty slots stay labelled and disabled.
		local skillId = self:GetSlotSkillId(slotIndex)
		if skillId == "" then
			-- Keep all six positions legible even when the later prototype slots have no skill data.
			label.Text = tostring(slotIndex)
			icon.Enable = false
			icon.Entity.Enable = false
			queuedHighlight.Enable = false
			queuedHighlight.Entity.Enable = false
			queueOrderBadge.Text = ""
			queueOrderBadge.Enable = false
			queueOrderBadge.Entity.Enable = false
			cooldownText.Text = ""
			cooldownText.Enable = false
			cooldownText.Entity.Enable = false
			self:RefreshSkillChargePips(slotIndex, "")
			button.Enable = false
			return
		end

		local displayName = self:GetSlotSkillName(slotIndex)
		if displayName == "" then
			displayName = skillId
		end
		local iconRuid = self:GetSkillIconRuid(skillId)
		icon.ImageRUID = DataRef(iconRuid)
		icon.Type = ImageType.Simple
		icon.DropShadow = false
		-- Keep the bottom bar visually focused on six large, readable slot keys.
		-- Skill identity and reservation order remain visible through the overhead icon queue.
		label.Text = tostring(slotIndex)
		icon.Entity.Enable = true
		icon.Enable = true
		local remainingCooldown = self:GetCooldownTurns(cooldownSnapshot, skillId)
		self:RefreshSkillChargePips(slotIndex, skillId)
		local queueOrder = self:GetQueueOrder(queuedTileIds, skillId)
		if remainingCooldown > 0 then
			icon.Color = Color(0.42, 0.40, 0.38, 0.72)
			cooldownText.Text = tostring(remainingCooldown)
			cooldownText.Entity.Enable = true
			cooldownText.Enable = true
			queuedHighlight.Enable = false
			queuedHighlight.Entity.Enable = false
			queueOrderBadge.Text = ""
			queueOrderBadge.Enable = false
			queueOrderBadge.Entity.Enable = false
		elseif queueOrder > 0 then
			icon.Color = Color(1, 1, 1, 1)
			cooldownText.Text = ""
			cooldownText.Enable = false
			cooldownText.Entity.Enable = false
			queuedHighlight.Entity.Enable = true
			queuedHighlight.Enable = true
			queueOrderBadge.Text = tostring(queueOrder)
			queueOrderBadge.Entity.Enable = true
			queueOrderBadge.Enable = true
		else
			icon.Color = Color(1, 1, 1, 1)
			cooldownText.Text = ""
			cooldownText.Enable = false
			cooldownText.Entity.Enable = false
			queuedHighlight.Enable = false
			queuedHighlight.Entity.Enable = false
			queueOrderBadge.Text = ""
			queueOrderBadge.Enable = false
			queueOrderBadge.Entity.Enable = false
		end
		button.Enable = canChooseTile
			and self:IsSkillOwned(ownedSkills, skillId)
			and remainingCooldown <= 0
			and queueOrder <= 0
	end

	@ExecSpace("ClientOnly")
	method void RequestSlotSkill(integer slotIndex, boolean fromQueueDrag)
		-- Queues whichever skill currently occupies the slot through the Presenter; the server re-validates ownership.
		if fromQueueDrag ~= true and (self._T.SkillSlotDragCandidate == true
			or self._T.SkillSlotDragActive == true
			or (_UtilLogic.ElapsedSeconds or 0) < self.SuppressSkillClickUntil) then
			log("[BattleSkillSlotDrag] slot click suppressed slot=" .. tostring(slotIndex))
			return
		end
		local skillId = self:GetSlotSkillId(slotIndex)
		if skillId == "" then
			log_warning("[BattleQueueHUD] register click ignored slot=" .. slotIndex .. " reason=SLOT_EMPTY")
			return
		end

		self.SuppressSkillDragUntil = (_UtilLogic.ElapsedSeconds or 0) + self.SkillSlotDragClickSuppressionSeconds
		self:PlaySkillIconPunch(slotIndex)
		local inputSource = fromQueueDrag == true and "QUEUE_DRAG" or "CLICK"
		log("[BattleQueueHUD] register requested source=" .. inputSource .. " slot=" .. slotIndex .. " tile=" .. skillId)
		_BattleHudPresenterLogic:RequestQueueTile(skillId)
	end

	@ExecSpace("ClientOnly")
	method void OnSkillSlot1Clicked()
		self:RequestSlotSkill(1, false)
	end

	@ExecSpace("ClientOnly")
	method void OnSkillSlot2Clicked()
		self:RequestSlotSkill(2, false)
	end

	@ExecSpace("ClientOnly")
	method void OnSkillSlot3Clicked()
		self:RequestSlotSkill(3, false)
	end

	@ExecSpace("ClientOnly")
	method void OnSkillSlot4Clicked()
		self:RequestSlotSkill(4, false)
	end

	@ExecSpace("ClientOnly")
	method void OnSkillSlot5Clicked()
		self:RequestSlotSkill(5, false)
	end

	@ExecSpace("ClientOnly")
	method void OnSkillSlot6Clicked()
		self:RequestSlotSkill(6, false)
	end

	@ExecSpace("ClientOnly")
	method void OnExecuteClicked()
		log("[BattleQueueHUD] execute clicked")
		_BattleHudPresenterLogic:RequestExecuteQueue()
	end

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleQuickbarCancelKey(KeyDownEvent event)
		-- Keyboard slots follow the current quickbar order and reuse the click/server validation path.
		if not self.IsHudContextVisible or self.IsMapTransferPending or _GameSettingsLogic:IsInputBlocked() then return end
		for slotIndex = 1, 6 do
			if _GameSettingsLogic:IsActionKey("SLOT_" .. tostring(slotIndex), event.key) then
				log("[BattleQueueHUD] keyboard register requested slot=" .. tostring(slotIndex))
				self:RequestSlotSkill(slotIndex, false)
				return
			end
		end
		if _GameSettingsLogic:IsActionKey("CLEAR_QUEUE", event.key) and self.CanClearQueue then
			self:OnClearClicked()
		end
	end

	@ExecSpace("ClientOnly")
	method void OnClearClicked()
		log("[BattleQueueHUD] clear clicked")
		_BattleHudPresenterLogic:RequestClearQueue()
	end

	@ExecSpace("ClientOnly")
	method void OnResetClicked()
		-- The server owns the in-flight gate; a rejected request cannot strand a disabled local button.
		log("[BattleQueueHUD] lobby return clicked")
		local session = _BattleHudPresenterLogic:GetBattleSession()
		if session ~= nil then session:RequestContinueResult() end
	end

	@ExecSpace("ClientOnly")
	method string GetPhaseLabel(string phase)
		-- Converts synchronized phase keys into compact Korean HUD labels.
		if phase == "Setup" then
			return "전투 준비"
		elseif phase == "PlayerTurn" then
			return "플레이어 턴"
		elseif phase == "EnemyTurn" then
			return "적 턴"
		elseif phase == "WaveTransition" then
			return "웨이브 완료"
		elseif phase == "BattleEnded" then
			return "전투 종료"
		end

		return phase
	end

	@ExecSpace("ClientOnly")
	method string GetReinforcementLabel(integer stageTurnNumber, any waveState)
		-- Displays the synchronized pressure rule without duplicating server spawn decisions.
		if waveState.CurrentWave >= waveState.TotalWaves then
			return "마지막 웨이브"
		end
		if waveState.ForceSpawnPending == true then
			return "증원 대기"
		end
		if waveState.CurrentWaveSpawnMode == "TURN_LIMIT" or waveState.CurrentWaveSpawnMode == "TURN_OR_TIME" then
			local elapsedTurns = math.max(0, stageTurnNumber - waveState.WaveSpawnStageTurn)
			local remainingTurns = math.max(0, waveState.ForceAfterTurns - elapsedTurns)
			if waveState.CurrentWaveSpawnMode == "TURN_OR_TIME" then
				return "증원 " .. remainingTurns .. "턴/시간"
			end
			return "증원까지 " .. remainingTurns .. "턴"
		elseif waveState.CurrentWaveSpawnMode == "TIME_LIMIT" then
			return "시간제 증원"
		end
		return "전멸 시 증원"
	end

	@ExecSpace("ClientOnly")
	method string GetQueueLabel(string serializedQueue, integer activeIndex, integer capacity)
		-- Renders any queue length without requiring one hard-coded UI entity per slot.
		if serializedQueue == "" then
			return "빈 큐  (0/" .. capacity .. ")"
		end

		local label = ""
		local index = 0
		for tileId in string.gmatch(serializedQueue, "([^|]+)") do
			index = index + 1
			if label ~= "" then
				label = label .. "  →  "
			end
			local prefix = "["
			if index == activeIndex then
				prefix = "▶["
			end
			label = label .. prefix .. self:GetTileLabel(tileId) .. "]"
		end
		return label .. "  (" .. index .. "/" .. capacity .. ")"
	end

	@ExecSpace("ClientOnly")
	method string GetTileLabel(string tileId)
		-- Display names arrive with the slot assignment because the skill DataSets are server-only.
		for slotIndex = 1, 6 do
			if self:GetSlotSkillId(slotIndex) == tileId then
				local name = self:GetSlotSkillName(slotIndex)
				if name ~= "" then
					return name
				end
			end
		end
		return tileId
	end

	@ExecSpace("ClientOnly")
	method string GetEnemyIntentCompactLabel(table uiState)
		-- Summarizes only the most urgent enemy state for the fixed-width status line.
		if uiState == nil or uiState.EnemyIntents == nil then
			return ""
		end
		local hasTracking = false
		local hasPreparing = false
		for _, intent in ipairs(uiState.EnemyIntents) do
			if intent.CastState == "CASTING" then
				return "적 충전"
			elseif intent.State == "ATTACK_READY" then
				return "적 공격 예고"
			elseif intent.State == "EXECUTING" then
				return "적 행동"
			elseif intent.State == "INSERTING" then
				hasPreparing = true
			elseif intent.State == "TRACKING" then
				hasTracking = true
			end
		end
		if hasPreparing then
			return "적 준비"
		elseif hasTracking then
			return "적 추적"
		end
		return ""
	end

	@ExecSpace("ClientOnly")
	method string GetEnemyIntentLabel(table uiState)
		-- Renders every synchronized enemy plan in SpawnOrder without duplicating AI decisions.
		if uiState == nil or uiState.EnemyIntents == nil or #uiState.EnemyIntents == 0 then
			return "준비 중"
		end
		local labels = {}
		for _, intent in ipairs(uiState.EnemyIntents) do
			local commandType = intent.CommandType or "WAIT"
			local label = commandType
			if commandType == "EXECUTE_TILE" then
				label = self:GetTileLabel(intent.TileId)
				if intent.State == "INSERTING" then
					label = label .. " 큐 추가 " .. tostring(intent.QueueTurnsElapsed) .. "/" .. tostring(intent.QueueTurnsRequired)
				elseif intent.State == "ATTACK_READY" then
					label = label .. " 공격 예고"
				end
			elseif commandType == "TELEGRAPH_TILE" then
				label = self:GetTileLabel(intent.TileId or "") .. " 예고 " .. tostring(intent.TelegraphTurnsRemaining or 0) .. "턴"
			elseif commandType == "BOSS_JUMP_TELEGRAPH" then
				label = "반대편 점프 예고"
			elseif commandType == "SUMMON_ENEMIES" then
				label = "좀비루팡 소환 (끝 타일 " .. tostring(intent.TargetCells or "") .. ")"
			elseif commandType == "BOSS_LAND_OPPOSITE" then
				label = "반대편 착지"
			elseif commandType == "MOVE_TOWARD" then
				label = "추적 접근"
			elseif commandType == "MOVE_AWAY" then
				label = "후퇴"
			elseif commandType == "MOVE_FIXED_FACING" then
				label = "고정 방향 전진"
			elseif commandType == "TURN_TO_PLAYER" then
				label = "플레이어 방향 전환"
			elseif commandType == "WAIT" then
				label = "대기"
			elseif intent.State == "COMPLETED" then
				label = "행동 완료"
			end
			local prefix = "#" .. tostring(intent.SpawnOrder)
			if intent.State == "EXECUTING" then
				prefix = prefix .. " 실행"
			elseif intent.State == "INSERTING" then
				prefix = prefix .. " 준비"
			elseif intent.State == "TRACKING" then
				prefix = prefix .. " 추적"
				if intent.NextCommandType == "TURN_TO_PLAYER" then
					label = self:GetTileLabel(intent.TileId) .. " 보유 · 방향 전환"
				elseif intent.NextCommandType == "MOVE_TOWARD" then
					label = self:GetTileLabel(intent.TileId) .. " 보유 · 접근"
				elseif intent.NextCommandType == "WAIT" then
					label = self:GetTileLabel(intent.TileId) .. " 보유 · 대기"
				end
			elseif intent.State == "ATTACK_READY" then
				prefix = prefix .. " 경고"
			end
			local actionCount = math.max(0, math.floor(tonumber(intent.ActionCount) or 0))
			if actionCount > 1 then
				label = label .. " " .. tostring(intent.CurrentActionIndex or 0) .. "/" .. tostring(actionCount)
			end
			local traitIds = intent.TraitIds or ""
			if traitIds ~= "" then
				label = label .. " [" .. traitIds .. "]"
			end
			table.insert(labels, prefix .. " " .. label)
		end
		return table.concat(labels, " / ")
	end

	@ExecSpace("ClientOnly")
	method integer GetTileCount(string serializedQueue)
		if serializedQueue == "" then
			return 0
		end
		local count = 0
		for _ in string.gmatch(serializedQueue, "([^|]+)") do
			count = count + 1
		end
		return count
	end

	@ExecSpace("ClientOnly")
	method string GetQueueFromIndex(string serializedQueue, integer firstVisibleIndex)
		local remainingSkills = {}
		local queueIndex = 0
		local startIndex = math.max(1, firstVisibleIndex)
		for skillId in string.gmatch(serializedQueue or "", "([^|]+)") do
			queueIndex = queueIndex + 1
			if queueIndex >= startIndex then
				table.insert(remainingSkills, skillId)
			end
		end
		return table.concat(remainingSkills, "|")
	end

	@ExecSpace("ClientOnly")
	method string GetActionLabel(string actionType)
		-- Converts internal action identifiers into player-facing queue text.
		if actionType == "" then
			return "대기"
		elseif actionType == "MOVE" then
			return "이동"
		elseif actionType == "TURN" then
			return "방향 전환"
		elseif actionType == "PUSH" then
			return "밀치기"
		elseif actionType == "ENEMY_MOVE_TOWARD" then
			return "적 추적 이동"
		elseif actionType == "ENEMY_MOVE_FIXED_FACING" then
			return "적 고정 방향 이동"
		elseif actionType == "ENEMY_TURN_TO_PLAYER" then
			return "적 방향 전환"
		elseif actionType == "ENEMY_EXECUTE_TILE" then
			return "적 기본 공격"
		elseif actionType == "ENEMY_BOSS_JUMP_TELEGRAPH" then
			return "보스 반대편 점프"
		elseif actionType == "ENEMY_BOSS_LAND_OPPOSITE" then
			return "보스 반대편 착지"
		elseif actionType == "ENEMY_SUMMON_ENEMIES" then
			return "좀비루팡 소환"
		elseif actionType == "ENEMY_WAIT" then
			return "적 대기"
		end

		return actionType
	end

	@ExecSpace("ClientOnly")
	method table ParseRoundRewards(string snapshot)
		local items = {}
		for record in string.gmatch(snapshot or "", "([^|]+)") do
			local captures = { string.match(record, "^([^~]+)~([^~]+)~(%d+)~([^~]+)~(.*)$") }

			local kind = captures[1]

			local id = captures[2]

			local amount = captures[3]

			local name = captures[4]

			local icon = captures[5]
			if kind ~= nil and tonumber(amount) > 0 and not (kind == "CURRENCY" and id == "gold") then
				table.insert(items, { Kind = kind, Id = id, Amount = tonumber(amount), Name = name, Icon = icon })
			end
		end
		return items
	end

	@ExecSpace("ClientOnly")
	method void RenderRoundRewards(any session, boolean unionVisible)
		if session == nil or not isvalid(self.ResultPanelEntity) then return end
		local signature = tostring(session.EntryRequestId) .. ":" .. (session.ResultRewardSnapshot or "") .. ":" .. tostring(session.ResultGold) .. ":" .. tostring(unionVisible)
		if self._T.RoundRewardDisplayKey == signature then return end
		self._T.RoundRewardDisplayKey = signature
		local gold = self.ResultPanelEntity:GetChildByName("GoldCard")
		if isvalid(gold) then gold:GetChildByName("Amount").TextGUIRendererComponent.Text = "+" .. tostring(session.ResultGold) end
		local list = self.ResultPanelEntity:GetChildByName("Rewards")
		if not isvalid(list) then return end
		local items = self:ParseRoundRewards(session.ResultRewardSnapshot)
		self:LayoutRoundRewards(math.max(1, math.ceil(#items / 2)), unionVisible)
		for index = 1, 8 do
			local row = list:GetChildByName("Reward" .. tostring(index))
			if isvalid(row) then
				local item = items[index]
				row.Enable = item ~= nil
				if item ~= nil then
					row:GetChildByName("Name").TextGUIRendererComponent.Text = item.Name
					row:GetChildByName("Amount").TextGUIRendererComponent.Text = "+" .. tostring(item.Amount)
					local icon = row:GetChildByName("Icon")
					icon.Enable = item.Icon ~= ""
					if item.Icon ~= "" then icon.SpriteGUIRendererComponent.ImageRUID = item.Icon end
					local badge = row:GetChildByName("Badge")
					badge.Enable = item.Icon == ""
					badge.TextGUIRendererComponent.Text = item.Kind == "REROLL" and "리롤" or "보상"
				end
			end
		end
		local empty = list:GetChildByName("Empty")
		if isvalid(empty) then empty.Enable = #items == 0 end
	end

	@ExecSpace("ClientOnly")
	method void LayoutRoundRewards(integer rowCount, boolean unionVisible)
		rowCount = math.min(4, rowCount)
		local reduction = (4 - rowCount) * 74 + (unionVisible and 0 or 72)
		self.ResultPanelEntity.UITransformComponent.RectSize = Vector2(900, 820 - reduction)
		local tops = { ResultText = 350, StageName = 298, Summary = 250, Divider = 220, RewardHeading = 190, GoldCard = 140 }
		for name, y in pairs(tops) do
			local child = self.ResultPanelEntity:GetChildByName(name)
			if isvalid(child) then child.UITransformComponent.anchoredPosition = Vector2(0, y - reduction / 2) end
		end
		local bottoms = { UnionRewardText = -230, UnionRewardBreakdownText = -266, BtnReset = -342 }
		for name, y in pairs(bottoms) do
			local child = self.ResultPanelEntity:GetChildByName(name)
			if isvalid(child) then child.UITransformComponent.anchoredPosition = Vector2(0, y + reduction / 2) end
		end
		local list = self.ResultPanelEntity:GetChildByName("Rewards")
		list.UITransformComponent.RectSize = Vector2(788, rowCount * 74 - 4)
		list.UITransformComponent.anchoredPosition = Vector2(0, -40 - reduction / 2 + (4 - rowCount) * 37)
		for index = 1, 8 do
			local row = list:GetChildByName("Reward" .. tostring(index))
			if isvalid(row) then row.UITransformComponent.anchoredPosition = Vector2(index % 2 == 1 and -201 or 201, (rowCount - 1) * 37 - math.floor((index - 1) / 2) * 74) end
		end
	end

end
