	property any SkillSlot2ClickHandler = nil
	property any SkillSlot3ClickHandler = nil
	property any SkillSlot4ClickHandler = nil
	property any SkillSlot5ClickHandler = nil
	property any SkillSlot6ClickHandler = nil
