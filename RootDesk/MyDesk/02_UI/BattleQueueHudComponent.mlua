	property string LastQueuedTileIds = ""
	property boolean IsMapTransferPending = false
	property string MapTransferSourceMapName = ""
	property number SkillSlotDragThreshold = 10
	property number SkillSlotDragClickSuppressionSeconds = 0.25
	property number SuppressSkillDragUntil = 0
	property number SkillSlotDragGhostAlpha = 0.86
	property number SkillSlotDragGhostOffsetX = 14
	property number SkillSlotDragGhostOffsetY = 18
	property number SkillSlotDragCancelDuration = 0.12
	property number SkillSlotReorderSuccessDuration = 0.14
	property number SkillSlotReorderPendingTimeout = 0.75
	property number SuppressSkillClickUntil = 0
	property number StateTextWidth = 1040
	property number StateTextHeight = 36
	property integer PendingSkillSlotReorderRequestId = 0
	property integer PendingSkillSlotReorderReceiptRevision = 0
	property integer SkillSlotReorderPendingTimerId = 0
	property integer SkillSlotDragVisualTimerId = 0
