	property boolean IsHudContextVisible = false
	property any PresenterStateChangedHandler = nil
	property any PresenterCommandResultHandler = nil
	property string InputFeedbackText = ""
	property integer InputFeedbackTimerId = 0
	property number InputFeedbackDuration = 0.30
	property number SkillPunchScale = 1.10
	property number QueuePopStartScale = 0.84
	property number QueuePopPeakScale = 1.12
