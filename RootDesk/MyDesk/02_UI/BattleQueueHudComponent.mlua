	property ButtonComponent ResetButton = "bf41edb1-bbbf-44d6-9d43-630e31343807"
	property SpriteGUIRendererComponent ResetButtonSprite = "bf41edb1-bbbf-44d6-9d43-630e31343807"
	property TextGUIRendererComponent ResetButtonText = "bf41edb1-bbbf-44d6-9d43-630e31343807"
	property string LastSignature = ""
	property boolean HasHudContextState = false
	property boolean IsHudContextVisible = false
