@Component
script WorldMapShopButtonComponent extends Component

	property string BranchId = ""
	property integer RequiredCompletedStageCount = 1
	property boolean AlwaysLocked = false
	property string AvailableTooltipText = "상점 방문"
	property string CompletedTooltipText = "이미 방문한 상점"
	property string LockedTooltipText = "이전 지역 클리어 필요"
	property any ClickHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- Connects the shop action when its popup group starts enabled.
		self:EnsureClickHandler("BEGIN_PLAY")
	end

	@ExecSpace("ClientOnly")
	method boolean EnsureClickHandler(string reason)
		-- Idempotently connects the click action for current and future shop markers.
		if self.Entity.ButtonComponent == nil then
			log_error("[WorldMapShop] button missing node=" .. self.Entity.Name .. " reason=" .. (reason or "UNSPECIFIED"))
			return false
		end
		if self.ClickHandler == nil then
			self.ClickHandler = self.Entity:ConnectEvent(ButtonClickEvent, self.OnClicked)
		end
		return self.ClickHandler ~= nil
	end

	@ExecSpace("ClientOnly")
	method boolean RebindClickHandler(string reason)
		if self.ClickHandler ~= nil then self.Entity:DisconnectEvent(ButtonClickEvent, self.ClickHandler) end
		self.ClickHandler = nil
		return self:EnsureClickHandler(reason or "REBIND")
	end

	@ExecSpace("ClientOnly")
	method void RefreshState(integer completedStageCount, string selectedBranch, string reason)
		-- Converts one shared progression snapshot into this shop marker's state.
		self:EnsureClickHandler(reason)
		local stateKey = "LOCKED"
		local tooltipText = self.LockedTooltipText
		if self.AlwaysLocked == false and completedStageCount >= self.RequiredCompletedStageCount then
			if selectedBranch == nil or selectedBranch == "" then
				stateKey = "AVAILABLE"
				tooltipText = self.AvailableTooltipText
			elseif self.BranchId ~= "" and selectedBranch == self.BranchId then
				stateKey = "COMPLETED"
				tooltipText = self.CompletedTooltipText
			end
		end
		local presentation = self:GetPresentation()
		if presentation ~= nil then
			presentation:ApplyState(stateKey, tooltipText)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnClicked()
		-- Opens an available branch shop or re-shows the current lock tooltip.
		local presentation = self:GetPresentation()
		if presentation == nil or presentation:CanActivate() == false then
			if presentation ~= nil then
				presentation:ShowTooltip()
			end
			log("[WorldMapShop] click ignored node=" .. self.Entity.Name .. " reason=NOT_AVAILABLE")
			return
		end
		local root = _EntityService:GetEntityByPath("/ui/DefaultGroup")
		local minimap = isvalid(root) and root:GetComponent("script.MinimapUI") or nil
		if minimap == nil or self.BranchId == "" then
			log_warning("[WorldMapShop] click rejected node=" .. self.Entity.Name .. " reason=ACTION_MISSING")
			return
		end
		minimap:OpenBranchShop(self.BranchId)
	end

	@ExecSpace("ClientOnly")
	method any GetPresentation()
		-- Resolves the reusable visual and tooltip component on this shop entity.
		return self.Entity:GetComponent("script.WorldMapButtonPresentationComponent")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- Releases the shop click subscription.
		if self.ClickHandler ~= nil then
			self.Entity:DisconnectEvent(ButtonClickEvent, self.ClickHandler)
		end
		self.ClickHandler = nil
	end

end
