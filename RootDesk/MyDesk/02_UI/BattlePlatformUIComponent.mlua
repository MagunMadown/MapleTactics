@Component
script BattlePlatformUIComponent extends Component

	property string PlatformRUID = "619f638cdb634056bfbecf71920b6482"
	property string PlayerPlatformRUID = "619f638cdb634056bfbecf71920b6482"
	property string EnemyPlatformRUID = "619f638cdb634056bfbecf71920b6482"
	-- World-space fitting box; AspectOnly preserves the original image proportions.
	property number WorldWidth = 1.08
	property number WorldHeight = 0.36

	@ExecSpace("ClientOnly")
	method void SetSkillRange(Entity map, table cells)
		-- Player hover previews are independent from enemy attack warnings.
		self._T.SkillRangeMap = map
		self._T.SkillRangeCells = {}
		for _, cell in ipairs(cells) do self._T.SkillRangeCells[cell] = true end
	end

	@ExecSpace("ClientOnly")
	method void SetEnemyRange(Entity map, table cells)
		-- Use the same zero-based cells as the synchronized enemy intent HUD.
		self._T.EnemyRangeMap = map
		self._T.EnemyRangeCells = cells or {}
	end

	@ExecSpace("ClientOnly")
	method Color GetPlatformColor(integer cell, Color base, table preview, boolean hasPreview, table danger)
		-- Attack warnings stay red even under a player preview; other cells keep their base opacity.
		if danger[cell] then return Color(1, 0.16, 0.20, 1) end
		if preview[cell] then return Color(0.2, 1, 1, 1) end
		if hasPreview then return Color(base.r, base.g, base.b, base.a * 0.35) end
		return base
	end

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- Cache the single UI set; maps supply only their visual board origin and spacing.
		self._T.Platforms = self.Entity:GetChildByName("Platforms")
		self._T.Cells = {}
		self._T.Map = nil
		self._T.ImageReady = false
		if isvalid(self._T.Platforms) == false then
			log_error("[BattlePlatformUI] Platforms container is missing")
			return
		end
		self._T.Platforms.Enable = false
		local clip = _ResourceService:LoadAnimationClipAndWait(self.PlatformRUID)
		if clip == nil or clip.IsLoadComplete == false or clip.Frames.Count == 0 then
			log_error("[BattlePlatformUI] Animation load failed: " .. self.PlatformRUID)
			return
		end
		log("[BattlePlatformUI] Animation loaded: " .. self.PlatformRUID .. "; frames=" .. tostring(clip.Frames.Count))
		for index = 1, 9 do
			local cell = self._T.Platforms:GetChildByName("BattleCell" .. tostring(index))
			if not isvalid(cell) then
				local template = self._T.Platforms:GetChildByName("BattleCell1")
				if isvalid(template) then cell = template:Clone("BattleCell" .. tostring(index)) end
			end
			if isvalid(cell) == false or cell.SpriteGUIRendererComponent == nil or cell.UITransformComponent == nil then
				log_error("[BattlePlatformUI] Missing cell or renderer: " .. tostring(index))
				self._T.Cells = {}
				return
			end
			cell.SpriteGUIRendererComponent.AnimClipPlayType = SpriteAnimClipPlayType.Loop
			cell.SpriteGUIRendererComponent.ImageRUID = DataRef(self.PlatformRUID)
			self._T.Cells[index] = cell
		end
		self._T.ImageReady = true
		log("[BattlePlatformUI] Shared variable-cell UI ready; world size=" .. tostring(self.WorldWidth) .. "x" .. tostring(self.WorldHeight))
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- Project world bounds each frame so camera movement, zoom and resolution preserve size.
		local player = _UserService.LocalPlayer
		if isvalid(player) == false or isvalid(player.CurrentMap) == false then
			self:HidePlatforms()
			return
		end
		local map = player.CurrentMap
		if self._T.Map ~= map then
			self:HidePlatforms()
			self._T.Map = map
			self._T.SkillRangeMap = nil
			self._T.EnemyRangeMap = nil
			self._T.BaseRingColors = {}
			self._T.ActorRefreshElapsed = 1
			self._T.ActorUnits = {}
		end
		local layout = map:GetComponent("script.BattleTileColor")
		if layout == nil or layout.Enable == false or map.EnabledInHierarchy == false then
			self:HidePlatforms()
			return
		end
		local session = map:GetComponent("script.BattleSessionComponent")
		if session == nil or session.Enable == false or session.BattleResult ~= "" then
			self:HidePlatforms()
			return
		end
		local cellCount = session ~= nil and math.max(1, math.min(9, session.CellCount)) or 7
		-- Refresh membership at 10 Hz instead of recursively scanning all actors every frame.
		self._T.ActorRefreshElapsed = (self._T.ActorRefreshElapsed or 1) + delta
		if self._T.ActorRefreshElapsed >= 0.1 then
			self._T.ActorRefreshElapsed = 0
			self._T.ActorUnits = map:GetChildComponentsByTypeName("script.BattleUnitComponent", true)
			for _, unit in ipairs(self._T.ActorUnits) do
				local actor = unit.Entity
				if not isvalid(actor) then continue end
				local renderer = actor.SpriteRendererComponent
				if renderer ~= nil and unit.Team == "Enemy" then
					if renderer.SortingLayer ~= "MapLayer2" then renderer.SortingLayer = "MapLayer2" end
					if renderer.OrderInLayer ~= 100 then renderer.OrderInLayer = 100 end
				end
			end
		end
		local originX = session ~= nil and session.CellStartX or layout.PlatformOrigin.x
		local spacing = session ~= nil and session.CellSpacing or layout.PlatformSpacing
		local worldPlatforms = map:GetChildByName("BattlePlatforms")
		local preview = (self._T.SkillRangeMap == map and self._T.SkillRangeCells) or {}
		local hasPreview = next(preview) ~= nil
		local danger = self._T.EnemyRangeMap == map and self._T.EnemyRangeCells or {}
		if session == nil or session.BattleResult ~= "" then danger = {} end
		if isvalid(worldPlatforms) then
			worldPlatforms.Enable = true
			self._T.WorldPlatforms = worldPlatforms
			for index = 1, 9 do
				local cell = worldPlatforms:GetChildByName("BattleCell" .. tostring(index))
				if isvalid(cell) then
					cell.Enable = index <= cellCount
					local renderer = cell.SpriteRendererComponent
					if renderer ~= nil then
						self._T.BaseRingColors = self._T.BaseRingColors or {}
						if self._T.BaseRingColors[cell.Id] == nil then self._T.BaseRingColors[cell.Id] = renderer.Color end
						local base = self._T.BaseRingColors[cell.Id]
						renderer.Color = self:GetPlatformColor(index - 1, base, preview, hasPreview, danger)
					end
					if index <= cellCount and cell.TransformComponent ~= nil then
						local position = cell.TransformComponent.Position
						cell.TransformComponent.Position = Vector3(originX + (index - 1) * spacing, position.y, position.z)
					end
				end
			end
			-- Keep actor visuals above ground rings, including newly spawned enemies.
			if player.AvatarRendererComponent ~= nil then
				player.AvatarRendererComponent.SortingLayer = "MapLayer2"
			end
			if isvalid(self._T.Platforms) then self._T.Platforms.Enable = false end
			if self._T.Map ~= map then
				self._T.Map = map
				log("[BattlePlatformUI] Using variable world platforms on BattlePlatforms layer")
			end
			return
		end
		-- Only the legacy UI fallback depends on UI cells and asynchronous clip loading.
		if self._T.ImageReady ~= true or not isvalid(self._T.Platforms) or self._T.Cells == nil or #self._T.Cells ~= 9 then return end
		local origin = Vector2(originX, layout.PlatformOrigin.y)
		local occupied = {}
		local units = self._T.ActorUnits or {}
		for _, unit in ipairs(units) do
			if isvalid(unit.Entity) and unit.Entity.EnabledInHierarchy and unit.IsDead == false and unit.CellIndex >= 0 and unit.CellIndex < cellCount then
				if unit.Team == "Player" then
					occupied[unit.CellIndex] = self.PlayerPlatformRUID
				elseif unit.Team == "Enemy" and occupied[unit.CellIndex] ~= self.PlayerPlatformRUID then
					occupied[unit.CellIndex] = self.EnemyPlatformRUID
				end
			end
		end
		local halfWidth = self.WorldWidth * 0.5
		local halfHeight = self.WorldHeight * 0.5
		for index = 1, 9 do
			self._T.Cells[index].Enable = index <= cellCount
			if index > cellCount then continue end
			local x = origin.x + (index - 1) * spacing
			local lower = self:ToLocalUI(Vector2(x - halfWidth, origin.y - halfHeight))
			local upper = self:ToLocalUI(Vector2(x + halfWidth, origin.y + halfHeight))
			local cell = self._T.Cells[index]
			local ruid = occupied[index - 1] or self.PlatformRUID
			if cell.SpriteGUIRendererComponent.ImageRUID.DataId ~= ruid then
				cell.SpriteGUIRendererComponent.ImageRUID = DataRef(ruid)
			end
			cell.UITransformComponent.anchoredPosition = Vector2((lower.x + upper.x) * 0.5, (lower.y + upper.y) * 0.5)
			cell.UITransformComponent.RectSize = Vector2(math.abs(upper.x - lower.x), math.abs(upper.y - lower.y))
			local base = layout.TileColor
			cell.SpriteGUIRendererComponent.Color = self:GetPlatformColor(index - 1, base, preview, hasPreview, danger)
		end
		self._T.Platforms.Enable = true
		if self._T.Map ~= map then
			self._T.Map = map
			log("[BattlePlatformUI] Displaying variable platforms in " .. map.Name .. "; origin=" .. tostring(origin))
		end
	end

	@ExecSpace("ClientOnly")
	method Vector2 ToLocalUI(Vector2 worldPosition)
		-- Convert relative to the container pivot, including its parent canvas scaling.
		local screenPosition = _UILogic:WorldToScreenPosition(worldPosition)
		return _UILogic:ScreenToLocalUIPosition(screenPosition, self._T.Platforms.UITransformComponent)
	end

	@ExecSpace("ClientOnly")
	method void HidePlatforms()
		-- Hide immediately in lobby/shop or while the local player's map is unavailable.
		if isvalid(self._T.WorldPlatforms) then
			self._T.WorldPlatforms.Enable = false
		end
		self._T.WorldPlatforms = nil
		if isvalid(self._T.Map) then
			local world = self._T.Map:GetChildByName("BattlePlatforms")
			if isvalid(world) then world.Enable = false end
		end
		if isvalid(self._T.Platforms) then
			self._T.Platforms.Enable = false
		end
		self._T.Map = nil
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- Release cached map and cell references when the UI session ends.
		self:HidePlatforms()
		self._T.Cells = nil
		self._T.Platforms = nil
	end

end
