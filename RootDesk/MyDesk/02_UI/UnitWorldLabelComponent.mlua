@Component
script UnitWorldLabelComponent extends Component

	-- Name box. A plain white sprite scaled to size and tinted through BoxColor, so a restyle only swaps these values.
	-- BoxSpriteSize is the sprite's world size at scale 1 (pixels / 100); the boxes are sized through transform scale.
	property string BoxSpriteRUID = "34933a8d498b481e840ee60438145b72"
	property Vector2 BoxSpriteSize = Vector2(1, 1)
	property Color BoxColor = Color(0, 0, 0, 0.85)
	property number BoxPaddingX = 0.08
	property number BoxHeight = 0.22
	property number NameOffsetY = -0.19
	property string NameFont = "Maple"
	property number NameFontSize = 1.6
	property Color NameColor = Color(1, 1, 1, 1)
	property number NameOutlineWidth = 0
	property Color NameOutlineColor = Color(0, 0, 0, 1)
	property boolean NameUnderlay = false
	property Color NameUnderlayColor = Color(0, 0, 0, 1)

	-- HP: one pip per point on a dark backing whose gaps read as the pip outline, with the exact value underneath.
	property number HpOffsetY = -0.39
	property number PipWidth = 0.13
	property number PipHeight = 0.08
	property number PipSpacing = 0.026
	property integer PipColumns = 5
	property number PipFramePadding = 0.016
	property Color PipFilledColor = Color(0.82, 0.16, 0.13, 1)
	property Color PipEmptyColor = Color(0.27, 0.27, 0.27, 1)
	property Color PipFrameColor = Color(0.025, 0.035, 0.055, 0.95)
	property number HpTextGap = 0.02
	property string HpTextFont = "Default"
	property number HpTextFontSize = 1.2
	property number HpTextHeight = 0.16
	property Color HpTextColor = Color(1, 1, 1, 1)
	property number HpTextOutlineWidth = 0
	property Color HpTextOutlineColor = Color(0.01, 0.015, 0.025, 1)
	property boolean HpTextUnderlay = true
	property Color HpTextUnderlayColor = Color(0, 0, 0, 1)
	property Vector2 HpTextUnderlayOffset = Vector2(0.6, -0.6)

	-- Drawn like a native name tag: on the map's top layer, above whatever else sits in it.
	property integer OrderInTopLayer = 1000

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- The spawner may already have called a setter in the spawn frame; EnsureReady runs its setup only once.
		self:EnsureReady()
	end

	@ExecSpace("ClientOnly")
	method void EnsureReady()
		-- Resolves the authored children and applies the inspector style before the first frame.
		if self._T.NameText ~= nil then return end
		self._T.NameBox = self.Entity:GetChildByName("NameBox", false)
		self._T.NameText = self.Entity:GetChildByName("NameText", false)
		self._T.HpGroup = self.Entity:GetChildByName("HpGroup", false)
		self._T.HpFrame = self._T.HpGroup:GetChildByName("HpFrame", false)
		self._T.HpText = self._T.HpGroup:GetChildByName("HpText", false)
		self._T.Pips = { self._T.HpGroup:GetChildByName("Pip", false) }
		self._T.Name = ""
		self._T.HpSignature = ""
		self._T.SortingKey = ""
		self._T.LayerMap = nil
		self._T.TopLayer = ""
		self._T.ParentScale = ""
		self:ApplyStyle()
		self:SetHpVisible(false)
		log("[UnitWorldLabel] ready entity=" .. self.Entity.Name)
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- Rides the unit it is attached to and keeps every renderer on the current map's top layer.
		self:EnsureReady()
		self:FollowParent()
		local map = self.Entity.CurrentMap
		if map ~= self._T.LayerMap then
			self._T.LayerMap = map
			self._T.TopLayer = self:FindTopLayer(map)
			log("[UnitWorldLabel] sorting layer=" .. self._T.TopLayer .. " map=" .. tostring(isvalid(map) and map.Name or nil))
		end
		if self._T.TopLayer ~= "" then self:ApplySorting(self._T.TopLayer, self.OrderInTopLayer) end
	end

	@ExecSpace("ClientOnly")
	method void SetOffsetSource(Entity source)
		-- The label is a child of the unit entity, so it is drawn wherever the engine draws the unit. It is not a
		-- child of the avatar root: those children share the avatar's sorting slot, and a ground layer above the
		-- avatar (as on battle maps) hides them whatever their order. Avatar units hop by moving the avatar root,
		-- so its local offset is copied instead; sprite units hop on their own entity and pass nil.
		self:EnsureReady()
		self._T.OffsetSource = source
		self:FollowParent()
	end

	@ExecSpace("ClientOnly")
	method void FollowParent()
		-- Cancels the parent's facing mirror and squash, then applies the offset source's hop.
		local parent = self.Entity.Parent
		if isvalid(parent) and parent.TransformComponent ~= nil then
			local scale = parent.TransformComponent.Scale
			local key = tostring(scale.x) .. ":" .. tostring(scale.y)
			if self._T.ParentScale ~= key then
				self._T.ParentScale = key
				local sx = math.abs(scale.x) > 0.0001 and 1 / scale.x or 1
				local sy = math.abs(scale.y) > 0.0001 and 1 / scale.y or 1
				self.Entity.TransformComponent.Scale = Vector3(sx, sy, 1)
			end
		end
		local x = 0
		local y = 0
		local source = self._T.OffsetSource
		if source ~= nil and isvalid(source) then
			local offset = source.TransformComponent.Position
			x = offset.x
			y = offset.y
		end
		local current = self.Entity.TransformComponent.Position
		if current.x ~= x or current.y ~= y or current.z ~= 0 then
			self.Entity.TransformComponent.Position = Vector3(x, y, 0)
		end
	end

	@ExecSpace("ClientOnly")
	method string FindTopLayer(Entity map)
		-- The avatar can stand on a lower layer than the ground drawn below its feet, so its layer is not enough.
		if not isvalid(map) then return "" end
		local top = nil
		for _, layer in ipairs(map:GetChildComponentsByTypeName("MapLayerComponent", true) or {}) do
			if layer.MapLayerName ~= "" and (top == nil or layer.LayerSortOrder > top.LayerSortOrder) then top = layer end
		end
		return top ~= nil and top.MapLayerName or ""
	end

	@ExecSpace("ClientOnly")
	method void ApplyStyle()
		-- Pushes the inspector style onto the child renderers; call again after changing a style property.
		self:EnsureReady()
		local box = self._T.NameBox.SpriteRendererComponent
		box.SpriteRUID = self.BoxSpriteRUID
		box.DrawMode = SpriteDrawMode.Simple
		box.Color = self.BoxColor
		local name = self._T.NameText.TextRendererComponent
		name.Font = self.NameFont
		name.FontSize = self.NameFontSize
		name.FontColor = self.NameColor
		name.OutlineWidth = self.NameOutlineWidth
		name.OutlineColor = self.NameOutlineColor
		name.Underlay = self.NameUnderlay
		name.UnderlayColor = self.NameUnderlayColor
		name.HorizontalAlignment = TextHorizontalAlignmentOption.Center
		name.VerticalAlignment = TextVerticalAlignmentOption.Middle
		name.Wrapping = false
		local frame = self._T.HpFrame.SpriteRendererComponent
		frame.SpriteRUID = self.BoxSpriteRUID
		frame.DrawMode = SpriteDrawMode.Simple
		frame.Color = self.PipFrameColor
		for _, pip in ipairs(self._T.Pips) do
			pip.SpriteRendererComponent.SpriteRUID = self.BoxSpriteRUID
			pip.SpriteRendererComponent.DrawMode = SpriteDrawMode.Simple
			self:SizeBox(pip, self.PipWidth, self.PipHeight)
		end
		local hpText = self._T.HpText.TextRendererComponent
		hpText.Font = self.HpTextFont
		hpText.FontSize = self.HpTextFontSize
		hpText.FontStyle = FontStyleType.Bold
		hpText.FontColor = self.HpTextColor
		hpText.OutlineWidth = self.HpTextOutlineWidth
		hpText.OutlineColor = self.HpTextOutlineColor
		hpText.Underlay = self.HpTextUnderlay
		hpText.UnderlayColor = self.HpTextUnderlayColor
		hpText.UnderlayOffsetX = self.HpTextUnderlayOffset.x
		hpText.UnderlayOffsetY = self.HpTextUnderlayOffset.y
		hpText.HorizontalAlignment = TextHorizontalAlignmentOption.Center
		hpText.VerticalAlignment = TextVerticalAlignmentOption.Middle
		hpText.RectSize = Vector2(1.2, self.HpTextHeight)
		hpText.Wrapping = false
		self._T.NameBox.TransformComponent.Position = Vector3(0, self.NameOffsetY, 0)
		self._T.NameText.TransformComponent.Position = Vector3(0, self.NameOffsetY, 0)
		self._T.HpGroup.TransformComponent.Position = Vector3(0, self.HpOffsetY, 0)
		self._T.SortingKey = ""
		self:LayoutName()
		self._T.HpSignature = ""
	end

	@ExecSpace("ClientOnly")
	method void SetName(string text)
		-- Updates the name and refits the box to the rendered text width.
		self:EnsureReady()
		text = text or ""
		if self._T.Name == text then return end
		self._T.Name = text
		self._T.NameText.TextRendererComponent.Text = text
		self:LayoutName()
	end

	@ExecSpace("ClientOnly")
	method void LayoutName()
		-- Sizes the box from the text's preferred width; an empty name hides the box.
		local text = self._T.Name or ""
		local renderer = self._T.NameText.TextRendererComponent
		local width = 0
		if text ~= "" then width = renderer:GetPreferredWidth(text) end
		renderer.RectSize = Vector2(width + self.BoxPaddingX * 2, self.BoxHeight)
		self:SizeBox(self._T.NameBox, width + self.BoxPaddingX * 2, self.BoxHeight)
		self._T.NameBox.Enable = text ~= ""
		self._T.NameText.Enable = text ~= ""
	end

	@ExecSpace("ClientOnly")
	method void SizeBox(Entity box, number width, number height)
		-- Stretches a childless box sprite to a world-unit size.
		local sx = math.max(0.0001, self.BoxSpriteSize.x)
		local sy = math.max(0.0001, self.BoxSpriteSize.y)
		box.TransformComponent.Scale = Vector3(width / sx, height / sy, 1)
	end

	@ExecSpace("ClientOnly")
	method void SetHpVisible(boolean visible)
		-- Shows or hides the whole HP block below the name.
		self:EnsureReady()
		if self._T.HpGroup.Enable ~= visible then self._T.HpGroup.Enable = visible end
	end

	@ExecSpace("ClientOnly")
	method void SetHpTextVisible(boolean visible)
		-- Shows or hides only the "current / max" line under the pips.
		self:EnsureReady()
		if self._T.HpText.Enable ~= visible then self._T.HpText.Enable = visible end
	end

	@ExecSpace("ClientOnly")
	method void SetHp(number currentHp, number maxHp)
		-- One pip per max-HP point in rows of PipColumns that grow downward, plus "current / max" underneath.
		self:EnsureReady()
		local maxPips = math.max(1, math.ceil(maxHp))
		local filled = math.max(0, math.min(maxPips, math.ceil(currentHp)))
		local signature = tostring(maxPips) .. ":" .. tostring(filled) .. ":" .. tostring(math.floor(currentHp)) .. "/" .. tostring(math.floor(maxHp))
		if self._T.HpSignature == signature then return end
		self._T.HpSignature = signature
		local pips = self._T.Pips
		local template = pips[1]
		for index = #pips + 1, maxPips do
			local pip = template:Clone("Pip" .. tostring(index))
			if not isvalid(pip) then break end
			table.insert(pips, pip)
		end
		local columns = math.min(math.max(1, self.PipColumns), maxPips)
		local rows = math.ceil(maxPips / columns)
		local gridWidth = columns * self.PipWidth + (columns - 1) * self.PipSpacing
		local gridHeight = rows * self.PipHeight + (rows - 1) * self.PipSpacing
		for index, pip in ipairs(pips) do
			local visible = index <= maxPips
			pip.Enable = visible
			if visible then
				local column = (index - 1) % columns
				local row = math.floor((index - 1) / columns)
				local x = -gridWidth * 0.5 + self.PipWidth * 0.5 + column * (self.PipWidth + self.PipSpacing)
				local y = -self.PipHeight * 0.5 - row * (self.PipHeight + self.PipSpacing)
				pip.TransformComponent.Position = Vector3(x, y, 0)
				pip.SpriteRendererComponent.Color = index <= filled and self.PipFilledColor or self.PipEmptyColor
			end
		end
		local pad = self.PipFramePadding
		self._T.HpFrame.TransformComponent.Position = Vector3(0, -gridHeight * 0.5, 0)
		self:SizeBox(self._T.HpFrame, gridWidth + pad * 2, gridHeight + pad * 2)
		self._T.HpText.TransformComponent.Position = Vector3(0, -gridHeight - pad - self.HpTextGap - self.HpTextHeight * 0.5, 0)
		self._T.HpText.TextRendererComponent.Text = tostring(math.floor(currentHp)) .. " / " .. tostring(math.floor(maxHp))
		self._T.SortingKey = ""
		log("[UnitWorldLabel] hp " .. self.Entity.Name .. " " .. signature)
	end

	@ExecSpace("ClientOnly")
	method void ApplySorting(string layer, integer order)
		-- Backings sit at the base order; pips and text draw one step above them.
		local key = layer .. ":" .. tostring(order) .. ":" .. tostring(#self._T.Pips)
		if self._T.SortingKey == key then return end
		self._T.SortingKey = key
		self:SetRendererSorting(self._T.NameBox.SpriteRendererComponent, layer, order)
		self:SetRendererSorting(self._T.HpFrame.SpriteRendererComponent, layer, order)
		self:SetRendererSorting(self._T.NameText.TextRendererComponent, layer, order + 1)
		self:SetRendererSorting(self._T.HpText.TextRendererComponent, layer, order + 1)
		for _, pip in ipairs(self._T.Pips) do
			self:SetRendererSorting(pip.SpriteRendererComponent, layer, order + 1)
		end
	end

	@ExecSpace("ClientOnly")
	method void SetRendererSorting(any renderer, string layer, integer order)
		-- Shared by sprite and text renderers, which expose the same two sorting fields.
		renderer.SortingLayer = layer
		renderer.OrderInLayer = order
	end

end
