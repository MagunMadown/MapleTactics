@Component
script WorldMapFutureRegionButtonComponent extends Component

	property string RequiredRouteId = ""
	property string HoverSoundRUID = "159bf70a74634bfc8e91a29e527a4be5"
	property string ClickSoundRUID = "972843e759204d3e9ad84e7d3fa94f83"
	property integer NoticeTimerId = 0
	property any ClickHandler = nil
	property any HoverHandler = nil
	property any ExitHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self.ClickHandler = self.Entity:ConnectEvent(ButtonClickEvent, self.OnClicked)
		self.HoverHandler = self.Entity:ConnectEvent(UITouchEnterEvent, self.OnHoverEnter)
		self.ExitHandler = self.Entity:ConnectEvent(UITouchExitEvent, self.OnHoverExit)
	end

	@ExecSpace("ClientOnly")
	method void OnClicked()
		local player = _UserService.LocalPlayer
		local runState = isvalid(player) and player:GetComponent("script.PlayerRunStateComponent") or nil
		if runState == nil or runState.LastCompletedContentId ~= self.RequiredRouteId then
			return
		end
		_SoundService:PlaySound(self.ClickSoundRUID, 1)
		local notice = _EntityService:GetEntityByPath("/ui/PopupGroup/MapTeleportPopup/WorldMapNotice")
		if isvalid(notice) and notice.TextGUIRendererComponent ~= nil then
			notice.TextGUIRendererComponent.Text = "다음 지역 맵 준비 중"
			notice.Enable = true
			notice.Visible = true
			if self.NoticeTimerId > 0 then _TimerService:ClearTimer(self.NoticeTimerId) end
			self.NoticeTimerId = _TimerService:SetTimerOnce(function()
				self.NoticeTimerId = 0
				if isvalid(notice) then
					notice.Enable = false
					notice.Visible = false
				end
			end, 2)
		end
		log("[WorldMap] future region requested route=" .. self.RequiredRouteId)
	end

	@ExecSpace("ClientOnly")
	method void OnHoverEnter()
		_SoundService:PlaySound(self.HoverSoundRUID, 1)
	end

	@ExecSpace("ClientOnly")
	method void OnHoverExit()
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self.NoticeTimerId > 0 then _TimerService:ClearTimer(self.NoticeTimerId) end
		if self.ClickHandler ~= nil then self.Entity:DisconnectEvent(ButtonClickEvent, self.ClickHandler) end
		if self.HoverHandler ~= nil then self.Entity:DisconnectEvent(UITouchEnterEvent, self.HoverHandler) end
		if self.ExitHandler ~= nil then self.Entity:DisconnectEvent(UITouchExitEvent, self.ExitHandler) end
	end

end
