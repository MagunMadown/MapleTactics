@Component
script ScrollableTextComponent extends Component

	property boolean FollowMouseWheel = false
	property boolean WheelRequiresHover = false
	property boolean HideScrollBar = false
	property any WheelSubscription = nil
	property number RefreshRemaining = 0
	property string PreviousText = ""
	property number PreviousWidth = -1
	property number PreviousHeight = -1
	property number PreviousFontSize = -1
	property number ContentHeight = 0

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- Keep the original text component as the existing controllers' data source.
		self:RefreshText()
		if self.FollowMouseWheel then
			self.WheelSubscription = _InputService:ConnectEvent(MouseScrollEvent, function(event)
				self:ScrollByWheel(event.ScrollDelta)
			end)
		end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- Only remeasure changed visible content, including a translated locale key.
		if not self.Entity.EnabledInHierarchy or not self.Entity.VisibleInHierarchy then return end
		self.RefreshRemaining = self.RefreshRemaining - delta
		if self.RefreshRemaining > 0 then return end
		self.RefreshRemaining = 0.1
		self:RefreshText()
	end

	@ExecSpace("ClientOnly")
	method void RefreshText()
		-- A clipped native scroll viewport preserves all text without reducing its font.
		local source = self.Entity.TextGUIRendererComponent
		local body = self.Entity:GetChildByName("ReadableContent")
		local layout = self.Entity.ScrollLayoutGroupComponent
		if source == nil or not isvalid(body) or layout == nil then return end
		-- Scrollbar visibility is authored in the UI; runtime Visible is not supported.
		local target = body.TextGUIRendererComponent
		local rect = self.Entity.UITransformComponent.RectSize
		local width = math.max(1, rect.x - 14)
		local content = source:GetLocalizedText()
		if content == nil or content == "" then content = source.Text or "" end
		source.Enable = false
		target.Enable = true
		target.FontColor = source.FontColor
		if content == self.PreviousText and width == self.PreviousWidth and rect.y == self.PreviousHeight and source.FontSize == self.PreviousFontSize then return end
		local changed = content ~= self.PreviousText
		target.Text = content
		target.Font = source.Font
		target.FontSize = source.FontSize
		target.FontStyle = source.FontStyle
		target.IsRichText = source.IsRichText
		target.BestFit = false
		target.SizeFit = false
		target.Overflow = TextOverflowMode.Overflow
		target.HorizontalAlignment = source.HorizontalAlignment
		target.VerticalAlignment = TextVerticalAlignmentOption.Top
		self.ContentHeight = math.max(rect.y, target:GetPreferredHeight(content, width) + 8)
		body.UITransformComponent.RectSize = Vector2(width, self.ContentHeight)
		self.PreviousText = content
		self.PreviousWidth = width
		self.PreviousHeight = rect.y
		self.PreviousFontSize = source.FontSize
		if changed then layout:ResetScrollPosition(UITransformAxis.Vertical) end
		log("[UITextFit] " .. self.Entity.Path .. " viewport=" .. tostring(rect.y) .. " content=" .. tostring(self.ContentHeight))
	end

	@ExecSpace("ClientOnly")
	method void ScrollByWheel(number delta)
		-- Fixed descriptions scroll only under the pointer; floating tooltips retain their existing behavior.
		if not self.Entity.EnabledInHierarchy or not self.Entity.VisibleInHierarchy then return end
		local transform = self.Entity.UITransformComponent
		if self.WheelRequiresHover then
			local cursor = _UILogic:ScreenToLocalUIPosition(_InputService:GetCursorPosition(), transform)
			local size, pivot = transform.RectSize, transform.Pivot
			if cursor.x < -size.x * pivot.x or cursor.x > size.x * (1 - pivot.x)
				or cursor.y < -size.y * pivot.y or cursor.y > size.y * (1 - pivot.y) then return end
		end
		local height = transform.RectSize.y
		if self.ContentHeight <= height then return end
		local layout = self.Entity.ScrollLayoutGroupComponent
		if layout == nil then return end
		local position = layout:GetScrollNormalizedPosition(UITransformAxis.Vertical)
		if self.WheelRequiresHover and layout.VerticalDirection == VerticalScrollBarDirection.BottomToTop then delta = -delta end
		layout:SetScrollNormalizedPosition(UITransformAxis.Vertical, math.max(0, math.min(1, position - delta * 48 / math.max(1, self.ContentHeight - height))))
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- Release the service subscription on reload and at session end.
		if self.WheelSubscription ~= nil then
			_InputService:DisconnectEvent(MouseScrollEvent, self.WheelSubscription)
			self.WheelSubscription = nil
		end
	end
end
