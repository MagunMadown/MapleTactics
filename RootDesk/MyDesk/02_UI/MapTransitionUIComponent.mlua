@Component
script MapTransitionUIComponent extends Component
	property Entity CoverEntity = "2478abec-1041-41eb-86f7-57bc839ad1a4"
	property CanvasGroupComponent CoverCanvas = "2478abec-1041-41eb-86f7-57bc839ad1a4"
	property boolean IsTransferActive = false
	property string SourceMapName = ""
	property number TransferElapsed = 0
	property number ReadyElapsed = 0
	property number FadeElapsed = 0
	property number ReadyHoldSeconds = 0.8
	property number FadeSeconds = 0.18
	property number TransferTimeoutSeconds = 8
	property boolean HasWarnedTimeout = false
	property number AnimationElapsed = 0

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- Resets the cover each play session before the common navigation boundary requests a transfer.
		self.IsTransferActive = false
		if isvalid(self.CoverCanvas) then self.CoverCanvas.GroupAlpha = 0 end
		if self.CoverEntity ~= nil then
			self.CoverEntity.Enable = false
		end
	end

	@ExecSpace("ClientOnly")
	method void BeginTransfer(string source)
		-- Covers the source map before its destination starts rendering.
		local player = _UserService.LocalPlayer
		self.SourceMapName = ""
		if isvalid(player) and isvalid(player.CurrentMap) then
			self.SourceMapName = player.CurrentMap.Name
		end
		self.AnimationElapsed = 0
		self:SelectLoadingCharacter(math.random(1, 3))
		self:SetLoadingChatHidden(true)
		self.IsTransferActive = true
		self.TransferElapsed = 0
		self.ReadyElapsed = 0
		self.FadeElapsed = 0
		self.HasWarnedTimeout = false
		if self.CoverCanvas ~= nil then
			self.CoverCanvas.GroupAlpha = 1
		end
		if self.CoverEntity ~= nil then
			self.CoverEntity.Enable = true
		end
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- Reveals the destination after its HUD has accepted the new map and the view has settled.
		if self.IsTransferActive == false then return end
		if not self.HasWarnedTimeout then self:AnimateLoading(delta) end
		self.TransferElapsed = self.TransferElapsed + delta
		local player = _UserService.LocalPlayer
		local currentMapName = ""
		if isvalid(player) and isvalid(player.CurrentMap) then
			currentMapName = player.CurrentMap.Name
		end
		local destinationChanged = currentMapName ~= "" and currentMapName ~= self.SourceMapName
		local hudReady = true
		local hudRoot = _EntityService:GetEntityByPath("/ui/BattleQueueHUD")
		if isvalid(hudRoot) then
			local controller = hudRoot:GetChildByName("Controller", false)
			if isvalid(controller) then
				local hud = controller:GetComponent("script.BattleQueueHudComponent")
				if hud ~= nil and hud.IsMapTransferPending then
					hudReady = false
				end
			end
		end
		if destinationChanged then
			local battleSession = player.CurrentMap:GetComponent("script.BattleSessionComponent")
			if battleSession ~= nil and battleSession.BattlePhase == "Setup" then
				hudReady = false
			end
		end
		local visualReady = true
		if destinationChanged then
			local map = player.CurrentMap
			local layout = map:GetComponent("script.BattleTileColor")
			if layout ~= nil and layout.Enable then
				local platformRoot = _EntityService:GetEntityByPath("/ui/BattlePlatformHUD")
				local platforms = isvalid(platformRoot) and platformRoot:GetComponent("script.BattlePlatformUIComponent") or nil
				visualReady = platforms ~= nil and platforms:IsMapVisualReady(map)
			end
		end
		if destinationChanged and hudReady and visualReady then
			self.ReadyElapsed = self.ReadyElapsed + delta
		else
			self.ReadyElapsed = 0
		end
		if self.ReadyElapsed < self.ReadyHoldSeconds then
			if self.TransferElapsed >= self.TransferTimeoutSeconds then
				if not self.HasWarnedTimeout then
					self.HasWarnedTimeout = true
					-- Release input, but keep observing a late arrival instead of abandoning the transfer.
					self:SetLoadingChatHidden(false)
					if isvalid(self.CoverEntity) then self.CoverEntity.Enable = false end
				end
			end
			return
		end
		self.FadeElapsed = self.FadeElapsed + delta
		local fadeDuration = math.max(0.01, self.FadeSeconds)
		local alpha = math.max(0, 1 - self.FadeElapsed / fadeDuration)
		if self.CoverCanvas ~= nil then
			self.CoverCanvas.GroupAlpha = alpha
		end
		if alpha > 0 then return end
		self:FinishTransfer(currentMapName, "READY")
	end

	@ExecSpace("ClientOnly")
	method void FinishTransfer(string mapName, string reason)
		-- Releases the input-blocking cover after readiness or a failed transfer, allowing a retry.
		self.IsTransferActive = false
		self:SetLoadingChatHidden(false)
		self.ReadyElapsed = 0
		self.FadeElapsed = 0
		if isvalid(self.CoverCanvas) then
			self.CoverCanvas.GroupAlpha = 0
		end
		if isvalid(self.CoverEntity) then
			self.CoverEntity.Enable = false
		end
	end
	@ExecSpace("ClientOnly")
	method void AnimateLoading(number delta)
		-- Limits visual catch-up after a stalled frame; transfer timers keep real elapsed time.
		self.AnimationElapsed = self.AnimationElapsed + math.min(math.max(delta, 0), 0.05)
		local slime = self.CoverEntity:GetChildByName("Walk", false):GetChildByName("Slime", false)
		local slimeHeight = slime.UITransformComponent.RectSize.y
		local phase = self.AnimationElapsed % 5
		local step = math.floor(phase)
		local t = math.min(1, (phase - step) / 0.4)
		local x = -360 + math.min(4, step) * 180
		local y = -22 + slimeHeight / 2
		if step < 4 then
			x = x + 180 * t
			y = y + math.sin(math.pi * t) * 60
		end
		slime.UITransformComponent.anchoredPosition = Vector2(x, y)
		local dots = math.floor(self.AnimationElapsed / 0.4) % 4
		local label = self.CoverEntity:GetChildByName("LoadingText", false).TextGUIRendererComponent
		local text = "NOW LOADING" .. string.rep(".", dots)
		if label.Text ~= text then label.Text = text end
	end

	@ExecSpace("ClientOnly")
	method void SetLoadingChatHidden(boolean hidden)
		-- Restores the exact prior chat state when loading or the preview map ends.
		local chat = _EntityService:GetEntityByPath("/ui/DefaultGroup/UIChat")
		if not isvalid(chat) then return end
		if hidden then
			if self._T.ChatEnabled == nil then self._T.ChatEnabled = chat.Enable end
			chat.Enable = false
		elseif self._T.ChatEnabled ~= nil then
			chat.Enable = self._T.ChatEnabled
			self._T.ChatEnabled = nil
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- Releases session-local chat suppression and pending resource work on shutdown.
		self._T.CharacterRequest = nil
		local actor = self.CoverEntity:GetChildByName("Walk", false):GetChildByName("Slime", false)
		if isvalid(actor) and self._T.CharacterHandler ~= nil then
			actor:DisconnectEvent(SpriteGUIAnimPlayerChangeFrameEvent, self._T.CharacterHandler)
		end
		self._T.CharacterHandler = nil
		self:SetLoadingChatHidden(false)
	end

	@ExecSpace("ClientOnly")
	method void SelectLoadingCharacter(integer index)
		-- Each loading entry chooses one of three equally weighted native move clips.
		local clips = {"50faf654ee5d479cb2958edce9feaef0", "c745828d831b42739b9a58c07f334864", "aa7d5f03ff1d45df9c08faa147b64db1"}
		local names = {"slime", "mushmom", "pinkbean"}
		local ruid = clips[index]
		if ruid == nil then return end
		local actor = self.CoverEntity:GetChildByName("Walk", false):GetChildByName("Slime", false)
		if self._T.CharacterHandler ~= nil then
			actor:DisconnectEvent(SpriteGUIAnimPlayerChangeFrameEvent, self._T.CharacterHandler)
			self._T.CharacterHandler = nil
		end
		local request = {}
		self._T.CharacterRequest = request
		actor.Enable = false
		_ResourceService:PreloadAsync({ruid}, function()
			if self._T.CharacterRequest ~= request or not isvalid(actor) then return end
			local clip = _ResourceService:LoadAnimationClipAndWait(ruid)
			if self._T.CharacterRequest ~= request or not isvalid(actor) or clip == nil or not clip.IsLoadComplete then return end
			local frames = {}
			local width, height = 0, 0
			for _, frame in ipairs(clip.Frames:ToTable()) do
				local sprite = frame.FrameSprite
				if sprite ~= nil and sprite.Width > 0 and sprite.Height > 0 then
					frames[frame.FrameIndex] = Vector2(sprite.Width, sprite.Height)
					width = math.max(width, sprite.Width)
					height = math.max(height, sprite.Height)
				end
			end
			if width <= 0 or height <= 0 then return end
			local scale = math.min(110 / width, 100 / height)
			local fit = function(frameIndex)
				if self._T.CharacterRequest ~= request or not isvalid(actor) then return end
				local size = frames[frameIndex]
				if size ~= nil then actor.UITransformComponent.RectSize = Vector2(size.x * scale, size.y * scale) end
			end
			self._T.CharacterHandler = actor:ConnectEvent(SpriteGUIAnimPlayerChangeFrameEvent, function(event) fit(event.FrameIndex) end)
			local renderer = actor.SpriteGUIRendererComponent
			renderer.PreserveSprite = PreserveSpriteType.None
			renderer.StartFrameIndex = 0
			renderer.EndFrameIndex = 2147483647
			renderer.AnimClipPlayType = SpriteAnimClipPlayType.Loop
			renderer.ImageRUID = DataRef(ruid)
			fit(0)
			actor.Enable = true
		end)
	end

end
