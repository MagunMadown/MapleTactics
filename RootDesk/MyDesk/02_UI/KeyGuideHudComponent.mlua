@Component
script KeyGuideHudComponent extends Component

    property Entity LobbyPanel = "e4a47300-3158-425b-8092-0e3e1fd8241e"
    property Entity BattlePanel = "94bb6a49-696a-4c7d-ba7f-1beb6fe57586"
    property string CurrentContext = ""
    property number RefreshRemaining = 0

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Resolve the initial context while keeping the controller active outside hidden panels.
        self.CurrentContext = ""
        self.RefreshRemaining = 0.2
        log("[KeyGuideHUD] begin")
        self:RefreshContext()
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Check at most five times per second without allocating timers or input handlers.
        self.RefreshRemaining = self.RefreshRemaining - delta
        if self.RefreshRemaining > 0 then return end
        self.RefreshRemaining = 0.2
        self:RefreshContext()
    end

    @ExecSpace("ClientOnly")
    method void RefreshContext()
        -- Show only the guide supported by the local player's current map on PC.
        if not isvalid(self.LobbyPanel) or not isvalid(self.BattlePanel) then return end
        local context = "HIDDEN"
        local player = _UserService.LocalPlayer
        if Environment:IsPCPlatform() and isvalid(player) and isvalid(player.CurrentMap) then
            local map = player.CurrentMap
            local battle = map:GetComponent("script.BattleSessionComponent")
            local lobby = map:GetComponent("script.LobbyGridMovementComponent")
            if isvalid(battle) and battle.Enable then
                context = "BATTLE"
            elseif isvalid(lobby) and lobby.Enable then
                context = "LOBBY"
            end
        end
        if context == self.CurrentContext then return end
        self.LobbyPanel.Enable = context == "LOBBY"
        self.BattlePanel.Enable = context == "BATTLE"
        if context == "LOBBY" then self:FitKeyLabels(self.LobbyPanel) end
        if context == "BATTLE" then self:FitKeyLabels(self.BattlePanel) end
        self.CurrentContext = context
        log("[KeyGuideHUD] context=" .. context)
    end

    @ExecSpace("ClientOnly")
    method void FitKeyLabels(Entity panel)
        -- Measure the actual font and keep ten pixels of padding on each side.
        for _, row in ipairs(panel.Children:ToTable()) do
            local key = row:GetChildByName("Key")
            if not isvalid(key) then continue end
            local label = key:GetChildByName("Label")
            if not isvalid(label) then continue end
            local text = label.TextGUIRendererComponent
            local width = math.ceil(text:GetPreferredWidth(text.Text)) + 20
            local height = key.UITransformComponent.RectSize.y
            key.UITransformComponent.RectSize = Vector2(width, height)
            label.UITransformComponent.RectSize = Vector2(width, height)
        end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Clear panel visibility and cached context before the next play session.
        if isvalid(self.LobbyPanel) then self.LobbyPanel.Enable = false end
        if isvalid(self.BattlePanel) then self.BattlePanel.Enable = false end
        self.CurrentContext = ""
        self.RefreshRemaining = 0
    end
end
