@Component
script WorldMapRunNodeButtonComponent extends Component

	property string NodeId = ""
	property string DisplayName = ""
	property string TargetEntityPath = ""
	property string HoverSoundRUID = "159bf70a74634bfc8e91a29e527a4be5"
	property string ClickSoundRUID = "972843e759204d3e9ad84e7d3fa94f83"
	property boolean RequestPending = false
	property integer RequestId = 100000
	property integer DelayTimerId = 0
	property any ClickHandler = nil
	property any HoverHandler = nil
	property any ExitHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		if self.Entity.ButtonComponent == nil then
			log_error("[WorldMapShop] button missing node=" .. self.NodeId)
			return
		end
		self.ClickHandler = self.Entity:ConnectEvent(ButtonClickEvent, self.OnClicked)
		self.HoverHandler = self.Entity:ConnectEvent(UITouchEnterEvent, self.OnHoverEnter)
		self.ExitHandler = self.Entity:ConnectEvent(UITouchExitEvent, self.OnHoverExit)
		log("[WorldMapShop] node ready id=" .. self.NodeId)
	end

	@ExecSpace("ClientOnly")
	method void OnClicked()
		if self.RequestPending then return end
		local minimap = self:GetMinimapUI()
		if minimap == nil or minimap.CurrentMode ~= "SHOP_CHOICE" then
			log_warning("[WorldMapShop] click rejected node=" .. self.NodeId .. " reason=MODE_MISMATCH")
			return
		end
		local flow = _RunManagerLogic:GetLocalRunFlowUiState()
		if flow.Success ~= true or flow.Commands.CanSelectNode ~= true or string.find("|" .. flow.AvailableNodeIds .. "|", "|" .. self.NodeId .. "|", 1, true) == nil then
			log_warning("[WorldMapShop] click rejected node=" .. self.NodeId .. " reason=NODE_NOT_AVAILABLE")
			return
		end
		if minimap:TryLockRouteSelection() == false then
			log("[WorldMapShop] click ignored node=" .. self.NodeId .. " reason=ROUTE_SELECTION_LOCKED")
			return
		end
		self.RequestPending = true
		self.Entity.ButtonComponent.Enable = false
		self.RequestId = self.RequestId + 1
		_SoundService:PlaySound(self.ClickSoundRUID, 1)
		minimap:PlayTravelAnimationTo(self.TargetEntityPath, self.DisplayName)
		self.DelayTimerId = _TimerService:SetTimerOnce(function()
			self.DelayTimerId = 0
			minimap:CloseWorldMapForTransfer(self.NodeId)
			log("[WorldMapShop] requesting selection node=" .. self.NodeId .. " request=" .. self.RequestId)
			_RunManagerLogic:RequestSelectNextContent(self.NodeId, self.RequestId)
		end, minimap.TravelDuration + 0.25)
	end

	@ExecSpace("ClientOnly")
	method void ResetForChoice()
		self.RequestPending = false
		if self.Entity.ButtonComponent ~= nil then self.Entity.ButtonComponent.Enable = true end
	end

	@ExecSpace("ClientOnly")
	method void OnHoverEnter()
		_SoundService:PlaySound(self.HoverSoundRUID, 1)
		local tooltip = self:GetTooltipUI()
		if tooltip ~= nil then tooltip:Show("run_node:" .. self.NodeId, self.DisplayName) end
	end

	@ExecSpace("ClientOnly")
	method void OnHoverExit()
		local tooltip = self:GetTooltipUI()
		if tooltip ~= nil then tooltip:Hide("run_node:" .. self.NodeId) end
	end

	@ExecSpace("ClientOnly")
	method any GetMinimapUI()
		local root = _EntityService:GetEntityByPath("/ui/DefaultGroup")
		return isvalid(root) and root:GetComponent("script.MinimapUI") or nil
	end

	@ExecSpace("ClientOnly")
	method any GetTooltipUI()
		local root = _EntityService:GetEntityByPath("/ui/MouseTooltipGroup")
		return isvalid(root) and root:GetComponent("script.MouseTooltipUIComponent") or nil
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self.DelayTimerId > 0 then _TimerService:ClearTimer(self.DelayTimerId) end
		if self.ClickHandler ~= nil then self.Entity:DisconnectEvent(ButtonClickEvent, self.ClickHandler) end
		if self.HoverHandler ~= nil then self.Entity:DisconnectEvent(UITouchEnterEvent, self.HoverHandler) end
		if self.ExitHandler ~= nil then self.Entity:DisconnectEvent(UITouchExitEvent, self.ExitHandler) end
	end

end
