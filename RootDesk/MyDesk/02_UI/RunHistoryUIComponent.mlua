@Component
script RunHistoryUIComponent extends Component

	property EntityRef RootEntity = "9486408b-c5ec-4689-ba8d-dcfa3943234c"
	property EntityRef ModalEntity = "d27cc7ac-be0c-44a8-9fc5-c74446bca23c"
	property boolean IsOpen = false
	property integer SelectedRunId = 0
	property integer HistoryPage = 1
	property integer BuildPage = 1
	property string ActiveTab = "Regions"
	property string ViewMode = "History"
	property string SelectedPublicId = ""
	property number HistoryRefreshCooldown = 0
	property number WorldRefreshCooldown = 0
	property number RefreshCooldown = 0
	property number PollRemaining = 0
	property number DetailDelay = 0
	property number DetailWait = 0

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- Wire the private-history and public-ranking views into the same existing lobby window.
		self._T.Links = {}
		self._T.Entities = {}
		self._T.Details = {}
		self._T.History = { Entries = {}, IsLoaded = false }
		self._T.HistoryRevision = -1
		self._T.CatalogRevision = -1
		self._T.WaitingHistory = false
		self._T.HistoryTimedOut = false
		self._T.HistoryWait = 0
		self._T.Record = nil
		self._T.World = { Entries = {}, IsLoaded = false }
		self._T.WorldRevision = -1
		self._T.PublishNotice = ""
		self._T.PublishPending = false
		self._T.PublishWait = 0
		self._T.ConfirmRunId = 0
		self._T.ConsentUntil = 0
		self:PreparePanelLayers()
		_GameUIPolishLogic:HideWindowImmediately(self.ModalEntity)
		self:Connect("Close", function() self:SetOpen(false) end)
		self:Connect("Refresh", function() self:RequestRefresh() end)
		self:Connect("ViewHistory", function() self:SelectView("History") end)
		self:Connect("ViewWorld", function() self:SelectView("World") end)
		self:Connect("Publish", function() self:PublishSelectedRun() end)
		self:Connect("Best", function() self:SelectBest() end)
		self:Connect("RecentPrev", function() self:ChangeHistoryPage(-1) end)
		self:Connect("RecentNext", function() self:ChangeHistoryPage(1) end)
		self:Connect("BuildPrev", function() self:ChangeBuildPage(-1) end)
		self:Connect("BuildNext", function() self:ChangeBuildPage(1) end)
		for _, tab in ipairs({ "Regions", "Skills", "Augments", "Relics" }) do
			local selectedTab = tab
			self:Connect("Tab" .. selectedTab, function() self:SelectTab(selectedTab) end)
		end
		for index = 1, 5 do
			local slot = index
			self:Connect("Recent/Row" .. tostring(slot), function()
				local entry = self:GetVisibleEntries()[(self.HistoryPage - 1) * 5 + slot]
				if entry ~= nil then
					if self.ViewMode == "World" then self:SelectPublic(entry.EntryId) else self:SelectRun(entry.RunId) end
				end
			end)
		end
	end

	@ExecSpace("ClientOnly")
	method void PreparePanelLayers()
		-- Screen UI uses sibling order; world-only OrderInLayer does not place backdrops behind existing labels.
		for _, path in ipairs({ "BoardBackdrop", "InfoBackdrop" }) do
			local panel = self:Find(path)
			if isvalid(panel) and panel.UITransformComponent ~= nil then
				_UILogic:SetSiblingIndex(panel.UITransformComponent, 0)
			end
		end
		local title = self:Find("Title")
		if isvalid(title) and title.UITransformComponent ~= nil and isvalid(title.Parent) then
			_UILogic:SetSiblingIndex(title.UITransformComponent, #title.Parent.Children:ToTable())
		end
	end

	@ExecSpace("ClientOnly")
	method Entity Find(string relativePath)
		local cached = self._T.Entities[relativePath]
		if isvalid(cached) then return cached end
		local entity = _EntityService:GetEntityByPath("/ui/RunHistoryUI/Modal/Window/" .. relativePath)
		self._T.Entities[relativePath] = entity
		return entity
	end

	@ExecSpace("ClientOnly")
	method void Connect(string path, any callback)
		local entity = self:Find(path)
		if isvalid(entity) == false or entity.ButtonComponent == nil then return end
		local eventLink = entity:ConnectEvent(ButtonClickEvent, function()
			if not self.IsOpen then return end
			_GameUIPolishLogic:PlayClick()
			callback()
		end)
		table.insert(self._T.Links, { Entity = entity, Handler = eventLink })
	end

	@ExecSpace("ClientOnly")
	method boolean IsInLobby()
		local player = _UserService.LocalPlayer
		return isvalid(player) and isvalid(player.CurrentMap) and player.CurrentMap.Name == "lobby"
	end

	@ExecSpace("ClientOnly")
	method void SetOpen(boolean open)
		if open and not self:IsInLobby() then return end
		if self.IsOpen == open or isvalid(self.ModalEntity) == false then return end
		self.IsOpen = open
		if open then
			self._T.HistoryRevision = -1
			self.PollRemaining = 0
			self:PollSnapshots()
			self:RequestRefresh()
		else
			self.DetailDelay = 0
			self.DetailWait = 0
			self._T.ConfirmRunId = 0; self._T.ConsentUntil = 0
		end
		_GameUIPolishLogic:SetWindowVisible(self.ModalEntity, open)
	end

	@ExecSpace("ClientOnly")
	method void RequestRefresh()
		-- Explicit requests are separately throttled per view; changing views never starts per-frame I/O.
		if not self.IsOpen or self.RefreshCooldown > 0 then return end
		self.RefreshCooldown = 10
		if self.ViewMode == "World" then
			self.WorldRefreshCooldown = 10
			self._T.WorldWaiting = true
			self._T.WorldTimedOut = false
			self._T.WorldWait = 8
			_RunRankingServiceLogic:RequestWorldRanking()
			self:Render()
			return
		end
		self.HistoryRefreshCooldown = 10
		self._T.WaitingHistory = true
		self._T.HistoryTimedOut = false
		self._T.HistoryWait = 8
		self._T.RequestRevision = self._T.HistoryRevision
		_RunResultServiceLogic:RequestMyRunHistory()
		self:Render()
	end

	@ExecSpace("ClientOnly")
	method void PollSnapshots()
		-- Poll synchronized DTOs only. Storage reads are explicit, throttled requests, never frame polling.
		local world = _RunRankingServiceLogic:GetLocalWorldRankingSnapshot()
		local worldChanged = world.Revision ~= self._T.WorldRevision
		if worldChanged then
			self._T.World = world
			self._T.WorldRevision = world.Revision
			self._T.WorldWaiting = false
			self._T.WorldTimedOut = false
			self._T.WorldWait = 0
			if world.Operation == "PUBLISH" then
				self._T.PublishPending = false
				self._T.PublishNotice = world.Success and (world.Reason == "RANKING_BEST_UNCHANGED" and "이미 같거나 더 좋은 기록이 공개되어 있습니다." or "공개 등록 완료 · 월드 랭킹에서 확인하세요.") or self:RankingReasonLabel(world.Reason)
			end
		end
		local history = _RunResultServiceLogic:GetLocalRunHistorySnapshot()
		local catalog = _RunHistoryPresenterLogic:GetLocalCatalog()
		if self.ViewMode == "World" then
			local catalogChanged = catalog.Revision ~= self._T.CatalogRevision
			self._T.CatalogRevision = catalog.Revision
			local selected = nil
			for _, entry in ipairs(world.Entries or {}) do if entry.EntryId == self.SelectedPublicId then selected = entry end end
			if selected == nil and world.OwnBest ~= nil and world.OwnBest.EntryId == self.SelectedPublicId then selected = world.OwnBest end
			if selected == nil then selected = (world.Entries or {})[1] or world.OwnBest end
			if selected ~= nil then
				self.SelectedPublicId = selected.EntryId; self.SelectedRunId = selected.Record.RunId
				self._T.Record = selected.Record; self._T.SelectedPublic = selected
			else
				self.SelectedPublicId = ""; self.SelectedRunId = 0; self._T.Record = nil; self._T.SelectedPublic = nil
			end
			if worldChanged or catalogChanged then self:Render() end
			return
		end
		local changed = history.Revision ~= self._T.HistoryRevision or catalog.Revision ~= self._T.CatalogRevision
		if changed then
			self._T.History = history
			self._T.HistoryRevision = history.Revision
			self._T.CatalogRevision = catalog.Revision
			if history.Revision ~= self._T.RequestRevision and (history.IsLoaded or history.Success == false) then
				self._T.WaitingHistory = false
				self._T.HistoryTimedOut = false
			end
			local retained = {}
			for _, entry in ipairs(history.Entries or {}) do retained[entry.RunId] = true end
			if history.HasBest and history.BestRecord ~= nil then
				retained[history.BestRecord.RunId] = true
				self._T.Details[history.BestRecord.RunId] = history.BestRecord
			end
			for id, _ in pairs(self._T.Details) do if not retained[id] then self._T.Details[id] = nil end end
			if not retained[self.SelectedRunId] then
				self.SelectedRunId = 0
				self._T.Record = nil
				local first = (history.Entries or {})[1]
				if first ~= nil then self:SelectRun(first.RunId)
				elseif history.HasBest then self:SelectBest() end
			else
				self._T.Record = self._T.Details[self.SelectedRunId]
			end
		end
		local detail = _RunResultServiceLogic:GetLocalRunResultDetailSnapshot()
		if detail.Success and detail.HasRecord and detail.Record ~= nil then
			-- A late response from a previously clicked row must never overwrite the current selection.
			if detail.Record.RunId == self.SelectedRunId and self._T.Record == nil then
				self._T.Record = detail.Record
				self._T.Details[self.SelectedRunId] = detail.Record
				self.DetailDelay = 0
				self.DetailWait = 0
				changed = true
			end
		end
		if changed or worldChanged then self:Render() end
	end

	@ExecSpace("ClientOnly")
	method void SelectView(string view)
		-- Reset cross-user selection keys: two different users may legitimately have the same RunId.
		if view ~= "History" and view ~= "World" then return end
		if self.ViewMode == view then return end
		self.ViewMode = view
		self.HistoryPage = 1; self.BuildPage = 1; self.SelectedRunId = 0; self.SelectedPublicId = ""
		self.DetailDelay = 0; self.DetailWait = 0; self._T.Record = nil; self._T.SelectedPublic = nil
		self._T.ConfirmRunId = 0; self._T.ConsentUntil = 0
		self._T.HistoryRevision = -1; self._T.WorldRevision = -1
		self.RefreshCooldown = view == "World" and self.WorldRefreshCooldown or self.HistoryRefreshCooldown
		self:PollSnapshots()
		self:RequestRefresh()
		self:Render()
	end

	@ExecSpace("ClientOnly")
	method table GetVisibleEntries()
		-- Lists and click selection always use the active view's own identity scheme.
		return self.ViewMode == "World" and (self._T.World.Entries or {}) or (self._T.History.Entries or {})
	end

	@ExecSpace("ClientOnly")
	method void SelectPublic(string entryId)
		-- Public builds arrive with the cached ranking response; selecting a row makes no additional RPC.
		local selected = nil
		for _, entry in ipairs(self._T.World.Entries or {}) do if entry.EntryId == entryId then selected = entry; break end end
		if selected == nil and self._T.World.OwnBest ~= nil and self._T.World.OwnBest.EntryId == entryId then selected = self._T.World.OwnBest end
		if selected == nil then return end
		self.SelectedPublicId = entryId; self.SelectedRunId = selected.Record.RunId
		self._T.Record = selected.Record; self._T.SelectedPublic = selected
		self.BuildPage = 1; self.DetailDelay = 0; self.DetailWait = 0
		self:Render()
	end

	@ExecSpace("ClientOnly")
	method string RankingReasonLabel(string reason)
		-- Human-readable errors avoid presenting test records, rule mismatches, or outages as successful registration.
		return ({ RANKING_RUN_EXCLUDED = "테스트·패배·중단 기록은 공개 랭킹에 등록할 수 없습니다.",
			RANKING_LEGACY_RECORD = "이전 버전 기록은 등록할 수 없습니다.", RANKING_CONDITIONS_MISMATCH = "현재 랭킹의 난이도·시즌·밸런스 조건과 다릅니다.",
			RANKING_BALANCE_UNVERSIONED = "밸런스 버전이 없는 기록은 등록할 수 없습니다.",
			RANKING_CAPTURE_INCOMPLETE = "진행 조건 또는 보유 내역 수집이 불완전합니다.",
			RANKING_HISTORY_NOT_READY = "개인 기록을 저장한 뒤 새로고침하고 다시 시도하세요.",
			RANKING_RUN_NOT_RETAINED = "본인의 보관 중인 기록만 등록할 수 있습니다.",
			RANKING_RATE_LIMIT = "잠시 후 다시 시도하세요.", RANKING_CREDIT_EXHAUSTED = "저장소 사용량 제한 · 잠시 후 다시 시도하세요.",
			RANKING_SCAN_LIMIT = "조회 한도에 도달해 상위 목록 일부를 표시합니다." })[reason] or ("조회·등록 실패 (" .. tostring(reason or "UNKNOWN") .. ")")
	end

	@ExecSpace("ClientOnly")
	method void PublishSelectedRun()
		-- The second click explicitly consents to publishing nickname, run metrics, region route, and build.
		if self.ViewMode ~= "History" or self._T.Record == nil or self._T.PublishPending then return end
		local candidate = _RunRankingPolicyLogic:ValidateCandidate(self._T.Record)
		if not candidate.Success then self._T.PublishNotice = self:RankingReasonLabel(candidate.Reason); self:Render(); return end
		local now = _UtilLogic.ElapsedSeconds
		if self._T.ConfirmRunId ~= self.SelectedRunId or now > self._T.ConsentUntil then
			self._T.ConfirmRunId = self.SelectedRunId; self._T.ConsentUntil = now + 8
			self._T.PublishNotice = "이름·완주 성적·지역 경로·스킬·증강·유물이 공개됩니다.\n동의하면 '동의 후 등록'을 다시 누르세요."
			self:Render(); return
		end
		self._T.ConfirmRunId = 0; self._T.ConsentUntil = 0
		self._T.PublishPending = true; self._T.PublishWait = 8
		self._T.PublishNotice = "공개 기록을 등록하는 중..."
		_RunRankingServiceLogic:RequestPublishMyRun(self.SelectedRunId, true)
		self:Render()
	end

	@ExecSpace("ClientOnly")
	method void SelectRun(integer runId)
		-- Private detail requests can never be used to select another user's public RunId.
		if runId <= 0 then return end
		self._T.ConfirmRunId = 0; self._T.ConsentUntil = 0; self._T.PublishNotice = ""
		self.SelectedRunId = runId
		self.BuildPage = 1
		self._T.Record = self._T.Details[runId]
		self.DetailDelay = self._T.Record == nil and 0.31 or 0
		self.DetailWait = self._T.Record == nil and 8 or 0
		self:Render()
	end

	@ExecSpace("ClientOnly")
	method void SelectBest()
		-- The best card means own private best or own consented public best depending on the active view.
		if self.ViewMode == "World" then
			if self._T.World.OwnBest ~= nil then self:SelectPublic(self._T.World.OwnBest.EntryId) end
			return
		end
		local history = self._T.History
		if not history.HasBest or history.BestRecord == nil then return end
		self._T.Details[history.BestRecord.RunId] = history.BestRecord
		self:SelectRun(history.BestRecord.RunId)
	end

	@ExecSpace("ClientOnly")
	method void SelectTab(string tab)
		if tab ~= "Regions" and tab ~= "Skills" and tab ~= "Augments" and tab ~= "Relics" then return end
		self.ActiveTab = tab
		self.BuildPage = 1
		self:Render()
	end

	@ExecSpace("ClientOnly")
	method void ChangeHistoryPage(integer delta)
		-- One pager serves the private recent list and the public top list without crossing identities.
		local pages = math.max(1, math.ceil(#self:GetVisibleEntries() / 5))
		self.HistoryPage = math.max(1, math.min(pages, self.HistoryPage + delta))
		self:Render()
	end

	@ExecSpace("ClientOnly")
	method void ChangeBuildPage(integer delta)
		local pages = math.max(1, math.ceil(#self:GetBuildRows() / 3))
		self.BuildPage = math.max(1, math.min(pages, self.BuildPage + delta))
		self:Render()
	end

	@ExecSpace("ClientOnly")
	method string FormatNumber(number value)
		return string.format("%.0f", value or 0)
	end

	@ExecSpace("ClientOnly")
	method string AscensionLabel(any record)
		-- Older stored runs have no challenge field and remain readable as the base difficulty.
		local level = record ~= nil and tonumber(record.AscensionLevel) or 0
		return _AscensionDifficultyLogic:GetDisplayName(math.max(0, math.min(_AscensionDifficultyLogic.MaxLevel, math.floor(level or 0))))
	end

	@ExecSpace("ClientOnly")
	method string FormatTime(number value)
		local seconds = math.max(0, math.floor(value or 0))
		return string.format("%02d:%02d:%02d", math.floor(seconds / 3600), math.floor(seconds / 60) % 60, seconds % 60)
	end

	@ExecSpace("ClientOnly")
	method string EndReasonLabel(string reason)
		return ({ COMPLETED = "완주", DEFEATED = "패배", ABANDONED = "중단" })[reason] or reason or ""
	end

	@ExecSpace("ClientOnly")
	method string ProgressLabel(table record)
		-- Legacy maximum stage numbers are not actual clear counts; do not fabricate missing history.
		if type(record.ClearedBattleCount) == "number" then
			return "전투 클리어 " .. self:FormatNumber(record.ClearedBattleCount) .. "회"
		end
		return "최대 단계 " .. self:FormatNumber(record.CompletedStageNumber) .. " (이전 기록)"
	end

	@ExecSpace("ClientOnly")
	method string RegionRouteLabel()
		-- Only region visits are shown; no per-stage or shop/rest event list is exposed.
		local record = self._T.Record
		if record == nil then return self.SelectedRunId > 0 and "지역 경로를 불러오는 중..." or "" end
		local history = record.RegionHistory or {}
		if not history.Captured then return "이전 기록 · 지역 경로 미수집" end
		local labels = {}
		for _, visit in ipairs(history.Visits or {}) do
			local display = _RunHistoryPresenterLogic:GetDisplayEntry("Regions", visit.RegionId)
			table.insert(labels, display.Name)
		end
		if #labels == 0 then return "전투에 진입한 지역 없음" end
		return (history.Complete and "" or "일부 기록 누락 · ") .. table.concat(labels, " → ")
	end

	@ExecSpace("ClientOnly")
	method void SetText(string path, string value)
		local entity = self:Find(path)
		if isvalid(entity) and entity.TextGUIRendererComponent ~= nil then entity.TextGUIRendererComponent.Text = value end
	end

	@ExecSpace("ClientOnly")
	method void SetEnabled(string path, boolean enabled)
		local entity = self:Find(path)
		if isvalid(entity) then entity:SetEnable(enabled) end
	end

	@ExecSpace("ClientOnly")
	method void StyleButton(string path, boolean enabled, boolean selected)
		-- Keep selection visible independently of the button's hover tint.
		local entity = self:Find(path)
		if isvalid(entity) == false or entity.ButtonComponent == nil then return end
		entity.ButtonComponent.Enable = enabled
		if entity.SpriteGUIRendererComponent ~= nil then
			entity.SpriteGUIRendererComponent.Color = selected and Color(0.16, 0.61, 0.68, 1) or Color(0.20, 0.25, 0.28, enabled and 1 or 0.55)
		end
		if entity.TextGUIRendererComponent ~= nil then
			entity.TextGUIRendererComponent.FontColor = enabled and Color(0.94, 0.98, 1, 1) or Color(0.63, 0.68, 0.72, 1)
		end
		self:SetEnabled(path .. "/Selection", enabled and selected)
	end

	@ExecSpace("ClientOnly")
	method void RenderTableRow(string path, table record, string name, number rank, boolean selected)
		-- Public and private lists share presentation only; their identity and storage contracts stay separate.
		self:SetText(path .. "/Rank", self:FormatNumber(rank))
		self:SetText(path .. "/Title", name)
		self:SetText(path .. "/Meta", _RunHistoryPresenterLogic:GetDisplayEntry("Jobs", record.JobId).Name)
		self:SetText(path .. "/Turns", self:FormatNumber(record.ConsumedTurns))
		self:SetText(path .. "/Hits", self:FormatNumber(record.HitsTaken))
		self:SetText(path .. "/Clears", type(record.ClearedBattleCount) == "number" and self:FormatNumber(record.ClearedBattleCount) or "—")
		self:StyleButton(path, true, selected)
		for _, cell in ipairs({ "Rank", "Title", "Meta", "Turns", "Hits", "Clears" }) do
			local entity = self:Find(path .. "/" .. cell)
			if isvalid(entity) and entity.TextGUIRendererComponent ~= nil then
				entity.TextGUIRendererComponent.FontColor = selected and Color(1, 1, 1, 1) or Color(0.86, 0.91, 0.94, 1)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void RenderStatistics(table summary)
		-- Separate labels from numbers; missing legacy clear counts must stay unknown, not zero.
		local knownClears = summary ~= nil and type(summary.ClearedBattleCount) == "number"
		self:SetText("Detail/Stats/Clears/Label", knownClears and "전투 클리어" or (summary ~= nil and "이전 최대 단계" or "전투 클리어"))
		self:SetText("Detail/Stats/Clears/Value", summary ~= nil and self:FormatNumber(knownClears and summary.ClearedBattleCount or summary.CompletedStageNumber) or "—")
		self:SetText("Detail/Stats/Turns/Value", summary ~= nil and self:FormatNumber(summary.ConsumedTurns) or "—")
		self:SetText("Detail/Stats/Hits/Value", summary ~= nil and self:FormatNumber(summary.HitsTaken) or "—")
		self:SetText("Detail/Stats/Time/Value", summary ~= nil and self:FormatTime(summary.ElapsedSeconds) or "—")
	end

	@ExecSpace("ClientOnly")
	method void RenderRegionBadge(string path, table row)
		-- Region completion uses a separate badge; non-region tabs must clear recycled badge state.
		self:SetEnabled(path .. "/Status", row ~= nil and row.IsRegion == true)
		if row == nil or row.IsRegion ~= true then return end
		self:SetText(path .. "/Status/Label", row.Completed and "완료" or "미완료")
		local badge = self:Find(path .. "/Status")
		if isvalid(badge) and badge.SpriteGUIRendererComponent ~= nil then
			badge.SpriteGUIRendererComponent.Color = row.Completed and Color(0.12, 0.33, 0.29, 1) or Color(0.30, 0.25, 0.15, 1)
		end
	end

	@ExecSpace("ClientOnly")
	method table GetBuildRows()
		-- Build display rows from the selected record without changing stored DTOs.
		local rows = {}
		local record = self._T.Record
		if self.ActiveTab == "Regions" then
			for index, visit in ipairs(((record or {}).RegionHistory or {}).Visits or {}) do
				local display = _RunHistoryPresenterLogic:GetDisplayEntry("Regions", visit.RegionId)
				table.insert(rows, { Name = tostring(index) .. ". " .. display.Name, IsRegion = true, Completed = visit.Completed == true,
					Description = "전투 " .. self:FormatNumber(visit.ClearedBattles) .. "회 클리어 · " .. self:FormatNumber(visit.ConsumedTurns)
						.. "턴 · 피격 " .. self:FormatNumber(visit.HitsTaken) .. "회" })
			end
			return rows
		end
		if record == nil or record.Build == nil or not record.Build.Captured then return rows end
		local build = record.Build
		if self.ActiveTab == "Skills" then
			for _, skill in ipairs(build.Skills or {}) do
				local display = _RunHistoryPresenterLogic:GetDisplayEntry("Skills", skill.SkillId)
				local slot = skill.SlotIndex > 0 and ("슬롯 " .. self:FormatNumber(skill.SlotIndex)) or "미배치"
				table.insert(rows, { Name = display.Name, Icon = display.Icon,
					Description = "티어 " .. self:FormatNumber(skill.SkillTier) .. " · 보유 " .. self:FormatNumber(skill.Amount) .. " · " .. slot })
				for index, id in ipairs(skill.AugmentIds or {}) do
					local augment = _RunHistoryPresenterLogic:GetDisplayEntry("Augments", id)
					table.insert(rows, { Name = "증강 · " .. augment.Name, Icon = augment.Icon,
						Description = display.Name .. " · 적용 " .. self:FormatNumber(index) .. " · " .. augment.Description })
				end
			end
		else
			for _, entry in ipairs(build[self.ActiveTab] or {}) do
				local id = self.ActiveTab == "Relics" and entry.RelicId or entry.AugmentId
				local count = self.ActiveTab == "Relics" and entry.Amount or entry.Stacks
				local display = _RunHistoryPresenterLogic:GetDisplayEntry(self.ActiveTab, id)
				table.insert(rows, { Name = display.Name .. " ×" .. self:FormatNumber(count), Icon = display.Icon, Description = display.Description })
			end
		end
		return rows
	end

	@ExecSpace("ClientOnly")
	method void Render()
		-- Reuse cached history and detail data; visibility updates do not request storage.
		self:StyleButton("ViewHistory", true, self.ViewMode == "History")
		self:StyleButton("ViewWorld", true, self.ViewMode == "World")
		self:SetEnabled("Publish", self.ViewMode == "History")
		if self.ViewMode == "World" then self:RenderWorld(); return end
		self:SetText("Title", "플레이 기록")
		self:SetText("TableHeader/Rank", "번호")
		self:SetText("TableHeader/Name", "기록")
		self:SetText("Best/Label", "개인 최고 기록")
		local candidate = self._T.Record ~= nil and _RunRankingPolicyLogic:ValidateCandidate(self._T.Record) or { Success = false }
		self:StyleButton("Publish", candidate.Success and not self._T.PublishPending, false)
		self:SetText("Publish", self._T.ConfirmRunId == self.SelectedRunId and self.SelectedRunId > 0 and self._T.ConsentUntil >= _UtilLogic.ElapsedSeconds and "동의 후 등록" or "공개 등록")
		local history = self._T.History
		local entries = history.Entries or {}
		local pages = math.max(1, math.ceil(#entries / 5))
		self.HistoryPage = math.max(1, math.min(pages, self.HistoryPage))
		self:SetText("RecentLabel", "최근 기록 · " .. self:FormatNumber(#entries) .. "/" .. self:FormatNumber(history.RetentionLimit or 10))
		for index = 1, 5 do
			local path = "Recent/Row" .. tostring(index)
			local entry = entries[(self.HistoryPage - 1) * 5 + index]
			self:SetEnabled(path, entry ~= nil)
			if entry ~= nil then
				local rowNumber = (self.HistoryPage - 1) * 5 + index
				self:RenderTableRow(path, entry, self:EndReasonLabel(entry.EndReason) .. " · " .. string.sub(entry.EndedAtUtc or "", 6, 10), rowNumber, entry.RunId == self.SelectedRunId)
				local job = _RunHistoryPresenterLogic:GetDisplayEntry("Jobs", entry.JobId)
				self:SetText(path .. "/Meta", self:AscensionLabel(entry) .. " · " .. job.Name)
			end
		end
		self:SetEnabled("RecentEmpty", #entries == 0)
		local empty = self._T.WaitingHistory and "기록을 불러오는 중..." or (history.Success == false and "기록 조회에 실패했습니다.\n새로고침으로 다시 시도하세요." or "아직 플레이 기록이 없습니다.")
		if self._T.HistoryTimedOut then empty = "기록 조회가 지연되었습니다.\n새로고침으로 다시 시도하세요." end
		self:SetText("RecentEmpty/Label", empty)
		self:SetText("RecentPage", tostring(self.HistoryPage) .. " / " .. tostring(pages))
		self:StyleButton("RecentPrev", self.HistoryPage > 1, false)
		self:StyleButton("RecentNext", self.HistoryPage < pages, false)
		self:StyleButton("Best", history.HasBest == true, history.HasBest and history.BestRecord.RunId == self.SelectedRunId)
		local best = history.BestRecord
		self:SetText("Best/Meta", history.HasBest and (self:AscensionLabel(best) .. " · 단계 " .. self:FormatNumber(best.CompletedStageNumber) .. " · " .. self:FormatNumber(best.ConsumedTurns) .. "턴 · " .. self:FormatTime(best.ElapsedSeconds)) or "아직 정식 완주 기록 없음")
		local status = "최근 기록과 개인 최고 기록 · 종료 시점의 보유 내역"
		if self._T.WaitingHistory then status = "기록을 불러오는 중..."
		elseif self._T.HistoryTimedOut then status = "기록 조회 지연 · 이전 기록 유지 · 새로고침으로 다시 시도하세요"
		elseif history.Success == false then status = "조회 실패 · 이전 기록 유지 (" .. tostring(history.Reason or "UNKNOWN") .. ")"
		elseif history.IsStale then status = "저장 대기 " .. self:FormatNumber(history.PendingResultCount) .. "건 · 마지막으로 저장된 기록 표시"
		elseif self._T.Record ~= nil and not candidate.Success then status = "개인 기록 · " .. self:RankingReasonLabel(candidate.Reason) end
		if (self._T.PublishNotice or "") ~= "" then status = self._T.PublishNotice end
		self:SetText("Status", status)
		self:StyleButton("Refresh", self.RefreshCooldown <= 0, false)
		local summary = self._T.Record
		if summary == nil then
			for _, entry in ipairs(entries) do if entry.RunId == self.SelectedRunId then summary = entry; break end end
		end
		self:SetText("Detail/Title", summary ~= nil and (self:EndReasonLabel(summary.EndReason) .. " · " .. _RunHistoryPresenterLogic:GetDisplayEntry("Jobs", summary.JobId).Name .. " · 기록 #" .. self:FormatNumber(summary.RunId)) or "기록을 선택하세요")
		local conditions = ((self._T.Record or {}).Conditions or {})
		local difficulty = ({ NORMAL = "일반", HARD = "어려움" })[conditions.DifficultyId] or conditions.DifficultyId or ""
		local conditionLabel = conditions.Captured and (" · " .. difficulty) or " · 조건 미수집"
		self:SetText("Detail/Date", summary ~= nil and (self:AscensionLabel(summary) .. " · " .. string.gsub(string.sub(summary.EndedAtUtc or "", 1, 16), "T", " ") .. " UTC" .. (self._T.Record ~= nil and conditionLabel or "")) or "")
		self:SetText("Detail/Eligibility", summary ~= nil and (candidate.Success and "공개 등록 가능" or (summary.RankEligible and "개인 최고 대상" or "개인 최고 제외")) or "")
		self:RenderStatistics(summary)
		self:SetText("RegionRoute", self:RegionRouteLabel())
		self:RenderBuild()
	end

	@ExecSpace("ClientOnly")
	method void RenderWorld()
		-- Public-only presentation reuses the region/build cards but does not request anyone's private history.
		local world = self._T.World
		local entries = world.Entries or {}
		local pages = math.max(1, math.ceil(#entries / 5))
		self.HistoryPage = math.max(1, math.min(pages, self.HistoryPage))
		self:SetText("Title", "월드 랭킹")
		self:SetText("TableHeader/Rank", "순위")
		self:SetText("TableHeader/Name", "닉네임")
		local difficulty = ({ NORMAL = "일반", HARD = "어려움" })[_RunRankingPolicyLogic.DifficultyId] or _RunRankingPolicyLogic.DifficultyId
		self:SetText("RecentLabel", "공개 상위 " .. self:FormatNumber(_RunRankingPolicyLogic.TopLimit) .. "명 · " .. difficulty .. " 완주")
		for index = 1, 5 do
			local path = "Recent/Row" .. tostring(index)
			local entry = entries[(self.HistoryPage - 1) * 5 + index]
			self:SetEnabled(path, entry ~= nil)
			if entry ~= nil then
				self:RenderTableRow(path, entry.Record, entry.Nickname, entry.Rank, entry.EntryId == self.SelectedPublicId)
			end
		end
		self:SetEnabled("RecentEmpty", #entries == 0)
		local empty = "공개 완주 기록이 없습니다.\n내 기록에서 공개 등록하세요."
		if self._T.WorldWaiting then empty = "월드 랭킹을 불러오는 중..."
		elseif self._T.WorldTimedOut then empty = "랭킹 조회 지연 · 새로고침으로 다시 시도하세요."
		elseif world.Success == false then empty = self:RankingReasonLabel(world.Reason)
		elseif not world.IsLoaded then empty = "새로고침으로 월드 랭킹을 조회하세요." end
		self:SetText("RecentEmpty/Label", empty)
		self:SetText("RecentPage", tostring(self.HistoryPage) .. " / " .. tostring(pages))
		self:StyleButton("RecentPrev", self.HistoryPage > 1, false)
		self:StyleButton("RecentNext", self.HistoryPage < pages, false)
		local best = world.OwnBest
		self:SetText("Best/Label", "내 공개 최고 기록")
		self:StyleButton("Best", best ~= nil, best ~= nil and best.EntryId == self.SelectedPublicId)
		self:SetText("Best/Meta", best ~= nil and (self:FormatNumber(best.Record.ConsumedTurns) .. "턴 · 피격 " .. self:FormatNumber(best.Record.HitsTaken) .. "회") or "아직 공개 등록한 기록 없음")
		local status = "턴이 적을수록 → 피격이 적을수록 · 동일 성적 공동 순위"
		if self._T.WorldWaiting then status = "월드 랭킹을 불러오는 중..."
		elseif self._T.WorldTimedOut then status = "랭킹 조회 지연 · 이전 목록 유지 · 새로고침으로 다시 시도하세요."
		elseif world.Success == false then status = self:RankingReasonLabel(world.Reason) .. " · 이전 목록 유지"
		elseif world.ScanLimited then status = self:RankingReasonLabel("RANKING_SCAN_LIMIT")
		elseif world.OwnBestReason ~= nil and world.OwnBestReason ~= "OK" and world.OwnBestReason ~= "NO_PUBLIC_RECORD" then status = "상위 목록 표시 · 내 공개 기록 조회 실패 (" .. world.OwnBestReason .. ")" end
		self:SetText("Status", status)
		self:StyleButton("Refresh", self.RefreshCooldown <= 0, false)
		local summary = self._T.Record
		local public = self._T.SelectedPublic
		self:SetText("Detail/Title", public ~= nil and (public.Nickname .. " · " .. _RunHistoryPresenterLogic:GetDisplayEntry("Jobs", summary.JobId).Name) or "공개 기록을 선택하세요")
		self:SetText("Detail/Date", summary ~= nil and (self:AscensionLabel(summary) .. " · " .. string.gsub(string.sub(summary.EndedAtUtc or "", 1, 16), "T", " ") .. " UTC · " .. difficulty .. " 완주") or "")
		self:SetText("Detail/Eligibility", public ~= nil and "공개 완주 기록" or "")
		self:RenderStatistics(summary)
		self:SetText("RegionRoute", self:RegionRouteLabel())
		self:RenderBuild()
	end

	@ExecSpace("ClientOnly")
	method void RenderBuild()
		-- Refresh all reusable row state, including region-only completion badges.
		local rows = self:GetBuildRows()
		local pages = math.max(1, math.ceil(#rows / 3))
		self.BuildPage = math.max(1, math.min(pages, self.BuildPage))
		for _, tab in ipairs({ "Regions", "Skills", "Augments", "Relics" }) do self:StyleButton("Tab" .. tab, true, self.ActiveTab == tab) end
		for index = 1, 3 do
			local path = "Build/Row" .. tostring(index)
			local row = rows[(self.BuildPage - 1) * 3 + index]
			self:SetEnabled(path, row ~= nil)
			self:RenderRegionBadge(path, row)
			if row ~= nil then
				self:SetText(path .. "/Name", row.Name)
				self:SetText(path .. "/Description", row.Description)
				local icon = self:Find(path .. "/Icon")
				if isvalid(icon) then
					icon:SetEnable(row.Icon ~= nil and row.Icon ~= "")
					icon.SpriteGUIRendererComponent.ImageRUID = row.Icon or ""
					icon.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
				end
			end
		end
		self:SetEnabled("BuildEmpty", #rows == 0)
		local message = "이 판에 보유한 항목이 없습니다."
		if self.SelectedRunId == 0 then message = "왼쪽에서 기록을 선택하세요."
		elseif self._T.Record == nil then message = self.DetailWait > 0 and "상세 기록을 불러오는 중..." or "상세 조회가 지연되었습니다.\n기록을 다시 선택해 주세요."
		elseif self.ActiveTab == "Regions" then
			local history = self._T.Record.RegionHistory or {}
			message = history.Captured and "전투에 진입한 지역이 없습니다." or "이전 버전 기록이라 지역 경로가 수집되지 않았습니다."
		elseif self._T.Record.Build == nil or not self._T.Record.Build.Captured then message = "이전 버전 기록이라 빌드 정보가 수집되지 않았습니다." end
		self:SetText("BuildEmpty/Label", message)
		self:SetText("BuildPage", tostring(self.BuildPage) .. " / " .. tostring(pages) .. " · " .. self:FormatNumber(#rows) .. "항목")
		self:StyleButton("BuildPrev", self.BuildPage > 1, false)
		self:StyleButton("BuildNext", self.BuildPage < pages, false)
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- Frame polling is local-only; explicit history/ranking requests are independently rate-limited.
		local previous = self.RefreshCooldown
		self.HistoryRefreshCooldown = math.max(0, self.HistoryRefreshCooldown - delta)
		self.WorldRefreshCooldown = math.max(0, self.WorldRefreshCooldown - delta)
		self.RefreshCooldown = self.ViewMode == "World" and self.WorldRefreshCooldown or self.HistoryRefreshCooldown
		if not self.IsOpen then return end
		if not self:IsInLobby() then self:SetOpen(false) return end
		if previous > 0 and self.RefreshCooldown == 0 then self:Render() end
		if self._T.WorldWaiting then
			self._T.WorldWait = self._T.WorldWait - delta
			if self._T.WorldWait <= 0 then
				self._T.WorldWaiting = false
				self._T.WorldTimedOut = true
				self:Render()
			end
		end
		if self._T.PublishPending then
			self._T.PublishWait = self._T.PublishWait - delta
			if self._T.PublishWait <= 0 then
				self._T.PublishPending = false; self._T.PublishNotice = "등록 응답 지연 · 잠시 후 새로고침으로 확인하세요."
				self:Render()
			end
		end
		if self._T.ConfirmRunId > 0 and _UtilLogic.ElapsedSeconds > self._T.ConsentUntil then
			self._T.ConfirmRunId = 0; self._T.ConsentUntil = 0; self._T.PublishNotice = ""
			self:Render()
		end
		if self._T.WaitingHistory then
			self._T.HistoryWait = self._T.HistoryWait - delta
			if self._T.HistoryWait <= 0 then
				self._T.WaitingHistory = false
				self._T.HistoryTimedOut = true
				self:Render()
			end
		end
		if self.DetailDelay > 0 then
			self.DetailDelay = self.DetailDelay - delta
			if self.DetailDelay <= 0 then _RunResultServiceLogic:RequestMyRunResultDetail(self.SelectedRunId) end
		end
		if self.DetailWait > 0 then
			self.DetailWait = math.max(0, self.DetailWait - delta)
			if self.DetailWait == 0 then self:RenderBuild() end
		end
		self.PollRemaining = self.PollRemaining - delta
		if self.PollRemaining <= 0 then self.PollRemaining = 0.2 self:PollSnapshots() end
	end

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleHistoryKeyDown(KeyDownEvent event)
		if event.key == KeyboardKey.Escape and self.IsOpen and _UILayerLogic:IsEscapeTarget(self.ModalEntity) then self:SetOpen(false) end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		for _, link in ipairs(self._T.Links or {}) do
			if isvalid(link.Entity) then link.Entity:DisconnectEvent(ButtonClickEvent, link.Handler) end
		end
		self._T.Links = {}
		self.IsOpen = false
		_GameUIPolishLogic:HideWindowImmediately(self.ModalEntity)
	end

end
