@Component
script RunHistoryUIComponent extends Component

	property EntityRef RootEntity = "9486408b-c5ec-4689-ba8d-dcfa3943234c"
	property EntityRef ModalEntity = "d27cc7ac-be0c-44a8-9fc5-c74446bca23c"
	property boolean IsOpen = false
	property integer SelectedRunId = 0
	property integer HistoryPage = 1
	property integer BuildPage = 1
	property string ActiveTab = "Skills"
	property number RefreshCooldown = 0
	property number PollRemaining = 0
	property number DetailDelay = 0
	property number DetailWait = 0

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self._T.Links = {}
		self._T.Entities = {}
		self._T.Details = {}
		self._T.History = { Entries = {}, IsLoaded = false }
		self._T.HistoryRevision = -1
		self._T.CatalogRevision = -1
		self._T.WaitingHistory = false
		self._T.HistoryTimedOut = false
		self._T.HistoryWait = 0
		self._T.Record = nil
		_GameUIPolishLogic:HideWindowImmediately(self.ModalEntity)
		self:Connect("Close", function() self:SetOpen(false) end)
		self:Connect("Refresh", function() self:RequestRefresh() end)
		self:Connect("Best", function() self:SelectBest() end)
		self:Connect("RecentPrev", function() self:ChangeHistoryPage(-1) end)
		self:Connect("RecentNext", function() self:ChangeHistoryPage(1) end)
		self:Connect("BuildPrev", function() self:ChangeBuildPage(-1) end)
		self:Connect("BuildNext", function() self:ChangeBuildPage(1) end)
		for _, tab in ipairs({ "Skills", "Augments", "Relics" }) do
			local selectedTab = tab
			self:Connect("Tab" .. selectedTab, function() self:SelectTab(selectedTab) end)
		end
		for index = 1, 5 do
			local slot = index
			self:Connect("Recent/Row" .. tostring(slot), function()
				local entry = (self._T.History.Entries or {})[(self.HistoryPage - 1) * 5 + slot]
				if entry ~= nil then self:SelectRun(entry.RunId) end
			end)
		end
	end

	@ExecSpace("ClientOnly")
	method Entity Find(string relativePath)
		local cached = self._T.Entities[relativePath]
		if isvalid(cached) then return cached end
		local entity = _EntityService:GetEntityByPath("/ui/RunHistoryUI/Modal/Window/" .. relativePath)
		self._T.Entities[relativePath] = entity
		return entity
	end

	@ExecSpace("ClientOnly")
	method void Connect(string path, any callback)
		local entity = self:Find(path)
		if isvalid(entity) == false or entity.ButtonComponent == nil then return end
		local eventLink = entity:ConnectEvent(ButtonClickEvent, function()
			if not self.IsOpen then return end
			_GameUIPolishLogic:PlayClick()
			callback()
		end)
		table.insert(self._T.Links, { Entity = entity, Handler = eventLink })
	end

	@ExecSpace("ClientOnly")
	method boolean IsInLobby()
		local player = _UserService.LocalPlayer
		return isvalid(player) and isvalid(player.CurrentMap) and player.CurrentMap.Name == "lobby"
	end

	@ExecSpace("ClientOnly")
	method void SetOpen(boolean open)
		if open and not self:IsInLobby() then return end
		if self.IsOpen == open or isvalid(self.ModalEntity) == false then return end
		self.IsOpen = open
		_GameSettingsLogic.IsMenuOpen = open
		if open then
			_GameUIPolishLogic:BringUIGroupToFront(self.RootEntity)
			self._T.HistoryRevision = -1
			self.PollRemaining = 0
			self:PollSnapshots()
			self:RequestRefresh()
		else
			self.DetailDelay = 0
			self.DetailWait = 0
		end
		_GameUIPolishLogic:SetWindowVisible(self.ModalEntity, open)
	end

	@ExecSpace("ClientOnly")
	method void RequestRefresh()
		if not self.IsOpen or self.RefreshCooldown > 0 then return end
		self.RefreshCooldown = 10
		self._T.WaitingHistory = true
		self._T.HistoryTimedOut = false
		self._T.HistoryWait = 8
		self._T.RequestRevision = self._T.HistoryRevision
		_RunResultServiceLogic:RequestMyRunHistory()
		self:Render()
	end

	@ExecSpace("ClientOnly")
	method void PollSnapshots()
		-- Poll synchronized DTOs only. Storage reads are explicit, throttled requests, never frame polling.
		local history = _RunResultServiceLogic:GetLocalRunHistorySnapshot()
		local catalog = _RunHistoryPresenterLogic:GetLocalCatalog()
		local changed = history.Revision ~= self._T.HistoryRevision or catalog.Revision ~= self._T.CatalogRevision
		if changed then
			self._T.History = history
			self._T.HistoryRevision = history.Revision
			self._T.CatalogRevision = catalog.Revision
			if history.Revision ~= self._T.RequestRevision and (history.IsLoaded or history.Success == false) then
				self._T.WaitingHistory = false
				self._T.HistoryTimedOut = false
			end
			local retained = {}
			for _, entry in ipairs(history.Entries or {}) do retained[entry.RunId] = true end
			if history.HasBest and history.BestRecord ~= nil then
				retained[history.BestRecord.RunId] = true
				self._T.Details[history.BestRecord.RunId] = history.BestRecord
			end
			for id, _ in pairs(self._T.Details) do if not retained[id] then self._T.Details[id] = nil end end
			if not retained[self.SelectedRunId] then
				self.SelectedRunId = 0
				self._T.Record = nil
				local first = (history.Entries or {})[1]
				if first ~= nil then self:SelectRun(first.RunId)
				elseif history.HasBest then self:SelectBest() end
			else
				self._T.Record = self._T.Details[self.SelectedRunId]
			end
		end
		local detail = _RunResultServiceLogic:GetLocalRunResultDetailSnapshot()
		if detail.Success and detail.HasRecord and detail.Record ~= nil then
			-- A late response from a previously clicked row must never overwrite the current selection.
			if detail.Record.RunId == self.SelectedRunId and self._T.Record == nil then
				self._T.Record = detail.Record
				self._T.Details[self.SelectedRunId] = detail.Record
				self.DetailDelay = 0
				self.DetailWait = 0
				changed = true
			end
		end
		if changed then self:Render() end
	end

	@ExecSpace("ClientOnly")
	method void SelectRun(integer runId)
		if runId <= 0 then return end
		self.SelectedRunId = runId
		self.BuildPage = 1
		self._T.Record = self._T.Details[runId]
		self.DetailDelay = self._T.Record == nil and 0.31 or 0
		self.DetailWait = self._T.Record == nil and 8 or 0
		self:Render()
	end

	@ExecSpace("ClientOnly")
	method void SelectBest()
		local history = self._T.History
		if not history.HasBest or history.BestRecord == nil then return end
		self._T.Details[history.BestRecord.RunId] = history.BestRecord
		self:SelectRun(history.BestRecord.RunId)
	end

	@ExecSpace("ClientOnly")
	method void SelectTab(string tab)
		if tab ~= "Skills" and tab ~= "Augments" and tab ~= "Relics" then return end
		self.ActiveTab = tab
		self.BuildPage = 1
		self:Render()
	end

	@ExecSpace("ClientOnly")
	method void ChangeHistoryPage(integer delta)
		local pages = math.max(1, math.ceil(#(self._T.History.Entries or {}) / 5))
		self.HistoryPage = math.max(1, math.min(pages, self.HistoryPage + delta))
		self:Render()
	end

	@ExecSpace("ClientOnly")
	method void ChangeBuildPage(integer delta)
		local pages = math.max(1, math.ceil(#self:GetBuildRows() / 3))
		self.BuildPage = math.max(1, math.min(pages, self.BuildPage + delta))
		self:Render()
	end

	@ExecSpace("ClientOnly")
	method string FormatNumber(number value)
		return string.format("%.0f", value or 0)
	end

	@ExecSpace("ClientOnly")
	method string AscensionLabel(any record)
		-- Older stored runs have no challenge field and remain readable as the base difficulty.
		local level = record ~= nil and tonumber(record.AscensionLevel) or 0
		return _AscensionDifficultyLogic:GetDisplayName(math.max(0, math.min(_AscensionDifficultyLogic.MaxLevel, math.floor(level or 0))))
	end

	@ExecSpace("ClientOnly")
	method string FormatTime(number value)
		local seconds = math.max(0, math.floor(value or 0))
		return string.format("%02d:%02d:%02d", math.floor(seconds / 3600), math.floor(seconds / 60) % 60, seconds % 60)
	end

	@ExecSpace("ClientOnly")
	method string EndReasonLabel(string reason)
		return ({ COMPLETED = "완주", DEFEATED = "패배", ABANDONED = "중단" })[reason] or reason or ""
	end

	@ExecSpace("ClientOnly")
	method void SetText(string path, string value)
		local entity = self:Find(path)
		if isvalid(entity) and entity.TextGUIRendererComponent ~= nil then entity.TextGUIRendererComponent.Text = value end
	end

	@ExecSpace("ClientOnly")
	method void SetEnabled(string path, boolean enabled)
		local entity = self:Find(path)
		if isvalid(entity) then entity:SetEnable(enabled) end
	end

	@ExecSpace("ClientOnly")
	method void StyleButton(string path, boolean enabled, boolean selected)
		local entity = self:Find(path)
		if isvalid(entity) == false or entity.ButtonComponent == nil then return end
		entity.ButtonComponent.Enable = enabled
		entity.SpriteGUIRendererComponent.Color = selected and Color(0.23, 0.32, 0.38, 1) or Color(0.12, 0.15, 0.22, enabled and 1 or 0.45)
		if entity.TextGUIRendererComponent ~= nil then
			entity.TextGUIRendererComponent.FontColor = enabled and Color(0.95, 0.96, 0.98, 1) or Color(0.48, 0.52, 0.60, 1)
		end
	end

	@ExecSpace("ClientOnly")
	method table GetBuildRows()
		local rows = {}
		local record = self._T.Record
		if record == nil or record.Build == nil or not record.Build.Captured then return rows end
		local build = record.Build
		if self.ActiveTab == "Skills" then
			for _, skill in ipairs(build.Skills or {}) do
				local display = _RunHistoryPresenterLogic:GetDisplayEntry("Skills", skill.SkillId)
				local slot = skill.SlotIndex > 0 and ("슬롯 " .. self:FormatNumber(skill.SlotIndex)) or "미배치"
				table.insert(rows, { Name = display.Name, Icon = display.Icon,
					Description = "티어 " .. self:FormatNumber(skill.SkillTier) .. " · 보유 " .. self:FormatNumber(skill.Amount) .. " · " .. slot })
				for index, id in ipairs(skill.AugmentIds or {}) do
					local augment = _RunHistoryPresenterLogic:GetDisplayEntry("Augments", id)
					table.insert(rows, { Name = "증강 · " .. augment.Name, Icon = augment.Icon,
						Description = display.Name .. " · 적용 " .. self:FormatNumber(index) .. " · " .. augment.Description })
				end
			end
		else
			for _, entry in ipairs(build[self.ActiveTab] or {}) do
				local id = self.ActiveTab == "Relics" and entry.RelicId or entry.AugmentId
				local count = self.ActiveTab == "Relics" and entry.Amount or entry.Stacks
				local display = _RunHistoryPresenterLogic:GetDisplayEntry(self.ActiveTab, id)
				table.insert(rows, { Name = display.Name .. " ×" .. self:FormatNumber(count), Icon = display.Icon, Description = display.Description })
			end
		end
		return rows
	end

	@ExecSpace("ClientOnly")
	method void Render()
		-- Shows the frozen challenge level beside recent, best, and detailed run results.
		local history = self._T.History
		local entries = history.Entries or {}
		local pages = math.max(1, math.ceil(#entries / 5))
		self.HistoryPage = math.max(1, math.min(pages, self.HistoryPage))
		self:SetText("RecentLabel", "최근 기록 · " .. self:FormatNumber(#entries) .. "/" .. self:FormatNumber(history.RetentionLimit or 10))
		for index = 1, 5 do
			local path = "Recent/Row" .. tostring(index)
			local entry = entries[(self.HistoryPage - 1) * 5 + index]
			self:SetEnabled(path, entry ~= nil)
			if entry ~= nil then
				local job = _RunHistoryPresenterLogic:GetDisplayEntry("Jobs", entry.JobId)
				self:SetText(path .. "/Title", self:EndReasonLabel(entry.EndReason) .. " · " .. job.Name .. " · 완료 단계 " .. self:FormatNumber(entry.CompletedStageNumber))
				self:SetText(path .. "/Meta", self:AscensionLabel(entry) .. " · " .. string.sub(entry.EndedAtUtc or "", 1, 16) .. " UTC · " .. self:FormatNumber(entry.ConsumedTurns) .. "턴")
				self:StyleButton(path, true, entry.RunId == self.SelectedRunId)
			end
		end
		self:SetEnabled("RecentEmpty", #entries == 0)
		local empty = self._T.WaitingHistory and "기록을 불러오는 중..." or (history.Success == false and "기록 조회에 실패했습니다.\n새로고침으로 다시 시도하세요." or "아직 플레이 기록이 없습니다.")
		if self._T.HistoryTimedOut then empty = "기록 조회가 지연되었습니다.\n새로고침으로 다시 시도하세요." end
		self:SetText("RecentEmpty/Label", empty)
		self:SetText("RecentPage", tostring(self.HistoryPage) .. " / " .. tostring(pages))
		self:StyleButton("RecentPrev", self.HistoryPage > 1, false)
		self:StyleButton("RecentNext", self.HistoryPage < pages, false)
		self:StyleButton("Best", history.HasBest == true, history.HasBest and history.BestRecord.RunId == self.SelectedRunId)
		local best = history.BestRecord
		self:SetText("Best/Meta", history.HasBest and (self:AscensionLabel(best) .. " · 단계 " .. self:FormatNumber(best.CompletedStageNumber) .. " · " .. self:FormatNumber(best.ConsumedTurns) .. "턴 · " .. self:FormatTime(best.ElapsedSeconds)) or "정식 완주 기록이 없습니다")
		local status = "이름·설명은 현재 데이터 기준 · 종료 시점의 보유 내역"
		if self._T.WaitingHistory then status = "기록을 불러오는 중..."
		elseif self._T.HistoryTimedOut then status = "기록 조회 지연 · 이전 기록 유지 · 새로고침으로 다시 시도하세요"
		elseif history.Success == false then status = "조회 실패 · 이전 기록 유지 (" .. tostring(history.Reason or "UNKNOWN") .. ")"
		elseif history.IsStale then status = "저장 대기 " .. self:FormatNumber(history.PendingResultCount) .. "건 · 마지막으로 저장된 기록 표시" end
		self:SetText("Status", status)
		self:StyleButton("Refresh", self.RefreshCooldown <= 0, false)
		local summary = self._T.Record
		if summary == nil then
			for _, entry in ipairs(entries) do if entry.RunId == self.SelectedRunId then summary = entry; break end end
		end
		self:SetText("Detail/Title", summary ~= nil and (self:EndReasonLabel(summary.EndReason) .. " · " .. _RunHistoryPresenterLogic:GetDisplayEntry("Jobs", summary.JobId).Name .. " · 기록 #" .. self:FormatNumber(summary.RunId)) or "기록을 선택하세요")
		self:SetText("Detail/Date", summary ~= nil and (string.sub(summary.EndedAtUtc or "", 1, 19) .. " UTC") or "")
		self:SetText("Detail/Eligibility", summary ~= nil and (summary.RankEligible and "최고 기록 집계 대상" or "최고 기록 제외 · " .. (summary.EndReason ~= "COMPLETED" and "미완주" or "테스트/제외 판정")) or "")
		self:SetText("Detail/Stats", summary ~= nil and (self:AscensionLabel(summary) .. " · 완료 단계 " .. self:FormatNumber(summary.CompletedStageNumber) .. " · " .. self:FormatNumber(summary.ConsumedTurns) .. "턴 · 피격 " .. self:FormatNumber(summary.HitsTaken) .. "회 · " .. self:FormatTime(summary.ElapsedSeconds)) or "")
		self:RenderBuild()
	end

	@ExecSpace("ClientOnly")
	method void RenderBuild()
		local rows = self:GetBuildRows()
		local pages = math.max(1, math.ceil(#rows / 3))
		self.BuildPage = math.max(1, math.min(pages, self.BuildPage))
		for _, tab in ipairs({ "Skills", "Augments", "Relics" }) do self:StyleButton("Tab" .. tab, true, self.ActiveTab == tab) end
		for index = 1, 3 do
			local path = "Build/Row" .. tostring(index)
			local row = rows[(self.BuildPage - 1) * 3 + index]
			self:SetEnabled(path, row ~= nil)
			if row ~= nil then
				self:SetText(path .. "/Name", row.Name)
				self:SetText(path .. "/Description", row.Description)
				local icon = self:Find(path .. "/Icon")
				if isvalid(icon) then
					icon:SetEnable(row.Icon ~= nil and row.Icon ~= "")
					icon.SpriteGUIRendererComponent.ImageRUID = row.Icon or ""
					icon.SpriteGUIRendererComponent.Color = Color(1, 1, 1, 1)
				end
			end
		end
		self:SetEnabled("BuildEmpty", #rows == 0)
		local message = "이 판에 보유한 항목이 없습니다."
		if self.SelectedRunId == 0 then message = "왼쪽에서 기록을 선택하세요."
		elseif self._T.Record == nil then message = self.DetailWait > 0 and "상세 기록을 불러오는 중..." or "상세 조회가 지연되었습니다.\n기록을 다시 선택해 주세요."
		elseif self._T.Record.Build == nil or not self._T.Record.Build.Captured then message = "이전 버전 기록이라 빌드 정보가 수집되지 않았습니다." end
		self:SetText("BuildEmpty/Label", message)
		self:SetText("BuildPage", tostring(self.BuildPage) .. " / " .. tostring(pages) .. " · " .. self:FormatNumber(#rows) .. "항목")
		self:StyleButton("BuildPrev", self.BuildPage > 1, false)
		self:StyleButton("BuildNext", self.BuildPage < pages, false)
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		local previous = self.RefreshCooldown
		self.RefreshCooldown = math.max(0, self.RefreshCooldown - delta)
		if not self.IsOpen then return end
		if not self:IsInLobby() then self:SetOpen(false) return end
		if previous > 0 and self.RefreshCooldown == 0 then self:Render() end
		if self._T.WaitingHistory then
			self._T.HistoryWait = self._T.HistoryWait - delta
			if self._T.HistoryWait <= 0 then
				self._T.WaitingHistory = false
				self._T.HistoryTimedOut = true
				self:Render()
			end
		end
		if self.DetailDelay > 0 then
			self.DetailDelay = self.DetailDelay - delta
			if self.DetailDelay <= 0 then _RunResultServiceLogic:RequestMyRunResultDetail(self.SelectedRunId) end
		end
		if self.DetailWait > 0 then
			self.DetailWait = math.max(0, self.DetailWait - delta)
			if self.DetailWait == 0 then self:RenderBuild() end
		end
		self.PollRemaining = self.PollRemaining - delta
		if self.PollRemaining <= 0 then self.PollRemaining = 0.2 self:PollSnapshots() end
	end

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleHistoryKeyDown(KeyDownEvent event)
		if event.key == KeyboardKey.Escape and self.IsOpen then self:SetOpen(false) end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		for _, link in ipairs(self._T.Links or {}) do
			if isvalid(link.Entity) then link.Entity:DisconnectEvent(ButtonClickEvent, link.Handler) end
		end
		self._T.Links = {}
		if self.IsOpen then _GameSettingsLogic.IsMenuOpen = false end
		self.IsOpen = false
		_GameUIPolishLogic:HideWindowImmediately(self.ModalEntity)
	end

end
