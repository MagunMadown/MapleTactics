@Logic
script EnemyPatternStepRepositoryLogic

	property string PatternStepDataSetName = "EnemyPatternSteps"
	property boolean AllowPrototypeCompatibilityFallback = false

	@ExecSpace("ServerOnly")
	method table GetPatternSteps(string patternId)
		-- Loads immutable pattern rows. Runtime selection and mutable progression belong outside the repository.
		local result = {
			Success = false,
			Reason = "PATTERN_NOT_FOUND",
			PatternId = patternId or "",
			Steps = {},
			Source = "DATASET"
		}
		if patternId == nil or patternId == "" then
			result.Reason = "INVALID_PATTERN_ID"
			return result
		end

		local dataSet = _DataService:GetTable(self.PatternStepDataSetName)
		if dataSet == nil then
			result.Reason = "PATTERN_DATASET_MISSING"
			log_error("[EnemyPatternData] dataset missing name=" .. self.PatternStepDataSetName)
			return result
		end

		for rowIndex = 1, dataSet:GetRowCount() do
			if dataSet:GetCell(rowIndex, "PatternId") == patternId
				and self:ParseBooleanCell(dataSet:GetCell(rowIndex, "Enabled")) == true then
				table.insert(result.Steps, self:ConvertRow(dataSet, rowIndex))
			end
		end
		if #result.Steps == 0 then
			log_warning("[EnemyPatternData] pattern missing id=" .. patternId .. " dataset=" .. self.PatternStepDataSetName)
			return result
		end

		table.sort(result.Steps, function(left, right)
			return left.StepIndex < right.StepIndex
		end)
		result.Success = true
		result.Reason = "OK"
		log("[EnemyPatternData] loaded pattern=" .. patternId .. " steps=" .. #result.Steps .. " source=" .. result.Source)
		return result
	end

	@ExecSpace("ServerOnly")
	method table GetPatternStep(string patternId, integer stepIndex)
		local bundle = self:GetPatternSteps(patternId)
		if bundle.Success == false then
			return { Success = false, Reason = bundle.Reason, PatternId = patternId, StepIndex = stepIndex, StepCount = 0 }
		end
		for _, step in ipairs(bundle.Steps) do
			if step.StepIndex == stepIndex then
				return { Success = true, Reason = "OK", PatternId = patternId, StepIndex = stepIndex, StepCount = #bundle.Steps, Step = step, Source = bundle.Source }
			end
		end
		return { Success = false, Reason = "PATTERN_STEP_NOT_FOUND", PatternId = patternId, StepIndex = stepIndex, StepCount = #bundle.Steps }
	end

	@ExecSpace("ServerOnly")
	method table ConvertRow(any dataSet, integer rowIndex)
		return {
			SchemaVersion = math.floor(tonumber(dataSet:GetCell(rowIndex, "SchemaVersion")) or 1),
			PatternId = dataSet:GetCell(rowIndex, "PatternId") or "",
			StepIndex = math.floor(tonumber(dataSet:GetCell(rowIndex, "StepIndex")) or 0),
			ActionType = dataSet:GetCell(rowIndex, "ActionType") or "",
			ConditionType = dataSet:GetCell(rowIndex, "ConditionType") or "ALWAYS",
			TileId = dataSet:GetCell(rowIndex, "TileId") or "",
			TelegraphTurns = math.floor(tonumber(dataSet:GetCell(rowIndex, "TelegraphTurns")) or 0),
			ParamA = dataSet:GetCell(rowIndex, "ParamA") or "",
			ParamB = dataSet:GetCell(rowIndex, "ParamB") or "",
			ParamC = dataSet:GetCell(rowIndex, "ParamC") or "",
			NextStepOnSuccess = math.floor(tonumber(dataSet:GetCell(rowIndex, "NextStepOnSuccess")) or 0),
			NextStepOnFailure = math.floor(tonumber(dataSet:GetCell(rowIndex, "NextStepOnFailure")) or 0),
			RowIndex = rowIndex,
			Source = "DATASET"
		}
	end

	method boolean ParseBooleanCell(any cellValue)
		if cellValue == true then
			return true
		end
		local normalized = string.lower(tostring(cellValue or ""))
		return normalized == "true" or normalized == "1" or normalized == "yes"
	end

end
