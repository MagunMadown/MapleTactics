@Logic
script RegionContentValidatorLogic

	@ExecSpace("ServerOnly")
	method table ValidateById(string regionId)
		local definition = _RegionDefinitionRepositoryLogic:GetRegionDefinition(regionId)
		if definition.Success == false then
			return definition
		end
		return self:ValidateDefinition(definition)
	end

	@ExecSpace("ServerOnly")
	method table ValidateDefinition(table definition)
		local result = {
			Success = false,
			Reason = "CONTENT_VALIDATION_FAILED",
			RegionId = definition.RegionId or "",
			Data = definition
		}
		if definition.SchemaVersion ~= _RegionDefinitionRepositoryLogic.SupportedSchemaVersion then
			return self:Reject(result, "UNSUPPORTED_REGION_SCHEMA")
		end
		if definition.RegionId == nil or definition.RegionId == "" then
			return self:Reject(result, "INVALID_REGION_ID")
		end
		if definition.MatchCount ~= nil and definition.MatchCount > 1 then
			return self:Reject(result, "DATA_DUPLICATE_REGION_ID")
		end
		if definition.DisplayName == nil or definition.DisplayName == "" then
			return self:Reject(result, "REGION_DISPLAY_NAME_MISSING")
		end
		if definition.RegionOrder == nil or definition.RegionOrder <= 0 then
			return self:Reject(result, "INVALID_REGION_ORDER")
		end
		if definition.Enabled ~= true then
			return self:Reject(result, "REGION_DISABLED")
		end
		result.Success = true
		result.Reason = "OK"
		log("[ContentValidation] region valid region=" .. result.RegionId .. " order=" .. definition.RegionOrder)
		return result
	end

	method table Reject(table result, string detailReason)
		result.Success = false
		result.Reason = "CONTENT_VALIDATION_FAILED"
		result.DetailReason = detailReason
		log_error("[ContentValidation] region rejected region=" .. result.RegionId .. " reason=" .. detailReason)
		return result
	end

end
