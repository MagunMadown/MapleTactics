@Logic
script ShopNodeBindingRepositoryLogic extends Logic

	property string DataSetName = "ShopNodeBindings"
	property integer SupportedSchemaVersion = 1

	@ExecSpace("ServerOnly")
	method table GetBinding(string nodeGraphId, string nodeId)
		if nodeGraphId == nil or nodeGraphId == "" or nodeId == nil or nodeId == "" then
			return { Success = false, Reason = "INVALID_SHOP_NODE_BINDING_KEY", NodeGraphId = nodeGraphId or "", NodeId = nodeId or "" }
		end
		local all = self:GetAllBindings()
		if all.Success == false then return all end
		local found = nil
		for _, binding in ipairs(all.Bindings) do
			if binding.NodeGraphId == nodeGraphId and binding.NodeId == nodeId then
				if found ~= nil then return self:Reject(binding, "DUPLICATE_SHOP_NODE_BINDING") end
				found = binding
			end
		end
		if found == nil then
			return { Success = false, Reason = "SHOP_NODE_BINDING_NOT_FOUND", NodeGraphId = nodeGraphId, NodeId = nodeId }
		end
		return found
	end

	@ExecSpace("ServerOnly")
	method table GetAllBindings()
		local dataSet = _DataService:GetTable(self.DataSetName)
		if dataSet == nil then
			return { Success = false, Reason = "SHOP_NODE_BINDING_DATASET_MISSING", Bindings = {} }
		end
		local bindings = {}
		for rowIndex = 1, dataSet:GetRowCount() do
			local binding = self:ConvertRow(dataSet, rowIndex)
			local validation = self:ValidateBinding(binding)
			if validation.Success == false then return validation end
			if validation.Enabled == true then table.insert(bindings, validation) end
		end
		return { Success = true, Reason = "OK", Bindings = bindings }
	end

	method table ConvertRow(any dataSet, integer rowIndex)
		return {
			Success = true,
			Reason = "OK",
			SchemaVersion = math.floor(tonumber(dataSet:GetCell(rowIndex, "SchemaVersion")) or 0),
			NodeGraphId = dataSet:GetCell(rowIndex, "NodeGraphId") or "",
			NodeId = dataSet:GetCell(rowIndex, "NodeId") or "",
			ShopId = dataSet:GetCell(rowIndex, "ShopId") or "",
			Enabled = self:ParseBooleanCell(dataSet:GetCell(rowIndex, "Enabled")),
			RowIndex = rowIndex
		}
	end

	method table ValidateBinding(table binding)
		if binding.SchemaVersion ~= self.SupportedSchemaVersion then
			return self:Reject(binding, "UNSUPPORTED_SHOP_NODE_BINDING_SCHEMA")
		end
		if binding.NodeGraphId == "" or binding.NodeId == "" or binding.ShopId == "" then
			return self:Reject(binding, "SHOP_NODE_BINDING_REQUIRED_FIELD_MISSING")
		end
		binding.Success = true
		binding.Reason = "OK"
		return binding
	end

	method table Reject(table binding, string detailReason)
		binding.Success = false
		binding.Reason = "SHOP_NODE_BINDING_VALIDATION_FAILED"
		binding.DetailReason = detailReason
		log_error("[ShopNodeBinding] rejected graph=" .. (binding.NodeGraphId or "") .. " node=" .. (binding.NodeId or "") .. " shop=" .. (binding.ShopId or "") .. " reason=" .. detailReason)
		return binding
	end

	method boolean ParseBooleanCell(any cellValue)
		if cellValue == true then return true end
		if cellValue == nil or cellValue == false then return false end
		local normalized = string.lower(tostring(cellValue))
		return normalized == "true" or normalized == "1" or normalized == "yes"
	end

end
