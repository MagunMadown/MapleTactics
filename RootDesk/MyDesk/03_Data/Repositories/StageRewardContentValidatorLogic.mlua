@Logic
script StageRewardContentValidatorLogic

	@ExecSpace("ServerOnly")
	method table ValidateAll()
		local loadResult = _StageRewardDefinitionRepositoryLogic:GetAllEntries()
		if loadResult.Success == false then
			return self:Reject("", loadResult.Reason, loadResult.DetailReason or loadResult.Reason, 0)
		end
		local seenIds = {}
		local validatedCount = 0
		for _, entry in ipairs(loadResult.Entries) do
			if seenIds[entry.StageRewardEntryId] == true then
				return self:Reject(entry.StageRewardEntryId, "DATA_DUPLICATE_ID", "DUPLICATE_STAGE_REWARD_ENTRY_ID", entry.RowIndex)
			end
			local stageReference = _ContentReferenceResolverLogic:ResolveReference("STAGE_DEFINITION", entry.StageId)
			if stageReference.Success == false then
				return self:Reject(entry.StageRewardEntryId, "DATA_INVALID_STAGE_REWARD_REFERENCE", "STAGE_" .. stageReference.Reason, entry.RowIndex)
			end
			local rewardReferenceType = entry.RewardType == "CURRENCY" and "RUN_CURRENCY" or "CONSUMABLE"
			local rewardReference = _ContentReferenceResolverLogic:ResolveReference(rewardReferenceType, entry.RewardRefId)
			if rewardReference.Success == false then
				local detailReason = entry.RewardType .. "_" .. rewardReference.Reason
				if entry.RewardType == "CURRENCY" and rewardReference.Reason == "REFERENCE_POLICY_NOT_ALLOWED" then
					detailReason = "DATA_REWARD_CURRENCY_NOT_ALLOWED"
				end
				return self:Reject(entry.StageRewardEntryId, "DATA_INVALID_STAGE_REWARD_REFERENCE", detailReason, entry.RowIndex)
			end
			seenIds[entry.StageRewardEntryId] = true
			validatedCount = validatedCount + 1
		end
		log("[StageRewardValidation] all valid count=" .. validatedCount .. " source=" .. loadResult.Source)
		return { Success = true, Reason = "OK", DetailReason = "", ValidatedCount = validatedCount, Source = loadResult.Source }
	end

	@ExecSpace("ServerOnly")
	method table Reject(string entryId, string reason, string detailReason, integer rowIndex)
		log_error("[StageRewardValidation] rejected entry=" .. entryId .. " row=" .. rowIndex .. " reason=" .. reason .. " detail=" .. detailReason)
		return { Success = false, Reason = reason, DetailReason = detailReason, StageRewardEntryId = entryId, RowIndex = rowIndex, ValidatedCount = 0 }
	end

end
