@Logic
script ShopContentValidatorLogic extends Logic

	@ExecSpace("ServerOnly")
	method table ValidateAll()
		-- Validate shared catalogs, unique relic rewards, currencies, and route bindings.
		local ids = _ShopDefinitionRepositoryLogic:GetAllShopIds()
		if ids.Success == false then
			return self:Reject("", "", ids.Reason, 0)
		end
		local relics = _RelicDefinitionRepositoryLogic:GetAllDefinitions()
		if relics.Success == false then return self:Reject("", "", relics.Reason, 0) end
		local seenRelicIds = {}
		local seenShopIds = {}
		local seenEntryIds = {}
		local validatedShopCount = 0
		local validatedEntryCount = 0
		for _, shopId in ipairs(ids.ShopIds) do
			if shopId == "" or seenShopIds[shopId] == true then
				return self:Reject(shopId, "", "DUPLICATE_OR_EMPTY_SHOP_ID", 0)
			end
			local bundle = _ShopDefinitionRepositoryLogic:GetShopBundle(shopId)
			if bundle.Success == false then
				return self:Reject(shopId, "", bundle.DetailReason or bundle.Reason, 0)
			end
			for _, entry in ipairs(bundle.Entries) do
				if seenEntryIds[entry.ShopEntryId] == true then
					return self:Reject(shopId, entry.ShopEntryId, "DUPLICATE_SHOP_ENTRY_ID", entry.RowIndex or 0)
				end
				if shopId == "shop_relic" and (entry.RewardType ~= "ITEM" or entry.RewardAmount ~= 1) then
					return self:Reject(shopId, entry.ShopEntryId, "INVALID_RELIC_REWARD", entry.RowIndex or 0)
				end
				if entry.RewardType == "ITEM" then
					if relics.Definitions[entry.RewardRefId] == nil or seenRelicIds[entry.RewardRefId] then
						return self:Reject(shopId, entry.ShopEntryId, "MISSING_OR_DUPLICATE_RELIC_REFERENCE", entry.RowIndex or 0)
					end
					seenRelicIds[entry.RewardRefId] = true
				else
					local rewardReferenceType = entry.RewardType == "SKILL" and "SKILL" or "CONSUMABLE"
					local rewardReference = _ContentReferenceResolverLogic:ResolveReference(rewardReferenceType, entry.RewardRefId)
					if rewardReference.Success == false then
						return self:Reject(shopId, entry.ShopEntryId, entry.RewardType .. "_" .. rewardReference.Reason, entry.RowIndex or 0)
					end
				end
				local priceReference = _ContentReferenceResolverLogic:ResolveReference("RUN_CURRENCY", entry.PriceCurrencyId)
				if priceReference.Success == false then
					return self:Reject(shopId, entry.ShopEntryId, "PRICE_CURRENCY_" .. priceReference.Reason, entry.RowIndex or 0)
				end
				seenEntryIds[entry.ShopEntryId] = true
				validatedEntryCount = validatedEntryCount + 1
			end
			seenShopIds[shopId] = true
			validatedShopCount = validatedShopCount + 1
		end
		local bindingValidation = self:ValidateBindings(seenShopIds)
		if bindingValidation.Success == false then return bindingValidation end
		log("[ShopValidation] all valid shops=" .. validatedShopCount .. " entries=" .. validatedEntryCount .. " bindings=" .. bindingValidation.ValidatedBindingCount)
		return { Success = true, Reason = "OK", ValidatedShopCount = validatedShopCount, ValidatedEntryCount = validatedEntryCount, ValidatedBindingCount = bindingValidation.ValidatedBindingCount }
	end

	@ExecSpace("ServerOnly")
	method table ValidateBindings(table validShopIds)
		local all = _ShopNodeBindingRepositoryLogic:GetAllBindings()
		if all.Success == false then
			return self:Reject(all.ShopId or "", all.NodeId or "", all.DetailReason or all.Reason, all.RowIndex or 0)
		end
		local seenBindingKeys = {}
		for _, binding in ipairs(all.Bindings) do
			local bindingKey = binding.NodeGraphId .. ":" .. binding.NodeId
			if seenBindingKeys[bindingKey] == true then
				return self:Reject(binding.ShopId, binding.NodeId, "DUPLICATE_SHOP_NODE_BINDING", binding.RowIndex or 0)
			end
			local node = _NodeDefinitionRepositoryLogic:GetNodeDefinition(binding.NodeGraphId, binding.NodeId)
			if node.Success == false or node.NodeType ~= "SHOP" then
				return self:Reject(binding.ShopId, binding.NodeId, "SHOP_NODE_BINDING_NODE_INVALID", binding.RowIndex or 0)
			end
			if validShopIds[binding.ShopId] ~= true then
				return self:Reject(binding.ShopId, binding.NodeId, "SHOP_NODE_BINDING_SHOP_INVALID", binding.RowIndex or 0)
			end
			seenBindingKeys[bindingKey] = true
		end
		local nodes = _DataService:GetTable("NodeDefinitions")
		if nodes == nil then return self:Reject("", "", "NODE_DATASET_NOT_FOUND", 0) end
		for rowIndex = 1, nodes:GetRowCount() do
			local enabledValue = nodes:GetCell(rowIndex, "Enabled")
			local enabledText = string.lower(tostring(enabledValue or ""))
			local enabled = enabledValue == true or enabledText == "true" or enabledText == "1" or enabledText == "yes"
			if nodes:GetCell(rowIndex, "NodeType") == "SHOP" and enabled == true then
				local nodeGraphId = nodes:GetCell(rowIndex, "NodeGraphId") or ""
				local nodeId = nodes:GetCell(rowIndex, "NodeId") or ""
				if seenBindingKeys[nodeGraphId .. ":" .. nodeId] ~= true then
					return self:Reject("", nodeId, "SHOP_NODE_BINDING_MISSING", rowIndex)
				end
			end
		end
		return { Success = true, Reason = "OK", ValidatedBindingCount = #all.Bindings }
	end

	@ExecSpace("ServerOnly")
	method table ValidateById(string shopId)
		local all = self:ValidateAll()
		if all.Success == false then
			return all
		end
		local bundle = _ShopDefinitionRepositoryLogic:GetShopBundle(shopId)
		if bundle.Success == false then
			return bundle
		end
		return { Success = true, Reason = "OK", Data = bundle, ValidatedEntryCount = #bundle.Entries }
	end

	@ExecSpace("ServerOnly")
	method table Reject(string shopId, string entryId, string detailReason, integer rowIndex)
		log_error("[ShopValidation] rejected shop=" .. shopId .. " entry=" .. entryId .. " row=" .. rowIndex .. " reason=" .. detailReason)
		return { Success = false, Reason = "SHOP_CONTENT_VALIDATION_FAILED", DetailReason = detailReason, ShopId = shopId, ShopEntryId = entryId, RowIndex = rowIndex }
	end

end
