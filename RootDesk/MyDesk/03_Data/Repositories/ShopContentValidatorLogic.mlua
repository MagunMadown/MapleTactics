@Logic
script ShopContentValidatorLogic

	@ExecSpace("ServerOnly")
	method table ValidateAll()
		local ids = _ShopDefinitionRepositoryLogic:GetAllShopIds()
		if ids.Success == false then
			return self:Reject("", "", ids.Reason, 0)
		end
		local seenShopIds = {}
		local seenEntryIds = {}
		local validatedShopCount = 0
		local validatedEntryCount = 0
		for _, shopId in ipairs(ids.ShopIds) do
			if shopId == "" or seenShopIds[shopId] == true then
				return self:Reject(shopId, "", "DUPLICATE_OR_EMPTY_SHOP_ID", 0)
			end
			local bundle = _ShopDefinitionRepositoryLogic:GetShopBundle(shopId)
			if bundle.Success == false then
				return self:Reject(shopId, "", bundle.DetailReason or bundle.Reason, 0)
			end
			local node = _NodeDefinitionRepositoryLogic:GetNodeDefinition(bundle.Definition.NodeGraphId, bundle.Definition.NodeId)
			if node.Success == false or node.NodeType ~= "SHOP" or node.NodeId ~= shopId then
				return self:Reject(shopId, "", "SHOP_NODE_REFERENCE_INVALID", bundle.Definition.RowIndex or 0)
			end
			for _, entry in ipairs(bundle.Entries) do
				if seenEntryIds[entry.ShopEntryId] == true then
					return self:Reject(shopId, entry.ShopEntryId, "DUPLICATE_SHOP_ENTRY_ID", entry.RowIndex or 0)
				end
				local rewardReferenceType = entry.RewardType == "SKILL" and "SKILL" or "CONSUMABLE"
				local rewardReference = _ContentReferenceResolverLogic:ResolveReference(rewardReferenceType, entry.RewardRefId)
				if rewardReference.Success == false then
					return self:Reject(shopId, entry.ShopEntryId, entry.RewardType .. "_" .. rewardReference.Reason, entry.RowIndex or 0)
				end
				local priceReference = _ContentReferenceResolverLogic:ResolveReference("RUN_CURRENCY", entry.PriceCurrencyId)
				if priceReference.Success == false then
					return self:Reject(shopId, entry.ShopEntryId, "PRICE_CURRENCY_" .. priceReference.Reason, entry.RowIndex or 0)
				end
				seenEntryIds[entry.ShopEntryId] = true
				validatedEntryCount = validatedEntryCount + 1
			end
			seenShopIds[shopId] = true
			validatedShopCount = validatedShopCount + 1
		end
		log("[ShopValidation] all valid shops=" .. validatedShopCount .. " entries=" .. validatedEntryCount)
		return { Success = true, Reason = "OK", ValidatedShopCount = validatedShopCount, ValidatedEntryCount = validatedEntryCount }
	end

	@ExecSpace("ServerOnly")
	method table ValidateById(string shopId)
		local all = self:ValidateAll()
		if all.Success == false then
			return all
		end
		local bundle = _ShopDefinitionRepositoryLogic:GetShopBundle(shopId)
		if bundle.Success == false then
			return bundle
		end
		return { Success = true, Reason = "OK", Data = bundle, ValidatedEntryCount = #bundle.Entries }
	end

	@ExecSpace("ServerOnly")
	method table Reject(string shopId, string entryId, string detailReason, integer rowIndex)
		log_error("[ShopValidation] rejected shop=" .. shopId .. " entry=" .. entryId .. " row=" .. rowIndex .. " reason=" .. detailReason)
		return { Success = false, Reason = "SHOP_CONTENT_VALIDATION_FAILED", DetailReason = detailReason, ShopId = shopId, ShopEntryId = entryId, RowIndex = rowIndex }
	end

end
