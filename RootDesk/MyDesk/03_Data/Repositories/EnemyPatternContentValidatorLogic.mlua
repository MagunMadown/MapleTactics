@Logic
script EnemyPatternContentValidatorLogic

	property integer SupportedSchemaVersion = 1

	@ExecSpace("ServerOnly")
	method table ValidateById(string patternId)
		local bundle = _EnemyPatternStepRepositoryLogic:GetPatternSteps(patternId)
		if bundle.Success == false then
			return bundle
		end
		return self:ValidateBundle(bundle)
	end

	@ExecSpace("ServerOnly")
	method table ValidateBundle(table bundle)
		-- Keeps pattern schema rules separate from loading and runtime decision policy.
		local result = {
			Success = false,
			Reason = "CONTENT_VALIDATION_FAILED",
			DetailReason = "",
			PatternId = bundle.PatternId or "",
			StepCount = 0,
			Data = bundle
		}
		local steps = bundle.Steps or {}
		if result.PatternId == "" then
			return self:Reject(result, "INVALID_PATTERN_ID")
		end
		if #steps == 0 then
			return self:Reject(result, "PATTERN_STEPS_EMPTY")
		end

		local expectedStepIndex = 1
		for _, step in ipairs(steps) do
			if step.SchemaVersion ~= self.SupportedSchemaVersion then
				return self:Reject(result, "UNSUPPORTED_PATTERN_SCHEMA")
			end
			if step.PatternId ~= result.PatternId then
				return self:Reject(result, "PATTERN_ID_MISMATCH")
			end
			if step.StepIndex ~= expectedStepIndex then
				return self:Reject(result, "INVALID_PATTERN_STEP_SEQUENCE")
			end
			if self:IsSupportedAction(step.ActionType) == false then
				return self:Reject(result, "UNSUPPORTED_PATTERN_ACTION")
			end
			if self:IsSupportedCondition(step.ConditionType) == false then
				return self:Reject(result, "UNSUPPORTED_PATTERN_CONDITION")
			end
			local usesSkillReference = step.ActionType == "EXECUTE_TILE"
				or step.ActionType == "TELEGRAPH_TILE"
				or step.ActionType == "CHARGE_FORWARD"
				or step.ActionType == "CAST_INTERRUPTIBLE"
				or step.ActionType == "BOSS_JUMP_TELEGRAPH"
				or step.ActionType == "BOSS_LAND_OPPOSITE"
			if usesSkillReference and step.TileId == "" then
				return self:Reject(result, "PATTERN_TILE_ID_MISSING")
			end
			if usesSkillReference then
				local skillValidation = _ContentValidatorLogic:ValidateSkillById(step.TileId)
				if skillValidation.Success == false then
					return self:Reject(result, "PATTERN_SKILL_REFERENCE_INVALID")
				end
			end
			if step.TelegraphTurns < 0 then
				return self:Reject(result, "INVALID_TELEGRAPH_TURNS")
			end
			if step.ActionType == "TELEGRAPH_TILE" and step.TelegraphTurns <= 0 then
				return self:Reject(result, "TELEGRAPH_TURNS_REQUIRED")
			end
			if step.ActionType == "CHARGE_FORWARD" and step.TelegraphTurns ~= 1 then
				return self:Reject(result, "CHARGE_REQUIRES_ONE_TELEGRAPH_TURN")
			end
			if step.ActionType == "CAST_INTERRUPTIBLE" and (tonumber(step.ParamA) or 0) < 1 then
				return self:Reject(result, "CAST_INTERRUPT_HITS_REQUIRED")
			end
			if step.ConditionType == "DISTANCE_EQ" and (tonumber(step.ParamA) or -1) < 0 then
				return self:Reject(result, "INVALID_DISTANCE_PARAM")
			end
			if step.ConditionType == "DISTANCE_LE" and (tonumber(step.ParamA) or -1) <= 0 then
				return self:Reject(result, "INVALID_DISTANCE_PARAM")
			end
			if step.ConditionType == "CELL_FREE" and self:IsSupportedCellSelector(step.ParamA) == false then
				return self:Reject(result, "INVALID_CELL_FREE_SELECTOR")
			end
			expectedStepIndex = expectedStepIndex + 1
		end
		for _, step in ipairs(steps) do
			if step.NextStepOnSuccess < 0 or step.NextStepOnSuccess > #steps then
				return self:Reject(result, "SUCCESS_NEXT_STEP_OUT_OF_RANGE")
			end
			if step.NextStepOnFailure < 0 or step.NextStepOnFailure > #steps then
				return self:Reject(result, "FAILURE_NEXT_STEP_OUT_OF_RANGE")
			end
			if step.ActionType == "CAST_INTERRUPTIBLE" then
				local executeStepIndex = step.NextStepOnSuccess
				if executeStepIndex <= 0 then
					executeStepIndex = step.StepIndex + 1
					if executeStepIndex > #steps then
						executeStepIndex = 1
					end
				end
				local executeStep = steps[executeStepIndex]
				if executeStep == nil or executeStep.ActionType ~= "EXECUTE_TILE" or executeStep.TileId ~= step.TileId then
					return self:Reject(result, "CAST_EXECUTE_STEP_MISMATCH")
				end
			end
		end

		result.Success = true
		result.Reason = "OK"
		result.StepCount = #steps
		log("[ContentValidation] enemy pattern valid pattern=" .. result.PatternId .. " steps=" .. result.StepCount .. " source=" .. (bundle.Source or ""))
		return result
	end

	method boolean IsSupportedAction(string actionType)
		return actionType == "WAIT"
			or actionType == "SUMMON_ENEMIES"
			or actionType == "TURN_TO_PLAYER"
			or actionType == "MOVE_TOWARD"
			or actionType == "MOVE_AWAY"
			or actionType == "MOVE_FIXED_FACING"
			or actionType == "TELEGRAPH_TILE"
			or actionType == "CHARGE_FORWARD"
			or actionType == "CAST_INTERRUPTIBLE"
			or actionType == "EXECUTE_TILE"
			or actionType == "BOSS_JUMP_TELEGRAPH"
			or actionType == "BOSS_LAND_OPPOSITE"
	end

	method boolean IsSupportedCondition(string conditionType)
		return conditionType == "ALWAYS"
			or conditionType == "SUMMON_READY"
			or conditionType == "DISTANCE_EQ"
			or conditionType == "DISTANCE_LE"
			or conditionType == "HP_RATIO_LE"
			or conditionType == "CELL_FREE"
	end

	method boolean IsSupportedCellSelector(string selector)
		return selector == "FRONT"
			or selector == "BACK"
			or selector == "TOWARD_PLAYER"
			or selector == "AWAY_FROM_PLAYER"
	end

	@ExecSpace("ServerOnly")
	method table Reject(table result, string detailReason)
		result.Success = false
		result.Reason = "CONTENT_VALIDATION_FAILED"
		result.DetailReason = detailReason
		log_error("[ContentValidation] enemy pattern rejected pattern=" .. (result.PatternId or "") .. " reason=" .. detailReason)
		return result
	end

end
