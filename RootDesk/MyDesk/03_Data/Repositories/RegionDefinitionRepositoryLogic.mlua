@Logic
script RegionDefinitionRepositoryLogic

	property string DataSetName = "RegionDefinitions"
	property integer SupportedSchemaVersion = 1

	@ExecSpace("ServerOnly")
	method table GetRegionDefinition(string regionId)
		local result = {
			Success = false,
			Reason = "REGION_DEFINITION_NOT_FOUND",
			RegionId = regionId or ""
		}
		if regionId == nil or regionId == "" then
			result.Reason = "INVALID_REGION_ID"
			return result
		end

		local dataSet = _DataService:GetTable(self.DataSetName)
		if dataSet == nil then
			result.Reason = "REGION_DATASET_NOT_FOUND"
			return result
		end

		local matchedDefinition = nil
		local matchCount = 0
		for rowIndex = 1, dataSet:GetRowCount() do
			if dataSet:GetCell(rowIndex, "RegionId") == regionId then
				matchCount = matchCount + 1
				if matchedDefinition == nil then
					matchedDefinition = self:ConvertRow(dataSet, rowIndex)
				end
			end
		end
		if matchedDefinition == nil then
			log_warning("[RegionDefinition] missing region=" .. regionId)
			return result
		end
		matchedDefinition.MatchCount = matchCount
		return matchedDefinition
	end

	@ExecSpace("ServerOnly")
	method table ConvertRow(any dataSet, integer rowIndex)
		local regionId = dataSet:GetCell(rowIndex, "RegionId") or ""
		local result = {
			Success = true,
			Reason = "OK",
			SchemaVersion = math.floor(tonumber(dataSet:GetCell(rowIndex, "SchemaVersion")) or 0),
			RegionId = regionId,
			DisplayName = dataSet:GetCell(rowIndex, "DisplayName") or regionId,
			RegionOrder = math.floor(tonumber(dataSet:GetCell(rowIndex, "RegionOrder")) or 0),
			Enabled = self:ParseBooleanCell(dataSet:GetCell(rowIndex, "Enabled")),
			Source = "DATASET"
		}
		return result
	end

	method boolean ParseBooleanCell(any cellValue)
		if cellValue == true then
			return true
		end
		if cellValue == nil or cellValue == false then
			return false
		end
		local normalized = string.lower(tostring(cellValue))
		return normalized == "true" or normalized == "1" or normalized == "yes"
	end

end
