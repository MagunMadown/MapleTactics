@Logic
script WeaponContentValidatorLogic extends Logic

	property integer SupportedSchemaVersion = 1

	@ExecSpace("ServerOnly")
	method table ValidateById(string weaponType)
		-- Row rules for one weapon entry. Skill validation calls this so a mistyped WeaponType is
		-- rejected at content-validation time instead of silently equipping nothing at cast time.
		local definition = _WeaponDefinitionRepositoryLogic:GetWeaponDefinition(weaponType)
		if definition.Success == false then
			return { Success = false, Reason = definition.Reason, WeaponType = weaponType or "", Data = definition }
		end
		return self:ValidateDefinition(definition)
	end

	@ExecSpace("ServerOnly")
	method table ValidateDefinition(table definition)
		-- Every field a cast-time equip depends on is checked here; callers only read Success.
		local result = {
			Success = false,
			Reason = "CONTENT_VALIDATION_FAILED",
			WeaponType = definition.WeaponType or "",
			Data = definition
		}
		if definition.SchemaVersion ~= self.SupportedSchemaVersion then
			return self:Reject(result, "UNSUPPORTED_WEAPON_SCHEMA")
		end
		if definition.WeaponType == nil or definition.WeaponType == "" then
			return self:Reject(result, "INVALID_WEAPON_TYPE")
		end
		if definition.MatchCount ~= nil and definition.MatchCount > 1 then
			return self:Reject(result, "DATA_DUPLICATE_WEAPON_TYPE")
		end
		if definition.Enabled ~= true then
			return self:Reject(result, "WEAPON_DISABLED")
		end
		if definition.DisplayName == nil or definition.DisplayName == "" then
			return self:Reject(result, "WEAPON_DISPLAY_NAME_MISSING")
		end
		if _WeaponDefinitionRepositoryLogic:IsSupportedEquipSlot(definition.EquipSlot) == false then
			return self:Reject(result, "UNSUPPORTED_WEAPON_EQUIP_SLOT")
		end
		if definition.WeaponRuid == nil or definition.WeaponRuid == "" then
			return self:Reject(result, "WEAPON_RUID_MISSING")
		end
		-- A two-handed weapon already occupies the sub-weapon slot, so pairing one with a second item
		-- would silently drop that item at equip time. Dual wield is a ONE_HANDED-only shape.
		local subWeaponRuid = definition.SubWeaponRuid or ""
		if subWeaponRuid ~= "" and definition.EquipSlot == "TWO_HANDED" then
			return self:Reject(result, "SUB_WEAPON_ON_TWO_HANDED")
		end

		result.Success = true
		result.Reason = "OK"
		log("[ContentValidation] weapon valid weaponType=" .. result.WeaponType .. " slot=" .. definition.EquipSlot .. " ruid=" .. definition.WeaponRuid .. " sub=" .. subWeaponRuid)
		return result
	end

	@ExecSpace("ServerOnly")
	method table Reject(table result, string detailReason)
		-- Mirrors the other domain validators so ContentIntegrity can read DetailReason uniformly.
		result.Success = false
		result.Reason = "CONTENT_VALIDATION_FAILED"
		result.DetailReason = detailReason
		log_error("[ContentValidation] weapon rejected weaponType=" .. result.WeaponType .. " reason=" .. detailReason)
		return result
	end

end
