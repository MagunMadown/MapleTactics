@Logic
script UnionBoardDefinitionRepositoryLogic extends Logic

    property string CellDataSetName = "UnionBoardCellDefinitions"

    property string SpecialZoneDataSetName = "UnionSpecialZoneDefinitions"

    property integer ExpectedVisualCellCount = 96

    property integer ExpectedCoreCellCount = 4

    property integer ExpectedTier1CellCount = 18

    property integer ExpectedTier2CellCount = 12

    property integer ExpectedTier3CellCount = 16

    property integer ExpectedTier4CellCount = 22

    property integer ExpectedTier5CellCount = 28

    @ExecSpace("ServerOnly")
    method table GetCell(integer gridX, integer gridY)
        local result = { Success = false, Reason = "BOARD_CELL_NOT_FOUND", GridX = gridX, GridY = gridY, MatchCount = 0 }
        if self:IsIntegerCell(gridX) == false or self:IsIntegerCell(gridY) == false then
            result.Reason = "INVALID_COORDINATE"
            return result
        end
        local dataSet = _DataService:GetTable(self.CellDataSetName)
        if dataSet == nil then
            result.Reason = "BOARD_CELL_DATASET_NOT_FOUND"
            return result
        end
        local matchCount = 0
        for rowIndex = 1, dataSet:GetRowCount() do
            if tonumber(dataSet:GetCell(rowIndex, "GridX")) == gridX and tonumber(dataSet:GetCell(rowIndex, "GridY")) == gridY then
                matchCount = matchCount + 1
                if result.Success == false then result = self:ConvertCellRow(dataSet, rowIndex) end
            end
        end
        result.MatchCount = matchCount
        if matchCount > 1 then
            result.Success = false
            result.Reason = "DUPLICATE_BOARD_COORDINATE"
        end
        return result
    end

    @ExecSpace("ServerOnly")
    method table GetCellById(string cellId)
        local result = { Success = false, Reason = "BOARD_CELL_NOT_FOUND", CellId = cellId or "", MatchCount = 0 }
        if self:IsSafeToken(cellId) == false then
            result.Reason = "INVALID_CELL_ID"
            return result
        end
        local dataSet = _DataService:GetTable(self.CellDataSetName)
        if dataSet == nil then
            result.Reason = "BOARD_CELL_DATASET_NOT_FOUND"
            return result
        end
        local matchCount = 0
        for rowIndex = 1, dataSet:GetRowCount() do
            if dataSet:GetCell(rowIndex, "CellId") == cellId then
                matchCount = matchCount + 1
                if result.Success == false then result = self:ConvertCellRow(dataSet, rowIndex) end
            end
        end
        result.MatchCount = matchCount
        if matchCount > 1 then
            result.Success = false
            result.Reason = "DUPLICATE_CELL_ID"
        end
        return result
    end

    @ExecSpace("ServerOnly")
    method table GetAllCells()
        local result = { Success = false, Reason = "BOARD_CELL_DATASET_NOT_FOUND", Cells = {}, CellCount = 0 }
        local dataSet = _DataService:GetTable(self.CellDataSetName)
        if dataSet == nil then return result end
        for rowIndex = 1, dataSet:GetRowCount() do table.insert(result.Cells, self:ConvertCellRow(dataSet, rowIndex)) end
        table.sort(result.Cells, function(left, right)
            if left.SortOrder == right.SortOrder then return left.CellId < right.CellId end
            return left.SortOrder < right.SortOrder
        end)
        result.Success = true
        result.Reason = "OK"
        result.CellCount = #result.Cells
        return result
    end

    @ExecSpace("ServerOnly")
    method boolean IsInsideBoard(integer gridX, integer gridY)
        local result = self:GetCell(gridX, gridY)
        return result.Success == true and (result.MatchCount or 0) == 1
    end

    @ExecSpace("ServerOnly")
    method table GetCoreCells()
        local result = { Success = false, Reason = "BOARD_CELL_DATASET_NOT_FOUND", Cells = {}, CellCount = 0 }
        local allCells = self:GetAllCells()
        if allCells.Success == false then return result end
        for _, cell in ipairs(allCells.Cells) do
            if cell.IsCore == true then table.insert(result.Cells, cell) end
        end
        result.Success = true
        result.Reason = "OK"
        result.CellCount = #result.Cells
        return result
    end

    @ExecSpace("ServerOnly")
    method table GetCellsByEffectType(string effectType)
        local result = { Success = false, Reason = "UNKNOWN_EFFECT_TYPE", EffectType = effectType or "", Cells = {}, CellCount = 0 }
        if self:IsKnownEffectType(effectType, false) == false then return result end
        local allCells = self:GetAllCells()
        if allCells.Success == false then
            result.Reason = allCells.Reason
            return result
        end
        for _, cell in ipairs(allCells.Cells) do
            if cell.EffectType == effectType then table.insert(result.Cells, cell) end
        end
        result.Success = true
        result.Reason = "OK"
        result.CellCount = #result.Cells
        return result
    end

    @ExecSpace("ServerOnly")
    method table GetBoardTier(integer gridX, integer gridY)
        local cell = self:GetCell(gridX, gridY)
        if cell.Success == false or (cell.MatchCount or 0) ~= 1 then return cell end
        return { Success = true, Reason = "OK", GridX = gridX, GridY = gridY, BoardTier = cell.BoardTier }
    end

    @ExecSpace("ServerOnly")
    method table GetSpecialZone(string specialZoneId)
        local result = { Success = false, Reason = "SPECIAL_ZONE_NOT_FOUND", SpecialZoneId = specialZoneId or "", MatchCount = 0 }
        if self:IsSafeToken(specialZoneId) == false then
            result.Reason = "INVALID_SPECIAL_ZONE_ID"
            return result
        end
        local dataSet = _DataService:GetTable(self.SpecialZoneDataSetName)
        if dataSet == nil then
            result.Reason = "SPECIAL_ZONE_DATASET_NOT_FOUND"
            return result
        end
        local matchCount = 0
        for rowIndex = 1, dataSet:GetRowCount() do
            if dataSet:GetCell(rowIndex, "SpecialZoneId") == specialZoneId then
                matchCount = matchCount + 1
                if result.Success == false then result = self:ConvertSpecialZoneRow(dataSet, rowIndex) end
            end
        end
        result.MatchCount = matchCount
        if matchCount > 1 then
            result.Success = false
            result.Reason = "DUPLICATE_SPECIAL_ZONE_ID"
        end
        return result
    end

    @ExecSpace("ServerOnly")
    method table ValidateBoard()
        local result = { Success = false, Reason = "CONTENT_VALIDATION_FAILED", CheckedCellCount = 0, CheckedCoreCellCount = 0, CheckedSpecialZoneCount = 0, ErrorCount = 0, Errors = {}, ErrorSnapshot = "" }
        local cellDataSet = _DataService:GetTable(self.CellDataSetName)
        if cellDataSet == nil then
            self:AddValidationError(result, self.CellDataSetName, 0, "", "DATASET_NOT_FOUND")
            return self:FinalizeValidation(result)
        end
        local zoneDataSet = _DataService:GetTable(self.SpecialZoneDataSetName)
        if zoneDataSet == nil then
            self:AddValidationError(result, self.SpecialZoneDataSetName, 0, "", "DATASET_NOT_FOUND")
            return self:FinalizeValidation(result)
        end

        local knownZones = {}
        local seenZoneSortOrders = {}
        for rowIndex = 1, zoneDataSet:GetRowCount() do
            result.CheckedSpecialZoneCount = result.CheckedSpecialZoneCount + 1
            local zone = self:ConvertSpecialZoneRow(zoneDataSet, rowIndex)
            if self:IsSafeToken(zone.SpecialZoneId) == false then
                self:AddValidationError(result, self.SpecialZoneDataSetName, rowIndex, zone.SpecialZoneId, "INVALID_SPECIAL_ZONE_ID")
            elseif knownZones[zone.SpecialZoneId] == true then
                self:AddValidationError(result, self.SpecialZoneDataSetName, rowIndex, zone.SpecialZoneId, "DUPLICATE_SPECIAL_ZONE_ID")
            else
                knownZones[zone.SpecialZoneId] = true
            end
            if zone.DisplayName == "" then self:AddValidationError(result, self.SpecialZoneDataSetName, rowIndex, zone.SpecialZoneId, "DISPLAY_NAME_MISSING") end
            if self:IsKnownEffectType(zone.EffectType, false) == false then self:AddValidationError(result, self.SpecialZoneDataSetName, rowIndex, zone.SpecialZoneId, "UNKNOWN_EFFECT_TYPE") end
            if self:IsNonNegativeNumberCell(zoneDataSet:GetCell(rowIndex, "EffectValue")) == false then self:AddValidationError(result, self.SpecialZoneDataSetName, rowIndex, zone.SpecialZoneId, "INVALID_EFFECT_VALUE") end
            if self:IsKnownUnionRank(zone.RequiredUnionRank) == false then self:AddValidationError(result, self.SpecialZoneDataSetName, rowIndex, zone.SpecialZoneId, "UNKNOWN_UNION_RANK") end
            if self:IsKnownActivationRule(zone.ActivationRule) == false then self:AddValidationError(result, self.SpecialZoneDataSetName, rowIndex, zone.SpecialZoneId, "UNKNOWN_ACTIVATION_RULE") end
            if self:IsPositiveIntegerCell(zoneDataSet:GetCell(rowIndex, "SortOrder")) == false then
                self:AddValidationError(result, self.SpecialZoneDataSetName, rowIndex, zone.SpecialZoneId, "INVALID_SORT_ORDER")
            elseif seenZoneSortOrders[zone.SortOrder] == true then
                self:AddValidationError(result, self.SpecialZoneDataSetName, rowIndex, zone.SpecialZoneId, "DUPLICATE_SORT_ORDER")
            else
                seenZoneSortOrders[zone.SortOrder] = true
            end
        end

        local seenCellIds = {}
        local seenCoordinates = {}
        local seenVisualNames = {}
        local seenCellSortOrders = {}
        local allCells = {}
        local coreCells = {}
        local prototypeHpCells = {}
        local tierCounts = { 0, 0, 0, 0, 0 }
        for rowIndex = 1, cellDataSet:GetRowCount() do
            result.CheckedCellCount = result.CheckedCellCount + 1
            local cell = self:ConvertCellRow(cellDataSet, rowIndex)
            table.insert(allCells, cell)
            local label = cell.CellId
            if self:IsSafeToken(cell.CellId) == false then
                self:AddValidationError(result, self.CellDataSetName, rowIndex, label, "INVALID_CELL_ID")
            elseif seenCellIds[cell.CellId] == true then
                self:AddValidationError(result, self.CellDataSetName, rowIndex, label, "DUPLICATE_CELL_ID")
            else
                seenCellIds[cell.CellId] = true
            end
            local gridXCell = cellDataSet:GetCell(rowIndex, "GridX")
            local gridYCell = cellDataSet:GetCell(rowIndex, "GridY")
            if self:IsIntegerCell(gridXCell) == false or self:IsIntegerCell(gridYCell) == false then
                self:AddValidationError(result, self.CellDataSetName, rowIndex, label, "INVALID_COORDINATE")
            else
                local coordinateKey = tostring(cell.GridX) .. ":" .. tostring(cell.GridY)
                if seenCoordinates[coordinateKey] == true then
                    self:AddValidationError(result, self.CellDataSetName, rowIndex, label, "DUPLICATE_COORDINATE")
                else
                    seenCoordinates[coordinateKey] = true
                end
            end
            if self:IsKnownRegion(cell.RegionId) == false then self:AddValidationError(result, self.CellDataSetName, rowIndex, label, "UNKNOWN_REGION") end
            if self:IsKnownEffectType(cell.EffectType, true) == false then self:AddValidationError(result, self.CellDataSetName, rowIndex, label, "UNKNOWN_EFFECT_TYPE") end
            local effectValueCell = cellDataSet:GetCell(rowIndex, "EffectValue")
            if self:IsNonNegativeNumberCell(effectValueCell) == false then
                self:AddValidationError(result, self.CellDataSetName, rowIndex, label, "INVALID_EFFECT_VALUE")
            elseif cell.EffectType == "" and cell.EffectValue ~= 0 then
                self:AddValidationError(result, self.CellDataSetName, rowIndex, label, "EFFECT_VALUE_WITHOUT_EFFECT_TYPE")
            elseif cell.EffectType ~= "" and cell.EffectValue <= 0 then
                self:AddValidationError(result, self.CellDataSetName, rowIndex, label, "NON_POSITIVE_EFFECT_VALUE")
            end
            if self:IsIntegerCell(cellDataSet:GetCell(rowIndex, "BoardTier")) == false or cell.BoardTier < 1 or cell.BoardTier > 5 then
                self:AddValidationError(result, self.CellDataSetName, rowIndex, label, "INVALID_BOARD_TIER")
            else
                tierCounts[cell.BoardTier] = tierCounts[cell.BoardTier] + 1
            end
            if self:IsStrictBooleanCell(cellDataSet:GetCell(rowIndex, "IsCore")) == false then self:AddValidationError(result, self.CellDataSetName, rowIndex, label, "INVALID_IS_CORE") end
            if cell.VisualCellName == "" then
                self:AddValidationError(result, self.CellDataSetName, rowIndex, label, "VISUAL_CELL_NAME_MISSING")
            elseif seenVisualNames[cell.VisualCellName] == true then
                self:AddValidationError(result, self.CellDataSetName, rowIndex, label, "DUPLICATE_VISUAL_CELL_NAME")
            else
                seenVisualNames[cell.VisualCellName] = true
            end
            if self:IsPositiveIntegerCell(cellDataSet:GetCell(rowIndex, "SortOrder")) == false then
                self:AddValidationError(result, self.CellDataSetName, rowIndex, label, "INVALID_SORT_ORDER")
            elseif seenCellSortOrders[cell.SortOrder] == true then
                self:AddValidationError(result, self.CellDataSetName, rowIndex, label, "DUPLICATE_SORT_ORDER")
            else
                seenCellSortOrders[cell.SortOrder] = true
            end
            if cell.SpecialZoneId ~= "" and knownZones[cell.SpecialZoneId] ~= true then self:AddValidationError(result, self.CellDataSetName, rowIndex, label, "UNKNOWN_SPECIAL_ZONE") end
            if cell.IsCore == true then
                table.insert(coreCells, cell)
                if cell.RegionId ~= "CORE" or cell.EffectType ~= "" or cell.EffectValue ~= 0 or cell.BoardTier ~= 1 or cell.SpecialZoneId ~= "" then self:AddValidationError(result, self.CellDataSetName, rowIndex, label, "INVALID_CORE_CONFIGURATION") end
            elseif cell.RegionId == "CORE" then
                self:AddValidationError(result, self.CellDataSetName, rowIndex, label, "NON_CORE_CELL_IN_CORE_REGION")
            end
            if cell.EffectType == "MAX_HP" and cell.BoardTier == 1 then
                table.insert(prototypeHpCells, cell)
                if cell.RegionId ~= "COMBAT" or cell.EffectValue ~= 1 then self:AddValidationError(result, self.CellDataSetName, rowIndex, label, "INVALID_PROTOTYPE_HP_CELL") end
            end
        end
        result.CheckedCoreCellCount = #coreCells
        if result.CheckedCellCount ~= self.ExpectedVisualCellCount then self:AddValidationError(result, self.CellDataSetName, 0, "", "UNEXPECTED_CELL_COUNT:" .. tostring(result.CheckedCellCount)) end
        if #coreCells ~= self.ExpectedCoreCellCount then
            self:AddValidationError(result, self.CellDataSetName, 0, "", "UNEXPECTED_CORE_CELL_COUNT:" .. tostring(#coreCells))
        elseif self:AreCellsContiguous(coreCells) == false then
            self:AddValidationError(result, self.CellDataSetName, 0, "", "CORE_CELLS_NOT_CONTIGUOUS")
        end
        if #prototypeHpCells ~= 3 then
            self:AddValidationError(result, self.CellDataSetName, 0, "", "UNEXPECTED_PROTOTYPE_HP_CELL_COUNT:" .. tostring(#prototypeHpCells))
        elseif self:AreCellsContiguous(prototypeHpCells) == false then
            self:AddValidationError(result, self.CellDataSetName, 0, "", "PROTOTYPE_HP_CELLS_NOT_CONTIGUOUS")
        end

        local expectedTierCounts = { self.ExpectedTier1CellCount, self.ExpectedTier2CellCount, self.ExpectedTier3CellCount, self.ExpectedTier4CellCount, self.ExpectedTier5CellCount }
        local expectedCumulativeCounts = { 18, 30, 46, 68, 96 }
        local cumulativeCount = 0
        for tier = 1, 5 do
            if tierCounts[tier] ~= expectedTierCounts[tier] then
                self:AddValidationError(result, self.CellDataSetName, 0, "TIER_" .. tostring(tier), "UNEXPECTED_TIER_CELL_COUNT:" .. tostring(tierCounts[tier]))
            end
            cumulativeCount = cumulativeCount + tierCounts[tier]
            if cumulativeCount ~= expectedCumulativeCounts[tier] then
                self:AddValidationError(result, self.CellDataSetName, 0, "TIER_LE_" .. tostring(tier), "UNEXPECTED_CUMULATIVE_CELL_COUNT:" .. tostring(cumulativeCount))
            end
            if self:AreCellsConnectedToCoreAtTier(allCells, tier) == false then
                self:AddValidationError(result, self.CellDataSetName, 0, "TIER_LE_" .. tostring(tier), "ACCESSIBLE_CELLS_NOT_CONNECTED_TO_CORE")
            end
        end
        return self:FinalizeValidation(result)
    end

    method table ConvertCellRow(any dataSet, integer rowIndex)
        return { Success = true, Reason = "OK", CellId = dataSet:GetCell(rowIndex, "CellId") or "", GridX = math.floor(tonumber(dataSet:GetCell(rowIndex, "GridX")) or 0), GridY = math.floor(tonumber(dataSet:GetCell(rowIndex, "GridY")) or 0), RegionId = dataSet:GetCell(rowIndex, "RegionId") or "", EffectType = dataSet:GetCell(rowIndex, "EffectType") or "", EffectValue = tonumber(dataSet:GetCell(rowIndex, "EffectValue")) or 0, BoardTier = math.floor(tonumber(dataSet:GetCell(rowIndex, "BoardTier")) or 0), IsCore = self:ParseBooleanCell(dataSet:GetCell(rowIndex, "IsCore")), SpecialZoneId = dataSet:GetCell(rowIndex, "SpecialZoneId") or "", VisualCellName = dataSet:GetCell(rowIndex, "VisualCellName") or "", SortOrder = math.floor(tonumber(dataSet:GetCell(rowIndex, "SortOrder")) or 0), RowIndex = rowIndex, Source = "DATASET" }
    end

    method table ConvertSpecialZoneRow(any dataSet, integer rowIndex)
        return { Success = true, Reason = "OK", SpecialZoneId = dataSet:GetCell(rowIndex, "SpecialZoneId") or "", DisplayName = dataSet:GetCell(rowIndex, "DisplayName") or "", EffectType = dataSet:GetCell(rowIndex, "EffectType") or "", EffectValue = tonumber(dataSet:GetCell(rowIndex, "EffectValue")) or 0, RequiredUnionRank = dataSet:GetCell(rowIndex, "RequiredUnionRank") or "", ActivationRule = dataSet:GetCell(rowIndex, "ActivationRule") or "", SortOrder = math.floor(tonumber(dataSet:GetCell(rowIndex, "SortOrder")) or 0), RowIndex = rowIndex, Source = "DATASET" }
    end

    method boolean AreCellsContiguous(table cells)
        if cells == nil or #cells == 0 then return false end
        local remaining = {}
        for _, cell in ipairs(cells) do remaining[tostring(cell.GridX) .. ":" .. tostring(cell.GridY)] = true end
        local queue = { cells[1] }
        remaining[tostring(cells[1].GridX) .. ":" .. tostring(cells[1].GridY)] = nil
        local visitedCount = 0
        local index = 1
        local directions = { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }
        while index <= #queue do
            local current = queue[index]
            index = index + 1
            visitedCount = visitedCount + 1
            for _, direction in ipairs(directions) do
                local neighborX = current.GridX + direction[1]
                local neighborY = current.GridY + direction[2]
                local key = tostring(neighborX) .. ":" .. tostring(neighborY)
                if remaining[key] == true then
                    remaining[key] = nil
                    table.insert(queue, { GridX = neighborX, GridY = neighborY })
                end
            end
        end
        return visitedCount == #cells
    end

    method boolean AreCellsConnectedToCoreAtTier(table cells, integer maximumTier)
        if cells == nil or #cells == 0 or maximumTier < 1 or maximumTier > 5 then return false end
        local accessibleCells = {}
        local hasCore = false
        for _, cell in ipairs(cells) do
            if cell.BoardTier <= maximumTier then
                table.insert(accessibleCells, cell)
                if cell.IsCore == true then hasCore = true end
            end
        end
        return hasCore == true and self:AreCellsContiguous(accessibleCells)
    end

    method boolean IsKnownRegion(string regionId)
        return regionId == "GROWTH" or regionId == "COMBAT" or regionId == "EXPLORATION" or regionId == "TACTICS" or regionId == "CORE"
    end

    method boolean IsKnownEffectType(string effectType, boolean allowEmpty)
        if allowEmpty == true and effectType == "" then return true end
        return effectType == "MESO_GAIN_RATE" or effectType == "ITEM_DROP_RATE" or effectType == "AUGMENT_REROLL" or effectType == "UNION_POINT_GAIN_RATE" or effectType == "STARTING_POTION" or effectType == "MAX_HP" or effectType == "INVENTORY_SLOT" or effectType == "STARTING_SKILL" or effectType == "STARTING_RANDOM_RELIC" or effectType == "ADDITIONAL_SKILL_UNLOCK"
    end

    method boolean IsKnownUnionRank(string rankId)
        if rankId == nil or rankId == "" then return false end
        local rank = _UnionRankDefinitionRepositoryLogic:GetDefinition(rankId)
        return rank.Success == true and (rank.MatchCount or 0) == 1
    end

    method boolean IsKnownActivationRule(string activationRule)
        return activationRule == "LANDMARK_CELL" or activationRule == "FULL_ZONE" or activationRule == "OCCUPIED_CELL_COUNT"
    end

    method boolean IsSafeToken(string value)
        return value ~= nil and value ~= "" and string.match(value, "^[%w_]+$") ~= nil
    end

    method boolean IsIntegerCell(any cellValue)
        local numeric = tonumber(cellValue)
        return numeric ~= nil and numeric == math.floor(numeric)
    end

    method boolean IsPositiveIntegerCell(any cellValue)
        local numeric = tonumber(cellValue)
        return numeric ~= nil and numeric > 0 and numeric == math.floor(numeric)
    end

    method boolean IsNonNegativeNumberCell(any cellValue)
        local numeric = tonumber(cellValue)
        return numeric ~= nil and numeric >= 0
    end

    method boolean IsStrictBooleanCell(any cellValue)
        local normalized = string.lower(tostring(cellValue or ""))
        return normalized == "true" or normalized == "false" or normalized == "1" or normalized == "0"
    end

    method boolean ParseBooleanCell(any cellValue)
        local normalized = string.lower(tostring(cellValue or ""))
        return normalized == "true" or normalized == "1"
    end

    method void AddValidationError(table result, string dataSetName, integer rowIndex, string definitionId, string detailReason)
        table.insert(result.Errors, { DataSetName = dataSetName or "", RowIndex = rowIndex, DefinitionId = definitionId or "", DetailReason = detailReason or "UNKNOWN" })
    end

    method table FinalizeValidation(table result)
        local parts = {}
        for _, item in ipairs(result.Errors) do table.insert(parts, item.DataSetName .. "[" .. tostring(item.RowIndex) .. "]" .. item.DefinitionId .. "=" .. item.DetailReason) end
        result.ErrorCount = #result.Errors
        result.ErrorSnapshot = table.concat(parts, "|")
        if result.ErrorCount == 0 then
            result.Success = true
            result.Reason = "OK"
            log("[UnionBoardValidation] valid cells=" .. result.CheckedCellCount .. " core=" .. result.CheckedCoreCellCount .. " zones=" .. result.CheckedSpecialZoneCount)
        else
            log_error("[UnionBoardValidation] rejected errors=" .. result.ErrorCount .. " details=" .. result.ErrorSnapshot)
        end
        return result
    end

end
