@Logic
script SkillDefinitionRepositoryLogic extends Logic

	property string SkillDataSetName = "SkillDefinitions"
	property string JobSkillDataSetNames = "WarriorSkillDefinitions,MageSkillDefinitions,ArcherSkillDefinitions,ThiefSkillDefinitions,PirateSkillDefinitions"
	property string EnemySkillDataSetName = "EnemySkillDefinitions"
	property string EffectStepDataSetName = "SkillEffectSteps"

	@ExecSpace("ServerOnly")
	method table GetSkillDataSetNames()
		-- Single source of truth for which datasets constitute "skills": the shared table, one CSV per job
		-- class, and the enemy-only table. Enemy rows are deliberately kept out of the job catalogs so a
		-- player can never be granted them and so player skill edits cannot break monster attacks.
		local names = { self.SkillDataSetName }
		for token in string.gmatch(self.JobSkillDataSetNames or "", "([^,]+)") do
			table.insert(names, token)
		end
		if self.EnemySkillDataSetName ~= "" then
			table.insert(names, self.EnemySkillDataSetName)
		end
		return names
	end

	@ExecSpace("ServerOnly")
	method table GetPlayerGrantableSkillIds()
		-- Skill ids a player may own. Enemy-only rows are excluded so HUD slots and rewards never surface them.
		local names = { self.SkillDataSetName }
		for token in string.gmatch(self.JobSkillDataSetNames or "", "([^,]+)") do
			table.insert(names, token)
		end
		local skillIds = {}
		for _, dataSetName in ipairs(names) do
			local dataSet = _DataService:GetTable(dataSetName)
			if dataSet ~= nil then
				for rowIndex = 1, dataSet:GetRowCount() do
					local skillId = dataSet:GetCell(rowIndex, "SkillId") or ""
					if skillId ~= "" then
						table.insert(skillIds, skillId)
					end
				end
			end
		end
		return skillIds
	end

	@ExecSpace("ServerOnly")
	method table GetJobSkillDefinitions(string jobId)
		-- Loads the selected job's dedicated skill dataset and returns its converted definitions.
		local result = {
			Success = false,
			Reason = "UNKNOWN_JOB",
			JobId = jobId or "",
			Skills = {}
		}
		if jobId == nil or jobId == "" then
			result.Reason = "INVALID_JOB_ID"
			return result
		end

		local dataSetNamesByJobId = {
			warrior = "WarriorSkillDefinitions",
			mage = "MageSkillDefinitions",
			archer = "ArcherSkillDefinitions",
			thief = "ThiefSkillDefinitions",
			pirate = "PirateSkillDefinitions"
		}
		local dataSetName = dataSetNamesByJobId[jobId]
		if dataSetName == nil then
			log_warning("[SkillDefinition] unknown job catalog job=" .. jobId)
			return result
		end

		local dataSet = _DataService:GetTable(dataSetName)
		if dataSet == nil then
			result.Reason = "JOB_SKILL_DATASET_MISSING"
			log_warning("[SkillDefinition] missing job dataset job=" .. jobId .. " dataset=" .. dataSetName)
			return result
		end

		for rowIndex = 1, dataSet:GetRowCount() do
			local definition = self:ConvertSkillRow(dataSet, rowIndex)
			if definition.SkillId ~= "" and definition.RequiredJobTag == jobId then
				table.insert(result.Skills, definition)
			end
		end
		if #result.Skills == 0 then
			result.Reason = "JOB_SKILLS_NOT_FOUND"
			log_warning("[SkillDefinition] empty job catalog job=" .. jobId .. " dataset=" .. dataSetName)
			return result
		end

		result.Success = true
		result.Reason = "OK"
		result.DataSetName = dataSetName
		log("[SkillDefinition] job catalog loaded job=" .. jobId .. " dataset=" .. dataSetName .. " skills=" .. #result.Skills)
		return result
	end

	@ExecSpace("ServerOnly")
	method table GetSkillDefinition(string skillId)
		local result = {
			Success = false,
			Reason = "UNKNOWN_SKILL",
			SkillId = skillId
		}
		if skillId == nil or skillId == "" then
			result.Reason = "INVALID_SKILL_ID"
			return result
		end

		local matchedDefinition = nil
		local matchCount = 0
		for _, dataSetName in ipairs(self:GetSkillDataSetNames()) do
			local dataSet = _DataService:GetTable(dataSetName)
			if dataSet ~= nil then
				for rowIndex = 1, dataSet:GetRowCount() do
					if dataSet:GetCell(rowIndex, "SkillId") == skillId then
						matchCount = matchCount + 1
						if matchedDefinition == nil then
							matchedDefinition = self:ConvertSkillRow(dataSet, rowIndex)
						end
					end
				end
			end
		end
		if matchedDefinition ~= nil then
			matchedDefinition.MatchCount = matchCount
			return matchedDefinition
		end

		log_warning("[SkillDefinition] missing skill=" .. skillId .. " dataset=" .. self.SkillDataSetName)
		return result
	end

	@ExecSpace("ServerOnly")
	method table GetEffectSteps(string effectSetId)
		local result = {
			Success = false,
			Reason = "EFFECT_SET_NOT_FOUND",
			EffectSetId = effectSetId,
			Steps = {}
		}
		if effectSetId == nil or effectSetId == "" then
			result.Reason = "INVALID_EFFECT_SET_ID"
			return result
		end

		local dataSet = _DataService:GetTable(self.EffectStepDataSetName)
		if dataSet ~= nil then
			for rowIndex = 1, dataSet:GetRowCount() do
				if dataSet:GetCell(rowIndex, "EffectSetId") == effectSetId then
					table.insert(result.Steps, self:ConvertEffectStepRow(dataSet, rowIndex))
				end
			end
		end

		if #result.Steps == 0 then
			log_warning("[SkillEffectData] missing effectSet=" .. effectSetId .. " dataset=" .. self.EffectStepDataSetName)
			return result
		end

		table.sort(result.Steps, function(left, right)
			return left.StepIndex < right.StepIndex
		end)
		result.Success = true
		result.Reason = "OK"
		return result
	end

	@ExecSpace("ServerOnly")
	method table GetSkillBundle(string skillId)
		local definition = self:GetSkillDefinition(skillId)
		if definition.Success == false then
			return {
				Success = false,
				Reason = definition.Reason,
				SkillId = skillId,
				Definition = definition,
				EffectSteps = {}
			}
		end
		local effects = self:GetEffectSteps(definition.EffectSetId)
		if effects.Success == false then
			return {
				Success = false,
				Reason = effects.Reason,
				SkillId = skillId,
				Definition = definition,
				EffectSteps = effects.Steps
			}
		end
		return {
			Success = true,
			Reason = "OK",
			SkillId = skillId,
			Definition = definition,
			EffectSteps = effects.Steps
		}
	end

	@ExecSpace("ServerOnly")
	method table ConvertSkillRow(any dataSet, integer rowIndex)
		local skillId = dataSet:GetCell(rowIndex, "SkillId") or ""
		local actionDuration = math.max(0.1, tonumber(dataSet:GetCell(rowIndex, "ActionDuration")) or 0.1)
		local result = {
			Success = true,
			Reason = "OK",
			SchemaVersion = math.floor(tonumber(dataSet:GetCell(rowIndex, "SchemaVersion")) or 1),
			SkillId = skillId,
			DisplayName = dataSet:GetCell(rowIndex, "DisplayName") or skillId,
			SkillTags = dataSet:GetCell(rowIndex, "SkillTags") or "",
			TargetingType = dataSet:GetCell(rowIndex, "TargetingType") or "",
			Range = math.floor(tonumber(dataSet:GetCell(rowIndex, "Range")) or 0),
			TargetOffsets = dataSet:GetCell(rowIndex, "TargetOffsets") or "",
			CooldownTurns = math.floor(tonumber(dataSet:GetCell(rowIndex, "CooldownTurns")) or 0),
			CostType = dataSet:GetCell(rowIndex, "CostType") or "",
			CostValue = tonumber(dataSet:GetCell(rowIndex, "CostValue")) or 0,
			MotionProfileId = dataSet:GetCell(rowIndex, "MotionProfileId") or "",
			EffectSetId = dataSet:GetCell(rowIndex, "EffectSetId") or "",
			RequiredJobTag = dataSet:GetCell(rowIndex, "RequiredJobTag") or "",
			FreePlay = self:ParseBooleanCell(dataSet:GetCell(rowIndex, "FreePlay")),
			ActionDuration = actionDuration,
			CastEffectRuid = dataSet:GetCell(rowIndex, "CastEffectRuid") or "",
			HitEffectRuid = dataSet:GetCell(rowIndex, "HitEffectRuid") or "",
			EffectScale = math.max(0.05, tonumber(dataSet:GetCell(rowIndex, "EffectScale")) or 1),
			-- Which avatar weapon this skill is swung with. Empty means "keep whatever is equipped",
			-- which is what every enemy row uses since enemies carry no avatar.
			WeaponType = dataSet:GetCell(rowIndex, "WeaponType") or "",
			-- Travelling projectile visual. Empty ProjectileRuid means the skill resolves with no
			-- flight phase at all, which is the case for every melee and area skill.
			ProjectileRuid = dataSet:GetCell(rowIndex, "ProjectileRuid") or "",
			ProjectileSpeed = tonumber(dataSet:GetCell(rowIndex, "ProjectileSpeed")) or 0,
			ProjectileScale = math.max(0.05, tonumber(dataSet:GetCell(rowIndex, "ProjectileScale")) or 1),
			-- Holds the shot back after the cast. 0 fires it together with the cast effect, which is
			-- what a ranged skill should read as; a positive value delays the launch.
			ProjectileLaunchDelay = math.max(0, tonumber(dataSet:GetCell(rowIndex, "ProjectileLaunchDelay")) or 0),
			-- 32x32 icon sprite taken from the skill's own resource pack. Empty is legal and falls back
			-- to the placeholder at the presentation layer, which is what every enemy row relies on.
			IconRuid = dataSet:GetCell(rowIndex, "IconRuid") or "",
			-- Sprite-based enemies use their own attack clip while avatar players keep MotionProfileId.
			CasterMotionRuid = dataSet:GetCell(rowIndex, "CasterMotionRuid") or "",
			CasterMotionPlayRate = tonumber(dataSet:GetCell(rowIndex, "CasterMotionPlayRate")) or 1,
			CasterMotionDuration = tonumber(dataSet:GetCell(rowIndex, "CasterMotionDuration")) or actionDuration,
			EnemyQueueTurns = math.max(0, math.floor(tonumber(dataSet:GetCell(rowIndex, "EnemyQueueTurns")) or 0)),
			HudIconRuid = dataSet:GetCell(rowIndex, "HudIconRuid") or "",
			Source = "DATASET"
		}
		log("[SkillDefinition] loaded skill=" .. result.SkillId .. " target=" .. result.TargetingType .. " effects=" .. result.EffectSetId .. " cooldown=" .. result.CooldownTurns .. " enemyQueueTurns=" .. result.EnemyQueueTurns .. " hudIcon=" .. result.HudIconRuid .. " motion=" .. result.CasterMotionRuid .. " cast=" .. result.CastEffectRuid .. " hit=" .. result.HitEffectRuid .. " weapon=" .. result.WeaponType .. " projectile=" .. result.ProjectileRuid .. " projectileSpeed=" .. result.ProjectileSpeed .. " icon=" .. result.IconRuid .. " source=" .. result.Source)
		return result
	end

	@ExecSpace("ServerOnly")
	method table ConvertEffectStepRow(any dataSet, integer rowIndex)
		return {
			SchemaVersion = math.floor(tonumber(dataSet:GetCell(rowIndex, "SchemaVersion")) or 1),
			EffectSetId = dataSet:GetCell(rowIndex, "EffectSetId") or "",
			StepIndex = math.floor(tonumber(dataSet:GetCell(rowIndex, "StepIndex")) or 0),
			EffectType = dataSet:GetCell(rowIndex, "EffectType") or "",
			TargetSelector = dataSet:GetCell(rowIndex, "TargetSelector") or "",
			Value = tonumber(dataSet:GetCell(rowIndex, "Value")) or 0,
			ParameterA = dataSet:GetCell(rowIndex, "ParameterA") or "",
			ParameterB = dataSet:GetCell(rowIndex, "ParameterB") or "",
			ConditionId = dataSet:GetCell(rowIndex, "ConditionId") or "",
			Source = "DATASET"
		}
	end

	method boolean ParseBooleanCell(any cellValue)
		-- Accepts native booleans and the string values emitted by CSV-backed UserDataSets.
		if cellValue == true then
			return true
		end
		local normalized = string.lower(tostring(cellValue or ""))
		return normalized == "true" or normalized == "1" or normalized == "yes"
	end

end
