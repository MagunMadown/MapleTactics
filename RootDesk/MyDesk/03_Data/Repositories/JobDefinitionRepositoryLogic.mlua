@Logic
script JobDefinitionRepositoryLogic

	property string JobDataSetName = "JobDefinitions"
	property string StartingSkillDataSetName = "JobStartingSkillEntries"

	@ExecSpace("ServerOnly")
	method table GetJobDefinition(string jobId)
		local result = {
			Success = false,
			Reason = "UNKNOWN_JOB",
			JobId = jobId or ""
		}
		if jobId == nil or jobId == "" then
			result.Reason = "INVALID_JOB_ID"
			return result
		end

		local dataSet = _DataService:GetTable(self.JobDataSetName)
		if dataSet == nil then
			result.Reason = "JOB_DATASET_MISSING"
			return result
		end

		local matchCount = 0
		for rowIndex = 1, dataSet:GetRowCount() do
			if dataSet:GetCell(rowIndex, "JobId") == jobId then
				matchCount = matchCount + 1
				if result.Success == false then
					result = self:ConvertJobRow(dataSet, rowIndex)
				end
			end
		end
		if result.Success == false then
			log_warning("[JobDefinition] missing job=" .. jobId .. " dataset=" .. self.JobDataSetName)
			return result
		end

		result.MatchCount = matchCount
		log("[JobDefinition] loaded job=" .. result.JobId .. " mechanic=" .. result.JobMechanicId .. " startSet=" .. result.StartingSkillSetId .. " queue=" .. result.BaseQueueCapacity)
		return result
	end

	@ExecSpace("ServerOnly")
	method table GetStartingSkillEntries(string startingSkillSetId)
		local result = {
			Success = false,
			Reason = "STARTING_SKILL_SET_NOT_FOUND",
			StartingSkillSetId = startingSkillSetId or "",
			Entries = {}
		}
		if startingSkillSetId == nil or startingSkillSetId == "" then
			result.Reason = "INVALID_STARTING_SKILL_SET_ID"
			return result
		end

		local dataSet = _DataService:GetTable(self.StartingSkillDataSetName)
		if dataSet == nil then
			result.Reason = "STARTING_SKILL_DATASET_MISSING"
			return result
		end
		for rowIndex = 1, dataSet:GetRowCount() do
			if dataSet:GetCell(rowIndex, "StartingSkillSetId") == startingSkillSetId
				and self:ParseBooleanCell(dataSet:GetCell(rowIndex, "Enabled")) == true then
				table.insert(result.Entries, self:ConvertStartingSkillRow(dataSet, rowIndex))
			end
		end
		if #result.Entries == 0 then
			return result
		end

		table.sort(result.Entries, function(left, right)
			if left.SlotIndex == right.SlotIndex then
				return left.SkillId < right.SkillId
			end
			return left.SlotIndex < right.SlotIndex
		end)
		result.Success = true
		result.Reason = "OK"
		log("[JobDefinition] starting skills loaded set=" .. startingSkillSetId .. " entries=" .. #result.Entries)
		return result
	end

	@ExecSpace("ServerOnly")
	method table GetJobBundle(string jobId)
		local definition = self:GetJobDefinition(jobId)
		if definition.Success == false then
			return { Success = false, Reason = definition.Reason, JobId = jobId, Definition = definition, StartingSkills = {} }
		end
		local startingSkills = self:GetStartingSkillEntries(definition.StartingSkillSetId)
		if startingSkills.Success == false then
			return { Success = false, Reason = startingSkills.Reason, JobId = jobId, Definition = definition, StartingSkills = startingSkills.Entries }
		end
		return {
			Success = true,
			Reason = "OK",
			JobId = jobId,
			Definition = definition,
			StartingSkills = startingSkills.Entries
		}
	end

	@ExecSpace("ServerOnly")
	method table ConvertJobRow(any dataSet, integer rowIndex)
		return {
			Success = true,
			Reason = "OK",
			SchemaVersion = math.floor(tonumber(dataSet:GetCell(rowIndex, "SchemaVersion")) or 0),
			JobId = dataSet:GetCell(rowIndex, "JobId") or "",
			DisplayName = dataSet:GetCell(rowIndex, "DisplayName") or "",
			JobTags = dataSet:GetCell(rowIndex, "JobTags") or "",
			BaseMaxHp = math.floor(tonumber(dataSet:GetCell(rowIndex, "BaseMaxHp")) or 0),
			BaseQueueCapacity = math.floor(tonumber(dataSet:GetCell(rowIndex, "BaseQueueCapacity")) or 0),
			StartingSkillSetId = dataSet:GetCell(rowIndex, "StartingSkillSetId") or "",
			JobMechanicId = dataSet:GetCell(rowIndex, "JobMechanicId") or "",
			JobPassiveSetId = dataSet:GetCell(rowIndex, "JobPassiveSetId") or "",
			Enabled = self:ParseBooleanCell(dataSet:GetCell(rowIndex, "Enabled")),
			Source = "DATASET"
		}
	end

	@ExecSpace("ServerOnly")
	method table ConvertStartingSkillRow(any dataSet, integer rowIndex)
		return {
			SchemaVersion = math.floor(tonumber(dataSet:GetCell(rowIndex, "SchemaVersion")) or 0),
			StartingSkillSetId = dataSet:GetCell(rowIndex, "StartingSkillSetId") or "",
			SlotIndex = math.floor(tonumber(dataSet:GetCell(rowIndex, "SlotIndex")) or 0),
			SkillId = dataSet:GetCell(rowIndex, "SkillId") or "",
			Count = math.floor(tonumber(dataSet:GetCell(rowIndex, "Count")) or 0),
			Enabled = self:ParseBooleanCell(dataSet:GetCell(rowIndex, "Enabled")),
			Source = "DATASET"
		}
	end

	method boolean ParseBooleanCell(any cellValue)
		if cellValue == true then
			return true
		end
		local normalized = string.lower(tostring(cellValue or ""))
		return normalized == "true" or normalized == "1" or normalized == "yes"
	end

end
