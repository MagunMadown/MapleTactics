@Logic
script StageRewardDefinitionRepositoryLogic

	property string DataSetName = "StageRewardDefinitions"
	property integer SupportedSchemaVersion = 1

	@ExecSpace("ServerOnly")
	method table GetAllEntries()
		-- Repository owns Dataset loading and row-shape rules only.
		local result = { Success = false, Reason = "STAGE_REWARD_DATASET_MISSING", DetailReason = "", Entries = {}, Source = "" }
		local dataSet = _DataService:GetTable(self.DataSetName)
		if dataSet == nil then
			return result
		end
		for rowIndex = 1, dataSet:GetRowCount() do
			local entry = self:ConvertRow(dataSet, rowIndex)
			local validation = self:ValidateEntry(entry)
			if validation.Success == false then
				result.Reason = validation.Reason
				result.DetailReason = validation.DetailReason or validation.Reason
				return result
			end
			if entry.Enabled == true then
				table.insert(result.Entries, entry)
			end
		end
		table.sort(result.Entries, function(left, right)
			return left.StageRewardEntryId < right.StageRewardEntryId
		end)
		result.Success = true
		result.Reason = "OK"
		result.Source = "DATASET"
		return result
	end

	@ExecSpace("ServerOnly")
	method table GetRewardsForStage(string stageId)
		local result = { Success = false, Reason = "STAGE_REWARD_NOT_FOUND", StageId = stageId or "", Entries = {}, Source = "" }
		if stageId == nil or stageId == "" then
			result.Reason = "INVALID_STAGE_ID"
			return result
		end
		local allEntries = self:GetAllEntries()
		if allEntries.Success == false then
			result.Reason = allEntries.Reason
			result.DetailReason = allEntries.DetailReason
			return result
		end
		for _, entry in ipairs(allEntries.Entries) do
			if entry.StageId == stageId then
				table.insert(result.Entries, entry)
			end
		end
		result.Success = true
		result.Reason = #result.Entries > 0 and "OK" or "NO_STAGE_REWARDS"
		result.Source = allEntries.Source
		return result
	end

	@ExecSpace("ServerOnly")
	method table ConvertRow(any dataSet, integer rowIndex)
		return {
			SchemaVersion = math.floor(tonumber(dataSet:GetCell(rowIndex, "SchemaVersion")) or 0),
			StageRewardEntryId = dataSet:GetCell(rowIndex, "StageRewardEntryId") or "",
			StageId = dataSet:GetCell(rowIndex, "StageId") or "",
			RewardType = dataSet:GetCell(rowIndex, "RewardType") or "",
			RewardRefId = dataSet:GetCell(rowIndex, "RewardRefId") or "",
			Amount = math.floor(tonumber(dataSet:GetCell(rowIndex, "Amount")) or 0),
			Enabled = self:ParseBooleanCell(dataSet:GetCell(rowIndex, "Enabled")),
			RowIndex = rowIndex,
			Source = "DATASET"
		}
	end

	@ExecSpace("ServerOnly")
	method table ValidateEntry(table entry)
		if entry.SchemaVersion ~= self.SupportedSchemaVersion then
			return self:RejectEntry(entry, "UNSUPPORTED_STAGE_REWARD_SCHEMA")
		end
		if entry.StageRewardEntryId == "" then
			return self:RejectEntry(entry, "STAGE_REWARD_ENTRY_ID_MISSING")
		end
		if entry.StageId == "" then
			return self:RejectEntry(entry, "STAGE_REWARD_STAGE_ID_MISSING")
		end
		if entry.RewardType ~= "CURRENCY" and entry.RewardType ~= "CONSUMABLE" then
			return self:RejectEntry(entry, "INVALID_STAGE_REWARD_TYPE")
		end
		if entry.RewardRefId == "" then
			return self:RejectEntry(entry, "STAGE_REWARD_REFERENCE_MISSING")
		end
		if entry.Amount <= 0 then
			return self:RejectEntry(entry, "INVALID_STAGE_REWARD_AMOUNT")
		end
		entry.Success = true
		entry.Reason = "OK"
		return entry
	end

	@ExecSpace("ServerOnly")
	method table RejectEntry(table entry, string detailReason)
		entry.Success = false
		entry.Reason = "CONTENT_VALIDATION_FAILED"
		entry.DetailReason = detailReason
		log_error("[StageRewardData] rejected entry=" .. (entry.StageRewardEntryId or "") .. " stage=" .. (entry.StageId or "") .. " reason=" .. detailReason)
		return entry
	end

	method boolean ParseBooleanCell(any cellValue)
		if cellValue == true then
			return true
		end
		if cellValue == nil or cellValue == false then
			return false
		end
		local normalized = string.lower(tostring(cellValue))
		return normalized == "true" or normalized == "1" or normalized == "yes"
	end

end
