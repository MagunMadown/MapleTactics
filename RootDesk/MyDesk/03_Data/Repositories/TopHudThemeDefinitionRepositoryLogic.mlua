@Logic
script TopHudThemeDefinitionRepositoryLogic extends Logic

	property string DataSetName = "TopHudThemeDefinitions"

	@ExecSpace("ClientOnly")
	method table GetTheme(string regionId)
		-- Reads presentation-only rows; unavailable or malformed data uses the common theme.
		local fallback = {
			AccentColor = Color(1, 0.83, 0.42, 1),
			BackdropColor = Color(0.025, 0.03, 0.04, 1),
			BackdropAlpha = 0.12
		}
		local ok, theme = pcall(function()
			local dataSet = _DataService:GetTable(self.DataSetName)
			if dataSet == nil then return fallback end
			local defaultTheme = nil
			local regionTheme = nil
			for rowIndex = 1, dataSet:GetRowCount() do
				local key = dataSet:GetCell(rowIndex, "RegionId") or ""
				if key == "default" then
					defaultTheme = self:ReadTheme(dataSet, rowIndex)
				elseif regionId ~= nil and regionId ~= "" and key == regionId then
					regionTheme = self:ReadTheme(dataSet, rowIndex)
				end
			end
			return regionTheme or defaultTheme or fallback
		end)
		if ok and theme ~= nil then return theme end
		return fallback
	end

	@ExecSpace("ClientOnly")
	method table ReadTheme(any dataSet, integer rowIndex)
		-- Rejects invalid display settings without allowing a theme to hide or recolor gameplay UI.
		local accent = self:ParseColor(dataSet:GetCell(rowIndex, "AccentColor"))
		local backdrop = self:ParseColor(dataSet:GetCell(rowIndex, "BackdropColor"))
		local alpha = tonumber(dataSet:GetCell(rowIndex, "BackdropAlpha"))
		if accent == nil or backdrop == nil or alpha == nil or alpha ~= alpha or alpha < 0 or alpha > 0.20 then
			return nil
		end
		return { AccentColor = accent, BackdropColor = backdrop, BackdropAlpha = alpha }
	end

	@ExecSpace("ClientOnly")
	method any ParseColor(string value)
		-- Accepts six-digit RGB only; opacity is separately controlled by BackdropAlpha.
		if value == nil then return nil end
		local hex = string.match(value, "^#(%x%x%x%x%x%x)$")
		if hex == nil then return nil end
		return Color(tonumber(string.sub(hex, 1, 2), 16) / 255,
			tonumber(string.sub(hex, 3, 4), 16) / 255,
			tonumber(string.sub(hex, 5, 6), 16) / 255, 1)
	end

end
