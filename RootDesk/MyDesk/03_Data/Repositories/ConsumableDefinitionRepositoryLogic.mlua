@Logic
script ConsumableDefinitionRepositoryLogic

	property string DataSetName = "ConsumableDefinitions"
	property integer SupportedSchemaVersion = 1
	-- Potion purchase prices and consumable resale baselines (70 percent, rounded down).
	property table ShopBasePrices = { red_potion = 10, orange_potion = 20, white_potion = 30, time_sand = 30, all_cure_potion = 20 }

	@ExecSpace("ServerOnly")
	method table GetDefinition(string consumableId)
		-- Loads and validates one consumable definition by stable content ID.
		consumableId = self:NormalizeConsumableId(consumableId)
		local result = { Success = false, Reason = "CONSUMABLE_DEFINITION_NOT_FOUND", ConsumableId = consumableId or "" }
		if consumableId == nil or consumableId == "" then
			result.Reason = "INVALID_CONSUMABLE_ID"
			return result
		end
		local dataSet = _DataService:GetTable(self.DataSetName)
		if dataSet == nil then
			result.Reason = "CONSUMABLE_DATASET_MISSING"
			return result
		end
		for rowIndex = 1, dataSet:GetRowCount() do
			if dataSet:GetCell(rowIndex, "ConsumableId") == consumableId then
				local definition = self:ConvertRow(dataSet, rowIndex)
				local validation = self:ValidateDefinition(definition)
				if validation.Success == false then
					return validation
				end
				if definition.Enabled == false then
					definition.Success = false
					definition.Reason = "CONSUMABLE_DISABLED"
					return definition
				end
				definition.Success = true
				definition.Reason = "OK"
				return definition
			end
		end
		return result
	end

	@ExecSpace("ServerOnly")
	method table ConvertRow(any dataSet, integer rowIndex)
		-- Converts string dataset cells into the stable runtime definition DTO.
		return {
			SchemaVersion = math.floor(tonumber(dataSet:GetCell(rowIndex, "SchemaVersion")) or 0),
			ConsumableId = dataSet:GetCell(rowIndex, "ConsumableId") or "",
			DisplayName = dataSet:GetCell(rowIndex, "DisplayName") or "",
			MaxStack = math.floor(tonumber(dataSet:GetCell(rowIndex, "MaxStack")) or 0),
			UseTiming = dataSet:GetCell(rowIndex, "UseTiming") or "",
			ConsumesTurn = self:ParseBooleanCell(dataSet:GetCell(rowIndex, "ConsumesTurn")),
			EffectType = dataSet:GetCell(rowIndex, "EffectType") or "",
			EffectValue = tonumber(dataSet:GetCell(rowIndex, "EffectValue")) or 0,
			TargetType = dataSet:GetCell(rowIndex, "TargetType") or "",
			Enabled = self:ParseBooleanCell(dataSet:GetCell(rowIndex, "Enabled")),
			ConsumeOnUse = self:ParseBooleanCell(dataSet:GetCell(rowIndex, "ConsumeOnUse")),
			TurnCost = tonumber(dataSet:GetCell(rowIndex, "TurnCost")) or -1,
			Description = dataSet:GetCell(rowIndex, "Description") or "",
			IconKey = dataSet:GetCell(rowIndex, "IconKey") or "",
			RowIndex = rowIndex,
			Source = "DATASET"
		}
	end

	@ExecSpace("ServerOnly")
	method table ValidateDefinition(table definition)
		-- Enforces row-local schema and primitive effect invariants.
		if definition.SchemaVersion ~= self.SupportedSchemaVersion then
			return self:Reject(definition, "UNSUPPORTED_CONSUMABLE_SCHEMA")
		end
		if definition.ConsumableId == "" or definition.DisplayName == "" then
			return self:Reject(definition, "CONSUMABLE_REQUIRED_FIELD_MISSING")
		end
		if definition.MaxStack <= 0 then
			return self:Reject(definition, "INVALID_CONSUMABLE_MAX_STACK")
		end
		if definition.UseTiming ~= "BATTLE_FREEPLAY" or definition.ConsumesTurn or definition.TurnCost ~= 0 or definition.ConsumeOnUse ~= true then
			return self:Reject(definition, "INVALID_CONSUMABLE_USE_TIMING")
		end
		local validEffect = (definition.EffectType == "HEAL" and definition.TargetType == "SELF" and definition.EffectValue > 0)
			or (definition.EffectType == "COOLDOWN_REDUCTION" and definition.TargetType == "OWNED_SKILL" and definition.EffectValue > 0 and definition.EffectValue == math.floor(definition.EffectValue))
			or (definition.EffectType == "CLEANSE" and definition.TargetType == "SELF" and definition.EffectValue == 0)
		if not validEffect or definition.IconKey == "" then
			return self:Reject(definition, "INVALID_CONSUMABLE_EFFECT")
		end
		return { Success = true, Reason = "OK" }
	end

	@ExecSpace("ServerOnly")
	method table Reject(table definition, string detailReason)
		-- Returns a uniform content failure without leaking raw dataset rows.
		log_error("[ConsumableData] rejected id=" .. (definition.ConsumableId or "") .. " row=" .. tostring(definition.RowIndex or 0) .. " detail=" .. detailReason)
		return { Success = false, Reason = "CONTENT_VALIDATION_FAILED", DetailReason = detailReason, ConsumableId = definition.ConsumableId or "", RowIndex = definition.RowIndex or 0 }
	end

	method boolean ParseBooleanCell(any cellValue)
		-- Converts common dataset boolean spellings into a strict boolean.
		if cellValue == true then
			return true
		end
		if cellValue == nil or cellValue == false then
			return false
		end
		local normalized = string.lower(tostring(cellValue))
		return normalized == "true" or normalized == "1" or normalized == "yes"
	end

	method string NormalizeConsumableId(string consumableId)
		-- Keeps the former four-HP potion as an alias, not a sixth item definition.
		if consumableId == "potion_hp_small" then return "orange_potion" end
		return consumableId or ""
	end

end
