@Logic
script BossPhaseDefinitionRepositoryLogic

	property string DataSetName = "BossPhaseDefinitions"
	property integer SupportedSchemaVersion = 1

	@ExecSpace("ServerOnly")
	method table GetPhaseDefinitions(string enemyDefinitionId)
		local result = { Success = false, Reason = "BOSS_PHASES_NOT_FOUND", EnemyDefinitionId = enemyDefinitionId or "", Definitions = {} }
		if result.EnemyDefinitionId == "" then
			result.Reason = "INVALID_ENEMY_DEFINITION_ID"
			return result
		end
		local dataSet = _DataService:GetTable(self.DataSetName)
		if dataSet == nil then
			result.Reason = "BOSS_PHASE_DATASET_MISSING"
			return result
		end
		for rowIndex = 1, dataSet:GetRowCount() do
			if dataSet:GetCell(rowIndex, "EnemyDefinitionId") == result.EnemyDefinitionId
				and self:ParseBooleanCell(dataSet:GetCell(rowIndex, "Enabled")) == true then
				table.insert(result.Definitions, self:ConvertRow(dataSet, rowIndex))
			end
		end
		table.sort(result.Definitions, function(left, right) return left.PhaseIndex < right.PhaseIndex end)
		if #result.Definitions == 0 then
			return result
		end
		result.Success = true
		result.Reason = "OK"
		log("[BossPhaseData] loaded enemy=" .. result.EnemyDefinitionId .. " phases=" .. #result.Definitions)
		return result
	end

	@ExecSpace("ServerOnly")
	method table ConvertRow(any dataSet, integer rowIndex)
		-- Empty phase motion overrides inherit the enemy's original presentation profile.
		return {
			SchemaVersion = math.floor(tonumber(dataSet:GetCell(rowIndex, "SchemaVersion")) or 0),
			EnemyDefinitionId = dataSet:GetCell(rowIndex, "EnemyDefinitionId") or "",
			PhaseIndex = math.floor(tonumber(dataSet:GetCell(rowIndex, "PhaseIndex")) or 0),
			PhaseId = dataSet:GetCell(rowIndex, "PhaseId") or "",
			HpRatioLE = tonumber(dataSet:GetCell(rowIndex, "HpRatioLE")) or 0,
			PatternId = dataSet:GetCell(rowIndex, "PatternId") or "",
			IdleMotionRuid = dataSet:GetCell(rowIndex, "IdleMotionRuid") or "",
			MoveMotionRuid = dataSet:GetCell(rowIndex, "MoveMotionRuid") or "",
			HitMotionRuid = dataSet:GetCell(rowIndex, "HitMotionRuid") or "",
			DeathMotionRuid = dataSet:GetCell(rowIndex, "DeathMotionRuid") or "",
			ReinforcementPoolId = dataSet:GetCell(rowIndex, "ReinforcementPoolId") or "",
			ReinforcementIntervalTurns = tonumber(dataSet:GetCell(rowIndex, "ReinforcementIntervalTurns")) or 0,
			ReinforcementMaxAlive = tonumber(dataSet:GetCell(rowIndex, "ReinforcementMaxAlive")) or 0,
			ReinforcementSpawnRange = tonumber(dataSet:GetCell(rowIndex, "ReinforcementSpawnRange")) or 0,
			RowIndex = rowIndex
		}
	end

	method boolean ParseBooleanCell(any cellValue)
		if cellValue == true then return true end
		local normalized = string.lower(tostring(cellValue or ""))
		return normalized == "true" or normalized == "1" or normalized == "yes"
	end

end
