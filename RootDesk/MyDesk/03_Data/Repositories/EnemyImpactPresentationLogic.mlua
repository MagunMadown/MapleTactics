@Logic
script EnemyImpactPresentationLogic extends Logic

	@ExecSpace("ServerOnly")
	method string GetDamageSound(string enemyDefinitionId)
		-- Preserve the presentation-facing API while the repository owns all resource data.
		return _EnemyImpactPresentationRepositoryLogic:ResolveResource(enemyDefinitionId, "", "DamageSoundRuid")
	end

	@ExecSpace("ServerOnly")
	method string GetImpactSound(string enemyDefinitionId, string skillId)
		-- Species, skill overrides and defaults are ordered by CSV priority.
		return _EnemyImpactPresentationRepositoryLogic:ResolveResource(enemyDefinitionId, skillId, "ImpactSoundRuid")
	end

	@ExecSpace("ServerOnly")
	method string GetHitEffect(string enemyDefinitionId, string skillId)
		-- Exact enemy/skill rules are data, not script branches.
		return _EnemyImpactPresentationRepositoryLogic:ResolveResource(enemyDefinitionId, skillId, "HitEffectRuid")
	end

	@ExecSpace("ServerOnly")
	method table GetResourceRuids()
		-- Use repository resources for the existing preload pass.
		return _EnemyImpactPresentationRepositoryLogic:GetResourceRuids()
	end
end
