@Logic
script ContentValidatorLogic extends Logic

	property integer SupportedStageSchemaVersion = 2
	property integer SupportedSkillSchemaVersion = 1

	@ExecSpace("ServerOnly")
	method table ValidateStageById(string stageId)
		local definition = _StageDefinitionRepositoryLogic:GetStageDefinition(stageId)
		if definition.Success == false then
			return {
				Success = false,
				Reason = definition.Reason,
				StageId = stageId,
				Data = definition
			}
		end
		return self:ValidateStageDefinition(definition)
	end

	@ExecSpace("ServerOnly")
	method table ValidateStageDefinition(table definition)
		local result = {
			Success = false,
			Reason = "CONTENT_VALIDATION_FAILED",
			StageId = definition.StageId or "",
			TotalWaves = 0,
			Data = definition
		}
		if definition.SchemaVersion ~= self.SupportedStageSchemaVersion then
			return self:RejectStage(result, "UNSUPPORTED_STAGE_SCHEMA")
		end
		if definition.StageId == nil or definition.StageId == "" then
			return self:RejectStage(result, "INVALID_STAGE_ID")
		end
		if definition.MatchCount ~= nil and definition.MatchCount > 1 then
			return self:RejectStage(result, "DATA_DUPLICATE_STAGE_ID")
		end
		if definition.RegionId == nil or definition.RegionId == "" then
			return self:RejectStage(result, "REGION_ID_MISSING")
		end
		local regionValidation = _RegionContentValidatorLogic:ValidateById(definition.RegionId)
		if regionValidation.Success == false then
			return self:RejectStage(result, regionValidation.DetailReason or "REGION_REFERENCE_MISSING")
		end
		if definition.StageIndex == nil or definition.StageIndex <= 0 then
			return self:RejectStage(result, "INVALID_STAGE_INDEX")
		end
		if definition.StageType ~= "NORMAL" and definition.StageType ~= "BOSS" then
			return self:RejectStage(result, "INVALID_STAGE_TYPE")
		end
		if definition.DisplayName == nil or definition.DisplayName == "" then
			return self:RejectStage(result, "STAGE_DISPLAY_NAME_MISSING")
		end
		if definition.CellCount == nil or definition.CellCount <= 0 then
			return self:RejectStage(result, "INVALID_CELL_COUNT")
		end
		if definition.CellSpacing == nil or definition.CellSpacing <= 0 then
			return self:RejectStage(result, "INVALID_CELL_SPACING")
		end
		if definition.PlayerStartCell == nil
			or definition.PlayerStartCell < 0
			or definition.PlayerStartCell >= definition.CellCount then
			return self:RejectStage(result, "INVALID_PLAYER_START_CELL")
		end
		if definition.QueueCapacity == nil or definition.QueueCapacity <= 0 then
			return self:RejectStage(result, "INVALID_QUEUE_CAPACITY")
		end
		if definition.WaveTableId == nil or definition.WaveTableId == "" then
			return self:RejectStage(result, "WAVE_TABLE_ID_MISSING")
		end
		if definition.NextStageId ~= nil
			and definition.NextStageId ~= ""
			and definition.NextStageId == definition.StageId then
			return self:RejectStage(result, "NEXT_STAGE_SELF_REFERENCE")
		end

		local totalWaves = _StageWaveRepositoryLogic:GetTotalWaveCount(definition.WaveTableId)
		if totalWaves <= 0 then
			return self:RejectStage(result, "WAVE_TABLE_NOT_FOUND")
		end

		result.Success = true
		result.Reason = "OK"
		result.TotalWaves = totalWaves
		log("[ContentValidation] stage valid stage=" .. result.StageId .. " region=" .. definition.RegionId .. " index=" .. definition.StageIndex .. " type=" .. definition.StageType .. " waveTable=" .. definition.WaveTableId .. " totalWaves=" .. totalWaves .. " cells=" .. definition.CellCount .. " queue=" .. definition.QueueCapacity)
		return result
	end

	@ExecSpace("ServerOnly")
	method table RejectStage(table result, string detailReason)
		result.Success = false
		result.Reason = "CONTENT_VALIDATION_FAILED"
		result.DetailReason = detailReason
		log_error("[ContentValidation] stage rejected stage=" .. result.StageId .. " reason=" .. detailReason)
		return result
	end

	@ExecSpace("ServerOnly")
	method table ValidateSkillById(string skillId)
		local bundle = _SkillDefinitionRepositoryLogic:GetSkillBundle(skillId)
		if bundle.Success == false then
			return {
				Success = false,
				Reason = bundle.Reason,
				SkillId = skillId,
				Data = bundle
			}
		end
		return self:ValidateSkillBundle(bundle)
	end

	@ExecSpace("ServerOnly")
	method table ValidateSkillBundle(table bundle)
		local definition = bundle.Definition
		local steps = bundle.EffectSteps
		local result = {
			Success = false,
			Reason = "CONTENT_VALIDATION_FAILED",
			SkillId = definition.SkillId or "",
			Data = bundle
		}
		if definition.SchemaVersion ~= self.SupportedSkillSchemaVersion then
			return self:RejectSkill(result, "UNSUPPORTED_SKILL_SCHEMA")
		end
		if definition.SkillId == nil or definition.SkillId == "" then
			return self:RejectSkill(result, "INVALID_SKILL_ID")
		end
		if definition.MatchCount ~= nil and definition.MatchCount > 1 then
			return self:RejectSkill(result, "DATA_DUPLICATE_SKILL_ID")
		end
		if definition.DisplayName == nil or definition.DisplayName == "" then
			return self:RejectSkill(result, "SKILL_DISPLAY_NAME_MISSING")
		end
		if self:IsSupportedSkillTargetingType(definition.TargetingType) == false then
			return self:RejectSkill(result, "UNSUPPORTED_TARGETING_TYPE")
		end
		if definition.Range == nil or definition.Range <= 0 then
			return self:RejectSkill(result, "INVALID_SKILL_RANGE")
		end
		if definition.TargetingType == "RANGE_OFFSETS"
			and self:AreValidTargetOffsets(definition.TargetOffsets, definition.Range) == false then
			return self:RejectSkill(result, "INVALID_TARGET_OFFSETS")
		end
		if definition.CooldownTurns == nil or definition.CooldownTurns < 0 then
			return self:RejectSkill(result, "INVALID_SKILL_COOLDOWN")
		end
		if definition.CostValue == nil or definition.CostValue < 0 then
			return self:RejectSkill(result, "INVALID_SKILL_COST")
		end
		if definition.EffectSetId == nil or definition.EffectSetId == "" then
			return self:RejectSkill(result, "EFFECT_SET_ID_MISSING")
		end
		if definition.ActionDuration == nil or definition.ActionDuration <= 0 then
			return self:RejectSkill(result, "INVALID_ACTION_DURATION")
		end
		if definition.EnemyQueueTurns == nil or definition.EnemyQueueTurns < 0 then
			return self:RejectSkill(result, "INVALID_ENEMY_QUEUE_TURNS")
		end
		if definition.CasterMotionRuid ~= nil and definition.CasterMotionRuid ~= "" then
			if definition.CasterMotionPlayRate == nil or definition.CasterMotionPlayRate <= 0 then
				return self:RejectSkill(result, "INVALID_CASTER_MOTION_PLAY_RATE")
			end
			if definition.CasterMotionDuration == nil or definition.CasterMotionDuration <= 0 then
				return self:RejectSkill(result, "INVALID_CASTER_MOTION_DURATION")
			end
		end
		if steps == nil or #steps == 0 then
			return self:RejectSkill(result, "EFFECT_STEPS_EMPTY")
		end

		local expectedStepIndex = 1
		for _, step in ipairs(steps) do
			if step.SchemaVersion ~= self.SupportedSkillSchemaVersion then
				return self:RejectSkill(result, "UNSUPPORTED_EFFECT_SCHEMA")
			end
			if step.EffectSetId ~= definition.EffectSetId then
				return self:RejectSkill(result, "EFFECT_SET_MISMATCH")
			end
			if step.StepIndex ~= expectedStepIndex then
				return self:RejectSkill(result, "INVALID_EFFECT_STEP_SEQUENCE")
			end
			if step.EffectType ~= "DAMAGE" and step.EffectType ~= "PUSH" and step.EffectType ~= "HEAL" then
				return self:RejectSkill(result, "UNKNOWN_EFFECT")
			end
			if self:IsSupportedEffectTargetSelector(step.TargetSelector) == false then
				return self:RejectSkill(result, "UNSUPPORTED_TARGET_SELECTOR")
			end
			if step.Value == nil or step.Value < 0 then
				return self:RejectSkill(result, "INVALID_EFFECT_VALUE")
			end
			expectedStepIndex = expectedStepIndex + 1
		end

		result.Success = true
		result.Reason = "OK"
		log("[ContentValidation] skill valid skill=" .. result.SkillId .. " effectSet=" .. definition.EffectSetId .. " steps=" .. #steps .. " cooldown=" .. definition.CooldownTurns)
		return result
	end

	method boolean IsSupportedSkillTargetingType(string targetingType)
		return targetingType == "SELF"
			or targetingType == "FRONT_CELL"
			or targetingType == "FIRST_ENEMY_FORWARD"
			or targetingType == "RANGE_OFFSETS"
	end

	method boolean IsSupportedEffectTargetSelector(string targetSelector)
		return targetSelector == "SELF_UNIT"
			or targetSelector == "FRONT_TARGET"
			or targetSelector == "PRIMARY_TARGET"
			or targetSelector == "ALL_SKILL_TARGETS"
	end

	method boolean AreValidTargetOffsets(string serializedOffsets, integer range)
		local count = 0
		local seen = {}
		for token in string.gmatch(serializedOffsets or "", "([^|]+)") do
			local value = tonumber(token)
			if value == nil or value ~= math.floor(value) or value == 0 or math.abs(value) > range then
				return false
			end
			local key = tostring(math.floor(value))
			if seen[key] == true then
				return false
			end
			seen[key] = true
			count = count + 1
		end
		return count > 0
	end

	@ExecSpace("ServerOnly")
	method table RejectSkill(table result, string detailReason)
		result.Success = false
		result.Reason = "CONTENT_VALIDATION_FAILED"
		result.DetailReason = detailReason
		log_error("[ContentValidation] skill rejected skill=" .. result.SkillId .. " reason=" .. detailReason)
		return result
	end

	@ExecSpace("ServerOnly")
	method table ValidateJobById(string jobId)
		-- Facade entry point. Job-specific rules stay in their dedicated validator object.
		return _JobContentValidatorLogic:ValidateById(jobId)
	end

	@ExecSpace("ServerOnly")
	method table ValidateJobBundle(table bundle)
		-- Facade entry point for already-loaded job bundles.
		return _JobContentValidatorLogic:ValidateBundle(bundle)
	end

	@ExecSpace("ServerOnly")
	method table ValidateAugmentById(string augmentId)
		-- Facade entry point. Augment-specific schema and router rules stay isolated.
		return _AugmentContentValidatorLogic:ValidateById(augmentId)
	end

	@ExecSpace("ServerOnly")
	method table ValidateAugmentBundle(table bundle)
		-- Facade entry point for already-loaded augment bundles.
		return _AugmentContentValidatorLogic:ValidateBundle(bundle)
	end

	@ExecSpace("ServerOnly")
	method table ValidateRegionById(string regionId)
		return _RegionContentValidatorLogic:ValidateById(regionId)
	end

	@ExecSpace("ServerOnly")
	method table ValidateEnemyDrops()
		-- Facade entry point. Drop-specific rules stay in their dedicated validator object.
		return _EnemyDropContentValidatorLogic:EnsureValid()
	end

	@ExecSpace("ServerOnly")
	method table ValidateStageRewards()
		-- Facade entry point. Stage reward row and reference rules stay in their dedicated validator object.
		return _StageRewardContentValidatorLogic:ValidateAll()
	end

	@ExecSpace("ServerOnly")
	method table ValidateShops()
		return _ShopContentValidatorLogic:ValidateAll()
	end

	@ExecSpace("ServerOnly")
	method table ValidateShopById(string shopId)
		return _ShopContentValidatorLogic:ValidateById(shopId)
	end

	@ExecSpace("ServerOnly")
	method table ValidateNodeGraph(string nodeGraphId)
		-- Facade entry point for complete run-flow graph and cross-reference validation.
		return _NodeContentValidatorLogic:ValidateById(nodeGraphId)
	end

	@ExecSpace("ServerOnly")
	method table ValidateEnemyPatternById(string patternId)
		-- Facade entry point. Enemy pattern row rules stay in their dedicated validator object.
		return _EnemyPatternContentValidatorLogic:ValidateById(patternId)
	end

	@ExecSpace("ServerOnly")
	method table ValidateEnemyPatternBundle(table bundle)
		-- Facade entry point for an already-loaded immutable pattern bundle.
		return _EnemyPatternContentValidatorLogic:ValidateBundle(bundle)
	end

	@ExecSpace("ServerOnly")
	method table ValidateBossPhasesByEnemyDefinitionId(string enemyDefinitionId)
		-- Facade entry point. Boss phase thresholds and Pattern references stay in their domain validator.
		return _BossPhaseContentValidatorLogic:ValidateByEnemyDefinitionId(enemyDefinitionId)
	end

	@ExecSpace("ServerOnly")
	method void InvalidateEnemyDropValidation(string reason)
		-- Invalidates the drop validator cache after static content changes.
		_EnemyDropContentValidatorLogic:InvalidateCache(reason)
	end

	@ExecSpace("ServerOnly")
	method table ValidateAllContent()
		-- Facade entry point for editor/startup audits. Cross-table traversal stays isolated.
		return _ContentIntegrityValidatorLogic:ValidateAll()
	end

end
