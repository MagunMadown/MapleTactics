@Logic
script ContentValidatorLogic extends Logic

	property integer SupportedStageSchemaVersion = 3
	property integer SupportedSkillSchemaVersion = 1

	@ExecSpace("ServerOnly")
	method table ValidateStageById(string stageId)
		local definition = _StageDefinitionRepositoryLogic:GetStageDefinition(stageId)
		if definition.Success == false then
			return {
				Success = false,
				Reason = definition.Reason,
				StageId = stageId,
				Data = definition
			}
		end
		return self:ValidateStageDefinition(definition)
	end

	@ExecSpace("ServerOnly")
	method table ValidateStageDefinition(table definition)
		local result = {
			Success = false,
			Reason = "CONTENT_VALIDATION_FAILED",
			StageId = definition.StageId or "",
			TotalWaves = 0,
			Data = definition
		}
		if definition.SchemaVersion ~= self.SupportedStageSchemaVersion then
			return self:RejectStage(result, "UNSUPPORTED_STAGE_SCHEMA")
		end
		if definition.StageId == nil or definition.StageId == "" then
			return self:RejectStage(result, "INVALID_STAGE_ID")
		end
		if definition.MatchCount ~= nil and definition.MatchCount > 1 then
			return self:RejectStage(result, "DATA_DUPLICATE_STAGE_ID")
		end
		if definition.RegionId == nil or definition.RegionId == "" then
			return self:RejectStage(result, "REGION_ID_MISSING")
		end
		local regionValidation = _RegionContentValidatorLogic:ValidateById(definition.RegionId)
		if regionValidation.Success == false then
			return self:RejectStage(result, regionValidation.DetailReason or "REGION_REFERENCE_MISSING")
		end
		if definition.StageIndex == nil or definition.StageIndex <= 0 then
			return self:RejectStage(result, "INVALID_STAGE_INDEX")
		end
		if definition.StageType ~= "NORMAL" and definition.StageType ~= "BOSS" then
			return self:RejectStage(result, "INVALID_STAGE_TYPE")
		end
		if definition.DisplayName == nil or definition.DisplayName == "" then
			return self:RejectStage(result, "STAGE_DISPLAY_NAME_MISSING")
		end
		if definition.CellCount == nil or definition.CellCount <= 0 then
			return self:RejectStage(result, "INVALID_CELL_COUNT")
		end
		if definition.CellSpacing == nil or definition.CellSpacing <= 0 then
			return self:RejectStage(result, "INVALID_CELL_SPACING")
		end
		if definition.PlayerStartCell == nil
			or definition.PlayerStartCell < 0
			or definition.PlayerStartCell >= definition.CellCount then
			return self:RejectStage(result, "INVALID_PLAYER_START_CELL")
		end
		if definition.QueueCapacity == nil or definition.QueueCapacity <= 0 then
			return self:RejectStage(result, "INVALID_QUEUE_CAPACITY")
		end
		if definition.WaveTableId == nil or definition.WaveTableId == "" then
			return self:RejectStage(result, "WAVE_TABLE_ID_MISSING")
		end
		local totalWaves = _StageWaveRepositoryLogic:GetTotalWaveCount(definition.WaveTableId)
		if totalWaves <= 0 then
			return self:RejectStage(result, "WAVE_TABLE_NOT_FOUND")
		end

		result.Success = true
		result.Reason = "OK"
		result.TotalWaves = totalWaves
		log("[ContentValidation] stage valid stage=" .. result.StageId .. " region=" .. definition.RegionId .. " index=" .. definition.StageIndex .. " type=" .. definition.StageType .. " waveTable=" .. definition.WaveTableId .. " totalWaves=" .. totalWaves .. " cells=" .. definition.CellCount .. " queue=" .. definition.QueueCapacity)
		return result
	end

	@ExecSpace("ServerOnly")
	method table RejectStage(table result, string detailReason)
		result.Success = false
		result.Reason = "CONTENT_VALIDATION_FAILED"
		result.DetailReason = detailReason
		log_error("[ContentValidation] stage rejected stage=" .. result.StageId .. " reason=" .. detailReason)
		return result
	end

	@ExecSpace("ServerOnly")
	method table ValidateSkillById(string skillId)
		local bundle = _SkillDefinitionRepositoryLogic:GetSkillBundle(skillId)
		if bundle.Success == false then
			return {
				Success = false,
				Reason = bundle.Reason,
				SkillId = skillId,
				Data = bundle
			}
		end
		return self:ValidateSkillBundle(bundle)
	end

	@ExecSpace("ServerOnly")
	method table ValidateSkillBundle(table bundle)
		local definition = bundle.Definition
		local steps = bundle.EffectSteps
		local result = {
			Success = false,
			Reason = "CONTENT_VALIDATION_FAILED",
			SkillId = definition.SkillId or "",
			Data = bundle
		}
		if definition.SchemaVersion ~= self.SupportedSkillSchemaVersion then
			return self:RejectSkill(result, "UNSUPPORTED_SKILL_SCHEMA")
		end
		if definition.SkillId == nil or definition.SkillId == "" then
			return self:RejectSkill(result, "INVALID_SKILL_ID")
		end
		if definition.MatchCount ~= nil and definition.MatchCount > 1 then
			return self:RejectSkill(result, "DATA_DUPLICATE_SKILL_ID")
		end
		if definition.DisplayName == nil or definition.DisplayName == "" then
			return self:RejectSkill(result, "SKILL_DISPLAY_NAME_MISSING")
		end
		if self:IsSupportedSkillTargetingType(definition.TargetingType) == false then
			return self:RejectSkill(result, "UNSUPPORTED_TARGETING_TYPE")
		end
		if definition.Range == nil or definition.Range <= 0 then
			return self:RejectSkill(result, "INVALID_SKILL_RANGE")
		end
		if definition.TargetingType == "RANGE_OFFSETS"
			and self:AreValidTargetOffsets(definition.TargetOffsets, definition.Range) == false then
			return self:RejectSkill(result, "INVALID_TARGET_OFFSETS")
		end
		if definition.CooldownTurns == nil or definition.CooldownTurns < 0 then
			return self:RejectSkill(result, "INVALID_SKILL_COOLDOWN")
		end
		if definition.CostValue == nil or definition.CostValue < 0 then
			return self:RejectSkill(result, "INVALID_SKILL_COST")
		end
		if definition.EffectSetId == nil or definition.EffectSetId == "" then
			return self:RejectSkill(result, "EFFECT_SET_ID_MISSING")
		end
		if definition.ActionDuration == nil or definition.ActionDuration <= 0 then
			return self:RejectSkill(result, "INVALID_ACTION_DURATION")
		end
		-- An empty WeaponType is legal: enemy skills have no avatar, and a player skill may
		-- deliberately keep whatever weapon is already equipped. A non-empty value must resolve.
		if definition.WeaponType ~= nil and definition.WeaponType ~= "" then
			local weaponValidation = self:ValidateWeaponById(definition.WeaponType)
			if weaponValidation.Success == false then
				return self:RejectSkill(result, "INVALID_SKILL_WEAPON_REFERENCE")
			end
		end
		-- A projectile needs a speed to reach its target; without one the impact would never land.
		-- An empty ProjectileRuid is the normal case and leaves the other two columns unread.
		if definition.ProjectileRuid ~= nil and definition.ProjectileRuid ~= "" then
			if definition.ProjectileSpeed == nil or definition.ProjectileSpeed <= 0 then
				return self:RejectSkill(result, "INVALID_PROJECTILE_SPEED")
			end
			if definition.TargetingType == "SELF" then
				return self:RejectSkill(result, "PROJECTILE_ON_SELF_TARGETING")
			end
			-- 0 is the normal case: it defers the launch to the motion profile's impact frame.
			if definition.ProjectileLaunchDelay == nil or definition.ProjectileLaunchDelay < 0 then
				return self:RejectSkill(result, "INVALID_PROJECTILE_LAUNCH_DELAY")
			end
			if definition.ProjectileCount == nil or definition.ProjectileCount < 1 then
				return self:RejectSkill(result, "INVALID_PROJECTILE_COUNT")
			end
			-- Without a gap the extra shots spawn on the same frame along the same path, so the row
			-- claims a volley but plays as a single arrow.
			if definition.ProjectileCount > 1
				and (definition.ProjectileInterval == nil or definition.ProjectileInterval <= 0) then
				return self:RejectSkill(result, "PROJECTILE_VOLLEY_WITHOUT_INTERVAL")
			end
		elseif definition.ProjectileHeight ~= nil and definition.ProjectileHeight > 0 then
			-- A flight height only means something for a flying object, so setting it with no
			-- projectile is a row that silently does nothing rather than an authoring choice.
			return self:RejectSkill(result, "PROJECTILE_HEIGHT_WITHOUT_PROJECTILE")
		elseif (definition.ProjectileCount ~= nil and definition.ProjectileCount > 1)
			or (definition.ProjectileInterval ~= nil and definition.ProjectileInterval > 0) then
			-- Same reasoning as the arc: volley columns with nothing to fire are dead authoring.
			return self:RejectSkill(result, "PROJECTILE_VOLLEY_WITHOUT_PROJECTILE")
		end
		local iconBackgroundColor = definition.HudIconBackgroundColor or ""
		if iconBackgroundColor ~= "" and string.match(iconBackgroundColor, "^#%x%x%x%x%x%x%x%x$") == nil then
			return self:RejectSkill(result, "INVALID_HUD_ICON_BACKGROUND_COLOR")
		end
		if definition.EnemyQueueTurns == nil or definition.EnemyQueueTurns < 0 then
			return self:RejectSkill(result, "INVALID_ENEMY_QUEUE_TURNS")
		end
		if definition.CasterMotionRuid ~= nil and definition.CasterMotionRuid ~= "" then
			if definition.CasterMotionPlayRate == nil or definition.CasterMotionPlayRate <= 0 then
				return self:RejectSkill(result, "INVALID_CASTER_MOTION_PLAY_RATE")
			end
			if definition.CasterMotionDuration == nil or definition.CasterMotionDuration <= 0 then
				return self:RejectSkill(result, "INVALID_CASTER_MOTION_DURATION")
			end
		end
		-- Tier 1 is the base form a job starts with; tier N is the upgraded form of the tier N-1 skill
		-- named by BaseSkillId. Keeping the link on the child means a new upgrade never edits the row it
		-- upgrades from, so the two rows cannot drift apart.
		if definition.SkillTier == nil or definition.SkillTier < 1 then
			return self:RejectSkill(result, "INVALID_SKILL_TIER")
		end
		local baseSkillId = definition.BaseSkillId or ""
		if definition.SkillTier == 1 then
			if baseSkillId ~= "" then
				return self:RejectSkill(result, "TIER_1_BASE_SKILL_PRESENT")
			end
		else
			if baseSkillId == "" then
				return self:RejectSkill(result, "BASE_SKILL_ID_MISSING")
			end
			if baseSkillId == definition.SkillId then
				return self:RejectSkill(result, "BASE_SKILL_SELF_REFERENCE")
			end
			-- Read the base row instead of validating it, so a tier 3 chain cannot recurse through here.
			local baseDefinition = _SkillDefinitionRepositoryLogic:GetSkillDefinition(baseSkillId)
			if baseDefinition.Success == false then
				return self:RejectSkill(result, "BASE_SKILL_NOT_FOUND")
			end
			if baseDefinition.SkillTier ~= definition.SkillTier - 1 then
				return self:RejectSkill(result, "BASE_SKILL_TIER_MISMATCH")
			end
			-- An upgrade belongs to the same job as the skill it replaces; a cross-job link would let a
			-- job's upgrade stage surface another job's skill.
			if baseDefinition.RequiredJobTag ~= definition.RequiredJobTag then
				return self:RejectSkill(result, "BASE_SKILL_JOB_MISMATCH")
			end
		end
		if steps == nil or #steps == 0 then
			return self:RejectSkill(result, "EFFECT_STEPS_EMPTY")
		end

		if bundle.IsUtility == true then
			local reason = self:ValidateUtilityEffect(definition, steps)
			if reason ~= "" then return self:RejectSkill(result, reason) end
		end

		local expectedStepIndex = 1
		for _, step in ipairs(steps) do
			if step.SchemaVersion ~= self.SupportedSkillSchemaVersion then
				return self:RejectSkill(result, "UNSUPPORTED_EFFECT_SCHEMA")
			end
			if step.EffectSetId ~= definition.EffectSetId then
				return self:RejectSkill(result, "EFFECT_SET_MISMATCH")
			end
			if step.StepIndex ~= expectedStepIndex then
				return self:RejectSkill(result, "INVALID_EFFECT_STEP_SEQUENCE")
			end
			local isBuffEffect = _BuffEffectExecutorLogic:IsBuffEffectType(step.EffectType)
			local isMoveEffect = bundle.IsUtility ~= true and _MoveSelfEffectExecutorLogic:IsMoveEffectType(step.EffectType)
			if step.EffectType ~= "DAMAGE" and step.EffectType ~= "PUSH" and step.EffectType ~= "PULL" and step.EffectType ~= "HEAL"
				and step.EffectType ~= "SEAL" and step.EffectType ~= "POISON_MIST"
				and step.EffectType ~= "BOSS_SWAP"
				and isBuffEffect == false and isMoveEffect == false and bundle.IsUtility ~= true then
				return self:RejectSkill(result, "UNKNOWN_EFFECT")
			end
			if self:IsSupportedEffectTargetSelector(step.TargetSelector) == false then
				return self:RejectSkill(result, "UNSUPPORTED_TARGET_SELECTOR")
			end
			if step.Value == nil or step.Value < 0 then
				return self:RejectSkill(result, "INVALID_EFFECT_VALUE")
			end
			if step.EffectType == "BOSS_SWAP" and (step.TargetSelector ~= "SELF_UNIT" or definition.TargetingType ~= "SELF" or definition.SkillId ~= "perion_skeleton_boss_swap") then
				return self:RejectSkill(result, "INVALID_BOSS_SWAP")
			end
			if step.EffectType == "PULL" and (step.TargetSelector ~= "PRIMARY_TARGET" or step.Value < 1 or step.Value ~= math.floor(step.Value)) then
				-- One target, dragged to a whole number of cells in front of the caster.
				return self:RejectSkill(result, "INVALID_PULL")
			end
			if step.EffectType == "SEAL" or step.EffectType == "POISON_MIST" then
				local turns = tonumber(step.ParameterA)
				if turns == nil or turns < 1 or turns ~= math.floor(turns) then
					return self:RejectSkill(result, "INVALID_HOSTILE_EFFECT_DURATION")
				end
				if step.TargetSelector ~= "ALL_SKILL_TARGETS" or definition.TargetingType ~= "RANGE_OFFSETS" then
					return self:RejectSkill(result, "INVALID_HOSTILE_EFFECT_TARGETING")
				end
				if step.EffectType == "POISON_MIST" and step.Value <= 0 then
					return self:RejectSkill(result, "INVALID_MIST_DAMAGE")
				end
			end
			-- Buffs live on the caster's own BattleUnitComponent, so they only accept the caster as target,
			-- a positive amount, and (for timed buffs) a whole enemy-round duration in ParameterA.
			if isBuffEffect == true then
				if step.TargetSelector ~= "SELF_UNIT" then
					return self:RejectSkill(result, "BUFF_REQUIRES_SELF_UNIT")
				end
				if step.Value <= 0 then
					return self:RejectSkill(result, "INVALID_BUFF_VALUE")
				end
				if _BuffEffectExecutorLogic:IsTimedBuffEffectType(step.EffectType)
					and _BuffEffectExecutorLogic:ParseDurationTurns(step) < 1 then
					return self:RejectSkill(result, "INVALID_BUFF_DURATION")
				end
			end
			-- A self move needs the caster as its target, a positive cell count, and a supported mode.
			if isMoveEffect == true then
				if step.TargetSelector ~= "SELF_UNIT" then
					return self:RejectSkill(result, "MOVE_REQUIRES_SELF_UNIT")
				end
			end
			-- TURN_SELF only needs the caster; the offset and mode rules below are for MOVE_SELF.
			if isMoveEffect == true and step.EffectType == "MOVE_SELF" then
				if _MoveSelfEffectExecutorLogic:ParseForwardOffset(step) < 1 then
					return self:RejectSkill(result, "INVALID_MOVE_OFFSET")
				end
				if _MoveSelfEffectExecutorLogic:IsSupportedMoveMode(step.ParameterA or "") == false then
					return self:RejectSkill(result, "UNSUPPORTED_MOVE_MODE")
				end
			end
			expectedStepIndex = expectedStepIndex + 1
		end

		result.Success = true
		result.Reason = "OK"
		log("[ContentValidation] skill valid skill=" .. result.SkillId .. " tier=" .. definition.SkillTier .. " base=" .. (definition.BaseSkillId or "") .. " effectSet=" .. definition.EffectSetId .. " steps=" .. #steps .. " cooldown=" .. definition.CooldownTurns .. " enemyQueueTurns=" .. definition.EnemyQueueTurns .. " weapon=" .. (definition.WeaponType or "") .. " projectile=" .. (definition.ProjectileRuid or "") .. " icon=" .. (definition.IconRuid or "") .. " hudIcon=" .. (definition.HudIconRuid or ""))
		return result
	end

	method boolean IsSupportedSkillTargetingType(string targetingType)
		return targetingType == "SELF"
			or targetingType == "FRONT_CELL"
			or targetingType == "FIRST_ENEMY_FORWARD"
			or targetingType == "FIRST_ENEMY_PIERCE"
			or targetingType == "RANGE_OFFSETS"
	end

	method boolean IsSupportedEffectTargetSelector(string targetSelector)
		return targetSelector == "SELF_UNIT"
			or targetSelector == "FRONT_TARGET"
			or targetSelector == "PRIMARY_TARGET"
			or targetSelector == "ALL_SKILL_TARGETS"
	end

	method boolean AreValidTargetOffsets(string serializedOffsets, integer range)
		local count = 0
		local seen = {}
		for token in string.gmatch(serializedOffsets or "", "([^|]+)") do
			local value = tonumber(token)
			if value == nil or value ~= math.floor(value) or value == 0 or math.abs(value) > range then
				return false
			end
			local key = tostring(math.floor(value))
			if seen[key] == true then
				return false
			end
			seen[key] = true
			count = count + 1
		end
		return count > 0
	end

	@ExecSpace("ServerOnly")
	method table RejectSkill(table result, string detailReason)
		result.Success = false
		result.Reason = "CONTENT_VALIDATION_FAILED"
		result.DetailReason = detailReason
		log_error("[ContentValidation] skill rejected skill=" .. result.SkillId .. " reason=" .. detailReason)
		return result
	end

	@ExecSpace("ServerOnly")
	method table ValidateJobById(string jobId)
		-- Facade entry point. Job-specific rules stay in their dedicated validator object.
		return _JobContentValidatorLogic:ValidateById(jobId)
	end

	@ExecSpace("ServerOnly")
	method table ValidateJobBundle(table bundle)
		-- Facade entry point for already-loaded job bundles.
		return _JobContentValidatorLogic:ValidateBundle(bundle)
	end

	@ExecSpace("ServerOnly")
	method table ValidateAugmentById(string augmentId)
		-- Facade entry point. Augment-specific schema and router rules stay isolated.
		return _AugmentContentValidatorLogic:ValidateById(augmentId)
	end

	@ExecSpace("ServerOnly")
	method table ValidateAugmentBundle(table bundle)
		-- Facade entry point for already-loaded augment bundles.
		return _AugmentContentValidatorLogic:ValidateBundle(bundle)
	end

	@ExecSpace("ServerOnly")
	method table ValidateRegionById(string regionId)
		return _RegionContentValidatorLogic:ValidateById(regionId)
	end

	@ExecSpace("ServerOnly")
	method table ValidateWeaponById(string weaponType)
		-- Facade entry point. Weapon row rules and the avatar RUID stay in their dedicated validator object.
		return _WeaponContentValidatorLogic:ValidateById(weaponType)
	end

	@ExecSpace("ServerOnly")
	method table ValidateEnemyDrops()
		-- Facade entry point. Drop-specific rules stay in their dedicated validator object.
		return _EnemyDropContentValidatorLogic:EnsureValid()
	end

	@ExecSpace("ServerOnly")
	method table ValidateStageRewards()
		-- Facade entry point. Stage reward row and reference rules stay in their dedicated validator object.
		return _StageRewardContentValidatorLogic:ValidateAll()
	end

	@ExecSpace("ServerOnly")
	method table ValidateShops()
		return _ShopContentValidatorLogic:ValidateAll()
	end

	@ExecSpace("ServerOnly")
	method table ValidateShopById(string shopId)
		return _ShopContentValidatorLogic:ValidateById(shopId)
	end

	@ExecSpace("ServerOnly")
	method table ValidateNodeGraph(string nodeGraphId)
		-- Facade entry point for complete run-flow graph and cross-reference validation.
		return _NodeContentValidatorLogic:ValidateById(nodeGraphId)
	end

	@ExecSpace("ServerOnly")
	method table ValidateEnemyPatternById(string patternId)
		-- Facade entry point. Enemy pattern row rules stay in their dedicated validator object.
		return _EnemyPatternContentValidatorLogic:ValidateById(patternId)
	end

	@ExecSpace("ServerOnly")
	method table ValidateEnemyPatternBundle(table bundle)
		-- Facade entry point for an already-loaded immutable pattern bundle.
		return _EnemyPatternContentValidatorLogic:ValidateBundle(bundle)
	end

	@ExecSpace("ServerOnly")
	method table ValidateBossPhasesByEnemyDefinitionId(string enemyDefinitionId)
		-- Facade entry point. Boss phase thresholds and Pattern references stay in their domain validator.
		return _BossPhaseContentValidatorLogic:ValidateByEnemyDefinitionId(enemyDefinitionId)
	end

	@ExecSpace("ServerOnly")
	method void InvalidateEnemyDropValidation(string reason)
		-- Invalidates the drop validator cache after static content changes.
		_EnemyDropContentValidatorLogic:InvalidateCache(reason)
	end

	@ExecSpace("ServerOnly")
	method table ValidateAllContent()
		-- Facade entry point for editor/startup audits. Cross-table traversal stays isolated.
		return _ContentIntegrityValidatorLogic:ValidateAll()
	end
	@ExecSpace("ServerOnly")
	method table ValidateUtilitySkills()
		-- Audits the separate immediate-action catalog without adding utilities to grantable skills.
		local result = { Success = true, Reason = "OK", Errors = {}, Bundles = {}, ValidatedCount = 0 }
		local definitions = _DataService:GetTable("UtilitySkillDefinitions")
		local effects = _DataService:GetTable("UtilitySkillEffectSteps")
		local jobs = _DataService:GetTable("JobDefinitions")
		if definitions == nil or effects == nil or jobs == nil then
			self:AddUtilityError(result, "UtilitySkillDefinitions", 0, "", "UTILITY_DATA_MISSING")
			return result
		end
		local jobIds = {}
		for row = 1, jobs:GetRowCount() do jobIds[jobs:GetCell(row, "JobId")] = true end
		local ordinaryIds = {}
		for _, dataSetName in ipairs(_SkillDefinitionRepositoryLogic:GetSkillDataSetNames()) do
			local dataSet = _DataService:GetTable(dataSetName)
			if dataSet ~= nil then
				for row = 1, dataSet:GetRowCount() do ordinaryIds[dataSet:GetCell(row, "SkillId")] = true end
			else
				self:AddUtilityError(result, dataSetName, 0, "", "DATASET_NOT_FOUND")
			end
		end
		local seenIds = {}
		local seenJobs = {}
		local effectSets = {}
		for row = 1, definitions:GetRowCount() do
			local skillId = definitions:GetCell(row, "SkillId") or ""
			local jobId = definitions:GetCell(row, "RequiredJobTag") or ""
			local effectSetId = definitions:GetCell(row, "EffectSetId") or ""
			local reason = self:ValidateUtilityRawNumbers(definitions, row, false)
			if skillId == "" then reason = "INVALID_SKILL_ID"
			elseif seenIds[skillId] then reason = "DATA_DUPLICATE_SKILL_ID"
			elseif ordinaryIds[skillId] == true then reason = "UTILITY_SKILL_ID_COLLISION"
			elseif jobIds[jobId] ~= true then reason = "UTILITY_JOB_REFERENCE_INVALID"
			elseif seenJobs[jobId] then reason = "UTILITY_JOB_AMBIGUOUS" end
			seenIds[skillId] = true
			seenJobs[jobId] = true
			effectSets[effectSetId] = true
			local definition = _SkillDefinitionRepositoryLogic:ConvertSkillRow(definitions, row)
			local steps = {}
			for effectRow = 1, effects:GetRowCount() do
				if effects:GetCell(effectRow, "EffectSetId") == effectSetId then
					table.insert(steps, _SkillDefinitionRepositoryLogic:ConvertEffectStepRow(effects, effectRow))
				end
			end
			if (definitions:GetCell(row, "FreePlay") or "") ~= "false" then reason = "UTILITY_FREE_PLAY_UNSUPPORTED" end
			if reason == "" then
				local validation = self:ValidateSkillBundle({ Definition = definition, EffectSteps = steps, IsUtility = true })
				if validation.Success == false then reason = validation.DetailReason or validation.Reason end
			end
			if reason ~= "" then
				self:AddUtilityError(result, "UtilitySkillDefinitions", row, skillId, reason)
			else
				result.Bundles[jobId] = { Success = true, Reason = "OK", Definition = definition, Step = steps[1] }
				result.ValidatedCount = result.ValidatedCount + 1
			end
		end
		for jobId, _ in pairs(jobIds) do
			if seenJobs[jobId] ~= true then self:AddUtilityError(result, "UtilitySkillDefinitions", 0, jobId, "UTILITY_JOB_MISSING") end
		end
		local seenSteps = {}
		for row = 1, effects:GetRowCount() do
			local effectSetId = effects:GetCell(row, "EffectSetId") or ""
			local stepKey = effectSetId .. "#" .. (effects:GetCell(row, "StepIndex") or "")
			local reason = self:ValidateUtilityRawNumbers(effects, row, true)
			if effectSetId == "" or effectSets[effectSetId] ~= true then reason = "ORPHAN_UTILITY_EFFECT_SET"
			elseif seenSteps[stepKey] then reason = "DUPLICATE_EFFECT_STEP_INDEX" end
			seenSteps[stepKey] = true
			if reason ~= "" then self:AddUtilityError(result, "UtilitySkillEffectSteps", row, stepKey, reason) end
		end
		return result
	end

	@ExecSpace("ServerOnly")
	method string ValidateUtilityRawNumbers(any dataSet, integer row, boolean isEffect)
		-- Reject malformed values before repository defaults, clamps or flooring can hide a typo.
		local rules = { {"SchemaVersion", 1, true, false}, {"Range", 1, true, false}, {"CooldownTurns", 0, true, false},
			{"CostValue", 0, false, false}, {"ActionDuration", 0.000001, false, false}, {"SkillTier", 1, true, false},
			{"EffectScale", 0.000001, false, true}, {"ProjectileSpeed", 0, false, true},
			{"ProjectileScale", 0.000001, false, true}, {"ProjectileLaunchDelay", 0, false, true},
			{"CasterMotionPlayRate", 0.000001, false, true}, {"CasterMotionDuration", 0.000001, false, true},
			{"EnemyQueueTurns", 0, true, true}, {"ProjectileCount", 1, true, true},
			{"ProjectileInterval", 0, false, true}, {"ProjectileHeight", 0, false, true} }
		if isEffect then rules = { {"SchemaVersion", 1, true, false}, {"StepIndex", 1, true, false}, {"Value", 0, true, false} } end
		for _, rule in ipairs(rules) do
			local raw = dataSet:GetCell(row, rule[1]) or ""
			if raw ~= "" or rule[4] ~= true then
				local value = tonumber(raw)
				if value == nil or value ~= value or value == math.huge or value < rule[2] or (rule[3] and value ~= math.floor(value)) then
					return "INVALID_UTILITY_NUMBER:" .. rule[1]
				end
			end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method string ValidateUtilityEffect(table definition, table steps)
		-- These contracts match BattleSessionComponent.ExecuteUtilityEffect, not the queued MOVE_SELF executor.
		if #steps ~= 1 then return "UTILITY_EFFECT_COUNT_INVALID" end
		if (definition.CostType or "") ~= "" or definition.CostValue ~= 0 then return "UTILITY_COST_UNSUPPORTED" end
		if definition.FreePlay == true then return "UTILITY_FREE_PLAY_UNSUPPORTED" end
		if definition.SkillTier ~= 1 or (definition.BaseSkillId or "") ~= "" then return "UTILITY_UPGRADE_UNSUPPORTED" end
		if (definition.ProjectileRuid or "") ~= "" then return "UTILITY_PROJECTILE_UNSUPPORTED" end
		local step = steps[1]
		if (step.ConditionId or "") ~= "" then return "UTILITY_CONDITION_UNSUPPORTED" end
		local a = step.ParameterA or ""
		local b = step.ParameterB or ""
		if step.EffectType == "GUARD" then
			if definition.TargetingType == "SELF" and step.TargetSelector == "SELF_UNIT"
				and step.Value == 0 and a == "UNTIL_NEXT_PLAYER_TURN" and b == "ALL_DAMAGE" then return "" end
		elseif step.EffectType == "MOVE_SELF" then
			if definition.TargetingType == "SELF" and step.TargetSelector == "SELF_UNIT" then
				if a == "FARTHEST_EMPTY_FORWARD" and step.Value == 0 and b == "" then return "" end
				if a == "BEHIND_FARTHEST_ENEMY_FORWARD" and step.Value >= 1 and step.Value == math.floor(step.Value) and b == "REQUIRE_EMPTY" then return "" end
			end
		elseif step.EffectType == "THROW_BEHIND" then
			-- One aimed enemy, landed a whole number of cells behind the caster.
			if definition.TargetingType ~= "SELF" and step.TargetSelector == "PRIMARY_TARGET"
				and step.Value >= 1 and step.Value == math.floor(step.Value) and b == "" then return "" end
		elseif step.EffectType == "PUSH_DISTANCE" then
			if definition.TargetingType ~= "SELF" and (step.TargetSelector == "PRIMARY_TARGET" or step.TargetSelector == "ALL_SKILL_TARGETS")
				and self:IsValidUtilityPushParameterB(b) then
				if a == "MAX" and step.Value == 0 then return "" end
				if a == "STOP_BEFORE_BLOCKED" and step.Value >= 1 and step.Value == math.floor(step.Value) then return "" end
			end
		else
			return "UNKNOWN_UTILITY_EFFECT"
		end
		return "INVALID_UTILITY_EFFECT_PARAMETERS"
	end

	method boolean IsValidUtilityPushParameterB(string parameterB)
		-- Empty, or a pipe-separated set of the supported push modifiers with no repeats.
		if (parameterB or "") == "" then
			return true
		end
		local seen = {}
		for token in string.gmatch(parameterB, "([^|]+)") do
			if token ~= "CARRY_CASTER" and token ~= "CANCEL_QUEUE" then
				return false
			end
			if seen[token] == true then
				return false
			end
			seen[token] = true
		end
		return true
	end

	method void AddUtilityError(table result, string dataSetName, integer rowIndex, string contentId, string reason)
		-- Shared structured errors are consumed by the startup audit and immediate-action lookup.
		result.Success = false
		result.Reason = "CONTENT_VALIDATION_FAILED"
		result.DetailReason = result.DetailReason or reason
		table.insert(result.Errors, { DataSetName = dataSetName, RowIndex = rowIndex, ContentId = contentId, DetailReason = reason })
	end

end
