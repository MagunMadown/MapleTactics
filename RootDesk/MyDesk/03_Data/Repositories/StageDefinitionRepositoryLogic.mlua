@Logic
script StageDefinitionRepositoryLogic

	property string DataSetName = "StageDefinitions"
	property integer SupportedSchemaVersion = 2

	@ExecSpace("ServerOnly")
	method table GetStageDefinition(string stageId)
		local result = {
			Success = false,
			Reason = "STAGE_DEFINITION_NOT_FOUND",
			StageId = stageId
		}
		if stageId == nil or stageId == "" then
			result.Reason = "INVALID_STAGE_ID"
			return result
		end

		local dataSet = _DataService:GetTable(self.DataSetName)
		if dataSet ~= nil then
			local matchedDefinition = nil
			local matchCount = 0
			for rowIndex = 1, dataSet:GetRowCount() do
				if dataSet:GetCell(rowIndex, "StageId") == stageId then
					matchCount = matchCount + 1
					if matchedDefinition == nil then
						matchedDefinition = self:ConvertRow(dataSet, rowIndex)
					end
				end
			end
			if matchedDefinition ~= nil then
				matchedDefinition.MatchCount = matchCount
				return matchedDefinition
			end
		end

		log_warning("[StageDefinition] missing stage=" .. stageId .. " dataset=" .. self.DataSetName)
		return result
	end

	@ExecSpace("ServerOnly")
	method table ConvertRow(any dataSet, integer rowIndex)
		local stageId = dataSet:GetCell(rowIndex, "StageId") or ""
		local result = {
			Success = true,
			Reason = "OK",
			SchemaVersion = math.floor(tonumber(dataSet:GetCell(rowIndex, "SchemaVersion")) or 0),
			StageId = stageId,
			RegionId = dataSet:GetCell(rowIndex, "RegionId") or "",
			StageIndex = math.floor(tonumber(dataSet:GetCell(rowIndex, "StageIndex")) or 0),
			StageType = dataSet:GetCell(rowIndex, "StageType") or "",
			DisplayName = dataSet:GetCell(rowIndex, "DisplayName") or stageId,
			CellCount = math.floor(tonumber(dataSet:GetCell(rowIndex, "CellCount")) or 0),
			CellStartX = tonumber(dataSet:GetCell(rowIndex, "CellStartX")) or 0,
			CellSpacing = tonumber(dataSet:GetCell(rowIndex, "CellSpacing")) or 0,
			UnitY = tonumber(dataSet:GetCell(rowIndex, "UnitY")) or 0,
			PlayerStartCell = math.floor(tonumber(dataSet:GetCell(rowIndex, "PlayerStartCell")) or -1),
			QueueCapacity = math.floor(tonumber(dataSet:GetCell(rowIndex, "QueueCapacity")) or 0),
			WaveTableId = dataSet:GetCell(rowIndex, "WaveTableId") or "",
			NextStageId = dataSet:GetCell(rowIndex, "NextStageId") or "",
			StageRuleId = dataSet:GetCell(rowIndex, "StageRuleId") or "",
			Source = "DATASET"
		}
		log("[StageDefinition] loaded stage=" .. result.StageId .. " region=" .. result.RegionId .. " index=" .. result.StageIndex .. " type=" .. result.StageType .. " schema=" .. result.SchemaVersion .. " waveTable=" .. result.WaveTableId .. " source=" .. result.Source)
		return result
	end

end
