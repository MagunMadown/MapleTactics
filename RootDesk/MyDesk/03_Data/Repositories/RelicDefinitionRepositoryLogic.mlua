@Logic
script RelicDefinitionRepositoryLogic extends Logic

	property string DataSetName = "RelicDefinitions"

	@ExecSpace("ServerOnly")
	method table GetAllDefinitions()
		-- Validate every numeric effect before a run captures the catalog.
		local dataSet = _DataService:GetTable(self.DataSetName)
		if dataSet == nil then return { Success = false, Reason = "RELIC_DATASET_MISSING" } end
		local definitions = {}
		for rowIndex = 1, dataSet:GetRowCount() do
			local id = dataSet:GetCell(rowIndex, "RelicId") or ""
			if id == "" or string.find(id, "[~|]") ~= nil or definitions[id] ~= nil then
				return { Success = false, Reason = "INVALID_OR_DUPLICATE_RELIC_ID", RowIndex = rowIndex }
			end
			local definition = { Success = true, Reason = "OK", RelicId = id, Source = "DATASET",
				DisplayName = dataSet:GetCell(rowIndex, "DisplayName") or "",
				IconImageRUID = dataSet:GetCell(rowIndex, "IconImageRUID") or "" }
			for _, field in ipairs({ "AttackBonus", "MaxHpBonus", "DefenseBonus" }) do
				local value = tonumber(dataSet:GetCell(rowIndex, field))
				if value == nil or value ~= value or value == math.huge or value < 0 or value ~= math.floor(value) then
					return { Success = false, Reason = "INVALID_RELIC_STAT", RelicId = id, Field = field }
				end
				definition[field] = value
			end
			if definition.DisplayName == "" or definition.IconImageRUID == ""
				or string.find(definition.DisplayName .. definition.IconImageRUID, "[~|]") ~= nil then
				return { Success = false, Reason = "INVALID_RELIC_PRESENTATION", RelicId = id }
			end
			definition.EffectDescription = self:DescribeEffects(definition.AttackBonus, definition.MaxHpBonus, definition.DefenseBonus)
			definitions[id] = definition
		end
		return { Success = true, Reason = "OK", Definitions = definitions }
	end

	@ExecSpace("ServerOnly")
	method table GetRelicDefinition(string relicId)
		-- Exact membership lookup; numeric columns own the effects.
		local catalog = self:GetAllDefinitions()
		if catalog.Success == false then return catalog end
		return catalog.Definitions[relicId or ""] or { Success = false, Reason = "RELIC_DEFINITION_NOT_FOUND" }
	end

	method string DescribeEffects(number attack, number hp, number defense)
		-- Share wording between the shop and combat HUD.
		local parts = {}
		if attack > 0 then table.insert(parts, "공격력 +" .. tostring(attack)) end
		if hp > 0 then table.insert(parts, "최대 체력 +" .. tostring(hp)) end
		if defense > 0 then table.insert(parts, "방어력 +" .. tostring(defense)) end
		return #parts > 0 and table.concat(parts, " / ") or "능력치 증가 없음"
	end

end
