@Logic
script RelicDefinitionRepositoryLogic extends Logic

	property string DataSetName = "RelicDefinitions"

	@ExecSpace("ServerOnly")
	method table GetRelicDefinition(string relicId)
		-- Exact membership lookup for RunItemSnapshot IDs; presentation data only.
		-- Missing definitions are ordinary ITEMs, not implicitly registered relics.
		local result = { Success = false, Reason = "RELIC_DEFINITION_NOT_FOUND", RelicId = relicId or "", DisplayName = "", IconImageRUID = "", EffectDescription = "", Source = "" }
		if relicId == nil or relicId == "" then
			result.Reason = "INVALID_RELIC_ID"
			return result
		end
		local dataSet = _DataService:GetTable(self.DataSetName)
		if dataSet == nil then
			result.Reason = "RELIC_DATASET_MISSING"
			return result
		end
		local foundRow = 0
		for rowIndex = 1, dataSet:GetRowCount() do
			if dataSet:GetCell(rowIndex, "RelicId") == relicId then
				if foundRow > 0 then
					result.Reason = "DUPLICATE_RELIC_ID"
					return result
				end
				foundRow = rowIndex
			end
		end
		if foundRow == 0 then return result end
		-- Keep authored strings and empty cells unchanged; never derive game effects.
		result.DisplayName = dataSet:GetCell(foundRow, "DisplayName") or ""
		result.IconImageRUID = dataSet:GetCell(foundRow, "IconImageRUID") or ""
		result.EffectDescription = dataSet:GetCell(foundRow, "EffectDescription") or ""
		result.Success = true
		result.Reason = "OK"
		result.Source = "DATASET"
		return result
	end

end
