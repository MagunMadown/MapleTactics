@Logic
script EnemyDropContentValidatorLogic

	property boolean CacheReady = false
	property table CachedResult = nil

	@ExecSpace("ServerOnly")
	method table EnsureValid()
		if self.CacheReady == true and self.CachedResult ~= nil then
			return self.CachedResult
		end
		local result = self:ValidateAll()
		self.CachedResult = result
		self.CacheReady = true
		return result
	end

	@ExecSpace("ServerOnly")
	method void InvalidateCache(string reason)
		self.CacheReady = false
		self.CachedResult = nil
		log("[EnemyDropValidation] cache invalidated reason=" .. reason)
	end

	@ExecSpace("ServerOnly")
	method table ValidateAll()
		local loadResult = _EnemyDropDefinitionRepositoryLogic:GetAllEntries()
		if loadResult.Success == false then
			return self:Reject("", loadResult.Reason, loadResult.DetailReason or loadResult.Reason, 0)
		end

		local seenIds = {}
		local validatedCount = 0
		for _, entry in ipairs(loadResult.Entries) do
			local entryResult = self:ValidateEntryReferences(entry, seenIds)
			if entryResult.Success == false then
				return entryResult
			end
			seenIds[entry.DropEntryId] = true
			validatedCount = validatedCount + 1
		end

		local result = {
			Success = true,
			Reason = "OK",
			DetailReason = "",
			DropEntryId = "",
			ValidatedCount = validatedCount,
			Source = loadResult.Source
		}
		log("[EnemyDropValidation] all valid count=" .. validatedCount .. " source=" .. loadResult.Source)
		return result
	end

	@ExecSpace("ServerOnly")
	method table ValidateEntryReferences(table entry, table seenIds)
		if entry == nil then
			return self:Reject("", "DATA_MISSING_REQUIRED", "DROP_ENTRY_MISSING", 0)
		end
		if seenIds ~= nil and seenIds[entry.DropEntryId] == true then
			return self:Reject(entry.DropEntryId, "DATA_DUPLICATE_ID", "DUPLICATE_DROP_ENTRY_ID", entry.RowIndex or 0)
		end

		local enemyReference = _ContentReferenceResolverLogic:ResolveReference("ENEMY_DEFINITION", entry.EnemyDefinitionId)
		if enemyReference.Success == false then
			return self:Reject(entry.DropEntryId, "DATA_INVALID_DROP_REFERENCE", "ENEMY_" .. enemyReference.Reason, entry.RowIndex or 0)
		end
		local rewardReferenceType = entry.DropType
		if entry.DropType == "CURRENCY" then
			rewardReferenceType = "RUN_CURRENCY"
		end
		local rewardReference = _ContentReferenceResolverLogic:ResolveReference(rewardReferenceType, entry.DropRefId)
		if rewardReference.Success == false then
			return self:Reject(entry.DropEntryId, "DATA_INVALID_DROP_REFERENCE", entry.DropType .. "_" .. rewardReference.Reason, entry.RowIndex or 0)
		end
		if entry.DropType == "CONSUMABLE" then
			local consumableDefinition = _ConsumableDefinitionRepositoryLogic:GetDefinition(entry.DropRefId)
			if consumableDefinition.Success == false then
				return self:Reject(entry.DropEntryId, "DATA_INVALID_DROP_REFERENCE", "CONSUMABLE_" .. (consumableDefinition.DetailReason or consumableDefinition.Reason), entry.RowIndex or 0)
			end
		end
		return {
			Success = true,
			Reason = "OK",
			DetailReason = "",
			DropEntryId = entry.DropEntryId,
			RowIndex = entry.RowIndex or 0
		}
	end

	@ExecSpace("ServerOnly")
	method table Reject(string dropEntryId, string reason, string detailReason, integer rowIndex)
		local result = {
			Success = false,
			Reason = reason,
			DetailReason = detailReason,
			DropEntryId = dropEntryId,
			RowIndex = rowIndex,
			ValidatedCount = 0
		}
		log_error("[EnemyDropValidation] rejected entry=" .. dropEntryId .. " row=" .. rowIndex .. " reason=" .. reason .. " detail=" .. detailReason)
		return result
	end

end
