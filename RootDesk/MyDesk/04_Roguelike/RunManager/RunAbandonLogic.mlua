@Logic
script RunAbandonLogic extends Logic

	-- Lobby position shared with the other lobby returns; it sits on the lobby's grid step columns.
	property Vector3 LobbyPosition = Vector3(-27.3686, -7.92, 0)

	@ExecSpace("Server")
	method void RequestAbandonRun()
		-- Menu "return to lobby": ends the current run for the requesting player and sends them home.
		local playerEntity = _UserService:GetUserEntityByUserId(senderUserId)
		local result = self:AbandonRun(playerEntity)
		if result.Success == false then
			log_warning("[RunAbandon] rejected user=" .. tostring(senderUserId) .. " reason=" .. tostring(result.Reason))
		end
	end

	@ExecSpace("ServerOnly")
	method table AbandonRun(Entity playerEntity)
		if isvalid(playerEntity) == false or playerEntity.PlayerComponent == nil then
			return { Success = false, Reason = "INVALID_PLAYER" }
		end
		local map = playerEntity.CurrentMap
		if isvalid(map) == false then
			return { Success = false, Reason = "MAP_MISSING" }
		end
		if map.Name == "lobby" then
			return { Success = false, Reason = "ALREADY_IN_LOBBY" }
		end

		-- A battle map owns its own teardown (timers, waves, drops); it then reuses the defeat return.
		local session = map:GetComponent("script.BattleSessionComponent")
		if session ~= nil and session.Enable and session.PlayerEntity == playerEntity then
			local forfeit = session:ForfeitToLobby()
			log("[RunAbandon] battle forfeit success=" .. tostring(forfeit.Success) .. " reason=" .. tostring(forfeit.Reason))
			return forfeit
		end

		-- Shop, skill and other run maps have no battle session: reset the run and go straight to the lobby.
		local resetResult = _RunManagerLogic:AbandonRun(playerEntity, "MENU_LOBBY_RETURN")
		if resetResult.Success == false then
			return resetResult
		end
		local entryState = _BattleGatewayLogic:GetOrCreateEntryState(playerEntity)
		if entryState ~= nil then
			entryState:ResetToIdle("MENU_LOBBY_RETURN")
		end
		local navigation = _MapTeleportManager:TeleportPlayer(playerEntity, "lobby", self.LobbyPosition, "MENU_LOBBY_RETURN")
		log("[RunAbandon] run reset map=" .. map.Name .. " sequence=" .. tostring(resetResult.RunSequence) .. " teleport=" .. tostring(navigation.Success))
		return navigation
	end

end
