@Logic
script AscensionDifficultyLogic extends Logic

	property integer MaxLevel = 7

	method integer ResolveLevel(string difficulty)
		-- Decodes the closed rank set; the retired HARD token is a legacy rank-one alias.
		if difficulty == "NORMAL" then return 0 end
		if difficulty == "HARD" then return 1 end
		if difficulty == nil then return -1 end
		local suffix = string.match(difficulty, "^ASCENSION_([1-7])$")
		return suffix ~= nil and tonumber(suffix) or -1
	end

	method string ToDifficulty(integer level)
		-- Produces the canonical entry token only for a supported whole rank.
		if level < 0 or level > self.MaxLevel or level ~= math.floor(level) then return "" end
		return level == 0 and "NORMAL" or "ASCENSION_" .. string.format("%.0f", level)
	end

	method string GetDisplayName(integer level)
		-- Shares player-facing difficulty labels between selection and run history.
		return level == 0 and "일반" or "승천 " .. string.format("%.0f", level)
	end

	method number GetCoinMultiplier(integer level)
		-- Returns the repeatable coin multiplier for a trusted completed run only.
		local multipliers = { 1.10, 1.20, 1.35, 1.50, 1.70, 1.85, 2.00 }
		if level < 1 or level > self.MaxLevel or level ~= math.floor(level) then return 1 end
		return multipliers[level]
	end

	method integer GetFirstClearCoinBonus(integer level)
		-- Defines the flat account-wide first-clear award, including ranks three, five and seven.
		local bonuses = { 50, 75, 100, 150, 200, 250, 350 }
		if level < 1 or level > self.MaxLevel or level ~= math.floor(level) then return 0 end
		return bonuses[level]
	end

	method table GetRules(integer level)
		-- Returns cumulative bonuses as a fresh value so callers never mutate shared definitions.
		level = math.max(0, math.min(self.MaxLevel, level))
		return {
			Level = level,
			EnemyHpScale = level >= 6 and 2 or (level >= 1 and 1 or 0),
			BossHpScale = level >= 4 and 2 or (level >= 1 and 1 or 0),
			AttackBonus = level >= 7 and 2 or (level >= 2 and 1 or 0),
			ForceTurnReduction = level >= 3 and 1 or 0,
			ConcurrentBonus = level >= 5 and 1 or 0,
			SpawnCountBonus = level >= 7 and 1 or 0
		}
	end

	method string GetRuleSummary(integer level)
		-- Describes the final cumulative rules, including HP caps and ordinary-battle-only pressure.
		if level == 0 then return "기본 난이도. 전체 도전을 완주하면 승천 1이 열립니다." end
		local rules = self:GetRules(level)
		local enemyHp = rules.EnemyHpScale == 2 and "일반 적 체력 보너스 2배 (기본 체력 이내)" or "일반 적 체력 증가 (+1~4, 기본 체력 이내)"
		local bossHp = rules.BossHpScale == 2 and "보스 체력 증가 (+8~24)" or "보스 체력 증가 (+4~12)"
		local lines = { enemyHp, bossHp }
		if rules.AttackBonus > 0 then table.insert(lines, "적 기본·스킬 공격력 +" .. tostring(rules.AttackBonus)) end
		if rules.ForceTurnReduction > 0 then table.insert(lines, "일반 전투 증원 대기 -1턴 (최소 1턴)") end
		if rules.ConcurrentBonus > 0 then table.insert(lines, "일반 전투 동시 출현 한도 +1") end
		if rules.SpawnCountBonus > 0 then table.insert(lines, "일반 전투 웨이브별 적 +1") end
		return table.concat(lines, "\n")
	end

	method string GetTooltipText(integer level)
		-- Describes cumulative difficulty and completion rewards from their shared definitions.
		level = math.max(0, math.min(self.MaxLevel, level))
		local title = level == 0 and "승천 0 · 일반 난이도" or self:GetDisplayName(level)
		local multiplier = self:GetCoinMultiplier(level)
		local lines = { "<color=#FFC76B>" .. title .. "</color>", self:GetRuleSummary(level), "" }
		table.insert(lines, "<color=#88E3AB>완주 코인 " .. string.format("%.2f", multiplier) .. "배 (일반 대비 +" .. string.format("%.0f", (multiplier - 1) * 100) .. "%)</color>")
		if level > 0 then
			table.insert(lines, "직전 단계 " .. string.format("%.2f", self:GetCoinMultiplier(level - 1)) .. "배 → " .. string.format("%.2f", multiplier) .. "배")
			table.insert(lines, "최초 완주 +" .. string.format("%.0f", self:GetFirstClearCoinBonus(level)) .. " 코인 · 계정 공통 1회")
			table.insert(lines, "최초 보상은 배율 계산 후 추가됩니다.")
			table.insert(lines, "실패 시 승천 보너스 없이 기존 코인 정산")
		end
		return table.concat(lines, "\n")
	end

end
