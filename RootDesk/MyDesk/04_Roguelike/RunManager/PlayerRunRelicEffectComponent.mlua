@Component
script PlayerRunRelicEffectComponent extends Component

	@TargetUserSync property integer ActiveRunSequence = 0
	@TargetUserSync property number AttackBonus = 0
	@TargetUserSync property number MaxHpBonus = 0
	@TargetUserSync property number DefenseBonus = 0
	property number AppliedMaxHpBonus = 0
	property boolean IsInitialized = false
	property table Definitions = {}
	property table ShopBundle = {}
	property table SpecialEffects = {}
	property string ActiveBattleKey = ""
	property string LastVictoryKey = ""
	property boolean FirstHitGuardUsed = false
	property boolean LethalSurvivalUsed = false
	property boolean FirstKillUsed = false
	property table DefeatedUnitIds = {}

	@ExecSpace("ServerOnly")
	method table CaptureForRun(integer runSequence)
		-- Freeze validated definitions and prices once per run.
		if self.IsInitialized and self.ActiveRunSequence == runSequence then
			return { Success = true, Reason = "RELIC_CATALOG_ALREADY_CAPTURED" }
		end
		self.ActiveRunSequence = runSequence
		self.AttackBonus = 0
		self.MaxHpBonus = 0
		self.DefenseBonus = 0
		self.AppliedMaxHpBonus = 0
		self.IsInitialized = false
		self.Definitions = {}
		self.ShopBundle = {}
		self.SpecialEffects = {}
		self.ActiveBattleKey = ""
		self.LastVictoryKey = ""
		self.FirstHitGuardUsed = false
		self.LethalSurvivalUsed = false
		self.FirstKillUsed = false
		self.DefeatedUnitIds = {}
		if runSequence <= 0 then return { Success = true, Reason = "RELIC_RESET" } end
		local catalog = _RelicDefinitionRepositoryLogic:GetAllDefinitions()
		if catalog.Success == false then return catalog end
		local validation = _ShopContentValidatorLogic:ValidateById("shop_relic")
		if validation.Success == false then return validation end
		self.Definitions = catalog.Definitions
		self.ShopBundle = validation.Data
		self.IsInitialized = true
		log("[RunRelic] captured sequence=" .. runSequence .. " entries=" .. #self.ShopBundle.Entries)
		return { Success = true, Reason = "RELIC_CATALOG_CAPTURED" }
	end

	@ExecSpace("ServerOnly")
	method table GrantStartingRelics(integer amount)
		-- Reuses frozen definitions and stable per-run receipts; map reentry never rerolls rewards.
		local inventory = self.Entity:GetComponent("script.PlayerRunInventoryComponent")
		if not self.IsInitialized or inventory == nil or self.ActiveRunSequence <= 0
			or inventory.ActiveRunSequence ~= self.ActiveRunSequence then
			return { Success = false, Reason = "RUN_RELIC_SEQUENCE_MISMATCH" }
		end
		local candidates = {}
		for id, _ in pairs(self.Definitions) do
			if inventory:GetSnapshotAmount(inventory.RunItemSnapshot, id) == 0 then table.insert(candidates, id) end
		end
		table.sort(candidates)
		local pending = {}
		for index = 1, math.max(0, amount) do
			local key = "union:starting_relic:" .. self.ActiveRunSequence .. ":" .. index
			if not inventory:ContainsDelimitedKey(inventory.AppliedRewardKeys, key) then table.insert(pending, key) end
		end
		if #pending > #candidates then return { Success = false, Reason = "STARTING_RELIC_POOL_EXHAUSTED" } end
		for _, key in ipairs(pending) do
			local index = self:SelectRelicIndex(candidates)
			local result = inventory:GrantRelic(candidates[index], key)
			if result.Success == false then return result end
			table.remove(candidates, index)
		end
		local result = self:Recalculate()
		result.GrantedCount = #pending
		log("[UnionStartingRelic] applied sequence=" .. self.ActiveRunSequence .. " granted=" .. #pending
			.. " attack=" .. self.AttackBonus .. " hp=" .. self.MaxHpBonus .. " defense=" .. self.DefenseBonus)
		return result
	end

	@ExecSpace("ServerOnly")
	method integer SelectRelicIndex(table relicIds)
		-- Share normal:special weights of 3:1 between shop offers and starting relics.
		local weights = {}
		local totalWeight = 0
		for index, id in ipairs(relicIds) do
			local definition = self.Definitions[id]
			local weight = 3
			if definition == nil then return 0 end
			if definition.SpecialEffectType ~= nil and definition.SpecialEffectType ~= "" then weight = 1 end
			weights[index] = weight
			totalWeight = totalWeight + weight
		end
		if totalWeight <= 0 then return 0 end
		local roll = _UtilLogic:RandomIntegerRange(1, totalWeight)
		for index, weight in ipairs(weights) do
			roll = roll - weight
			if roll <= 0 then
				log("[RunRelic] draw id=" .. relicIds[index] .. " weight=" .. weight .. " total=" .. totalWeight)
				return index
			end
		end
		return 0
	end

	@ExecSpace("ServerOnly")
	method table Recalculate()
		-- Sum unique owned relics and apply only the unapplied max-HP difference.
		local runState = self.Entity:GetComponent("script.PlayerRunStateComponent")
		local inventory = self.Entity:GetComponent("script.PlayerRunInventoryComponent")
		if not self.IsInitialized or runState == nil or inventory == nil
			or runState.RunSequence ~= self.ActiveRunSequence or inventory.ActiveRunSequence ~= self.ActiveRunSequence then
			return { Success = false, Reason = "RUN_RELIC_SEQUENCE_MISMATCH" }
		end
		local attack, hp, defense = 0, 0, 0
		local specialEffects = {}
		for id, definition in pairs(self.Definitions) do
			if inventory:GetSnapshotAmount(inventory.RunItemSnapshot, id) > 0 then
				attack = attack + definition.AttackBonus
				hp = hp + definition.MaxHpBonus
				defense = defense + definition.DefenseBonus
				local effectType = definition.SpecialEffectType or ""
				if effectType ~= "" then
					specialEffects[effectType] = (specialEffects[effectType] or 0) + definition.SpecialEffectValue
				end
			end
		end
		self.AttackBonus = attack
		self.MaxHpBonus = hp
		self.DefenseBonus = defense
		self.SpecialEffects = specialEffects
		local delta = hp - self.AppliedMaxHpBonus
		if runState.RunHpInitialized and delta ~= 0 then
			-- Removing a max-HP relic clamps current HP to the new maximum without dealing damage.
			local nextMaxHp = math.max(1, runState.RunMaxHp + delta)
			local nextCurrentHp = delta < 0 and math.min(runState.RunCurrentHp, nextMaxHp) or runState.RunCurrentHp + delta
			runState:SetRunHp(nextCurrentHp, nextMaxHp, "RELIC_EFFECT")
			self.AppliedMaxHpBonus = hp
			local unit = self.Entity:GetComponent("script.BattleUnitComponent")
			if unit ~= nil then
				-- Run HP never includes a battle-only max HP buff, so keep the active buff on top of it.
				unit.MaxHp = runState.RunMaxHp + unit.MaxHpBuffAmount
				unit:RestoreCurrentHp(runState.RunCurrentHp)
			end
			log("[RunRelic] hp delta=" .. delta .. " hp=" .. runState.RunCurrentHp .. "/" .. runState.RunMaxHp)
		end
		return { Success = true, Reason = "RELIC_EFFECTS_APPLIED", AttackBonus = attack, MaxHpBonus = hp, DefenseBonus = defense }
	end

	@ExecSpace("ServerOnly")
	method boolean IsCurrentRun()
		-- Rejects uncaptured or stale effects after a run reset, including potion and damage callers.
		local runState = self.Entity:GetComponent("script.PlayerRunStateComponent")
		local inventory = self.Entity:GetComponent("script.PlayerRunInventoryComponent")
		return self.IsInitialized and self.ActiveRunSequence > 0 and runState ~= nil and inventory ~= nil
			and runState.RunSequence == self.ActiveRunSequence and inventory.ActiveRunSequence == self.ActiveRunSequence
	end

	@ExecSpace("ServerOnly")
	method number GetSpecialEffectValue(string effectType)
		-- Reads the unique-owned-relic aggregate captured for the current run.
		if not self:IsCurrentRun() then return 0 end
		return self.SpecialEffects[effectType] or 0
	end

	@ExecSpace("ServerOnly")
	method void BeginBattle(string stageId, integer entryRequestId)
		-- Arms once per encounter, never on a wave transition or repeated initialization of that entry.
		if not self:IsCurrentRun() then return end
		local key = tostring(self.ActiveRunSequence) .. ":" .. stageId .. ":" .. tostring(entryRequestId)
		if self.ActiveBattleKey == key then return end
		local recalculation = self:Recalculate()
		if recalculation.Success == false then return end
		self.ActiveBattleKey = key
		self.FirstHitGuardUsed = false
		self.LethalSurvivalUsed = false
		self.FirstKillUsed = false
		self.DefeatedUnitIds = {}
		self:ApplyRelicHealing("BATTLE_START_HEAL")
		log("[RunRelic] battle armed key=" .. key)
	end

	@ExecSpace("ServerOnly")
	method number ResolveIncomingDamage(number amount, number currentHp)
		-- Runs after other guards and stat reductions, before the unit commits HP or death.
		if amount <= 0 or currentHp <= 0 or self.ActiveBattleKey == "" then return amount end
		if not self.FirstHitGuardUsed and self:GetSpecialEffectValue("FIRST_HIT_GUARD") > 0 then
			self.FirstHitGuardUsed = true
			log("[RunRelic] triggered effect=FIRST_HIT_GUARD key=" .. self.ActiveBattleKey .. " blocked=" .. amount)
			return 0
		end
		if amount >= currentHp and not self.LethalSurvivalUsed and self:GetSpecialEffectValue("LETHAL_SURVIVAL") > 0 then
			self.LethalSurvivalUsed = true
			log("[RunRelic] triggered effect=LETHAL_SURVIVAL key=" .. self.ActiveBattleKey .. " hp=1")
			return math.max(0, currentHp - 1)
		end
		return amount
	end

	@ExecSpace("ServerOnly")
	method void ApplyRelicHealing(string effectType)
		-- Uses the unit's healing API so run HP stays synchronized and dead players are never revived.
		local amount = self:GetSpecialEffectValue(effectType)
		local unit = self.Entity:GetComponent("script.BattleUnitComponent")
		if amount <= 0 or unit == nil or unit.Team ~= "Player" then return end
		local healing = unit:ApplyHealing(amount)
		log("[RunRelic] triggered effect=" .. effectType .. " key=" .. self.ActiveBattleKey
			.. " applied=" .. tostring(healing.AppliedAmount or 0) .. " reason=" .. healing.Reason)
	end

	@ExecSpace("ServerOnly")
	method void OnEnemyKilled(string unitId)
		-- Called only for an attributed, confirmed enemy death, before wave/victory settlement.
		if not self:IsCurrentRun() or self.ActiveBattleKey == "" or self.DefeatedUnitIds[unitId] then return end
		self.DefeatedUnitIds[unitId] = true
		self:ApplyRelicHealing("KILL_HEAL")
		if self.FirstKillUsed then return end
		self.FirstKillUsed = true
		local reduction = self:GetSpecialEffectValue("FIRST_KILL_COOLDOWN")
		local runtime = self.Entity:GetComponent("script.SkillRuntimeStateComponent")
		if reduction > 0 and runtime ~= nil then
			runtime:AdvanceCooldowns(reduction, "RELIC_FIRST_KILL")
			log("[RunRelic] triggered effect=FIRST_KILL_COOLDOWN key=" .. self.ActiveBattleKey .. " reduction=" .. reduction)
		end
	end

	@ExecSpace("ServerOnly")
	method table ApplyVictory(string battleRecordKey)
		-- Retries currency safely through the reward receipt; healing is committed only once per battle.
		if not self:IsCurrentRun() or self.ActiveBattleKey ~= battleRecordKey then
			return { Success = true, Reason = "RELIC_BATTLE_NOT_ACTIVE" }
		end
		if self.LastVictoryKey == battleRecordKey then return { Success = true, Reason = "RELIC_VICTORY_ALREADY_APPLIED" } end
		local amount = self:GetSpecialEffectValue("VICTORY_MESO")
		if amount > 0 then
			local grant = _RunManagerLogic:GrantRunReward(self.Entity, "CURRENCY", _RunManagerLogic.MesoCurrencyId,
				amount, "relic:victory:" .. battleRecordKey)
			if grant.Success == false then return grant end
			log("[RunRelic] triggered effect=VICTORY_MESO key=" .. battleRecordKey
				.. " amount=" .. tostring(grant.FinalAmount or amount) .. " reason=" .. grant.Reason)
		end
		self:ApplyRelicHealing("VICTORY_HEAL")
		self.LastVictoryKey = battleRecordKey
		return { Success = true, Reason = "RELIC_VICTORY_APPLIED" }
	end

end
