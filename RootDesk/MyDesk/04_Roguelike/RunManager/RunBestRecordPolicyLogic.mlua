@Logic
script RunBestRecordPolicyLogic extends Logic

	property string PolicyVersion = "completed_progress_turns_hits_time_v1"

	method boolean IsCandidate(table record)
		-- Personal best accepts authoritative, ranking-eligible completions only, never Maker/prototype runs.
		return record ~= nil and record.RankEligible == true and record.EndReason == "COMPLETED"
	end

	method boolean IsBetter(table candidate, table previous)
		-- Higher completed ascensions rank first; legacy records are level zero with their original tie rules.
		if self:IsCandidate(candidate) == false then return false end
		if self:IsCandidate(previous) == false then return true end
		local candidateLevel = candidate.AscensionLevel or 0
		local previousLevel = previous.AscensionLevel or 0
		if candidateLevel ~= previousLevel then return candidateLevel > previousLevel end
		if candidate.CompletedStageNumber ~= previous.CompletedStageNumber then
			return candidate.CompletedStageNumber > previous.CompletedStageNumber
		end
		if candidate.ConsumedTurns ~= previous.ConsumedTurns then return candidate.ConsumedTurns < previous.ConsumedTurns end
		if candidate.HitsTaken ~= previous.HitsTaken then return candidate.HitsTaken < previous.HitsTaken end
		if candidate.ElapsedSeconds ~= previous.ElapsedSeconds then return candidate.ElapsedSeconds < previous.ElapsedSeconds end
		return false
	end

end
