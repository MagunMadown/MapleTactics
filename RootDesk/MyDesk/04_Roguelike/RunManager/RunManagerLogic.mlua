@Logic
script RunManagerLogic

	property integer DefaultRunSeed = 1000

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- This Logic coordinates run state but never stores one user's mutable run as global data.
		log("[RunManager] ready defaultSeed=" .. self.DefaultRunSeed)
	end

	@ExecSpace("ServerOnly")
	method any GetOrCreateRunState(Entity playerEntity)
		if isvalid(playerEntity) == false or playerEntity.PlayerComponent == nil then
			log_error("[RunManager] state unavailable reason=INVALID_PLAYER")
			return nil
		end

		local runState = playerEntity:GetComponent("script.PlayerRunStateComponent")
		if runState == nil then
			runState = playerEntity:AddComponent("PlayerRunStateComponent")
		end
		if runState == nil then
			log_error("[RunManager] state unavailable reason=COMPONENT_ATTACH_FAILED player=" .. playerEntity.Name)
			return nil
		end
		return runState
	end

	@ExecSpace("ServerOnly")
	method any EnsureRunState(Entity playerEntity, integer fallbackSeed)
		local runState = self:GetOrCreateRunState(playerEntity)
		if runState == nil then
			return nil
		end

		if runState.RunSequence <= 0 or runState.RunState == "Idle" then
			local seed = fallbackSeed
			if seed < 0 then
				seed = self.DefaultRunSeed
			end
			runState:BeginNewRun(seed)
			log("[RunManager] initialized player=" .. playerEntity.Name .. " sequence=" .. runState.RunSequence .. " seed=" .. runState.RunSeed)
		else
			log("[RunManager] reused player=" .. playerEntity.Name .. " sequence=" .. runState.RunSequence .. " seed=" .. runState.RunSeed .. " state=" .. runState.RunState)
		end
		return runState
	end

	@ExecSpace("ServerOnly")
	method any StartNewRun(Entity playerEntity, integer runSeed)
		local runState = self:GetOrCreateRunState(playerEntity)
		if runState == nil then
			return nil
		end

		runState:BeginNewRun(runSeed)
		log("[RunManager] new run player=" .. playerEntity.Name .. " sequence=" .. runState.RunSequence .. " seed=" .. runState.RunSeed)
		return runState
	end

	@ExecSpace("ServerOnly")
	method boolean RecordBattleResult(Entity playerEntity, integer stageNumber, string battleResult)
		local runState = self:GetOrCreateRunState(playerEntity)
		if runState == nil then
			return false
		end
		return runState:RecordBattleResult(stageNumber, battleResult)
	end

end
