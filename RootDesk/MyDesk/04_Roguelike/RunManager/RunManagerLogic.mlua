@Logic
script RunManagerLogic extends Logic

	property integer DefaultRunSeed = 1000
	property string DefaultJobId = "warrior"
	property string LobbyPrototypeStageId = "henesys_stage_01"
	property string MesoCurrencyId = "gold"
	property string StartingPotionId = "orange_potion"

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- This Logic coordinates run state but never stores one user's mutable run as global data.
		log("[RunManager] ready defaultSeed=" .. self.DefaultRunSeed .. " defaultJob=" .. self.DefaultJobId)
	end

	@ExecSpace("ServerOnly")
	method string ResolveJobId(string jobId)
		-- Normalizes legacy callers without duplicating the default-job policy in map components.
		if jobId == nil or jobId == "" then
			return self.DefaultJobId
		end
		return jobId
	end

	@ExecSpace("ServerOnly")
	method table ApplyJobSelection(Entity playerEntity, string jobId)
		-- Validates and applies one job at the run boundary while preventing mid-run job swaps.
		local runState = self:GetOrCreateRunState(playerEntity)
		if runState == nil then
			return { Success = false, Reason = "RUN_STATE_UNAVAILABLE" }
		end
		local resolvedJobId = self:ResolveJobId(jobId)
		if (jobId == nil or jobId == "") and runState.SelectedJobId ~= "" then
			resolvedJobId = runState.SelectedJobId
		end
		if runState.SelectedJobId ~= "" and runState.SelectedJobId ~= resolvedJobId then
			return { Success = false, Reason = "JOB_CHANGE_NOT_ALLOWED", JobId = resolvedJobId }
		end
		local unionSnapshot = self:GetRunUnionEffectSnapshot(playerEntity)
		if unionSnapshot.Success == false then
			return unionSnapshot
		end
		local jobSnapshot = nil
		if runState.SelectedJobId == resolvedJobId and runState.JobBaseMaxHp > 0 then
			jobSnapshot = runState:GetJobSnapshot()
		else
			local validation = _ContentValidatorLogic:ValidateJobById(resolvedJobId)
			if validation.Success == false then
				return validation
			end
			jobSnapshot = runState:ApplyJobBundle(validation.Data, unionSnapshot.StartingSkillBonus, unionSnapshot.MaxHPBonus)
		end
		if jobSnapshot.Success == false then
			return jobSnapshot
		end
		local inventory = self:GetOrCreateRunInventory(playerEntity)
		if inventory == nil or inventory.ActiveRunSequence ~= runState.RunSequence then
			return { Success = false, Reason = "RUN_INVENTORY_SEQUENCE_MISMATCH", JobId = resolvedJobId }
		end
		if inventory.RunSkillSnapshot == "" then
			local skillResult = inventory:InitializeStartingSkills(runState.StartingSkillIds)
			if skillResult.Success == false then
				return skillResult
			end
		end
		jobSnapshot.OwnedSkillSnapshot = inventory.RunSkillSnapshot
		jobSnapshot.SkillInventoryRevision = inventory.SkillInventoryRevision
		local augmentState = self:GetOrCreateRunAugmentState(playerEntity)
		if augmentState == nil or augmentState.ActiveRunSequence ~= runState.RunSequence then
			return { Success = false, Reason = "RUN_AUGMENT_SEQUENCE_MISMATCH", JobId = resolvedJobId }
		end
		-- Job utilities replace automatic job augments, including already-started run snapshots.
		runState.SelectedJobPassiveSetId = ""
		runState.SelectedJobMechanicId = "NONE"
		augmentState:RemoveJobPassives()
		jobSnapshot.PassiveSetId = ""
		jobSnapshot.MechanicId = "NONE"
		jobSnapshot.OwnedAugmentSnapshot = augmentState.OwnedAugmentSnapshot
		jobSnapshot.AugmentRevision = augmentState.AugmentRevision
		return jobSnapshot
	end

	@ExecSpace("ServerOnly")
	method table GetRunJobSnapshot(Entity playerEntity)
		-- Exposes the selected job to lobby, battle, shop, and result systems through one facade.
		local runState = self:GetOrCreateRunState(playerEntity)
		if runState == nil then
			return { Success = false, Reason = "RUN_STATE_UNAVAILABLE" }
		end
		return runState:GetJobSnapshot()
	end

	@ExecSpace("ServerOnly")
	method table GetLobbyBattleEntryContext(Entity playerEntity)
		-- Aggregates existing owners only; this facade does not own lobby, job, or run state.
		local runState = self:GetOrCreateRunState(playerEntity)
		if runState == nil then
			return { IsReady = false, Success = false, Reason = "RUN_STATE_UNAVAILABLE" }
		end
		local jobState = playerEntity:GetComponent("script.TemporaryClassSelectionStateComponent")
		if jobState == nil or jobState.SelectedJobId == "" then
			return { IsReady = false, Success = false, Reason = "JOB_NOT_SELECTED" }
		end

		local stageId = self:ResolveLobbyBattleStageId(runState)
		local stageDefinition = _StageDefinitionRepositoryLogic:GetStageDefinition(stageId)
		if stageDefinition.Success == false then
			return { IsReady = false, Success = false, Reason = stageDefinition.Reason, StageId = stageId }
		end
		local jobDefinition = _JobDefinitionRepositoryLogic:GetJobDefinition(jobState.SelectedJobId)
		if jobDefinition.Success == false or jobDefinition.Enabled ~= true then
			return { IsReady = false, Success = false, Reason = jobDefinition.Reason, StageId = stageId, JobId = jobState.SelectedJobId }
		end

		local entryMode = self:ResolveLobbyBattleEntryMode(runState)
		if runState.RunState == "Completed" then
			log("[RunManager] completed run restart ready sequence=" .. tostring(runState.RunSequence) .. " stage=" .. stageId .. " mode=" .. entryMode)
		end
		return {
			IsReady = true,
			Success = true,
			Reason = "OK",
			StageId = stageId,
			JobId = jobState.SelectedJobId,
			RunSeed = runState.RunSeed,
			EntryMode = entryMode,
			CharacterId = "",
			LoadoutId = "",
			CharacterIdRequired = false,
			LoadoutIdRequired = false
		}
	end

	@ExecSpace("ServerOnly")
	method string ResolveLobbyBattleStageId(any runState)
		-- A selected battle/boss node is authoritative; otherwise use the real StageDefinitions prototype row.
		if runState ~= nil
			and runState.RunState == "Active"
			and (runState.SelectedContentType == "BATTLE" or runState.SelectedContentType == "BOSS")
			and runState.SelectedContentId ~= "" then
			return runState.SelectedContentId
		end
		return self.LobbyPrototypeStageId
	end

	method string ResolveLobbyBattleEntryMode(any runState)
		-- Only an active run is resumable in the existing lifecycle; Idle, Failed, and Completed start new.
		if runState ~= nil and runState.RunSequence > 0 and runState.RunState == "Active" then
			return "CONTINUE_RUN"
		end
		return "NEW_RUN"
	end

	@ExecSpace("ClientOnly")
	method table GetLocalLobbyBattleEntryContext()
		-- UI-facing read DTO built from synced player-owned state; no random/default IDs are generated here.
		local playerEntity = _UserService.LocalPlayer
		if playerEntity == nil then
			return { IsReady = false, Success = false, Reason = "LOCAL_PLAYER_UNAVAILABLE" }
		end
		local runState = playerEntity:GetComponent("script.PlayerRunStateComponent")
		local jobState = playerEntity:GetComponent("script.TemporaryClassSelectionStateComponent")
		if jobState == nil or jobState.SelectedJobId == "" then
			return { IsReady = false, Success = false, Reason = "JOB_NOT_SELECTED" }
		end
		local stageId = self.LobbyPrototypeStageId
		if runState ~= nil
			and runState.RunState == "Active"
			and (runState.SelectedContentType == "BATTLE" or runState.SelectedContentType == "BOSS")
			and runState.SelectedContentId ~= "" then
			stageId = runState.SelectedContentId
		end
		local runSeed = self.DefaultRunSeed
		if runState ~= nil then
			runSeed = runState.RunSeed
		end
		return {
			IsReady = stageId ~= "",
			Success = stageId ~= "",
			Reason = stageId ~= "" and "OK" or "STAGE_NOT_RESOLVED",
			StageId = stageId,
			JobId = jobState.SelectedJobId,
			RunSeed = runSeed,
			EntryMode = self:ResolveLobbyBattleEntryMode(runState),
			CharacterId = "",
			LoadoutId = "",
			CharacterIdRequired = false,
			LoadoutIdRequired = false
		}
	end

	@ExecSpace("ServerOnly")
	method any GetOrCreateRunState(Entity playerEntity)
		-- Returns the player-owned run progression component without storing mutable state in this Logic.
		if isvalid(playerEntity) == false or playerEntity.PlayerComponent == nil then
			log_error("[RunManager] state unavailable reason=INVALID_PLAYER")
			return nil
		end

		local runState = playerEntity:GetComponent("script.PlayerRunStateComponent")
		if runState == nil then
			runState = playerEntity:AddComponent("PlayerRunStateComponent")
		end
		if runState == nil then
			log_error("[RunManager] state unavailable reason=COMPONENT_ATTACH_FAILED player=" .. playerEntity.Name)
			return nil
		end
		return runState
	end

	@ExecSpace("ServerOnly")
	method any GetOrCreateRunInventory(Entity playerEntity)
		-- Returns the separate player-owned run inventory component.
		if isvalid(playerEntity) == false or playerEntity.PlayerComponent == nil then
			log_error("[RunManager] inventory unavailable reason=INVALID_PLAYER")
			return nil
		end
		local inventory = playerEntity:GetComponent("script.PlayerRunInventoryComponent")
		if inventory == nil then
			inventory = playerEntity:AddComponent("PlayerRunInventoryComponent")
		end
		if inventory == nil then
			log_error("[RunManager] inventory unavailable reason=COMPONENT_ATTACH_FAILED player=" .. playerEntity.Name)
		end
		return inventory
	end

	@ExecSpace("ServerOnly")
	method any GetOrCreateRunAugmentState(Entity playerEntity)
		-- Returns the player-owned run augment component without storing instances in global Logic state.
		if isvalid(playerEntity) == false or playerEntity.PlayerComponent == nil then
			log_error("[RunManager] augment state unavailable reason=INVALID_PLAYER")
			return nil
		end
		local augmentState = playerEntity:GetComponent("script.PlayerRunAugmentComponent")
		if augmentState == nil then
			augmentState = playerEntity:AddComponent("PlayerRunAugmentComponent")
		end
		if augmentState == nil then
			log_error("[RunManager] augment state unavailable reason=COMPONENT_ATTACH_FAILED player=" .. playerEntity.Name)
		end
		return augmentState
	end

	@ExecSpace("ServerOnly")
	method any GetOrCreateRunUnionEffectState(Entity playerEntity)
		-- Returns the player-owned immutable-per-run Union effect snapshot component.
		if isvalid(playerEntity) == false or playerEntity.PlayerComponent == nil then
			log_error("[RunManager] Union effect state unavailable reason=INVALID_PLAYER")
			return nil
		end
		local unionState = playerEntity:GetComponent("script.PlayerRunUnionEffectComponent")
		if unionState == nil then
			unionState = playerEntity:AddComponent("PlayerRunUnionEffectComponent")
		end
		if unionState == nil then
			log_error("[RunManager] Union effect state unavailable reason=COMPONENT_ATTACH_FAILED player=" .. playerEntity.Name)
		end
		return unionState
	end

	@ExecSpace("ServerOnly")
	method table GetRunUnionEffectSnapshot(Entity playerEntity)
		-- Exposes only the captured run snapshot and never re-resolves the permanent profile mid-run.
		local runState = self:GetOrCreateRunState(playerEntity)
		local unionState = self:GetOrCreateRunUnionEffectState(playerEntity)
		if runState == nil or unionState == nil then
			return { Success = false, Reason = "RUN_UNION_STATE_UNAVAILABLE" }
		end
		local snapshot = unionState:GetSnapshot()
		if snapshot.Success == false or snapshot.RunSequence ~= runState.RunSequence then
			return { Success = false, Reason = "RUN_UNION_SEQUENCE_MISMATCH", RunSequence = runState.RunSequence, UnionRunSequence = snapshot.RunSequence or 0 }
		end
		return snapshot
	end

	@ExecSpace("ServerOnly")
	method table InitializeNewRunOwnedState(Entity playerEntity, any runState, table resolvedEffectSnapshot)
		-- Captures Union once, then initializes the existing inventory and augment owners for the same sequence.
		local unionState = self:GetOrCreateRunUnionEffectState(playerEntity)
		if unionState == nil then
			return { Success = false, Reason = "RUN_UNION_STATE_UNAVAILABLE" }
		end
		local captured = unionState:CaptureForRun(runState.RunSequence, resolvedEffectSnapshot)
		if captured.Success == false then
			return captured
		end
		local rewardRun = _UnionRewardServiceLogic:BeginRun(playerEntity, runState.RunSequence)
		if rewardRun.Success == false then
			return {
				Success = false,
				Reason = "UNION_REWARD_RUN_INITIALIZATION_FAILED",
				CauseReason = rewardRun.Reason or "UNKNOWN",
				DetailReason = rewardRun.DetailReason or "",
				ErrorCode = rewardRun.ErrorCode or 0
			}
		end
		local inventory = self:GetOrCreateRunInventory(playerEntity)
		if inventory == nil then
			return { Success = false, Reason = "RUN_INVENTORY_UNAVAILABLE" }
		end
		inventory:ResetForRun(runState.RunSequence, captured.InventorySlotBonus)
		if captured.StartingPotionBonus > 0 then
			local potionGrant = inventory:GrantRunReward(
				"CONSUMABLE",
				self.StartingPotionId,
				captured.StartingPotionBonus,
				"union:start:" .. tostring(runState.RunSequence) .. ":" .. self.StartingPotionId
			)
			if potionGrant.Success == false then
				return { Success = false, Reason = "UNION_STARTING_POTION_GRANT_FAILED", DetailReason = potionGrant.Reason }
			end
		end
		local augmentState = self:GetOrCreateRunAugmentState(playerEntity)
		if augmentState == nil then
			return { Success = false, Reason = "RUN_AUGMENT_UNAVAILABLE" }
		end
		augmentState:ResetForRun(runState.RunSequence, captured.AugmentRerollBonus)
		local shopReset = _RunShopLogic:ResetPlayerShopState(playerEntity, runState.RunSequence)
		if shopReset.Success == false then
			return { Success = false, Reason = "RUN_SHOP_STATE_INITIALIZATION_FAILED", DetailReason = shopReset.Reason }
		end
		return { Success = true, Reason = "RUN_OWNED_STATE_INITIALIZED", UnionSnapshot = captured }
	end

	@ExecSpace("ServerOnly")
	method any EnsureRunState(Entity playerEntity, integer fallbackSeed)
		-- Reuses an active run or initializes progression and inventory as one boundary.
		local runState = self:GetOrCreateRunState(playerEntity)
		if runState == nil then
			return nil
		end

		if runState.RunSequence <= 0 or runState.RunState == "Idle" then
			local seed = fallbackSeed
			if seed < 0 then
				seed = self.DefaultRunSeed
			end
			local resolvedEffects = _UnionEffectResolverLogic:GetEffectSnapshot(playerEntity)
			if resolvedEffects.Success == false then
				log_error("[UnionEffect] run start blocked reason=" .. (resolvedEffects.Reason or "UNKNOWN"))
				return nil
			end
			runState:BeginNewRun(seed)
			local initialized = self:InitializeNewRunOwnedState(playerEntity, runState, resolvedEffects.EffectSnapshot)
			if initialized.Success == false then
				log_error("[UnionEffect] run-owned initialization failed reason=" .. initialized.Reason)
				return nil
			end
			log("[RunManager] initialized player=" .. playerEntity.Name .. " sequence=" .. runState.RunSequence .. " seed=" .. runState.RunSeed)
		else
			self:GetOrCreateRunInventory(playerEntity)
			local unionState = self:GetOrCreateRunUnionEffectState(playerEntity)
			if unionState == nil then
				return nil
			end
			if unionState.IsInitialized == false or unionState.ActiveRunSequence ~= runState.RunSequence then
				local fallbackCapture = unionState:CaptureForRun(runState.RunSequence, {})
				if fallbackCapture.Success == false then
					return nil
				end
				log_warning("[UnionEffect] active run had no stable snapshot; zero bonuses captured sequence=" .. runState.RunSequence)
			end
			if unionState.RewardRunId <= 0 then
				local rewardRun = _UnionRewardServiceLogic:BeginRun(playerEntity, runState.RunSequence)
				if rewardRun.Success == false then
					log_error("[UnionReward] active run reward initialization failed reason=" .. rewardRun.Reason)
					return nil
				end
				log_warning("[UnionReward] active run received a migrated reward run id=" .. tostring(rewardRun.RewardRunId or 0))
			end
			local augmentState = self:GetOrCreateRunAugmentState(playerEntity)
			if augmentState == nil then
				return nil
			end
			if augmentState.ActiveRunSequence ~= runState.RunSequence then
				augmentState:ResetForRun(runState.RunSequence, unionState.AugmentRerollBonus)
				log("[RunManager] migrated augment state sequence=" .. runState.RunSequence)
			end
			log("[RunManager] reused player=" .. playerEntity.Name .. " sequence=" .. runState.RunSequence .. " seed=" .. runState.RunSeed .. " state=" .. runState.RunState)
		end
		return runState
	end

	@ExecSpace("ServerOnly")
	method any StartNewRun(Entity playerEntity, integer runSeed)
		-- Starts progression and resets independently owned inventory and augment state.
		local runState = self:GetOrCreateRunState(playerEntity)
		if runState == nil then
			return nil
		end

		local resolvedEffects = _UnionEffectResolverLogic:GetEffectSnapshot(playerEntity)
		if resolvedEffects.Success == false then
			log_error("[UnionEffect] run start blocked reason=" .. (resolvedEffects.Reason or "UNKNOWN"))
			return nil
		end
		runState:BeginNewRun(runSeed)
		local initialized = self:InitializeNewRunOwnedState(playerEntity, runState, resolvedEffects.EffectSnapshot)
		if initialized.Success == false then
			log_error("[UnionEffect] run-owned initialization failed reason=" .. initialized.Reason .. " cause=" .. (initialized.CauseReason or "UNKNOWN") .. " detail=" .. (initialized.DetailReason or "") .. " errorCode=" .. tostring(initialized.ErrorCode or 0))
			return nil
		end
		log("[RunManager] new run player=" .. playerEntity.Name .. " sequence=" .. runState.RunSequence .. " seed=" .. runState.RunSeed)
		return runState
	end

	@ExecSpace("ServerOnly")
	method table ResetFailedRun(Entity playerEntity, string reason)
		-- Clears every player-owned run payload only after the authoritative defeat result has been recorded.
		local runState = self:GetOrCreateRunState(playerEntity)
		if runState == nil then
			return { Success = false, Reason = "RUN_STATE_UNAVAILABLE" }
		end
		if runState.RunState ~= "Failed" or runState.LastBattleResult ~= "Defeat" then
			return { Success = false, Reason = "RUN_NOT_FAILED" }
		end
		local inventory = self:GetOrCreateRunInventory(playerEntity)
		if inventory == nil then
			return { Success = false, Reason = "RUN_INVENTORY_UNAVAILABLE" }
		end
		local augmentState = self:GetOrCreateRunAugmentState(playerEntity)
		if augmentState == nil then
			return { Success = false, Reason = "RUN_AUGMENT_UNAVAILABLE" }
		end
		local unionState = self:GetOrCreateRunUnionEffectState(playerEntity)
		if unionState == nil then
			return { Success = false, Reason = "RUN_UNION_STATE_UNAVAILABLE" }
		end

		local resetResult = runState:ResetAfterDefeat(reason)
		if resetResult.Success == false then
			return resetResult
		end
		inventory:ResetForRun(0, 0)
		augmentState:ResetForRun(0, 0)
		unionState:ClearRunSnapshot("DEFEAT_RESET")
		local shopReset = _RunShopLogic:ResetPlayerShopState(playerEntity, 0)
		if shopReset.Success == false then
			return { Success = false, Reason = "RUN_SHOP_STATE_RESET_FAILED", DetailReason = shopReset.Reason }
		end
		log("[RunManager] failed run reset player=" .. playerEntity.Name .. " sequence=" .. resetResult.RunSequence .. " reason=" .. resetResult.Reason)
		return resetResult
	end

	@ExecSpace("ServerOnly")
	method boolean RecordBattleResult(Entity playerEntity, string stageId, integer stageNumber, string battleResult, integer entryRequestId)
		-- Commits stage and relic rewards before progressing the run; each reward owns its retry receipt.
		local runState = self:GetOrCreateRunState(playerEntity)
		if runState == nil then
			return false
		end
		local battleRecordKey = tostring(runState.RunSequence) .. ":" .. stageId .. ":" .. tostring(entryRequestId)
		if runState.LastBattleRecordKey == battleRecordKey then
			log_warning("[RunManager] duplicate result ignored key=" .. battleRecordKey)
			return true
		end
		local flowResult = _NodeDefinitionRepositoryLogic:ResolveBattleOutcome(
			runState.CurrentNodeGraphId,
			runState.CurrentNodeId,
			stageId,
			battleResult
		)
		if flowResult.Success == false then
			log_error("[RunManager] flow resolution failed stage=" .. stageId .. " reason=" .. flowResult.Reason)
			return false
		end
		if battleResult == "Victory" then
			local rewardResult = self:ApplyStageClearRewards(playerEntity, stageId, battleRecordKey)
			if rewardResult.Success == false then
				log_error("[RunManager] stage reward failed stage=" .. stageId .. " reason=" .. rewardResult.Reason .. " detail=" .. (rewardResult.DetailReason or ""))
				return false
			end
			local relics = playerEntity:GetComponent("script.PlayerRunRelicEffectComponent")
			if relics ~= nil then
				local relicResult = relics:ApplyVictory(battleRecordKey)
				if relicResult.Success == false then
					log_error("[RunManager] relic victory failed key=" .. battleRecordKey .. " reason=" .. relicResult.Reason)
					return false
				end
			end
		end
		local unionRewardResult = _UnionRewardServiceLogic:ProcessBattleResult(
			playerEntity,
			stageId,
			flowResult.StageType or self:ResolveStageType(stageId),
			battleResult,
			battleRecordKey,
			flowResult
		)
		if unionRewardResult.Success == false then
			log_error("[RunManager] Union reward failed stage=" .. stageId .. " reason=" .. unionRewardResult.Reason)
			return false
		end
		if battleResult == "Victory" then
			-- Uses the node normalized by ResolveBattleOutcome before applying the next flow state.
			if runState.CurrentNodeGraphId ~= flowResult.NodeGraphId or runState.CurrentNodeId ~= flowResult.CompletedNodeId then
				log_warning("[RunManager] Union Job milestone context normalized stage=" .. stageId .. " previousGraph=" .. runState.CurrentNodeGraphId .. " previousNode=" .. runState.CurrentNodeId .. " resolvedGraph=" .. (flowResult.NodeGraphId or "") .. " resolvedNode=" .. (flowResult.CompletedNodeId or ""))
			end
			local jobProgressionResult = _UnionJobProgressionServiceLogic:TryApplyJobUnionMilestone(playerEntity, {
				BattleResult = battleResult,
				StageId = stageId,
				NodeGraphId = flowResult.NodeGraphId,
				NodeId = flowResult.CompletedNodeId
			})
			if jobProgressionResult.Success == false then
				log_error("[RunManager] Union Job milestone failed stage=" .. stageId .. " reason=" .. (jobProgressionResult.Reason or "UNKNOWN"))
				return false
			end
			if jobProgressionResult.WasImproved == true then
				log("[RunManager] Union Job milestone committed job=" .. jobProgressionResult.AuthoritativeJobId .. " milestone=" .. jobProgressionResult.MilestoneId .. " progress=" .. tostring(jobProgressionResult.NewProgress))
			end
		end
		if runState:RecordBattleResult(stageNumber, battleResult, battleRecordKey) == false then
			return false
		end
		if runState:ApplyBattleFlowResult(flowResult) == false then
			return false
		end
		if unionRewardResult.RunEnded == true and battleResult == "Victory" then
			runState:MarkRunCompleted("UNION_REWARD_RUN_CLEAR")
		end
		return true
	end

	@ExecSpace("ServerOnly")
	method string ResolveStageType(string stageId)
		local definition = _StageDefinitionRepositoryLogic:GetStageDefinition(stageId)
		if definition.Success == false then
			return ""
		end
		return definition.StageType or ""
	end

	@ExecSpace("ServerOnly")
	method table ApplyStageClearRewards(Entity playerEntity, string stageId, string battleRecordKey)
		-- Resolves static Stage rewards, then delegates every mutation and duplicate guard to the run inventory owner.
		local validation = _ContentValidatorLogic:ValidateStageRewards()
		if validation.Success == false then
			return { Success = false, Reason = "STAGE_REWARD_VALIDATION_FAILED", DetailReason = validation.DetailReason or validation.Reason, AppliedCount = 0 }
		end
		local definitions = _StageRewardDefinitionRepositoryLogic:GetRewardsForStage(stageId)
		if definitions.Success == false then
			return { Success = false, Reason = definitions.Reason, DetailReason = definitions.DetailReason or "", AppliedCount = 0 }
		end
		local result = { Success = true, Reason = definitions.Reason, StageId = stageId, AppliedCount = 0, DuplicateCount = 0, RewardSnapshot = "" }
		for _, entry in ipairs(definitions.Entries) do
			local rewardKey = "stage:" .. battleRecordKey .. ":" .. entry.StageRewardEntryId
			local grant = self:GrantRunReward(playerEntity, entry.RewardType, entry.RewardRefId, entry.Amount, rewardKey)
			if grant.Success == false then
				result.Success = false
				result.Reason = "STAGE_REWARD_GRANT_FAILED"
				result.DetailReason = entry.StageRewardEntryId .. ":" .. grant.Reason
				return result
			end
			if grant.Reason == "DUPLICATE_REWARD_IGNORED" then
				result.DuplicateCount = result.DuplicateCount + 1
			else
				result.AppliedCount = result.AppliedCount + 1
			end
			local grantedAmount = grant.FinalAmount or entry.Amount
			local snapshotEntry = entry.StageRewardEntryId .. "~" .. entry.RewardType .. "~" .. entry.RewardRefId .. "~" .. tostring(grantedAmount)
			result.RewardSnapshot = result.RewardSnapshot == "" and snapshotEntry or result.RewardSnapshot .. "|" .. snapshotEntry
		end
		log("[StageReward] resolved stage=" .. stageId .. " battleKey=" .. battleRecordKey .. " applied=" .. result.AppliedCount .. " duplicate=" .. result.DuplicateCount .. " rewards=" .. result.RewardSnapshot)
		return result
	end

	@ExecSpace("ServerOnly")
	method table GetRunFlowSnapshot(Entity playerEntity)
		local runState = self:GetOrCreateRunState(playerEntity)
		if runState == nil then
			return { Success = false, Reason = "RUN_STATE_UNAVAILABLE" }
		end
		return runState:GetRunFlowSnapshot()
	end

	@ExecSpace("ServerOnly")
	method table SelectNextContent(Entity playerEntity, string nodeId, integer requestId)
		-- Authenticated callers select only one option already published in the player-owned flow snapshot.
		local runState = self:GetOrCreateRunState(playerEntity)
		if runState == nil then
			return { Success = false, Reason = "RUN_STATE_UNAVAILABLE" }
		end
		if requestId == nil or requestId <= 0 then
			return { Success = false, Reason = "INVALID_CONTENT_SELECTION_REQUEST" }
		end
		local selectionKey = tostring(runState.RunSequence) .. ":" .. tostring(requestId)
		if runState.LastContentSelectionKey == selectionKey then
			local duplicate = runState:GetRunFlowSnapshot()
			duplicate.Reason = "DUPLICATE_SELECTION_IGNORED"
			return duplicate
		end
		if runState.RunFlowState ~= "AWAITING_NODE_SELECTION" or runState.ContentTransitionState ~= "SELECTION_REQUIRED" then
			return { Success = false, Reason = "NODE_SELECTION_NOT_AVAILABLE", RunFlowState = runState.RunFlowState, ContentTransitionState = runState.ContentTransitionState }
		end

		local selection = self:ResolveAvailableContentSelection(runState, nodeId)
		if selection.Success == false then
			return selection
		end
		local route = _RunContentFlowRouterLogic:Resolve(selection)
		if route.Success == false then
			return route
		end
		local applied = runState:ApplyContentTransition(selection, route, selectionKey)
		applied.Reason = route.Reason
		return applied
	end

	@ExecSpace("ServerOnly")
	method table CompleteCurrentContent(Entity playerEntity, string expectedContentType, integer requestId)
		-- Completes one selected non-battle node through a shared server-authoritative boundary.
		local runState = self:GetOrCreateRunState(playerEntity)
		if runState == nil then
			return { Success = false, Reason = "RUN_STATE_UNAVAILABLE" }
		end
		if requestId == nil or requestId <= 0 then
			return { Success = false, Reason = "INVALID_CONTENT_COMPLETION_REQUEST" }
		end
		local completionKey = tostring(runState.RunSequence) .. ":" .. tostring(requestId)
		if runState.LastContentCompletionKey == completionKey then
			local duplicate = runState:GetRunFlowSnapshot()
			duplicate.Reason = "DUPLICATE_CONTENT_COMPLETION_IGNORED"
			return duplicate
		end
		if expectedContentType ~= "SHOP" and expectedContentType ~= "EVENT" and expectedContentType ~= "REST" then
			return { Success = false, Reason = "CONTENT_TYPE_NOT_COMPLETABLE", ContentType = expectedContentType or "" }
		end
		if runState.SelectedContentType ~= expectedContentType then
			return { Success = false, Reason = "CONTENT_TYPE_MISMATCH", ExpectedContentType = expectedContentType, SelectedContentType = runState.SelectedContentType }
		end
		local expectedFlowState = "AWAITING_" .. expectedContentType
		if runState.RunFlowState ~= expectedFlowState or runState.ContentTransitionState ~= "READY" then
			return { Success = false, Reason = "CONTENT_COMPLETION_NOT_READY", RunFlowState = runState.RunFlowState, ContentTransitionState = runState.ContentTransitionState }
		end
		if runState.CurrentNodeGraphId == "" or runState.SelectedNodeId == "" or runState.CurrentNodeId ~= runState.SelectedNodeId then
			return { Success = false, Reason = "CONTENT_NODE_CONTEXT_MISMATCH" }
		end
		local flowResult = _NodeDefinitionRepositoryLogic:ResolveContentCompletion(runState.CurrentNodeGraphId, runState.SelectedNodeId)
		if flowResult.Success == false then
			return flowResult
		end
		if flowResult.FlowState == "RUN_COMPLETED" then
			local reward = _UnionRewardServiceLogic:ProcessTerminalContentCompletion(playerEntity, runState.RunSequence, runState.LastCompletedStageId)
			if reward.Success == false then return reward end
		end
		return runState:ApplyContentCompletion(flowResult, completionKey)
	end

	@ExecSpace("ServerOnly")
	method table ResolveAvailableContentSelection(any runState, string nodeId)
		local nodeIds = self:SplitPipeValues(runState.AvailableNodeIds)
		local contentTypes = self:SplitPipeValues(runState.AvailableContentTypes)
		local contentIds = self:SplitPipeValues(runState.AvailableContentIds)
		if #nodeIds ~= #contentTypes or #nodeIds ~= #contentIds then
			return { Success = false, Reason = "RUN_FLOW_OPTION_SNAPSHOT_MISMATCH" }
		end
		for index = 1, #nodeIds do
			if nodeIds[index] == nodeId then
				local nodeDefinition = _NodeDefinitionRepositoryLogic:GetNodeDefinition(runState.CurrentNodeGraphId, nodeId)
				if nodeDefinition.Success == false then
					return { Success = false, Reason = nodeDefinition.Reason, DetailReason = nodeDefinition.DetailReason or "" }
				end
				local expectedContentId = nodeDefinition.NodeId
				if nodeDefinition.NodeType == "BATTLE" or nodeDefinition.NodeType == "BOSS" then
					expectedContentId = nodeDefinition.StageId
				elseif nodeDefinition.NodeType == "SHOP" then
					local binding = _ShopNodeBindingRepositoryLogic:GetBinding(nodeDefinition.NodeGraphId, nodeDefinition.NodeId)
					if binding.Success == false then
						return { Success = false, Reason = binding.DetailReason or binding.Reason, NodeId = nodeId }
					end
					expectedContentId = binding.ShopId
				end
				if nodeDefinition.NodeType ~= contentTypes[index] or expectedContentId ~= contentIds[index] then
					return { Success = false, Reason = "RUN_FLOW_OPTION_DEFINITION_MISMATCH", NodeId = nodeId }
				end
				return {
					Success = true,
					Reason = "AVAILABLE_CONTENT_SELECTED",
					NodeGraphId = runState.CurrentNodeGraphId,
					NodeId = nodeId,
					ContentType = contentTypes[index],
					ContentId = contentIds[index]
				}
			end
		end
		return { Success = false, Reason = "NODE_NOT_AVAILABLE", NodeId = nodeId or "" }
	end

	method table SplitPipeValues(string snapshot)
		local values = {}
		for value in string.gmatch(snapshot or "", "([^|]+)") do
			table.insert(values, value)
		end
		return values
	end

	@ExecSpace("Server")
	method void RequestSelectNextContent(string nodeId, integer requestId)
		local playerEntity = _UserService:GetUserEntityByUserId(senderUserId)
		local result = self:SelectNextContent(playerEntity, nodeId, requestId)
		if result.Success == false then
			log_warning("[RunContentFlow] selection rejected user=" .. senderUserId .. " node=" .. nodeId .. " request=" .. requestId .. " reason=" .. result.Reason)
			self:NotifyContentSelectionResult(false, result.Reason, nodeId, senderUserId)
			return
		end
		log("[RunContentFlow] selection accepted user=" .. senderUserId .. " node=" .. nodeId .. " request=" .. requestId .. " action=" .. (result.RouteAction or "") .. " reason=" .. result.Reason)
		if result.Reason ~= "DUPLICATE_SELECTION_IGNORED" and (result.SelectedContentType == "SHOP" or result.ContentType == "SHOP") then
			local transfer = _RunContentMapTransitionAdapterLogic:ConsumeSelectedShop(playerEntity)
			if transfer.Success == false then
				log_warning("[RunContentFlow] shop transfer rejected user=" .. senderUserId .. " node=" .. nodeId .. " reason=" .. transfer.Reason)
			end
		elseif result.SelectedContentType == "BATTLE" or result.ContentType == "BATTLE"
			or result.SelectedContentType == "BOSS" or result.ContentType == "BOSS" then
			local transfer = _RunContentMapTransitionAdapterLogic:ConsumeSelectedBattle(playerEntity)
			if transfer.Success == false then
				log_warning("[RunContentFlow] battle transfer rejected user=" .. senderUserId .. " node=" .. nodeId .. " reason=" .. transfer.Reason)
				self:NotifyContentSelectionResult(false, transfer.Reason, nodeId, senderUserId)
			end
		end
	end

	@ExecSpace("Client")
	method void NotifyContentSelectionResult(boolean success, string reason, string nodeId)
		-- Restores the matching world-map choice after a rejected selection.
		if success then return end
		if string.find(nodeId or "", "shop_", 1, true) == 1 then
			local uiRoot = _EntityService:GetEntityByPath("/ui/DefaultGroup")
			local minimap = isvalid(uiRoot) and uiRoot:GetComponent("script.MinimapUI") or nil
			if minimap ~= nil then
				local clearedStageId = nodeId == "shop_ellinia_nautilus" and "ellinia_stage_04" or "henesys_stage_04"
				if nodeId == "shop_kerning_perion" then clearedStageId = "region_kerning_stage_04" end
				if nodeId == "shop_perion_sleepywood" then clearedStageId = "region_04_stage_04" end
				if nodeId == "shop_nautilus_sleepywood" then clearedStageId = "region_05_stage_04" end
				minimap:OpenWorldMapMode("SHOP_CHOICE", "SELECTION_REJECTED:" .. reason, clearedStageId)
			end
			log_warning("[WorldMapShop] selection rejected node=" .. nodeId .. " reason=" .. reason)
			return
		end
		local regionPaths = { kerning_stage01_battle = "KerningCityBranchBtn", perion_stage01_battle = "PerionCityBranchBtn", ellinia_stage01_battle = "ElliniaBranchBtn", nautilus_stage01_battle = "NautilusCityBranchBtn", sleepywood_stage01_battle = "SleepywoodCityBranchBtn" }
		if regionPaths[nodeId] ~= nil then
			local elliniaNode = _EntityService:GetEntityByPath("/ui/PopupGroup/MapTeleportPopup/" .. regionPaths[nodeId])
			local regionButton = isvalid(elliniaNode) and elliniaNode:GetComponent("script.WorldMapFutureRegionButtonComponent") or nil
			if regionButton ~= nil then regionButton:HandleEntryResult(false, reason) end
			log_warning("[WorldMapRegion] battle selection rejected node=" .. nodeId .. " reason=" .. reason)
		end
	end

	@ExecSpace("ServerOnly")
	method table SelectWorldMapBranch(Entity playerEntity, string branchId)
		-- Commits exactly one post-Henesys route so upper and lower shop choices are mutually exclusive.
		local runState = self:GetOrCreateRunState(playerEntity)
		if runState == nil then
			return { Success = false, Reason = "RUN_STATE_UNAVAILABLE" }
		end
		if runState.CompletedStageCount < 1 then
			return { Success = false, Reason = "HENESYS_NOT_CLEARED" }
		end
		if branchId ~= "UPPER" and branchId ~= "LOWER" then
			return { Success = false, Reason = "INVALID_WORLD_MAP_BRANCH" }
		end
		if runState.SelectedWorldMapBranch == branchId then
			return { Success = true, Reason = "DUPLICATE_BRANCH_SELECTION", BranchId = branchId }
		end
		if runState.SelectedWorldMapBranch ~= "" then
			return { Success = false, Reason = "WORLD_MAP_BRANCH_ALREADY_SELECTED", BranchId = runState.SelectedWorldMapBranch }
		end
		runState.SelectedWorldMapBranch = branchId
		runState.RunFlowRevision = runState.RunFlowRevision + 1
		log("[WorldMap] branch selected player=" .. playerEntity.Name .. " branch=" .. branchId .. " completed=" .. runState.CompletedStageCount)
		return { Success = true, Reason = "WORLD_MAP_BRANCH_SELECTED", BranchId = branchId }
	end

	@ExecSpace("Server")
	method void RequestSelectWorldMapBranch(string branchId)
		-- Accepts the owning client's upper/lower shop choice through an authenticated RPC boundary.
		local playerEntity = _UserService:GetUserEntityByUserId(senderUserId)
		local result = self:SelectWorldMapBranch(playerEntity, branchId)
		if result.Success == false then
			log_warning("[WorldMap] branch request rejected user=" .. senderUserId .. " branch=" .. branchId .. " reason=" .. result.Reason)
			return
		end
		log("[WorldMap] branch request accepted user=" .. senderUserId .. " branch=" .. branchId .. " reason=" .. result.Reason)
	end

	@ExecSpace("ClientOnly")
	method table GetLocalRunFlowUiState()
		-- Client UI reads one DTO and never parses NodeDefinitions or calls content handlers.
		local playerEntity = _UserService.LocalPlayer
		if playerEntity == nil then
			return { Success = false, Reason = "LOCAL_PLAYER_UNAVAILABLE" }
		end
		local runState = playerEntity:GetComponent("script.PlayerRunStateComponent")
		if runState == nil then
			return { Success = false, Reason = "RUN_STATE_UNAVAILABLE" }
		end
		return {
			Success = true,
			Reason = runState.ContentTransitionReason,
			RevisionKey = tostring(runState.RunFlowRevision) .. ":" .. tostring(runState.ContentTransitionRevision),
			RunState = runState.RunState,
			RunFlowState = runState.RunFlowState,
			CurrentNodeGraphId = runState.CurrentNodeGraphId,
			CurrentNodeId = runState.CurrentNodeId,
			AvailableNodeIds = runState.AvailableNodeIds,
			AvailableContentTypes = runState.AvailableContentTypes,
			AvailableContentIds = runState.AvailableContentIds,
			SelectedWorldMapBranch = runState.SelectedWorldMapBranch,
			Transition = {
				State = runState.ContentTransitionState,
				SelectedNodeId = runState.SelectedNodeId,
				ContentType = runState.SelectedContentType,
				ContentId = runState.SelectedContentId,
				RouteAction = runState.ContentRouteAction,
				UiRouteId = runState.ContentUiRouteId,
				DestinationType = runState.ContentDestinationType,
				DestinationId = runState.ContentDestinationId,
				RequiresMapTransfer = runState.ContentRequiresMapTransfer,
				Reason = runState.ContentTransitionReason,
				Revision = runState.ContentTransitionRevision
			},
			Commands = {
				CanSelectNode = runState.RunFlowState == "AWAITING_NODE_SELECTION" and runState.ContentTransitionState == "SELECTION_REQUIRED",
				CanConsumeTransition = runState.ContentTransitionState == "READY",
				CanCompleteContent = runState.ContentTransitionState == "READY"
					and (runState.SelectedContentType == "SHOP" or runState.SelectedContentType == "EVENT" or runState.SelectedContentType == "REST")
			}
		}
	end

	@ExecSpace("ServerOnly")
	method table GrantRunReward(Entity playerEntity, string rewardType, string rewardRefId, integer amount, string rewardKey)
		-- Public reward boundary for battle, shop, event, and future node implementations.
		local runState = self:GetOrCreateRunState(playerEntity)
		local inventory = self:GetOrCreateRunInventory(playerEntity)
		if runState == nil or inventory == nil then
			return { Success = false, Reason = "RUN_STATE_UNAVAILABLE" }
		end
		if runState.RunSequence <= 0 or runState.RunState == "Idle" then
			return { Success = false, Reason = "RUN_NOT_STARTED" }
		end
		if inventory.ActiveRunSequence ~= runState.RunSequence then
			return { Success = false, Reason = "RUN_INVENTORY_SEQUENCE_MISMATCH" }
		end
		local finalAmount = amount
		local mesoGainRate = 0
		if rewardType == "CURRENCY" and rewardRefId == self.MesoCurrencyId then
			local unionState = self:GetOrCreateRunUnionEffectState(playerEntity)
			if unionState == nil or unionState.IsInitialized == false or unionState.ActiveRunSequence ~= runState.RunSequence then
				return { Success = false, Reason = "RUN_UNION_SEQUENCE_MISMATCH" }
			end
			mesoGainRate = unionState.MesoGainRate
			finalAmount = unionState:CalculateMesoReward(amount)
		end
		local grant = inventory:GrantRunReward(rewardType, rewardRefId, finalAmount, rewardKey)
		grant.BaseAmount = amount
		grant.FinalAmount = finalAmount
		grant.UnionMesoGainRate = mesoGainRate
		if grant.Success and grant.Reason ~= "DUPLICATE_REWARD_IGNORED" and isvalid(playerEntity.CurrentMap) then
			local session = playerEntity.CurrentMap:GetComponent("script.BattleSessionComponent")
			if session ~= nil and session.PlayerEntity == playerEntity then
				session:RecordRoundReward(rewardType, grant.RewardRefId or rewardRefId, grant.AcceptedAmount or 0, rewardKey)
				if (grant.OverflowAmount or 0) > 0 and inventory.OverflowCurrencyPerItem > 0 and inventory.OverflowCurrencyId ~= "" then
					session:RecordRoundReward("CURRENCY", inventory.OverflowCurrencyId, grant.OverflowAmount * inventory.OverflowCurrencyPerItem, rewardKey .. ":overflow")
				end
			end
		end
		return grant
	end

	@ExecSpace("ServerOnly")
	method table ApplyRunShopPurchase(Entity playerEntity, table shopEntry, string purchaseKey)
		-- Shop validates immutable content; RunManager enforces run ownership before the inventory performs one atomic mutation.
		if shopEntry == nil or shopEntry.Success ~= true then
			return { Success = false, Reason = "INVALID_SHOP_ENTRY" }
		end
		local runState = self:GetOrCreateRunState(playerEntity)
		local inventory = self:GetOrCreateRunInventory(playerEntity)
		if runState == nil or inventory == nil then
			return { Success = false, Reason = "RUN_STATE_UNAVAILABLE" }
		end
		if inventory.ActiveRunSequence ~= runState.RunSequence then
			return { Success = false, Reason = "RUN_INVENTORY_SEQUENCE_MISMATCH" }
		end
		local effects = _RunShopLogic:GetOrCreateRelicEffects(playerEntity)
		if effects == nil or not effects.IsInitialized or effects.ActiveRunSequence ~= runState.RunSequence then
			return { Success = false, Reason = "RUN_RELIC_SEQUENCE_MISMATCH" }
		end
		if shopEntry.RewardType == "ITEM" and effects.Definitions[shopEntry.RewardRefId] == nil then
			return { Success = false, Reason = "RUN_RELIC_SEQUENCE_MISMATCH" }
		end
		if shopEntry.RewardType ~= "ITEM" and shopEntry.RewardType ~= "CONSUMABLE" then
			return { Success = false, Reason = "UNSUPPORTED_PURCHASE_REWARD_TYPE" }
		end
		if shopEntry.RewardType == "ITEM" and inventory:GetSnapshotAmount(inventory.RunItemSnapshot, shopEntry.RewardRefId) > 0 then
			return { Success = false, Reason = "RELIC_ALREADY_OWNED" }
		end
		local purchase = inventory:ApplyShopPurchase(
			shopEntry.PriceCurrencyId,
			shopEntry.PriceAmount,
			shopEntry.RewardType,
			shopEntry.RewardRefId,
			shopEntry.RewardAmount,
			purchaseKey
		)
		if purchase.Success and shopEntry.RewardType == "ITEM" then effects:Recalculate() end
		return purchase
	end

	@ExecSpace("ServerOnly")
	method table GetRunRewardSnapshot(Entity playerEntity)
		-- Returns the inventory DTO through the stable RunManager facade.
		local inventory = self:GetOrCreateRunInventory(playerEntity)
		if inventory == nil then
			return { Success = false, Reason = "RUN_STATE_UNAVAILABLE" }
		end
		return inventory:GetSnapshot()
	end

	@ExecSpace("ServerOnly")
	method table CalculateUnionPointReward(Entity playerEntity, integer baseUnionPoints)
		-- Returns the captured-run Union Coin result without granting or persisting it.
		local unionSnapshot = self:GetRunUnionEffectSnapshot(playerEntity)
		if unionSnapshot.Success == false then
			return unionSnapshot
		end
		local unionState = self:GetOrCreateRunUnionEffectState(playerEntity)
		local finalUnionPoints = unionState:CalculateUnionPointReward(baseUnionPoints)
		return {
			Success = baseUnionPoints ~= nil and baseUnionPoints > 0,
			Reason = baseUnionPoints ~= nil and baseUnionPoints > 0 and "OK" or "INVALID_UNION_POINT_AMOUNT",
			BaseUnionPoints = baseUnionPoints or 0,
			UnionPointGainRate = unionSnapshot.UnionPointGainRate,
			FinalUnionPoints = finalUnionPoints,
			WasGranted = false
		}
	end

	@ExecSpace("ServerOnly")
	method table CanUseRunSkill(Entity playerEntity, string skillId)
		-- Checks player-owned run skill eligibility through the inventory facade.
		local runState = self:GetOrCreateRunState(playerEntity)
		local inventory = self:GetOrCreateRunInventory(playerEntity)
		if runState == nil or inventory == nil then
			return { Success = false, Reason = "RUN_STATE_UNAVAILABLE", SkillId = skillId or "" }
		end
		if inventory.ActiveRunSequence ~= runState.RunSequence then
			return { Success = false, Reason = "RUN_INVENTORY_SEQUENCE_MISMATCH", SkillId = skillId or "" }
		end
		return inventory:CanUseSkill(skillId)
	end

	@ExecSpace("ServerOnly")
	method table GrantRunSkill(Entity playerEntity, string skillId, integer amount, string rewardKey)
		-- Validates a skill reference before granting it from a future shop, reward, or event adapter.
		local validation = _ContentValidatorLogic:ValidateSkillById(skillId)
		if validation.Success == false then
			return validation
		end
		local runState = self:GetOrCreateRunState(playerEntity)
		local inventory = self:GetOrCreateRunInventory(playerEntity)
		if runState == nil or inventory == nil then
			return { Success = false, Reason = "RUN_STATE_UNAVAILABLE", SkillId = skillId or "" }
		end
		if inventory.ActiveRunSequence ~= runState.RunSequence then
			return { Success = false, Reason = "RUN_INVENTORY_SEQUENCE_MISMATCH", SkillId = skillId or "" }
		end
		return inventory:GrantSkill(skillId, amount, rewardKey)
	end

	@ExecSpace("ServerOnly")
	method table GetRunSkillSnapshot(Entity playerEntity)
		-- Returns the mutable run-owned skill DTO for server integrations and tests.
		local inventory = self:GetOrCreateRunInventory(playerEntity)
		if inventory == nil then
			return { Success = false, Reason = "RUN_STATE_UNAVAILABLE" }
		end
		return inventory:GetSkillSnapshot()
	end

	@ExecSpace("ServerOnly")
	method table GrantRunAugment(Entity playerEntity, string augmentId, string sourceType, string rewardKey)
		-- Validates static content before mutating the player-owned augment instance collection.
		local validation = _ContentValidatorLogic:ValidateAugmentById(augmentId)
		if validation.Success == false then
			return validation
		end
		local runState = self:GetOrCreateRunState(playerEntity)
		local augmentState = self:GetOrCreateRunAugmentState(playerEntity)
		if runState == nil or augmentState == nil then
			return { Success = false, Reason = "RUN_STATE_UNAVAILABLE", AugmentId = augmentId or "" }
		end
		if augmentState.ActiveRunSequence ~= runState.RunSequence then
			return { Success = false, Reason = "RUN_AUGMENT_SEQUENCE_MISMATCH", AugmentId = augmentId or "" }
		end
		return augmentState:GrantUniqueAugment(augmentId, sourceType, rewardKey)
	end

	@ExecSpace("ServerOnly")
	method table GetRunAugmentSnapshot(Entity playerEntity)
		-- Returns the mutable run augment DTO for battle, shop, result, and tests.
		local augmentState = self:GetOrCreateRunAugmentState(playerEntity)
		if augmentState == nil then
			return { Success = false, Reason = "RUN_STATE_UNAVAILABLE" }
		end
		return augmentState:GetSnapshot()
	end

	@ExecSpace("ServerOnly")
	method table CanUseRunConsumable(Entity playerEntity, string consumableId, string useKey)
		-- Checks one consumable without exposing the inventory component to battle code.
		local inventory = self:GetOrCreateRunInventory(playerEntity)
		if inventory == nil then
			return { Success = false, Reason = "RUN_STATE_UNAVAILABLE" }
		end
		return inventory:CanConsume(consumableId, 1, useKey)
	end

	@ExecSpace("ServerOnly")
	method table ConsumeRunConsumable(Entity playerEntity, string consumableId, string useKey)
		-- Commits one validated consumable use through the run inventory owner.
		local inventory = self:GetOrCreateRunInventory(playerEntity)
		if inventory == nil then
			return { Success = false, Reason = "RUN_STATE_UNAVAILABLE" }
		end
		return inventory:Consume(consumableId, 1, useKey)
	end

	@ExecSpace("ClientOnly")
	method table GetLocalRunStatsSnapshot()
		-- Exposes synchronized run statistics in battle, rest, shop, and the completed-run lobby.
		local playerEntity = _UserService.LocalPlayer
		if isvalid(playerEntity) then
			local combatStats = playerEntity:GetComponent("script.PlayerRunCombatStatsComponent")
			if combatStats ~= nil then
				return combatStats:GetSnapshot()
			end
		end
		return { Success = false, RunSequence = 0, RunStartTime = 0, ElapsedSeconds = 0,
			FinalElapsedSeconds = 0, IsRunning = false, ConsumedTurns = 0, HitsTaken = 0, Revision = 0 }
	end

end
