@Component
script PlayerRunAugmentComponent extends Component

	@TargetUserSync property integer ActiveRunSequence = 0
	@TargetUserSync property string OwnedAugmentSnapshot = ""
	@TargetUserSync property string SkillAugmentSnapshot = ""
	@TargetUserSync property integer AvailableRerollCount = 0
	@TargetUserSync property integer AugmentRevision = 0
	property integer BaseRerollCount = 2
	property integer MaxSkillAugmentStages = 2
	property integer NextAcquiredOrder = 1
	property string AppliedAugmentRewardKeys = ""

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- Reports attachment while all mutable augment instances remain player-owned.
		log("[RunAugment] attached player=" .. self.Entity.Name .. " runSequence=" .. self.ActiveRunSequence)
	end

	@ExecSpace("ServerOnly")
	method void ResetForRun(integer runSequence, integer rerollBonus)
		-- Clears augment instances and initializes the available rerolls once for this run sequence.
		self.ActiveRunSequence = math.max(0, runSequence)
		self.OwnedAugmentSnapshot = ""
		self.SkillAugmentSnapshot = ""
		self._T.SkillUpgradeOffers = nil
		self._T.RerollClearReceipts = {}
		self.AvailableRerollCount = math.max(0, self.BaseRerollCount + math.max(0, math.floor(tonumber(rerollBonus) or 0)))
		self.AugmentRevision = self.AugmentRevision + 1
		self.NextAcquiredOrder = 1
		self.AppliedAugmentRewardKeys = ""
		log("[RunAugment] reset runSequence=" .. self.ActiveRunSequence .. " rerolls=" .. self.AvailableRerollCount .. " revision=" .. self.AugmentRevision)
	end

	@ExecSpace("ServerOnly")
	method table GrantUniqueAugment(string augmentId, string sourceType, string rewardKey)
		-- Adds one validated UNIQUE augment exactly once and records acquisition order.
		if self.ActiveRunSequence <= 0 then
			return { Success = false, Reason = "RUN_NOT_STARTED", AugmentId = augmentId or "" }
		end
		if self:IsSafeToken(augmentId) == false or self:IsSafeToken(sourceType) == false or self:IsSafeToken(rewardKey) == false then
			return { Success = false, Reason = "INVALID_AUGMENT_REWARD_KEY", AugmentId = augmentId or "" }
		end
		if self:ContainsDelimitedKey(self.AppliedAugmentRewardKeys, rewardKey) then
			return { Success = true, Reason = "DUPLICATE_REWARD_IGNORED", AugmentId = augmentId, Revision = self.AugmentRevision }
		end
		local definition = _AugmentDefinitionRepositoryLogic:GetDefinition(augmentId)
		if definition.Success and definition.ExclusiveGroup == "SKILL_AUGMENT" then
			return { Success = false, Reason = "SKILL_BINDING_REQUIRED", AugmentId = augmentId }
		end
		local existing = self:FindOwnedAugment(augmentId)
		if existing.Success == true then
			self.AppliedAugmentRewardKeys = self:AppendDelimitedKey(self.AppliedAugmentRewardKeys, rewardKey)
			return { Success = true, Reason = "AUGMENT_ALREADY_OWNED", AugmentId = augmentId, Stacks = existing.Stacks, AcquiredOrder = existing.AcquiredOrder, Revision = self.AugmentRevision }
		end
		local acquiredOrder = self.NextAcquiredOrder
		self.NextAcquiredOrder = self.NextAcquiredOrder + 1
		local encoded = augmentId .. "~1~" .. tostring(acquiredOrder) .. "~" .. sourceType
		self.OwnedAugmentSnapshot = self:AppendDelimitedKey(self.OwnedAugmentSnapshot, encoded)
		self.AppliedAugmentRewardKeys = self:AppendDelimitedKey(self.AppliedAugmentRewardKeys, rewardKey)
		self.AugmentRevision = self.AugmentRevision + 1
		log("[RunAugment] granted id=" .. augmentId .. " source=" .. sourceType .. " order=" .. acquiredOrder .. " revision=" .. self.AugmentRevision)
		return { Success = true, Reason = "APPLIED", AugmentId = augmentId, Stacks = 1, AcquiredOrder = acquiredOrder, Revision = self.AugmentRevision }
	end

	@ExecSpace("ServerOnly")
	method table FindOwnedAugment(string augmentId)
		-- Finds one owned augment without exposing the serialized representation to callers.
		for _, entry in ipairs(self:GetOwnedEntries()) do
			if entry.AugmentId == augmentId then
				entry.Success = true
				entry.Reason = "AUGMENT_OWNED"
				return entry
			end
		end
		return { Success = false, Reason = "AUGMENT_NOT_OWNED", AugmentId = augmentId or "", Stacks = 0, AcquiredOrder = 0 }
	end

	@ExecSpace("ServerOnly")
	method void RemoveJobPassives()
		-- Removes only legacy job-granted augments, preserving all reward/shop augments.
		local kept = {}
		local removed = 0
		for _, entry in ipairs(self:GetOwnedEntries()) do
			if entry.SourceType == "JOB" then
				removed = removed + 1
			else
				table.insert(kept, entry.AugmentId .. "~" .. tostring(entry.Stacks) .. "~" .. tostring(entry.AcquiredOrder) .. "~" .. entry.SourceType)
			end
		end
		if removed > 0 then
			self.OwnedAugmentSnapshot = table.concat(kept, "|")
			self.AugmentRevision = self.AugmentRevision + 1
			log("[RunAugment] removed legacy job passives count=" .. tostring(removed))
		end
	end

	@ExecSpace("ServerOnly")
	method table GetOwnedEntries()
		-- Decodes owned augment instances in acquisition order for deterministic runtime dispatch.
		local entries = {}
		for encoded in string.gmatch(self.OwnedAugmentSnapshot or "", "([^|]+)") do
			local fields = {}
			for field in string.gmatch(encoded, "([^~]+)") do
				table.insert(fields, field)
			end
			if #fields == 4 then
				table.insert(entries, {
					AugmentId = fields[1],
					Stacks = math.max(1, math.floor(tonumber(fields[2]) or 1)),
					AcquiredOrder = math.max(1, math.floor(tonumber(fields[3]) or 1)),
					SourceType = fields[4]
				})
			end
		end
		table.sort(entries, function(left, right)
			if left.AcquiredOrder ~= right.AcquiredOrder then
				return left.AcquiredOrder < right.AcquiredOrder
			end
			return left.AugmentId < right.AugmentId
		end)
		return entries
	end

	@ExecSpace("ServerOnly")
	method table GetSnapshot()
		-- Returns the stable player-owned augment DTO for battle and external flow systems.
		return { Success = true, Reason = "OK", RunSequence = self.ActiveRunSequence, OwnedAugmentSnapshot = self.OwnedAugmentSnapshot, OwnedCount = #self:GetOwnedEntries(), SkillAugmentSnapshot = self.SkillAugmentSnapshot, AvailableRerollCount = self.AvailableRerollCount, Revision = self.AugmentRevision }
	end

	method boolean ContainsDelimitedKey(string snapshot, string key)
		-- Tests a pipe-delimited key collection without partial matches.
		return string.find("|" .. (snapshot or "") .. "|", "|" .. key .. "|", 1, true) ~= nil
	end

	method string AppendDelimitedKey(string snapshot, string key)
		-- Appends one encoded entry to a pipe-delimited collection.
		if snapshot == nil or snapshot == "" then
			return key
		end
		return snapshot .. "|" .. key
	end

	method boolean IsSafeToken(string value)
		-- Protects the internal augment snapshot delimiters from ambiguous identifiers.
		return value ~= nil and value ~= "" and string.find(value, "|", 1, true) == nil and string.find(value, "~", 1, true) == nil
	end


	@ExecSpace("ServerOnly")
	method string GetSkillAugmentId(string skillId)
		-- Reads one skill-bound augment separately from global/job passives.
		for id, augmentId in string.gmatch(self.SkillAugmentSnapshot or "", "([^|~]+)~([^|~]+)") do
			if id == skillId then return augmentId end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method table SetSkillAugment(string skillId, string augmentId, string rewardKey)
		-- Skill modifiers require completed tier upgrades and use their own augment-stage budget.
		if self.ActiveRunSequence <= 0 or not self:IsSafeToken(skillId) or not self:IsSafeToken(augmentId)
			or not self:IsSafeToken(rewardKey) then return { Success = false, Reason = "INVALID_SKILL_AUGMENT" } end
		if self:ContainsDelimitedKey(self.AppliedAugmentRewardKeys, rewardKey) then
			return { Success = false, Reason = "UPGRADE_ALREADY_APPLIED" }
		end
		local inventory = self.Entity:GetComponent("script.PlayerRunInventoryComponent")
		if inventory == nil or inventory.ActiveRunSequence ~= self.ActiveRunSequence or inventory:GetSnapshotAmount(inventory.RunSkillSnapshot, skillId) <= 0 then
			return { Success = false, Reason = "SKILL_NOT_OWNED" }
		end
		local definition = _SkillDefinitionRepositoryLogic:GetSkillDefinition(skillId)
		if not definition.Success then return definition end
		local run = self.Entity:GetComponent("script.PlayerRunStateComponent")
		if run == nil or run.RunSequence ~= self.ActiveRunSequence then
			return { Success = false, Reason = "RUN_AUGMENT_UNAVAILABLE" }
		end
		local path = _SkillDefinitionRepositoryLogic:GetNextSkillUpgrade(run.SelectedJobId, skillId)
		if path.Success then return { Success = false, Reason = "SKILL_TIER_UPGRADE_REQUIRED" } end
		if path.Reason ~= "NO_UPGRADE_PATH" then return path end
		if #self:GetSkillAugmentIds(skillId) >= self.MaxSkillAugmentStages then
			return { Success = false, Reason = "SKILL_AUGMENT_LIMIT" }
		end
		local current = _AugmentRuntimeLogic:GetEffectiveSkillBundle(self.Entity, skillId)
		local checked = _AugmentContentValidatorLogic:ValidateById(augmentId)
		if not current.Success or not checked.Success or not _AugmentRuntimeLogic:CanBindSkillAugment(current.Data.Definition, current.Data.EffectSteps, checked.Data) then
			return { Success = false, Reason = "INVALID_SKILL_AUGMENT" }
		end
		self.SkillAugmentSnapshot = self:AppendDelimitedKey(self.SkillAugmentSnapshot, skillId .. "~" .. augmentId)
		self.AppliedAugmentRewardKeys = self:AppendDelimitedKey(self.AppliedAugmentRewardKeys, rewardKey)
		self.AugmentRevision = self.AugmentRevision + 1
		self._T.SkillUpgradeOffers = nil
		log("[SkillAugment] applied skill=" .. skillId .. " augment=" .. augmentId .. " reward=" .. rewardKey)
		return { Success = true, Reason = "APPLIED" }
	end

	@ExecSpace("ServerOnly")
	method table GetSkillAugmentIds(string skillId)
		local ids = {}
		for id, augmentId in string.gmatch(self.SkillAugmentSnapshot or "", "([^|~]+)~([^|~]+)") do
			if id == skillId then table.insert(ids, augmentId) end
		end
		return ids
	end

	@ExecSpace("ServerOnly")
	method void TransferSkillAugments(string baseSkillId, string upgradeSkillId)
		local entries = {}
		local moved = 0
		for id, augmentId in string.gmatch(self.SkillAugmentSnapshot or "", "([^|~]+)~([^|~]+)") do
			if id == baseSkillId then id = upgradeSkillId; moved = moved + 1 end
			table.insert(entries, id .. "~" .. augmentId)
		end
		if moved == 0 then return end
		self.SkillAugmentSnapshot = table.concat(entries, "|")
		self.AugmentRevision = self.AugmentRevision + 1
		self._T.SkillUpgradeOffers = nil
		log("[SkillAugment] transferred base=" .. baseSkillId .. " upgrade=" .. upgradeSkillId .. " count=" .. moved)
	end

	@ExecSpace("ServerOnly")
	method void RemoveSkillAugments(string skillId)
		local kept = {}
		for id, augmentId in string.gmatch(self.SkillAugmentSnapshot or "", "([^|~]+)~([^|~]+)") do
			if id ~= skillId then table.insert(kept, id .. "~" .. augmentId) end
		end
		self.SkillAugmentSnapshot = table.concat(kept, "|")
		self.AugmentRevision = self.AugmentRevision + 1
		self._T.SkillUpgradeOffers = nil
	end


	@ExecSpace("ServerOnly")
	method void GrantClearReroll(string completionKey, boolean boss)
		if self.ActiveRunSequence <= 0 or not self:IsSafeToken(completionKey) then return end
		self._T.RerollClearReceipts = self._T.RerollClearReceipts or {}
		if self._T.RerollClearReceipts[completionKey] then return end
		-- Record misses too: repeated result callbacks must not reroll the 20% reward.
		self._T.RerollClearReceipts[completionKey] = true
		local awarded = boss or _UtilLogic:RandomIntegerRange(1, 100) <= 20
		if awarded then self.AvailableRerollCount = self.AvailableRerollCount + 1 end
		log("[AugmentReroll] clear=" .. completionKey .. " boss=" .. tostring(boss) .. " awarded=" .. tostring(awarded) .. " count=" .. self.AvailableRerollCount)
	end

end
