@Logic
script RunResultContractLogic extends Logic

	property integer SchemaVersion = 3
	property integer MaxRecordBytes = 4000
	property string RuleVersion = "run_result_v1"
	property string BalanceVersion = "balance_2026_10_06"
	property string SeasonId = "all_time"
	property string RankingRuleVersion = "completion_turns_hits_v1"
	property string AccountProgressionMode = "ACCOUNT_APPLIED"

	method table CaptureConditions(string difficulty, boolean observedStart)
		-- Captures server policy at run start; unversioned data is not a public leaderboard release.
		return { Captured = true, ObservedStart = observedStart, DifficultyId = difficulty,
			BalanceVersion = self.BalanceVersion, SeasonId = self.SeasonId,
			RankingRuleVersion = self.RankingRuleVersion, AccountProgressionMode = self.AccountProgressionMode }
	end

	method table EmptyConditions()
		-- Legacy records cannot be assigned today's balance, difficulty, or season retrospectively.
		return { Captured = false, ObservedStart = false, DifficultyId = "", BalanceVersion = "",
			SeasonId = "", RankingRuleVersion = "", AccountProgressionMode = "" }
	end

	method table ValidateConditions(table conditions)
		-- Validates bounded server-captured grouping fields without changing private best-record policy.
		if type(conditions) ~= "table" or conditions.Captured ~= true or type(conditions.ObservedStart) ~= "boolean" then
			return { Success = false, Reason = "RUN_RESULT_CONDITIONS_MISSING" }
		end
		for _, field in ipairs({ "DifficultyId", "BalanceVersion", "SeasonId", "RankingRuleVersion", "AccountProgressionMode" }) do
			if type(conditions[field]) ~= "string" or conditions[field] == "" or #conditions[field] > 64 then
				return { Success = false, Reason = "RUN_RESULT_CONDITION_INVALID", Field = field }
			end
		end
		return { Success = true, Reason = "OK" }
	end

	method string MakeRecordId(integer runId)
		-- JSON may restore integer-valued numbers as floats; IDs never depend on tostring formatting.
		return "run:" .. string.format("%.0f", runId)
	end

	method string FormatUtcTimestamp()
		-- ISO T/Z strings are auto-converted to unsupported Date tokens by MSW JSONDecode.
		return DateTime.UtcNow:ToFormattedString("yyyy-MM-dd HH:mm:ss.fff") .. " UTC"
	end

	method table ValidateRecord(table record)
		-- Validates the persisted DTO, not a live Component or a client-supplied score.
		if type(record) ~= "table" or (record.SchemaVersion ~= 1 and record.SchemaVersion ~= 2 and record.SchemaVersion ~= self.SchemaVersion) then
			return { Success = false, Reason = "RUN_RESULT_SCHEMA_UNSUPPORTED" }
		end
		for _, field in ipairs({ "RunId", "RunSequence", "RunSeed", "ConsumedTurns", "HitsTaken", "CompletedStageNumber" }) do
			local value = record[field]
			if type(value) ~= "number" or value ~= value or value < 0 or value > 9007199254740991 or value ~= math.floor(value) then
				return { Success = false, Reason = "RUN_RESULT_INVALID_INTEGER", Field = field }
			end
		end
		if record.AscensionLevel ~= nil and (type(record.AscensionLevel) ~= "number" or record.AscensionLevel ~= record.AscensionLevel
			or record.AscensionLevel < 0 or record.AscensionLevel > _AscensionDifficultyLogic.MaxLevel or record.AscensionLevel ~= math.floor(record.AscensionLevel)) then
			return { Success = false, Reason = "RUN_RESULT_INVALID_ASCENSION_LEVEL" }
		end
		if record.AscensionEligible ~= nil and type(record.AscensionEligible) ~= "boolean" then
			return { Success = false, Reason = "RUN_RESULT_INVALID_ASCENSION_ELIGIBILITY" }
		end
		if record.AscensionEligible == true and (record.AscensionLevel == nil or record.EndReason ~= "COMPLETED"
			or record.JobId == "" or record.RankExclusionReason == "PROTOTYPE_TEST" or record.RankExclusionReason == "SKILL_TEST"
			or record.RankExclusionReason == "RUN_START_UNOBSERVED") then
			return { Success = false, Reason = "RUN_RESULT_INVALID_ASCENSION_ELIGIBILITY" }
		end
		if record.RunId <= 0 or record.RunSequence <= 0 or record.RecordId ~= self:MakeRecordId(record.RunId) then
			return { Success = false, Reason = "RUN_RESULT_ID_INVALID" }
		end
		for _, field in ipairs({ "RecordId", "RuleVersion", "StartedAtUtc", "EndedAtUtc", "JobId", "NodeGraphId", "LastNodeId", "LastStageId", "RouteId", "EndReason", "RankExclusionReason" }) do
			if type(record[field]) ~= "string" or string.len(record[field]) > 100 then
				return { Success = false, Reason = "RUN_RESULT_INVALID_STRING", Field = field }
			end
		end
		if type(record.EndDetail) ~= "string" or string.len(record.EndDetail) > 160 then
			return { Success = false, Reason = "RUN_RESULT_INVALID_DETAIL" }
		end
		if record.RuleVersion == "" or record.StartedAtUtc == "" or record.EndedAtUtc == "" then
			return { Success = false, Reason = "RUN_RESULT_METADATA_MISSING" }
		end
		if record.EndReason ~= "COMPLETED" and record.EndReason ~= "DEFEATED" and record.EndReason ~= "ABANDONED" then
			return { Success = false, Reason = "RUN_RESULT_END_REASON_INVALID" }
		end
		for _, field in ipairs({ "ElapsedSeconds", "CurrentHp", "MaxHp" }) do
			local value = record[field]
			if type(value) ~= "number" or value ~= value or value < 0 or value >= math.huge then
				return { Success = false, Reason = "RUN_RESULT_INVALID_NUMBER", Field = field }
			end
		end
		if record.CurrentHp > record.MaxHp or type(record.RankEligible) ~= "boolean" then
			return { Success = false, Reason = "RUN_RESULT_STATE_INVALID" }
		end
		if record.RankEligible and (record.EndReason ~= "COMPLETED" or record.RankExclusionReason ~= "" or record.JobId == "") then
			return { Success = false, Reason = "RUN_RESULT_ELIGIBILITY_INVALID" }
		end
		if record.SchemaVersion >= 2 then
			if type(record.Build) ~= "table" or record.Build.Captured ~= true then
				return { Success = false, Reason = "RUN_RESULT_BUILD_MISSING" }
			end
			local buildValidation = _RunBuildSnapshotLogic:ValidateSnapshot(record.Build)
			if not buildValidation.Success then return buildValidation end
		end
		if record.SchemaVersion == self.SchemaVersion then
			local conditions = self:ValidateConditions(record.Conditions)
			if not conditions.Success then return conditions end
			local regions = _RunRegionHistoryContractLogic:ValidateSnapshot(record.RegionHistory)
			if not regions.Success then return regions end
			if record.RegionHistory.Captured ~= true or not _RunRegionHistoryContractLogic:IsCounter(record.ClearedBattleCount)
				or record.ClearedBattleCount ~= regions.ClearedBattleCount
				or regions.ConsumedTurns > record.ConsumedTurns or regions.HitsTaken > record.HitsTaken then
				return { Success = false, Reason = "RUN_RESULT_REGION_TOTAL_MISMATCH" }
			end
			if record.RankEligible and (not record.Conditions.ObservedStart or not record.RegionHistory.Complete or #record.RegionHistory.Visits == 0) then
				return { Success = false, Reason = "RUN_RESULT_ELIGIBILITY_INVALID" }
			end
		end
		return { Success = true, Reason = "OK", Record = record }
	end

	method table EncodeRecord(table record)
		-- Keeps the versioned JSON under one storage credit-sized value; rejects rather than truncating.
		if record == nil or record.SchemaVersion ~= self.SchemaVersion then
			return { Success = false, Reason = "RUN_RESULT_WRITE_SCHEMA_UNSUPPORTED" }
		end
		if record.AscensionLevel == nil or type(record.AscensionEligible) ~= "boolean" then
			return { Success = false, Reason = "RUN_RESULT_ASCENSION_METADATA_MISSING" }
		end
		local validation = self:ValidateRecord(record)
		if validation.Success == false then return validation end
		local stored = {}
		for key, value in pairs(record) do stored[key] = value end
		stored.Build = _RunBuildSnapshotLogic:ToStorageSnapshot(record.Build)
		stored.RegionHistory = _RunRegionHistoryContractLogic:ToStorageSnapshot(record.RegionHistory)
		local ok, encoded = pcall(function() return _HttpService:JSONEncode(stored) end)
		if ok == false or type(encoded) ~= "string" then
			return { Success = false, Reason = "RUN_RESULT_ENCODE_FAILED" }
		end
		if string.len(encoded) > self.MaxRecordBytes then
			return { Success = false, Reason = "RUN_RESULT_TOO_LARGE", Bytes = string.len(encoded) }
		end
		return { Success = true, Reason = "OK", Record = record, Json = encoded, Bytes = string.len(encoded) }
	end

	method table DecodeRecord(string encoded)
		-- Fails closed on corrupted or future schemas without replacing existing saved data.
		if encoded == nil or encoded == "" then return { Success = true, Reason = "NO_RUN_RESULT", HasRecord = false } end
		if string.len(encoded) > self.MaxRecordBytes then return { Success = false, Reason = "RUN_RESULT_TOO_LARGE" } end
		local ok, decoded = pcall(function() return _HttpService:JSONDecode(encoded) end)
		if ok == false or type(decoded) ~= "table" then return { Success = false, Reason = "RUN_RESULT_DECODE_FAILED" } end
		if (decoded.SchemaVersion == 2 or decoded.SchemaVersion == self.SchemaVersion) and type(decoded.Build) == "table" then
			decoded.Build = _RunBuildSnapshotLogic:FromStorageSnapshot(decoded.Build)
		end
		if decoded.SchemaVersion == self.SchemaVersion and type(decoded.RegionHistory) == "table" then
			decoded.RegionHistory = _RunRegionHistoryContractLogic:FromStorageSnapshot(decoded.RegionHistory)
		end
		local validation = self:ValidateRecord(decoded)
		if validation.Success and decoded.SchemaVersion == 1 then
			-- Normalize the read DTO only; keep the original JSON for repository CAS/deduplication.
			decoded.Build = _RunBuildSnapshotLogic:EmptySnapshot()
		end
		if validation.Success then
			if decoded.SchemaVersion < self.SchemaVersion then
				-- Older records have no trustworthy conditions or regional route; unknown clears stay unknown.
				decoded.Conditions = self:EmptyConditions()
				decoded.RegionHistory = _RunRegionHistoryContractLogic:EmptySnapshot()
				decoded.ClearedBattleCount = nil
			end
			-- Legacy records remain readable but never prove an ascension unlock.
			if decoded.AscensionLevel == nil then decoded.AscensionLevel = 0 end
			if decoded.AscensionEligible == nil then decoded.AscensionEligible = false end
		end
		validation.HasRecord = validation.Success
		validation.Json = encoded
		return validation
	end

end
