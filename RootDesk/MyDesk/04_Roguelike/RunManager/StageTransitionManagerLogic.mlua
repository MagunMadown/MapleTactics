@Logic
script StageTransitionManagerLogic extends Logic

	property integer NewSkillChoiceCount = 2
	property number CompletedRunLobbyDelay = 3.0
	property table PendingTransitions = {}
	
	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- Initializes the reward-stage transition adapter.
		self.PendingTransitions = {}
		log("[StageTransition] ready")
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- Cancels every delayed transfer before this world session ends.
		for _, pending in pairs(self.PendingTransitions) do
			if pending.TimerId > 0 then _TimerService:ClearTimer(pending.TimerId) end
		end
		self.PendingTransitions = {}
	end

	@ExecSpace("ServerOnly")
	method void CancelPendingTransition(Entity playerEntity, string reason)
		-- Invalidates a player's old reward or lobby timer before another flow takes ownership.
		if isvalid(playerEntity) == false or playerEntity.PlayerComponent == nil then return end
		local userId = playerEntity.PlayerComponent.UserId
		local pending = self.PendingTransitions[userId]
		if pending == nil then return end
		self.PendingTransitions[userId] = nil
		if pending.TimerId > 0 then _TimerService:ClearTimer(pending.TimerId) end
		log("[StageTransition] pending transfer cancelled user=" .. userId .. " reason=" .. (reason or "UNSPECIFIED"))
	end

	@ExecSpace("ServerOnly")
	method table CapturePendingTransition(Entity playerEntity, string reason)
		-- Captures the exact run, result, flow and map that authorize one delayed transition.
		if isvalid(playerEntity) == false or playerEntity.PlayerComponent == nil or isvalid(playerEntity.CurrentMap) == false then
			return { Success = false, Reason = "INVALID_TRANSITION_PLAYER" }
		end
		local runState = playerEntity:GetComponent("script.PlayerRunStateComponent")
		if runState == nil then return { Success = false, Reason = "RUN_STATE_UNAVAILABLE" } end
		self:CancelPendingTransition(playerEntity, reason)
		local entryState = playerEntity:GetComponent("script.BattleEntryStateComponent")
		local pending = {
			Success = true, PlayerEntity = playerEntity, UserId = playerEntity.PlayerComponent.UserId,
			SourceMap = playerEntity.CurrentMap, TimerId = 0,
			RunSequence = runState.RunSequence, RunState = runState.RunState,
			RunFlowState = runState.RunFlowState, RunFlowRevision = runState.RunFlowRevision,
			LastBattleRecordKey = runState.LastBattleRecordKey, LastCompletedStageId = runState.LastCompletedStageId,
			PendingNextStageMapName = runState.PendingNextStageMapName,
			EntryRequestId = entryState ~= nil and entryState.RequestId or -1
		}
		self.PendingTransitions[pending.UserId] = pending
		return pending
	end

	@ExecSpace("ServerOnly")
	method boolean IsPendingTransitionCurrent(table pending)
		-- Rejects cancelled timers and snapshots changed by abandoning, restarting or leaving the source map.
		if self.PendingTransitions[pending.UserId] ~= pending then return false end
		local playerEntity = pending.PlayerEntity
		if isvalid(playerEntity) == false or isvalid(pending.SourceMap) == false or playerEntity.CurrentMap ~= pending.SourceMap then return false end
		local runState = playerEntity:GetComponent("script.PlayerRunStateComponent")
		if runState == nil or runState.RunSequence ~= pending.RunSequence or runState.RunState ~= pending.RunState then return false end
		if runState.RunFlowState ~= pending.RunFlowState or runState.RunFlowRevision ~= pending.RunFlowRevision then return false end
		if runState.LastBattleRecordKey ~= pending.LastBattleRecordKey or runState.LastCompletedStageId ~= pending.LastCompletedStageId then return false end
		if runState.PendingNextStageMapName ~= pending.PendingNextStageMapName then return false end
		local entryState = playerEntity:GetComponent("script.BattleEntryStateComponent")
		local entryRequestId = entryState ~= nil and entryState.RequestId or -1
		return entryRequestId == pending.EntryRequestId
	end

	@ExecSpace("ServerOnly")
	method void HandleVictoryTransition(Entity playerEntity, string clearedStageId)
		-- Stores the next Stage map and moves the player through the configured reward map.
		if isvalid(playerEntity) == false then
			log_warning("[StageTransition] victory transition rejected reason=INVALID_PLAYER stage=" .. clearedStageId)
			return
		end
		self:CancelPendingTransition(playerEntity, "VICTORY_TRANSITION")
		local runFlow = _RunManagerLogic:GetRunFlowSnapshot(playerEntity)
		if self:IsShopChoiceFlow(runFlow) then
			log("[StageTransition] shop choice ready stage=" .. clearedStageId .. " nodes=" .. runFlow.AvailableNodeIds)
			self:OpenShopChoiceWorldMap("BOSS_CLEAR", clearedStageId, playerEntity.PlayerComponent.UserId)
			return
		end
		local graphTransition = self:ResolveGraphTransition(clearedStageId)
		if graphTransition.Success == false then
			log("[StageTransition] no graph transition current=" .. clearedStageId .. " reason=" .. graphTransition.Reason)
			return
		end
		local rewardMap = self:DetermineIntermediateMap(playerEntity, clearedStageId)
		if rewardMap == "" then
			log_warning("[StageTransition] reward map unresolved stage=" .. clearedStageId)
			return
		end
		local nextStageMap = graphTransition.NextShopMapId or ""
		if graphTransition.NextBattleStageId ~= "" then
			local nextStageRoute = _StageMapRouteRepositoryLogic:GetMapRoute(graphTransition.NextBattleStageId)
			if nextStageRoute == nil or nextStageRoute.Success ~= true then
				local reason = nextStageRoute == nil and "STAGE_MAP_ROUTE_RESULT_MISSING" or nextStageRoute.Reason
				log_warning("[StageTransition] next stage route missing stage=" .. graphTransition.NextBattleStageId .. " reason=" .. reason)
				return
			else
				nextStageMap = nextStageRoute.MapId
			end
		end
		if graphTransition.NextBattleStageId ~= "" then
			local prepareResult = self:PrepareNextBattleEntry(playerEntity, graphTransition.NextBattleStageId)
			if prepareResult.Success ~= true then
				log_warning("[StageTransition] next battle entry prepare failed stage=" .. graphTransition.NextBattleStageId .. " reason=" .. prepareResult.Reason)
				return
			end
		end
		self:StoreNextStageMapForPlayer(playerEntity, nextStageMap)
		log("[StageTransition] victory current=" .. clearedStageId .. " rewardNode=" .. graphTransition.RewardNodeId .. " next=" .. graphTransition.NextBattleStageId .. " nextMap=" .. nextStageMap .. " rewardMap=" .. rewardMap)
		local pending = self:CapturePendingTransition(playerEntity, "VICTORY_REWARD")
		if pending.Success == false then return end
		local targetMap = rewardMap
		local transferReward = function()
			if self:IsPendingTransitionCurrent(pending) == false then
				if self.PendingTransitions[pending.UserId] == pending then self.PendingTransitions[pending.UserId] = nil end
				log("[StageTransition] stale reward transfer ignored user=" .. pending.UserId)
				return
			end
			self.PendingTransitions[pending.UserId] = nil
			log("[StageTransition] teleporting player=" .. playerEntity.Name .. " rewardMap=" .. targetMap)
			_MapTeleportManager:TeleportPlayer(playerEntity, targetMap, Vector3(0, 0.5, 0), "VICTORY_REWARD")
		end
		pending.TimerId = _TimerService:SetTimerOnce(transferReward, 1.5)
		if pending.TimerId == 0 then transferReward() end
	end

	@ExecSpace("ServerOnly")
	method void HandleCompletedRunTransition(Entity playerEntity)
		-- Leaves the existing result panel visible briefly, then returns the completed run to the lobby.
		if isvalid(playerEntity) == false then
			log_warning("[StageTransition] completed run transition rejected reason=INVALID_PLAYER")
			return
		end
		local runState = playerEntity:GetComponent("script.PlayerRunStateComponent")
		if runState == nil or runState.RunState ~= "Completed" then
			log_warning("[StageTransition] completed run transition rejected reason=RUN_NOT_COMPLETED")
			return
		end
		local pending = self:CapturePendingTransition(playerEntity, "RUN_COMPLETED_RETURN")
		if pending.Success == false then return end
		local returnCompletedRun = function()
			if self:IsPendingTransitionCurrent(pending) == false then
				if self.PendingTransitions[pending.UserId] == pending then self.PendingTransitions[pending.UserId] = nil end
				log("[StageTransition] stale completed-run transfer ignored user=" .. pending.UserId)
				return
			end
			self.PendingTransitions[pending.UserId] = nil
			local entryState = _BattleGatewayLogic:GetOrCreateEntryState(playerEntity)
			if entryState ~= nil then entryState:ResetToIdle("RUN_COMPLETED_RETURN") end
			_MapTeleportManager:TeleportPlayer(playerEntity, "lobby", Vector3(-27.3686, -7.92, 0), "RUN_COMPLETED_RETURN")
			log("[StageTransition] completed run returned player=" .. playerEntity.Name .. " sequence=" .. pending.RunSequence .. " destination=lobby")
		end
		pending.TimerId = _TimerService:SetTimerOnce(returnCompletedRun, math.max(1.5, self.CompletedRunLobbyDelay))
		if pending.TimerId == 0 then returnCompletedRun() end
	end

	@ExecSpace("ServerOnly")
	method boolean IsShopChoiceFlow(table runFlow)
		-- A single next shop also requires explicit selection on the world map.
		if runFlow == nil or runFlow.Success ~= true or runFlow.RunFlowState ~= "AWAITING_NODE_SELECTION" then
			return false
		end
		local count = 0
		for contentType in string.gmatch(runFlow.AvailableContentTypes or "", "([^|]+)") do
			if contentType ~= "SHOP" then
				return false
			end
			count = count + 1
		end
		return count >= 1
	end

	@ExecSpace("Client")
	method void OpenShopChoiceWorldMap(string source, string clearedStageId)
		-- Send the cleared region explicitly so UI does not depend on Sync/RPC arrival order.
		local uiRoot = _EntityService:GetEntityByPath("/ui/DefaultGroup")
		if isvalid(uiRoot) == false then
			log_warning("[StageTransition] shop choice UI root missing")
			return
		end
		local minimap = uiRoot:GetComponent("script.MinimapUI")
		if minimap == nil then
			log_warning("[StageTransition] shop choice minimap component missing")
			return
		end
		minimap:OpenWorldMapMode("SHOP_CHOICE", source, clearedStageId)
	end

	@ExecSpace("ServerOnly")
	method table PrepareNextBattleEntry(Entity playerEntity, string nextStageId)
		-- Keeps the exact StageId across reward maps. This is required when multiple
		-- stages reuse one physical battle map because the map name cannot identify
		-- which dataset must be loaded on re-entry.
		if isvalid(playerEntity) == false or nextStageId == nil or nextStageId == "" then
			return { Success = false, Reason = "INVALID_NEXT_BATTLE_ENTRY" }
		end
		local runState = playerEntity:GetComponent("script.PlayerRunStateComponent")
		if runState == nil or runState.RunState ~= "Active" then
			return { Success = false, Reason = "ACTIVE_RUN_STATE_UNAVAILABLE" }
		end
		local entryState = playerEntity:GetComponent("script.BattleEntryStateComponent")
		local characterId = ""
		local loadoutId = ""
		if entryState ~= nil then
			characterId = entryState.CharacterId or ""
			loadoutId = entryState.LoadoutId or ""
		end
		local result = _BattleGatewayLogic:PrepareBattleEntry(
			playerEntity,
			nextStageId,
			characterId,
			runState.SelectedJobId,
			loadoutId,
			runState.RunSeed,
			"CONTINUE_RUN"
		)
		if result.Success == true then
			log("[StageTransition] next battle entry prepared stage=" .. nextStageId .. " request=" .. result.RequestId)
		end
		return result
	end

	@ExecSpace("ServerOnly")
	method table ResolveGraphTransition(string clearedStageId)
		-- Resolves the required battle-to-reward-to-battle chain from NodeDefinitions.
		local currentBattle = _NodeDefinitionRepositoryLogic:FindNodeByStageId(clearedStageId)
		if currentBattle.Success == false then
			return { Success = false, Reason = currentBattle.Reason or "CURRENT_BATTLE_NODE_NOT_FOUND" }
		end
		local rewardNodeId = self:GetSingleNextNodeId(currentBattle.NextNodeIds)
		if rewardNodeId == "" then
			return { Success = false, Reason = "REWARD_NODE_NOT_CONFIGURED" }
		end
		local rewardNode = _NodeDefinitionRepositoryLogic:GetNodeDefinition(currentBattle.NodeGraphId, rewardNodeId)
		if rewardNode.Success == false then
			return { Success = false, Reason = rewardNode.Reason or "REWARD_NODE_NOT_FOUND" }
		end
		if rewardNode.NodeType ~= "REST" then
			return { Success = false, Reason = "REWARD_NODE_TYPE_INVALID", RewardNodeId = rewardNode.NodeId }
		end
		if rewardNode.NextNodeIds == nil or rewardNode.NextNodeIds == "" then
			return {
				Success = true,
				Reason = "TERMINAL_REWARD_NODE",
				NodeGraphId = currentBattle.NodeGraphId,
				RewardNodeId = rewardNode.NodeId,
				NextBattleNodeId = "",
				NextBattleStageId = ""
			}
		end
		local nextBattleNodeId = self:GetSingleNextNodeId(rewardNode.NextNodeIds)
		if nextBattleNodeId == "" then
			return { Success = false, Reason = "NEXT_BATTLE_NODE_NOT_CONFIGURED", RewardNodeId = rewardNode.NodeId }
		end
		local nextBattle = _NodeDefinitionRepositoryLogic:GetNodeDefinition(currentBattle.NodeGraphId, nextBattleNodeId)
		if nextBattle.Success == false then
			return { Success = false, Reason = nextBattle.Reason or "NEXT_BATTLE_NODE_NOT_FOUND" }
		end
		if nextBattle.NodeType == "SHOP" then
			local binding = _ShopNodeBindingRepositoryLogic:GetBinding(currentBattle.NodeGraphId, nextBattle.NodeId)
			if binding.Success == false then return binding end
			local bundle = _ShopDefinitionRepositoryLogic:GetShopBundle(binding.ShopId)
			if bundle.Success == false then return bundle end
			return { Success = true, Reason = "REWARD_THEN_SHOP", NodeGraphId = currentBattle.NodeGraphId,
				RewardNodeId = rewardNode.NodeId, NextBattleNodeId = "", NextBattleStageId = "", NextShopMapId = _ShopDefinitionRepositoryLogic:GetMapIdForNode(bundle.Definition, nextBattle.NodeId) }
		end
		if nextBattle.NodeType ~= "BATTLE" and nextBattle.NodeType ~= "BOSS" then
			return { Success = false, Reason = "NEXT_NODE_NOT_BATTLE", NextNodeId = nextBattle.NodeId }
		end
		return {
			Success = true,
			Reason = "OK",
			NodeGraphId = currentBattle.NodeGraphId,
			RewardNodeId = rewardNode.NodeId,
			NextBattleNodeId = nextBattle.NodeId,
			NextBattleStageId = nextBattle.StageId
		}
	end

	method string GetSingleNextNodeId(string nextNodeIds)
		-- Returns one configured next node and rejects empty or branching transition chains.
		local resolvedNodeId = ""
		local count = 0
		for nodeId in string.gmatch(nextNodeIds or "", "([^|]+)") do
			count = count + 1
			resolvedNodeId = nodeId
		end
		if count ~= 1 then
			return ""
		end
		return resolvedNodeId
	end
	
	@ExecSpace("ServerOnly")
	method string DetermineIntermediateMap(Entity playerEntity, string clearedStageId)
		-- Recheck current ownership on every reward; selling/removing a skill reopens new-skill offers.
		local inventory = isvalid(playerEntity) and playerEntity:GetComponent("script.PlayerRunInventoryComponent") or nil
		if inventory ~= nil and #inventory:GetDistinctOwnedSkillIds() >= inventory.RunSkillBarSlotCount then
			log("[StageTransition] new skill stage skipped reason=SKILL_SLOTS_FULL stage=" .. clearedStageId .. " -> new_upgrade_stage")
			return "new_upgrade_stage"
		end
		-- Returns the intermediate map while shrinking new-skill choices to the available candidate count.
		-- henesys_stage_01 (henesys_battle map) -> always new_skill_stage
		-- otherwise -> 75% new_upgrade_stage, 25% new_skill_stage
		local availableCount = self:GetUnownedJobSkillCount(playerEntity)
		local choiceCount = math.min(math.max(1, self.NewSkillChoiceCount), availableCount)
		if clearedStageId == "henesys_stage_01" then
			if choiceCount > 0 then
				log("[StageTransition] first clear reward fixed stage=" .. clearedStageId .. " available=" .. availableCount .. " choices=" .. choiceCount .. " -> new_skill_stage")
				return "new_skill_stage"
			end
			log("[StageTransition] first clear new skill unavailable stage=" .. clearedStageId .. " -> new_upgrade_stage")
			return "new_upgrade_stage"
		end
		if choiceCount <= 0 then
			log("[StageTransition] new skill stage skipped reason=INSUFFICIENT_UNOWNED_JOB_SKILLS stage=" .. clearedStageId .. " -> new_upgrade_stage")
			return "new_upgrade_stage"
		end
		if clearedStageId ~= "" then
			local roll = math.random(1, 100)
			if roll <= 25 then
				log("[StageTransition] " .. clearedStageId .. " roll=" .. roll .. " -> new_upgrade_stage")
				return "new_upgrade_stage"
			else
				log("[StageTransition] " .. clearedStageId .. " roll=" .. roll .. " -> new_skill_stage")
				return "new_skill_stage"
			end
		end
		return ""
	end

	@ExecSpace("ServerOnly")
	method integer GetUnownedJobSkillCount(Entity playerEntity)
		-- Counts every unowned tier-1 skill so the reward map can expose only valid choice slots.
		if isvalid(playerEntity) == false then
			return 0
		end
		local runState = playerEntity:GetComponent("script.PlayerRunStateComponent")
		local inventory = playerEntity:GetComponent("script.PlayerRunInventoryComponent")
		if runState == nil or runState.SelectedJobId == "" or inventory == nil then
			return 0
		end
		local catalog = _SkillDefinitionRepositoryLogic:GetJobSkillDefinitions(runState.SelectedJobId)
		if catalog.Success == false then
			return 0
		end
		local availableCount = 0
		for _, definition in ipairs(catalog.Skills) do
			local ownsSkillFamily = inventory:HasOwnedSkillInFamily(definition.SkillId, catalog.Skills)
			if definition.SkillTier == 1 and ownsSkillFamily == false then
				availableCount = availableCount + 1
			end
		end
		log("[StageTransition] new skill candidates mode=FAMILY_AWARE job=" .. runState.SelectedJobId .. " available=" .. availableCount .. " maxChoices=" .. self.NewSkillChoiceCount .. " owned=" .. inventory.RunSkillSnapshot)
		return availableCount
	end
	
	@ExecSpace("ServerOnly")
	method void StoreNextStageMapForPlayer(Entity playerEntity, string nextStageMapName)
		-- Stores only a route-resolved map name so consumers never treat a StageId as a MapId.
		if isvalid(playerEntity) == false then
			return
		end
		
		local runState = playerEntity:GetComponent("script.PlayerRunStateComponent")
		if runState ~= nil then
			runState.PendingNextStageMapName = nextStageMapName
			log("[StageTransition] stored nextMap=" .. nextStageMapName .. " on player=" .. playerEntity.Name)
			return
		end
		
		log_warning("[StageTransition] PlayerRunStateComponent not found, storing as tag")
	end
	
	@ExecSpace("ServerOnly")
	method string GetNextStageMapNameForPlayer(Entity playerEntity)
		-- Reads the stored route, recovering it from the already prepared battle entry when needed.
		if isvalid(playerEntity) == false then
			return ""
		end
		
		local runState = playerEntity:GetComponent("script.PlayerRunStateComponent")
		if runState ~= nil and runState.PendingNextStageMapName ~= nil and runState.PendingNextStageMapName ~= "" then
			return runState.PendingNextStageMapName
		end

		local entryState = playerEntity:GetComponent("script.BattleEntryStateComponent")
		if entryState == nil or entryState.EntryState ~= "PREPARED" or entryState.StageId == nil or entryState.StageId == "" then
			return ""
		end
		local recoveredRoute = _StageMapRouteRepositoryLogic:GetMapRoute(entryState.StageId)
		if recoveredRoute == nil or recoveredRoute.Success ~= true or recoveredRoute.MapId == "" then
			local reason = recoveredRoute == nil and "STAGE_MAP_ROUTE_RESULT_MISSING" or recoveredRoute.Reason
			log_warning("[StageTransition] pending next map recovery failed stage=" .. entryState.StageId .. " reason=" .. reason)
			return ""
		end
		if runState ~= nil then
			runState.PendingNextStageMapName = recoveredRoute.MapId
		end
		log("[StageTransition] pending next map recovered stage=" .. entryState.StageId .. " map=" .. recoveredRoute.MapId)
		return recoveredRoute.MapId
		
	end
	
	@ExecSpace("ServerOnly")
	method table EnterRewardShop(Entity playerEntity)
		local run = _RunManagerLogic:GetOrCreateRunState(playerEntity)
		if run == nil or run.RunState ~= "Active" then return { Success = false, Reason = "ACTIVE_RUN_REQUIRED" } end
		local route = self:ResolveGraphTransition(run.LastCompletedStageId)
		if route.Success ~= true or (route.NextShopMapId or "") == "" then return { Success = false, Reason = "REWARD_SHOP_NOT_CONFIGURED" } end
		if run.SelectedContentType == "SHOP" and run.ContentTransitionState == "READY" then
			return _RunContentMapTransitionAdapterLogic:ConsumeSelectedShop(playerEntity)
		end
		if run.AvailableNodeIds == route.RewardNodeId then
			local selected = _RunManagerLogic:SelectNextContent(playerEntity, route.RewardNodeId, 9000000 + run.RunFlowRevision)
			if selected.Success == false then return selected end
		end
		if run.SelectedNodeId == route.RewardNodeId and run.SelectedContentType == "REST" then
			local completed = _RunManagerLogic:CompleteCurrentContent(playerEntity, "REST", 9000000 + run.RunFlowRevision)
			if completed.Success == false then return completed end
		end
		local reward = _NodeDefinitionRepositoryLogic:GetNodeDefinition(route.NodeGraphId, route.RewardNodeId)
		local shopNodeId = self:GetSingleNextNodeId(reward.NextNodeIds)
		local selected = _RunManagerLogic:SelectNextContent(playerEntity, shopNodeId, 9000000 + run.RunFlowRevision)
		if selected.Success == false then return selected end
		return _RunContentMapTransitionAdapterLogic:ConsumeSelectedShop(playerEntity)
	end

end
