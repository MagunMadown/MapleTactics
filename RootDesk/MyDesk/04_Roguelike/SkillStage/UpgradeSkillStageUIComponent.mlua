	@ExecSpace("ClientOnly")
	method void ReleasePreviewFit(Entity preview)
		-- Cancels a pending load and removes the previous frame callback.
		local fits = self._T.PreviewFits
		if fits == nil or not isvalid(preview) then return end
		local state = fits[preview.Id]
		if state == nil then return end
		fits[preview.Id] = nil
		if state.eventHandler ~= nil then
			preview:DisconnectEvent(SpriteGUIAnimPlayerChangeFrameEvent, state.eventHandler)
		end
		preview.UITransformComponent.RectSize = state.box
	end

	@ExecSpace("ClientOnly")
	method void ClearPreviewFits()
		-- Releases frame callbacks and invalidates loads on close or play shutdown.
		for _, state in pairs(self._T.PreviewFits or {}) do
			if isvalid(state.entity) then
				if state.eventHandler ~= nil then
					state.entity:DisconnectEvent(SpriteGUIAnimPlayerChangeFrameEvent, state.eventHandler)
				end
				state.entity.UITransformComponent.RectSize = state.box
			end
		end
		self._T.PreviewFits = {}
	end

	@ExecSpace("ClientOnly")
	method void SetPreviewThumbnail(Entity preview, string ruid)
		-- Restores the full preview box when leaving animation playback.
		self:ReleasePreviewFit(preview)
		local renderer = preview.SpriteGUIRendererComponent
		renderer.Type = ImageType.Simple
		renderer.PreserveSprite = PreserveSpriteType.AspectOnly
		renderer.LocalPosition = Vector2(0, 0)
		renderer.LocalScale = Vector2(1, 1)
		renderer.Color = Color(1, 1, 1, 1)
		renderer.ImageRUID = DataRef("thumbnail://" .. ruid)
		preview.Enable = true
	end

	@ExecSpace("ClientOnly")
	method void PlayFittedPreview(Entity preview, string ruid, boolean trimLastFrame)
		-- Fits all animation frames at one scale; world pivots cannot push UI art into the mask.
		self:ReleasePreviewFit(preview)
		self._T.PreviewFits = self._T.PreviewFits or {}
		self._T.PreviewSizes = self._T.PreviewSizes or {}
		local state = { entity = preview, box = preview.UITransformComponent.RectSize }
		local cacheKey = ruid .. ":" .. tostring(trimLastFrame == true)
		self._T.PreviewFits[preview.Id] = state
		preview.Enable = false
		_ResourceService:PreloadAsync({ruid}, function()
			if not isvalid(preview) or self._T.PreviewFits[preview.Id] ~= state then return end
			local sizes = self._T.PreviewSizes[cacheKey]
			if sizes == nil then
				local ok, clip = pcall(function() return _ResourceService:LoadAnimationClipAndWait(ruid) end)
				if ok and clip ~= nil and clip.IsLoadComplete then
					sizes = self:BuildPreviewFrameSizes(clip, trimLastFrame)
					if sizes ~= nil and sizes.width > 0 and sizes.height > 0 then
						self._T.PreviewSizes[cacheKey] = sizes
					else
						sizes = nil
					end
				end
			end
			-- Resource waits can resume after a different skill, hover exit or map change.
			if not isvalid(preview) or self._T.PreviewFits[preview.Id] ~= state then return end
			if sizes == nil or sizes.frames[0] == nil then
				log_warning("[SkillPreviewFit] metadata unavailable; thumbnail fallback ruid=" .. ruid)
				self:SetPreviewThumbnail(preview, ruid)
				return
			end
			local scale = math.min(state.box.x / sizes.width, state.box.y / sizes.height)
			local applyFrame = function(frameIndex)
				if not isvalid(preview) or self._T.PreviewFits[preview.Id] ~= state then return end
				local size = sizes.frames[frameIndex]
				if size ~= nil then
					preview.UITransformComponent.RectSize = Vector2(size.x * scale, size.y * scale)
				end
			end
			local renderer = preview.SpriteGUIRendererComponent
			renderer.Type = ImageType.Simple
			-- None ignores sprite pivots; each frame's rect already preserves its native aspect.
			renderer.PreserveSprite = PreserveSpriteType.None
			renderer.LocalPosition = Vector2(0, 0)
			renderer.LocalScale = Vector2(1, 1)
			renderer.Color = Color(1, 1, 1, 1)
			renderer.StartFrameIndex = 0
			renderer.EndFrameIndex = sizes.endFrame
			renderer.AnimClipPlayType = SpriteAnimClipPlayType.Loop
			renderer.PlayRate = 1
			state.eventHandler = preview:ConnectEvent(SpriteGUIAnimPlayerChangeFrameEvent, function(event)
				applyFrame(event.FrameIndex)
		end)
		applyFrame(0)
		renderer.ImageRUID = DataRef(ruid)
		preview.Enable = true
		log("[SkillPreviewFit] ruid=" .. ruid .. " bounds=" .. tostring(sizes.width) .. "x" .. tostring(sizes.height) .. " scale=" .. tostring(scale))
		end)
	end

	@ExecSpace("ClientOnly")
	method any BuildPreviewFrameSizes(any clip, boolean trimLastFrame)
		-- Explosion's reported white terminal frame is excluded from playback and fitting, only in this UI.
		local frames = clip.Frames:ToTable()
		local lastFrame = -1
		for _, frame in ipairs(frames) do lastFrame = math.max(lastFrame, frame.FrameIndex) end
		if lastFrame < 0 then return nil end
		local endFrame = trimLastFrame and math.max(0, lastFrame - 1) or lastFrame
		local sizes = { width = 0, height = 0, frames = {}, endFrame = endFrame }
		for _, frame in ipairs(frames) do
			if frame.FrameIndex <= endFrame then
				local sprite = frame.FrameSprite
				if sprite == nil or not sprite.IsLoadComplete or sprite.Width <= 0 or sprite.Height <= 0 then return nil end
				sizes.frames[frame.FrameIndex] = Vector2(sprite.Width, sprite.Height)
				sizes.width = math.max(sizes.width, sprite.Width)
				sizes.height = math.max(sizes.height, sprite.Height)
			end
		end
		return sizes
	end

	method boolean IsHiddenOffer(string token)
		return string.match(token or "", "~hidden_[%w_]+$") ~= nil
	end

	@ExecSpace("ClientOnly")
	method void SetHiddenGlow(Entity card, boolean active)
		if not isvalid(card) then return end
		local root = card:GetChildByName("HiddenGlow")
		if not isvalid(root) then return end
		root.Enable = active
		self._T.HiddenGlowViews = self._T.HiddenGlowViews or {}
		if not active then self._T.HiddenGlowViews[card.Id] = nil; return end
		if self._T.HiddenGlowViews[card.Id] ~= nil then return end
		local view = { Root = root, Card = card, Edges = {}, Sparks = {} }
		for layer = 1, 3 do
			for edge = 1, 4 do
				local entity = root:GetChildByName("Edge" .. layer .. "_" .. edge)
				if isvalid(entity) then table.insert(view.Edges, { Renderer = entity.SpriteGUIRendererComponent, Layer = layer, Edge = edge }) end
			end
		end
		for index = 1, 4 do
			local spark = root:GetChildByName("Spark" .. index)
			if isvalid(spark) then
				table.insert(view.Sparks, { Entity = spark, H = spark:GetChildByName("H"), V = spark:GetChildByName("V"), Halo = spark:GetChildByName("Halo") })
			end
		end
		self._T.HiddenGlowViews[card.Id] = view
		log("[HiddenAugmentGlow] enabled card=" .. card.Name)
	end

	@ExecSpace("ClientOnly")
	method void ClearHiddenGlow()
		for _, view in pairs(self._T.HiddenGlowViews or {}) do
			if isvalid(view.Root) then view.Root.Enable = false end
		end
		self._T.HiddenGlowViews = {}
		self._T.HiddenGlowTime = 0
	end

	method Vector2 HiddenBorderPoint(number distance, number width, number height)
		local d = distance % (2 * (width + height))
		if d < width then return Vector2(-width / 2 + d, height / 2) end
		d = d - width
		if d < height then return Vector2(width / 2, height / 2 - d) end
		d = d - height
		if d < width then return Vector2(width / 2 - d, -height / 2) end
		return Vector2(-width / 2, -height / 2 + d - width)
	end

	@ExecSpace("ClientOnly")
	method void AnimateHiddenGlow(number delta)
		-- Only four bounded, non-interactive overlay groups; no timers, allocations of entities or resource loads per frame.
		local time = (self._T.HiddenGlowTime or 0) + math.max(0, delta)
		self._T.HiddenGlowTime = time
		for _, view in pairs(self._T.HiddenGlowViews or {}) do
			if isvalid(view.Root) and isvalid(view.Card) and view.Card.Enable then
				local pulse = 0.5 + 0.5 * math.sin(time * 2.4)
				for _, edge in ipairs(view.Edges) do
					local shift = 0.5 + 0.5 * math.sin(time * 1.5 + edge.Edge * 1.4)
					if edge.Layer == 3 then
						edge.Renderer.Color = Color(1, 0.87 + pulse * 0.12, 0.46 + pulse * 0.28, 1)
					else
						local alpha = edge.Layer == 1 and (0.10 + pulse * 0.08) or (0.28 + pulse * 0.14)
						edge.Renderer.Color = Color(0.50 + shift * 0.45, 0.65 + (1 - shift) * 0.3, 1, alpha)
					end
				end
				local size = view.Card.UITransformComponent.RectSize
				local perimeter = 2 * (size.x + size.y)
				for index, spark in ipairs(view.Sparks) do
					local twinkle = 0.5 + 0.5 * math.sin(time * 4 + index * 2.2)
					spark.Entity.UITransformComponent.anchoredPosition = self:HiddenBorderPoint(time * 105 + perimeter * (index - 1) / 4, size.x, size.y)
					local length = 12 + twinkle * 16
					spark.H.UITransformComponent.RectSize = Vector2(length, 2)
					spark.V.UITransformComponent.RectSize = Vector2(2, length)
					spark.H.SpriteGUIRendererComponent.Color = Color(1, 0.97, 0.8, 0.6 + twinkle * 0.4)
					spark.V.SpriteGUIRendererComponent.Color = Color(1, 0.97, 0.8, 0.6 + twinkle * 0.4)
					spark.Halo.SpriteGUIRendererComponent.Color = Color(0.72, 0.82, 1, 0.10 + twinkle * 0.16)
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void ConnectRerollButtons()
		self._T.RerollBindings = {}
		local cards = { self.SkillButton1.Entity, self.SkillButton2.Entity, self.SkillButton3.Entity }
		for index, card in ipairs(cards) do
			local button = card:GetChildByName("Reroll")
			if isvalid(button) then
				local slot = index
				local handler = button:ConnectEvent(ButtonClickEvent, function() self:RequestSlotReroll(slot) end)
				table.insert(self._T.RerollBindings, { Entity = button, Handler = handler })
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshRerollButtons()
		for _, binding in ipairs(self._T.RerollBindings or {}) do
			if isvalid(binding.Entity) then
				local enabled = self._T.RerollReady == true and not self._T.RerollPending and not self.ApplyLocked and (self._T.RerollCount or 0) > 0
				binding.Entity.ButtonComponent.Enable = enabled
				binding.Entity.SpriteGUIRendererComponent.Color = enabled and Color(0.08, 0.47, 0.54, 1) or Color(0.12, 0.15, 0.20, 1)
				binding.Entity.TextGUIRendererComponent.FontColor = enabled and Color(0.83, 1, 0.96, 1) or Color(0.35, 0.40, 0.46, 1)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void ReceiveRerollInfo(integer count, integer revision, string reason)
		self._T.RerollCount = math.max(0, count)
		self._T.RerollRevision = revision
		self._T.RerollReady = revision >= 0
		self._T.RerollPending = false
		self.RerollCountText.Entity.Enable = false
		self:RefreshRerollButtons()
		if reason == "REROLLED" then self.StatusText.Text = "선택지 1개 새로고침 · 리롤 1회 사용"
		elseif reason == "ONLY_SAME_CANDIDATE" then self.StatusText.Text = "다른 후보가 없어 선택지 유지 · 리롤 1회 사용"
		elseif reason == "NO_REROLLS" then self.StatusText.Text = "남은 리롤권이 없습니다"
		elseif reason == "STALE_OFFER" then _UpgradeSkillStageLogic:RequestUpgradeState()
		elseif reason ~= "OK" then self.StatusText.Text = "새로고침 실패: " .. reason end
	end

	@ExecSpace("ClientOnly")
	method void RequestSlotReroll(integer slotIndex)
		if self.ApplyLocked or self._T.RerollPending or not self._T.RerollReady or (self._T.RerollCount or 0) <= 0 then return end
		local token = self:GetToken(self.SkillIds, slotIndex)
		if token == "" then return end
		self._T.RerollPending = true
		self:RefreshRerollButtons()
		self.StatusText.Text = "선택지 새로고침 중..."
		_UpgradeSkillStageLogic:RequestReroll(slotIndex, self._T.RerollRevision or 0, token)
	end

end
