@Component
script UpgradeSkillStageUIComponent extends Component

	property Entity PanelEntity = "51c81f28-bd4a-4ecd-bbc5-bc6364ef70e4"
	property TextGUIRendererComponent StatusText = "5873ec4b-67c6-44b9-afa3-1036b413cbb9"
	property Entity BeforeInfoPanel = "1f3b2290-1e43-45f9-b3e7-7afecced57cb"
	property Entity AfterInfoPanel = "280fb1ed-0bef-48de-8dac-8d5186f58895"
	property Entity ComparisonArrow = "86a51d34-6fc8-49e7-9e31-8e619ac34fa5"
	property SpriteGUIRendererComponent BeforeInfoIcon = "338d77c5-0979-4dce-bd6b-bcca6c6711c7"
	property SpriteGUIRendererComponent AfterInfoIcon = "5c480310-ae13-4fe8-b69d-9467df5871b8"
	property TextGUIRendererComponent BeforeInfoText = "65aa5675-c457-4520-a37f-230f5366a410"
	property TextGUIRendererComponent AfterInfoText = "873384ce-9bc0-4835-a005-054c1a48bc91"
	property ButtonComponent ApplyButton = "e777687c-ef37-4ea2-b87a-3a7749443a8e"
	property TextGUIRendererComponent ApplyButtonText = "e777687c-ef37-4ea2-b87a-3a7749443a8e"
	property string ApplyButtonUpgradeText = "이 스킬 강화"
	property string ApplyButtonSkipText = "넘어가기"
	property ButtonComponent SkillButton1 = "70766df0-f3e3-42e8-8fbb-0380f37454ce"
	property ButtonComponent SkillButton2 = "b4caf6c5-44ba-44eb-9a97-76786be7707c"
	property ButtonComponent SkillButton3 = "3bc90b1f-c2db-4b70-afbf-3512081129ad"
	property ButtonComponent SkillButton4 = "d7e17bac-d577-42d3-a40a-8ff3a87c7018"
	property ButtonComponent SkillButton5 = "96f43627-46e6-4ca4-931c-dc9123625892"
	property ButtonComponent SkillButton6 = "729df355-8736-4da5-8eb0-fa71b8208d74"
	property SpriteGUIRendererComponent SkillIcon1 = "2e296716-2fa5-4b07-b191-5e51303e1daf"
	property SpriteGUIRendererComponent SkillIcon2 = "defaf195-5162-4a37-9bf4-b68534634271"
	property SpriteGUIRendererComponent SkillIcon3 = "4fec1d82-10d5-4df7-96cd-2acb898bcd6a"
	property SpriteGUIRendererComponent SkillIcon4 = "59cdaf44-622c-47e2-8aa5-14614eadce7e"
	property SpriteGUIRendererComponent SkillIcon5 = "0deff904-779e-407b-a788-162b5e23fb61"
	property SpriteGUIRendererComponent SkillIcon6 = "eca9b1fe-088b-4d25-bdb5-03e9b4da86e5"
	property TextGUIRendererComponent SkillLabel1 = "2f221059-778c-484d-b987-3ef2cbe63d14"
	property TextGUIRendererComponent SkillLabel2 = "bf1a03f0-1872-481c-8209-1613a09b5472"
	property TextGUIRendererComponent SkillLabel3 = "8db7a561-bb69-44d2-962c-11b5ebe3a0be"
	property TextGUIRendererComponent SkillLabel4 = "1b0b714c-0401-46e7-a788-90774ce5ee11"
	property TextGUIRendererComponent SkillLabel5 = "ee727140-fd12-43c4-88d7-0de7dc3b003d"
	property TextGUIRendererComponent SkillLabel6 = "bca842b0-58a6-4014-acc5-8079c1016c14"
	property string DefaultSkillIconRuid = "1705e3c5b2c146ac9a699f96fb067408"
	property string UpgradeMapName = "new_upgrade_stage"
	property string SkillIds = ""
	property string SkillNames = ""
	property string SkillIcons = ""
	property string SkillTiers = ""
	property string SkillDescriptions = ""
	property string UpgradeSkillIds = ""
	property string UpgradeSkillNames = ""
	property string UpgradeSkillIcons = ""
	property string UpgradeSkillTiers = ""
	property string UpgradeSkillDescriptions = ""
	property string SelectedSkillId = ""
	property any PreviewCatalog = nil


	property string ActiveMapName = ""
	property boolean StateRequested = false
	property boolean ApplyLocked = false
	property boolean SkipMode = false
	property any ApplyClickHandler = nil
	property any SkillClickHandler1 = nil
	property any SkillClickHandler2 = nil
	property any SkillClickHandler3 = nil
	property any SkillClickHandler4 = nil
	property any SkillClickHandler5 = nil
	property any SkillClickHandler6 = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- Wires the six owned-skill slots and keeps the controller alive outside the upgrade map.
		self.PanelEntity.Enable = false
		self.ApplyButton.Entity.Enable = false
		self.ApplyButton.Enable = false
		self.ApplyClickHandler = self.ApplyButton.Entity:ConnectEvent(ButtonClickEvent, self.OnApplyClicked)
		self.SkillClickHandler1 = self.SkillButton1.Entity:ConnectEvent(ButtonClickEvent, self.OnSkill1Clicked)
		self.SkillClickHandler2 = self.SkillButton2.Entity:ConnectEvent(ButtonClickEvent, self.OnSkill2Clicked)
		self.SkillClickHandler3 = self.SkillButton3.Entity:ConnectEvent(ButtonClickEvent, self.OnSkill3Clicked)
		self.SkillClickHandler4 = self.SkillButton4.Entity:ConnectEvent(ButtonClickEvent, self.OnSkill4Clicked)
		self.SkillClickHandler5 = self.SkillButton5.Entity:ConnectEvent(ButtonClickEvent, self.OnSkill5Clicked)
		self.SkillClickHandler6 = self.SkillButton6.Entity:ConnectEvent(ButtonClickEvent, self.OnSkill6Clicked)
		self:ResetSelection()
		log("[UpgradeSkillStageUI] ready")
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- Opens and refreshes the panel exactly once whenever the local player enters the upgrade map.
		local player = _UserService.LocalPlayer
		local mapName = ""
		if isvalid(player) and player.CurrentMap ~= nil then
			mapName = player.CurrentMap.Name
		end
		if mapName == self.ActiveMapName then
			return
		end
		self.ActiveMapName = mapName
		self.StateRequested = false
		self:ResetSelection()
		if mapName ~= self.UpgradeMapName then
			self.PanelEntity.Enable = false
			return
		end
		self.PanelEntity.Enable = true
		self.StatusText.Text = "보유 스킬을 선택하세요"
		self.StateRequested = true
		_UpgradeSkillStageLogic:RequestUpgradeState()
		log("[UpgradeSkillStageUI] entered map=" .. mapName .. " state requested")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- Disconnects every UI callback so script reloads cannot duplicate selections.
		self:ClearPreviewFits()
		if self.ApplyClickHandler ~= nil then self.ApplyButton.Entity:DisconnectEvent(ButtonClickEvent, self.ApplyClickHandler) end
		if self.SkillClickHandler1 ~= nil then self.SkillButton1.Entity:DisconnectEvent(ButtonClickEvent, self.SkillClickHandler1) end
		if self.SkillClickHandler2 ~= nil then self.SkillButton2.Entity:DisconnectEvent(ButtonClickEvent, self.SkillClickHandler2) end
		if self.SkillClickHandler3 ~= nil then self.SkillButton3.Entity:DisconnectEvent(ButtonClickEvent, self.SkillClickHandler3) end
		if self.SkillClickHandler4 ~= nil then self.SkillButton4.Entity:DisconnectEvent(ButtonClickEvent, self.SkillClickHandler4) end
		if self.SkillClickHandler5 ~= nil then self.SkillButton5.Entity:DisconnectEvent(ButtonClickEvent, self.SkillClickHandler5) end
		if self.SkillClickHandler6 ~= nil then self.SkillButton6.Entity:DisconnectEvent(ButtonClickEvent, self.SkillClickHandler6) end
	end

	@ExecSpace("ClientOnly")
	method void ReceiveState(string skillIds, string skillNames, string skillIcons, string skillTiers, string skillDescriptions, string upgradeSkillIds, string upgradeSkillNames, string upgradeSkillIcons, string upgradeSkillTiers, string upgradeSkillDescriptions, string reason)
		-- Renders each authoritative CSV-backed base-to-next-tier path into a clickable slot.
		if reason ~= "OK" then
			self.StatusText.Text = "스킬 목록을 불러오지 못했습니다: " .. reason
			log_warning("[UpgradeSkillStageUI] state unavailable reason=" .. reason)
			return
		end
		self:ResetSelection()
		self.SkillIds = skillIds
		self.SkillNames = skillNames
		self.SkillIcons = skillIcons
		self.SkillTiers = skillTiers
		self.SkillDescriptions = skillDescriptions
		self.UpgradeSkillIds = upgradeSkillIds
		self.UpgradeSkillNames = upgradeSkillNames
		self.UpgradeSkillIcons = upgradeSkillIcons
		self.UpgradeSkillTiers = upgradeSkillTiers
		self.UpgradeSkillDescriptions = upgradeSkillDescriptions
		local buttons = { self.SkillButton1, self.SkillButton2, self.SkillButton3, self.SkillButton4, self.SkillButton5, self.SkillButton6 }
		local icons = { self.SkillIcon1, self.SkillIcon2, self.SkillIcon3, self.SkillIcon4, self.SkillIcon5, self.SkillIcon6 }
		local labels = { self.SkillLabel1, self.SkillLabel2, self.SkillLabel3, self.SkillLabel4, self.SkillLabel5, self.SkillLabel6 }
		for index = 1, 6 do
			local skillId = self:GetToken(skillIds, index)
			local visible = skillId ~= ""
			buttons[index].Entity.Enable = visible
			buttons[index].Enable = visible
			local iconRuid = self:GetToken(skillIcons, index)
			self:ConfigureSkillIcon(icons[index], iconRuid, visible)
			if visible then
				local displayName = self:GetToken(skillNames, index)
				local tier = self:GetToken(skillTiers, index)
				local upgradeTier = self:GetToken(upgradeSkillTiers, index)
				labels[index].Text = displayName .. "\n<size=22>T" .. tier .. " → T" .. upgradeTier .. "</size>"
			end
		end
		self.SkipMode = upgradeSkillIds == ""
		if self.SkipMode then
			self.ApplyButtonText.Text = self.ApplyButtonSkipText
			self.ApplyButton.Entity.Enable = true
			self.ApplyButton.Enable = true
			self.StatusText.Text = "더 이상 업그레이드할 스킬이 없습니다"
			log("[UpgradeSkillStageUI] no upgrade candidates; skip enabled")
			return
		end
		self.ApplyButtonText.Text = self.ApplyButtonUpgradeText
		self.ApplyButton.Enable = false
		self.ApplyButton.Entity.Enable = false
		self:SelectSkill(1)
		log("[UpgradeSkillStageUI] paths displayed bases=" .. skillIds .. " upgrades=" .. upgradeSkillIds)
	end

	@ExecSpace("ClientOnly")
	method void ResetSelection()
		-- Restores the target as an empty registration slot and hides the apply button.
		self.SelectedSkillId = ""
		self.PreviewCatalog = {}
		self:ConfigureSkillPreview(self.BeforeInfoPanel, self.BeforeInfoIcon, "")
		self:ConfigureSkillPreview(self.AfterInfoPanel, self.AfterInfoIcon, "")
        local buttons = { self.SkillButton1, self.SkillButton2, self.SkillButton3, self.SkillButton4, self.SkillButton5, self.SkillButton6 }
        for _, button in ipairs(buttons) do
            button.Entity.Enable = false
            local marker = button.Entity:GetChildByName("Selected")
            if isvalid(marker) then marker.Enable = false end
        end
        self.ApplyLocked = false
		self.SkipMode = false
		self.ApplyButtonText.Text = self.ApplyButtonUpgradeText
		self:ConfigureSkillIcon(self.BeforeInfoIcon, "", false)
		self:ConfigureSkillIcon(self.AfterInfoIcon, "", false)
		if isvalid(self.BeforeInfoPanel) then self.BeforeInfoPanel.Enable = false end
		if isvalid(self.AfterInfoPanel) then self.AfterInfoPanel.Enable = false end
		if isvalid(self.ComparisonArrow) then self.ComparisonArrow.Enable = false end
		self.ApplyButton.Enable = false
		self.ApplyButton.Entity.Enable = false
	end

	@ExecSpace("ClientOnly")
	method void SelectSkill(integer slotIndex)
		-- Equips the clicked owned skill into the empty target slot without mutating server state yet.
		if self.ApplyLocked == true then
			return
		end
		local skillId = self:GetToken(self.SkillIds, slotIndex)
		if skillId == "" then
			return
		end
		local skillIconRuid = self:GetToken(self.SkillIcons, slotIndex)
		local upgradeSkillId = self:GetToken(self.UpgradeSkillIds, slotIndex)
		local upgradeIconRuid = self:GetToken(self.UpgradeSkillIcons, slotIndex)
		local upgradeTier = self:GetToken(self.UpgradeSkillTiers, slotIndex)
		if upgradeSkillId == "" then
			return
		end
		self.SelectedSkillId = skillId
		self:ConfigureSkillIcon(self.BeforeInfoIcon, skillIconRuid, true)
		self:ConfigureSkillIcon(self.AfterInfoIcon, upgradeIconRuid, true)
		self:ConfigureSkillPreview(self.BeforeInfoPanel, self.BeforeInfoIcon, skillId)
		self:ConfigureSkillPreview(self.AfterInfoPanel, self.AfterInfoIcon, upgradeSkillId)
		if self.BeforeInfoText ~= nil then
			self.BeforeInfoText.Text = self:BuildComparisonText(self:GetToken(self.SkillDescriptions, slotIndex), "", false)
		end
		if self.AfterInfoText ~= nil then
			self.AfterInfoText.Text = self:BuildComparisonText(self:GetToken(self.UpgradeSkillDescriptions, slotIndex), self:GetToken(self.SkillDescriptions, slotIndex), true)
		end
		if isvalid(self.BeforeInfoPanel) then self.BeforeInfoPanel.Enable = true end
		if isvalid(self.AfterInfoPanel) then self.AfterInfoPanel.Enable = true end
		if isvalid(self.ComparisonArrow) then self.ComparisonArrow.Enable = true end
		self.ApplyButton.Entity.Enable = true
		self.ApplyButton.Enable = true
		self:SetCardHeading(self.BeforeInfoPanel, self:GetToken(self.SkillNames, slotIndex), "현재  ·  T" .. self:GetToken(self.SkillTiers, slotIndex))
        self:SetCardHeading(self.AfterInfoPanel, self:GetToken(self.UpgradeSkillNames, slotIndex), "강화  ·  T" .. self:GetToken(self.SkillTiers, slotIndex) .. " → T" .. upgradeTier)
        local buttons = { self.SkillButton1, self.SkillButton2, self.SkillButton3, self.SkillButton4, self.SkillButton5, self.SkillButton6 }
        for index, button in ipairs(buttons) do
            local marker = button.Entity:GetChildByName("Selected")
            if isvalid(marker) then marker.Enable = index == slotIndex end
        end
        self.StatusText.Text = ""
		log("[UpgradeSkillStageUI] equipped slot=" .. slotIndex .. " base=" .. skillId .. " upgrade=" .. upgradeSkillId .. " tier=" .. upgradeTier)
	end

	@ExecSpace("ClientOnly")
	method void OnApplyClicked()
		-- Applies the selected upgrade or requests a validated skip when no path remains.
		if self.ApplyLocked == true then
			return
		end
		if self.SkipMode then
			self.ApplyLocked = true
			self.ApplyButton.Enable = false
			self.StatusText.Text = "다음 스테이지로 이동 중..."
			_UpgradeSkillStageLogic:RequestSkipUpgrade()
			log("[UpgradeSkillStageUI] skip requested")
			return
		end
		if self.SelectedSkillId == "" then
			return
		end
		self.ApplyLocked = true
		self.ApplyButton.Enable = false
		self.StatusText.Text = "업그레이드 적용 중..."
		_UpgradeSkillStageLogic:RequestApplyUpgrade(self.SelectedSkillId)
		log("[UpgradeSkillStageUI] apply requested skill=" .. self.SelectedSkillId)
	end

	@ExecSpace("ClientOnly")
	method void ReceiveApplyResult(boolean success, string reason, string baseSkillId, string upgradeSkillId, integer upgradeTier, string nextStageMapName)
		-- Shows the confirmed CSV-defined replacement and moves to the stored next stage.
		if success == false then
			self.ApplyLocked = false
			self.ApplyButton.Enable = true
			self.StatusText.Text = "업그레이드 실패: " .. reason
			log_warning("[UpgradeSkillStageUI] apply failed base=" .. baseSkillId .. " reason=" .. reason)
			return
		end
		self.StatusText.Text = "업그레이드 완료 · Tier " .. tostring(upgradeTier)
		log("[UpgradeSkillStageUI] apply complete base=" .. baseSkillId .. " upgrade=" .. upgradeSkillId .. " tier=" .. upgradeTier .. " nextMap=" .. nextStageMapName)
		_MapTeleportManager:RequestTeleport(nextStageMapName, Vector3(0, 0.5, 0), "UPGRADE_SKILL_STAGE_COMPLETE")
	end

	@ExecSpace("ClientOnly")
	method void ReceiveSkipResult(boolean success, string reason, string nextStageMapName)
		-- Moves to the next stage after the server confirms there are no upgrade candidates.
		if success == false then
			self.ApplyLocked = false
			self.ApplyButton.Enable = true
			self.StatusText.Text = "넘어가기 실패: " .. reason
			log_warning("[UpgradeSkillStageUI] skip failed reason=" .. reason)
			return
		end
		self.StatusText.Text = "다음 스테이지로 이동합니다"
		log("[UpgradeSkillStageUI] skip complete nextMap=" .. nextStageMapName)
		_MapTeleportManager:RequestTeleport(nextStageMapName, Vector3(0, 0.5, 0), "UPGRADE_SKILL_STAGE_SKIPPED")
	end

	@ExecSpace("ClientOnly")
	method void ConfigureSkillIcon(SpriteGUIRendererComponent icon, string iconRuid, boolean visible)
		-- Authored placeholders are dark and nearly transparent. Every runtime skill icon must
		-- restore its own visibility instead of inheriting that placeholder tint.
		if icon == nil then
			return
		end
		icon.Enable = visible
		if icon.Entity ~= nil then
			icon.Entity.Enable = visible
		end
		if visible == false then
			return
		end
		local resolvedRuid = iconRuid or ""
		if resolvedRuid == "" then
			resolvedRuid = self.DefaultSkillIconRuid
		end
		icon.ImageRUID = DataRef(resolvedRuid)
		icon.Type = ImageType.Simple
		icon.PreserveSprite = PreserveSpriteType.None
		icon.Color = Color(1, 1, 1, 1)
		icon.DropShadow = false
		log("[UpgradeSkillStageUI] icon configured ruid=" .. resolvedRuid)
	end


    @ExecSpace("ClientOnly")
    method void ReceivePreviewCatalog(string skillIds, table previews)
        -- Accepts effects for the currently displayed server-approved skill list.
        if self.SkillIds ~= skillIds then return end
        self.PreviewCatalog = previews
        for i = 1, 6 do
            if self.SelectedSkillId ~= "" and self:GetToken(self.SkillIds, i) == self.SelectedSkillId then
                self:ConfigureSkillPreview(self.BeforeInfoPanel, self.BeforeInfoIcon, self.SelectedSkillId)
                self:ConfigureSkillPreview(self.AfterInfoPanel, self.AfterInfoIcon, self:GetToken(self.UpgradeSkillIds, i))
                break
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void ConfigureSkillPreview(Entity card, SpriteGUIRendererComponent icon, string skillId)
        -- Plays the selected skill's authored effect, keeping an icon fallback when none exists.
        if not isvalid(card) or icon == nil then return end
        local preview = card:GetChildByName("SkillPreview", true)
        if not isvalid(preview) then return end
        self:ReleasePreviewFit(preview)
        local ruid = self.PreviewCatalog ~= nil and self.PreviewCatalog[skillId] or ""
        local hasEffect = ruid ~= nil and ruid ~= ""
        preview.Enable = false
        icon.Entity.UITransformComponent.RectSize = hasEffect and Vector2(48, 48) or Vector2(144, 144)
        icon.Entity.UITransformComponent.anchoredPosition = hasEffect and Vector2(-172, 224) or Vector2(0, 110)
        if not hasEffect then return end
        self:PlayFittedPreview(preview, ruid)
    end

    @ExecSpace("ClientOnly")
    method void SetCardHeading(Entity card, string skillName, string tierText)
        -- Uses the same server-provided skill name and tier as the upgrade selection.
        if not isvalid(card) then return end
        local title = card:GetChildByName("Title")
        local tier = card:GetChildByName("Tier")
        if isvalid(title) then title.TextGUIRendererComponent.Text = skillName end
        if isvalid(tier) then tier.TextGUIRendererComponent.Text = tierText end
    end

    @ExecSpace("ClientOnly")
    method string BuildComparisonText(string description, string previousDescription, boolean showChanges)
        -- Compares authoritative presentation rows, without recalculating upgrade balance.
        local previous = {}
        for row in string.gmatch(previousDescription or "", "[^\n]+") do
            local label, value = string.match(row, "^([^:]+):%s*(.*)$")
            if label ~= nil then previous[label] = value end
        end
        local rows = {}
        for row in string.gmatch(description or "", "[^\n]+") do
            local label, value = string.match(row, "^([^:]+):%s*(.*)$")
            if label ~= nil and label ~= "스킬명" then
                local oldValue = previous[label]
                local displayLabel = label
                if label == "재사용 대기" then displayLabel = "재사용" end
                local result = displayLabel .. "  " .. value
                if showChanges and oldValue ~= nil and oldValue ~= value then
                    result = "<color=#8FE9DD>" .. displayLabel .. "  " .. oldValue .. " → " .. value .. "</color>"
                end
                table.insert(rows, result)
            end
        end
        return table.concat(rows, "\n")
    end

	method string GetToken(string snapshot, integer targetIndex)
		-- Returns one 1-based token from a pipe-delimited UI DTO.
		local index = 0
		for token in string.gmatch(snapshot or "", "([^|]+)") do
			index = index + 1
			if index == targetIndex then
				return token
			end
		end
		return ""
	end

	@ExecSpace("ClientOnly")
	method void OnSkill1Clicked()
		-- Equips owned skill slot 1.
		self:SelectSkill(1)
	end

	@ExecSpace("ClientOnly")
	method void OnSkill2Clicked()
		-- Equips owned skill slot 2.
		self:SelectSkill(2)
	end

	@ExecSpace("ClientOnly")
	method void OnSkill3Clicked()
		-- Equips owned skill slot 3.
		self:SelectSkill(3)
	end

	@ExecSpace("ClientOnly")
	method void OnSkill4Clicked()
		-- Equips owned skill slot 4.
		self:SelectSkill(4)
	end

	@ExecSpace("ClientOnly")
	method void OnSkill5Clicked()
		-- Equips owned skill slot 5.
		self:SelectSkill(5)
	end

	@ExecSpace("ClientOnly")
	method void OnSkill6Clicked()
		-- Equips owned skill slot 6.
		self:SelectSkill(6)
	end

	@ExecSpace("ClientOnly")
	method void ReleasePreviewFit(Entity preview)
		-- Cancels a pending load and removes the previous frame callback.
		local fits = self._T.PreviewFits
		if fits == nil or not isvalid(preview) then return end
		local state = fits[preview.Id]
		if state == nil then return end
		fits[preview.Id] = nil
		if state.eventHandler ~= nil then
			preview:DisconnectEvent(SpriteGUIAnimPlayerChangeFrameEvent, state.eventHandler)
		end
		preview.UITransformComponent.RectSize = state.box
	end

	@ExecSpace("ClientOnly")
	method void ClearPreviewFits()
		-- Releases frame callbacks and invalidates loads on close or play shutdown.
		for _, state in pairs(self._T.PreviewFits or {}) do
			if isvalid(state.entity) then
				if state.eventHandler ~= nil then
					state.entity:DisconnectEvent(SpriteGUIAnimPlayerChangeFrameEvent, state.eventHandler)
				end
				state.entity.UITransformComponent.RectSize = state.box
			end
		end
		self._T.PreviewFits = {}
	end

	@ExecSpace("ClientOnly")
	method void SetPreviewThumbnail(Entity preview, string ruid)
		-- Restores the full preview box when leaving animation playback.
		self:ReleasePreviewFit(preview)
		local renderer = preview.SpriteGUIRendererComponent
		renderer.Type = ImageType.Simple
		renderer.PreserveSprite = PreserveSpriteType.AspectOnly
		renderer.LocalPosition = Vector2(0, 0)
		renderer.LocalScale = Vector2(1, 1)
		renderer.Color = Color(1, 1, 1, 1)
		renderer.ImageRUID = DataRef("thumbnail://" .. ruid)
		preview.Enable = true
	end

	@ExecSpace("ClientOnly")
	method void PlayFittedPreview(Entity preview, string ruid)
		-- Fits all animation frames at one scale; world pivots cannot push UI art into the mask.
		self:ReleasePreviewFit(preview)
		self._T.PreviewFits = self._T.PreviewFits or {}
		self._T.PreviewSizes = self._T.PreviewSizes or {}
		local state = { entity = preview, box = preview.UITransformComponent.RectSize }
		self._T.PreviewFits[preview.Id] = state
		preview.Enable = false
		_ResourceService:PreloadAsync({ruid}, function()
			if not isvalid(preview) or self._T.PreviewFits[preview.Id] ~= state then return end
			local sizes = self._T.PreviewSizes[ruid]
			if sizes == nil then
				local ok, clip = pcall(function() return _ResourceService:LoadAnimationClipAndWait(ruid) end)
				if ok and clip ~= nil and clip.IsLoadComplete then
					sizes = { width = 0, height = 0, frames = {} }
					for _, frame in ipairs(clip.Frames:ToTable()) do
						local sprite = frame.FrameSprite
						if sprite ~= nil and sprite.IsLoadComplete and sprite.Width > 0 and sprite.Height > 0 then
							sizes.frames[frame.FrameIndex] = Vector2(sprite.Width, sprite.Height)
							sizes.width = math.max(sizes.width, sprite.Width)
							sizes.height = math.max(sizes.height, sprite.Height)
						else
							sizes = nil
							break
						end
					end
					if sizes ~= nil and sizes.width > 0 and sizes.height > 0 then
						self._T.PreviewSizes[ruid] = sizes
					else
						sizes = nil
					end
				end
			end
			-- Resource waits can resume after a different skill, hover exit or map change.
			if not isvalid(preview) or self._T.PreviewFits[preview.Id] ~= state then return end
			if sizes == nil or sizes.frames[0] == nil then
				log_warning("[SkillPreviewFit] metadata unavailable; thumbnail fallback ruid=" .. ruid)
				self:SetPreviewThumbnail(preview, ruid)
				return
			end
			local scale = math.min(state.box.x / sizes.width, state.box.y / sizes.height)
			local applyFrame = function(frameIndex)
				if not isvalid(preview) or self._T.PreviewFits[preview.Id] ~= state then return end
				local size = sizes.frames[frameIndex]
				if size ~= nil then
					preview.UITransformComponent.RectSize = Vector2(size.x * scale, size.y * scale)
				end
			end
			local renderer = preview.SpriteGUIRendererComponent
			renderer.Type = ImageType.Simple
			-- None ignores sprite pivots; each frame's rect already preserves its native aspect.
			renderer.PreserveSprite = PreserveSpriteType.None
			renderer.LocalPosition = Vector2(0, 0)
			renderer.LocalScale = Vector2(1, 1)
			renderer.Color = Color(1, 1, 1, 1)
			renderer.StartFrameIndex = 0
			renderer.EndFrameIndex = 2147483647
			renderer.AnimClipPlayType = SpriteAnimClipPlayType.Loop
			renderer.PlayRate = 1
			state.eventHandler = preview:ConnectEvent(SpriteGUIAnimPlayerChangeFrameEvent, function(event)
				applyFrame(event.FrameIndex)
		end)
		applyFrame(0)
		renderer.ImageRUID = DataRef(ruid)
		preview.Enable = true
		log("[SkillPreviewFit] ruid=" .. ruid .. " bounds=" .. tostring(sizes.width) .. "x" .. tostring(sizes.height) .. " scale=" .. tostring(scale))
		end)
	end

end
