@Component
script NewSkillStageChoiceComponent extends Component

	property integer ChoiceIndex = 1
	property string LabelEntityPath = ""
	property Vector3 TargetPosition = Vector3(0, 0, 0)
	property string OfferedSkillId = ""
	property string OfferedDisplayName = ""
	property string OfferedDescription = ""
	property string DefaultSkillIconRuid = "1705e3c5b2c146ac9a699f96fb067408"
	property string UnavailableAnimationRuid = "2dfb3187bc8f447f97ee6eeb51bbe039"
	property number UnavailableAnimationOffsetX = 0.50
	property string UnavailableTooltipText = "새로운 스킬이 없습니다."
	property string SpearPullingIconRuid = "bb70484eb6eb41f181ff21d336e78ea0"
	property string BrandishIconRuid = "ad4304f4d5654158aca63c8c142d5035"
	property string DivineSwingIconRuid = "01f0134411804cd7aaa13065ca3b5ab7"
	property string HoverSoundRUID = "159bf70a74634bfc8e91a29e527a4be5"
	property string ClickSoundRUID = "972843e759204d3e9ad84e7d3fa94f83"
	property number SoundVolume = 1
	property Color NormalIconColor = Color(1, 1, 1, 1)
	property Color HoverIconColor = Color(0.58, 0.64, 0.76, 1)
	property Vector2 HoverHalfExtent = Vector2(1.25, 1.25)
	property boolean IsHovered = false
	property boolean IsUnavailableSlot = false
	property boolean HasAppliedUnavailableOffset = false
	property string TargetMapName = ""
	property boolean SelectionLocked = false
	property any touchHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- Requests this slot's authoritative job skill offer and wires world touch input.
		self.SelectionLocked = false
		self.IsHovered = false
		self.IsUnavailableSlot = false
		self.HasAppliedUnavailableOffset = false
		self.touchHandler = self.Entity:ConnectEvent(TouchEvent, self.OnTouched)
		self:RequestOffer(self.ChoiceIndex)
		log("[NewSkillStage] offer requested slot=" .. self.ChoiceIndex)
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- Detects PC pointer entry over this world-space skill icon and toggles its description tooltip.
		if Environment:IsPCPlatform() == false or self.SelectionLocked == true or (self.OfferedSkillId == "" and self.IsUnavailableSlot == false) or self.Entity.Enable == false then
			self:SetHoverState(false)
			return
		end
		if _InputService:IsPointerOverUI() then
			self:SetHoverState(false)
			return
		end
		local cursorPosition = _InputService:GetCursorPosition()
		local cursorWorldPosition = _UILogic:ScreenToWorldPosition(cursorPosition)
		local entityPosition = self.Entity.TransformComponent.WorldPosition
		local inside = math.abs(cursorWorldPosition.x - entityPosition.x) <= self.HoverHalfExtent.x
			and math.abs(cursorWorldPosition.y - entityPosition.y) <= self.HoverHalfExtent.y
		self:SetHoverState(inside)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- Releases the world touch handler when the selection map unloads.
		if self.touchHandler ~= nil then
			self.Entity:DisconnectEvent(TouchEvent, self.touchHandler)
			self.touchHandler = nil
		end
		self:SetHoverState(false)
		if self.HasAppliedUnavailableOffset == true and self.Entity.TransformComponent ~= nil then
			self.Entity.TransformComponent:Translate(-self.UnavailableAnimationOffsetX, 0)
			self.HasAppliedUnavailableOffset = false
		end
	end

	@ExecSpace("Server")
	method void RequestOffer(integer choiceIndex)
		-- Resolves a deterministic offer from the requesting player's selected job.
		local playerEntity = _UserService:GetUserEntityByUserId(senderUserId)
		local offer = self:ResolveOffer(playerEntity, choiceIndex)
		if offer.Success == false then
			if offer.Reason == "CHOICE_SLOT_UNAVAILABLE" then
				log("[NewSkillStage] offer slot placeholder user=" .. senderUserId .. " slot=" .. choiceIndex .. " candidates=" .. tostring(offer.CandidateCount or 0))
			else
				log_warning("[NewSkillStage] offer rejected user=" .. senderUserId .. " slot=" .. choiceIndex .. " reason=" .. offer.Reason)
			end
			self:ReceiveOffer("", "", "", "", offer.Reason, senderUserId)
			return
		end
		log("[NewSkillStage] offer ready user=" .. senderUserId .. " job=" .. offer.JobId .. " slot=" .. choiceIndex .. " skill=" .. offer.SkillId)
		self:ReceiveOffer(offer.SkillId, offer.DisplayName, offer.IconRuid, offer.Description, "OK", senderUserId)
	end

	@ExecSpace("ServerOnly")
	method table ResolveOffer(Entity playerEntity, integer choiceIndex)
		-- Offers only unowned tier-1 job skills; higher tiers belong exclusively to the upgrade map.
		if isvalid(playerEntity) == false then
			return { Success = false, Reason = "INVALID_PLAYER" }
		end
		local runState = playerEntity:GetComponent("script.PlayerRunStateComponent")
		if runState == nil or runState.SelectedJobId == "" then
			return { Success = false, Reason = "JOB_NOT_SELECTED" }
		end
		local catalog = _SkillDefinitionRepositoryLogic:GetJobSkillDefinitions(runState.SelectedJobId)
		if catalog.Success == false then
			return catalog
		end
		local inventory = playerEntity:GetComponent("script.PlayerRunInventoryComponent")
		if inventory == nil or inventory.ActiveRunSequence ~= runState.RunSequence then
			return { Success = false, Reason = "RUN_INVENTORY_UNAVAILABLE" }
		end
		local candidateSkills = {}
		for _, skillDefinition in ipairs(catalog.Skills) do
			local ownsSkillFamily = inventory:HasOwnedSkillInFamily(skillDefinition.SkillId, catalog.Skills)
			if skillDefinition.SkillTier == 1 and ownsSkillFamily == false then
				table.insert(candidateSkills, skillDefinition)
			end
		end
		local normalizedChoiceIndex = math.max(1, math.floor(choiceIndex or 1))
		if normalizedChoiceIndex > #candidateSkills then
			log("[NewSkillStage] offer slot unavailable job=" .. runState.SelectedJobId .. " slot=" .. normalizedChoiceIndex .. " candidates=" .. #candidateSkills .. " owned=" .. inventory.RunSkillSnapshot)
			return { Success = false, Reason = "CHOICE_SLOT_UNAVAILABLE", JobId = runState.SelectedJobId, CandidateCount = #candidateSkills }
		end
		local rotation = math.abs(runState.RunSeed + runState.CompletedStageCount * 17)
		local skillIndex = ((rotation + normalizedChoiceIndex - 1) % #candidateSkills) + 1
		local definition = candidateSkills[skillIndex]
		log("[NewSkillStage] offer filtered job=" .. runState.SelectedJobId .. " slot=" .. normalizedChoiceIndex .. " mode=NEW_FAMILY_AWARE catalog=" .. #catalog.Skills .. " unowned=" .. #candidateSkills .. " owned=" .. inventory.RunSkillSnapshot .. " selected=" .. definition.SkillId)
		return {
			Success = true,
			Reason = "OK",
			JobId = runState.SelectedJobId,
			SkillId = definition.SkillId,
			DisplayName = definition.DisplayName,
			IconRuid = self:GetSkillIconRuid(definition),
			Description = self:BuildSkillDescription(definition)
		}
	end

	@ExecSpace("ServerOnly")
	method string BuildSkillDescription(any definition)
		-- Builds a concise Korean tooltip from the authoritative skill definition fields.
		local targetLabel = definition.TargetingType or ""
		if targetLabel == "FRONT_CELL" then
			targetLabel = "정면 칸"
		elseif targetLabel == "FIRST_ENEMY_FORWARD" then
			targetLabel = "전방의 첫 번째 적"
		elseif targetLabel == "RANGE_OFFSETS" then
			targetLabel = "지정 범위"
		elseif targetLabel == "SELF" then
			targetLabel = "자신"
		elseif targetLabel == "" then
			targetLabel = "정보 없음"
		end
		local damageValue = self:GetSkillDamageValue(definition)
		local damageText = damageValue > 0 and tostring(damageValue) or "없음"
		local description = "피해: " .. damageText
			.. "\n범위: " .. tostring(definition.Range or 0)
			.. "\n대상: " .. targetLabel
			.. "\n재사용 대기: " .. tostring(definition.CooldownTurns or 0) .. "턴"
		if definition.CostType ~= nil and definition.CostType ~= "" and (definition.CostValue or 0) > 0 then
			description = description .. "\n비용: " .. definition.CostType .. " " .. tostring(definition.CostValue)
		end
		return description
	end

	@ExecSpace("ServerOnly")
	method number GetSkillDamageValue(any definition)
		-- Sums every authored DAMAGE step so multi-step skills expose their total tooltip damage.
		if definition == nil or definition.EffectSetId == nil or definition.EffectSetId == "" then
			return 0
		end
		local effectResult = _SkillDefinitionRepositoryLogic:GetEffectSteps(definition.EffectSetId)
		if effectResult.Success == false then
			return 0
		end
		local totalDamage = 0
		for _, effectStep in ipairs(effectResult.Steps) do
			if effectStep.EffectType == "DAMAGE" then
				totalDamage = totalDamage + (effectStep.Value or 0)
			end
		end
		return totalDamage
	end

	@ExecSpace("ServerOnly")
	method string GetSkillIconRuid(any definition)
		-- Prefers the authored dataset icon and falls back to skill-specific effect art when it is empty.
		local iconRuid = definition.IconRuid or ""
		if iconRuid ~= "" then
			return iconRuid
		end
		local sourceRuid = definition.CastEffectRuid or ""
		if sourceRuid == "" then
			sourceRuid = definition.HitEffectRuid or ""
		end
		if sourceRuid ~= "" then
			return "thumbnail://" .. sourceRuid
		end
		return self.DefaultSkillIconRuid
	end

	@ExecSpace("Client")
	method void ReceiveOffer(string skillId, string displayName, string iconRuid, string description, string reason)
		-- Applies a skill offer or plays a non-interactive animation for an unused choice slot.
		self:SetHoverState(false)
		if reason ~= "OK" or skillId == "" then
			self.OfferedSkillId = ""
			self.OfferedDisplayName = ""
			self.OfferedDescription = ""
			self.IsUnavailableSlot = reason == "CHOICE_SLOT_UNAVAILABLE"
			local unavailableLabelEntity = _EntityService:GetEntityByPath(self.LabelEntityPath)
			if isvalid(unavailableLabelEntity) and unavailableLabelEntity.NameTagComponent ~= nil then
				unavailableLabelEntity.NameTagComponent.Enable = false
			end
			if reason == "CHOICE_SLOT_UNAVAILABLE" then
				self.Entity.Enable = true
				if self.HasAppliedUnavailableOffset == false and self.Entity.TransformComponent ~= nil then
					self.Entity.TransformComponent:Translate(self.UnavailableAnimationOffsetX, 0)
					self.HasAppliedUnavailableOffset = true
				end
				if self.Entity.SpriteRendererComponent ~= nil then
					self.Entity.SpriteRendererComponent.SpriteRUID = self.UnavailableAnimationRuid
					self.Entity.SpriteRendererComponent.Color = self.NormalIconColor
				end
				log("[NewSkillStage] choice slot replaced with unavailable animation slot=" .. self.ChoiceIndex .. " ruid=" .. self.UnavailableAnimationRuid .. " offsetX=" .. self.UnavailableAnimationOffsetX .. " tooltip=" .. self.UnavailableTooltipText)
			else
				if self.HasAppliedUnavailableOffset == true and self.Entity.TransformComponent ~= nil then
					self.Entity.TransformComponent:Translate(-self.UnavailableAnimationOffsetX, 0)
					self.HasAppliedUnavailableOffset = false
				end
				self.Entity.Enable = false
				log_warning("[NewSkillStage] offer unavailable slot=" .. self.ChoiceIndex .. " reason=" .. reason)
			end
			return
		end
		self.IsUnavailableSlot = false
		if self.HasAppliedUnavailableOffset == true and self.Entity.TransformComponent ~= nil then
			self.Entity.TransformComponent:Translate(-self.UnavailableAnimationOffsetX, 0)
			self.HasAppliedUnavailableOffset = false
		end
		self.Entity.Enable = true
		self.OfferedSkillId = skillId
		self.OfferedDisplayName = displayName
		self.OfferedDescription = description or ""
		if iconRuid ~= "" and self.Entity.SpriteRendererComponent ~= nil then
			self.Entity.SpriteRendererComponent.SpriteRUID = iconRuid
			self.Entity.SpriteRendererComponent.Color = self.NormalIconColor
		end
		local labelEntity = _EntityService:GetEntityByPath(self.LabelEntityPath)
		if isvalid(labelEntity) and labelEntity.NameTagComponent ~= nil then
			labelEntity.NameTagComponent.Name = displayName
			labelEntity.NameTagComponent.Enable = true
		end
		log("[NewSkillStage] offer displayed slot=" .. self.ChoiceIndex .. " skill=" .. skillId .. " name=" .. displayName .. " icon=" .. iconRuid)
	end

	@ExecSpace("ClientOnly")
	method void SetHoverState(boolean hovered)
		-- Plays the shared hover SFX once per entry and toggles the mouse-following screen tooltip.
		if self.IsHovered == hovered then
			return
		end
		self.IsHovered = hovered
		local iconRenderer = self.Entity.SpriteRendererComponent
		if iconRenderer ~= nil then
			iconRenderer.Color = hovered and self.HoverIconColor or self.NormalIconColor
		end
		if hovered then
			_SoundService:PlaySound(self.HoverSoundRUID, self.SoundVolume)
			local tooltipUI = self:GetTooltipUI()
			if tooltipUI ~= nil then
				tooltipUI:Show(self:GetTooltipOwnerKey(), self:GetTooltipText())
			end
			log("[NewSkillStage] tooltip shown slot=" .. self.ChoiceIndex .. " skill=" .. self.OfferedSkillId)
		else
			local tooltipUI = self:GetTooltipUI()
			if tooltipUI ~= nil then
				tooltipUI:Hide(self:GetTooltipOwnerKey())
			end
			log("[NewSkillStage] tooltip hidden slot=" .. self.ChoiceIndex .. " skill=" .. self.OfferedSkillId)
		end
	end

	@ExecSpace("ClientOnly")
	method string GetTooltipText()
		-- Returns the centered multi-line skill description consumed by the shared tooltip.
		if self.IsUnavailableSlot then
			return self.UnavailableTooltipText
		end
		return self.OfferedDisplayName .. "\n" .. self.OfferedDescription
	end

	@ExecSpace("ClientOnly")
	method string GetTooltipOwnerKey()
		-- Builds a stable owner key so another hovered choice cannot hide this tooltip.
		if self.IsUnavailableSlot then
			return "new_skill:" .. tostring(self.ChoiceIndex) .. ":unavailable"
		end
		return "new_skill:" .. tostring(self.ChoiceIndex) .. ":" .. self.OfferedSkillId
	end

	@ExecSpace("ClientOnly")
	method any GetTooltipUI()
		-- Resolves the shared topmost tooltip component used by every hover consumer.
		local uiRoot = _EntityService:GetEntityByPath("/ui/MouseTooltipGroup")
		if isvalid(uiRoot) then
			return uiRoot:GetComponent("script.MouseTooltipUIComponent")
		end
		return nil
	end

	@ExecSpace("ClientOnly")
	method void OnTouched(TouchEvent event)
		-- Submits the displayed offer once and ignores repeated local touches.
		if self.SelectionLocked == true or self.OfferedSkillId == "" then
			return
		end
		self.SelectionLocked = true
		_SoundService:PlaySound(self.ClickSoundRUID, self.SoundVolume)
		self:SetHoverState(false)
		self:RequestSelectOffer(self.ChoiceIndex, self.OfferedSkillId)
		log("[NewSkillStage] selection requested slot=" .. self.ChoiceIndex .. " skill=" .. self.OfferedSkillId)
	end

	@ExecSpace("Server")
	method void RequestSelectOffer(integer choiceIndex, string skillId)
		-- Recomputes the offer server-side, grants it once, and rejects forged or repeated choices.
		local playerEntity = _UserService:GetUserEntityByUserId(senderUserId)
		local offer = self:ResolveOffer(playerEntity, choiceIndex)
		if offer.Success == false or offer.SkillId ~= skillId then
			local reason = offer.Success == false and offer.Reason or "OFFER_MISMATCH"
			log_warning("[NewSkillStage] selection rejected user=" .. senderUserId .. " slot=" .. choiceIndex .. " reason=" .. reason)
			self:ReceiveSelectionResult(false, reason, skillId, "")
			return
		end
		local runState = playerEntity:GetComponent("script.PlayerRunStateComponent")
		local rewardKey = "new_skill_stage:" .. tostring(runState.RunSequence) .. ":" .. tostring(runState.CompletedStageCount)
		local result = _RunManagerLogic:GrantRunSkill(playerEntity, skillId, 1, rewardKey)
		if result.Success == false or result.GrantedAmount ~= 1 then
			local reason = result.Success == false and result.Reason or "SKILL_ALREADY_SELECTED"
			log_warning("[NewSkillStage] grant rejected user=" .. senderUserId .. " skill=" .. skillId .. " reason=" .. reason)
			self:ReceiveSelectionResult(false, reason, skillId, "")
			return
		end
		local nextStageMapName = _StageTransitionManagerLogic:GetNextStageMapNameForPlayer(playerEntity)
		if nextStageMapName == "" then
			log_warning("[NewSkillStage] grant applied but next map missing user=" .. senderUserId .. " skill=" .. skillId .. " key=" .. rewardKey)
			self:ReceiveSelectionResult(false, "NEXT_STAGE_MAP_UNAVAILABLE", skillId, "")
			return
		end
		log("[NewSkillStage] grant applied user=" .. senderUserId .. " job=" .. offer.JobId .. " skill=" .. skillId .. " key=" .. rewardKey .. " nextMap=" .. nextStageMapName)
		self:ReceiveSelectionResult(true, "APPLIED", skillId, nextStageMapName)
	end

	@ExecSpace("Client")
	method void ReceiveSelectionResult(boolean success, string reason, string skillId, string nextStageMapName)
		-- Teleports with the server-resolved map after this stage grants exactly one skill.
		if success == false then
			self.SelectionLocked = false
			log_warning("[NewSkillStage] selection failed skill=" .. skillId .. " reason=" .. reason)
			return
		end
		self.TargetMapName = nextStageMapName or ""
		if self.TargetMapName == "" then
			self.SelectionLocked = false
			log_warning("[NewSkillStage] selection applied but next map is unavailable skill=" .. skillId)
			return
		end
		log("[NewSkillStage] selection complete skill=" .. skillId .. " targetMap=" .. self.TargetMapName)
		_MapTeleportManager:RequestTeleport(self.TargetMapName, self.TargetPosition, "NEW_SKILL_STAGE_COMPLETE")
	end

end
