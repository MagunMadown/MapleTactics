@Logic
script BattleRunContentHandlerLogic

	@ExecSpace("ServerOnly")
	method table Resolve(table context)
		if context.ContentId == nil or context.ContentId == "" then
			return { Success = false, Reason = "BATTLE_CONTENT_ID_MISSING" }
		end
		return {
			Success = true,
			Reason = "CONTENT_TRANSITION_READY",
			FlowState = "AWAITING_BATTLE",
			RouteAction = "PREPARE_BATTLE_ENTRY",
			UiRouteId = "BATTLE_LOADING",
			DestinationType = context.ContentType,
			DestinationId = context.ContentId,
			RequiresMapTransfer = true
		}
	end

end
