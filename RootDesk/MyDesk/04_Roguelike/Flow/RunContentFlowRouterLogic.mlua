@Logic
script RunContentFlowRouterLogic

	@ExecSpace("ServerOnly")
	method table Resolve(table context)
		-- Routes immutable selection context to one stateless content-type handler.
		if context == nil or context.ContentType == nil or context.ContentType == "" then
			return { Success = false, Reason = "INVALID_CONTENT_TRANSITION_CONTEXT" }
		end
		if context.ContentType == "BATTLE" or context.ContentType == "BOSS" then
			return _BattleRunContentHandlerLogic:Resolve(context)
		end
		if context.ContentType == "SHOP" then
			return _ShopRunContentHandlerLogic:Resolve(context)
		end
		if context.ContentType == "EVENT" then
			return _EventRunContentHandlerLogic:Resolve(context)
		end
		if context.ContentType == "REST" then
			return _RestRunContentHandlerLogic:Resolve(context)
		end
		return { Success = false, Reason = "CONTENT_TYPE_HANDLER_NOT_REGISTERED", ContentType = context.ContentType }
	end

end
