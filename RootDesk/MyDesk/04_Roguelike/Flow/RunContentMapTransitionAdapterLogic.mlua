@Logic
script RunContentMapTransitionAdapterLogic

	@ExecSpace("ServerOnly")
	method table ConsumeSelectedShop(Entity playerEntity)
		-- Consumes only the server-approved SHOP transition stored on this player.
		local runState = _RunManagerLogic:GetOrCreateRunState(playerEntity)
		if runState == nil then
			return { Success = false, Reason = "RUN_STATE_UNAVAILABLE" }
		end
		if runState.ContentTransitionState ~= "READY" or runState.SelectedContentType ~= "SHOP"
			or runState.SelectedContentId == "" or runState.ContentRequiresMapTransfer ~= true then
			return { Success = false, Reason = "SHOP_TRANSITION_NOT_READY" }
		end
		local bundle = _ShopDefinitionRepositoryLogic:GetShopBundle(runState.SelectedContentId)
		if bundle.Success == false then
			return bundle
		end
		if bundle.Definition.MapId ~= runState.ContentDestinationId then
			return { Success = false, Reason = "SHOP_DESTINATION_MISMATCH" }
		end
		local opened = _RunShopLogic:OpenShop(playerEntity, runState.SelectedContentId)
		if opened.Success == false then
			return opened
		end
		local transferred = _MapTeleportManager:TeleportPlayerToSpawn(playerEntity, bundle.Definition.MapId, "SpawnLocation", "RUN_CONTENT_SHOP")
		if transferred.Success == false then
			return transferred
		end
		log("[RunContentMap] shop transfer accepted node=" .. runState.SelectedContentId .. " map=" .. bundle.Definition.MapId)
		return { Success = true, Reason = "SHOP_MAP_TRANSFERRED", ShopId = runState.SelectedContentId, MapId = bundle.Definition.MapId }
	end

end
