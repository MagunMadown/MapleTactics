@Logic
script RunContentMapTransitionAdapterLogic extends Logic

	@ExecSpace("ServerOnly")
	method table ConsumeSelectedShop(Entity playerEntity)
		-- Consumes only the server-approved SHOP transition stored on this player.
		local runState = _RunManagerLogic:GetOrCreateRunState(playerEntity)
		if runState == nil then
			return { Success = false, Reason = "RUN_STATE_UNAVAILABLE" }
		end
		if runState.ContentTransitionState ~= "READY" or runState.SelectedContentType ~= "SHOP"
			or runState.SelectedContentId == "" or runState.ContentRequiresMapTransfer ~= true then
			return { Success = false, Reason = "SHOP_TRANSITION_NOT_READY" }
		end
		local bundle = _ShopDefinitionRepositoryLogic:GetShopBundle(runState.SelectedContentId)
		if bundle.Success == false then
			return bundle
		end
		if bundle.Definition.MapId ~= runState.ContentDestinationId then
			return { Success = false, Reason = "SHOP_DESTINATION_MISMATCH" }
		end
		local opened = _RunShopLogic:OpenShop(playerEntity, runState.SelectedContentId)
		if opened.Success == false then
			return opened
		end
		local transferred = _MapTeleportManager:TeleportPlayerToSpawn(playerEntity, bundle.Definition.MapId, "SpawnLocation", "RUN_CONTENT_SHOP")
		if transferred.Success == false then
			return transferred
		end
		log("[RunContentMap] shop transfer accepted node=" .. runState.SelectedNodeId .. " shop=" .. runState.SelectedContentId .. " map=" .. bundle.Definition.MapId)
		return { Success = true, Reason = "SHOP_MAP_TRANSFERRED", NodeId = runState.SelectedNodeId, ShopId = runState.SelectedContentId, MapId = bundle.Definition.MapId }
	end


	@ExecSpace("ServerOnly")
	method table ConsumeSelectedBattle(Entity playerEntity)
		-- Prepares and transfers only the server-approved BATTLE transition.
		local runState = _RunManagerLogic:GetOrCreateRunState(playerEntity)
		if runState == nil then
			return { Success = false, Reason = "RUN_STATE_UNAVAILABLE" }
		end
		if runState.ContentTransitionState ~= "READY"
			or (runState.SelectedContentType ~= "BATTLE" and runState.SelectedContentType ~= "BOSS")
			or runState.SelectedContentId == "" or runState.ContentRequiresMapTransfer ~= true then
			return { Success = false, Reason = "BATTLE_TRANSITION_NOT_READY" }
		end
		local route = _StageMapRouteRepositoryLogic:GetMapRoute(runState.SelectedContentId)
		if route == nil or route.Success ~= true then
			return { Success = false, Reason = route == nil and "STAGE_MAP_ROUTE_RESULT_MISSING" or route.Reason }
		end
		local entryState = playerEntity:GetComponent("script.BattleEntryStateComponent")
		local characterId = entryState == nil and "" or entryState.CharacterId
		local loadoutId = entryState == nil and "" or entryState.LoadoutId
		local prepared = _BattleGatewayLogic:PrepareBattleEntry(
			playerEntity,
			runState.SelectedContentId,
			characterId,
			runState.SelectedJobId,
			loadoutId,
			runState.RunSeed,
			"CONTINUE_RUN"
		)
		if prepared.Success ~= true then
			return prepared
		end
		local transferred = _BattleGatewayLogic:TransferPreparedLobbyBattleEntry(playerEntity, prepared.RequestId)
		if transferred.Success ~= true then
			return transferred
		end
		log("[RunContentMap] battle transfer accepted node=" .. runState.SelectedNodeId .. " stage=" .. runState.SelectedContentId .. " map=" .. route.MapId)
		return transferred
	end

end
