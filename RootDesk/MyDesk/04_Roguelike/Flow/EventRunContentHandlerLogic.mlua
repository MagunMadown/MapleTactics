@Logic
script EventRunContentHandlerLogic

	@ExecSpace("ServerOnly")
	method table Resolve(table context)
		if context.ContentId == nil or context.ContentId == "" then
			return { Success = false, Reason = "EVENT_CONTENT_ID_MISSING" }
		end
		return {
			Success = true,
			Reason = "CONTENT_TRANSITION_READY",
			FlowState = "AWAITING_EVENT",
			RouteAction = "OPEN_EVENT",
			UiRouteId = "RUN_EVENT",
			DestinationType = "EVENT",
			DestinationId = context.ContentId,
			RequiresMapTransfer = false
		}
	end

end
