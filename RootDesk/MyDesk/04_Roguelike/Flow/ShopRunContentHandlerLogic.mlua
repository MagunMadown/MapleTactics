@Logic
script ShopRunContentHandlerLogic

	@ExecSpace("ServerOnly")
	method table Resolve(table context)
		if context.ContentId == nil or context.ContentId == "" then
			return { Success = false, Reason = "SHOP_CONTENT_ID_MISSING" }
		end
		return {
			Success = true,
			Reason = "CONTENT_TRANSITION_READY",
			FlowState = "AWAITING_SHOP",
			RouteAction = "OPEN_SHOP",
			UiRouteId = "RUN_SHOP",
			DestinationType = "SHOP",
			DestinationId = context.ContentId,
			RequiresMapTransfer = false
		}
	end

end
