@Logic
script ShopRunContentHandlerLogic extends Logic

	@ExecSpace("ServerOnly")
	method table Resolve(table context)
		if context.ContentId == nil or context.ContentId == "" then
			return { Success = false, Reason = "SHOP_CONTENT_ID_MISSING" }
		end
		local bundle = _ShopDefinitionRepositoryLogic:GetShopBundle(context.ContentId)
		if bundle.Success == false then
			return { Success = false, Reason = bundle.DetailReason or bundle.Reason }
		end
		return {
			Success = true,
			Reason = "CONTENT_TRANSITION_READY",
			FlowState = "AWAITING_SHOP",
			RouteAction = "OPEN_SHOP",
			UiRouteId = "RUN_SHOP",
			DestinationType = "SHOP",
			DestinationId = _ShopDefinitionRepositoryLogic:GetMapIdForNode(bundle.Definition, context.NodeId),
			RequiresMapTransfer = true
		}
	end

end
