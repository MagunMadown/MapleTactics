@Logic
script RestRunContentHandlerLogic

	@ExecSpace("ServerOnly")
	method table Resolve(table context)
		if context.ContentId == nil or context.ContentId == "" then
			return { Success = false, Reason = "REST_CONTENT_ID_MISSING" }
		end
		return {
			Success = true,
			Reason = "CONTENT_TRANSITION_READY",
			FlowState = "AWAITING_REST",
			RouteAction = "OPEN_REST",
			UiRouteId = "RUN_REST",
			DestinationType = "REST",
			DestinationId = context.ContentId,
			RequiresMapTransfer = false
		}
	end

end
