@Component
script ShopExitButtonComponent extends Component

	property any TouchHandler = nil
	property boolean ClosePending = false
	property integer CloseRequestId = 300000
	property string ClickSoundRUID = "972843e759204d3e9ad84e7d3fa94f83"

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self.TouchHandler = self.Entity:ConnectEvent(TouchEvent, self.OnTouched)
		log("[RunShopExit] button ready")
	end

	@ExecSpace("ClientOnly")
	method void OnTouched(TouchEvent event)
		if self.ClosePending then return end
		self.ClosePending = true
		_SoundService:PlaySound(self.ClickSoundRUID, 1)
		self.CloseRequestId = self.CloseRequestId + 1
		local uiRoot = _EntityService:GetEntityByPath("/ui/RunShopUI")
		local controller = isvalid(uiRoot) and uiRoot:GetComponent("script.RunShopUIComponent") or nil
		if controller ~= nil then controller:CloseUi() end
		_RunShopLogic:RequestCloseShop(self.CloseRequestId)
		log("[RunShopExit] close requested request=" .. self.CloseRequestId)
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		if self.ClosePending == false then return end
		local state = _RunShopLogic:GetLocalShopUiState()
		if state.Success ~= true or state.Completion.LastCompletedContentType ~= "SHOP" or state.Completion.LastCompletedContentId == "" then return end
		self.ClosePending = false
		local uiRoot = _EntityService:GetEntityByPath("/ui/DefaultGroup")
		local minimap = isvalid(uiRoot) and uiRoot:GetComponent("script.MinimapUI") or nil
		if minimap ~= nil then minimap:OpenWorldMapMode("POST_SHOP_ROUTE", "SHOP_EXIT", state.Completion.LastCompletedContentId) end
		log("[RunShopExit] completed route=" .. state.Completion.LastCompletedContentId)
	end

	@ExecSpace("ClientOnly")
	method void HandleCloseResult(boolean success, string reason)
		if success then return end
		self.ClosePending = false
		log_warning("[RunShopExit] close rejected reason=" .. reason)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self.TouchHandler ~= nil then self.Entity:DisconnectEvent(TouchEvent, self.TouchHandler) end
	end

end
