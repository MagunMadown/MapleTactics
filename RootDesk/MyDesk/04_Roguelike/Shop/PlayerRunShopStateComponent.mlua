@Component
script PlayerRunShopStateComponent extends Component

	@TargetUserSync property integer ActiveRunSequence = 0
	@TargetUserSync property string ShopState = "IDLE"
	@TargetUserSync property string ActiveShopId = ""
	@TargetUserSync property integer VisitSequence = 0
	@TargetUserSync property string VisitKey = ""
	@TargetUserSync property string OfferSnapshot = ""
	@TargetUserSync property string PurchasedOfferIds = ""
	@TargetUserSync property string LastPurchaseOfferId = ""
	@TargetUserSync property boolean LastPurchaseSuccess = false
	@TargetUserSync property string LastPurchaseReason = ""
	@TargetUserSync property string LastCloseReason = ""
	@TargetUserSync property integer ShopRevision = 0
	property string AppliedPurchaseRequestKeys = ""

	@ExecSpace("ServerOnly")
	method table Open(integer runSequence, string shopId, string visitKey, string offerSnapshot)
		if runSequence <= 0 or shopId == "" or visitKey == "" or offerSnapshot == "" then
			return { Success = false, Reason = "INVALID_SHOP_OPEN_CONTEXT" }
		end
		if self.ShopState == "OPEN" and self.ActiveRunSequence == runSequence and self.ActiveShopId == shopId and self.VisitKey == visitKey then
			local snapshot = self:GetSnapshot()
			snapshot.Reason = "SHOP_ALREADY_OPEN"
			return snapshot
		end
		self.ActiveRunSequence = runSequence
		self.ActiveShopId = shopId
		self.VisitSequence = self.VisitSequence + 1
		self.VisitKey = visitKey
		self.OfferSnapshot = offerSnapshot
		self.PurchasedOfferIds = ""
		self.LastPurchaseOfferId = ""
		self.LastPurchaseSuccess = false
		self.LastPurchaseReason = "SHOP_OPENED"
		self.LastCloseReason = ""
		self.AppliedPurchaseRequestKeys = ""
		self.ShopState = "OPEN"
		self.ShopRevision = self.ShopRevision + 1
		log("[RunShopState] opened shop=" .. shopId .. " visit=" .. self.VisitSequence .. " offers=" .. offerSnapshot .. " revision=" .. self.ShopRevision)
		return self:GetSnapshot()
	end

	@ExecSpace("ServerOnly")
	method table Close(integer runSequence, string shopId, string reason)
		-- Closes the active visit after the shared run-flow completion has committed.
		if self.ShopState == "CLOSED" and self.ActiveRunSequence == runSequence and self.ActiveShopId == shopId then
			local duplicate = self:GetSnapshot()
			duplicate.Reason = "SHOP_ALREADY_CLOSED"
			return duplicate
		end
		if self.ShopState ~= "OPEN" or self.ActiveRunSequence ~= runSequence or self.ActiveShopId ~= shopId then
			return { Success = false, Reason = "SHOP_CLOSE_CONTEXT_MISMATCH" }
		end
		self.ShopState = "CLOSED"
		self.LastCloseReason = reason or "SHOP_COMPLETED"
		self.ShopRevision = self.ShopRevision + 1
		log("[RunShopState] closed shop=" .. self.ActiveShopId .. " visit=" .. self.VisitSequence .. " reason=" .. self.LastCloseReason .. " revision=" .. self.ShopRevision)
		local snapshot = self:GetSnapshot()
		snapshot.Reason = self.LastCloseReason
		return snapshot
	end

	@ExecSpace("ServerOnly")
	method boolean IsOfferPurchased(string shopEntryId)
		return string.find("|" .. self.PurchasedOfferIds .. "|", "|" .. shopEntryId .. "|", 1, true) ~= nil
	end

	@ExecSpace("ServerOnly")
	method boolean IsPurchaseRequestApplied(string requestKey)
		return string.find("|" .. self.AppliedPurchaseRequestKeys .. "|", "|" .. requestKey .. "|", 1, true) ~= nil
	end

	@ExecSpace("ServerOnly")
	method void MarkPurchaseRequestApplied(string requestKey)
		if self:IsPurchaseRequestApplied(requestKey) then
			return
		end
		self.AppliedPurchaseRequestKeys = self.AppliedPurchaseRequestKeys == "" and requestKey or self.AppliedPurchaseRequestKeys .. "|" .. requestKey
	end

	@ExecSpace("ServerOnly")
	method void PublishPurchaseResult(string shopEntryId, boolean success, string reason)
		self.LastPurchaseOfferId = shopEntryId or ""
		self.LastPurchaseSuccess = success
		self.LastPurchaseReason = reason or "UNKNOWN"
		self.ShopRevision = self.ShopRevision + 1
	end

	@ExecSpace("ServerOnly")
	method table MarkPurchased(string shopEntryId, string reason)
		if self:IsOfferPurchased(shopEntryId) == false then
			self.PurchasedOfferIds = self.PurchasedOfferIds == "" and shopEntryId or self.PurchasedOfferIds .. "|" .. shopEntryId
		end
		self:PublishPurchaseResult(shopEntryId, true, reason)
		log("[RunShopState] purchased shop=" .. self.ActiveShopId .. " entry=" .. shopEntryId .. " visit=" .. self.VisitSequence .. " reason=" .. reason .. " revision=" .. self.ShopRevision)
		return self:GetSnapshot()
	end

	@ExecSpace("ServerOnly")
	method table GetSnapshot()
		return {
			Success = true,
			Reason = self.LastPurchaseReason,
			RunSequence = self.ActiveRunSequence,
			ShopState = self.ShopState,
			ShopId = self.ActiveShopId,
			VisitSequence = self.VisitSequence,
			OfferSnapshot = self.OfferSnapshot,
			PurchasedOfferIds = self.PurchasedOfferIds,
			LastPurchaseOfferId = self.LastPurchaseOfferId,
			LastPurchaseSuccess = self.LastPurchaseSuccess,
			LastPurchaseReason = self.LastPurchaseReason,
			LastCloseReason = self.LastCloseReason,
			Revision = self.ShopRevision
		}
	end

end
