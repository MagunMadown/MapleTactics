@Logic
script RunShopLogic extends Logic

	@ExecSpace("ServerOnly")
	method any GetOrCreateShopState(Entity playerEntity)
		if isvalid(playerEntity) == false or playerEntity.PlayerComponent == nil then
			return nil
		end
		local shopState = playerEntity:GetComponent("script.PlayerRunShopStateComponent")
		if shopState == nil then
			shopState = playerEntity:AddComponent("PlayerRunShopStateComponent")
		end
		return shopState
	end

	@ExecSpace("ServerOnly")
	method table ResetPlayerShopState(Entity playerEntity, integer runSequence)
		-- Reset the visit and capture immutable relic definitions at the new-run boundary.
		local shopState = self:GetOrCreateShopState(playerEntity)
		if shopState == nil then
			return { Success = false, Reason = "RUN_SHOP_STATE_UNAVAILABLE" }
		end
		local relics = self:GetOrCreateRelicEffects(playerEntity)
		if relics == nil then return { Success = false, Reason = "RUN_RELIC_STATE_UNAVAILABLE" } end
		local captured = relics:CaptureForRun(runSequence)
		if captured.Success == false then return captured end
		return shopState:ResetForRun(runSequence)
	end

	@ExecSpace("ServerOnly")
	method table OpenShop(Entity playerEntity, string shopId)
		-- Keep an existing visit or draw up to three distinct unowned relics with shared rarity weights.
		local runState = _RunManagerLogic:GetOrCreateRunState(playerEntity)
		local shopState = self:GetOrCreateShopState(playerEntity)
		if runState == nil or shopState == nil then
			return { Success = false, Reason = "RUN_SHOP_STATE_UNAVAILABLE" }
		end
		if runState.RunFlowState ~= "AWAITING_SHOP" or runState.ContentTransitionState ~= "READY"
			or runState.SelectedContentType ~= "SHOP" or runState.SelectedContentId ~= shopId then
			return { Success = false, Reason = "SHOP_TRANSITION_NOT_READY" }
		end
		if shopState.ActiveRunSequence == runState.RunSequence and shopState.VisitKey == runState.LastContentSelectionKey
			and shopState.ActiveShopId == shopId and shopState.ActiveNodeId == runState.SelectedNodeId then
			return shopState:GetSnapshot()
		end
		local relics = self:GetOrCreateRelicEffects(playerEntity)
		local inventory = _RunManagerLogic:GetOrCreateRunInventory(playerEntity)
		if relics == nil or not relics.IsInitialized or relics.ActiveRunSequence ~= runState.RunSequence
			or inventory == nil or inventory.ActiveRunSequence ~= runState.RunSequence then
			return { Success = false, Reason = "RUN_RELIC_SEQUENCE_MISMATCH" }
		end
		local bundle = relics.ShopBundle
		if bundle.Definition.ShopId ~= shopId then return { Success = false, Reason = "INVALID_SHOP_ID" } end
		local nextVisit = shopState.ActiveRunSequence == runState.RunSequence and shopState.VisitSequence + 1 or 1
		local potions = self:BuildPotionOffers(shopId, runState.RunSequence, nextVisit)
		if not potions.Success then return potions end
		local candidates = {}
		for _, entry in ipairs(bundle.Entries) do
			if inventory:GetSnapshotAmount(inventory.RunItemSnapshot, entry.RewardRefId) == 0 and not shopState:IsOfferPurchased(entry.ShopEntryId) then
				table.insert(candidates, entry)
			end
		end
		table.sort(candidates, function(left, right) return left.ShopEntryId < right.ShopEntryId end)
		local relicIds = {}
		for _, entry in ipairs(candidates) do table.insert(relicIds, entry.RewardRefId) end
		local snapshot = ""
		local offeredEntries = {}
		local firstOffered = nil
		for slot = 1, math.min(3, #candidates) do
			local index = relics:SelectRelicIndex(relicIds)
			if index <= 0 then return { Success = false, Reason = "INVALID_RELIC_OFFER_POOL" } end
			local offered = candidates[index]
			if firstOffered == nil then firstOffered = offered end
			offeredEntries[offered.ShopEntryId] = offered
			local definition = relics.Definitions[offered.RewardRefId]
			local row = table.concat({ offered.ShopEntryId, definition.DisplayName, offered.RewardType, offered.RewardRefId,
				tostring(offered.RewardAmount), offered.PriceCurrencyId, tostring(offered.PriceAmount), tostring(offered.DisplayOrder),
				offered.IconImageRUID, offered.ItemCategory, tostring(definition.AttackBonus), tostring(definition.MaxHpBonus),
				tostring(definition.DefenseBonus), definition.EffectDescription }, "~")
			snapshot = snapshot == "" and row or snapshot .. "|" .. row
			table.remove(candidates, index)
			table.remove(relicIds, index)
		end
		for _, entry in ipairs(potions.Entries) do
			offeredEntries[entry.ShopEntryId] = entry
			local row = table.concat({ entry.ShopEntryId, entry.DisplayName, entry.RewardType, entry.RewardRefId,
				"1", entry.PriceCurrencyId, tostring(entry.PriceAmount), tostring(entry.DisplayOrder), entry.IconImageRUID,
				"물약", "0", "0", "0", entry.EffectDescription }, "~")
			snapshot = snapshot == "" and row or snapshot .. "|" .. row
		end
		local opened = shopState:Open(runState.RunSequence, shopId, runState.SelectedNodeId, bundle.Definition.DisplayName, runState.LastContentSelectionKey, snapshot)
		if opened.Success then
			shopState.OfferedEntry = firstOffered or {}
			shopState.OfferedEntries = offeredEntries
			self:CaptureSellCatalog(shopState, relics)
			self:CaptureSkillSellCatalog(playerEntity, shopState)
		end
		return opened
	end

	@ExecSpace("ServerOnly")
	method table BuildPotionOffers(string shopId, integer runSequence, integer visitSequence)
		-- Freeze three potion offers per visit; visit-specific IDs prevent replay and reopen restocking.
		local entries = {}
		for index, id in ipairs({ "red_potion", "orange_potion", "white_potion" }) do
			local definition = _ConsumableDefinitionRepositoryLogic:GetDefinition(id)
			if not definition.Success then return definition end
			local price = _ConsumableDefinitionRepositoryLogic.ShopBasePrices[id] or 0
			if price <= 0 then return { Success = false, Reason = "INVALID_POTION_PRICE" } end
			local displayName = string.gsub(definition.DisplayName, "[~|]", " ")
			local description = string.gsub(definition.Description, "[~|]", " ")
			table.insert(entries, { Success = true, ShopId = shopId, ShopEntryId = "potion:" .. runSequence .. ":" .. visitSequence .. ":" .. id,
				DisplayName = displayName, RewardType = "CONSUMABLE", RewardRefId = id, RewardAmount = 1,
				PriceCurrencyId = "gold", PriceAmount = price, DisplayOrder = 100 + index,
				IconImageRUID = definition.IconKey, EffectDescription = description })
		end
		return { Success = true, Entries = entries }
	end

	@ExecSpace("ServerOnly")
	method void CaptureSellCatalog(any shopState, any relics)
		-- Freeze validated names, art, and 70-percent prices for this visit; clients never submit a price.
		local ids = { "red_potion", "orange_potion", "white_potion", "time_sand", "all_cure_potion" }
		local rows = {}
		shopState.SellCatalog = {}
		shopState.SellItemTypes = {}
		if relics ~= nil and relics.IsInitialized and relics.ActiveRunSequence == shopState.ActiveRunSequence then
			local entries = {}
			for _, entry in ipairs(relics.ShopBundle.Entries or {}) do table.insert(entries, entry) end
			table.sort(entries, function(a, b) return a.DisplayOrder < b.DisplayOrder end)
			for _, entry in ipairs(entries) do
				local definition = relics.Definitions[entry.RewardRefId]
				if definition ~= nil and entry.RewardType == "ITEM" and entry.PriceCurrencyId == "gold" then
					local price = math.max(1, math.floor(entry.PriceAmount * 70 / 100 / math.max(1, entry.RewardAmount)))
					shopState.SellCatalog[entry.RewardRefId] = price
					shopState.SellItemTypes[entry.RewardRefId] = "ITEM"
					local displayName, _ = string.gsub(definition.DisplayName, "[~|]", " ")
					local description, _ = string.gsub(definition.EffectDescription, "[~|]", " ")
					table.insert(rows, table.concat({entry.RewardRefId, displayName, entry.IconImageRUID, tostring(price), description, "ITEM"}, "~"))
				end
			end
		end
		for _, itemId in ipairs(ids) do
			local definition = _ConsumableDefinitionRepositoryLogic:GetDefinition(itemId)
			local basePrice = _ConsumableDefinitionRepositoryLogic.ShopBasePrices[itemId] or 0
			local price = math.floor(basePrice * 70 / 100)
			if definition.Success and price > 0 then
				shopState.SellCatalog[itemId] = price
				shopState.SellItemTypes[itemId] = "CONSUMABLE"
				local displayName, _ = string.gsub(definition.DisplayName, "[~|]", " ")
				local description, _ = string.gsub(definition.Description, "[~|]", " ")
				table.insert(rows, table.concat({ itemId, displayName, definition.IconKey, tostring(price), description, "CONSUMABLE" }, "~"))
			end
		end
		shopState.SellCatalogSnapshot = table.concat(rows, "|")
	end

	@ExecSpace("ServerOnly")
	method table SellItem(Entity playerEntity, string itemId, integer runSequence, integer visitSequence, integer expectedRevision)
		-- Restrict a sale to the owning player's current ready shop visit and inventory revision.
		local runState = _RunManagerLogic:GetOrCreateRunState(playerEntity)
		local shopState = self:GetOrCreateShopState(playerEntity)
		local inventory = _RunManagerLogic:GetOrCreateRunInventory(playerEntity)
		if runState == nil or shopState == nil or inventory == nil then return { Success = false, Reason = "SHOP_NOT_OPEN" } end
		if shopState.ShopState ~= "OPEN" or runSequence ~= runState.RunSequence or runSequence ~= shopState.ActiveRunSequence
			or runSequence ~= inventory.ActiveRunSequence or visitSequence ~= shopState.VisitSequence
			or runState.RunFlowState ~= "AWAITING_SHOP" or runState.SelectedContentType ~= "SHOP"
			or runState.ContentTransitionState ~= "READY" or shopState.ActiveShopId ~= runState.SelectedContentId
			or shopState.ActiveNodeId ~= runState.SelectedNodeId or shopState.VisitKey ~= runState.LastContentSelectionKey then
			return { Success = false, Reason = "SHOP_NOT_OPEN" }
		end
		local price = shopState.SellCatalog[itemId]
		if price == nil or price <= 0 then return { Success = false, Reason = "ITEM_NOT_SELLABLE" } end
		local itemType = shopState.SellItemTypes[itemId]
		local effects = nil
		if itemType == "ITEM" then
			effects = self:GetOrCreateRelicEffects(playerEntity)
			if effects == nil or not effects.IsInitialized or effects.ActiveRunSequence ~= runSequence or effects.Definitions[itemId] == nil then
				return { Success = false, Reason = "RUN_RELIC_SEQUENCE_MISMATCH" }
			end
		end
		local result = inventory:ApplyShopSale(itemId, itemType, price, expectedRevision)
		if result.Success and effects ~= nil then effects:Recalculate() end
		return result
	end

	@ExecSpace("ServerOnly")
	method void CaptureSkillSellCatalog(Entity player, any shopState)
		local inventory = player:GetComponent("script.PlayerRunInventoryComponent")
		local owner = _RunManagerLogic:GetOrCreateRunAugmentState(player)
		if inventory == nil or owner == nil then return end
		for _, id in ipairs(inventory:GetDistinctOwnedSkillIds()) do
			local definition = _SkillDefinitionRepositoryLogic:GetSkillDefinition(id)
			if definition.Success then
				local price = (definition.SkillTier > 1 or #owner:GetSkillAugmentIds(id) > 0) and 40 or 20
				shopState.SellCatalog[id] = price
				shopState.SellItemTypes[id] = "SKILL"
				local name = string.gsub(definition.DisplayName, "[~|]", " ")
				local description = "판매 시 스킬과 증강 제거 / 이후 증강 선택에서 새 기본 스킬 선택 가능"
				local row = table.concat({ id, name, _UpgradeSkillStageLogic:GetSkillIconRuid(definition), tostring(price), description, "SKILL" }, "~")
				shopState.SellCatalogSnapshot = shopState.SellCatalogSnapshot == "" and row or shopState.SellCatalogSnapshot .. "|" .. row
			end
		end
	end

	@ExecSpace("Server")
	method void RequestSellItem(string itemId, integer runSequence, integer visitSequence, integer expectedRevision)
		-- Resolve identity from the RPC sender rather than a client-supplied player.
		local playerEntity = _UserService:GetUserEntityByUserId(senderUserId)
		local result = self:SellItem(playerEntity, itemId, runSequence, visitSequence, expectedRevision)
		self:NotifySaleResult(result.Success, result.Reason, expectedRevision + 1, senderUserId)
	end

	@ExecSpace("Client")
	method void NotifySaleResult(boolean success, string reason, integer committedRevision)
		-- Deliver transaction feedback without placing an RPC on the client-only UI entity.
		local root = _EntityService:GetEntityByPath("/ui/RunShopUI")
		local controller = isvalid(root) and root:GetComponent("script.RunShopUIComponent") or nil
		if controller ~= nil then controller:HandleSaleResult(success, reason, committedRevision) end
	end

	@ExecSpace("ServerOnly")
	method table PurchaseOffer(Entity playerEntity, string shopEntryId, integer requestId)
		-- Accept only the displayed offer and make successful retries idempotent.
		local runState = _RunManagerLogic:GetOrCreateRunState(playerEntity)
		local shopState = self:GetOrCreateShopState(playerEntity)
		if runState == nil or shopState == nil then
			return { Success = false, Reason = "RUN_SHOP_STATE_UNAVAILABLE" }
		end
		if requestId == nil or requestId <= 0 then
			shopState:PublishPurchaseResult(shopEntryId, false, "INVALID_SHOP_PURCHASE_REQUEST")
			return { Success = false, Reason = "INVALID_SHOP_PURCHASE_REQUEST" }
		end
		if shopState.ShopState ~= "OPEN" or shopState.ActiveRunSequence ~= runState.RunSequence
			or shopState.ActiveShopId ~= runState.SelectedContentId or runState.RunFlowState ~= "AWAITING_SHOP"
			or shopState.ActiveNodeId ~= runState.SelectedNodeId or shopState.VisitKey ~= runState.LastContentSelectionKey
			or runState.ContentTransitionState ~= "READY" then
			shopState:PublishPurchaseResult(shopEntryId, false, "SHOP_NOT_OPEN")
			return { Success = false, Reason = "SHOP_NOT_OPEN" }
		end
		local entry = shopState.OfferedEntries[shopEntryId]
		if entry == nil then
			shopState:PublishPurchaseResult(shopEntryId, false, "SHOP_OFFER_MISMATCH")
			return { Success = false, Reason = "SHOP_OFFER_MISMATCH" }
		end
		local requestKey = tostring(runState.RunSequence) .. ":" .. tostring(shopState.VisitSequence) .. ":" .. tostring(requestId)
		if shopState:IsPurchaseRequestApplied(requestKey) then
			return { Success = true, Reason = "DUPLICATE_PURCHASE_REQUEST_IGNORED", ShopEntryId = shopEntryId, Revision = shopState.ShopRevision }
		end
		if shopState:IsOfferPurchased(shopEntryId) then
			shopState:MarkPurchaseRequestApplied(requestKey)
			shopState:PublishPurchaseResult(shopEntryId, true, "DUPLICATE_PURCHASE_IGNORED")
			return { Success = true, Reason = "DUPLICATE_PURCHASE_IGNORED", ShopEntryId = shopEntryId, Revision = shopState.ShopRevision }
		end
		if entry.Success == false then
			shopState:PublishPurchaseResult(shopEntryId, false, entry.Reason)
			return entry
		end
		local purchaseKey = "shop:" .. tostring(runState.RunSequence) .. ":" .. shopEntryId
		local purchase = _RunManagerLogic:ApplyRunShopPurchase(playerEntity, entry, purchaseKey)
		if purchase.Success == false then
			shopState:PublishPurchaseResult(shopEntryId, false, purchase.Reason)
			return purchase
		end
		shopState:MarkPurchaseRequestApplied(requestKey)
		shopState:MarkPurchased(shopEntryId, purchase.Reason)
		purchase.ShopId = shopState.ActiveShopId
		purchase.ShopEntryId = shopEntryId
		purchase.ShopRevision = shopState.ShopRevision
		return purchase
	end

	@ExecSpace("ServerOnly")
	method table CloseShop(Entity playerEntity, integer requestId)
		-- Completes the current SHOP node and closes its visit without requiring a purchase.
		local runState = _RunManagerLogic:GetOrCreateRunState(playerEntity)
		local shopState = self:GetOrCreateShopState(playerEntity)
		if runState == nil or shopState == nil then
			return { Success = false, Reason = "RUN_SHOP_STATE_UNAVAILABLE" }
		end
		if requestId == nil or requestId <= 0 then
			return { Success = false, Reason = "INVALID_SHOP_CLOSE_REQUEST" }
		end
		local completionKey = tostring(runState.RunSequence) .. ":" .. tostring(requestId)
		if runState.LastContentCompletionKey == completionKey then
			local duplicate = shopState:GetSnapshot()
			duplicate.Reason = "DUPLICATE_CONTENT_COMPLETION_IGNORED"
			duplicate.RunFlowState = runState.RunFlowState
			duplicate.RunState = runState.RunState
			return duplicate
		end
		if shopState.ShopState ~= "OPEN" or shopState.ActiveRunSequence ~= runState.RunSequence
			or shopState.ActiveShopId ~= runState.SelectedContentId or runState.RunFlowState ~= "AWAITING_SHOP" then
			return { Success = false, Reason = "SHOP_NOT_OPEN" }
		end
		local flowResult = _RunManagerLogic:CompleteCurrentContent(playerEntity, "SHOP", requestId)
		if flowResult.Success == false then
			return flowResult
		end
		local closed = shopState:Close(shopState.ActiveRunSequence, shopState.ActiveShopId, flowResult.Reason)
		if closed.Success == false then
			return closed
		end
		closed.RunFlowState = flowResult.RunFlowState
		closed.RunState = flowResult.RunState
		closed.NextNodeIds = flowResult.AvailableNodeIds
		closed.CompletionKey = completionKey
		if closed.RunState == "Completed" then
			_StageTransitionManagerLogic:HandleCompletedRunTransition(playerEntity)
		end
		return closed
	end

	@ExecSpace("Server")
	method void RequestOpenShop(string shopId)
		local playerEntity = _UserService:GetUserEntityByUserId(senderUserId)
		local result = self:OpenShop(playerEntity, shopId)
		if result.Success == false then
			log_warning("[RunShop] open rejected user=" .. senderUserId .. " shop=" .. shopId .. " reason=" .. result.Reason)
		end
	end

	@ExecSpace("Server")
	method void RequestOpenSelectedShop()
		-- The client supplies no ShopId; the server opens only the route selected for this run.
		local playerEntity = _UserService:GetUserEntityByUserId(senderUserId)
		local runState = _RunManagerLogic:GetOrCreateRunState(playerEntity)
		local shopId = runState == nil and "" or runState.SelectedContentId
		local result = self:OpenShop(playerEntity, shopId)
		if result.Success == false then
			log_warning("[RunShop] selected open rejected user=" .. senderUserId .. " reason=" .. result.Reason)
			return
		end
		log("[RunShop] selected open accepted user=" .. senderUserId .. " shop=" .. shopId)
	end

	@ExecSpace("Server")
	method void RequestPurchaseOffer(string shopEntryId, integer requestId)
		local playerEntity = _UserService:GetUserEntityByUserId(senderUserId)
		local result = self:PurchaseOffer(playerEntity, shopEntryId, requestId)
		if result.Success == false then
			log_warning("[RunShop] purchase rejected user=" .. senderUserId .. " entry=" .. shopEntryId .. " request=" .. requestId .. " reason=" .. result.Reason)
			return
		end
		log("[RunShop] purchase accepted user=" .. senderUserId .. " entry=" .. shopEntryId .. " request=" .. requestId .. " reason=" .. result.Reason)
	end

	@ExecSpace("Server")
	method void RequestCloseShop(integer requestId)
		-- Lets the owning client finish or skip the active shop through the same completion path.
		local playerEntity = _UserService:GetUserEntityByUserId(senderUserId)
		local result = self:CloseShop(playerEntity, requestId)
		if result.Success == false then
			log_warning("[RunShop] close rejected user=" .. senderUserId .. " request=" .. requestId .. " reason=" .. result.Reason)
			self:NotifyCloseShopResult(false, result.Reason, senderUserId)
			return
		end
		log("[RunShop] close accepted user=" .. senderUserId .. " request=" .. requestId .. " state=" .. (result.RunFlowState or "") .. " reason=" .. result.Reason)
	end

	@ExecSpace("Client")
	method void NotifyCloseShopResult(boolean success, string reason)
		if success then return end
		local exitEntity = _EntityService:GetEntityByPath("/ui/ShopDepartureUI/Controller")
		local exitButton = isvalid(exitEntity) and exitEntity:GetComponent("script.ShopExitButtonComponent") or nil
		if exitButton ~= nil then exitButton:HandleCloseResult(false, reason) end
	end

	@ExecSpace("ClientOnly")
	method table GetLocalShopUiState()
		-- Expose owner-synced display data without reading the server-only catalog.
		local playerEntity = _UserService.LocalPlayer
		if playerEntity == nil then
			return { Success = false, Reason = "LOCAL_PLAYER_UNAVAILABLE" }
		end
		local shopState = playerEntity:GetComponent("script.PlayerRunShopStateComponent")
		local inventory = playerEntity:GetComponent("script.PlayerRunInventoryComponent")
		local runState = playerEntity:GetComponent("script.PlayerRunStateComponent")
		if shopState == nil or inventory == nil or runState == nil then
			return { Success = false, Reason = "RUN_SHOP_STATE_UNAVAILABLE" }
		end
		local hasAvailableOffer = false
		for row in string.gmatch(shopState.OfferSnapshot, "([^|]+)") do
			local offerId = string.match(row, "^([^~]+)~")
			if offerId ~= nil and string.find("|" .. shopState.PurchasedOfferIds .. "|", "|" .. offerId .. "|", 1, true) == nil then hasAvailableOffer = true end
		end
		return {
			Success = true,
			Reason = shopState.ShopState == "CLOSED" and shopState.LastCloseReason or shopState.LastPurchaseReason,
			RevisionKey = tostring(shopState.ShopRevision) .. ":" .. tostring(inventory.InventoryRevision) .. ":" .. tostring(inventory.SkillInventoryRevision) .. ":" .. tostring(runState.RunFlowRevision) .. ":" .. tostring(runState.ContentTransitionRevision),
			ShopState = shopState.ShopState,
			ShopId = shopState.ActiveShopId,
			NodeId = shopState.ActiveNodeId,
			ShopDisplayName = shopState.ShopDisplayName,
			VisitSequence = shopState.VisitSequence,
			RunSequence = shopState.ActiveRunSequence,
			InventoryRevision = inventory.InventoryRevision,
			SellCatalogSnapshot = shopState.SellCatalogSnapshot,
			OfferSnapshot = shopState.OfferSnapshot,
			PurchasedOfferIds = shopState.PurchasedOfferIds,
			CurrencySnapshot = inventory.RunCurrencySnapshot,
			ConsumableSnapshot = inventory.RunConsumableSnapshot,
			SkillSnapshot = inventory.RunSkillSnapshot,
			ItemSnapshot = inventory.RunItemSnapshot,
			LastPurchase = {
				OfferId = shopState.LastPurchaseOfferId,
				Success = shopState.LastPurchaseSuccess,
				Reason = shopState.LastPurchaseReason
			},
			Completion = {
				Reason = shopState.LastCloseReason,
				RunState = runState.RunState,
				RunFlowState = runState.RunFlowState,
				LastCompletedContentType = runState.LastCompletedContentType,
				LastCompletedContentId = runState.LastCompletedContentId
			},
			Commands = {
				CanOpenUi = runState.RunFlowState == "AWAITING_SHOP" and runState.SelectedContentType == "SHOP",
				CanPurchase = shopState.ShopState == "OPEN" and hasAvailableOffer,
				CanClose = shopState.ShopState == "OPEN",
				CanSkip = shopState.ShopState == "OPEN"
			}
		}
	end

	@ExecSpace("ServerOnly")
	method any GetOrCreateRelicEffects(Entity playerEntity)
		-- Attach run-owned effects using the existing runtime component pattern.
		if not isvalid(playerEntity) or playerEntity.PlayerComponent == nil then return nil end
		local effects = playerEntity:GetComponent("script.PlayerRunRelicEffectComponent")
		if effects == nil then effects = playerEntity:AddComponent("PlayerRunRelicEffectComponent") end
		return effects
	end

end
