@Component
script ShopNpcInteractionComponent extends Component

	property any TouchHandler = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self.TouchHandler = self.Entity:ConnectEvent(TouchEvent, self.OnTouched)
		log("[RunShopNPC] interaction ready entity=" .. self.Entity.Name)
	end

	@ExecSpace("ClientOnly")
	method void OnTouched(TouchEvent event)
		-- UI clicks must not pass through to the world NPC, regardless of callback order.
		if _InputService:IsPointerOverUI() or _RunRelicInventoryUILogic.IsOpen then return end
		local uiRoot = _EntityService:GetEntityByPath("/ui/RunShopUI")
		local controller = isvalid(uiRoot) and uiRoot:GetComponent("script.RunShopUIComponent") or nil
		if controller == nil then
			log_warning("[RunShopNPC] UI controller missing")
			return
		end
		controller:OpenUi()
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		if self.TouchHandler ~= nil then self.Entity:DisconnectEvent(TouchEvent, self.TouchHandler) end
	end

end
