@Component
script UnionShopNpcInteractionComponent extends Component

    property any TouchHandler = nil

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Attach to the dedicated lobby NPC alongside its TouchReceiveComponent.
        self.TouchHandler = self.Entity:ConnectEvent(TouchEvent, self.OnTouched)
        log("[UnionShopNPC] interaction ready entity=" .. self.Entity.Name)
    end

    @ExecSpace("ClientOnly")
    method void OnTouched(TouchEvent event)
        -- Reuse the shop UI while respecting the existing lobby modal guards.
        if _InputService:IsPointerOverUI() or _RunRelicInventoryUILogic.IsOpen then return end
        local player = _UserService.LocalPlayer
        if not isvalid(player) or player.CurrentMap ~= self.Entity.CurrentMap then return end
        if _GameSettingsLogic:IsInputBlocked() then return end
        local ui = _EntityService:GetEntityByPath("/ui/RunShopUI")
        local controller = isvalid(ui) and ui:GetComponent("script.RunShopUIComponent") or nil
        if controller ~= nil then controller:OpenUnionUi() end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Release the subscription when the NPC leaves the map.
        if self.TouchHandler ~= nil then self.Entity:DisconnectEvent(TouchEvent, self.TouchHandler) end
        self.TouchHandler = nil
    end
end
