@Logic
script PrototypeWeaponController

	-- TEMPORARY TEST ADAPTER: remove this Logic and its Lobby confirm call when real job equipment data is connected.
	property boolean EnablePrototypeWeaponPreview = true
	property string WarriorSwordRUID = "9edfb2ac8d4948ae9d6d789c99e0b966"
	property string BowmanBowRUID = "67ce4147813d49f5975917ee86777950"
	property string MagicianWandRUID = "061712eadf7d4357a6c306dfd5368860"
	property string ThiefDaggerRUID = "11ccce1ca9224050897b2d59fe14a3bf"
	property string ThiefClawRUID = "c80eb7c8ad1f45988e6d74b1c95a0b13"

	@ExecSpace("ServerOnly")
	method table ApplyJobWeapon(Entity player, string jobId)
		if self.EnablePrototypeWeaponPreview == false then
			return { Success = true, Reason = "PROTOTYPE_WEAPON_PREVIEW_DISABLED", JobId = jobId or "" }
		end
		if isvalid(player) == false then
			return { Success = false, Reason = "PLAYER_UNAVAILABLE" }
		end

		if jobId == "prototype_warrior" or jobId == "Warrior" then
			return self:EquipWeapon(player, MapleAvatarItemCategory.OneHandedWeapon, self.WarriorSwordRUID, "Warrior Sword")
		elseif jobId == "prototype_bowman" or jobId == "Bowman" then
			return self:EquipWeapon(player, MapleAvatarItemCategory.TwoHandedWeapon, self.BowmanBowRUID, "Bowman Bow")
		elseif jobId == "prototype_magician" or jobId == "Magician" then
			return self:EquipWeapon(player, MapleAvatarItemCategory.OneHandedWeapon, self.MagicianWandRUID, "Magician Wand")
		elseif jobId == "prototype_thief" or jobId == "Thief" then
			local state = self:GetOrCreateWeaponState(player)
			if state == nil or state:SetThiefWeaponMode("Dagger") == false then
				return { Success = false, Reason = "WEAPON_STATE_UNAVAILABLE" }
			end
			return self:EquipWeapon(player, MapleAvatarItemCategory.OneHandedWeapon, self.ThiefDaggerRUID, "Thief Dagger")
		end

		return { Success = false, Reason = "UNKNOWN_PROTOTYPE_JOB", JobId = jobId or "" }
	end

	@ExecSpace("ServerOnly")
	method table SetThiefWeaponMode(Entity player, string mode)
		if isvalid(player) == false then
			return { Success = false, Reason = "PLAYER_UNAVAILABLE" }
		end
		if mode ~= "Dagger" and mode ~= "Claw" then
			return { Success = false, Reason = "INVALID_THIEF_WEAPON_MODE", Mode = mode or "" }
		end

		local state = self:GetOrCreateWeaponState(player)
		if state == nil or state:SetThiefWeaponMode(mode) == false then
			return { Success = false, Reason = "WEAPON_STATE_UNAVAILABLE", Mode = mode }
		end
		if mode == "Claw" then
			return self:EquipWeapon(player, MapleAvatarItemCategory.OneHandedWeapon, self.ThiefClawRUID, "Thief Claw")
		end
		return self:EquipWeapon(player, MapleAvatarItemCategory.OneHandedWeapon, self.ThiefDaggerRUID, "Thief Dagger")
	end

	@ExecSpace("ServerOnly")
	method string GetThiefWeaponMode(Entity player)
		if isvalid(player) == false then
			return ""
		end
		local state = player:GetComponent("script.PrototypeWeaponStateComponent")
		if state == nil then
			return "Dagger"
		end
		return state.ThiefWeaponMode
	end

	@ExecSpace("ServerOnly")
	method table EquipWeapon(Entity player, MapleAvatarItemCategory category, string weaponRUID, string weaponName)
		local costume = player.CostumeManagerComponent
		if costume == nil then
			log_error("[PrototypeWeapon] CostumeManagerComponent missing player=" .. player.Name)
			return { Success = false, Reason = "COSTUME_MANAGER_MISSING" }
		end
		if weaponRUID == nil or weaponRUID == "" then
			log_error("[PrototypeWeapon] RUID missing weapon=" .. weaponName)
			return { Success = false, Reason = "WEAPON_RUID_MISSING", WeaponName = weaponName }
		end

		self:ClearCurrentMainWeapon(player)
		costume:SetEquip(category, weaponRUID)
		log("[PrototypeWeapon] equipped player=" .. player.Name .. " weapon=" .. weaponName .. " ruid=" .. weaponRUID)
		return { Success = true, Reason = "OK", WeaponName = weaponName, WeaponRUID = weaponRUID }
	end

	@ExecSpace("ServerOnly")
	method boolean ClearCurrentMainWeapon(Entity player)
		if isvalid(player) == false or player.CostumeManagerComponent == nil then
			return false
		end
		local costume = player.CostumeManagerComponent
		costume:SetEquip(MapleAvatarItemCategory.OneHandedWeapon, "")
		costume:SetEquip(MapleAvatarItemCategory.TwoHandedWeapon, "")
		return true
	end

	@ExecSpace("ServerOnly")
	method any GetOrCreateWeaponState(Entity player)
		local state = player:GetComponent("script.PrototypeWeaponStateComponent")
		if state == nil then
			state = player:AddComponent("PrototypeWeaponStateComponent")
		end
		return state
	end

end
