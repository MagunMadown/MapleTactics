@Logic
script PrototypeWeaponController extends Logic

	property string PreviewWarningKeys = ""

	@ExecSpace("ClientOnly")
	method table GetJobWeaponPreview(string jobId)
		-- Job data carries only the WeaponDefinitions key, never an avatar RUID.
		local jobEntry = nil
		local entries = _LobbyJobSelectionProvider:GetEntries()
		for _, entry in ipairs(entries) do
			if entry.Id == jobId then
				jobEntry = entry
				break
			end
		end
		if jobEntry == nil then
			if _LobbyJobSelectionProvider.EntrySnapshot == nil or _LobbyJobSelectionProvider.EntrySnapshot == "" then
				return { Success = false, Reason = "JOB_CACHE_NOT_READY", JobId = jobId or "", Retryable = true }
			end
			self:LogPreviewWarningOnce(jobId, "JOB_DEFINITION_MISSING")
			return { Success = false, Reason = "JOB_DEFINITION_MISSING", JobId = jobId or "" }
		end

		local previewWeaponId = jobEntry.PreviewWeaponId or ""
		if previewWeaponId == "" then
			self:LogPreviewWarningOnce(jobId, "PREVIEW_WEAPON_ID_MISSING")
			return { Success = false, Reason = "PREVIEW_WEAPON_ID_MISSING", JobId = jobId or "" }
		end

		local weapon = _WeaponDefinitionRepositoryLogic:GetCachedWeaponDefinition(previewWeaponId)
		if weapon == nil then
			self:LogPreviewWarningOnce(jobId, "WEAPON_DEFINITION_RESULT_MISSING")
			return { Success = false, Reason = "WEAPON_DEFINITION_RESULT_MISSING", JobId = jobId or "", PreviewWeaponId = previewWeaponId }
		end
		if weapon.Success == false then
			if weapon.Retryable then
				return { Success = false, Reason = weapon.Reason, JobId = jobId or "", PreviewWeaponId = previewWeaponId, Retryable = true }
			end
			self:LogPreviewWarningOnce(jobId, weapon.Reason)
			return { Success = false, Reason = weapon.Reason, JobId = jobId or "", PreviewWeaponId = previewWeaponId }
		end
		if weapon.WeaponRuid == nil or weapon.WeaponRuid == "" then
			self:LogPreviewWarningOnce(jobId, "WEAPON_RUID_MISSING")
			return { Success = false, Reason = "WEAPON_RUID_MISSING", JobId = jobId or "", PreviewWeaponId = previewWeaponId }
		end

		local category = self:GetCategoryForEquipSlot(weapon.EquipSlot)
		if category == nil then
			self:LogPreviewWarningOnce(jobId, "UNSUPPORTED_EQUIP_SLOT")
			return { Success = false, Reason = "UNSUPPORTED_EQUIP_SLOT", JobId = jobId or "", PreviewWeaponId = previewWeaponId }
		end
		return {
			Success = true,
			Reason = "OK",
			JobId = jobId,
			PreviewWeaponId = previewWeaponId,
			WeaponType = weapon.WeaponType,
			WeaponName = weapon.DisplayName,
			Category = category,
			WeaponRUID = weapon.WeaponRuid,
			SubWeaponRUID = weapon.SubWeaponRuid or ""
		}
	end

	@ExecSpace("ClientOnly")
	method void LogPreviewWarningOnce(string jobId, string reason)
		local warningKey = "|" .. (jobId or "") .. ":" .. (reason or "UNKNOWN") .. "|"
		if string.find(self.PreviewWarningKeys or "", warningKey, 1, true) ~= nil then
			return
		end
		self.PreviewWarningKeys = (self.PreviewWarningKeys or "") .. warningKey
		log_warning("[LobbyClassSelect] preview weapon data missing job=" .. (jobId or "") .. " reason=" .. (reason or "UNKNOWN"))
	end

	method any GetCategoryForEquipSlot(string equipSlot)
		if equipSlot == "ONE_HANDED" then
			return MapleAvatarItemCategory.OneHandedWeapon
		end
		if equipSlot == "TWO_HANDED" then
			return MapleAvatarItemCategory.TwoHandedWeapon
		end
		return nil
	end

	@ExecSpace("ServerOnly")
	method table SetThiefWeaponMode(Entity player, string mode)
		if isvalid(player) == false then
			return { Success = false, Reason = "PLAYER_UNAVAILABLE" }
		end
		if mode ~= "Dagger" and mode ~= "Claw" then
			return { Success = false, Reason = "INVALID_THIEF_WEAPON_MODE", Mode = mode or "" }
		end

		local state = self:GetOrCreateWeaponState(player)
		if state == nil or state:SetThiefWeaponMode(mode) == false then
			return { Success = false, Reason = "WEAPON_STATE_UNAVAILABLE", Mode = mode }
		end
		local weaponType = mode == "Claw" and "CLAW" or "DAGGER"
		local weapon = _WeaponDefinitionRepositoryLogic:GetWeaponDefinition(weaponType)
		if weapon == nil or weapon.Success == false then
			return { Success = false, Reason = weapon == nil and "WEAPON_DEFINITION_RESULT_MISSING" or weapon.Reason, Mode = mode }
		end
		return self:EquipWeaponDefinition(player, weapon)
	end

	@ExecSpace("ServerOnly")
	method string GetThiefWeaponMode(Entity player)
		if isvalid(player) == false then
			return ""
		end
		local state = player:GetComponent("script.PrototypeWeaponStateComponent")
		if state == nil then
			return "Dagger"
		end
		return state.ThiefWeaponMode
	end

	@ExecSpace("ServerOnly")
	method table EquipWeaponDefinition(Entity player, table weapon)
		local costume = player.CostumeManagerComponent
		if costume == nil then
			log_error("[PrototypeWeapon] CostumeManagerComponent missing player=" .. player.Name)
			return { Success = false, Reason = "COSTUME_MANAGER_MISSING" }
		end
		if weapon == nil or weapon.WeaponRuid == nil or weapon.WeaponRuid == "" then
			log_error("[PrototypeWeapon] weapon definition RUID missing")
			return { Success = false, Reason = "WEAPON_RUID_MISSING" }
		end

		local category = self:GetCategoryForEquipSlot(weapon.EquipSlot)
		if category == nil then
			return { Success = false, Reason = "UNSUPPORTED_EQUIP_SLOT", EquipSlot = weapon.EquipSlot or "" }
		end
		self:ClearCurrentWeaponSlots(player)
		costume:SetEquip(category, weapon.WeaponRuid)
		if weapon.SubWeaponRuid ~= nil and weapon.SubWeaponRuid ~= "" then
			costume:SetEquip(MapleAvatarItemCategory.SubWeapon, weapon.SubWeaponRuid)
		end
		log("[PrototypeWeapon] equipped player=" .. player.Name .. " weaponType=" .. weapon.WeaponType .. " ruid=" .. weapon.WeaponRuid)
		return { Success = true, Reason = "OK", WeaponName = weapon.DisplayName, WeaponRUID = weapon.WeaponRuid, WeaponType = weapon.WeaponType }
	end

	@ExecSpace("ServerOnly")
	method boolean ClearCurrentWeaponSlots(Entity player)
		if isvalid(player) == false or player.CostumeManagerComponent == nil then
			return false
		end
		local costume = player.CostumeManagerComponent
		costume:SetEquip(MapleAvatarItemCategory.OneHandedWeapon, "")
		costume:SetEquip(MapleAvatarItemCategory.TwoHandedWeapon, "")
		costume:SetEquip(MapleAvatarItemCategory.SubWeapon, "")
		return true
	end

	@ExecSpace("ServerOnly")
	method any GetOrCreateWeaponState(Entity player)
		local state = player:GetComponent("script.PrototypeWeaponStateComponent")
		if state == nil then
			state = player:AddComponent("PrototypeWeaponStateComponent")
		end
		return state
	end

end
