@Logic
script MonsterCodexProvider

	@Sync property string EntrySnapshot = ""
	property string DataSetName = "EnemyDefinitions"
	property string DefaultIconRuid = "a95cfed2c8fe4d2cb64cbb62db051f92"

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self:RefreshFromSource()
	end

	@ExecSpace("ServerOnly")
	method void RefreshFromSource()
		local dataSet = _DataService:GetTable(self.DataSetName)
		local records = {}
		if dataSet ~= nil then
			for rowIndex = 1, dataSet:GetRowCount() do
				local id = dataSet:GetCell(rowIndex, "EnemyDefinitionId") or ""
				local name = dataSet:GetCell(rowIndex, "DisplayName") or id
				if id ~= "" then
					table.insert(records, self:Encode(id, name, self.DefaultIconRuid, "Maple Tactics에 등장하는 " .. name .. "입니다."))
				end
			end
		end
		self.EntrySnapshot = table.concat(records, "|")
		log("[MonsterCodexProvider] refreshed count=" .. tostring(#records))
	end

	@ExecSpace("ClientOnly")
	method table GetEntries()
		return self:Decode(self.EntrySnapshot, "Monster")
	end

	method string Encode(string id, string name, string icon, string description)
		return id .. "~" .. name .. "~" .. icon .. "~" .. description
	end

	method table Decode(string snapshot, string category)
		local entries = {}
		for record in string.gmatch(snapshot or "", "([^|]+)") do
			local fields = {}
			for field in string.gmatch(record, "([^~]+)") do table.insert(fields, field) end
			if #fields >= 4 then table.insert(entries, { Id=fields[1], Category=category, DisplayName=fields[2], Icon=fields[3], Description=fields[4] }) end
		end
		return entries
	end

end
