@Logic
script LobbyJobSelectionProvider extends Logic

	@Sync property string EntrySnapshot = ""
	property string DataSetName = "JobDefinitions"
	property string StartingSkillDataSetName = "JobStartingSkillEntries"

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		local dataSet = _DataService:GetTable(self.DataSetName)
		local records = {}
		if dataSet ~= nil then
			for rowIndex = 1, dataSet:GetRowCount() do
				local enabled = self:ParseBooleanCell(dataSet:GetCell(rowIndex, "Enabled"))
				local jobId = dataSet:GetCell(rowIndex, "JobId") or ""
				local displayName = dataSet:GetCell(rowIndex, "DisplayName") or jobId
				local startingSkillSetId = dataSet:GetCell(rowIndex, "StartingSkillSetId") or ""
				local previewWeaponId = dataSet:GetCell(rowIndex, "PreviewWeaponId") or ""
				if enabled and jobId ~= "" then
					local startingSkills = self:GetStartingSkills(startingSkillSetId)
					local skill01 = startingSkills[1] or {}
					local skill02 = startingSkills[2] or {}
					table.insert(records,
						jobId .. "~" .. displayName
						.. "~" .. ((skill01.SkillId or "") ~= "" and skill01.SkillId or "정보 없음")
						.. "~" .. ((skill01.DisplayName or "") ~= "" and skill01.DisplayName or "정보 없음")
						.. "~" .. ((skill01.IconRuid or "") ~= "" and skill01.IconRuid or "정보 없음")
						.. "~" .. ((skill02.SkillId or "") ~= "" and skill02.SkillId or "정보 없음")
						.. "~" .. ((skill02.DisplayName or "") ~= "" and skill02.DisplayName or "정보 없음")
						.. "~" .. ((skill02.IconRuid or "") ~= "" and skill02.IconRuid or "정보 없음")
						.. "~" .. (previewWeaponId ~= "" and previewWeaponId or "정보 없음"))
				end
			end
		end
		self.EntrySnapshot = table.concat(records, "|")
		log("[LobbyJobProvider] refreshed count=" .. tostring(#records))
	end

	@ExecSpace("ClientOnly")
	method table GetEntries()
		local entries = {}
		for record in string.gmatch(self.EntrySnapshot or "", "([^|]+)") do
			local fields = {}
			for field in string.gmatch(record, "([^~]+)") do table.insert(fields, field) end
			if #fields >= 9 then
				table.insert(entries, {
					Id = fields[1],
					Name = fields[2],
					Description = "",
					StartingSkill01Id = fields[3] == "정보 없음" and "" or fields[3],
					StartingSkill01 = fields[4] == "정보 없음" and "" or fields[4],
					StartingSkill01IconRuid = fields[5] == "정보 없음" and "" or fields[5],
					StartingSkill02Id = fields[6] == "정보 없음" and "" or fields[6],
					StartingSkill02 = fields[7] == "정보 없음" and "" or fields[7],
					StartingSkill02IconRuid = fields[8] == "정보 없음" and "" or fields[8],
					PreviewWeaponId = fields[9] == "정보 없음" and "" or fields[9]
				})
			elseif #fields >= 5 then
				-- Keeps the client usable while an older server snapshot is still synchronizing.
				table.insert(entries, {
					Id = fields[1],
					Name = fields[2],
					Description = "",
					StartingSkill01Id = "",
					StartingSkill01 = fields[3] == "정보 없음" and "" or fields[3],
					StartingSkill01IconRuid = "",
					StartingSkill02Id = "",
					StartingSkill02 = fields[4] == "정보 없음" and "" or fields[4],
					StartingSkill02IconRuid = "",
					PreviewWeaponId = fields[5] == "정보 없음" and "" or fields[5]
				})
			end
		end
		return entries
	end

	@ExecSpace("ServerOnly")
	method table GetStartingSkills(string startingSkillSetId)
		local skills = {}
		if startingSkillSetId == nil or startingSkillSetId == "" then
			return skills
		end
		local dataSet = _DataService:GetTable(self.StartingSkillDataSetName)
		if dataSet == nil then
			return skills
		end
		local rows = {}
		for rowIndex = 1, dataSet:GetRowCount() do
			if dataSet:GetCell(rowIndex, "StartingSkillSetId") == startingSkillSetId
				and self:ParseBooleanCell(dataSet:GetCell(rowIndex, "Enabled")) then
				table.insert(rows, {
					SlotIndex = math.floor(tonumber(dataSet:GetCell(rowIndex, "SlotIndex")) or 0),
					SkillId = dataSet:GetCell(rowIndex, "SkillId") or ""
				})
			end
		end
		table.sort(rows, function(left, right) return left.SlotIndex < right.SlotIndex end)
		for index = 1, math.min(2, #rows) do
			local skillId = rows[index].SkillId
			local definition = _SkillDefinitionRepositoryLogic:GetSkillDefinition(skillId)
			if definition ~= nil and definition.Success then
				table.insert(skills, {
					SkillId = skillId,
					DisplayName = definition.DisplayName or skillId,
					IconRuid = definition.IconRuid or ""
				})
			else
				table.insert(skills, {
					SkillId = skillId,
					DisplayName = skillId,
					IconRuid = ""
				})
			end
		end
		return skills
	end

	method boolean ParseBooleanCell(any value)
		if value == true then return true end
		local normalized = string.lower(tostring(value or ""))
		return normalized == "true" or normalized == "1" or normalized == "yes"
	end

end
