@Logic
script SkillCodexProvider extends Logic

	@Sync property string EntrySnapshot = ""
	property string DefaultIconRuid = "1705e3c5b2c146ac9a699f96fb067408"

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self:RefreshFromRepository()
	end

	@ExecSpace("ServerOnly")
	method void RefreshFromRepository()
		-- Publishes validated player skills with the raw RequiredJobTag needed by the Codex job filter.
		local records = {}
		-- The Repository owns the shared and per-job skill dataset list. Enemy-only skills stay out of the Codex.
		local skillIds = _SkillDefinitionRepositoryLogic:GetPlayerGrantableSkillIds()
		for _, id in ipairs(skillIds) do
			if id ~= "" then
				local validation = _ContentValidatorLogic:ValidateSkillById(id)
				local definition = _SkillDefinitionRepositoryLogic:GetSkillDefinition(id)
				if validation.Success == true and definition.Success == true then
					local description = self:BuildDescription(definition) .. "\n사용 무기: " .. self:GetWeaponLabel(definition.WeaponType)
					local iconRuid = self:GetSkillIconRuid(definition)
					local typeLabel = self:GetTypeLabel(definition)
					local requiredJobTag = definition.RequiredJobTag or ""
					local jobLabel = self:GetJobLabel(requiredJobTag)
					local targetLabel = self:GetTargetLabel(definition.TargetingType)
					table.insert(records, {
						Id = definition.SkillId, Category = "Skill", DisplayName = definition.DisplayName,
						Icon = iconRuid, Description = description, TypeLabel = typeLabel,
						MetaPrimaryLabel = "사용 직업", MetaPrimaryValue = jobLabel,
						MetaSecondaryLabel = "대상 / 효과", MetaSecondaryValue = targetLabel,
						RequiredJobTag = requiredJobTag, IsDiscovered = true
					})
				else
					local reason = validation.Success == false and validation.Reason or definition.Reason
					log_warning("[SkillCodexProvider] skipped id=" .. id .. " reason=" .. reason)
				end
			end
		end
		self.EntrySnapshot = _HttpService:JSONEncode({ Entries = records })
		log("[SkillCodexProvider] refreshed source=PLAYER_SKILL_REPOSITORY count=" .. tostring(#records))
	end

	method string GetSkillIconRuid(table definition)
		-- Prefers the authored icon: it is the real 32x32 icon sprite from the skill's own resource
		-- pack, which reads better at Codex size than a frame of the effect animation.
		local iconRuid = definition.IconRuid or ""
		if iconRuid ~= "" then
			return iconRuid
		end
		-- No authored icon: fall back to the skill's own effect art as a static thumbnail before
		-- giving up on the placeholder, so an unauthored row still shows something skill-specific.
		local sourceRuid = definition.CastEffectRuid or ""
		if sourceRuid == "" then
			sourceRuid = definition.HitEffectRuid or ""
		end
		if sourceRuid == "" then
			return self.DefaultIconRuid
		end
		return "thumbnail://" .. sourceRuid
	end

	method string BuildDescription(table definition)
		local effects = _SkillDefinitionRepositoryLogic:GetEffectSteps(definition.EffectSetId or "")
		return self:BuildReadableDescription(definition, effects.Success and effects.Steps or {})
	end

	@ExecSpace("ServerOnly")
	method string BuildReadableDescription(table definition, table steps)
		-- One player-facing description for rewards, the codex and live combat; values come from effects.
		local lines = { "재사용 대기: " .. tostring(math.floor(definition.CooldownTurns or 0)) .. "턴", "범위: " .. self:DescribeRange(definition) }
		for _, step in ipairs(steps) do
			local kind = step.EffectType
			local value = _BuffEffectExecutorLogic:FormatNumber(step.Value or 0)
			local text = ""
			if kind == "DAMAGE" then
				local hits = _DamageEffectExecutorLogic:GetHitCount(step)
				text = hits > 1 and ("기본 피해: " .. value .. " × " .. tostring(hits) .. "회 (타격마다 공격력 보너스 적용)") or ("기본 피해: " .. value)
			elseif kind == "HEAL" then text = "회복: HP " .. value
			elseif kind == "PUSH" then text = "밀치기: 대상 " .. value .. "칸"
			elseif kind == "PULL" then text = "끌어오기: 대상 " .. value .. "칸"
			elseif kind == "REDUCE_OWN_COOLDOWN" then text = "이 스킬의 재사용 대기 " .. value .. "턴 감소"
			elseif kind == "PUSH_ADJACENT" then text = "앞뒤 인접한 적을 각각 " .. value .. "칸 밀어냄"
			elseif kind == "NEXT_ARROW" then text = "연계 준비: 다음 공격에 화살 " .. value .. "발 추가"
			elseif kind == "STUN" then text = value .. "% 확률로 " .. tostring(math.max(1, tonumber(step.ParameterA) or 1)) .. "턴 기절"
			elseif kind == "MOVE_SELF" then
				local mode = step.ParameterA or ""
				if mode == "FORWARD_OFFSET" then text = value .. "칸 전진"
				elseif mode == "BACKWARD_OFFSET" then text = value .. "칸 후퇴"
				else text = _MoveSelfEffectExecutorLogic:DescribeMoveStep(step) end
			else text = _BuffEffectExecutorLogic:DescribeEffectSteps({step}) end
			if text ~= "" then
				if step.ConditionId == "PREVIOUS_ATTACK" then text = "연계: 같은 실행 묶음에서 공격 스킬 바로 다음에 사용하면 " .. text end
				if kind ~= "DAMAGE" and kind ~= "HEAL" and kind ~= "NEXT_ARROW" and step.ConditionId ~= "PREVIOUS_ATTACK" then text = "효과: " .. text end
				table.insert(lines, text)
			end
		end
		if definition.SkillId == "heal" then table.insert(lines, "횟수형: 보스 클리어 시 사용 횟수 +1") end
		if definition.FreePlay then table.insert(lines, "즉시 사용: 턴을 소모하지 않음") end
		if (definition.SkillAugmentName or "") ~= "" then table.insert(lines, "증강: " .. definition.SkillAugmentName) end
		return table.concat(lines, "\n")
	end

	method string DescribeRange(table definition)
		if definition.TargetingType == "SELF" then return "자신" end
		if definition.TargetingType == "FRONT_CELL" then return "바라보는 방향의 바로 앞 1칸" end
		local range = tostring(math.floor(definition.Range or 0))
		if definition.TargetingType == "FIRST_ENEMY_FORWARD" then return "전방 " .. range .. "칸 안의 첫 번째 적" end
		if definition.TargetingType == "FIRST_ENEMY_PIERCE" then return "전방 " .. range .. "칸 안의 첫 적과 그 뒤 1칸" end
		local front, back = {}, {}
		for token in string.gmatch(definition.TargetOffsets or "", "[^|]+") do
			local offset = tonumber(token) or 0
			if offset > 0 then table.insert(front, tostring(offset)) elseif offset < 0 then table.insert(back, tostring(-offset)) end
		end
		local labels = {}
		if #front > 0 then table.insert(labels, "앞 " .. table.concat(front, "·") .. "칸") end
		if #back > 0 then table.insert(labels, "뒤 " .. table.concat(back, "·") .. "칸") end
		return #labels > 0 and table.concat(labels, " / ") or "자신의 위치"
	end


	@ExecSpace("ServerOnly")
	method string GetWeaponLabel(string weaponType)
		-- Resolves the authored weapon display name. An empty WeaponType is a legal authoring choice,
		-- and an unresolved one is shown raw so a data mistake is visible in the Codex instead of hidden.
		if weaponType == nil or weaponType == "" then
			return "무기 무관"
		end
		local weapon = _WeaponDefinitionRepositoryLogic:GetWeaponDefinition(weaponType)
		if weapon.Success == false then
			return weaponType
		end
		return weapon.DisplayName
	end

	method string GetTypeLabel(table definition)
		local tags = string.upper(definition.SkillTags or "")
		if string.find(tags, "HEAL", 1, true) ~= nil or string.find(tags, "SUPPORT", 1, true) ~= nil or string.find(tags, "BUFF", 1, true) ~= nil then
			return "지원 스킬"
		end
		if string.find(tags, "MOVE", 1, true) ~= nil or string.find(tags, "MOBILITY", 1, true) ~= nil or string.find(tags, "DASH", 1, true) ~= nil then
			return "이동 스킬"
		end
		return "공격 스킬"
	end

	method string GetJobLabel(string requiredJobTag)
		local jobTag = string.upper(requiredJobTag or "")
		if jobTag == "" then
			return "공용"
		elseif string.find(jobTag, "WARRIOR", 1, true) ~= nil then
			return "전사"
		elseif string.find(jobTag, "MAGE", 1, true) ~= nil then
			return "마법사"
		elseif string.find(jobTag, "ARCHER", 1, true) ~= nil then
			return "궁수"
		elseif string.find(jobTag, "THIEF", 1, true) ~= nil then
			return "도적"
		elseif string.find(jobTag, "PIRATE", 1, true) ~= nil then
			return "해적"
		end
		return requiredJobTag
	end

	method string GetTargetLabel(string targetingType)
		if targetingType == "FRONT_CELL" then
			return "정면 한 칸"
		elseif targetingType == "FIRST_ENEMY_FORWARD" then
			return "전방 첫 번째 적"
		elseif targetingType == "FIRST_ENEMY_PIERCE" then
			return "전방 첫 적 + 뒤 1칸"
		elseif targetingType == "RANGE_OFFSETS" then
			return "지정 범위"
		elseif targetingType == "SELF" then
			return "자신"
		elseif targetingType == nil or targetingType == "" then
			return "정보 없음"
		end
		return targetingType
	end

	@ExecSpace("ClientOnly")
	method table GetEntries()
		-- JSON preserves empty job tags, line breaks and delimiters in descriptions.
		if self.EntrySnapshot == "" then return {} end
		return _HttpService:JSONDecode(self.EntrySnapshot).Entries or {}
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		-- Repaints a catalog opened before the server snapshot arrived.
		if name == "EntrySnapshot" and _LobbyCodexLogic:IsOpen() and _LobbyCodexLogic.ActiveCategory == "Skill" then
			_LobbyCodexLogic:RefreshCodex()
		end
	end

end
