@Logic
script SkillCodexProvider

	@Sync property string EntrySnapshot = ""
	property string DataSetName = "SkillDefinitions"
	property string DefaultIconRuid = "1705e3c5b2c146ac9a699f96fb067408"

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self:RefreshFromRepository()
	end

	@ExecSpace("ServerOnly")
	method void RefreshFromRepository()
		local dataSet = _DataService:GetTable(self.DataSetName)
		local records = {}
		if dataSet == nil then
			self.EntrySnapshot = ""
			log_warning("[SkillCodexProvider] dataset missing name=" .. self.DataSetName)
			return
		end
		for rowIndex = 1, dataSet:GetRowCount() do
			local id = dataSet:GetCell(rowIndex, "SkillId") or ""
			if id ~= "" then
				local validation = _ContentValidatorLogic:ValidateSkillById(id)
				local definition = _SkillDefinitionRepositoryLogic:GetSkillDefinition(id)
				if validation.Success == true and definition.Success == true then
					local description = self:BuildDescription(definition)
					table.insert(records, definition.SkillId .. "~" .. definition.DisplayName .. "~" .. self.DefaultIconRuid .. "~" .. description)
				else
					local reason = validation.Success == false and validation.Reason or definition.Reason
					log_warning("[SkillCodexProvider] skipped id=" .. id .. " reason=" .. reason)
				end
			end
		end
		self.EntrySnapshot = table.concat(records, "|")
		log("[SkillCodexProvider] refreshed source=" .. self.DataSetName .. " count=" .. tostring(#records))
	end

	method string BuildDescription(table definition)
		local targetLabel = definition.TargetingType
		if definition.TargetingType == "FRONT_CELL" then
			targetLabel = "정면 칸"
		elseif definition.TargetingType == "FIRST_ENEMY_FORWARD" then
			targetLabel = "바라보는 방향의 첫 번째 적"
		elseif definition.TargetingType == "RANGE_OFFSETS" then
			targetLabel = "지정된 범위 칸"
		end
		local description = "대상: " .. targetLabel .. " (" .. definition.TargetingType .. "). 범위: " .. tostring(definition.Range) .. ". 재사용 대기: " .. tostring(definition.CooldownTurns) .. "턴."
		if definition.RequiredJobTag ~= nil and definition.RequiredJobTag ~= "" then description = description .. " 직업 요구: " .. definition.RequiredJobTag .. "." end
		if definition.FreePlay == true then description = description .. " FreePlay 사용 가능." end
		return description
	end

	@ExecSpace("ClientOnly")
	method table GetEntries()
		local entries = {}
		for record in string.gmatch(self.EntrySnapshot or "", "([^|]+)") do
			local fields = {}
			for field in string.gmatch(record, "([^~]+)") do table.insert(fields, field) end
			if #fields >= 4 then table.insert(entries, { Id=fields[1], Category="Skill", DisplayName=fields[2], Icon=fields[3], Description=fields[4] }) end
		end
		return entries
	end

end
