@Component
script PrototypeWeaponStateComponent extends Component

	@Sync property string ThiefWeaponMode = "Dagger"

	@ExecSpace("ServerOnly")
	method boolean SetThiefWeaponMode(string mode)
		if mode ~= "Dagger" and mode ~= "Claw" then
			return false
		end
		self.ThiefWeaponMode = mode
		return true
	end

	method string GetThiefWeaponMode()
		return self.ThiefWeaponMode
	end

end
