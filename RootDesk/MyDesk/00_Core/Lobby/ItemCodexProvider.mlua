@Logic
script ItemCodexProvider

	@Sync property string EntrySnapshot = ""
	property string DataSetName = "ConsumableDefinitions"
	property string ConsumableIconRuid = "f02d66457cea4f63b1d9f4abaec1f4ad"

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		self:RefreshFromSource()
	end

	@ExecSpace("ServerOnly")
	method void RefreshFromSource()
		local records = {}
		local dataSet = _DataService:GetTable(self.DataSetName)
		if dataSet == nil then
			self.EntrySnapshot = ""
			log_warning("[ItemCodexProvider] dataset missing name=" .. self.DataSetName)
			return
		end
		for rowIndex = 1, dataSet:GetRowCount() do
			local id = dataSet:GetCell(rowIndex, "ConsumableId") or ""
			local name = dataSet:GetCell(rowIndex, "DisplayName") or id
			if id ~= "" and self:ParseBooleanCell(dataSet:GetCell(rowIndex, "Enabled")) then
				local effectType = dataSet:GetCell(rowIndex, "EffectType") or ""
				local effectValue = tonumber(dataSet:GetCell(rowIndex, "EffectValue")) or 0
				local targetType = dataSet:GetCell(rowIndex, "TargetType") or ""
				local maxStack = math.floor(tonumber(dataSet:GetCell(rowIndex, "MaxStack")) or 0)
				local description = self:BuildDescription(effectType, effectValue, targetType, maxStack)
				table.insert(records, id .. "~" .. name .. "~" .. self.ConsumableIconRuid .. "~" .. description)
			end
		end
		self.EntrySnapshot = table.concat(records, "|")
		log("[ItemCodexProvider] refreshed source=" .. self.DataSetName .. " count=" .. tostring(#records))
	end

	method string BuildDescription(string effectType, number effectValue, string targetType, integer maxStack)
		local description = ""
		if effectType == "HEAL" and effectValue > 0 then
			description = "체력을 " .. tostring(effectValue) .. " 회복합니다."
		elseif effectType ~= "" then
			description = effectType .. " 효과를 적용합니다."
		else
			description = "소비 아이템입니다."
		end
		if targetType == "SELF" then description = description .. " 자신에게 사용합니다." end
		if maxStack > 0 then description = description .. " 최대 소지 수: " .. tostring(maxStack) end
		return description
	end

	method boolean ParseBooleanCell(any value)
		if value == true then return true end
		local normalized = string.lower(tostring(value or ""))
		return normalized == "true" or normalized == "1" or normalized == "yes"
	end

	@ExecSpace("ClientOnly")
	method table GetEntries()
		local entries = {}
		for record in string.gmatch(self.EntrySnapshot or "", "([^|]+)") do
			local fields = {}
			for field in string.gmatch(record, "([^~]+)") do table.insert(fields, field) end
			if #fields >= 4 then table.insert(entries, { Id=fields[1], Category="Item", DisplayName=fields[2], Icon=fields[3], Description=fields[4] }) end
		end
		return entries
	end

end
