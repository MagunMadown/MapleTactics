@Logic
script ItemCodexProvider extends Logic

	@Sync property string EntrySnapshot = ""

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- Publishes consumables and relics through their gameplay repositories.
		self:RefreshFromSource()
	end

	@ExecSpace("ServerOnly")
	method void RefreshFromSource()
		-- Loads sources independently so one unavailable catalog does not hide the other.
		local entries = {}
		self:AppendConsumables(entries)
		local consumableCount = #entries
		self:AppendRelics(entries)
		self.EntrySnapshot = _HttpService:JSONEncode({ Entries = entries })
		log("[ItemCodexProvider] refreshed consumables=" .. tostring(consumableCount) .. " relics=" .. tostring(#entries - consumableCount))
	end

	@ExecSpace("ServerOnly")
	method void AppendConsumables(table entries)
		-- Uses validated gameplay definitions, including authored descriptions and icons.
		local dataSet = _DataService:GetTable(_ConsumableDefinitionRepositoryLogic.DataSetName)
		if dataSet == nil then
			log_warning("[ItemCodexProvider] consumable dataset missing")
			return
		end
		for rowIndex = 1, dataSet:GetRowCount() do
			local id = dataSet:GetCell(rowIndex, "ConsumableId") or ""
			local definition = _ConsumableDefinitionRepositoryLogic:GetDefinition(id)
			if definition.Success then
				local targetLabel = definition.TargetType == "SELF" and "자신" or "보유 스킬 하나"
				table.insert(entries, {
					Id = "Consumable:" .. id, ItemKind = "Consumable", Category = "Item",
					DisplayName = definition.DisplayName, Icon = definition.IconKey,
					Description = definition.Description, TypeLabel = "소비 아이템",
					MetaPrimaryLabel = "사용 대상", MetaPrimaryValue = targetLabel,
					MetaSecondaryLabel = "최대 소지 수", MetaSecondaryValue = tostring(definition.MaxStack),
					IsDiscovered = true
				})
			elseif definition.Reason ~= "CONSUMABLE_DISABLED" then
				log_warning("[ItemCodexProvider] consumable skipped id=" .. id .. " reason=" .. definition.Reason)
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void AppendRelics(table entries)
		-- Derives effects from gameplay bonuses and preserves authored thumbnail prefixes.
		local catalog = _RelicDefinitionRepositoryLogic:GetAllDefinitions()
		if catalog.Success == false then
			log_warning("[ItemCodexProvider] relic catalog unavailable reason=" .. catalog.Reason)
			return
		end
		local ids = {}
		for id, _ in pairs(catalog.Definitions) do table.insert(ids, id) end
		table.sort(ids)
		for _, id in ipairs(ids) do
			local definition = catalog.Definitions[id]
			table.insert(entries, {
				Id = "Relic:" .. id, ItemKind = "Relic", Category = "Item",
				DisplayName = definition.DisplayName, Icon = definition.IconImageRUID,
				Description = definition.EffectDescription, TypeLabel = "유물",
				MetaPrimaryLabel = "효과", MetaPrimaryValue = definition.EffectDescription,
				MetaSecondaryLabel = "적용 방식", MetaSecondaryValue = "보유 시 자동 적용",
				IsDiscovered = true
			})
		end
	end

	@ExecSpace("ClientOnly")
	method table GetEntries()
		-- Reads only synchronized public display data on the client.
		if self.EntrySnapshot == "" then return {} end
		local snapshot = _HttpService:JSONDecode(self.EntrySnapshot)
		return snapshot.Entries or {}
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		-- Refreshes late-arriving data without resetting the selected item kind.
		if name == "EntrySnapshot" and _LobbyCodexLogic:IsOpen() and _LobbyCodexLogic.ActiveCategory == "Item" then
			_LobbyCodexLogic:RefreshCodex()
		end
	end

end
