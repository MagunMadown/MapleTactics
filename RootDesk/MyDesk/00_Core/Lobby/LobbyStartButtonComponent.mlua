@Component
script LobbyStartButtonComponent extends Component

	property string StartButtonPath = "/ui/DefaultGroup/LobbyStartButton"
	property ButtonComponent StartButton = nil
	property TextGUIRendererComponent StartButtonText = nil
	property any StartClickHandler = nil
	property boolean IsStartingBattle = false
	property boolean WasInLobby = false

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- Connects the persistent UI root to the lobby-only battle start button.
		if self:ResolveButtonBinding() == false then
			log_error("[Lobby] battle start unavailable reason=UI_BINDING_MISSING")
			return
		end
		self.StartClickHandler = self.StartButton.Entity:ConnectEvent(ButtonClickEvent, self.OnStartButtonClicked)
		self:RefreshLobbyVisibility(true)
		log("[Lobby] battle start button ready")
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- Shows the persistent button only while the local player is inside the lobby map.
		self:RefreshLobbyVisibility(false)
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- Releases the click event owned by the persistent UI controller.
		if self.StartButton ~= nil and isvalid(self.StartButton.Entity) and self.StartClickHandler ~= nil then
			self.StartButton.Entity:DisconnectEvent(ButtonClickEvent, self.StartClickHandler)
		end
		self.StartClickHandler = nil
	end

	@ExecSpace("ClientOnly")
	method void OnStartButtonClicked()
		-- Validates the lobby-facing prerequisites and opens the shared world map.
		if self:IsLocalPlayerInLobby() == false then
			return
		end
		if self.IsStartingBattle then
			log("[Lobby] battle start ignored - entry already in progress")
			return
		end

		local selectedJobId = _LobbyCharacterSelectionLogic:GetSelectedClassId()
		if selectedJobId == nil or selectedJobId == "" then
			self:HandleBattleEntryResult(false, "JOB_NOT_SELECTED")
			return
		end

		self.IsStartingBattle = true
		self:SetButtonEnabled(false)
		log("[Lobby] battle start clicked jobId=" .. selectedJobId)

		local uiRoot = _EntityService:GetEntityByPath("/ui/DefaultGroup")
		local minimapUI = nil
		if isvalid(uiRoot) then
			minimapUI = uiRoot:GetComponent("script.MinimapUI")
		end
		if minimapUI == nil or minimapUI:OpenWorldMap("LOBBY_START") == false then
			self:HandleBattleEntryResult(false, "WORLD_MAP_UNAVAILABLE")
			return
		end

		log("[Lobby] world map opened jobId=" .. selectedJobId)
	end

	@ExecSpace("ClientOnly")
	method void HandleWorldMapClosed()
		-- Restores the lobby start button after the world map closes without transferring.
		if self:IsLocalPlayerInLobby() == false then
			return
		end
		self.IsStartingBattle = false
		self:SetButtonEnabled(true)
		log("[Lobby] battle start unlocked reason=WORLD_MAP_CLOSED")
	end

	@ExecSpace("ClientOnly")
	method void HandleBattleEntryResult(boolean success, string reason)
		-- Keeps the button locked for a successful transfer and restores it after any rejected request.
		if success then
			log("[Lobby] battle start accepted reason=" .. reason)
			return
		end

		self.IsStartingBattle = false
		self:SetButtonText("게임 시작")
		self:SetButtonEnabled(self:IsLocalPlayerInLobby())
		log_warning("[Lobby] battle start failed reason=" .. reason)
	end

	@ExecSpace("ClientOnly")
	method void RefreshLobbyVisibility(boolean forceRefresh)
		-- Resets transient client state only when crossing into or out of the lobby map.
		local isInLobby = self:IsLocalPlayerInLobby()
		if forceRefresh == false and isInLobby == self.WasInLobby then
			return
		end

		self.WasInLobby = isInLobby
		if self:ResolveButtonBinding() == false then
			return
		end
		self.StartButton.Entity:SetEnable(isInLobby)
		if isInLobby then
			self.IsStartingBattle = false
			self:SetButtonText("게임 시작")
			self:SetButtonEnabled(true)
		end
	end

	@ExecSpace("ClientOnly")
	method boolean IsLocalPlayerInLobby()
		-- Identifies the existing lobby map without interpreting any StageId or MapId.
		local player = _UserService.LocalPlayer
		return isvalid(player) and isvalid(player.CurrentMap) and player.CurrentMap.Name == "lobby"
	end

	@ExecSpace("ClientOnly")
	method boolean ResolveButtonBinding()
		-- Resolves the builder-authored button and its native components by stable UI path.
		if self.StartButton ~= nil and isvalid(self.StartButton.Entity) then
			return true
		end

		local buttonEntity = _EntityService:GetEntityByPath(self.StartButtonPath)
		if isvalid(buttonEntity) == false then
			return false
		end
		self.StartButton = buttonEntity.ButtonComponent
		self.StartButtonText = buttonEntity.TextGUIRendererComponent
		return self.StartButton ~= nil and self.StartButtonText ~= nil
	end

	@ExecSpace("ClientOnly")
	method void SetButtonEnabled(boolean enabled)
		-- Enables or disables input while retaining the visible button state.
		if self.StartButton ~= nil then
			self.StartButton.Enable = enabled
		end
	end

	@ExecSpace("ClientOnly")
	method void SetButtonText(string text)
		-- Updates the button label for normal and transfer-in-progress states.
		if self.StartButtonText ~= nil then
			self.StartButtonText.Text = text
		end
	end

end
