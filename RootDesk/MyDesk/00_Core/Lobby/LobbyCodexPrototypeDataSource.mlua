@Logic
script LobbyCodexPrototypeDataSource extends Logic

	@ExecSpace("ClientOnly")
	method table GetEntries(string category)
		-- Returns presentation-only entries so the UI can later swap to repository adapters unchanged.
		if category == "Monster" then
			return self:GetMonsterEntries()
		end
		if category == "Item" then
			return self:GetItemEntries()
		end
		if category == "Skill" then
			return self:GetSkillEntries()
		end
		return {}
	end

	@ExecSpace("ClientOnly")
	method table GetMonsterEntries()
		-- Builds the temporary monster codex preview rows.
		return {
			{ Id="dummy_slime", Category="Monster", DisplayName="슬라임", Icon="50faf654ee5d479cb2958edce9feaef0", Description="말랑말랑한 몸으로 통통 튀어 다니는 숲의 작은 몬스터입니다.", TypeLabel="일반 몬스터", MetaPrimaryLabel="출현 지역", MetaPrimaryValue="초록 숲길", MetaSecondaryLabel="기본 속성", MetaSecondaryValue="근접형", IsDiscovered=true },
			{ Id="dummy_evil_eye", Category="Monster", DisplayName="이블아이", Icon="81f20348f7c24712922569a2ea4eb0db", Description="커다란 눈으로 모험가를 노려보다가 어둠 속에서 기습합니다.", TypeLabel="일반 몬스터", MetaPrimaryLabel="출현 지역", MetaPrimaryValue="깊은 나무굴", MetaSecondaryLabel="기본 속성", MetaSecondaryValue="원거리형", IsDiscovered=true },
			{ Id="dummy_mushmom", Category="Monster", DisplayName="머쉬맘", Icon="86015373d23b4b05bb8fcc6086354652", Description="거대한 갓 아래 신비한 힘을 품은 버섯들의 우두머리입니다.", TypeLabel="보스 몬스터", MetaPrimaryLabel="출현 지역", MetaPrimaryValue="버섯 언덕", MetaSecondaryLabel="기본 속성", MetaSecondaryValue="보스", IsDiscovered=false }
		}
	end

	@ExecSpace("ClientOnly")
	method table GetItemEntries()
		-- Builds the temporary item codex preview rows.
		return {
			{ Id="dummy_red_potion", Category="Item", DisplayName="빨간 포션", Icon="234aca1a4ce946119b68e3717991e775", Description="달콤한 약초 향이 나는 작은 회복 물약입니다.", TypeLabel="일반 소비 아이템", MetaPrimaryLabel="분류", MetaPrimaryValue="회복 물약", MetaSecondaryLabel="획득처 / 용도", MetaSecondaryValue="상점 · 체력 회복", IsDiscovered=true },
			{ Id="dummy_blue_potion", Category="Item", DisplayName="파란 포션", Icon="7e9b39b73f4945b1a8d77db6c99a6946", Description="맑은 마력이 담겨 은은하게 빛나는 파란 물약입니다.", TypeLabel="일반 소비 아이템", MetaPrimaryLabel="분류", MetaPrimaryValue="마력 물약", MetaSecondaryLabel="획득처 / 용도", MetaSecondaryValue="상점 · 자원 회복", IsDiscovered=true },
			{ Id="dummy_wooden_sword", Category="Item", DisplayName="나무 검", Icon="76d3f1c6cc624233955614d1562cc2bd", Description="초보 모험가가 기본기를 익힐 때 사용하는 가벼운 검입니다.", TypeLabel="일반 장비", MetaPrimaryLabel="분류", MetaPrimaryValue="무기", MetaSecondaryLabel="획득처 / 용도", MetaSecondaryValue="훈련장 · 기본 공격", IsDiscovered=false }
		}
	end

	@ExecSpace("ClientOnly")
	method table GetSkillEntries()
		-- Builds the temporary skill codex preview rows.
		return {
			{ Id="dummy_power_strike", Category="Skill", DisplayName="파워 스트라이크", Icon="e4acdf27d68549db8858d6082169c70c", Description="힘을 모아 전방의 적 하나를 강하게 내려칩니다.", TypeLabel="공격 스킬", MetaPrimaryLabel="사용 직업", MetaPrimaryValue="전사", MetaSecondaryLabel="간단 효과", MetaSecondaryValue="전방 단일 대상 강타", IsDiscovered=true },
			{ Id="dummy_dash", Category="Skill", DisplayName="대시", Icon="312640bfa2a240c8854495427a69688d", Description="짧은 거리를 빠르게 이동해 유리한 위치를 선점합니다.", TypeLabel="이동 스킬", MetaPrimaryLabel="사용 직업", MetaPrimaryValue="공용", MetaSecondaryLabel="간단 효과", MetaSecondaryValue="전방 빠른 이동", IsDiscovered=true },
			{ Id="dummy_magic_claw", Category="Skill", DisplayName="매직 클로", Icon="ae459686fc6a4ba08798c66c9cf209b9", Description="마력으로 만든 날카로운 발톱을 날려 적을 공격합니다.", TypeLabel="공격 스킬", MetaPrimaryLabel="사용 직업", MetaPrimaryValue="마법사", MetaSecondaryLabel="간단 효과", MetaSecondaryValue="마법 투사체 2회", IsDiscovered=false }
		}
	end

end
