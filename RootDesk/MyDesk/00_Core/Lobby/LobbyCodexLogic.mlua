@Logic
script LobbyCodexLogic

	property string PopupPath = "/ui/CodexUI/Popup"
	property string RootPath = "/ui/CodexUI"
	property string PreviewPath = "/ui/CodexUI/Popup/MainPanel/ContentArea/DetailPanel/PreviewContainer/PreviewImage"
	property string DetailNamePath = "/ui/CodexUI/Popup/MainPanel/ContentArea/DetailPanel/NameText"
	property string DetailDescriptionPath = "/ui/CodexUI/Popup/MainPanel/ContentArea/DetailPanel/DescriptionText"
	property string MonsterTabPath = "/ui/CodexUI/Popup/MainPanel/TabBar/MonsterTab"
	property string ItemTabPath = "/ui/CodexUI/Popup/MainPanel/TabBar/ItemTab"
	property string SkillTabPath = "/ui/CodexUI/Popup/MainPanel/TabBar/SkillTab"
	property string CloseButtonPath = "/ui/CodexUI/Popup/MainPanel/Header/CloseButton"
	property string EntryContainerPath = "/ui/CodexUI/Popup/MainPanel/ContentArea/EntryPanel/EntryContainer"
	property string EntryTemplatePath = "/ui/CodexUI/Popup/MainPanel/ContentArea/EntryPanel/EntryContainer/EntrySlot_01"

	property Entity Popup = nil
	property Entity Root = nil
	property TextGUIRendererComponent DetailName = nil
	property TextGUIRendererComponent DetailDescription = nil
	property SpriteGUIRendererComponent PreviewImage = nil
	property Entity EntryContainer = nil
	property Entity EntryTemplate = nil
	property any Entries = nil
	property any EventHandles = nil
	property any SlotHandles = nil
	property any SlotEntities = nil
	property string ActiveCategory = "Monster"
	property integer SelectedIndex = 1
	property boolean IsPopupOpen = false
	property boolean IsConnected = false

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self.Entries = {}
		self.EventHandles = {}
		self.SlotHandles = {}
		self.SlotEntities = {}
		self:EnsureUi()
		self:SetPopupEnabled(false)
		log("[LobbyCodex] ready dataDriven=true")
	end

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleEscapeKey(KeyDownEvent event)
		if event.key == KeyboardKey.Escape and self.IsPopupOpen then self:ClosePopup() end
	end

	@ExecSpace("ClientOnly")
	method boolean OpenPopup()
		if self.IsPopupOpen or self:EnsureUi() == false then return false end
		self.IsPopupOpen = true
		self:SetPopupEnabled(true)
		self:RefreshCategory("Monster")
		log("[LobbyCodex] opened")
		return true
	end

	@ExecSpace("ClientOnly")
	method void ClosePopup()
		if self.IsPopupOpen == false then return end
		self.IsPopupOpen = false
		self:SetPopupEnabled(false)
		self:RestoreInteractionPrompt()
		log("[LobbyCodex] closed")
	end

	@ExecSpace("ClientOnly")
	method boolean IsOpen()
		return self.IsPopupOpen
	end

	@ExecSpace("ClientOnly")
	method table GetEntriesForCategory(string category)
		if category == "Monster" then return _MonsterCodexProvider:GetEntries() end
		if category == "Item" then return _ItemCodexProvider:GetEntries() end
		if category == "Skill" then return _SkillCodexProvider:GetEntries() end
		return {}
	end

	@ExecSpace("ClientOnly")
	method void RefreshCodex()
		self:RefreshCategory(self.ActiveCategory)
	end

	@ExecSpace("ClientOnly")
	method void RefreshCategory(string category)
		if category ~= "Monster" and category ~= "Item" and category ~= "Skill" then return end
		self.ActiveCategory = category
		self.Entries = self:GetEntriesForCategory(category)
		self.SelectedIndex = #self.Entries > 0 and 1 or 0
		self:RebuildEntrySlots()
		self:ShowSelectedDetail()
		self:RefreshTabs()
		log("[LobbyCodex] refreshed category=" .. category .. " count=" .. tostring(#self.Entries))
	end

	@ExecSpace("ClientOnly")
	method void BindEntry(integer entryIndex, Entity slotEntity)
		local entry = self.Entries[entryIndex]
		if entry == nil or isvalid(slotEntity) == false then return end
		self.SlotEntities[entryIndex] = slotEntity
		local nameEntity = slotEntity:GetChildByName("EntryName")
		local iconEntity = slotEntity:GetChildByName("EntryIcon")
		if isvalid(nameEntity) and nameEntity.TextGUIRendererComponent ~= nil then nameEntity.TextGUIRendererComponent.Text = entry.DisplayName end
		if isvalid(iconEntity) and iconEntity.SpriteGUIRendererComponent ~= nil then iconEntity.SpriteGUIRendererComponent.ImageRUID = entry.Icon end
		local oldHandle = self.SlotHandles[slotEntity.Id]
		if oldHandle ~= nil then slotEntity:DisconnectEvent(ButtonClickEvent, oldHandle) end
		self.SlotHandles[slotEntity.Id] = slotEntity:ConnectEvent(ButtonClickEvent, function() self:SelectEntry(entryIndex) end)
		self:ApplySelectionState(entryIndex, slotEntity)
	end

	@ExecSpace("ClientOnly")
	method void RebuildEntrySlots()
		for _, slotEntity in pairs(self.SlotEntities) do
			if isvalid(slotEntity) then slotEntity:Destroy() end
		end
		self.SlotEntities = {}
		self.SlotHandles = {}
		for index = 1, #self.Entries do
			local slotEntity = self.EntryTemplate:Clone("CodexEntry_" .. tostring(index))
			if isvalid(slotEntity) then
				slotEntity:SetEnable(true)
				self:BindEntry(index, slotEntity)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void SelectEntry(integer index)
		if index < 1 or index > #self.Entries then return end
		self.SelectedIndex = index
		for slotIndex, slotEntity in pairs(self.SlotEntities) do self:ApplySelectionState(slotIndex, slotEntity) end
		self:ShowSelectedDetail()
		log("[LobbyCodex] entry category=" .. self.ActiveCategory .. " id=" .. self.Entries[index].Id)
	end

	@ExecSpace("ClientOnly")
	method void ApplySelectionState(integer index, Entity slotEntity)
		if isvalid(slotEntity) and slotEntity.SpriteGUIRendererComponent ~= nil then
			slotEntity.SpriteGUIRendererComponent.Color = index == self.SelectedIndex and Color(0.25,0.55,0.82,1) or Color(0.12,0.16,0.22,1)
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowSelectedDetail()
		local selected = self.Entries[self.SelectedIndex]
		if selected == nil then
			self.DetailName.Text = "Coming Soon"
			self.DetailDescription.Text = "표시할 데이터가 없습니다."
			self.PreviewImage.ImageRUID = ""
			return
		end
		self.DetailName.Text = selected.DisplayName
		self.DetailDescription.Text = selected.Description
		self.PreviewImage.ImageRUID = selected.Icon
	end

	@ExecSpace("ClientOnly")
	method boolean EnsureUi()
		if self.IsConnected then return true end
		self.Root = _EntityService:GetEntityByPath(self.RootPath)
		self.Popup = _EntityService:GetEntityByPath(self.PopupPath)
		local preview = _EntityService:GetEntityByPath(self.PreviewPath)
		local detailName = _EntityService:GetEntityByPath(self.DetailNamePath)
		local detailDescription = _EntityService:GetEntityByPath(self.DetailDescriptionPath)
		local container = _EntityService:GetEntityByPath(self.EntryContainerPath)
		local template = _EntityService:GetEntityByPath(self.EntryTemplatePath)
		if isvalid(self.Root) == false or isvalid(self.Popup) == false or isvalid(preview) == false or isvalid(detailName) == false or isvalid(detailDescription) == false or isvalid(container) == false or isvalid(template) == false then return false end
		self.PreviewImage = preview.SpriteGUIRendererComponent
		self.DetailName = detailName.TextGUIRendererComponent
		self.DetailDescription = detailDescription.TextGUIRendererComponent
		self.EntryContainer = container
		self.EntryTemplate = template
		self.EntryTemplate:SetEnable(false)
		local paths = { self.MonsterTabPath, self.ItemTabPath, self.SkillTabPath, self.CloseButtonPath }
		local handlers = { self.OnMonsterTab, self.OnItemTab, self.OnSkillTab, self.OnClose }
		for i=1,#paths do
			local entity = _EntityService:GetEntityByPath(paths[i])
			if isvalid(entity) == false or entity.ButtonComponent == nil then return false end
			self.EventHandles[i] = entity:ConnectEvent(ButtonClickEvent, handlers[i])
		end
		self.IsConnected = true
		return true
	end

	@ExecSpace("ClientOnly")
	method void OnMonsterTab()
		self:RefreshCategory("Monster")
	end

	@ExecSpace("ClientOnly")
	method void OnItemTab()
		self:RefreshCategory("Item")
	end

	@ExecSpace("ClientOnly")
	method void OnSkillTab()
		self:RefreshCategory("Skill")
	end

	@ExecSpace("ClientOnly")
	method void OnClose()
		self:ClosePopup()
	end

	@ExecSpace("ClientOnly")
	method void RefreshTabs()
		self:RefreshTab(self.MonsterTabPath, self.ActiveCategory == "Monster")
		self:RefreshTab(self.ItemTabPath, self.ActiveCategory == "Item")
		self:RefreshTab(self.SkillTabPath, self.ActiveCategory == "Skill")
	end

	@ExecSpace("ClientOnly")
	method void RefreshTab(string path, boolean active)
		local entity = _EntityService:GetEntityByPath(path)
		if isvalid(entity) and entity.SpriteGUIRendererComponent ~= nil then entity.SpriteGUIRendererComponent.Color = active and Color(0.20,0.48,0.78,1) or Color(0.18,0.20,0.25,1) end
	end

	@ExecSpace("ClientOnly")
	method void SetPopupEnabled(boolean enabled)
		if isvalid(self.Root) then self.Root:SetEnable(true) end
		if isvalid(self.Popup) then self.Popup:SetEnable(enabled) end
	end

	@ExecSpace("ClientOnly")
	method void RestoreInteractionPrompt()
		local zone = _EntityService:GetEntityByPath("/maps/loby/Lobby_2F/FutureZones/CodexZone")
		if isvalid(zone) and zone.LobbyInteractionComponent ~= nil and zone.LobbyInteractionComponent.IsPlayerInRange then zone.LobbyInteractionComponent:ShowPrompt() end
	end

end
