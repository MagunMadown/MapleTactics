@Logic
script LobbyCodexLogic

	property string RootPath = "/ui/CodexUI"
	property string PopupPath = "/ui/CodexUI/Popup"
	property string MonsterTabPath = "/ui/CodexUI/Popup/MainPanel/TabBar/MonsterTab"
	property string ItemTabPath = "/ui/CodexUI/Popup/MainPanel/TabBar/ItemTab"
	property string SkillTabPath = "/ui/CodexUI/Popup/MainPanel/TabBar/SkillTab"
	property string FilterAllPath = "/ui/CodexUI/Popup/MainPanel/Body/FilterPanel/FilterAll"
	property string FilterDiscoveredPath = "/ui/CodexUI/Popup/MainPanel/Body/FilterPanel/FilterDiscovered"
	property string FilterLockedPath = "/ui/CodexUI/Popup/MainPanel/Body/FilterPanel/FilterLocked"
	property string CloseButtonPath = "/ui/CodexUI/Popup/MainPanel/Footer/CloseButton"
	property string EntryContainerPath = "/ui/CodexUI/Popup/MainPanel/Body/ListPanel/EntryContainer"
	property string EntryTemplatePath = "/ui/CodexUI/Popup/MainPanel/Body/ListPanel/EntryContainer/EntrySlot_01"
	property string EntryCountPath = "/ui/CodexUI/Popup/MainPanel/Body/ListPanel/EntryCount"
	property string PreviewPath = "/ui/CodexUI/Popup/MainPanel/Body/DetailPanel/PreviewFrame/PreviewImage"
	property string DetailNamePath = "/ui/CodexUI/Popup/MainPanel/Body/DetailPanel/NameText"
	property string DetailTypePath = "/ui/CodexUI/Popup/MainPanel/Body/DetailPanel/TypeText"
	property string DetailDescriptionPath = "/ui/CodexUI/Popup/MainPanel/Body/DetailPanel/DescriptionText"
	property string DetailMetaPrimaryLabelPath = "/ui/CodexUI/Popup/MainPanel/Body/DetailPanel/MetaPrimaryLabel"
	property string DetailMetaPrimaryValuePath = "/ui/CodexUI/Popup/MainPanel/Body/DetailPanel/MetaPrimaryValue"
	property string DetailMetaSecondaryLabelPath = "/ui/CodexUI/Popup/MainPanel/Body/DetailPanel/MetaSecondaryLabel"
	property string DetailMetaSecondaryValuePath = "/ui/CodexUI/Popup/MainPanel/Body/DetailPanel/MetaSecondaryValue"
	property string DiscoveryBadgePath = "/ui/CodexUI/Popup/MainPanel/Body/DetailPanel/DiscoveryBadge"

	property Entity Root = nil
	property Entity Popup = nil
	property Entity EntryContainer = nil
	property Entity EntryTemplate = nil
	property SpriteGUIRendererComponent PreviewImage = nil
	property TextGUIRendererComponent DetailName = nil
	property TextGUIRendererComponent DetailType = nil
	property TextGUIRendererComponent DetailDescription = nil
	property TextGUIRendererComponent DetailMetaPrimaryLabel = nil
	property TextGUIRendererComponent DetailMetaPrimaryValue = nil
	property TextGUIRendererComponent DetailMetaSecondaryLabel = nil
	property TextGUIRendererComponent DetailMetaSecondaryValue = nil
	property TextGUIRendererComponent DiscoveryBadge = nil
	property TextGUIRendererComponent EntryCount = nil
	property any AllEntries = nil
	property any Entries = nil
	property any EventHandles = nil
	property any SlotHandles = nil
	property any SlotEntities = nil
	property string ActiveCategory = "Monster"
	property string ActiveFilter = "All"
	property integer SelectedIndex = 1
	property boolean IsPopupOpen = false
	property boolean IsConnected = false

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- Initializes the presentation-only codex shell and keeps the popup hidden until lobby interaction.
		self.AllEntries = {}
		self.Entries = {}
		self.EventHandles = {}
		self.SlotHandles = {}
		self.SlotEntities = {}
		self:EnsureUi()
		self:SetPopupEnabled(false)
		log("[LobbyCodex] ready source=PROTOTYPE_DUMMY")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- Disconnects persistent button and cloned-slot events owned by this Logic.
		self:ClearEntrySlots()
		for _, binding in pairs(self.EventHandles) do
			if binding ~= nil and isvalid(binding.Entity) and binding.Handle ~= nil then
				binding.Entity:DisconnectEvent(ButtonClickEvent, binding.Handle)
			end
		end
		self.EventHandles = {}
		self.IsConnected = false
	end

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleEscapeKey(KeyDownEvent event)
		-- Closes the codex with the standard PC back action.
		if event.key == KeyboardKey.Escape and self.IsPopupOpen then
			self:ClosePopup()
		end
	end

	@ExecSpace("ClientOnly")
	method boolean OpenPopup()
		-- Opens the codex at the monster tab and refreshes its prototype presentation data.
		if self.IsPopupOpen or self:EnsureUi() == false then
			return false
		end
		self.IsPopupOpen = true
		self:SetPopupEnabled(true)
		self:RefreshCategory("Monster")
		log("[LobbyCodex] opened")
		return true
	end

	@ExecSpace("ClientOnly")
	method void ClosePopup()
		-- Hides the codex and restores the lobby interaction prompt when still in range.
		if self.IsPopupOpen == false then
			return
		end
		self.IsPopupOpen = false
		self:SetPopupEnabled(false)
		self:RestoreInteractionPrompt()
		log("[LobbyCodex] closed")
	end

	@ExecSpace("ClientOnly")
	method boolean IsOpen()
		-- Reports whether the codex popup currently owns lobby input focus.
		return self.IsPopupOpen
	end

	@ExecSpace("ClientOnly")
	method table GetEntriesForCategory(string category)
		-- Reads from the temporary UI data boundary instead of game repositories.
		return _LobbyCodexPrototypeDataSource:GetEntries(category)
	end

	@ExecSpace("ClientOnly")
	method void RefreshCodex()
		-- Rebuilds the active category without changing tab or filter selection.
		self:RefreshList()
	end

	@ExecSpace("ClientOnly")
	method void RefreshCategory(string category)
		-- Changes tabs, resets the filter, and rebuilds the list and detail panels.
		if category ~= "Monster" and category ~= "Item" and category ~= "Skill" then
			return
		end
		self.ActiveCategory = category
		self.ActiveFilter = "All"
		self:RefreshTabs()
		self:RefreshFilters()
		self:RefreshList()
		log("[LobbyCodex] tab changed category=" .. category)
	end

	@ExecSpace("ClientOnly")
	method void SetFilter(string filter)
		-- Applies one of the presentation-only discovery filters.
		if filter ~= "All" and filter ~= "Discovered" and filter ~= "Locked" then
			return
		end
		self.ActiveFilter = filter
		self:RefreshFilters()
		self:RefreshList()
		log("[LobbyCodex] filter changed filter=" .. filter)
	end

	@ExecSpace("ClientOnly")
	method void RefreshList()
		-- Replaces list contents from the active data source and filter.
		self.AllEntries = self:GetEntriesForCategory(self.ActiveCategory)
		self.Entries = {}
		for _, entry in ipairs(self.AllEntries) do
			local includeEntry = self.ActiveFilter == "All"
				or (self.ActiveFilter == "Discovered" and entry.IsDiscovered == true)
				or (self.ActiveFilter == "Locked" and entry.IsDiscovered ~= true)
			if includeEntry then
				table.insert(self.Entries, entry)
			end
		end
		self.SelectedIndex = #self.Entries > 0 and 1 or 0
		self:RebuildEntrySlots()
		self:RefreshEntryCount()
		self:RefreshDetailPanel()
		log("[LobbyCodex] list refreshed category=" .. self.ActiveCategory .. " filter=" .. self.ActiveFilter .. " count=" .. tostring(#self.Entries))
	end

	@ExecSpace("ClientOnly")
	method void RebuildEntrySlots()
		-- Recreates visible list slots from one hidden template under the scroll layout.
		self:ClearEntrySlots()
		for index = 1, #self.Entries do
			local slotEntity = self.EntryTemplate:Clone("CodexEntry_" .. tostring(index))
			if isvalid(slotEntity) then
				slotEntity:SetEnable(true)
				self:BindEntry(index, slotEntity)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void ClearEntrySlots()
		-- Disconnects and destroys every runtime-cloned list slot.
		for _, slotEntity in pairs(self.SlotEntities) do
			if isvalid(slotEntity) then
				local handle = self.SlotHandles[slotEntity.Id]
				if handle ~= nil then
					slotEntity:DisconnectEvent(ButtonClickEvent, handle)
				end
				slotEntity:Destroy()
			end
		end
		self.SlotEntities = {}
		self.SlotHandles = {}
	end

	@ExecSpace("ClientOnly")
	method void BindEntry(integer entryIndex, Entity slotEntity)
		-- Binds one prototype DTO to a reusable list slot and applies discovery presentation.
		local entry = self.Entries[entryIndex]
		if entry == nil or isvalid(slotEntity) == false then
			return
		end
		self.SlotEntities[entryIndex] = slotEntity
		local nameEntity = slotEntity:GetChildByName("EntryName")
		local typeEntity = slotEntity:GetChildByName("EntryType")
		local iconEntity = slotEntity:GetChildByName("EntryIcon")
		local displayName = entry.IsDiscovered == true and entry.DisplayName or "???"
		if isvalid(nameEntity) and nameEntity.TextGUIRendererComponent ~= nil then
			nameEntity.TextGUIRendererComponent.Text = displayName
			nameEntity.TextGUIRendererComponent.FontColor = entry.IsDiscovered == true and Color(0.25,0.14,0.06,1) or Color(0.98,0.82,0.50,1)
		end
		if isvalid(typeEntity) and typeEntity.TextGUIRendererComponent ~= nil then
			typeEntity.TextGUIRendererComponent.Text = entry.IsDiscovered == true and entry.TypeLabel or "미발견"
			typeEntity.TextGUIRendererComponent.FontColor = entry.IsDiscovered == true and Color(0.40,0.27,0.14,1) or Color(0.88,0.69,0.40,1)
		end
		if isvalid(iconEntity) and iconEntity.SpriteGUIRendererComponent ~= nil then
			iconEntity.SpriteGUIRendererComponent.ImageRUID = entry.Icon
			iconEntity.SpriteGUIRendererComponent.Color = entry.IsDiscovered == true and Color(1,1,1,1) or Color(0.36,0.30,0.26,0.72)
		end
		self.SlotHandles[slotEntity.Id] = slotEntity:ConnectEvent(ButtonClickEvent, function()
			self:SelectEntry(entryIndex)
		end)
		self:ApplySelectionState(entryIndex, slotEntity)
	end

	@ExecSpace("ClientOnly")
	method void SelectEntry(integer index)
		-- Selects one visible row and refreshes both selection and detail presentation.
		if index < 1 or index > #self.Entries then
			return
		end
		self.SelectedIndex = index
		for slotIndex, slotEntity in pairs(self.SlotEntities) do
			self:ApplySelectionState(slotIndex, slotEntity)
		end
		self:RefreshDetailPanel()
		log("[LobbyCodex] entry selected category=" .. self.ActiveCategory .. " id=" .. self.Entries[index].Id)
	end

	@ExecSpace("ClientOnly")
	method void ApplySelectionState(integer index, Entity slotEntity)
		-- Uses warm gold for selection and a muted tint for undiscovered rows.
		if isvalid(slotEntity) == false or slotEntity.SpriteGUIRendererComponent == nil then
			return
		end
		local entry = self.Entries[index]
		local isSelected = index == self.SelectedIndex
		if entry ~= nil and entry.IsDiscovered ~= true then
			slotEntity.SpriteGUIRendererComponent.Color = isSelected and Color(0.54,0.43,0.31,1) or Color(0.40,0.33,0.27,0.94)
		else
			slotEntity.SpriteGUIRendererComponent.Color = isSelected and Color(1.00,0.82,0.36,1) or Color(0.98,0.87,0.68,1)
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshDetailPanel()
		-- Displays the selected entry while masking every undiscovered field.
		local selected = self.Entries[self.SelectedIndex]
		if selected == nil then
			self.DetailName.Text = "표시할 항목이 없습니다"
			self.DetailType.Text = ""
			self.DetailDescription.Text = "필터를 변경해 다른 항목을 확인해보세요."
			self.DetailMetaPrimaryLabel.Text = ""
			self.DetailMetaPrimaryValue.Text = ""
			self.DetailMetaSecondaryLabel.Text = ""
			self.DetailMetaSecondaryValue.Text = ""
			self.DiscoveryBadge.Text = "목록 없음"
			self.DiscoveryBadge.FontColor = Color(0.42,0.30,0.18,1)
			self.PreviewImage.ImageRUID = ""
			return
		end

		local discovered = selected.IsDiscovered == true
		self.DetailName.Text = discovered and selected.DisplayName or "???"
		self.DetailType.Text = discovered and selected.TypeLabel or "미발견 항목"
		self.DetailDescription.Text = discovered and selected.Description or "아직 발견하지 못한 항목입니다. 모험을 계속해 정보를 밝혀보세요!"
		self.DetailMetaPrimaryLabel.Text = selected.MetaPrimaryLabel
		self.DetailMetaPrimaryValue.Text = discovered and selected.MetaPrimaryValue or "???"
		self.DetailMetaSecondaryLabel.Text = selected.MetaSecondaryLabel
		self.DetailMetaSecondaryValue.Text = discovered and selected.MetaSecondaryValue or "???"
		self.DiscoveryBadge.Text = discovered and "발견 완료" or "미발견"
		self.DiscoveryBadge.FontColor = discovered and Color(0.20,0.48,0.18,1) or Color(0.62,0.39,0.16,1)
		self.DetailType.FontColor = discovered and Color(0.30,0.20,0.10,1) or Color(0.58,0.37,0.16,1)
		self.PreviewImage.ImageRUID = selected.Icon
		self.PreviewImage.Color = discovered and Color(1,1,1,1) or Color(0.34,0.28,0.24,0.68)
	end

	@ExecSpace("ClientOnly")
	method void RefreshEntryCount()
		-- Shows filtered and total counts for future large data sets.
		if self.EntryCount ~= nil then
			self.EntryCount.Text = tostring(#self.Entries) .. " / " .. tostring(#self.AllEntries) .. " 항목"
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshTabs()
		-- Makes the active top tab immediately distinguishable from inactive tabs.
		self:RefreshButtonState(self.MonsterTabPath, self.ActiveCategory == "Monster")
		self:RefreshButtonState(self.ItemTabPath, self.ActiveCategory == "Item")
		self:RefreshButtonState(self.SkillTabPath, self.ActiveCategory == "Skill")
	end

	@ExecSpace("ClientOnly")
	method void RefreshFilters()
		-- Makes the active left filter immediately distinguishable from inactive filters.
		self:RefreshButtonState(self.FilterAllPath, self.ActiveFilter == "All")
		self:RefreshButtonState(self.FilterDiscoveredPath, self.ActiveFilter == "Discovered")
		self:RefreshButtonState(self.FilterLockedPath, self.ActiveFilter == "Locked")
	end

	@ExecSpace("ClientOnly")
	method void RefreshButtonState(string path, boolean active)
		-- Applies a bright gold selection and a readable caramel inactive state.
		local entity = _EntityService:GetEntityByPath(path)
		if isvalid(entity) and entity.SpriteGUIRendererComponent ~= nil then
			entity.SpriteGUIRendererComponent.Color = active and Color(1.00,0.82,0.34,1) or Color(0.88,0.66,0.38,1)
		end
	end

	@ExecSpace("ClientOnly")
	method boolean EnsureUi()
		-- Resolves the builder-authored UI and connects all stable button events once.
		if self.IsConnected then
			return true
		end
		self.Root = _EntityService:GetEntityByPath(self.RootPath)
		self.Popup = _EntityService:GetEntityByPath(self.PopupPath)
		self.EntryContainer = _EntityService:GetEntityByPath(self.EntryContainerPath)
		self.EntryTemplate = _EntityService:GetEntityByPath(self.EntryTemplatePath)
		local preview = _EntityService:GetEntityByPath(self.PreviewPath)
		local detailName = _EntityService:GetEntityByPath(self.DetailNamePath)
		local detailType = _EntityService:GetEntityByPath(self.DetailTypePath)
		local detailDescription = _EntityService:GetEntityByPath(self.DetailDescriptionPath)
		local metaPrimaryLabel = _EntityService:GetEntityByPath(self.DetailMetaPrimaryLabelPath)
		local metaPrimaryValue = _EntityService:GetEntityByPath(self.DetailMetaPrimaryValuePath)
		local metaSecondaryLabel = _EntityService:GetEntityByPath(self.DetailMetaSecondaryLabelPath)
		local metaSecondaryValue = _EntityService:GetEntityByPath(self.DetailMetaSecondaryValuePath)
		local discoveryBadge = _EntityService:GetEntityByPath(self.DiscoveryBadgePath)
		local entryCount = _EntityService:GetEntityByPath(self.EntryCountPath)
		if isvalid(self.Root) == false or isvalid(self.Popup) == false or isvalid(self.EntryContainer) == false or isvalid(self.EntryTemplate) == false
			or isvalid(preview) == false or isvalid(detailName) == false or isvalid(detailType) == false or isvalid(detailDescription) == false
			or isvalid(metaPrimaryLabel) == false or isvalid(metaPrimaryValue) == false or isvalid(metaSecondaryLabel) == false
			or isvalid(metaSecondaryValue) == false or isvalid(discoveryBadge) == false or isvalid(entryCount) == false then
			log_error("[LobbyCodex] UI binding failed")
			return false
		end

		self.PreviewImage = preview.SpriteGUIRendererComponent
		self.DetailName = detailName.TextGUIRendererComponent
		self.DetailType = detailType.TextGUIRendererComponent
		self.DetailDescription = detailDescription.TextGUIRendererComponent
		self.DetailMetaPrimaryLabel = metaPrimaryLabel.TextGUIRendererComponent
		self.DetailMetaPrimaryValue = metaPrimaryValue.TextGUIRendererComponent
		self.DetailMetaSecondaryLabel = metaSecondaryLabel.TextGUIRendererComponent
		self.DetailMetaSecondaryValue = metaSecondaryValue.TextGUIRendererComponent
		self.DiscoveryBadge = discoveryBadge.TextGUIRendererComponent
		self.EntryCount = entryCount.TextGUIRendererComponent
		if self.PreviewImage == nil or self.DetailName == nil or self.DetailType == nil or self.DetailDescription == nil
			or self.DetailMetaPrimaryLabel == nil or self.DetailMetaPrimaryValue == nil or self.DetailMetaSecondaryLabel == nil
			or self.DetailMetaSecondaryValue == nil or self.DiscoveryBadge == nil or self.EntryCount == nil then
			return false
		end

		self.EntryTemplate:SetEnable(false)
		local connected = self:ConnectButton(self.MonsterTabPath, self.OnMonsterTab, "MonsterTab")
			and self:ConnectButton(self.ItemTabPath, self.OnItemTab, "ItemTab")
			and self:ConnectButton(self.SkillTabPath, self.OnSkillTab, "SkillTab")
			and self:ConnectButton(self.FilterAllPath, self.OnFilterAll, "FilterAll")
			and self:ConnectButton(self.FilterDiscoveredPath, self.OnFilterDiscovered, "FilterDiscovered")
			and self:ConnectButton(self.FilterLockedPath, self.OnFilterLocked, "FilterLocked")
			and self:ConnectButton(self.CloseButtonPath, self.OnClose, "Close")
		if connected == false then
			return false
		end
		self.IsConnected = true
		return true
	end

	@ExecSpace("ClientOnly")
	method boolean ConnectButton(string path, any callback, string key)
		-- Connects one native ButtonClickEvent and records its owner for deterministic cleanup.
		local entity = _EntityService:GetEntityByPath(path)
		if isvalid(entity) == false or entity.ButtonComponent == nil then
			log_error("[LobbyCodex] button binding failed key=" .. key .. " path=" .. path)
			return false
		end
		self.EventHandles[key] = { Entity=entity, Handle=entity:ConnectEvent(ButtonClickEvent, callback) }
		return true
	end

	@ExecSpace("ClientOnly")
	method void OnMonsterTab()
		-- Opens the monster prototype collection.
		self:RefreshCategory("Monster")
	end

	@ExecSpace("ClientOnly")
	method void OnItemTab()
		-- Opens the item prototype collection.
		self:RefreshCategory("Item")
	end

	@ExecSpace("ClientOnly")
	method void OnSkillTab()
		-- Opens the skill prototype collection.
		self:RefreshCategory("Skill")
	end

	@ExecSpace("ClientOnly")
	method void OnFilterAll()
		-- Shows all prototype entries.
		self:SetFilter("All")
	end

	@ExecSpace("ClientOnly")
	method void OnFilterDiscovered()
		-- Shows only discovered prototype entries.
		self:SetFilter("Discovered")
	end

	@ExecSpace("ClientOnly")
	method void OnFilterLocked()
		-- Shows only undiscovered prototype entries.
		self:SetFilter("Locked")
	end

	@ExecSpace("ClientOnly")
	method void OnClose()
		-- Closes the codex from the bottom action button.
		self:ClosePopup()
	end

	@ExecSpace("ClientOnly")
	method void SetPopupEnabled(boolean enabled)
		-- Keeps the global UI group alive while toggling only the popup subtree.
		if isvalid(self.Root) then
			self.Root:SetEnable(true)
		end
		if isvalid(self.Popup) then
			self.Popup:SetEnable(enabled)
		end
	end

	@ExecSpace("ClientOnly")
	method void RestoreInteractionPrompt()
		-- Restores the E-key prompt when the local player remains inside the CodexZone.
		local zone = _EntityService:GetEntityByPath("/maps/loby/Lobby_2F/FutureZones/CodexZone")
		if isvalid(zone) and zone.LobbyInteractionComponent ~= nil and zone.LobbyInteractionComponent.IsPlayerInRange then
			zone.LobbyInteractionComponent:ShowPrompt()
		end
	end

end
