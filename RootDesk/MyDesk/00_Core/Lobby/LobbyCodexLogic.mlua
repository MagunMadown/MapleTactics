@Logic
script LobbyCodexLogic

	property string CollectionGroupPath = "/ui/CollectionUI"
	property string CollectionWindowPath = "/ui/CollectionUI/CollectionWindow"
	property string CollectionFramePath = "/ui/CollectionUI/CollectionWindow/CollectionFrame"
	property string CollectionHeaderPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionHeader"
	property string CollectionCategoryTabsPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionCategoryTabs"
	property string CollectionContentPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionContent"
	property string DiscoveryFilterPanelPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionContent/DiscoveryFilterPanel"
	property string MonsterRegionPanelPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionContent/MonsterRegionPanel"
	property string SelectedMonsterRegion = ""
	property string MonsterGalleryPanelPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionContent/MonsterGalleryPanel"
	property integer MonsterPage = 1
	property string CategoryNavigationPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionContent/CategoryNavigation"
	property boolean MonsterContinentExpanded = true
	property string ExpandedMonsterRegion = ""
	property string CollectionGridPanelPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionContent/CollectionGridPanel"
	property string CollectionDetailPanelPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionContent/CollectionDetailPanel"
	property string MonsterTabButtonPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionCategoryTabs/MonsterTabButton"
	property string ItemTabButtonPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionCategoryTabs/ItemTabButton"
	property string SkillTabButtonPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionCategoryTabs/SkillTabButton"
	property string SkillJobTabsPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/SkillJobTabs"
	property string WarriorTabButtonPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/SkillJobTabs/WarriorTabButton"
	property string ArcherTabButtonPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/SkillJobTabs/ArcherTabButton"
	property string MageTabButtonPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/SkillJobTabs/MageTabButton"
	property string ThiefTabButtonPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/SkillJobTabs/ThiefTabButton"
	property string PirateTabButtonPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/SkillJobTabs/PirateTabButton"
	property string AllEntriesFilterButtonPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionContent/DiscoveryFilterPanel/AllEntriesFilterButton"
	property string DiscoveredEntriesFilterButtonPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionContent/DiscoveryFilterPanel/DiscoveredEntriesFilterButton"
	property string LockedEntriesFilterButtonPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionContent/DiscoveryFilterPanel/LockedEntriesFilterButton"
	property string CollectionCloseButtonPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionHeader/CollectionCloseButton"
	property string CollectionCardGridPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionContent/CollectionGridPanel/CollectionCardGrid"
	property string CollectionCardTemplatePath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionContent/CollectionGridPanel/CollectionCardGrid/CollectionCardTemplate"
	property string CollectionEntryCountTextPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionContent/CollectionGridPanel/CollectionEntryCountText"
	property string CollectionPreviewIconPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionContent/CollectionDetailPanel/CollectionPreviewFrame/CollectionPreviewIcon"
	property string CollectionNameTextPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionContent/CollectionDetailPanel/CollectionNameText"
	property string CollectionTypeTextPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionContent/CollectionDetailPanel/CollectionTypeText"
	property string CollectionDescriptionTextPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionContent/CollectionDetailPanel/CollectionDescriptionText"
	property string PrimaryMetadataLabelTextPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionContent/CollectionDetailPanel/PrimaryMetadataLabelText"
	property string PrimaryMetadataValueTextPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionContent/CollectionDetailPanel/PrimaryMetadataValueText"
	property string SecondaryMetadataLabelTextPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionContent/CollectionDetailPanel/SecondaryMetadataLabelText"
	property string SecondaryMetadataValueTextPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionContent/CollectionDetailPanel/SecondaryMetadataValueText"
	property string CollectionDiscoveryBadgeTextPath = "/ui/CollectionUI/CollectionWindow/CollectionFrame/CollectionContent/CollectionDetailPanel/CollectionDiscoveryBadgeText"

	property Entity CollectionGroup = nil
	property Entity CollectionWindow = nil
	property Entity CollectionCardGrid = nil
	property Entity CollectionCardTemplate = nil
	property Entity SkillJobTabs = nil
	property SpriteGUIRendererComponent CollectionPreviewIcon = nil
	property TextGUIRendererComponent CollectionNameText = nil
	property TextGUIRendererComponent CollectionTypeText = nil
	property TextGUIRendererComponent CollectionDescriptionText = nil
	property TextGUIRendererComponent PrimaryMetadataLabelText = nil
	property TextGUIRendererComponent PrimaryMetadataValueText = nil
	property TextGUIRendererComponent SecondaryMetadataLabelText = nil
	property TextGUIRendererComponent SecondaryMetadataValueText = nil
	property TextGUIRendererComponent CollectionDiscoveryBadgeText = nil
	property TextGUIRendererComponent CollectionEntryCountText = nil
	property any AllEntries = nil
	property any Entries = nil
	property any EventHandles = nil
	property any SlotHandles = nil
	property any SlotEntities = nil
	property string ActiveCategory = "Monster"
	property string ActiveFilter = "All"
	property string SelectedSkillJob = "warrior"
	property integer SelectedIndex = 1
	property boolean IsPopupOpen = false
	property boolean IsConnected = false

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- Initializes the presentation-only codex shell and keeps the popup hidden until lobby interaction.
		self.AllEntries = {}
		self.Entries = {}
		self.EventHandles = {}
		self.SlotHandles = {}
		self.SlotEntities = {}
		self:EnsureUi()
		self:SetPopupEnabled(false)
		log("[LobbyCodex] ready monsterSource=EnemyDefinitions")
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- Disconnects persistent button and cloned-slot events owned by this Logic.
		self:ClearEntrySlots()
		for _, binding in pairs(self.EventHandles) do
			if binding ~= nil and isvalid(binding.Entity) and binding.Handle ~= nil then
				binding.Entity:DisconnectEvent(ButtonClickEvent, binding.Handle)
			end
		end
		self.EventHandles = {}
		self.IsConnected = false
	end

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleEscapeKey(KeyDownEvent event)
		-- Closes the codex with the standard PC back action.
		if event.key == KeyboardKey.Escape and self.IsPopupOpen then
			self:ClosePopup()
		end
	end

	@ExecSpace("ClientOnly")
	method boolean OpenPopup()
		-- Opens the codex at the monster tab and reads the synchronized enemy catalog.
		if self.IsPopupOpen or self:EnsureUi() == false then
			return false
		end
		self.IsPopupOpen = true
		self:SetPopupEnabled(true)
		self:RefreshCategory("Monster")
		log("[LobbyCodex] opened")
		return true
	end

	@ExecSpace("ClientOnly")
	method void ClosePopup()
		-- Hides the codex and restores the lobby interaction prompt when still in range.
		if self.IsPopupOpen == false then
			return
		end
		self.IsPopupOpen = false
		self:SetPopupEnabled(false)
		self:RestoreInteractionPrompt()
		log("[LobbyCodex] closed")
	end

	@ExecSpace("ClientOnly")
	method boolean IsOpen()
		-- Reports whether the codex popup currently owns lobby input focus.
		return self.IsPopupOpen
	end

	@ExecSpace("ClientOnly")
	method table GetEntriesForCategory(string category)
		-- Routes each category to its synchronized gameplay data provider.
		if category == "Monster" then
			return _MonsterCodexProvider:GetEntries()
		elseif category == "Item" then
			return _ItemCodexProvider:GetEntries()
		elseif category == "Skill" then
			return _SkillCodexProvider:GetEntries()
		end
		return {}
	end

	@ExecSpace("ClientOnly")
	method void RefreshCodex()
		-- Rebuilds the active category without changing tab or filter selection.
		self:RefreshList()
	end

	@ExecSpace("ClientOnly")
	method void RefreshCategory(string category)
		-- Changes tabs, resets the filter, and rebuilds the list and detail panels.
		if category ~= "Monster" and category ~= "Item" and category ~= "Skill" then
			return
		end
		self.ActiveCategory = category
		self.ActiveFilter = "All"
		if category == "Monster" then self.SelectedMonsterRegion = "" end
		if category == "Skill" then
			self.SelectedSkillJob = "warrior"
		end
		self:RefreshTabs()
		self:RefreshFilters()
		self:RefreshSkillJobTabs()
		self:RefreshList()
		log("[LobbyCodex] tab changed category=" .. category)
	end

	@ExecSpace("ClientOnly")
	method void SetFilter(string filter)
		-- Item filters select a kind; other categories keep their discovery filters.
		local validFilter = filter == "All"
		if self.ActiveCategory == "Item" then
			validFilter = validFilter or filter == "Consumable" or filter == "Relic"
		elseif self.ActiveCategory == "Monster" then
			validFilter = validFilter or filter == "Normal" or filter == "Boss"
		else
			validFilter = validFilter or filter == "Discovered" or filter == "Locked"
		end
		if validFilter == false then
			return
		end
		self.ActiveFilter = filter
		self:RefreshFilters()
		self:RefreshList()
		log("[LobbyCodex] filter changed filter=" .. filter)
	end

	@ExecSpace("ClientOnly")
	method void SetSkillJob(string requiredJobTag)
		-- Changes the active skill job and refreshes the shared list through RequiredJobTag filtering.
		if self.ActiveCategory ~= "Skill" then
			return
		end
		if requiredJobTag ~= "warrior" and requiredJobTag ~= "archer" and requiredJobTag ~= "mage"
			and requiredJobTag ~= "thief" and requiredJobTag ~= "pirate" then
			return
		end
		self.SelectedSkillJob = requiredJobTag
		self:RefreshSkillJobTabs()
		self:RefreshList()
		log("[LobbyCodex] skill job changed requiredJobTag=" .. requiredJobTag)
	end

	@ExecSpace("ClientOnly")
	method void RefreshList()
		-- Replaces list contents from the active data source and filter.
		self.AllEntries = self:GetEntriesForCategory(self.ActiveCategory)
		self.Entries = {}
		for _, entry in ipairs(self.AllEntries) do
			local includeDiscovery = self.ActiveFilter == "All"
				or (self.ActiveFilter == "Discovered" and entry.IsDiscovered == true)
				or (self.ActiveFilter == "Locked" and entry.IsDiscovered ~= true)
			if self.ActiveCategory == "Item" then
				includeDiscovery = self.ActiveFilter == "All" or entry.ItemKind == self.ActiveFilter
			elseif self.ActiveCategory == "Monster" then
				local inRegion = self.SelectedMonsterRegion == "" or (entry.RegionIds or {})[self.SelectedMonsterRegion] == true
				includeDiscovery = inRegion and (self.ActiveFilter == "All"
					or (self.ActiveFilter == "Normal" and entry.IsBoss ~= true)
					or (self.ActiveFilter == "Boss" and entry.IsBoss == true))
			end
			local includeJob = self.ActiveCategory ~= "Skill" or entry.RequiredJobTag == self.SelectedSkillJob
			if includeDiscovery and includeJob then
				table.insert(self.Entries, entry)
			end
		end
		self.SelectedIndex = #self.Entries > 0 and 1 or 0
		self.MonsterPage = 1
		self:RebuildEntrySlots()
		self:RefreshEntryCount()
		self:RefreshDetailPanel()
		log("[LobbyCodex] list refreshed category=" .. self.ActiveCategory .. " filter=" .. self.ActiveFilter .. " requiredJobTag=" .. self.SelectedSkillJob .. " count=" .. tostring(#self.Entries))
	end

	@ExecSpace("ClientOnly")
	method void RebuildEntrySlots()
		-- All categories reuse the ten authored gallery cards.
		self:ClearEntrySlots()
	end

	@ExecSpace("ClientOnly")
	method void ClearEntrySlots()
		-- Disconnects and destroys every runtime-cloned list slot.
		for _, slotEntity in pairs(self.SlotEntities) do
			if isvalid(slotEntity) then
				local handle = self.SlotHandles[slotEntity.Id]
				if handle ~= nil then
					slotEntity:DisconnectEvent(ButtonClickEvent, handle)
				end
				slotEntity:Destroy()
			end
		end
		self.SlotEntities = {}
		self.SlotHandles = {}
	end

	@ExecSpace("ClientOnly")
	method void BindEntry(integer entryIndex, Entity slotEntity)
		-- Binds one prototype DTO to a reusable list slot and applies discovery presentation.
		local entry = self.Entries[entryIndex]
		if entry == nil or isvalid(slotEntity) == false then
			return
		end
		self.SlotEntities[entryIndex] = slotEntity
		local nameEntity = slotEntity:GetChildByName("CollectionCardNameText")
		local typeEntity = slotEntity:GetChildByName("CollectionCardTypeText")
		local iconEntity = slotEntity:GetChildByName("CollectionCardIcon")
		self:ApplyEntryLayout(slotEntity)
		local displayName = entry.IsDiscovered == true and entry.DisplayName or "???"
		if isvalid(nameEntity) and nameEntity.TextGUIRendererComponent ~= nil then
			nameEntity.TextGUIRendererComponent.Text = displayName
			nameEntity.TextGUIRendererComponent.FontColor = entry.IsDiscovered == true and Color(0.25,0.14,0.06,1) or Color(0.98,0.82,0.50,1)
		end
		if isvalid(typeEntity) and typeEntity.TextGUIRendererComponent ~= nil then
			typeEntity.TextGUIRendererComponent.Text = entry.IsDiscovered == true and entry.TypeLabel or "미발견"
			typeEntity.TextGUIRendererComponent.FontColor = entry.IsDiscovered == true and Color(0.40,0.27,0.14,1) or Color(0.88,0.69,0.40,1)
		end
		if isvalid(iconEntity) and iconEntity.SpriteGUIRendererComponent ~= nil then
			iconEntity.SpriteGUIRendererComponent.ImageRUID = DataRef(entry.Icon or "")
			iconEntity.SpriteGUIRendererComponent.Color = entry.IsDiscovered == true and Color(1,1,1,1) or Color(0.36,0.30,0.26,0.72)
		end
		self.SlotHandles[slotEntity.Id] = slotEntity:ConnectEvent(ButtonClickEvent, function()
			self:SelectEntry(entryIndex)
		end)
		self:ApplySelectionState(entryIndex, slotEntity)
	end

	@ExecSpace("ClientOnly")
	method void SelectEntry(integer index)
		-- Selects one visible row and refreshes both selection and detail presentation.
		if index < 1 or index > #self.Entries then
			return
		end
		self.SelectedIndex = index
		for slotIndex, slotEntity in pairs(self.SlotEntities) do
			self:ApplySelectionState(slotIndex, slotEntity)
		end
		self:RefreshDetailPanel()
		log("[LobbyCodex] entry selected category=" .. self.ActiveCategory .. " id=" .. self.Entries[index].Id)
	end

	@ExecSpace("ClientOnly")
	method void ApplySelectionState(integer index, Entity slotEntity)
		-- Uses warm gold for selection and a muted tint for undiscovered rows.
		if isvalid(slotEntity) == false or slotEntity.SpriteGUIRendererComponent == nil then
			return
		end
		local entry = self.Entries[index]
		local isSelected = index == self.SelectedIndex
		if self.ActiveCategory == "Skill" then
			slotEntity.SpriteGUIRendererComponent.Color = isSelected and Color(1.00,0.73,0.20,1) or Color(0.96,0.83,0.60,1)
			local iconFrame = slotEntity:GetChildByName("CollectionCardIconFrame")
			if isvalid(iconFrame) and iconFrame.SpriteGUIRendererComponent ~= nil then
				iconFrame.SpriteGUIRendererComponent.Color = isSelected and Color(0.48,0.24,0.06,1) or Color(1.00,0.93,0.73,1)
			end
			return
		end
		if entry ~= nil and entry.IsDiscovered ~= true then
			slotEntity.SpriteGUIRendererComponent.Color = isSelected and Color(0.54,0.43,0.31,1) or Color(0.40,0.33,0.27,0.94)
		else
			slotEntity.SpriteGUIRendererComponent.Color = isSelected and Color(1.00,0.82,0.36,1) or Color(0.98,0.87,0.68,1)
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshDetailPanel()
		-- Refreshes the shared gallery and its scrollable entry details.
		self:RefreshMonsterPage()
	end

	@ExecSpace("ClientOnly")
	method void RefreshEntryCount()
		-- Shows filtered and total counts for future large data sets.
		if self.CollectionEntryCountText ~= nil then
			self.CollectionEntryCountText.Text = tostring(#self.Entries) .. " / " .. tostring(#self.AllEntries) .. " 항목"
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshTabs()
		-- Makes the active top tab immediately distinguishable from inactive tabs.
		self:RefreshButtonState(self.MonsterTabButtonPath, self.ActiveCategory == "Monster")
		self:RefreshButtonState(self.ItemTabButtonPath, self.ActiveCategory == "Item")
		self:RefreshButtonState(self.SkillTabButtonPath, self.ActiveCategory == "Skill")
	end

	@ExecSpace("ClientOnly")
	method void RefreshFilters()
		-- Updates the visible category navigation after filter changes.
		if self.ActiveCategory == "Monster" then self:RefreshMonsterNavigation() else self:RefreshCategoryNavigation() end
	end

	@ExecSpace("ClientOnly")
	method void SetPathText(string path, string text)
		-- Updates an existing label without changing its layout or event bindings.
		local entity = _EntityService:GetEntityByPath(path)
		if isvalid(entity) and entity.TextGUIRendererComponent ~= nil then
			entity.TextGUIRendererComponent.Text = text
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshSkillJobTabs()
		-- Updates common layout and category-specific navigation without switching shells.
		self:ApplyCodexLayout(self.ActiveCategory == "Skill")
		self:RefreshCategoryNavigation()
	end

	@ExecSpace("ClientOnly")
	method void ApplyCodexLayout(boolean skillMode)
		-- Uses one cream gallery layout for monsters, items and skills.
		self:SetPathEnabled(self.MonsterGalleryPanelPath, true)
		self:SetPathEnabled(self.MonsterRegionPanelPath, self.ActiveCategory == "Monster")
		self:SetPathEnabled(self.CategoryNavigationPath, self.ActiveCategory ~= "Monster")
		self:SetPathEnabled(self.CollectionGridPanelPath, false)
		self:SetPathEnabled(self.CollectionDetailPanelPath, false)
		self:SetPathEnabled(self.DiscoveryFilterPanelPath, false)
		self:SetPathEnabled(self.SkillJobTabsPath, false)
		self:SetPathEnabled(self.CollectionHeaderPath .. "/CollectionSubtitleText", false)
		self:ApplyRectLayout(self.CollectionFramePath, 0, 0, 1540, 900)
		self:ApplyRectLayout(self.CollectionHeaderPath .. "/CollectionTitleText", 0, 0, 700, 48)
	end

	@ExecSpace("ClientOnly")
	method void SelectMonsterRegion(string regionId)
		-- Selects a Victoria region and resets its general/boss filter.
		if self.ActiveCategory ~= "Monster" then return end
		local known = regionId == ""
		for _, region in ipairs(_MonsterCodexProvider:GetVictoriaRegions()) do
			if region.Id == regionId then known = true end
		end
		if known == false then return end
		self.SelectedMonsterRegion = regionId
		self.ActiveFilter = "All"
		self:RefreshMonsterNavigation()
		self:RefreshList()
	end

	@ExecSpace("ClientOnly")
	method void RefreshMonsterNavigation()
		-- Lays out one expanded region beneath its continent and keeps selection visible.
		local root = self.MonsterRegionPanelPath
		self:SetPathText(self.MonsterGalleryPanelPath .. "/Continent", "빅토리아 아일랜드")
		self:SetPathText(root .. "/Victoria/AllRegions", (self.MonsterContinentExpanded and "- " or "+ ") .. "빅토리아 아일랜드")
		self:RefreshButtonState(root .. "/Victoria/AllRegions", self.SelectedMonsterRegion == "")
		self:SetPathEnabled(root .. "/Victoria/Regions", self.MonsterContinentExpanded)
		local label = "전체 지역"
		local y = 112
		for index, region in ipairs(_MonsterCodexProvider:GetVictoriaRegions()) do
			local path = root .. "/Victoria/Regions/Region" .. tostring(index)
			local expanded = self.ExpandedMonsterRegion == region.Id
			self:ApplyRectLayout(path, 6, y, 220, 48)
			self:SetPathText(path, (expanded and "- " or "+ ") .. region.DisplayName)
			self:RefreshButtonState(path, self.SelectedMonsterRegion == region.Id)
			for _, kind in ipairs({ "Normal", "Boss" }) do
				self:SetPathEnabled(path .. "/" .. kind, expanded)
				self:RefreshButtonState(path .. "/" .. kind, self.SelectedMonsterRegion == region.Id and self.ActiveFilter == kind)
			end
			if self.SelectedMonsterRegion == region.Id then label = region.DisplayName end
			y = y - 54 - (expanded and 88 or 0)
		end
		if self.ActiveFilter == "Normal" then label = label .. " > 일반 몬스터" end
		if self.ActiveFilter == "Boss" then label = label .. " > 보스" end
		self:SetPathText(self.MonsterGalleryPanelPath .. "/RegionTitle", label)
	end

	@ExecSpace("ClientOnly")
	method boolean ConnectMonsterNavigation()
		-- Registers each navigation callback once in the existing cleanup collection.
		local root = self.MonsterRegionPanelPath
		if self:ConnectButton(root .. "/Victoria/AllRegions", function() self:ToggleMonsterContinent() end, "MonsterAllRegions") == false then return false end
		for index, region in ipairs(_MonsterCodexProvider:GetVictoriaRegions()) do
			local regionId = region.Id
			if self:ConnectButton(root .. "/Victoria/Regions/Region" .. tostring(index), function() self:ToggleMonsterRegion(regionId) end, "MonsterRegion" .. tostring(index)) == false then return false end
		end
		for index, region in ipairs(_MonsterCodexProvider:GetVictoriaRegions()) do
			local regionId = region.Id
			for _, kind in ipairs({ "Normal", "Boss" }) do
				local filter = kind
				if self:ConnectButton(root .. "/Victoria/Regions/Region" .. tostring(index) .. "/" .. kind, function() self:SelectMonsterRegion(regionId) self:SetFilter(filter) end, "MonsterType" .. tostring(index) .. kind) == false then return false end
			end
		end
		for index = 1, 5 do
			local optionIndex = index
			if self:ConnectButton(self.CategoryNavigationPath .. "/Option" .. tostring(index), function() self:SelectCategoryOption(optionIndex) end, "CategoryOption" .. tostring(index)) == false then return false end
		end
		for index = 1, 10 do
			local slotIndex = index
			if self:ConnectButton(self.MonsterGalleryPanelPath .. "/Cards/Card" .. tostring(index), function() self:SelectMonsterCard(slotIndex) end, "MonsterCard" .. tostring(index)) == false then return false end
		end
		if self:ConnectButton(self.MonsterGalleryPanelPath .. "/Pagination/Previous", function() self:ChangeMonsterPage(-1) end, "MonsterPreviousPage") == false then return false end
		if self:ConnectButton(self.MonsterGalleryPanelPath .. "/Pagination/Next", function() self:ChangeMonsterPage(1) end, "MonsterNextPage") == false then return false end
		return true
	end


	@ExecSpace("ClientOnly")
	method table GetCategoryNavigation()
		-- Supplies labels and filter keys for the common left navigation.
		if self.ActiveCategory == "Item" then
			return { {Key="All", Label="전체 아이템"}, {Key="Consumable", Label="소비 아이템"}, {Key="Relic", Label="유물"} }
		end
		return { {Key="warrior", Label="전사"}, {Key="archer", Label="궁수"}, {Key="mage", Label="마법사"}, {Key="thief", Label="도적"}, {Key="pirate", Label="해적"} }
	end

	@ExecSpace("ClientOnly")
	method void RefreshCategoryNavigation()
		-- Shows item kinds or skill jobs beside the same gallery.
		if self.ActiveCategory == "Monster" then return end
		local options = self:GetCategoryNavigation()
		local selected = self.ActiveCategory == "Item" and self.ActiveFilter or self.SelectedSkillJob
		local label = ""
		self:SetPathText(self.CategoryNavigationPath .. "/Title", self.ActiveCategory == "Item" and "아이템 종류" or "직업 선택")
		for index = 1, 5 do
			local option = options[index]
			local path = self.CategoryNavigationPath .. "/Option" .. tostring(index)
			self:SetPathEnabled(path, option ~= nil)
			if option ~= nil then
				self:SetPathText(path, option.Label)
				self:RefreshButtonState(path, option.Key == selected)
				if option.Key == selected then label = option.Label end
			end
		end
		self:SetPathText(self.MonsterGalleryPanelPath .. "/Continent", self.ActiveCategory == "Item" and "아이템 도감" or "스킬 도감")
		self:SetPathText(self.MonsterGalleryPanelPath .. "/RegionTitle", label)
	end

	@ExecSpace("ClientOnly")
	method void SelectCategoryOption(integer index)
		-- Dispatches shared navigation clicks to the active category.
		if self.ActiveCategory == "Monster" then return end
		local options = self:GetCategoryNavigation()
		local option = options[index]
		if option == nil then return end
		if self.ActiveCategory == "Item" then self:SetFilter(option.Key) else self:SetSkillJob(option.Key) end
	end

	@ExecSpace("ClientOnly")
	method void ToggleMonsterContinent()
		-- Toggles the continent subtree and returns its gallery to all regions.
		if self.ActiveCategory ~= "Monster" then return end
		self.MonsterContinentExpanded = not self.MonsterContinentExpanded
		self:SelectMonsterRegion("")
	end

	@ExecSpace("ClientOnly")
	method void ToggleMonsterRegion(string regionId)
		-- Expands one region at a time and selects its full monster list.
		if self.ActiveCategory ~= "Monster" then return end
		self.ExpandedMonsterRegion = self.ExpandedMonsterRegion == regionId and "" or regionId
		self.MonsterContinentExpanded = true
		self:SelectMonsterRegion(regionId)
	end

	@ExecSpace("ClientOnly")
	method void SelectMonsterCard(integer slotIndex)
		-- Converts a page-local card click to its stable filtered-list index.
		if slotIndex < 1 or slotIndex > 10 then return end
		local index = (self.MonsterPage - 1) * 10 + slotIndex
		if self.Entries[index] ~= nil then self:SelectEntry(index) end
	end

	@ExecSpace("ClientOnly")
	method void ChangeMonsterPage(integer direction)
		-- Moves only within the available pages and selects the first card on the new page.
		local pages = math.max(1, math.ceil(#self.Entries / 10))
		local nextPage = math.max(1, math.min(pages, self.MonsterPage + direction))
		if nextPage == self.MonsterPage then return end
		self.MonsterPage = nextPage
		self.SelectedIndex = (nextPage - 1) * 10 + 1
		self:RefreshMonsterPage()
		log("[LobbyCodex] monster page=" .. tostring(nextPage) .. "/" .. tostring(pages))
	end

	@ExecSpace("ClientOnly")
	method void RefreshMonsterPage()
		-- Reuses exactly ten authored cards; empty cells remain visible without accepting clicks.
		local root = self.MonsterGalleryPanelPath
		local pages = math.max(1, math.ceil(#self.Entries / 10))
		self.MonsterPage = math.max(1, math.min(pages, self.MonsterPage))
		for slotIndex = 1, 10 do
			local index = (self.MonsterPage - 1) * 10 + slotIndex
			local entry = self.Entries[index]
			local path = root .. "/Cards/Card" .. tostring(slotIndex)
			local card = _EntityService:GetEntityByPath(path)
			local icon = _EntityService:GetEntityByPath(path .. "/Face/Icon")
			local face = _EntityService:GetEntityByPath(path .. "/Face")
			local selected = entry ~= nil and index == self.SelectedIndex
			local nameLabel = _EntityService:GetEntityByPath(path .. "/Name")
			if isvalid(nameLabel) and nameLabel.TextGUIRendererComponent ~= nil then
				nameLabel.TextGUIRendererComponent.FontColor = selected and Color(1,1,1,1) or Color(0.22,0.28,0.27,1)
			end
			if isvalid(card) then
				if card.ButtonComponent ~= nil then card.ButtonComponent.Enable = entry ~= nil end
				if card.SpriteGUIRendererComponent ~= nil then
					card.SpriteGUIRendererComponent.Color = selected and Color(0.13,0.48,0.45,1) or Color(0.81,0.85,0.82,1)
				end
			end
			if isvalid(face) and face.SpriteGUIRendererComponent ~= nil then
				face.SpriteGUIRendererComponent.Color = entry ~= nil and Color(0.95,0.965,0.945,1) or Color(0.91,0.93,0.91,1)
			end
			self:SetPathText(path .. "/Name", entry ~= nil and (entry.IsDiscovered == true and entry.DisplayName or "???") or "")
			if isvalid(icon) then
				icon:SetEnable(entry ~= nil)
				self:ApplyEntityRect(icon, 0, 0, self.ActiveCategory == "Monster" and 140 or 100, 100)
				if entry ~= nil and icon.SpriteGUIRendererComponent ~= nil then
					icon.SpriteGUIRendererComponent.ImageRUID = DataRef(entry.Icon or "")
					icon.SpriteGUIRendererComponent.Color = entry.IsDiscovered == true and Color(1,1,1,1) or Color(0.25,0.36,0.39,1)
				end
			end
		end
		self:SetPathText(root .. "/Pagination/Page", tostring(self.MonsterPage) .. " / " .. tostring(pages))
		self:SetPathText(root .. "/Pagination/Count", tostring(#self.Entries) .. "종")
		for _, buttonInfo in ipairs({ { Name="Previous", Enabled=self.MonsterPage > 1 }, { Name="Next", Enabled=self.MonsterPage < pages } }) do
			local button = _EntityService:GetEntityByPath(root .. "/Pagination/" .. buttonInfo.Name)
			if isvalid(button) and button.ButtonComponent ~= nil then button.ButtonComponent.Enable = buttonInfo.Enabled end
			if isvalid(button) and button.TextGUIRendererComponent ~= nil then
				button.TextGUIRendererComponent.FontColor = buttonInfo.Enabled and Color(0.22,0.38,0.36,1) or Color(0.64,0.61,0.54,1)
			end
		end
		local detail = root .. "/Detail/Scroll"
		local selected = self.Entries[self.SelectedIndex]
		local discovered = selected ~= nil and selected.IsDiscovered == true
		self:SetPathText(detail .. "/Name", selected == nil and "표시할 항목이 없습니다" or (discovered and selected.DisplayName or "???"))
		self:SetPathText(detail .. "/Kind", selected == nil and "" or (discovered and selected.TypeLabel or "미발견"))
		self:SetPathText(detail .. "/Description", selected == nil and "지역이나 분류를 변경해보세요." or (discovered and (selected.Description or "") or "아직 발견하지 못한 항목입니다."))
		self:SetPathText(detail .. "/Health", selected == nil and "" or ((selected.MetaPrimaryLabel or "정보") .. "   " .. (discovered and (selected.MetaPrimaryValue or "-") or "???")))
		self:SetPathText(detail .. "/Attack", selected == nil and "" or ((selected.MetaSecondaryLabel or "정보") .. "   " .. (discovered and (selected.MetaSecondaryValue or "-") or "???")))
		if discovered then
			local summary = (selected.Description or "") .. "\n\n" .. (selected.TypeLabel or "")
			summary = summary .. "   ·   " .. (selected.MetaPrimaryLabel or "정보") .. " " .. (selected.MetaPrimaryValue or "-")
			summary = summary .. "   ·   " .. (selected.MetaSecondaryLabel or "정보") .. " " .. (selected.MetaSecondaryValue or "-")
			self:SetPathText(detail .. "/Description", summary)
		end
		for _, field in ipairs({ "Name", "Description" }) do
			local row = _EntityService:GetEntityByPath(detail .. "/" .. field)
			if isvalid(row) and row.TextGUIRendererComponent ~= nil and row.UITransformComponent ~= nil then
				local height = row.TextGUIRendererComponent:GetPreferredHeight(row.TextGUIRendererComponent.Text, 950)
				row.UITransformComponent.RectSize = Vector2(950, math.max(32, height + 4))
			end
		end
		local scroll = _EntityService:GetEntityByPath(detail)
		if isvalid(scroll) and scroll.ScrollLayoutGroupComponent ~= nil then
			scroll.ScrollLayoutGroupComponent:ResetScrollPosition(UITransformAxis.Vertical)
		end
	end



	@ExecSpace("ClientOnly")
	method void ConfigureEntryLayout(boolean skillMode)
		-- Configures an icon-first three-column Skill grid or restores the original vertical list.
		if isvalid(self.CollectionCardGrid) == false or self.CollectionCardGrid.ScrollLayoutGroupComponent == nil then
			return
		end
		local layout = self.CollectionCardGrid.ScrollLayoutGroupComponent
		if skillMode then
			layout.Type = LayoutGroupType.Grid
			layout.GridSpacing = Vector2(15, 15)
			layout.CellSize = Vector2(250, 185)
			layout.Constraint = GridLayoutConstraint.FixedColumnCount
			layout.ConstraintCount = 3
		else
			layout.Type = LayoutGroupType.Vertical
			layout.Spacing = 10
			layout.GridSpacing = Vector2(0, 0)
			layout.CellSize = Vector2(100, 100)
			layout.Constraint = GridLayoutConstraint.Flexible
			layout.ConstraintCount = 1
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplyEntryLayout(Entity slotEntity)
		-- Resizes one shared entry as a large Skill card or restores the original Monster/Item list row.
		if isvalid(slotEntity) == false then
			return
		end
		local iconFrame = slotEntity:GetChildByName("CollectionCardIconFrame")
		local icon = slotEntity:GetChildByName("CollectionCardIcon")
		local nameText = slotEntity:GetChildByName("CollectionCardNameText")
		local typeText = slotEntity:GetChildByName("CollectionCardTypeText")
		if self.ActiveCategory == "Skill" then
			self:ApplyEntityRect(slotEntity, 0, 0, 250, 185)
			self:ApplyEntityRect(iconFrame, 0, 28, 112, 112)
			self:ApplyEntityRect(icon, 0, 28, 90, 90)
			self:ApplyEntityRect(nameText, 0, -62, 220, 38)
			self:ApplyEntityTextSize(nameText, 24)
			if isvalid(nameText) and nameText.TextGUIRendererComponent ~= nil then
				nameText.TextGUIRendererComponent.BestFit = true
				nameText.TextGUIRendererComponent.MinSize = 18
				nameText.TextGUIRendererComponent.MaxSize = 24
			end
			if isvalid(typeText) then
				typeText:SetEnable(false)
			end
			return
		end
		if isvalid(typeText) then
			typeText:SetEnable(true)
		end
		if isvalid(nameText) and nameText.TextGUIRendererComponent ~= nil then
			nameText.TextGUIRendererComponent.BestFit = false
			nameText.TextGUIRendererComponent.MaxSize = 40
		end
		self:ApplyEntityRect(slotEntity, 0, 0, 460, 104)
		self:ApplyEntityRect(iconFrame, -175, 0, 82, 82)
		self:ApplyEntityRect(icon, -175, 0, 64, 64)
		self:ApplyEntityRect(nameText, 45, 18, 310, 36)
		self:ApplyEntityTextSize(nameText, 24)
		self:ApplyEntityRect(typeText, 45, -20, 310, 30)
		self:ApplyEntityTextSize(typeText, 20)
	end

	@ExecSpace("ClientOnly")
	method void ApplySkillDetailLayout()
		-- Fits a readable Skill detail card inside the common Codex content bounds.
		self:ApplyRectLayout(self.CollectionNameTextPath, 0, 210, 440, 44)
		self:ApplyTextSize(self.CollectionNameTextPath, 30)
		self:ApplyRectLayout(self.CollectionDetailPanelPath .. "/CollectionPreviewFrame", -120, 95, 200, 160)
		self:ApplyRectLayout(self.CollectionPreviewIconPath, 0, 0, 136, 136)
		self:ApplyRectLayout(self.CollectionDetailPanelPath .. "/CollectionTypePanel", 115, 95, 220, 64)
		self:ApplyRectLayout(self.CollectionTypeTextPath, 115, 95, 200, 42)
		self:ApplyTextSize(self.CollectionTypeTextPath, 24)
		self:ApplyRectLayout(self.CollectionDiscoveryBadgeTextPath, 150, 165, 150, 32)
		self:ApplyTextSize(self.CollectionDiscoveryBadgeTextPath, 22)
		self:ApplyRectLayout(self.CollectionDetailPanelPath .. "/CollectionDescriptionTitleText", -180, -15, 120, 30)
		self:ApplyTextSize(self.CollectionDetailPanelPath .. "/CollectionDescriptionTitleText", 22)
		self:ApplyRectLayout(self.CollectionDescriptionTextPath, 0, -70, 450, 80)
		self:ApplyTextSize(self.CollectionDescriptionTextPath, 22)
		self:ApplyRectLayout(self.CollectionDetailPanelPath .. "/CollectionMetadataPanel", 0, -180, 450, 100)
		self:ApplyRectLayout(self.PrimaryMetadataLabelTextPath, -140, -158, 130, 26)
		self:ApplyTextSize(self.PrimaryMetadataLabelTextPath, 20)
		self:ApplyRectLayout(self.PrimaryMetadataValueTextPath, 90, -158, 290, 28)
		self:ApplyTextSize(self.PrimaryMetadataValueTextPath, 20)
		self:ApplyRectLayout(self.SecondaryMetadataLabelTextPath, -140, -202, 130, 26)
		self:ApplyTextSize(self.SecondaryMetadataLabelTextPath, 20)
		self:ApplyRectLayout(self.SecondaryMetadataValueTextPath, 90, -202, 290, 28)
		self:ApplyTextSize(self.SecondaryMetadataValueTextPath, 20)
	end

	@ExecSpace("ClientOnly")
	method void ApplyStandardDetailLayout()
		-- Restores the original detail layout used by the Monster and Item Codex categories.
		self:ApplyRectLayout(self.CollectionNameTextPath, 0, 226, 440, 48)
		self:ApplyTextSize(self.CollectionNameTextPath, 24)
		self:ApplyRectLayout(self.CollectionDetailPanelPath .. "/CollectionPreviewFrame", -138, 118, 210, 180)
		self:ApplyRectLayout(self.CollectionPreviewIconPath, 0, 0, 142, 142)
		self:ApplyRectLayout(self.CollectionDetailPanelPath .. "/CollectionTypePanel", 122, 112, 228, 62)
		self:ApplyRectLayout(self.CollectionTypeTextPath, 122, 112, 210, 40)
		self:ApplyTextSize(self.CollectionTypeTextPath, 24)
		self:ApplyRectLayout(self.CollectionDiscoveryBadgeTextPath, 178, 184, 150, 34)
		self:ApplyTextSize(self.CollectionDiscoveryBadgeTextPath, 24)
		self:ApplyRectLayout(self.CollectionDetailPanelPath .. "/CollectionDescriptionTitleText", -192, 8, 100, 32)
		self:ApplyTextSize(self.CollectionDetailPanelPath .. "/CollectionDescriptionTitleText", 24)
		self:ApplyRectLayout(self.CollectionDescriptionTextPath, 0, -55, 450, 104)
		self:ApplyTextSize(self.CollectionDescriptionTextPath, 24)
		self:ApplyRectLayout(self.CollectionDetailPanelPath .. "/CollectionMetadataPanel", 0, -184, 460, 112)
		self:ApplyRectLayout(self.PrimaryMetadataLabelTextPath, -150, -162, 120, 30)
		self:ApplyTextSize(self.PrimaryMetadataLabelTextPath, 24)
		self:ApplyRectLayout(self.PrimaryMetadataValueTextPath, 88, -162, 300, 30)
		self:ApplyTextSize(self.PrimaryMetadataValueTextPath, 24)
		self:ApplyRectLayout(self.SecondaryMetadataLabelTextPath, -150, -210, 120, 30)
		self:ApplyTextSize(self.SecondaryMetadataLabelTextPath, 24)
		self:ApplyRectLayout(self.SecondaryMetadataValueTextPath, 88, -210, 300, 30)
		self:ApplyTextSize(self.SecondaryMetadataValueTextPath, 24)
	end

	@ExecSpace("ClientOnly")
	method void ApplyRectLayout(string path, number x, number y, number width, number height)
		-- Resolves one stable UI path and applies centered RectTransform geometry.
		local entity = _EntityService:GetEntityByPath(path)
		self:ApplyEntityRect(entity, x, y, width, height)
	end

	@ExecSpace("ClientOnly")
	method void ApplyTextSize(string path, number fontSize)
		-- Resolves one stable UI path and applies a readable text size.
		local entity = _EntityService:GetEntityByPath(path)
		self:ApplyEntityTextSize(entity, fontSize)
	end

	@ExecSpace("ClientOnly")
	method void ApplyEntityRect(Entity entity, number x, number y, number width, number height)
		-- Applies runtime geometry without changing anchors or pivots authored by UIBuilder.
		if isvalid(entity) and entity.UITransformComponent ~= nil then
			entity.UITransformComponent.anchoredPosition = Vector2(x, y)
			entity.UITransformComponent.RectSize = Vector2(width, height)
		end
	end

	@ExecSpace("ClientOnly")
	method void ApplyEntityTextSize(Entity entity, number fontSize)
		-- Applies a font size only when the target owns the expected text renderer.
		if isvalid(entity) and entity.TextGUIRendererComponent ~= nil then
			entity.TextGUIRendererComponent.FontSize = fontSize
		end
	end

	@ExecSpace("ClientOnly")
	method void SetPathEnabled(string path, boolean enabled)
		-- Toggles one layout subtree while keeping the shared Codex UI group alive.
		local entity = _EntityService:GetEntityByPath(path)
		if isvalid(entity) then
			entity:SetEnable(enabled)
		end
	end

	@ExecSpace("ClientOnly")
	method void RefreshButtonState(string path, boolean active)
		-- Uses teal selection and warm neutral inactive states across every tab.
		local entity = _EntityService:GetEntityByPath(path)
		if isvalid(entity) and entity.SpriteGUIRendererComponent ~= nil then
			entity.SpriteGUIRendererComponent.Color = active and Color(0.13,0.48,0.45,1) or Color(0.88,0.92,0.89,1)
		end
		if isvalid(entity) and entity.TextGUIRendererComponent ~= nil then
			entity.TextGUIRendererComponent.FontColor = active and Color(1,0.99,0.94,1) or Color(0.22,0.28,0.27,1)
		end
	end

	@ExecSpace("ClientOnly")
	method boolean EnsureUi()
		-- Resolves the builder-authored UI and connects all stable button events once.
		if self.IsConnected then
			return true
		end
		self.CollectionGroup = _EntityService:GetEntityByPath(self.CollectionGroupPath)
		self.CollectionWindow = _EntityService:GetEntityByPath(self.CollectionWindowPath)
		self.CollectionCardGrid = _EntityService:GetEntityByPath(self.CollectionCardGridPath)
		self.CollectionCardTemplate = _EntityService:GetEntityByPath(self.CollectionCardTemplatePath)
		self.SkillJobTabs = _EntityService:GetEntityByPath(self.SkillJobTabsPath)
		local preview = _EntityService:GetEntityByPath(self.CollectionPreviewIconPath)
		local detailName = _EntityService:GetEntityByPath(self.CollectionNameTextPath)
		local detailType = _EntityService:GetEntityByPath(self.CollectionTypeTextPath)
		local detailDescription = _EntityService:GetEntityByPath(self.CollectionDescriptionTextPath)
		local metaPrimaryLabel = _EntityService:GetEntityByPath(self.PrimaryMetadataLabelTextPath)
		local metaPrimaryValue = _EntityService:GetEntityByPath(self.PrimaryMetadataValueTextPath)
		local metaSecondaryLabel = _EntityService:GetEntityByPath(self.SecondaryMetadataLabelTextPath)
		local metaSecondaryValue = _EntityService:GetEntityByPath(self.SecondaryMetadataValueTextPath)
		local discoveryBadge = _EntityService:GetEntityByPath(self.CollectionDiscoveryBadgeTextPath)
		local entryCount = _EntityService:GetEntityByPath(self.CollectionEntryCountTextPath)
		if isvalid(self.CollectionGroup) == false or isvalid(self.CollectionWindow) == false or isvalid(self.CollectionCardGrid) == false or isvalid(self.CollectionCardTemplate) == false or isvalid(self.SkillJobTabs) == false
			or isvalid(preview) == false or isvalid(detailName) == false or isvalid(detailType) == false or isvalid(detailDescription) == false
			or isvalid(metaPrimaryLabel) == false or isvalid(metaPrimaryValue) == false or isvalid(metaSecondaryLabel) == false
			or isvalid(metaSecondaryValue) == false or isvalid(discoveryBadge) == false or isvalid(entryCount) == false then
			log_error("[LobbyCodex] UI binding failed")
			return false
		end

		self.CollectionPreviewIcon = preview.SpriteGUIRendererComponent
		self.CollectionNameText = detailName.TextGUIRendererComponent
		self.CollectionTypeText = detailType.TextGUIRendererComponent
		self.CollectionDescriptionText = detailDescription.TextGUIRendererComponent
		self.PrimaryMetadataLabelText = metaPrimaryLabel.TextGUIRendererComponent
		self.PrimaryMetadataValueText = metaPrimaryValue.TextGUIRendererComponent
		self.SecondaryMetadataLabelText = metaSecondaryLabel.TextGUIRendererComponent
		self.SecondaryMetadataValueText = metaSecondaryValue.TextGUIRendererComponent
		self.CollectionDiscoveryBadgeText = discoveryBadge.TextGUIRendererComponent
		self.CollectionEntryCountText = entryCount.TextGUIRendererComponent
		if self.CollectionPreviewIcon == nil or self.CollectionNameText == nil or self.CollectionTypeText == nil or self.CollectionDescriptionText == nil
			or self.PrimaryMetadataLabelText == nil or self.PrimaryMetadataValueText == nil or self.SecondaryMetadataLabelText == nil
			or self.SecondaryMetadataValueText == nil or self.CollectionDiscoveryBadgeText == nil or self.CollectionEntryCountText == nil then
			return false
		end

		self.CollectionCardTemplate:SetEnable(false)
		local connected = self:ConnectMonsterNavigation()
			and self:ConnectButton(self.MonsterTabButtonPath, self.OnMonsterTab, "MonsterTab")
			and self:ConnectButton(self.ItemTabButtonPath, self.OnItemTab, "ItemTab")
			and self:ConnectButton(self.SkillTabButtonPath, self.OnSkillTab, "SkillTab")
			and self:ConnectButton(self.WarriorTabButtonPath, self.OnWarriorJobTab, "WarriorJobTab")
			and self:ConnectButton(self.ArcherTabButtonPath, self.OnArcherJobTab, "ArcherJobTab")
			and self:ConnectButton(self.MageTabButtonPath, self.OnMageJobTab, "MageJobTab")
			and self:ConnectButton(self.ThiefTabButtonPath, self.OnThiefJobTab, "ThiefJobTab")
			and self:ConnectButton(self.PirateTabButtonPath, self.OnPirateJobTab, "PirateJobTab")
			and self:ConnectButton(self.AllEntriesFilterButtonPath, self.OnFilterAll, "FilterAll")
			and self:ConnectButton(self.DiscoveredEntriesFilterButtonPath, self.OnFilterDiscovered, "FilterDiscovered")
			and self:ConnectButton(self.LockedEntriesFilterButtonPath, self.OnFilterLocked, "FilterLocked")
			and self:ConnectButton(self.CollectionCloseButtonPath, self.OnClose, "Close")
		if connected == false then
			return false
		end
		self.IsConnected = true
		return true
	end

	@ExecSpace("ClientOnly")
	method boolean ConnectButton(string path, any callback, string key)
		-- Connects one native ButtonClickEvent and records its owner for deterministic cleanup.
		local entity = _EntityService:GetEntityByPath(path)
		if isvalid(entity) == false or entity.ButtonComponent == nil then
			log_error("[LobbyCodex] button binding failed key=" .. key .. " path=" .. path)
			return false
		end
		self.EventHandles[key] = { Entity=entity, Handle=entity:ConnectEvent(ButtonClickEvent, callback) }
		return true
	end

	@ExecSpace("ClientOnly")
	method void OnMonsterTab()
		-- Opens the monster catalog.
		self:RefreshCategory("Monster")
	end

	@ExecSpace("ClientOnly")
	method void OnItemTab()
		-- Opens consumables and relics with kind filters in the left panel.
		self:RefreshCategory("Item")
	end

	@ExecSpace("ClientOnly")
	method void OnSkillTab()
		-- Opens the skill collection with warrior selected as the default job.
		self:RefreshCategory("Skill")
	end

	@ExecSpace("ClientOnly")
	method void OnWarriorJobTab()
		-- Filters the shared Skill list to warrior definitions.
		self:SetSkillJob("warrior")
	end

	@ExecSpace("ClientOnly")
	method void OnArcherJobTab()
		-- Filters the shared Skill list to archer definitions.
		self:SetSkillJob("archer")
	end

	@ExecSpace("ClientOnly")
	method void OnMageJobTab()
		-- Filters the shared Skill list to mage definitions.
		self:SetSkillJob("mage")
	end

	@ExecSpace("ClientOnly")
	method void OnThiefJobTab()
		-- Filters the shared Skill list to thief definitions.
		self:SetSkillJob("thief")
	end

	@ExecSpace("ClientOnly")
	method void OnPirateJobTab()
		-- Filters the shared Skill list to pirate definitions.
		self:SetSkillJob("pirate")
	end

	@ExecSpace("ClientOnly")
	method void OnFilterAll()
		-- Shows all entries in the active category.
		self:SetFilter("All")
	end

	@ExecSpace("ClientOnly")
	method void OnFilterDiscovered()
		-- The second filter selects consumables on the item tab.
		self:SetFilter(self.ActiveCategory == "Item" and "Consumable" or "Discovered")
	end

	@ExecSpace("ClientOnly")
	method void OnFilterLocked()
		-- The third filter selects relics on the item tab.
		self:SetFilter(self.ActiveCategory == "Item" and "Relic" or "Locked")
	end

	@ExecSpace("ClientOnly")
	method void OnClose()
		-- Closes the codex from the header action button.
		self:ClosePopup()
	end

	@ExecSpace("ClientOnly")
	method void SetPopupEnabled(boolean enabled)
		-- Keeps the global UI group alive while toggling only the popup subtree.
		if isvalid(self.CollectionGroup) then
			self.CollectionGroup:SetEnable(true)
		end
		if isvalid(self.CollectionWindow) then
			self.CollectionWindow:SetEnable(enabled)
		end
	end

	@ExecSpace("ClientOnly")
	method void RestoreInteractionPrompt()
		-- Restores the E-key prompt when the local player remains inside the CodexZone.
		local zone = _EntityService:GetEntityByPath("/maps/lobby/Lobby_2F/FutureZones/CodexZone")
		if isvalid(zone) and zone.LobbyInteractionComponent ~= nil and zone.LobbyInteractionComponent.IsPlayerInRange then
			zone.LobbyInteractionComponent:ShowPrompt()
		end
	end

end
