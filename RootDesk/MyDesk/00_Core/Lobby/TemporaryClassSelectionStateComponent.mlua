@Component
script TemporaryClassSelectionStateComponent extends Component

	@Sync property string SelectedJobId = ""

	@ExecSpace("ServerOnly")
	method void SetSelectedJobId(string jobId)
		self.SelectedJobId = jobId or ""
		log("[TemporaryClassSelectionState] stored player=" .. self.Entity.Name .. " jobId=" .. self.SelectedJobId)
	end

	method string GetSelectedJobId()
		return self.SelectedJobId
	end

end
