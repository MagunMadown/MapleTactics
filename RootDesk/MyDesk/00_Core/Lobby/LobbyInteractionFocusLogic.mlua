@Logic
script LobbyInteractionFocusLogic extends Logic

	property Entity FocusEntity = nil
	property boolean IsPortalFocus = false
	property number InputCooldown = 0
	property table TargetPaths = {}

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- Keeps one deterministic interaction owner for the whole lobby.
		self.TargetPaths = {
			"/maps/lobby/Lobby_2F/Facilities/UnionManagerNPC",
			"/maps/lobby/Lobby_2F/FutureZones/CharacterSelectZone",
			"/maps/lobby/Lobby_2F/FutureZones/CodexZone",
			"/maps/lobby/Lobby_2F/Object_Lobby/Object_Lobby_Portal",
			"/maps/lobby/Lobby_2F/Facilities/UnionShopNPC",
			"/maps/lobby/Lobby_2F/Facilities/SkillEnhancementNPC",
			"/maps/lobby/Lobby_2F/Facilities/RunHistoryNPC"
		}
		self.FocusEntity = nil
		self:HideLegacyFocusMarker()
		log("[LobbyFocus] ready targets=" .. tostring(#self.TargetPaths))
	end

	@ExecSpace("ClientOnly")
	method void HideLegacyFocusMarker()
		-- Hides the retired marker if Maker retained the deleted UI entity during refresh.
		local legacyMarker = _EntityService:GetEntityByPath("/ui/DefaultGroup/LobbyFocusMarker")
		if isvalid(legacyMarker) and legacyMarker.Enable then
			legacyMarker:SetEnable(false)
			log("[LobbyFocus] retired marker hidden")
		end
	end

	@ExecSpace("ClientOnly")
	method boolean IsModalOpen()
		-- Prevents E and proximity prompts from leaking through an open service.
		-- Every lobby service, shop and the world map are Input windows in UILayerLogic.
		return _GameUIPolishLogic:IsTransitioning() or _GameSettingsLogic:IsInputBlocked()
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- Selects the nearest eligible target; equal distances retain the listed priority.
		self:HideLegacyFocusMarker()
		self.InputCooldown = math.max(0, self.InputCooldown - delta)
		local player = _UserService.LocalPlayer
		local nearest = nil
		local nearestDistance = math.huge
		local portal = false
		if isvalid(player) and isvalid(player.CurrentMap) and player.CurrentMap.Name == "lobby" and self:IsModalOpen() == false then
			for i, path in ipairs(self.TargetPaths) do
				local target = _EntityService:GetEntityByPath(path)
				if isvalid(target) and target.TransformComponent ~= nil and player.TransformComponent ~= nil then
					local zone = target:GetComponent("script.LobbyInteractionComponent")
					local dx = player.TransformComponent.WorldPosition.x - target.TransformComponent.WorldPosition.x
					local dy = player.TransformComponent.WorldPosition.y - target.TransformComponent.WorldPosition.y
					local rx = zone ~= nil and zone.InteractionRangeX or 1.15
					local ry = zone ~= nil and zone.InteractionRangeY or 1.5
					local distance = dx * dx + dy * dy
					if math.abs(dx) <= rx and math.abs(dy) <= ry and distance < nearestDistance then
						nearest = target
						nearestDistance = distance
						portal = i == 4
					end
				end
			end
		end
		self.FocusEntity = nearest
		self.IsPortalFocus = portal
		local prompt = _EntityService:GetEntityByPath("/ui/DefaultGroup/LobbyInteractionPrompt")
		local focusedZone = isvalid(nearest) and nearest:GetComponent("script.LobbyInteractionComponent") or nil
		local needsJob = (portal and isvalid(nearest)) or (focusedZone ~= nil and focusedZone.InteractionId == "SkillTree")
		-- The prompt belongs to proximity only; clicks never show it.
		if isvalid(prompt) then prompt:SetEnable(isvalid(nearest)) end
		self:RefreshJobNotice(prompt, needsJob)
		if isvalid(nearest) == false then return end
		local zone = nearest:GetComponent("script.LobbyInteractionComponent")
		local label = portal and "게임 시작" or (zone ~= nil and zone.InteractionPromptText or "상호작용")
		local text = _EntityService:GetEntityByPath("/ui/DefaultGroup/LobbyInteractionPrompt/PromptText")
		if isvalid(text) then text.TextGUIRendererComponent.Text = label end
		-- The key cap shows the player's interact key; longer names use a smaller font to stay inside the cap.
		local keyText = _EntityService:GetEntityByPath("/ui/DefaultGroup/LobbyInteractionPrompt/Keycap/Key")
		if isvalid(keyText) then
			local keyLabel = _GameSettingsLogic:GetActionKeyShortLabel("INTERACT")
			local renderer = keyText.TextGUIRendererComponent
			if renderer.Text ~= keyLabel then
				renderer.Text = keyLabel
				_GameUIPolishLogic:FitLabel(renderer, string.len(keyLabel) <= 2 and 26 or 16)
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void ShowJobRequiredNotice()
		-- Standing at the NPC, its prompt already carries the job notice; a distant click gets a toast instead.
		local zone = isvalid(self.FocusEntity) and self.FocusEntity:GetComponent("script.LobbyInteractionComponent") or nil
		if zone ~= nil and zone.InteractionId == "SkillTree" then return end
		_GameUIPolishLogic:ShowToast("먼저 직업을 선택해야 합니다", "스킬 강화는 직업을 선택한 뒤 이용할 수 있습니다.")
	end

	@ExecSpace("ClientOnly")
	method void RefreshJobNotice(Entity prompt, boolean atPortal)
		-- Shared notice for services requiring a selected job.
		if isvalid(prompt) == false then return end
		local notice = prompt:GetChildByName("JobNotice")
		local jobMissing = atPortal and (_LobbyCharacterSelectionLogic:GetSelectedClassId() or "") == ""
		if isvalid(notice) == false then
			if jobMissing == false then return end
			local hint = prompt:GetChildByName("Hint")
			if isvalid(hint) == false then return end
			-- Reuses the authored hint line so the font and styling match the prompt.
			notice = hint:Clone("JobNotice")
			if isvalid(notice) == false then return end
			notice:AttachTo(prompt)
			local transform = notice.UITransformComponent
			transform.RectSize = Vector2(330, 34)
			transform.anchoredPosition = Vector2(0, -68)
			-- Borrows the prompt's own dark plate so the warning stays readable on the bright ground.
			local plate = prompt.SpriteGUIRendererComponent
			local backing = notice.SpriteGUIRendererComponent
			if plate ~= nil and backing ~= nil then
				backing.ImageRUID = plate.ImageRUID
				backing.Type = plate.Type
				backing.Color = plate.Color
				backing.Enable = true
			end
			local text = notice.TextGUIRendererComponent
			text.Text = "먼저 직업을 선택해야 합니다"
			_GameUIPolishLogic:FitLabel(text, 20)
			text.FontColor = Color(1, 0.78, 0.35, 1)
			text.HorizontalAlignment = TextHorizontalAlignmentOption.Center
		end
		notice.Enable = jobMissing
	end

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleKeyDown(KeyDownEvent event)
		-- One key press opens at most one target, including the central portal.
		if _GameSettingsLogic:IsActionKey("INTERACT", event.key) == false or self.InputCooldown > 0 or self:IsModalOpen() or isvalid(self.FocusEntity) == false then return end
		self.InputCooldown = 0.25
		if self.IsPortalFocus then
			local root = _EntityService:GetEntityByPath("/ui/DefaultGroup")
			local start = isvalid(root) and root:GetComponent("script.LobbyStartButtonComponent") or nil
			if start ~= nil then start:OnStartButtonClicked() end
		else
			local zone = self.FocusEntity:GetComponent("script.LobbyInteractionComponent")
			if zone ~= nil then zone:OnInteract() end
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- Clears the local reference and hides the shared interaction prompt.
		self.FocusEntity = nil
		for _, path in ipairs({"/ui/DefaultGroup/LobbyInteractionPrompt"}) do
			local entity = _EntityService:GetEntityByPath(path)
			if isvalid(entity) then entity:SetEnable(false) end
		end
	end
end
