@Component
script LobbyInteractionComponent extends Component

	property string InteractionId = ""
	property string InteractionPromptText = "상호작용"
	property string InteractionKeyLabel = "E"
	property string TestMessage = "상호작용을 실행합니다."
	property number InteractionRangeX = 1.5
	property number InteractionRangeY = 1.5
	property boolean IsPlayerInRange = false
	property string PromptRootPath = "/ui/DefaultGroup/LobbyInteractionPrompt"
	property string PromptTextPath = "/ui/DefaultGroup/LobbyInteractionPrompt/PromptText"
	property Entity InteractionPromptRoot = nil
	property TextGUIRendererComponent PromptTextRenderer = nil
	property integer MessageTimerId = 0
	property boolean ServiceWasOpen = false
	property any TouchHandler = nil
	property string PointerTargetPath = ""

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		-- Initializes the reusable distance-based lobby interaction in a hidden state.
		local pointerTarget = self.PointerTargetPath ~= "" and _EntityService:GetEntityByPath(self.PointerTargetPath) or self.Entity
		self._T.PointerTarget = pointerTarget
		if isvalid(pointerTarget) then
			self.TouchHandler = pointerTarget:ConnectEvent(TouchEvent, self.OnTouched)
		else
			log_warning("[LobbyInteraction] pointer target missing id=" .. self.InteractionId)
		end
		self.IsPlayerInRange = false
		self.ServiceWasOpen = false
		self:ResolvePromptBinding()
		self:HidePrompt()
		log("[LobbyInteraction] ready id=" .. self.InteractionId .. " key=" .. self.InteractionKeyLabel)
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- Detects local-player entry and exit without requiring a native TriggerComponent.
		if self.InteractionId == "CharacterSelect" then
			local talking = _LobbyCharacterSelectionLogic:IsOpen()
			if self._T.KhunTalking ~= talking then
				local npc = _EntityService:GetEntityByPath("/maps/lobby/Lobby_2F/LayoutBlockout/CenterZone/JobSelectEmblem")
				if isvalid(npc) and npc.SpriteRendererComponent ~= nil then
					npc.SpriteRendererComponent.SpriteRUID = talking and "6bba1eb8f40f435c80db3dfe2b25479c" or "eb2545e6725646b1b964796abdd7281c"
					self._T.KhunTalking = talking
				end
			end
		end
		local localPlayer = _UserService.LocalPlayer
		if isvalid(localPlayer) == false or localPlayer.TransformComponent == nil or self.Entity.TransformComponent == nil then
			if self.IsPlayerInRange then
				self.IsPlayerInRange = false
				self:HidePrompt()
			end
			return
		end

		if localPlayer.CurrentMap ~= self.Entity.CurrentMap then
			if self.IsPlayerInRange then
				self:OnPlayerExit(localPlayer)
			end
			return
		end

		local playerPosition = localPlayer.TransformComponent.WorldPosition
		local zonePosition = self.Entity.TransformComponent.WorldPosition
		local insideRange = math.abs(playerPosition.x - zonePosition.x) <= self.InteractionRangeX
			and math.abs(playerPosition.y - zonePosition.y) <= self.InteractionRangeY

		if insideRange and self.IsPlayerInRange == false then
			self:OnPlayerEnter(localPlayer)
		elseif insideRange == false and self.IsPlayerInRange then
			self:OnPlayerExit(localPlayer)
		end

		-- Restores the shared prompt after an NPC-owned service closes without forcing the player to leave the range.
		if self.InteractionId == "Union" and self.IsPlayerInRange and self.ServiceWasOpen and _UnionSystemUILogic:IsOpen() == false then
			self.ServiceWasOpen = false
			self:ShowPrompt()
		end
	end

	@ExecSpace("ClientOnly")
	method void OnEndPlay()
		-- Releases click input and the temporary message timer when the zone unloads.
		if self.TouchHandler ~= nil then
			if isvalid(self._T.PointerTarget) then
				self._T.PointerTarget:DisconnectEvent(TouchEvent, self.TouchHandler)
			end
			self._T.PointerTarget = nil
			self.TouchHandler = nil
		end
		if self.MessageTimerId ~= 0 then
			_TimerService:ClearTimer(self.MessageTimerId)
			self.MessageTimerId = 0
		end

		self.IsPlayerInRange = false
		self.ServiceWasOpen = false
		self:HidePrompt()
	end

	@ExecSpace("ClientOnly")
	method void OnPlayerEnter(Entity playerEntity)
		-- Records local-player overlap and shows the configured interaction prompt.
		if isvalid(playerEntity) == false or playerEntity ~= _UserService.LocalPlayer then
			return
		end

		self.IsPlayerInRange = true
		self:ShowPrompt()
		log("[LobbyInteraction] enter id=" .. self.InteractionId)
	end

	@ExecSpace("ClientOnly")
	method void OnPlayerExit(Entity playerEntity)
		-- Clears local-player overlap and hides any prompt or temporary message.
		if isvalid(playerEntity) == false or playerEntity ~= _UserService.LocalPlayer then
			return
		end

		self.IsPlayerInRange = false
		if self.InteractionId == "CharacterSelect" and _LobbyCharacterSelectionLogic:IsOpen() then
			_LobbyCharacterSelectionLogic:ClosePopup(false)
		end
		if self.InteractionId == "Codex" and _LobbyCodexLogic:IsOpen() then
			_LobbyCodexLogic:ClosePopup()
		end
		if self.InteractionId == "Union" and _UnionSystemUILogic:IsOpen() then
			_UnionSystemUILogic:CloseWindow()
		end
		if self.MessageTimerId ~= 0 then
			_TimerService:ClearTimer(self.MessageTimerId)
			self.MessageTimerId = 0
		end

		self:HidePrompt()
		log("[LobbyInteraction] exit id=" .. self.InteractionId)
	end

	@ExecSpace("ClientOnly")
	method void OnInteract()
		-- Routes configured lobby interactions while retaining the temporary fallback action.
		if self.IsPlayerInRange == false or _LobbyInteractionFocusLogic.FocusEntity ~= self.Entity or _LobbyInteractionFocusLogic:IsModalOpen() then
			return
		end
		self:OpenService()
	end

	@ExecSpace("ClientOnly")
	method void OnTouched(TouchEvent event)
		-- Mouse/touch opens the selected NPC from anywhere in the same lobby; E retains proximity checks.
		local player = _UserService.LocalPlayer
		if not isvalid(player) or not isvalid(self.Entity.CurrentMap)
			or player.CurrentMap ~= self.Entity.CurrentMap or self.Entity.CurrentMap.Name ~= "lobby" then return end
		-- Native NPC touches may overlap the collapsed chat/HUD region; actual modals still block service entry.
		if _RunRelicInventoryUILogic.IsOpen
			or _LobbyInteractionFocusLogic:IsModalOpen() or _LobbyInteractionFocusLogic.InputCooldown > 0 then return end
		_LobbyInteractionFocusLogic.InputCooldown = 0.25
		log("[LobbyInteraction] pointer id=" .. self.InteractionId)
		self:OpenService()
	end

	@ExecSpace("ClientOnly")
	method void OpenService()
		-- Shared service routing for pointer and keyboard interaction.
		if _LobbyInteractionFocusLogic:IsModalOpen() then return end
		if self.InteractionId == "CharacterSelect" then
			self:HidePrompt()
			local opened = _LobbyCharacterSelectionLogic:OpenPopup()
			if opened == false and _LobbyCharacterSelectionLogic:IsOpen() == false then
				self:ShowPrompt()
			end
			return
		end
		if self.InteractionId == "Codex" then
			self:HidePrompt()
			local opened = _LobbyCodexLogic:OpenPopup()
			if opened == false and _LobbyCodexLogic:IsOpen() == false then self:ShowPrompt() end
			return
		end
		if self.InteractionId == "RunHistory" then
			-- Reuses the owner's history screen; the NPC never reads or writes storage itself.
			local controller = _EntityService:GetEntityByPath("/ui/RunHistoryUI/Controller")
			local panel = isvalid(controller) and controller:GetComponent("script.RunHistoryUIComponent") or nil
			if panel == nil then return end
			self:HidePrompt()
			panel:SetOpen(true)
			if panel.IsOpen == false then self:ShowPrompt() end
			return
		end
		if self.InteractionId == "SkillTree" then
			self:HidePrompt()
			_SkillTreeUILogic:OpenWindow()
			return
		end
		if self.InteractionId == "UnionShop" then
			self:HidePrompt()
			local ui = _EntityService:GetEntityByPath("/ui/RunShopUI")
			local shop = isvalid(ui) and ui:GetComponent("script.RunShopUIComponent") or nil
			if shop == nil or shop:OpenUnionUi() == false then self:ShowPrompt() end
			return
		end
		if self.InteractionId == "Union" then
			self:HidePrompt()
			local opened = _UnionSystemUILogic:OpenWindow()
			self.ServiceWasOpen = opened or _UnionSystemUILogic:IsOpen()
			if self.ServiceWasOpen == false then self:ShowPrompt() end
			return
		end

		log(self.TestMessage)
		if self:ResolvePromptBinding() then
			self.PromptTextRenderer.Text = self.TestMessage
			self.InteractionPromptRoot:SetEnable(true)
		end

		if self.MessageTimerId ~= 0 then
			_TimerService:ClearTimer(self.MessageTimerId)
		end

		local restorePrompt = function()
			self.MessageTimerId = 0
			if self.IsPlayerInRange then
				self:ShowPrompt()
			else
				self:HidePrompt()
			end
		end
		self.MessageTimerId = _TimerService:SetTimerOnce(restorePrompt, 1.5)
	end

	@ExecSpace("ClientOnly")
	method void ShowPrompt()
		-- Displays only the centrally selected target.
		if _LobbyInteractionFocusLogic.FocusEntity ~= self.Entity or _LobbyInteractionFocusLogic:IsModalOpen() then return end
		if self:ResolvePromptBinding() == false then
			log_warning("[LobbyInteraction] prompt binding missing id=" .. self.InteractionId)
			return
		end

		self.PromptTextRenderer.Text = self.InteractionPromptText
		local keyLabel = _EntityService:GetEntityByPath(self.PromptRootPath .. "/Keycap/Key")
		if isvalid(keyLabel) and keyLabel.TextGUIRendererComponent ~= nil then
			keyLabel.TextGUIRendererComponent.Text = self.InteractionKeyLabel
		end
		self.InteractionPromptRoot:SetEnable(true)
	end

	@ExecSpace("ClientOnly")
	method void HidePrompt()
		-- A departing zone cannot hide another target's prompt.
		if _LobbyInteractionFocusLogic.FocusEntity ~= self.Entity then return end
		if self:ResolvePromptBinding() then
			self.InteractionPromptRoot:SetEnable(false)
		end
	end

	@ExecSpace("ClientOnly")
	method boolean ResolvePromptBinding()
		-- Resolves client-only UI entities by path instead of a cross-hierarchy serialized reference.
		if isvalid(self.InteractionPromptRoot) and self.PromptTextRenderer ~= nil then
			return true
		end

		local promptRoot = _EntityService:GetEntityByPath(self.PromptRootPath)
		local promptTextEntity = _EntityService:GetEntityByPath(self.PromptTextPath)
		if isvalid(promptRoot) then
			self.InteractionPromptRoot = promptRoot
		end
		if isvalid(promptTextEntity) and promptTextEntity.TextGUIRendererComponent ~= nil then
			self.PromptTextRenderer = promptTextEntity.TextGUIRendererComponent
		end

		return isvalid(self.InteractionPromptRoot) and self.PromptTextRenderer ~= nil
	end

end
