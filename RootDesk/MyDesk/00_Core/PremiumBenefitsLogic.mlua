@Logic
script PremiumBenefitsLogic extends Logic

    -- Register as a one-time WorldShop Pass. Keep this ID permanently mapped to these benefits.
    property string MagnetPetProductId = ""
    property boolean SalesEnabled = false
    property string MagnetRelicId = "premium_magnet_pet"

    @ExecSpace("ServerOnly")
    method table GetBenefits(Entity player)
        -- Fail closed on profile load errors; a purchased run must never silently lose its benefits.
        local profile = _UnionProfileRepositoryLogic:GetUnionProfile(player)
        if profile.Success == false then return profile end
        return {Success = true, MagnetPetOwned = (profile.Profile.MagnetPetPurchaseId or "") ~= ""}
    end

    method table GetMagnetRelicDefinition()
        -- This reserved catalog entry is never included in random or ordinary shop acquisition.
        return {Success = true, Reason = "OK", RelicId = self.MagnetRelicId, Source = "PREMIUM",
            DisplayName = "자석펫", IconImageRUID = "d6a6fae1f10f49fa904b9890445d4b73",
            EffectDescription = "맵에 있는 아이템 즉시 자동 수집 / 인벤토리 슬롯 +1 (매 모험 시작 시 지급)",
            AttackBonus = 0, MaxHpBonus = 0, DefenseBonus = 0, SpecialEffectType = "MAGNET_PET", SpecialEffectValue = 1,
            RequiredJobId = "", IsOpen = false, PremiumOnly = true}
    end

    @ExecSpace("ServerOnly")
    method table GrantRunRelic(Entity player, integer runSequence)
        -- Grant exactly one protected relic after the normal run inventory and catalog initialize.
        local benefits = player:GetComponent("script.PlayerRunUnionEffectComponent")
        if benefits == nil or not benefits.IsInitialized or benefits.ActiveRunSequence ~= runSequence then
            return {Success = false, Reason = "RUN_PREMIUM_SEQUENCE_MISMATCH"}
        end
        if not benefits.MagnetPetOwned then return {Success = true, Reason = "NOT_OWNED"} end
        local inventory = player:GetComponent("script.PlayerRunInventoryComponent")
        local effects = player:GetComponent("script.PlayerRunRelicEffectComponent")
        if inventory == nil or effects == nil or not effects.IsInitialized
            or inventory.ActiveRunSequence ~= runSequence or effects.ActiveRunSequence ~= runSequence
            or effects.Definitions[self.MagnetRelicId] == nil then
            return {Success = false, Reason = "RUN_PREMIUM_RELIC_UNAVAILABLE"}
        end
        if inventory:GetSnapshotAmount(inventory.RunItemSnapshot, self.MagnetRelicId) > 0 then
            return effects:Recalculate()
        end
        inventory.RunItemSnapshot = inventory:SetSnapshotAmount(inventory.RunItemSnapshot, self.MagnetRelicId, 1)
        inventory.InventoryRevision = inventory.InventoryRevision + 1
        local result = effects:Recalculate()
        log("[MagnetPet] run relic granted sequence=" .. tostring(runSequence))
        return result
    end

end
