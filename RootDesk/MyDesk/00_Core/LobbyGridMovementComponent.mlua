@Component
script LobbyGridMovementComponent extends Component

	-- Keeps lobby movement on the same logical step size used by map01.
	property number CellSize = 1.12
	property number MinX = -29.46
	property number MaxX = -22.74

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleMoveKeyDown(KeyDownEvent event)
		-- Lobby modal services own keyboard focus while open; normal grid input resumes on close.
		if _LobbyCharacterSelectionLogic:IsOpen() or _LobbyCodexLogic:IsOpen() or _UnionSystemUILogic:IsOpen() then
			return
		end

		local direction = 0
		if event.key == KeyboardKey.LeftArrow or event.key == KeyboardKey.A then
			direction = -1
		elseif event.key == KeyboardKey.RightArrow or event.key == KeyboardKey.D then
			direction = 1
		end

		if direction == 0 then
			return
		end

		local player = _UserService.LocalPlayer
		if isvalid(player) == false or player.CurrentMap ~= self.Entity then
			return
		end

		log("[LobbyGridMove] requested direction=" .. direction)
		self:RequestMove(direction)
	end

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		log("[LobbyGridMove] begin map=" .. self.Entity.Name .. " cellSize=" .. self.CellSize)
		local users = _UserService:GetUsersByMapComponent(self.Entity.MapComponent)
		if users == nil then
			return
		end

		for _, player in ipairs(users) do
			self:SetGridControl(player, true)
		end
	end

	@ExecSpace("ServerOnly")
	method void OnMapEnter(Entity enteredEntity)
		self:SetGridControl(enteredEntity, true)
	end

	@ExecSpace("ServerOnly")
	method void OnMapLeave(Entity leftEntity)
		self:SetGridControl(leftEntity, false)
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		local users = _UserService:GetUsersByMapComponent(self.Entity.MapComponent)
		if users == nil then
			return
		end

		for _, player in ipairs(users) do
			self:SetGridControl(player, false)
		end
	end

	@ExecSpace("ServerOnly")
	method void SetGridControl(Entity player, boolean enabled)
		if isvalid(player) == false or player.PlayerComponent == nil then
			return
		end

		if player.PlayerControllerComponent ~= nil then
			player.PlayerControllerComponent.Enable = not enabled
		end

		if player.MovementComponent ~= nil then
			player.MovementComponent:Stop()
		end

		log("[LobbyGridMove] control player=" .. player.Name .. " grid=" .. tostring(enabled))
	end

	@ExecSpace("Server")
	method void RequestMove(integer direction)
		if direction ~= -1 and direction ~= 1 then
			log_warning("[LobbyGridMove] rejected reason=INVALID_DIRECTION")
			return
		end

		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if isvalid(player) == false or player.CurrentMap ~= self.Entity then
			log_warning("[LobbyGridMove] rejected reason=INVALID_SENDER")
			return
		end

		if player.TransformComponent == nil or player.MovementComponent == nil then
			log_warning("[LobbyGridMove] rejected reason=MOVEMENT_COMPONENT_MISSING")
			return
		end

		local current = player.TransformComponent.WorldPosition
		local targetX = current.x + self.CellSize * direction
		if targetX < self.MinX then
			targetX = self.MinX
		elseif targetX > self.MaxX then
			targetX = self.MaxX
		end

		if math.abs(targetX - current.x) < 0.001 then
			log("[LobbyGridMove] blocked boundary x=" .. current.x)
			return
		end

		player.MovementComponent:Stop()
		player.MovementComponent:SetWorldPosition(Vector2(targetX, current.y))
		if player.PlayerControllerComponent ~= nil then
			player.PlayerControllerComponent.LookDirectionX = direction
		end
		log("[LobbyGridMove] moved user=" .. senderUserId .. " from=" .. current.x .. " to=" .. targetX)
	end

end
