@Component
script LobbyGridMovementComponent extends Component

	-- Map bounds remain local; input, interpolation and hop use the battle movement pipeline.
	property number CellSize = 1.12
	property number MinX = -29.46
	property number MaxX = -22.74
	-- Every step lands on GridOriginX + n * CellSize (the lobby spawn column), so fixed props such as the
	-- start portal can sit exactly on a reachable column even after the player touches a map edge.
	property number GridOriginX = -27.3686

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleMoveKeyDown(KeyDownEvent event)
		-- Lobby modal services own keyboard focus while open; normal grid input resumes on close.
		if _SkillTreeUILogic:IsOpen() or _LobbyCharacterSelectionLogic:IsOpen() or _LobbyCodexLogic:IsOpen() or _UnionSystemUILogic:IsOpen() or _GameSettingsLogic:IsInputBlocked() then
			return
		end

		local player = _UserService.LocalPlayer
		if isvalid(player) == false or player.CurrentMap ~= self.Entity then
			return
		end

		if event.key == KeyboardKey.Mouse2 or _GameSettingsLogic:IsActionKey("TURN", event.key) then
			if event.key == KeyboardKey.Mouse2 and _InputService:IsPointerOverUI() then
				return
			end
			self._T.BufferedDirection = nil
			_PlayerGridMovementLogic:CancelBlockedMove("NEW_TURN")
			self:RequestTurn()
			return
		end

		local direction = _PlayerGridMovementLogic:GetDirection(event.key)
		if direction == 0 then
			return
		end

		self:TryLobbyMove(player, direction)
	end

	@ExecSpace("ClientOnly")
	method void TryLobbyMove(Entity player, integer direction)
		if _PlayerGridMovementLogic:HasLocalMove(self.Entity) or (self._T.moveContext or 0) <= 0 then
			self._T.BufferedDirection = direction
			self._T.BufferedMoveRemaining = 0.6
			return
		end
		self._T.BufferedDirection = nil
		local current = player.TransformComponent.WorldPosition
		local context = self._T.moveContext or 0
		local target = Vector2(self:GetStepTargetX(current.x, direction), current.y)
		local profile = _PlayerGridMovementLogic:GetProfile(nil)
		profile.AttemptDirection = direction
		profile.AttemptCellSize = self.CellSize
		profile.ObstructionHint = math.abs(target.x - current.x) < 0.001
		local requestId = _PlayerGridMovementLogic:BeginLocalMove(player, self.Entity, 0, context, target, profile)
		if requestId > 0 then self:RequestMove(direction, requestId, context) end
	end

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		-- Tracks each lobby player independently; no movement state lives in the shared Logic.
		self._T.gridMoves = {}
		self._T.gridPlayers = {}
		self._T.gridMoveContexts = {}
		self._T.lastMoveRequestIds = {}
		self._T.playerScanRemaining = 0
		log("[LobbyGridMove] begin map=" .. self.Entity.Name .. " cellSize=" .. self.CellSize)
		local users = _UserService:GetUsersByMapComponent(self.Entity.MapComponent)
		if users == nil then
			return
		end

		for _, player in ipairs(users) do
			self:SetGridControl(player, true)
		end
	end

	@ExecSpace("ServerOnly")
	method void OnMapEnter(Entity enteredEntity)
		-- Applies grid control when this lifecycle callback provides a player entity.
		self:SetGridControl(enteredEntity, true)
	end

	@ExecSpace("ServerOnly")
	method void OnMapLeave(Entity leftEntity)
		-- Discard the old map's target before another map can take control of this player.
		if isvalid(leftEntity) and leftEntity.PlayerComponent ~= nil and self._T.gridMoves ~= nil then
			self._T.gridMoves[leftEntity.PlayerComponent.UserId] = nil
			self._T.gridPlayers[leftEntity.PlayerComponent.UserId] = nil
		end
		self:SetGridControl(leftEntity, false)
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		-- Release map-owned movement state at shutdown.
		self._T.gridMoves = {}
		local users = _UserService:GetUsersByMapComponent(self.Entity.MapComponent)
		if users == nil then
			return
		end

		for _, player in ipairs(users) do
			self:SetGridControl(player, false)
		end
	end

	@ExecSpace("ServerOnly")
	method void SetGridControl(Entity player, boolean enabled)
		-- Reuses the battle visual component, without registering a battle unit or starting a battle.
		if isvalid(player) == false or player.PlayerComponent == nil then
			return
		end

		if player.PlayerControllerComponent ~= nil then
			player.PlayerControllerComponent.Enable = not enabled
		end

		if player.MovementComponent ~= nil then
			player.MovementComponent:Stop()
		end
		if enabled and player:GetComponent("script.BattleUnitPresentationComponent") == nil then
			player:AddComponent("BattleUnitPresentationComponent")
		end
		if enabled then
			local userId = player.PlayerComponent.UserId
			self._T.gridPlayers = self._T.gridPlayers or {}
			self._T.gridMoveContexts = self._T.gridMoveContexts or {}
			if self._T.gridPlayers[userId] ~= player then
				self._T.gridPlayers[userId] = player
				self._T.gridMoveContexts[userId] = (self._T.gridMoveContexts[userId] or 0) + 1
				self._T.lastMoveRequestIds = self._T.lastMoveRequestIds or {}
				self._T.lastMoveRequestIds[userId] = 0
			end
			self:ReceiveMoveContext(self._T.gridMoveContexts[userId], userId)
		end

		log("[LobbyGridMove] control player=" .. player.Name .. " grid=" .. tostring(enabled))
	end

	@ExecSpace("Server")
	method void RequestMove(integer direction, integer requestId, integer context)
		-- Validates ownership and accepts only one in-flight battle-style step per player.
		if direction ~= -1 and direction ~= 1 then
			log_warning("[LobbyGridMove] rejected reason=INVALID_DIRECTION")
			return
		end

		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if isvalid(player) == false or player.CurrentMap ~= self.Entity then
			log_warning("[LobbyGridMove] rejected reason=INVALID_SENDER")
			return
		end
		if requestId <= 0 or requestId ~= math.floor(requestId) then return end
		local current = player.TransformComponent ~= nil and player.TransformComponent.WorldPosition or Vector3.zero
		if self._T.gridMoveContexts == nil or context ~= self._T.gridMoveContexts[senderUserId] then
			self:ReceiveMoveResult(requestId, context, false, true, current.x, current.y, "LOBBY_CONTEXT_CHANGED", senderUserId)
			return
		end
		self._T.lastMoveRequestIds = self._T.lastMoveRequestIds or {}
		if requestId <= (self._T.lastMoveRequestIds[senderUserId] or 0) then return end
		self._T.lastMoveRequestIds[senderUserId] = requestId

		if player.TransformComponent == nil or player.MovementComponent == nil then
			self:ReceiveMoveResult(requestId, context, false, true, current.x, current.y, "MOVEMENT_COMPONENT_MISSING", senderUserId)
			log_warning("[LobbyGridMove] rejected reason=MOVEMENT_COMPONENT_MISSING")
			return
		end
		if self._T.gridMoves == nil then self._T.gridMoves = {} end
		if self._T.gridMoves[senderUserId] ~= nil then
			self:ReceiveMoveResult(requestId, context, false, true, current.x, current.y, "MOVE_IN_PROGRESS", senderUserId)
			log("[LobbyGridMove] blocked reason=MOVE_IN_PROGRESS")
			return
		end

		-- Snap to the spawn-anchored columns and clamp to the outermost column inside the map bounds, so a
		-- boundary step never shifts the columns by a fraction of a cell.
		local targetX = self:GetStepTargetX(current.x, direction)

		if math.abs(targetX - current.x) < 0.001 then
			self:ReceiveMoveResult(requestId, context, false, true, current.x, current.y, "BOUNDARY", senderUserId)
			log("[LobbyGridMove] blocked boundary x=" .. current.x)
			return
		end

		player.MovementComponent:Stop()
		local profile = _PlayerGridMovementLogic:GetProfile(nil)
		self._T.gridMoves[senderUserId] = {
			Entity = player, StartPosition = Vector2(current.x, current.y),
			TargetPosition = Vector2(targetX, current.y), Elapsed = 0,
			Duration = _PlayerGridMovementLogic:GetDuration(profile), Profile = profile,
			RequestId = requestId, Context = context
		}
		_PlayerGridMovementLogic:PlayHop(player, senderUserId, profile, requestId)
		self:ReceiveMoveResult(requestId, context, true, false, targetX, current.y, "MOVE_ACCEPTED", senderUserId)
		log("[LobbyGridMove] started pipeline=PlayerGridMovementLogic user=" .. senderUserId .. " from=" .. current.x .. " to=" .. targetX .. " duration=" .. tostring(self._T.gridMoves[senderUserId].Duration))
	end

	method number GetStepTargetX(number currentX, integer direction)
		local origin = self.GridOriginX
		local targetX = origin + math.floor((currentX + self.CellSize * direction - origin) / self.CellSize + 0.5) * self.CellSize
		local minColumn = origin + math.ceil((self.MinX - origin) / self.CellSize - 0.0001) * self.CellSize
		local maxColumn = origin + math.floor((self.MaxX - origin) / self.CellSize + 0.0001) * self.CellSize
		return math.max(minColumn, math.min(maxColumn, targetX))
	end

	@ExecSpace("Client")
	method void ReceiveMoveContext(integer context)
		local player = _UserService.LocalPlayer
		if isvalid(player) and player.CurrentMap == self.Entity and context >= (self._T.moveContext or 0) then self._T.moveContext = context end
	end

	@ExecSpace("Client")
	method void ReceiveMoveResult(integer requestId, integer context, boolean success, boolean completed, number targetX, number targetY, string reason)
		_PlayerGridMovementLogic:ResolveLocalMove(self.Entity, requestId, 0, context, success, completed, targetX, targetY, reason)
	end

	@ExecSpace("Server")
	method void RequestTurn()
		-- Turns in place with W, Up Arrow or middle click; movement preserves the chosen facing.
		local player = _UserService:GetUserEntityByUserId(senderUserId)
		if isvalid(player) == false or player.CurrentMap ~= self.Entity then
			return
		end
		local controller = player.PlayerControllerComponent
		if controller == nil then return end
		if self._T.gridMoves ~= nil and self._T.gridMoves[senderUserId] ~= nil then
			return
		end
		if controller.LookDirectionX >= 0 then
			controller.LookDirectionX = -1
		else
			controller.LookDirectionX = 1
		end
		log("[LobbyGridTurn] turned user=" .. senderUserId .. " direction=" .. tostring(controller.LookDirectionX))
	end

	@ExecSpace("ClientOnly")
	method void UpdateBufferedMove(Entity player, number delta)
		if self._T.BufferedDirection == nil then return end
		self._T.BufferedMoveRemaining = (self._T.BufferedMoveRemaining or 0) - delta
		if self._T.BufferedMoveRemaining <= 0 or _SkillTreeUILogic:IsOpen() or _LobbyCharacterSelectionLogic:IsOpen() or _LobbyCodexLogic:IsOpen() or _UnionSystemUILogic:IsOpen() or _GameSettingsLogic:IsInputBlocked() then
			self._T.BufferedDirection = nil
			return
		end
		if (self._T.moveContext or 0) <= 0 or _PlayerGridMovementLogic:HasLocalMove(self.Entity) then return end
		local direction = self._T.BufferedDirection
		self._T.BufferedDirection = nil
		self:TryLobbyMove(player, direction)
	end

	method void OnUpdate(number delta)
		-- Advances lobby steps through the same easing and exact endpoint snap used by battle.
		if self:IsClient() then
			local localPlayer = _UserService.LocalPlayer
			if isvalid(localPlayer) and localPlayer.CurrentMap == self.Entity then
				self._T.localPlayerOnMap = true
				self:UpdateBufferedMove(localPlayer, delta)
				if localPlayer.PlayerControllerComponent ~= nil then
					localPlayer.PlayerControllerComponent.Enable = false
				end
			elseif self._T.localPlayerOnMap then
				self._T.localPlayerOnMap = false
				self._T.moveContext = nil
				self._T.BufferedDirection = nil
			end
			return
		end
		-- Map-root OnMapEnter is not a player-join subscription. Reconcile users after spawn/transfer.
		if self._T.gridPlayers == nil then self._T.gridPlayers = {} end
		self._T.playerScanRemaining = (self._T.playerScanRemaining or 0) - delta
		if self._T.playerScanRemaining <= 0 then
			self._T.playerScanRemaining = 0.1
			local users = _UserService:GetUsersByMapComponent(self.Entity.MapComponent)
			for _, player in ipairs(users or {}) do
				local userId = player.PlayerComponent.UserId
				if self._T.gridPlayers[userId] ~= player then
					self:SetGridControl(player, true)
				end
			end
			for userId, player in pairs(self._T.gridPlayers) do
				if isvalid(player) == false or player.CurrentMap ~= self.Entity then
					self._T.gridPlayers[userId] = nil
				end
			end
		end
		if self._T.gridMoves == nil then return end
		for userId, movement in pairs(self._T.gridMoves) do
			local player = movement.Entity
			if isvalid(player) == false or player.CurrentMap ~= self.Entity or player.MovementComponent == nil then
				self._T.gridMoves[userId] = nil
			else
				local profile = movement.Profile
				local step = _PlayerGridMovementLogic:Advance(movement, delta, profile.MoveCurve, profile.MoveSnapThreshold)
				player.MovementComponent:SetWorldPosition(step.Position)
				if step.Complete then
					self._T.gridMoves[userId] = nil
					self:ReceiveMoveResult(movement.RequestId, movement.Context, true, true, step.Position.x, step.Position.y, "MOVE_COMPLETE", userId)
					log("[LobbyGridMove] completed user=" .. userId .. " snappedX=" .. tostring(step.Position.x))
				end
			end
		end
	end

end
