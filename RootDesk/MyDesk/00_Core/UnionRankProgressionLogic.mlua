@Logic
script UnionRankProgressionLogic extends Logic

    @ExecSpace("ServerOnly")
    method void NotifyRankTransition(Entity userEntity, integer previousLifetimeUnionPoints, integer currentLifetimeUnionPoints)
        -- A persisted lifetime-point threshold transition emits exactly one small client notification.
        if isvalid(userEntity) == false or userEntity.PlayerComponent == nil then return end
        if currentLifetimeUnionPoints <= previousLifetimeUnionPoints then return end

        local previousRankResult = _UnionRankDefinitionRepositoryLogic:GetRankForLifetimePoints(previousLifetimeUnionPoints)
        local currentRankResult = _UnionRankDefinitionRepositoryLogic:GetRankForLifetimePoints(currentLifetimeUnionPoints)
        if previousRankResult.Success == false or currentRankResult.Success == false then
            log_warning("[UnionRank] transition lookup failed user=" .. tostring(userEntity.PlayerComponent.UserId))
            return
        end

        local previousRank = previousRankResult
        local currentRank = currentRankResult
        if previousRank.RankId == currentRank.RankId then return end

        local userId = tostring(userEntity.PlayerComponent.UserId)
        self:ReceiveRankUp(currentRank.DisplayName, currentRank.UnlockDescription, currentRank.UnlockedBoardTier, userId)
        log("[UnionRank] rank up user=" .. userId .. " from=" .. previousRank.RankId .. " to=" .. currentRank.RankId .. " lifetime=" .. tostring(currentLifetimeUnionPoints))
    end

    @ExecSpace("Client")
    method void ReceiveRankUp(string rankDisplayName, string unlockDescription, integer unlockedBoardTier)
        -- Displays only the server-confirmed rank reached by persisted lifetime points, on the shared toast layer.
        local detail = unlockDescription or ("보드 티어 " .. tostring(unlockedBoardTier) .. "이 개방되었습니다.")
        _GameUIPolishLogic:ShowToast("유니온 등급 상승! " .. (rankDisplayName or "UNION"), detail)
    end

end
