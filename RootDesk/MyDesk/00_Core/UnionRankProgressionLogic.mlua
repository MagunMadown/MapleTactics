@Logic
script UnionRankProgressionLogic extends Logic

    property string RankUpToastPath = "/ui/UnionSystemUI/UnionRankUpToast"
    property Entity RankUpToastEntity = nil
    property TextGUIRendererComponent RankUpTitleText = nil
    property TextGUIRendererComponent RankUpRankText = nil
    property TextGUIRendererComponent RankUpDescriptionText = nil
    property integer HideTimerId = 0

    @ExecSpace("ServerOnly")
    method void NotifyRankTransition(Entity userEntity, integer previousLifetimeUnionPoints, integer currentLifetimeUnionPoints)
        -- A persisted lifetime-point threshold transition emits exactly one small client notification.
        if isvalid(userEntity) == false or userEntity.PlayerComponent == nil then return end
        if currentLifetimeUnionPoints <= previousLifetimeUnionPoints then return end

        local previousRankResult = _UnionRankDefinitionRepositoryLogic:GetRankForLifetimePoints(previousLifetimeUnionPoints)
        local currentRankResult = _UnionRankDefinitionRepositoryLogic:GetRankForLifetimePoints(currentLifetimeUnionPoints)
        if previousRankResult.Success == false or currentRankResult.Success == false then
            log_warning("[UnionRank] transition lookup failed user=" .. tostring(userEntity.PlayerComponent.UserId))
            return
        end

        local previousRank = previousRankResult
        local currentRank = currentRankResult
        if previousRank.RankId == currentRank.RankId then return end

        local userId = tostring(userEntity.PlayerComponent.UserId)
        self:ReceiveRankUp(currentRank.DisplayName, currentRank.UnlockDescription, currentRank.UnlockedBoardTier, userId)
        log("[UnionRank] rank up user=" .. userId .. " from=" .. previousRank.RankId .. " to=" .. currentRank.RankId .. " lifetime=" .. tostring(currentLifetimeUnionPoints))
    end

    @ExecSpace("Client")
    method void ReceiveRankUp(string rankDisplayName, string unlockDescription, integer unlockedBoardTier)
        -- Displays only the server-confirmed rank reached by persisted lifetime points.
        self:ResolveToastBindings()
        if isvalid(self.RankUpToastEntity) == false then
            log_warning("[UnionRank] rank-up toast binding missing")
            return
        end

        self:SetText(self.RankUpTitleText, "유니온 등급 상승!")
        self:SetText(self.RankUpRankText, rankDisplayName or "UNION")
        self:SetText(self.RankUpDescriptionText, unlockDescription or ("보드 티어 " .. tostring(unlockedBoardTier) .. "이 개방되었습니다."))
        self.RankUpToastEntity:SetEnable(true)

        if self.HideTimerId ~= 0 then
            _TimerService:ClearTimer(self.HideTimerId)
            self.HideTimerId = 0
        end
        self.HideTimerId = _TimerService:SetTimerOnce(function()
            if isvalid(self.RankUpToastEntity) then self.RankUpToastEntity:SetEnable(false) end
            self.HideTimerId = 0
        end, 3.2)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Prevents a delayed toast callback from surviving the client Logic lifecycle.
        if self.HideTimerId ~= 0 then
            _TimerService:ClearTimer(self.HideTimerId)
            self.HideTimerId = 0
        end
    end

    @ExecSpace("ClientOnly")
    method void ResolveToastBindings()
        -- Resolves the STEP 8 toast lazily because UI entities may initialize after global Logic.
        self.RankUpToastEntity = _EntityService:GetEntityByPath(self.RankUpToastPath)
        self.RankUpTitleText = self:GetText(self.RankUpToastPath .. "/TitleText")
        self.RankUpRankText = self:GetText(self.RankUpToastPath .. "/RankText")
        self.RankUpDescriptionText = self:GetText(self.RankUpToastPath .. "/DescriptionText")
    end

    @ExecSpace("ClientOnly")
    method TextGUIRendererComponent GetText(string path)
        local entity = _EntityService:GetEntityByPath(path)
        return isvalid(entity) and entity.TextGUIRendererComponent or nil
    end

    @ExecSpace("ClientOnly")
    method void SetText(TextGUIRendererComponent renderer, string value)
        if renderer ~= nil and isvalid(renderer.Entity) then renderer.Text = value or "" end
    end

end
