@Component
script MapBgmPlaylistComponent extends Component

@Sync
property string TrackRUIDs = ""
property any SoundStateEventHandler = nil

@ExecSpace("ClientOnly")
method void OnBeginPlay()
	-- Subscribe to BGM playback changes; read the configured playlist on map entry.
	self._T.active = false
	self._T.pendingNext = false
	self._T.started = false
	self._T.trackIndex = 1
	self._T.ready = false
	self._T.tracks = {}
	local sound = self.Entity.SoundComponent
	if not isvalid(sound) then
		log_warning("[MapBgmPlaylist] Map SoundComponent is missing.")
		return
	end
	self.SoundStateEventHandler = _SoundService:ConnectEvent(SoundPlayStateChangedEvent, function(event)
		if not self._T.active or not self:IsCurrentMap() then return end
		if event.State == SoundPlayState.Play then
			self._T.started = true
		elseif event.State == SoundPlayState.Stop and self._T.started then
			self._T.started = false
			self._T.pendingNext = true
		end
	end)
	self._T.ready = true
	log("[MapBgmPlaylist] Ready: " .. self.Entity.Name)
end

@ExecSpace("ClientOnly")
method boolean IsCurrentMap()
	-- Ignore playback events from other maps and other players' transitions.
	local player = _UserService.LocalPlayer
	return isvalid(player) and player.CurrentMap == self.Entity
end

@ExecSpace("ClientOnly")
method void OnUpdate(number delta)
	-- Start on local entry and defer track changes outside the sound event callback.
	if not self._T.ready then return end
	if not self:IsCurrentMap() then
		self._T.active = false
		self._T.started = false
		self._T.pendingNext = false
		return
	end
	if not self._T.active then
		local tracks = {}
		for track in string.gmatch(self.TrackRUIDs or "", "([^|]+)") do
			if track ~= "" then table.insert(tracks, track) end
		end
		-- Initial property synchronization can finish after OnBeginPlay.
		if #tracks == 0 then return end
		self._T.tracks = tracks
		self._T.trackIndex = 1
		self:PlayCurrentTrack()
	elseif self._T.pendingNext then
		self._T.trackIndex = self._T.trackIndex % #self._T.tracks + 1
		self:PlayCurrentTrack()
	end
end

@ExecSpace("ClientOnly")
method void PlayCurrentTrack()
	-- Repeat a single track natively, or advance a multi-track list on completion.
	local sound = self.Entity.SoundComponent
	if not isvalid(sound) or not self:IsCurrentMap() then return end
	self._T.active = false
	self._T.started = false
	self._T.pendingNext = false
	sound:Stop()
	sound.Bgm = true
	sound.Loop = #self._T.tracks == 1
	sound.PlayOnEnable = false
	sound.KeepBGM = false
	local track = self._T.tracks[self._T.trackIndex]
	sound.AudioClipRUID = track
	self._T.active = true
	sound:Play()
	log("[MapBgmPlaylist] Track " .. tostring(self._T.trackIndex) .. ": " .. track)
end

@ExecSpace("ClientOnly")
method void OnEndPlay()
	-- Disconnect before stopping so teardown cannot queue another track.
	self._T.ready = false
	self._T.active = false
	self._T.pendingNext = false
	if self.SoundStateEventHandler ~= nil then
		_SoundService:DisconnectEvent(SoundPlayStateChangedEvent, self.SoundStateEventHandler)
		self.SoundStateEventHandler = nil
	end
	if self:IsCurrentMap() and isvalid(self.Entity.SoundComponent) then
		self.Entity.SoundComponent:Stop()
	end
end

end
