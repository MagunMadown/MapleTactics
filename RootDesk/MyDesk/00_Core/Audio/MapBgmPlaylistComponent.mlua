@Component
script MapBgmPlaylistComponent extends Component

@Sync
@Description("Add one BGM RUID per entry. PersistentBgmComponent plays this list across skill reward maps.")
property SyncTable<string> TrackRUIDs

@ExecSpace("ClientOnly")
method table GetTracks()
	-- Supply map configuration without owning playback or map-lifetime audio state.
	local tracks = {}
	for _, entry in ipairs(self.TrackRUIDs) do
		local track = string.match(entry, "^%s*(.-)%s*$")
		if #track == 32 and string.match(track, "^%x+$") ~= nil then
			table.insert(tracks, string.lower(track))
		end
	end
	return tracks
end

end
